            </termEntry>
            <termEntry id="Speak alert message">
                <langSet xml:lang="en-US"><tig><term>Speak alert message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎬ ᎠᏓᏃᏎᎯ ᏗᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Google Play system update">
                <langSet xml:lang="en-US"><tig><term>Google Play system update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Google ᎤᎾᏛᏁᎸᏗ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="No contacts in this account">
                <langSet xml:lang="en-US"><tig><term>No contacts in this account</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏗᏟᏃᎮᏙᏗ ᎾᎿ ᎯᎠ ᎠᏚᏓᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Activating your phone...  Don't turn it off">
                <langSet xml:lang="en-US"><tig><term>Activating your phone...  Don't turn it off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᎳᏗᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ...  ᏤᏍᏗ ᎭᎦᏔᎲᎾ ᎨᎡᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="ENABLE">
                <langSet xml:lang="en-US"><tig><term>ENABLE</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵ ᎢᏳᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up to answer">
                <langSet xml:lang="en-US"><tig><term>Swipe up to answer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎾᎢ ᎦᏬᎯᎵᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change permissions in Settings &gt; Apps &gt; Messages &gt; Permissions.">
                <langSet xml:lang="en-US"><tig><term>You can change permissions in Settings &gt; Apps &gt; Messages &gt; Permissions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎯᏁᏟᏴᎾ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿ ᏕᎦᎧᎲᎢ &gt; ᏗᎬᏙᏗ &gt; ᏗᎪᎵᏰᏗ &gt; ᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Silence alarms">
                <langSet xml:lang="en-US"><tig><term>Silence alarms</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎷᏪᎢ ᏗᏓᏕᏯᏙᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier unknown">
                <langSet xml:lang="en-US"><tig><term>Carrier unknown</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᏙᎯ ᏅᎪᎵᎬᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Go all the way to the edge.">
                <langSet xml:lang="en-US"><tig><term>Go all the way to the edge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᎾ ᏂᎦᏓ ᏥᎩ ᏳᎵᏍᏙᏗ ᎾᎿᎢ ᏥᎩ ᎠᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up to answer and hold ongoing call">
                <langSet xml:lang="en-US"><tig><term>Swipe up to answer and hold ongoing call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎾᎢ ᎦᏬᎯᎵᏴᏍᏗ ᎠᎴ ᎯᏂᏯ ᎤᎿᎢ ᏓᏰᏏ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe from left to right on the sensor.">
                <langSet xml:lang="en-US"><tig><term>Swipe from left to right on the sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᏅᏓᏳᏓᎴᏅᎯ ᎤᏓᎷᎵ ᎾᎿᎢ ᎠᎦᏘᏏ ᎤᎿᎢ ᏥᎩ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot call without permissions.">
                <langSet xml:lang="en-US"><tig><term>Cannot call without permissions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏪᏯᎾ ᎾᏠᏯᏍᏗᏍᎬᎾ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Running application">
                <langSet xml:lang="en-US"><tig><term>Running application</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏓ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you turn off Wi-Fi Calling, all your future calls will go over the mobile network.">
                <langSet xml:lang="en-US"><tig><term>If you turn off Wi-Fi Calling, all your future calls will go over the mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᎠᏍᏚᏗ Wi-Fi ᏓᏯᏂᏍᎬ, ᏂᎦᏓ ᏂᏨᎤᎢ ᎤᏩᎫᏗᏗᏒ ᏓᏯᏂ ᎠᏎ ᎮᎾ ᎢᏴᏛ ᏥᎩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If the mobile network isn't available, you may not be able to make calls.">
                <langSet xml:lang="en-US"><tig><term>If the mobile network isn't available, you may not be able to make calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏥᎩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ, ᏂᎯ ᏰᎵᏯ ᎥᏝ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎪᏢᏗ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up to answer and end call on hold">
                <langSet xml:lang="en-US"><tig><term>Swipe up to answer and end call on hold</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎾᎢ ᎦᏬᎯᎵᏴᏍᏗ ᎠᎴ ᎠᎵᏍᏆᏓ ᏪᏯᎾ ᎤᎿᎢ ᎯᏂᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold your phone tight and make two chopping motions.">
                <langSet xml:lang="en-US"><tig><term>Hold your phone tight and make two chopping motions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏂᏴᏎᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎯᏍᏓᏱᏓ ᎠᎴ ᎪᏢᏗ ᏔᎵ ᎦᎷᏱᏓᏍᏗ ᏗᏓᏅᏏᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Press the fingerprint sensor to turn off the screen">
                <langSet xml:lang="en-US"><tig><term>Press the fingerprint sensor to turn off the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎾᎿᎢ ᎠᏍᏚᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="TalkBack will turn off when One Button Nav is turned on">
                <langSet xml:lang="en-US"><tig><term>TalkBack will turn off when One Button Nav is turned on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TalkBack ᎠᏎ ᎠᏍᏚᏗ ᎢᏳᏃ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎨᎡᎢ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Visit settings to manage screen lock.">
                <langSet xml:lang="en-US"><tig><term>Visit settings to manage screen lock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏩᏛᎯᏓᏍᏗ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ ᎠᏰᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Loading conversations">
                <langSet xml:lang="en-US"><tig><term>Loading conversations</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏢᏍᎬ ᏓᎾᏟᏃᎮᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe your finger back &amp; forth across the screen to see 2 apps in split screen.">
                <langSet xml:lang="en-US"><tig><term>Swipe your finger back &amp; forth across the screen to see 2 apps in split screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᎠᏨᏍᏗ ᎠᎴ ᎦᏌᏙᏯᏍᏗ ᏗᎦᎾᏗᏫᏍᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎠᎪᏩᏛᏗ 2 ᏗᎬᏙᏗ ᎾᎿ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting in landscape opens the rear camera.">
                <langSet xml:lang="en-US"><tig><term>Twisting in landscape opens the rear camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᎾᎿ ᎦᏅᎯᏒᎢ ᏓᏍᏚᎢ ᏥᎩ ᎣᏂᏗᏢ ᏗᏓᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting in portrait opens the selfie camera.">
                <langSet xml:lang="en-US"><tig><term>Twisting in portrait opens the selfie camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᎾᎿ ᎠᏰᎵ ᎠᎪᏩᏛᏙᏗ ᏓᏍᏚᎢ ᏥᎩ ᎣᏩᏒ ᏗᏓᏟᎶᏍᏔᏅ ᏗᏓᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Then, lift your finger.">
                <langSet xml:lang="en-US"><tig><term>Then, lift your finger.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏉᏃ, ᎠᏌᎳᏙᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch and hold the One Button Navigation until you feel a short buzz.">
                <langSet xml:lang="en-US"><tig><term>Touch and hold the One Button Navigation until you feel a short buzz.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎩᎳ ᏂᎯ ᎠᏒᎾᏍᏗ Ꭰ ᎤᏍᏆᎳ ᎤᏍᏆᏃᏴᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you're ready to unlock your device with just a glance">
                <langSet xml:lang="en-US"><tig><term>Now you're ready to unlock your device with just a glance</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎭᏛᏅᏍᏗ dᎤᎢᏍᏗ ᏂᎯ ᏥᏂᏕᎬᏅᏗᏓᏂ ᏣᎧᏛ ᏚᏳᎪᏛᏉ Ꭰ ᏗᎧᏅᏙᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the \“Microscreen is active\” notification">
                <langSet xml:lang="en-US"><tig><term>Tap on the \“Microscreen is active\” notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ \“Microscreen ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ\” ᎠᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Navigate through your device with simple gestures">
                <langSet xml:lang="en-US"><tig><term>Navigate through your device with simple gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎸ ᎠᏓᏅᏏᏓᏍᏗ ᏬᎶᎯᏍᏗ ᏂᏧᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ ᎠᎯᏓ ᎤᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, we\’re not able to open Visual Voicemail at this time. Please try again later. If there is still a problem, please contact Customer Service at  and tell them the error code is .">
                <langSet xml:lang="en-US"><tig><term>Sorry, we\’re not able to open Visual Voicemail at this time. Please try again later. If there is still a problem, please contact Customer Service at  and tell them the error code is .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎤᏰᎸᏅ, ᎢᏗ ᎥᏝ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᏍᏚᎢᏓ ᏓᏟᎶᏍᏛ ᎧᏁᎬ ᎤᎿᎢ ᎯᎠ ᎠᏥᎢᎵᏒ. ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ. ᎢᏳᏃ ᎤᎿᎢ ᏄᏍᏛ ᎠᏏᏉ Ꭰ ᏓᏓᎴᎬ, ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᎤᏩᏍᎩ ᏕᎦᎫᏍᏛᏁᎭ ᎤᎿᎢ  ᏃᎴ ᎤᏃᎮᏗ ᎢᏯᏂᎢ ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Lift the phone when it rings to immediately switch it to vibrate">
                <langSet xml:lang="en-US"><tig><term>Lift the phone when it rings to immediately switch it to vibrate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎳᏙᏗ ᏥᎩ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᎿ ᏧᏃᏴᎦ ᎾᎿᎢ ᎢᎬᏪᏅᏓᏉ ᎦᏁᏟᏴᏍᏗ ᎾᎿ ᎾᎿᎢ ᎠᎵᏖᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="With 3 of your fingers spread slightly apart, touch and hold on the screen">
                <langSet xml:lang="en-US"><tig><term>With 3 of your fingers spread slightly apart, touch and hold on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗ 3 ᎾᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᎦᏅᎯᏗᏍᎩ ᎠᏰᎦᎸᏛ ᏍᏗᎩᏓ ᏂᏚᏓᎳᏛᎢ, ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold to launch assistant">
                <langSet xml:lang="en-US"><tig><term>Hold to launch assistant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏂᏯ ᎭᏂᎩᏍᏙᏗ ᎠᎾᏓᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the volume keys to change tracks when the screen is off">
                <langSet xml:lang="en-US"><tig><term>Use the volume keys to change tracks when the screen is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎤᏃᏴᎬᎢ ᏗᏍᏚᎢᏍᏗ ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᎤᏔᏏᏄᏱ ᎢᏳᏃ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎨᎡᎢ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please check your data connectivity.">
                <langSet xml:lang="en-US"><tig><term>Please check your data connectivity.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏣᎦᏛᎲᎦ ᏣᏤᎵ ᎦᏟᏌᏅᎯ ᏕᎫᏓᎸᏛᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id=" video saved to &quot;&quot; album">
                <langSet xml:lang="en-US"><tig><term> video saved to "" album</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏗᏓᏴᎳᏛᏍᎩ ᎠᎵᏏᏅᏔᏅᎢ ᎾᎿᎢ "" ᎠᏜᏩᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip open or swipe up to answer">
                <langSet xml:lang="en-US"><tig><term>Flip open or swipe up to answer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏁᏍᏆᏚᎦ ᎯᏍᏚᎢ ᎠᎴ ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎾᎢ ᎦᏬᎯᎵᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ignore">
                <langSet xml:lang="en-US"><tig><term>Ignore</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏥᎭᎦᏎᏍᏔᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb settings">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT calling">
                <langSet xml:lang="en-US"><tig><term>RTT calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏫᏗᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="For example, aspirin">
                <langSet xml:lang="en-US"><tig><term>For example, aspirin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾ ᏱᏓᏥᎶᏍᏔᏅ, ᎠᎩᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" participant">
                <langSet xml:lang="en-US"><tig><term> participant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏖᎳᏗᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn\u00A0more">
                <langSet xml:lang="en-US"><tig><term>Learn\u00A0more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Airplane mode on and UIM off">
                <langSet xml:lang="en-US"><tig><term>Airplane mode on and UIM off</term></tig></langSet>
