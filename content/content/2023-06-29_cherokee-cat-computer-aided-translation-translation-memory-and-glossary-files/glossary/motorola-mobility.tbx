            </termEntry>
            <termEntry id="Your video call is now running on the mobile network.">
                <langSet xml:lang="en-US"><tig><term>Your video call is now running on the mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ Ꭷ ᎠᏂᎩᏍᏓ ᎤᎾᎢ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Certificate required to install a private key">
                <langSet xml:lang="en-US"><tig><term>Certificate required to install a private key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎦᏘᏅᏔᏅ Ꭰ ᎤᏕᎸᎢ ᎠᏍᏚᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press back to cancel at any time.">
                <langSet xml:lang="en-US"><tig><term>Press back to cancel at any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᏨᏍᏗ ᎾᎿᎢ ᎠᏎᏒᏗ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The primary benefit of Wi-Fi Calling is to increase your coverage in locations with Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>The primary benefit of Wi-Fi Calling is to increase your coverage in locations with Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏄᎬᏫᏳᏒ ᎤᎾᎵᏍᏕᎸᏔᏂᏓᏍᏗ ᎤᎿ Wi-Fi ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᎾᎿᎢ ᎤᏁᏉᏨᎢ ᏂᏨᎤᎢ ᎫᏢᏗ ᎾᎿ ᎤᏙᏢᏒᎢ ᎬᏗ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please Wait...">
