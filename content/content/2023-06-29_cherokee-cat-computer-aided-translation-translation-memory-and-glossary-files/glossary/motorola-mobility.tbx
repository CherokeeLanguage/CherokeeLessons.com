                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎯᏚᏛᎸᎦ ᎤᏰᎯᏍᏛ (ᎯᏍᏚᎠ) Wi-Fi ᏑᎾᏚᏓᎵ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow apps to show content around the camera cutout">
