            </termEntry>
            <termEntry id="Pointer location">
                <langSet xml:lang="en-US"><tig><term>Pointer location</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎯᎯ ᎤᏙᏢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flash entire window surfaces when they update">
                <langSet xml:lang="en-US"><tig><term>Flash entire window surfaces when they update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏂᎦᏛ ᏦᎳᏂ ᏗᎦᏚᎢ ᎾᎯᏳ ᏚᎪᏢᎯᏌᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show view updates">
                <langSet xml:lang="en-US"><tig><term>Show view updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᎠᎪᎵᏰᏗ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable USB audio routing">
                <langSet xml:lang="en-US"><tig><term>Disable USB audio routing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ USB ᎤᏃᏴᎬ ᏓᏅᎪᏗᏍᎬ ᎿᏛᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Desktop backup password">
                <langSet xml:lang="en-US"><tig><term>Desktop backup password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏍᎩᎶᎩ ᎦᏚ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Debugged application waits for debugger to attach before executing">
                <langSet xml:lang="en-US"><tig><term>Debugged application waits for debugger to attach before executing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎬᎢ ᎠᏔᏲᏍᏙᏗ ᏓᎦᏘᏴᎢ ᎾᏍᎩᎾ ᏗᎪᎷᏩᏘᏍᎩ ᎾᎢ ᎦᏯᎸᏗ ᎤᏓᎷᎸᎢ ᏕᎦᏌᏙᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Monitoring">
                <langSet xml:lang="en-US"><tig><term>Monitoring</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏎᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flash views inside windows when drawn">
                <langSet xml:lang="en-US"><tig><term>Flash views inside windows when drawn</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᎪᎵᏰᏗ ᎭᏫᎾᏗᏢ ᏗᏦᎳᏂ ᎾᎯᏳ ᏧᏎᏒᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flash hardware layers green when they update">
                <langSet xml:lang="en-US"><tig><term>Flash hardware layers green when they update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᏓᏰᎦᏢᎢ ᎢᏤᏳᏍᏗ ᎾᎯᏳ ᏚᎪᏢᎯᏌᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable HW overlays">
                <langSet xml:lang="en-US"><tig><term>Disable HW overlays</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ HW ᎦᏚᎢ ᏗᏰᏍᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Simulate color space">
                <langSet xml:lang="en-US"><tig><term>Simulate color space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏠᏱ ᏱᎬᏁᎸ ᎠᏑᏫᏓ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Debug non-rectangular clip operations">
                <langSet xml:lang="en-US"><tig><term>Debug non-rectangular clip operations</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎩ ᎥᏝ-ᎦᏅᎯᏓ ᏅᎩ ᏧᏅᏏᏯ ᎪᏪᎵ ᏗᎦᏛᏙᏗ ᏓᏂᏱᎵᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="A device wants to access your contacts and call log.">
                <langSet xml:lang="en-US"><tig><term>A device wants to access your contacts and call log.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᎠᎵ ᏪᏯᎾ ᎸᏛᏁᎸ ᎪᏪᎳᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show taps">
                <langSet xml:lang="en-US"><tig><term>Show taps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᏗᏐᎥᏍᏙᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show visual feedback for taps">
                <langSet xml:lang="en-US"><tig><term>Show visual feedback for taps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᎠᎪᏩᏛᏗ ᎦᏬᎯᎵᏴᏓ ᎾᏍᎩᎾ ᏗᏐᎥᏍᏙᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show surface updates">
                <langSet xml:lang="en-US"><tig><term>Show surface updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᎦᏚᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="In order to enable or disable an eSIM card, it's necessary to go to Mobile Network Settings.">
                <langSet xml:lang="en-US"><tig><term>In order to enable or disable an eSIM card, it's necessary to go to Mobile Network Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎬᏅᏗ ᏰᎵ ᎢᏳᎵᏍᏙᏗ ᎠᎴ ᎠᎴᏫᏍᏙᏗ eSIM ᎠᏆᏂᏲᏍᏗ, ᏱᏂᎦᎵᏍᏗᎠ ᎥᎾᎢ ᎠᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Always use GPU for screen compositing">
                <langSet xml:lang="en-US"><tig><term>Always use GPU for screen compositing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᎬᏙᏓ GPU ᎾᏍᎩᎾ ᎠᏴᏙᎳᏛᎢ ᏕᎪᏪᎵᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swap calls">
                <langSet xml:lang="en-US"><tig><term>Swap calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable OpenGL traces">
                <langSet xml:lang="en-US"><tig><term>Enable OpenGL traces</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎯᏍᏚᎢGL ᏗᏍᏓᏩᏛᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show layout bounds">
                <langSet xml:lang="en-US"><tig><term>Show layout bounds</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᏱᏗᎬᏂ ᏚᏂᏣᏖᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Force RTL layout direction">
                <langSet xml:lang="en-US"><tig><term>Force RTL layout direction</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏌᏙᏯᏍᏗ RTL ᏱᎬᏂ ᏫᏚᏳᎪᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Force screen layout direction to RTL for all locales">
                <langSet xml:lang="en-US"><tig><term>Force screen layout direction to RTL for all locales</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏌᏙᏯᏍᏗ ᎠᏴᏙᎳᏛᎢ ᏱᎬᏂ ᏫᏚᏳᎪᏛ ᎾᎾᎢ RTL ᎾᏍᎩᎾ ᏂᎦᏓ ᏤᏍᎦᏂᎨᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Force 4x MSAA">
                <langSet xml:lang="en-US"><tig><term>Force 4x MSAA</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏌᏙᏯᏍᏗ 4x MSAA</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable 4x MSAA in OpenGL ES 2.0 apps">
                <langSet xml:lang="en-US"><tig><term>Enable 4x MSAA in OpenGL ES 2.0 apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ 4x MSAA ᎾᎿᎢ ᎯᏍᏚᎢGL ES 2.0 ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable GPU debug layers">
                <langSet xml:lang="en-US"><tig><term>Enable GPU debug layers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ GPU ᎪᎷᏩᏘᏍᎩ ᏚᏰᎦᏢᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow loading GPU debug layers for debug apps">
                <langSet xml:lang="en-US"><tig><term>Allow loading GPU debug layers for debug apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎦᏢᏍᎬ GPU ᎪᎷᏩᏘᏍᎩ ᏚᏰᎦᏢᎢ ᎾᏍᎩᎾ d ᎪᎷᏩᏘᏍᎩ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Profile HWUI rendering">
                <langSet xml:lang="en-US"><tig><term>Profile HWUI rendering</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎧᏛ HWUI ᎢᏳᏍᏗ ᏓᏅᎪᏗᏍᎬᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable verbose vendor logging">
                <langSet xml:lang="en-US"><tig><term>Enable verbose vendor logging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎤᎶᏒᏍᏔᏅ ᎧᏁᏥᏙᎯ ᎦᎾᏕᎩ ᏄᏛᏁᎸᏅ ᎧᏃᎮᏠᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Animator duration scale">
                <langSet xml:lang="en-US"><tig><term>Animator duration scale</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏍᏗᏍᎩ ᎢᏳᏓᏅᎯᏓ ᎦᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make all activities resizable for multi-window, regardless of manifest values.">
                <langSet xml:lang="en-US"><tig><term>Make all activities resizable for multi-window, regardless of manifest values.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎾᎵᏖᎸᎲᏍᎬ ᏂᎬ ᎦᏁᏟᏴᏍᏔᏅᎩ ᏂᎦᏓ ᏱᏗᎬᏁᏗ ᎾᏍᎩᎾ ᎢᎸᏍᎩ-ᏦᎳᏂ, ᎾᏂᏰᎸᏍᎬᎢ ᎥᎿᎢ of ᎬᏂᎨᏒᎢ ᏗᎬᏩᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable support for experimental freeform windows.">
                <langSet xml:lang="en-US"><tig><term>Enable support for experimental freeform windows.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎦᎫᏍᏛᏓ ᎾᏍᎩᎾ ᎠᏁᎸᏔᏂᏓᏍᏗ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᏗᏦᎳᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to activate Wi-Fi calling.">
                <langSet xml:lang="en-US"><tig><term>Unable to activate Wi-Fi calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ Wi-Fi ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="MAC is randomized">
                <langSet xml:lang="en-US"><tig><term>MAC is randomized</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>MAC ᎾᏍᎩ ᏅᎦᏖᏃᎸᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Read/Write clogo block">
                <langSet xml:lang="en-US"><tig><term>Read/Write clogo block</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ/ᎪᏪᎶᏗ clogo ᎦᏐᎭᎾᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Window animation scale">
                <langSet xml:lang="en-US"><tig><term>Window animation scale</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Window ᎠᏓᏅᏏᏙᎯ ᎦᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Simulate secondary displays">
                <langSet xml:lang="en-US"><tig><term>Simulate secondary displays</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏠᏱ ᏱᎬᏁᎸᎢ ᏔᎵᏁᎢ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show background ANRs">
                <langSet xml:lang="en-US"><tig><term>Show background ANRs</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ANRs</term></tig></langSet>
            </termEntry>
            <termEntry id="Try disconnecting, then reconnecting the USB cable.">
                <langSet xml:lang="en-US"><tig><term>Try disconnecting, then reconnecting the USB cable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᎱᏓᎳᏍᎬᎢ, ᎾᏉᏃ ᏙᎫᏓᎸᎲᏍᎩ ᏥᎩ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show notification channel warnings">
