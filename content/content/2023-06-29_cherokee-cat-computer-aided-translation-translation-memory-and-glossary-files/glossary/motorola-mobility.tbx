                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᏄᏩᏅ ᎢᏧᎳ ᎤᏃᏴᎬᎢ ᏗᏍᏚᎢᏍᎦ ᎾᏍᎩᎾ ᎦᏲᎵ ᏓᏓᎾᏩᏍᎬᎢ ᎬᏴᏍᏗ ᎨᏒ ᏗᎦᏎᏍᏙᏗ ᏓᏍᏚᎢᏍᎪᎢ ᏗᎦᏎᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Current features:You can change selected features in Settings &gt; Accessibility.">
                <langSet xml:lang="en-US"><tig><term>Current features:You can change selected features in Settings &gt; Accessibility.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊᏥᎩ ᏗᎦᏎᏍᏙᏗ:ᏂᎯ ᏰᎵᏊ ᎯᏁᏟᏴᎾ ᎠᏑᏰᏛ ᏗᎦᏎᏍᏙᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ &gt; ᎬᏴᏍᏗ ᎨᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Authentication via the proxy server was unsuccessful.">
                <langSet xml:lang="en-US"><tig><term>Authentication via the proxy server was unsuccessful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᎢᏗᏢ ᎾᏍᎩ ᏗᏯᏙᎯᎯ ᏗᏯᏙᎮᎯ ᎾᏍᎩ ᎤᏓᏄᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Caller ID defaults to not restricted.">
