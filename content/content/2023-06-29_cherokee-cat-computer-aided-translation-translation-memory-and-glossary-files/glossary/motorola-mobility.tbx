            </termEntry>
            <termEntry id="Call is transferring to the cellular network. Voice and data rates may apply.">
                <langSet xml:lang="en-US"><tig><term>Call is transferring to the cellular network. Voice and data rates may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎨᎡᎢ ᏙᏓᏰᏣᏲᎯᏎᎵ ᎾᎿᎢ ᏥᎩ ᏫᏚᏍᏗᎬᎢ ᎫᏓᎸᎢ. ᎤᏁᎬ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᏗᎪᏣᎴᏒᏛ ᏰᎵᏯ ᎲᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" app blocked">
                <langSet xml:lang="en-US"><tig><term> app blocked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎬᏙᏗ ᎠᏍᏚᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Color inversion">
                <langSet xml:lang="en-US"><tig><term>Color inversion</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ ᎠᏨᏍᏔᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id=" selected">
                <langSet xml:lang="en-US"><tig><term> selected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏑᏰᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smoothest gaming experience, uses more battery and processing power.">
                <langSet xml:lang="en-US"><tig><term>Smoothest gaming experience, uses more battery and processing power.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᎯᏗᏴᎢ ᏗᏁᎸᏗᏍᎬᎢ ᏄᎵᏍᏔᏂᏙᎸᎢ,  ᎬᏔᏂᏓᏍᏗ ᎤᎪᏗ ᎠᎾᎦᎵᏍᎩ ᎠᎴ ᎠᎯᎸᏍᏗᏍᎬ ᎤᏟᏂᎩᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap twice on the screen to wake up Peek Display">
                <langSet xml:lang="en-US"><tig><term>Tap twice on the screen to wake up Peek Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏗ ᏔᎵ ᎢᏳᏩᏔ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ ᎾᎢ ᏱᏰᏍᏗ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
