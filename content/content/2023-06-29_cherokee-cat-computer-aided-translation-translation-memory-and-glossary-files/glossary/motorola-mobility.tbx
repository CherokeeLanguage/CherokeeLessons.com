            <termEntry id=" is in picture-in-picture">
                <langSet xml:lang="en-US"><tig><term> is in picture-in-picture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏄᏍᏛ ᎾᎿᎢ ᏗᏓᏟᎶᏍᏔᏅ-ᎾᎿᎢ-ᏗᏓᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
