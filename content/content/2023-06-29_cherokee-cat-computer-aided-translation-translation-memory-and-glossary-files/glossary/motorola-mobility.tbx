                <langSet xml:lang="chr"><tig><term>1 ᎬᏙᏗ ᎬᏔᏅᎯ ᎠᏅᏓᏗᏍᏙᏗ ᎾᎿᎢ ᎣᏂ </term></tig></langSet>
            </termEntry>
            <termEntry id="Device protection features won\u2019t be turned on.">
