            </termEntry>
            <termEntry id="Data associated with your account, such as email and calendar info">
                <langSet xml:lang="en-US"><tig><term>Data associated with your account, such as email and calendar info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᏚᎵᎪᏒᎢ ᎬᏗ ᏂᏨᎤᎢ ᎠᏚᏓᎸᏙᏗ, ᏕᎧᏁᎢᏍᏔᏅᎯ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏃᎴ ᏅᏓ ᏗᏎᏍᏗ ᎧᏃᎮᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only one SIM can be active at a time.Switching to  won\u2019t cancel your  service.">
                <langSet xml:lang="en-US"><tig><term>Only one SIM can be active at a time.Switching to  won\u2019t cancel your  service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᏌᏇ SIM ᏰᎵᏯ ᎨᎡᎩ ᎬᏂᎦᎵᏍᏗ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ.ᎠᏓᏁᏟᏴᎢ ᎾᎿᎢ  ᎭᏗ ᏰᎴ ᎠᏎᏒᏗ ᏂᏨᎤᎢ  ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This APN cannot be changed.">
                <langSet xml:lang="en-US"><tig><term>This APN cannot be changed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ APN ᎨᏍᏗ ᏰᎵ ᎨᎡᎩ ᎦᏁᏟᏴᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Never">
                <langSet xml:lang="en-US"><tig><term>Never</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When using 2 SIMs, this tablet will be limited to 4G. Learn more">
                <langSet xml:lang="en-US"><tig><term>When using 2 SIMs, this tablet will be limited to 4G. Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏔᏂᏓᏍᏗ 2 SIMs, ᎯᎠ ᏗᎪᏪᎶᏗᎢ ᎠᏎ ᎨᎡᎩ ᏩᏎᏢᏊ ᎾᎿᎢ 4G. ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected apps share permissions and can access each other\u2019s data.">
                <langSet xml:lang="en-US"><tig><term>Connected apps share permissions and can access each other\u2019s data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ ᏗᎬᏙᏗ ᎠᏯᏙᎯᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏃᎴ ᏰᎵᏊ ᎠᏴᏍᏗ ᏧᏤᎵᏛ ᎠᏂᏐᎢ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" of data used">
                <langSet xml:lang="en-US"><tig><term> of data used</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎥᎿᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="About accessibility button">
                <langSet xml:lang="en-US"><tig><term>About accessibility button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ ᎬᏴᏍᏗ ᎨᏒᎢ ᎠᏐᏅᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about time to take action (Accessibility timeout)">
                <langSet xml:lang="en-US"><tig><term>Learn more about time to take action (Accessibility timeout)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏗᎢ ᎢᎸᏨ ᎠᏥᎢᎵᏒ to ᎠᎩᏍᏗ ᎢᏯᏛᏁᏗ (ᎬᏴᏍᏗ ᎨᏒ ᏙᏖᏙᎵ)</term></tig></langSet>
            </termEntry>
            <termEntry id="mobile data">
                <langSet xml:lang="en-US"><tig><term>mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="{count, plural, offset:2 =0 {Nothing can interrupt} =1 {{sound_category_1} can interrupt} =2 {{sound_category_1} and {sound_category_2} can interrupt} =3 {{sound_category_1}, {sound_category_2}, and {sound_category_3} can interrupt} other {{sound_category_1}, {sound_category_2}, and # more can interrupt} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, offset:2 =0 {Nothing can interrupt} =1 {{sound_category_1} can interrupt} =2 {{sound_category_1} and {sound_category_2} can interrupt} =3 {{sound_category_1}, {sound_category_2}, and {sound_category_3} can interrupt} other {{sound_category_1}, {sound_category_2}, and # more can interrupt} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, offset:2 =0 {ᎥᏝ ᎪᎱᏍᏗ ᏰᎵ ᎤᏓᏲᏍᏓᏁᎸᎩ} =1 {{sound_category_1} ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} =2 {{sound_category_1} ᏃᎴ {sound_category_2} ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} =3 {{sound_category_1}, {sound_category_2}, ᏃᎴ {sound_category_3} ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} other {{sound_category_1}, {sound_category_2}, ᏃᎴ # ᎤᏥ ᎢᎦᎢ ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="USSD services are not possible via Wi-Fi Calling.As this type of service requires cellular network coverage (2G/3G) to proceed, they cannot be executed in airplane mode.">
                <langSet xml:lang="en-US"><tig><term>USSD services are not possible via Wi-Fi Calling.As this type of service requires cellular network coverage (2G/3G) to proceed, they cannot be executed in airplane mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USSD ᎢᏗᏓᏛᏁᏗᎢ ᎨᏍᏗ ᏰᎵ ᏴᏅᏛᎦ Ꮎ Wi-Fi ᏫᏴᎾᎯᎠ ᏗᏓᏛᏁᏗᎢ ᎠᏎ ᏗᏝᏃᎮᏗ ᏧᎾᏚᏓᎵ ᎫᏝᎢ (2G/3G) ᎠᎯᎵᏒ, ᎭᏗ ᎡᎵ ᏴᎲᏓ ᏥᏳᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Require pattern to start up your device. While off, this device can't receive calls, messages, notifications, or alarms.">
                <langSet xml:lang="en-US"><tig><term>Require pattern to start up your device. While off, this device can't receive calls, messages, notifications, or alarms.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᎠᏂᎩᏍᏙᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎾᎯᏳᎢ ᎠᏍᏚᎭ, ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᏓᏯᏂ, ᏗᎪᎵᏰᏗ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᏗᏓᏕᏯᏙᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This device can have 2 SIMs active at once. To continue using 1 SIM at a time, tap &quot;No thanks&quot;.">
                <langSet xml:lang="en-US"><tig><term>This device can have 2 SIMs active at once. To continue using 1 SIM at a time, tap "No thanks".</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏯ ᎤᎭ 2 SIMs ᎬᏂᎦᎵᏍᏗ ᎤᎿᎢ ᏌᏊᏊ. ᎾᎿᎢ ᏂᎦᏯᎢᏒ ᎬᏗᎭ 1 SIM ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ, ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ "ᎭᏗ ᎠᎾᎵᎮᎵᎬ".</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data usage cycle">
                <langSet xml:lang="en-US"><tig><term>Mobile data usage cycle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ ᎤᏕᏲᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you allow data roaming, roaming charges may apply.This setting affects all users on this tablet.">
                <langSet xml:lang="en-US"><tig><term>When you allow data roaming, roaming charges may apply.This setting affects all users on this tablet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ, ᎡᏙᎵᏙᎲ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎲᏓ.ᎯᎠ ᏕᎦᎧᎲᎢ ᏂᏙᏓᎬᏂᏌᏂ ᏂᎦᏓ ᏗᏅᏗᏍᎩ ᎤᎿᎢ ᎯᎠ ᏗᎪᏪᎶᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not a conversation">
                <langSet xml:lang="en-US"><tig><term>Not a conversation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ Ꮎ ᎠᎾᏟᏌᎮᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your new ^1 is working. To move photos, files, and app data to this device, go to Settings &gt; Storage.">
                <langSet xml:lang="en-US"><tig><term>Your new ^1 is working. To move photos, files, and app data to this device, go to Settings &gt; Storage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏤ ^1 ᎨᎡᎢ ᏚᏂᎸᏫᏍᏓᏁᎲ. ᎾᎿᎢ ᎠᎲᏍᏗ ᏟᎶᏍᏔᏅᎯ, ᏗᏍᏆᏂᎪᏙᏗ, ᏃᎴ ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ, ᏤᏅᏍᏗ ᏕᎦᎧᎲᎢ &gt; ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data is off">
                <langSet xml:lang="en-US"><tig><term>Mobile data is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can move your photos, files, and some apps to this new ^1. The move takes about ^2 and will free ^3 on internal storage. Some apps won\u2019t work while it\u2019s underway.">
                <langSet xml:lang="en-US"><tig><term>You can move your photos, files, and some apps to this new ^1. The move takes about ^2 and will free ^3 on internal storage. Some apps won\u2019t work while it\u2019s underway.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ, ᏗᏍᏆᏂᎪᏙᏗ, ᏃᎴ ᎢᎦᏓ ᏗᎬᏙᏗ ᎾᎿᎢ ᎯᎠ ᏗᏤ ^1. ᏥᎩ ᎠᎲᏍᏗ ᎠᎩᏍᎪᎢ ᎢᎸᏨ ^2 ᏃᎴ ᎠᏎ ᏗᏣᏲᎯᏍᏗ ^3 ᎤᎿᎢ ᎭᏫᏂ ᎠᏍᏆᏂᎪᏙᏗ. ᎢᎦᏓ ᏗᎬᏙᏗ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎯᏳᎢ ᎨᎡᎢ ᎤᏓᏄᏴᏛᎢ ᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data. Encryption takes an hour or more, during which the tablet will restart several times.">
                <langSet xml:lang="en-US"><tig><term>The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data. Encryption takes an hour or more, during which the tablet will restart several times.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏕᎵᏍᏙᏗ ᎠᎢᏒᎢ ᏄᏍᏛ ᎪᎯᏓ ᏗᎨᏛᏍᎩ ᏃᎴ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎦᏘᏍᎩᏌᏅᎯ. ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᏃᎴ ᎤᎪᏗᏊ, ᎾᎯᏳ ᎦᏙᎤᏍᏗ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎢᎸᏍᎩ ᎢᏳᏩᏗ.</term></tig></langSet>
            </termEntry>
