            </termEntry>
            <termEntry id="Turning on Airplane Mode disables all network features including calling, messaging, mobile data, Wi-Fi, and Bluetooth.">
                <langSet xml:lang="en-US"><tig><term>Turning on Airplane Mode disables all network features including calling, messaging, mobile data, Wi-Fi, and Bluetooth.</term></tig></langSet>
