                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency calls via WiFi Calling">
                <langSet xml:lang="en-US"><tig><term>Emergency calls via WiFi Calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏗ ᏩᏴᏅᏗ Ꮎ WiFi ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="The device switches automatically to a cellular network (2G/3G) to place an emergency call.">
                <langSet xml:lang="en-US"><tig><term>The device switches automatically to a cellular network (2G/3G) to place an emergency call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏱᎬᏁᏟᏴᎾ ᎤᏩᏒ Ꮎ ᏕᎫᏓᎸ ᏧᎾᏚᏓᎵ (2G/3G) ᏱᏣᏚᎵ ᎤᏟᏍᏗ ᏪᏯᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app couldn't be uninstalled but was disabled and is no longer accessible To enable it again, open the Apps page on the Settings app">
                <langSet xml:lang="en-US"><tig><term>This app couldn't be uninstalled but was disabled and is no longer accessible To enable it again, open the Apps page on the Settings app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ Ꮭ ᏯᎯᏘᏅᏓᎩ ᎠᏎᏃ ᎠᎴᏫᏍᏙᏛᏅ Ꮰ ᏃᏭ ᏴᎲᏓT  ᏱᏣᏚᎵ ᎤᏩᏂᎩᏍᏗ, ᏥᎯᏍᏚ ᏗᎩᏙᏗ ᎤᎦᏅᏓᏛᎢ ᎾᏕᎦᎧᎲᎢ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disabling 2G">
                <langSet xml:lang="en-US"><tig><term>Disabling 2G</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ 2Ꮆ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency calls are not possible via WiFi Calling.">
                <langSet xml:lang="en-US"><tig><term>Emergency calls are not possible via WiFi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏗ ᏩᏴᏅᏗ Ꮭ ᏱᏅᎦᎵᏍᏓ Ꮎ WiFi ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block Gestures">
                <langSet xml:lang="en-US"><tig><term>Block Gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ ᏚᏂᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This is a critical app that can't be uninstalled or disabled">
                <langSet xml:lang="en-US"><tig><term>This is a critical app that can't be uninstalled or disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ Ꮭ ᏯᎯᏘᏅᏓᎩ ᎠᎴ ᏴᎲᎴᏫᏍᏙᏓ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Specify when to turn off the inactive Mobile Hotspot automatically">
                <langSet xml:lang="en-US"><tig><term>Specify when to turn off the inactive Mobile Hotspot automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎯᏳᏗᏍᎬ ᏘᏍᏚᏂᏒ ᏂᏚᎸᏫᏍᏓᏁᎮᎢ ᎠᏂᎩᏍᎩ ᎤᏗᏞᎩᎫᏓᎸ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about magnification">
                <langSet xml:lang="en-US"><tig><term>Learn more about magnification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏗᎢ ᎢᎸᏨ ᎠᏔᏃᎯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allowing 2G service could increase the success of some apps and features working in locations with limited cellular coverage.">
                <langSet xml:lang="en-US"><tig><term>Allowing 2G service could increase the success of some apps and features working in locations with limited cellular coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎵᏍᎪᎵᏔᏅ 2Ꮆ ᏳᏛᏁᏗ ᎧᏁᏉᏨᎢ ᎠᏍᏆᏙᏅᎢ ᎬᏙᏗ ᎠᎴ ᏗᎦᏎᏍᏙᏗ ᏧᎸᏫᏍᏓᏁᎯ ᎤᏙᏢᏒ ᎠᏎᎸᎯ ᏗᏢᏃᎮᏗ ᎫᏝᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id=" apps are available">
                <langSet xml:lang="en-US"><tig><term> apps are available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ Ꮭ ᏗᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="No Wi-Fi devices connected">
                <langSet xml:lang="en-US"><tig><term>No Wi-Fi devices connected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ Wi-Fi ᏥᏂᏕᎬᏅᏗᏓᎾ ᏕᎫᏓᎸᎥᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To get quick shortcuts anytime, you can double tap or swipe on the power key">
                <langSet xml:lang="en-US"><tig><term>To get quick shortcuts anytime, you can double tap or swipe on the power key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᏍᏆᎳ ᏱᏗᎬᏁᎯ ᏁᎵᏒᏭ, ᏔᎵ ᎢᏳᏩᏉᏘ ᎭᏐᏅᏍᏓ Ꮎ ᎦᎶᎯᏍᏗᏍᎩ ᎠᎴ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No cable?">
                <langSet xml:lang="en-US"><tig><term>No cable?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ?</term></tig></langSet>
            </termEntry>
            <termEntry id="When this is turned off, you\u2019ll need to press the power key to unlock.">
                <langSet xml:lang="en-US"><tig><term>When this is turned off, you\u2019ll need to press the power key to unlock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎯᎠ ᎠᏍᏛᎯᎦ, ᏂᎯ\u2019II ᎤᏚᎸᏗ ᎭᏐᎥᏍᏓ Ꮎ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ ᎤᏂᏐᎭᎾᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Back, Home, Recent">
                <langSet xml:lang="en-US"><tig><term>Back, Home, Recent</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ, ᏧᏪᏅᏒ, ᎾᏞᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Super Slow Motion limit reached">
                <langSet xml:lang="en-US"><tig><term>Super Slow Motion limit reached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳ ᎤᏍᎦᏃᎳ ᎠᏓᏅᏏᏒᎭ ᎠᏎᎸᎯ ᏭᎷᏨᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Locked &amp; unlocked external display">
                <langSet xml:lang="en-US"><tig><term>Locked &amp; unlocked external display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᎴ Ꮭ ᏍᏓᏱ ᏯᏍᏚᎭ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To capture photos with the flip closed, twist your wrist twice to open the camera.">
                <langSet xml:lang="en-US"><tig><term>To capture photos with the flip closed, twist your wrist twice to open the camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᎦᏂᏴᏍᎬ ᏗᏟᎶᏍᏔᏅᎯ ᎬᏗ ᎠᏗᏅᏗ ᎠᎵᏍᏚᎲᏍᎩ, ᏍᏕᏯᏍᏗ ᏔᎵ ᎢᏳᏩᏗ ᏂᏣᏤᎵ ᎠᎵᏰᏑᏜᏗᏍᏗ ᎯᏍᏚᎢᏍᎬ Ꮎ ᏗᏓᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The submitted XML data does not comply with XSD requirements. Please check data validity">
                <langSet xml:lang="en-US"><tig><term>The submitted XML data does not comply with XSD requirements. Please check data validity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏗᎨᏥᏲᎯᏎᎸᎯ XML ᎦᏘᏍᎩᏌᏅᎯ ᎥᏝ ᏱᏓᏍᏓᏩᏕᎦ ᎬᏗ XSD ᎠᏎ ᎢᏗᏛᏁᏗᎢ. ᎰᏩᏊ ᏣᎦᏛᎲᎦ ᎦᏘᏍᎩᏌᏅᎯ ᏙᎯᏳᎢ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now that you've added a fingerprint, you can unlock your phone by touching the fingerprint sensor.">
                <langSet xml:lang="en-US"><tig><term>Now that you've added a fingerprint, you can unlock your phone by touching the fingerprint sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏊ Ꮎ ᏂᎯᏃ ᎧᏁᏉᏓ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ, ᎡᎵᏊ ᏂᎯ ᏦᏐᎭᎾᎳᎩ ᏂᏨᏅ ᏗᏟᏃᎮᏗ ᎬᏗ ᎭᏐᎥᏍᏗᏍᎬ Ꮎ ᎦᏰᏌᏛᎢᏅᎥᏪᎸᎢ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Button Position">
                <langSet xml:lang="en-US"><tig><term>Button Position</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏐᎥᏍᏙᏗ ᎦᎪᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only turn off 5G Standalone if advised by your wireless carrier.">
                <langSet xml:lang="en-US"><tig><term>Only turn off 5G Standalone if advised by your wireless carrier.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎠᏍᏚᏗ 5G ᎦᏙᎬᎤᏩᏒ ᎢᏳᏃ ᎤᏓᏬᏅᏔᏅᎩ ᎬᏗ ᏂᏨᏅᎢ ᏂᏓᏏᎳᏛᎾ ᎠᏓᏁᏢᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No Internet connection">
                <langSet xml:lang="en-US"><tig><term>No Internet connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Work profile accounts - ">
                <langSet xml:lang="en-US"><tig><term>Work profile accounts - </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏗᏚᏓᎸᏙᏗ - </term></tig></langSet>
            </termEntry>
            <termEntry id="Personal profile accounts">
                <langSet xml:lang="en-US"><tig><term>Personal profile accounts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎤᏤᎵ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏗᏚᏓᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It’s a great way to capture wide angle shots with just one hand.">
                <langSet xml:lang="en-US"><tig><term>It’s a great way to capture wide angle shots with just one hand.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏒᏍᏔᏅ ᎢᏯᏛᏗ  ᎥᎦᏂᏴᏗ ᎾᏯᏛᎥ ᏓᏍᏓᏅᏅ ᏚᎷᏨ ᏛᏟᎶᏍᏗᏍᎬ ᎬᏗ ᏗᎪᎸᎩ ᏌᏊ ᎤᏬᏰᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto makes it easy to open the camera, even when your device is locked.">
                <langSet xml:lang="en-US"><tig><term>Moto makes it easy to open the camera, even when your device is locked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎼᏙ ᏂᎬᏁᎠ ᎠᏂᏗᎨ ᎠᏍᏚᎢᏍᏗ Ꮎ ᏗᏓᏟᎶᏍᏗᏍᎩ,  ᎥᏍᏊ ᎾᎯᏳ ᏂᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏍᏓᏯ ᎠᏍᏚᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lights appear on the edges for alarms, notifications, and incoming calls.">
                <langSet xml:lang="en-US"><tig><term>Lights appear on the edges for alarms, notifications, and incoming calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏨᏍᏛ ᎦᎾᎨᏒ ᏄᏍᏗ ᎾᎢ ᏓᏍᏛᎢ ᏗᏓᏕᏍᏙᏗᏍᎩ,  ᏗᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᏕᎦᎷᎬ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Work account - ">
                <langSet xml:lang="en-US"><tig><term>Work account - </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᎸᏫᏍᏓᏁᏗ ᎠᏚᏓᎸᏗ - </term></tig></langSet>
            </termEntry>
            <termEntry id="Enable Face Detection">
                <langSet xml:lang="en-US"><tig><term>Enable Face Detection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎧᏁᏉᏍᏗᏍᎬ ᏚᎾᏄᎪᏫᏍᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Brightness level">
                <langSet xml:lang="en-US"><tig><term>Brightness level</term></tig></langSet>
