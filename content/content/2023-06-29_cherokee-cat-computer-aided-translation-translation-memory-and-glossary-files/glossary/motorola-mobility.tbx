                <langSet xml:lang="en-US"><tig><term>Camera has been turned back on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᎭ ᏭᏪᏙᎸ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏨᏍᏗ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id=" turned camera on">
                <langSet xml:lang="en-US"><tig><term> turned camera on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏭᎪᎸᏍᏔᏁᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id=" turned camera off">
                <langSet xml:lang="en-US"><tig><term> turned camera off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏭᎪᎸᏍᏔᏁᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="One-way camera">
