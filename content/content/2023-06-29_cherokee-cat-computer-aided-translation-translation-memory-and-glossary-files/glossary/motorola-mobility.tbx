            </termEntry>
            <termEntry id="Continue to the  app to install voices">
                <langSet xml:lang="en-US"><tig><term>Continue to the  app to install voices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᎵᏱᎵᏒ ᎾᎿᎢ ᏥᎩ  ᎬᏙᏗ ᎾᎿᎢ ᎯᏘᏅᎦ ᎧᏁᎬ</term></tig></langSet>
            </termEntry>
