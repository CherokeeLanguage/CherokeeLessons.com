                <langSet xml:lang="en-US"><tig><term>Handwriting language</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏬᏰᏂ ᎪᏪᎶᏔᏅ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block calls and texts from">
                <langSet xml:lang="en-US"><tig><term>Block calls and texts from</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ ᏓᏯᏂ ᏃᎴ ᏗᎪᎵᏰᏗ ᏂᏓᏳᏓᎴᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again later.">
                <langSet xml:lang="en-US"><tig><term>Please try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Password incorrect. SIM now locked. Enter PUK2.">
                <langSet xml:lang="en-US"><tig><term>Password incorrect. SIM now locked. Enter PUK2.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᏂᏚᏳᎪᏛᎾ SIM ᏍᏓᏯ. ᎠᏍᏚᎭ ᎠᏴᏍᏗ PUK</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Text (RTT) Call">
                <langSet xml:lang="en-US"><tig><term>Real Time Text (RTT) Call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT) ᏫᎬᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your live stream has been paused">
                <langSet xml:lang="en-US"><tig><term>Your live stream has been paused</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏃᏊᏥᎩ ᎤᏪᎬ ᏂᎦᎵᏍᏓ ᎠᏲᎯᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Handwriting language">
                <langSet xml:lang="en-US"><tig><term>Handwriting language</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏬᏰᏂ ᎪᏪᎶᏔᏅ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This action can be performed only when mobile network is available.">
                <langSet xml:lang="en-US"><tig><term>This action can be performed only when mobile network is available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎢᏯᏓᏛᏁᏗ ᎠᏎᎢᏯᏛᏁᏗ ᏫᏚᏍᏗᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT setting can not be modified during this call.">
                <langSet xml:lang="en-US"><tig><term>RTT setting can not be modified during this call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏕᎦᎧᎲᎢ ᏰᎵᏊ ᎨᏍᏗ ᏰᎵ ᎦᏁᏟᏴᏗ ᎾᎯᏳ ᎯᎠ ᏫᎬᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to get your Friend Lists.">
                <langSet xml:lang="en-US"><tig><term>Failed to get your Friend Lists.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎾᎿᎢ ᎠᎩᏍᏗ ᏂᏨᎤᎢ ᎢᏍᏓᎵ ᏚᏓᏅᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To make AT&amp;T video calls, turn on Mobile data.">
                <langSet xml:lang="en-US"><tig><term>To make AT&amp;T video calls, turn on Mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏂᏕᎬᎦ AT&amp;T ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ, ᎯᏍᏚᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="96 kbps">
                <langSet xml:lang="en-US"><tig><term>96 kbps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>96 kbps</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on  may cause you cannot receive voicemails for calling accounts . To avoid this conflict, please turn off Moto voicemail first and then tap continue.">
                <langSet xml:lang="en-US"><tig><term>Turning on  may cause you cannot receive voicemails for calling accounts . To avoid this conflict, please turn off Moto voicemail first and then tap continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᎢᏍᎬ  ᏰᎵᏯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᎥᎧᏁᎬᎢ ᎤᎬᏩᏟ ᏓᏯᏂᏍᎬ ᏗᏚᏓᎸᏙᏗ . ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎯᎠ ᏂᏓᏙᎵᎬᎾ, ᎰᏩᏊ ᎠᏍᏚᏗ Moto ᎥᎧᏁᎬᎢ ᎠᎬᏱ ᏃᎴ ᎢᏳᏃ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎯᎸᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Text (RTT)">
                <langSet xml:lang="en-US"><tig><term>Real Time Text (RTT)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT)</term></tig></langSet>
            </termEntry>
            <termEntry id="Your network is unavailable now.">
                <langSet xml:lang="en-US"><tig><term>Your network is unavailable now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏧᎾᏚᏓᎵ ᎨᎡᎢ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Other language">
                <langSet xml:lang="en-US"><tig><term>Other language</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏐᎢ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="USER BUSY">
                <langSet xml:lang="en-US"><tig><term>USER BUSY</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎩ ᏕᏣᎸᏫᏍᏓᏁ</term></tig></langSet>
            </termEntry>
            <termEntry id="Background Effect">
                <langSet xml:lang="en-US"><tig><term>Background Effect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᏄᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Live Stream">
                <langSet xml:lang="en-US"><tig><term>Moto Live Stream</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏊᏥᎩ ᎤᏪᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Badge icon">
                <langSet xml:lang="en-US"><tig><term>Badge icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎧᏁᏍᏗ ᎠᎢᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Collecting log">
                <langSet xml:lang="en-US"><tig><term>Collecting log</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏏᏍᎬ ᏄᏛᏁᎸ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="When using the Real Time Text (RTT) keyboard during a call, your device sends text instantly as you type. The recipient can immediately read your message while it is being written without waiting.">
                <langSet xml:lang="en-US"><tig><term>When using the Real Time Text (RTT) keyboard during a call, your device sends text instantly as you type. The recipient can immediately read your message while it is being written without waiting.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎬᏗᏍᎬ ᎾᏍᎩ ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT) ᏗᏐᏅᏍᏙᏗ ᎾᎯᏳ ᏫᎬᏔᏅ, ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏫᏗᎦᏅᏍᎩ ᎪᏪᎳᏅᎢ ᎤᎵᏍᏗᏓᏬ ᎯᎢᎾᎢ ᏂᎯ ᎢᏳᏍᏗ. ᎾᏍᎩᏃ ᏗᎦᏁᏍᎩ ᏰᎵᏊ ᎠᎴᏉ ᎠᎪᎵᏰᏗ ᏣᏤᎵ ᎧᏃᎮᏍᎩ ᎾᎯᏳᎢ ᎾᏍᎩ ᎠᏃᏪᎵᏍᎬ ᏄᏂᎦᏘᏛᎾᏬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select Privacy">
                <langSet xml:lang="en-US"><tig><term>Select Privacy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎤᏕᎵᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call forwarding function is not allowed while roaming.">
                <langSet xml:lang="en-US"><tig><term>Call forwarding function is not allowed while roaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᏔᏅ ᎠᎬᏱᏗᏨ ᎠᎾᎩᏍᏗ ᏚᎸᏫᏍᏓᏁᎲ ᏝᏱᎩ ᎠᎵᏍᎪᎸᏔᏅ ᎾᎯᏳᎢ ᎡᏙᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call not connected.">
                <langSet xml:lang="en-US"><tig><term>Call not connected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᏔᏅ ᎭᏗ ᏱᏣᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot perform this action, needs mobile network.">
                <langSet xml:lang="en-US"><tig><term>Cannot perform this action, needs mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎢᏯᏛᏁᏗ ᎯᎠ ᎠᎵᏖᎸᏗ, ᏚᏚᎸᏛᎢ ᎠᏓᏅᏏᏙᎯ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="got it">
                <langSet xml:lang="en-US"><tig><term>got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT keyboard and Video calling cannot be on at the same time. Video calling setting will be turned off and you will not be able to make or receive video calls. Also, you will not be able to merge calls.">
                <langSet xml:lang="en-US"><tig><term>RTT keyboard and Video calling cannot be on at the same time. Video calling setting will be turned off and you will not be able to make or receive video calls. Also, you will not be able to merge calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏗᏐᏅᏍᏙᏗ ᏃᎴ ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏗᏍᎩ ᎨᏍᏗ ᏰᎵ ᎠᏍᏚᎢᏓ ᎾᎿᎢ ᎾᏍᎩ ᎾᎯᏳᏉ ᎠᏥᎢᎵᏒ. ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏗᏍᎩ ᏕᎦᎧᎲᎢ ᏰᎵᏉ ᎠᏍᏚᏓ ᎨᏎᏍᏗ ᏃᎴ ᏂᎯ ᏰᎵᏊ ᎨᏍᏗ ᏰᎵ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᎪᏒᏗ ᎠᎴᏃ ᎠᎩᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ. ᎾᏍᏉ, ᏂᎯ ᏰᎵᏉ ᎨᏍᏗ ᏰᎵ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᏓᏠᎯᏍᏛ ᏫᏗᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not show this again.">
                <langSet xml:lang="en-US"><tig><term>Do not show this again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᎪᏩᏛᏗ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call Not Connected">
                <langSet xml:lang="en-US"><tig><term>Call Not Connected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᏔᏅ ᎭᏗ ᏱᏣᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Live Stream needs permission to access some things on your device.">
                <langSet xml:lang="en-US"><tig><term>Moto Live Stream needs permission to access some things on your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏊᏥᎩ ᎤᏪᎬ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎢᎦᏓ ᏧᏓᎴᏅᏛ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select &quot;Permissions&quot; in App info to re-enable.">
                <langSet xml:lang="en-US"><tig><term>Select "Permissions" in App info to re-enable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᎡᏗ ᎣᏃᎮᏍᎩ ᏏᏊ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Anyone on or off Facebook">
                <langSet xml:lang="en-US"><tig><term>Anyone on or off Facebook</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏂᎥᏊ ᎤᎿᎢ ᎠᎴ ᎠᏍᏚᏗ Facebook</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 43.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 43.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 43</term></tig></langSet>
            </termEntry>
            <termEntry id="Recorder">
                <langSet xml:lang="en-US"><tig><term>Recorder</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you\’re ready to get helpful shortcuts and more by tapping and swiping on the power key">
                <langSet xml:lang="en-US"><tig><term>Now you\’re ready to get helpful shortcuts and more by tapping and swiping on the power key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏂᎯ ᎾᏍᎩ ᏣᏛᏅᎢᏍᏔᏃᏅ ᏣᎩᏍᏗ ᎠᎵᏍᏕᎵᏍᎩ ᏗᏥᏳᎪᏗᏊ ᎠᎴ ᎤᏟ ᎢᎦᎢ ᏄᏩᏅ ᎭᏐᎥᏍᏗᏍᎬᎢ ᎠᎴ ᎦᏅᎦᎵᏗᏍᎬ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Double tap on the power key">
                <langSet xml:lang="en-US"><tig><term>Double tap on the power key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="No mobile data left">
                <langSet xml:lang="en-US"><tig><term>No mobile data left</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎦᏍᎦᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call Quality Notification">
                <langSet xml:lang="en-US"><tig><term>Call Quality Notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎢᏲᏍᏓ ᎠᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Precipitation">
                <langSet xml:lang="en-US"><tig><term>Precipitation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᎸᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Voice Service:">
                <langSet xml:lang="en-US"><tig><term>Voice Service:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎬ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Current subId:">
                <langSet xml:lang="en-US"><tig><term>Current subId:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ subId:</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot place a call as there are already two calls in progress. Disconnect one of the calls or merge them into a conference prior to placing a new call.">
                <langSet xml:lang="en-US"><tig><term>Cannot place a call as there are already two calls in progress. Disconnect one of the calls or merge them into a conference prior to placing a new call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎤᏙᏢᏒ Ꭰ ᏪᏯᎾ ᎯᎢᎾᎢ ᎤᎿᎢ ᎨᏒᎢ ᎦᏳᎳ ᏔᎵ ᏓᏯᏂ ᎾᎿ ᎠᎵᏱᎵᏒ. ᎱᏓᎳᎩ ᏌᏊ ᎾᎿ ᏥᎩ ᏓᏯᏂ ᎠᎴ ᏓᏠᎯᏍᏛ ᎢᏯᏂᎢ ᎾᎿᎢ Ꭰ ᏧᎾᏓᏛᎪᏙᏗ ᏧᏩᎫᏔᏅᏒ ᎾᎿᎢ ᏩᎲᏍᎬ Ꭰ ᏗᏤ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Post your live stream on your Facebook timeline so that people can watch it back.">
                <langSet xml:lang="en-US"><tig><term>Post your live stream on your Facebook timeline so that people can watch it back.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏃᏣᏢᏍᎩ ᏂᏨᎤᎢ ᏊᏥᎩ ᎤᏪᎬ ᎤᎿᎢ ᏂᏨᎤᎢ Facebook ᎠᏟᎠᎵᏒᎢ ᎤᏓᏅᏅᎢ ᏴᏫ ᏰᎵᏯ ᎭᎦᏙᏍᏓ ᎾᎿ ᎠᏨᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cbrs Data">
                <langSet xml:lang="en-US"><tig><term>Cbrs Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Cbrs ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Message Waiting:">
                <langSet xml:lang="en-US"><tig><term>Message Waiting:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏃᏣᎳᏅᎯ ᎠᎦᏘᏯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Can you hear the recording?">
                <langSet xml:lang="en-US"><tig><term>Can you hear the recording?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏯ ᏂᎯ ᎭᏛᎬᎦ ᏥᎩ ᎦᏂᏴᏗᏍᎬ?</term></tig></langSet>
            </termEntry>
            <termEntry id="IMS Status">
                <langSet xml:lang="en-US"><tig><term>IMS Status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>IMS ᏄᏛᎿᏕᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="I agree with the privacy policy">
                <langSet xml:lang="en-US"><tig><term>I agree with the privacy policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲ ᎣᏏ ᎠᏰᎸᏍᏗ ᎬᏗ ᏥᎩ ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Max character limit reached.">
