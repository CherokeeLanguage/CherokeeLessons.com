            </termEntry>
            <termEntry id="Choose  account to proceed with system update.">
                <langSet xml:lang="en-US"><tig><term>Choose  account to proceed with system update.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ  ᎠᏚᏓᎸᏗ to ᎠᎯᎸᏍᏗ ᎬᏗ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
