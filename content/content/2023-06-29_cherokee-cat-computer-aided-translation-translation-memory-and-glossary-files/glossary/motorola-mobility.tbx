                <langSet xml:lang="en-US"><tig><term>Photo and video locations appear after you turn on “Save location”</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᎠᏓᏴᎳᏛᏍᎩ ᏚᏙᏢᏒᎢ ᎤᎾᏄᎪᎢᏍᏗ ᎤᎶᏐᏅ ᎯᏍᏚᎢᏒᎢ ᎤᎾᎢ “ᎠᎵᏏᏅᏙᏗ ᎤᏙᏢᏒᎢ”</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery Saver turns off when your device charges above ^1">
                <langSet xml:lang="en-US"><tig><term>Battery Saver turns off when your device charges above ^1</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎠᏍᏚᏗ ᎢᏳᏃ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏓᎬᏩᎶᏗᏍᎬ ᎦᎸᎳᏗᏟ ^1</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
