                <langSet xml:lang="chr"><tig><term>ᎠᏍᏡᏴ-ᎠᏴᏙᎳᏛᎢ ᎠᏯᏙᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Network unavailable.">
                <langSet xml:lang="en-US"><tig><term>Network unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᏓᎵ ᏄᏛᏅᎢᏍᏛᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For sent an error message to Ready For Assistant.">
                <langSet xml:lang="en-US"><tig><term>Ready For sent an error message to Ready For Assistant.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ  ᏫᎦᏅᏅᎢ ᎠᎴᎢ ᏓᏓᎴᎬᎢ ᎧᏃᎮᏍᎩ ᎾᎢ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ  ᎠᎾᏓᏍᏕᎵᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="No recent bubbles">
                <langSet xml:lang="en-US"><tig><term>No recent bubbles</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎾᏞᎬ ᏓᎵᏆᎷᎲᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="App may not work on a secondary display.">
                <langSet xml:lang="en-US"><tig><term>App may not work on a secondary display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏰᎵᏉ ᎥᏝ ᏱᏗᎬᏩᎸᏫᏍᏓᏏ ᎤᎾᎢ ᏔᎵᏁᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please check your USB connection or Wi-Fi status.">
                <langSet xml:lang="en-US"><tig><term>Please check your USB connection or Wi-Fi status.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏣᎦᏛᎲᎦ ᏣᏤᎵ USB ᎫᏓᎸᎢ ᎠᎴᏃ ᏫᎢ-ᏈᎢ ᏄᏍᏗᏓᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please check it on your phone.">
                <langSet xml:lang="en-US"><tig><term>Please check it on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏣᎦᏛᎲᎦ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Top full screen">
                <langSet xml:lang="en-US"><tig><term>Top full screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏚᎢ ᎠᎧᎵ ᎠᏴᏙᎳᏛᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Setup is over due to network timeout.">
                <langSet xml:lang="en-US"><tig><term>Setup is over due to network timeout.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᎧᎲᎦᏃ ᏄᏍᏛ ᎤᎶᏐᏅᎢ ᎤᎵᏍᏆᏗᏍᏗᎢ ᎾᎢ ᎤᏚᏓᎵ ᎠᏲᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This SIM can\u2019t be erased due to an error.Restart your device and try again.">
                <langSet xml:lang="en-US"><tig><term>This SIM can\u2019t be erased due to an error.Restart your device and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ eSIM ᎨᏍᏗ ᏰᎵ\u2019 ᎨᏒᎩ ᏛᏍᏍᎪᎸᏥ ᏂᎨᏒ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᏓᏓᎴᎬᎢ.ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth error!">
                <langSet xml:lang="en-US"><tig><term>Bluetooth error!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏓᏓᎴᎬᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Using one-handed mode">
                <langSet xml:lang="en-US"><tig><term>Using one-handed mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎬ ᏌᏊ-ᏩᏓᏁᎸᎩ ᎬᏙᏗᎭ </term></tig></langSet>
            </termEntry>
            <termEntry id="Please check your USB connection or Wi-Fi status, and whether the VPN is enabled and continue on the same Wi-Fi network.">
                <langSet xml:lang="en-US"><tig><term>Please check your USB connection or Wi-Fi status, and whether the VPN is enabled and continue on the same Wi-Fi network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏣᎦᏛᎲᎦ ᏣᏤᎵ USB ᎫᏓᎸᎢ ᎠᎴᏃ ᏫᎢ-ᏈᎢ ᏄᏍᏗᏓᏅᎢ, ᎠᎴ ᎢᏳᏃ ᎾᏍᎩ VPN ᏄᏍᏛ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎠᎴ  ᏂᎦᏯᎢᏒᎢ ᎤᎾᎢ ᎾᏍᎩ ᎤᏠᏱ ᏫᎢ-ᏈᎢ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Pair devices">
                <langSet xml:lang="en-US"><tig><term>Pair devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᏙᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Setup is over due to USB timeout.">
                <langSet xml:lang="en-US"><tig><term>Setup is over due to USB timeout.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᎧᎲᎦᏃ ᏄᏍᏛ ᎤᎶᏐᏅᎢ ᎤᎵᏍᏆᏗᏍᏗᎢ ᎾᎢ USB ᎠᏲᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Skip to previous">
                <langSet xml:lang="en-US"><tig><term>Skip to previous</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏓᎾᏫᏓ ᎾᎢ ᏧᏩᎫᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="{deviceName} sends files to this PC">
                <langSet xml:lang="en-US"><tig><term>{deviceName} sends files to this PC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{deviceName} ᏫᏗᎦᏅᏍᎩ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎢ ᎯᎠ PC</term></tig></langSet>
            </termEntry>
            <termEntry id=" from ">
                <langSet xml:lang="en-US"><tig><term> from </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᏓᏳᏓᎴᏅ </term></tig></langSet>
            </termEntry>
            <termEntry id="Please reconnect the USB cable.">
                <langSet xml:lang="en-US"><tig><term>Please reconnect the USB cable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᏙᎭᎵᎪᏓ ᎾᏍᎩ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="A new version is available {version}.">
                <langSet xml:lang="en-US"><tig><term>A new version is available {version}.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎢᎽ ᏄᏓᎴᏒᎢ ᏄᏍᏛ ᎠᏛᏅᎢᏍᏔᏅ {version}.</term></tig></langSet>
            </termEntry>
            <termEntry id="Left full screen">
                <langSet xml:lang="en-US"><tig><term>Left full screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎦᏂ ᎠᎧᎵ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="WiFi Calling is the service providing the ability to make and receive voice calls over the Internet connection in any available WiFi network, even if you are out of mobile coverage.">
                <langSet xml:lang="en-US"><tig><term>WiFi Calling is the service providing the ability to make and receive voice calls over the Internet connection in any available WiFi network, even if you are out of mobile coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>WiFi ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᏥᎩ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎬ ᏥᎩ ᎾᏏᎾᏒ ᎾᎿᎢ ᎪᏢᏗ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ ᎢᏴᏛ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎾᎿ ᎾᏂᎥᏉ ᎠᏛᏅᎢᏍᏔᏅ WiFi ᏧᎾᏚᏓᎵ, ᎥᏍᏊ ᎾᎿ ᏂᎯ ᎨᎡᎩ ᎤᎾᏙᏣᎴᏍᏗ ᎠᏂᎩᏍᎩ ᎫᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After the update has been downloaded, the Ready For Assistant will need to restart in order to install it.">
                <langSet xml:lang="en-US"><tig><term>After the update has been downloaded, the Ready For Assistant will need to restart in order to install it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᎾᏍᎩ ᎪᏢᎯᏐᏗ ᎦᏳᎵ ᏄᎵᏍᏔᏅ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ, ᎾᏍᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᎠᎾᏓᏍᏕᎵᏍᎩ ᎠᏎᎢ ᎤᏚᎸᏓ ᎠᏂᎩᏍᏙᏗᎢ ᎾᎢ ᎤᎬᏩᎵ ᎦᏘᏅᏛᏍᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" does not support NFC Card emulation function.">
                <langSet xml:lang="en-US"><tig><term> does not support NFC Card emulation function.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏞᏍᏗ ᎦᎫᏍᏛ NFC ᏆᎾᏲᏍᏗ ᎠᏰᎵᏍᎩ ᏧᎸᏫᏍᏓᏁᏗᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Overflow">
                <langSet xml:lang="en-US"><tig><term>Overflow</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᎧᎵᏬᎯᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dismiss bubble">
                <langSet xml:lang="en-US"><tig><term>Dismiss bubble</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᎯᏍᏙᏗ ᎠᎵᏆᎷᎲᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Transfer files between devices">
                <langSet xml:lang="en-US"><tig><term>Transfer files between devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏰᏟ ᏂᏚᏓᎸᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to restart this app and go full screen.">
                <langSet xml:lang="en-US"><tig><term>Tap to restart this app and go full screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᎢ ᎠᏂᎩᏍᏙᏗ ᎯᎠ ᎬᏙᏗ ᎠᎴ ᎮᎾ ᎠᎧᎵ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t bubble conversation">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t bubble conversation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ\u2019 ᎠᎵᏆᎷᎲᏍᎬ ᎠᎾᏟᏃᎮᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="App may not work with split-screen.">
                <langSet xml:lang="en-US"><tig><term>App may not work with split-screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏰᎵᏉ ᎥᏝ ᏱᏗᎬᏩᎸᏫᏍᏓᏏ ᎬᏗ ᎠᏍᏡᏴ-ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To exit, swipe up from the bottom of the screen or tap anywhere above the app">
                <langSet xml:lang="en-US"><tig><term>To exit, swipe up from the bottom of the screen or tap anywhere above the app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎦᏅᎪᎢᏍᏗ, ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎠᏐᎥᏍᏙᏗ ᎾᎿᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎴᏃ ᎭᏐᎥᏍᏓ ᎤᎾᏊᎨᏒᎢ ᎦᎸᎳᏗᏢ ᎾᏍᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you've turned on Wi-Fi on both your phone and PC">
                <langSet xml:lang="en-US"><tig><term>Make sure you've turned on Wi-Fi on both your phone and PC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᎤᎾᎢ  ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎡᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ PC</term></tig></langSet>
            </termEntry>
            <termEntry id="Bottom full screen">
                <langSet xml:lang="en-US"><tig><term>Bottom full screen</term></tig></langSet>
