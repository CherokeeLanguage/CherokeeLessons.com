            </termEntry>
            <termEntry id="Unavailable on carrier-locked devices">
                <langSet xml:lang="en-US"><tig><term>Unavailable on carrier-locked devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏛᏅᎢᏍᏛᎾ ᎤᎿᎢ ᎠᏫᏗᏍᎩ-ᏍᏓᏯ ᎠᏍᏚᎭ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fold the folio behing your device to prop it up">
