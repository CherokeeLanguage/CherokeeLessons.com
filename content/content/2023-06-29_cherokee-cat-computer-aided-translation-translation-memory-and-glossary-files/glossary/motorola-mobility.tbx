            </termEntry>
            <termEntry id="No nearby devices were found.">
                <langSet xml:lang="en-US"><tig><term>No nearby devices were found.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏒᎩ ᎠᏩᏛᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable wireless display">
