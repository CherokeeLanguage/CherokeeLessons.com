            <termEntry id="The new Gesture Selfie feature lets you take a selfie by showing the palm of your hand.">
                <langSet xml:lang="en-US"><tig><term>The new Gesture Selfie feature lets you take a selfie by showing the palm of your hand.</term></tig></langSet>
