            </termEntry>
            <termEntry id="Select automatically">
                <langSet xml:lang="en-US"><tig><term>Select automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="The password must be: 8-64 characters">
                <langSet xml:lang="en-US"><tig><term>The password must be: 8-64 characters</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎠᏎᎢ: 8-64 ᏗᎪᏪᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The count of hexadecimal characters must be even number">
                <langSet xml:lang="en-US"><tig><term>The count of hexadecimal characters must be even number</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏎᏍᏗ ᎾᏍᎩ ᎮᎦᏕᏏᎹᎵ ᏗᎪᏪᎶᏗ ᏝᏃ ᎾᏍᎩ ᏧᏓᎴᎿ ᎠᏎᏍᏔᏅᎩ ᏳᎵᏍᏙᏗ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Invalid hexadecimal characters">
                <langSet xml:lang="en-US"><tig><term>Invalid hexadecimal characters</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏓᏂᎸᎬᎾ ᎮᎦᏕᏏᎹᎵ ᏗᎪᏪᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from a bottom corner to invoke digital assistant app.">
                <langSet xml:lang="en-US"><tig><term>Swipe up from a bottom corner to invoke digital assistant app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ Ꭰ ᎭᏫᏂᏗᏢ ᎤᏅᏏᏴ ᎾᎿᎢ ᎠᏓᏠᏯᏍᏙᏗ ᎠᎾᎦᎵᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't update visual voicemail">
