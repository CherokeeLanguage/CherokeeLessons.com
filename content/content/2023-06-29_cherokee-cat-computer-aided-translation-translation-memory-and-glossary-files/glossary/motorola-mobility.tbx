            </termEntry>
            <termEntry id="Revoke access to USB debugging from all computers you\u2019ve previously authorized?">
                <langSet xml:lang="en-US"><tig><term>Revoke access to USB debugging from all computers you\u2019ve previously authorized?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏎᎯᏍᏗ ᎠᏴᏍᏗ ᎾᎢ USB ᎪᎷᏩᏘᏍᎬ ᏂᏓᏳᏓᎴᏅ ᏂᎦᏓ ᏗᎦᏙᎥᎯᏍᏗ ᏗᏍᏆᏂᎪᏗᏍᎩ ᏧᏩᎫᏔᏅᏒ ᎤᎾᎵᏍᎪᎸᏔᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap accessibility button">
                <langSet xml:lang="en-US"><tig><term>Tap accessibility button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒᎢ ᎠᏐᏅᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Drawing">
                <langSet xml:lang="en-US"><tig><term>Drawing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᎶᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Plugin usb to install software">
                <langSet xml:lang="en-US"><tig><term>Plugin usb to install software</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏙᏗ usb ᎾᎿᎢ ᎯᏘᏅᎦ ᎦᎾᏗᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="PC [] is connecting your phone and asking for control.">
                <langSet xml:lang="en-US"><tig><term>PC [] is connecting your phone and asking for control.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PC [] ᎨᎡᎢ ᏓᎾᎵᎪᏗᏍᎬ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᎴ ᎯᏔᏲᎯᎭ ᎤᎬᏩᏟ ᏗᎫᎪᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t complete sign-up. Tap to try again.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t complete sign-up. Tap to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏯᏍᏆᏓ ᎠᏘᎳᏗᏍᏗᎢ. ᎭᏐᎥᏍᏓ ᎾᎢ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="While you’re gaming, you can find tools &amp; settings right from the sidebar.">
                <langSet xml:lang="en-US"><tig><term>While you’re gaming, you can find tools &amp; settings right from the sidebar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏕᎭᏁᎸᏗᏍᎬᎢ, ᏂᎯ ᎡᎵᏊ ᏗᏣᏩᏛᏗ ᏗᎬᏔᏂᏓᏍᏗ ᎠᎴ ᏕᎦᎧᎲᎢ ᎠᎦᏘᏏ ᎾᏍᎩᎾ Ꮎ ᎤᏟᏗᏢ ᎪᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open the sidebar by tapping the icon or swiping right from the edge of your screen.">
                <langSet xml:lang="en-US"><tig><term>Open the sidebar by tapping the icon or swiping right from the edge of your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ Ꮎ ᎤᏟᏗᏢ ᎠᏪᎸᎢ ᎬᏗ ᎠᏑᏰᏍᎬ Ꮎ ᎠᎢᎧᏂ ᎠᎴ ᎦᎶᎯᏍᏗᏍᎬ ᎠᎦᏘᏏ ᎾᏍᎩᎾ ᎠᏍᏛᎢ ᎥᎿᎢ ᏂᎯ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Debug GPU overdraw">
                <langSet xml:lang="en-US"><tig><term>Debug GPU overdraw</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎩ GPU ᎤᎶᏒᏍᏔᏅ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t keep activities">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t keep activities</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒ ᏓᎵᏖᎸᎲᏍᎨᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This input method may be able to collect all the text you type, including personal data like passwords and credit card numbers. It comes from the app . Use this input method?">
                <langSet xml:lang="en-US"><tig><term>This input method may be able to collect all the text you type, including personal data like passwords and credit card numbers. It comes from the app . Use this input method?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎦᏬᎯᎵᏴᏓ ᎢᎬᏁᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᎦᏟᏌᏅᎩ ᏂᎦᏓ ᎾᏍᎩ ᎪᏪᎳᏅᎢ ᏂᎯ ᎠᏐᎥᏍᏙᏗ, ᎤᏠᏯᏍᏗ ᎠᏏᏴᏫ ᎦᏟᏌᏅᎯ ᎢᏳᏍᏘ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎠᎴ ᎠᏓᏚᎲᏍᎩ ᏆᏂᏲᏍᏗ ᏗᏎᏍᏗ. ᎾᏍᎩ ᏂᏓᏳᏓᎴᏅ ᎤᎷᏨᎩ ᎾᏍᎩ ᎬᏙᏗ . ᎬᏙᏓ ᎯᎠ ᎦᏬᎯᎵᏴᏓ ᎢᎬᏁᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="To connect your display, turn it off.">
                <langSet xml:lang="en-US"><tig><term>To connect your display, turn it off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎱᏓᎸᎩ ᎾᎿᎢ ᏂᏨᎤᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sign-up complete. Connecting\u2026">
                <langSet xml:lang="en-US"><tig><term>Sign-up complete. Connecting\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏖᎳᏗᏍᏗ ᎠᎵᏍᏆᏓ. ᏓᎾᎵᎪᏗᏍᎬ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow development settings?">
                <langSet xml:lang="en-US"><tig><term>Allow development settings?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏎᎯᏍᏗ ᎠᏴᏍᏗ ᎾᎢ USB ᎪᎷᏩᏘᏍᎬ ᏂᏓᏳᏓᎴᏅ ᏂᎦᏓ ᏗᎦᏙᎥᎯᏍᏗ ᏗᏍᏆᏂᎪᏗᏍᎩ ᏧᏩᎫᏔᏅᏒ ᎤᎾᎵᏍᎪᎸᏔᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="New password and confirmation don\u2019t match">
                <langSet xml:lang="en-US"><tig><term>New password and confirmation don\u2019t match</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏤ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎠᎴ ᎦᎫᏍᏛᏗᏱ ᎤᎵᎪᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Desktop full backups aren\u2019t currently protected">
                <langSet xml:lang="en-US"><tig><term>Desktop full backups aren\u2019t currently protected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏍᎩᎶᎩ ᎦᏚ ᎧᎵ ᏗᏍᏆᏂᎪᏗᏍᎩ ᏃᏊᎨᏒᎢ ᎠᎵᏍᎦᏍᏙᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="The bug report will appear on the phone shortly">
                <langSet xml:lang="en-US"><tig><term>The bug report will appear on the phone shortly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏍᎪᏯ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎠᏎᎤᎾᏄᎪᎢᏍᏗ ᎤᎾᎢ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᏂᎪᎯᎸᎾᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="Type SIM PUK and new PIN code">
                <langSet xml:lang="en-US"><tig><term>Type SIM PUK and new PIN code</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ SIM PUK ᎠᎴ ᎢᏤ PIN ᎠᏍᏓᏩᏛᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It's \’s anniversary">
                <langSet xml:lang="en-US"><tig><term>It's \’s anniversary</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎤᏕᏘᏱᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device will stay locked until you manually unlock">
                <langSet xml:lang="en-US"><tig><term>Device will stay locked until you manually unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎡᏙᎮᏍᏗ ᏍᏓᏯ ᎠᏍᏚᎭ ᎩᎳ ᏂᎯ ᎣᏩᏌ ᏱᎬᏁᏗ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You usually dismiss these notifications. Keep showing them?">
                <langSet xml:lang="en-US"><tig><term>You usually dismiss these notifications. Keep showing them?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏠᎯᎭ ᏗᏲᎯᏍᏗ ᎯᎠᏃ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏍᏆᏂᎪᏙᏗ ᏕᏍᎩᏍᎪᏩᏛᏗᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Text is copied to clipboard, you can paste it to your PC directly.">
                <langSet xml:lang="en-US"><tig><term>Text is copied to clipboard, you can paste it to your PC directly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ ᎨᎡᎢ ᏓᏟᎶᏍᏔᏅᎯ ᎾᎿᎢ ᏗᎦᏯᎸᏙᏗᎢ, ᏂᎯ ᏰᎵᏯ ᏣᏯᎸᏗ ᎾᎿ ᎾᎿᎢ ᏂᏨᎤᎢ PC ᎠᏓᏎᎮᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It's \’s birthday soon">
                <langSet xml:lang="en-US"><tig><term>It's \’s birthday soon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ  ᎤᏕᏘᏱᏍᎬ ᎾᏝᎫᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will automatically try to cool down. You can still use your phone, but it may run slower.Once your phone has cooled down, it will run normally.">
                <langSet xml:lang="en-US"><tig><term>Your phone will automatically try to cool down. You can still use your phone, but it may run slower.Once your phone has cooled down, it will run normally.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏣᏁᎸᏙᏗ ᎾᎿᎢ ᎤᏁᏌᏴᏟ ᎡᎳᏗᏟ. ᏂᎯ ᏰᎵᏯ ᎠᏏᏉ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ, ᎠᏎᏃ ᎾᏍᎩ ᏰᎵᏉ ᎠᎢᏎᏍᏗ ᎤᏍᎦᏃᎵ.ᏌᏊᏊ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏂᏚᏩᎿ ᎤᏁᏌᏴᏟ ᎡᎳᏗᏟ, ᎾᏍᎩ ᎠᏎ ᎠᎢᏎᏍᏗ ᏄᎶᏒᏍᏛᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restart your device to implement this change">
                <langSet xml:lang="en-US"><tig><term>Restart your device to implement this change</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎭᏂᎩᏍᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎢ ᎬᏔᏂᏓᏍᏗ ᎯᎠ ᎦᏁᏟᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless">
                <langSet xml:lang="en-US"><tig><term>Wireless</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏏᎳᏛᎾ ᏗᏐᏅᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show battery level percentage inside the status bar icon when not charging">
                <langSet xml:lang="en-US"><tig><term>Show battery level percentage inside the status bar icon when not charging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎠᎾᎦᎵᏍᎩ ᎤᏩᎾᏕᏍᎩ ᎢᎦᏘᎭ ᎭᏫᎾᏗᏢ ᏥᎩ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᎢᏳᏃ ᎥᏝ ᏓᎬᏩᎶᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="To connect your keyboard with your tablet, you first have to turn on Bluetooth.">
                <langSet xml:lang="en-US"><tig><term>To connect your keyboard with your tablet, you first have to turn on Bluetooth.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎱᏓᎸᎥᎦ ᏣᏤᎵ ᏗᏐᏅᏍᏙᏗ ᎬᏗ ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᎠᎬᏱ ᏍᏚᎢᏍᏗ ᏌᎪᏂᎨ ᎦᏅᏙᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shows at the top of conversation notifications and as a profile picture on lock screen">
                <langSet xml:lang="en-US"><tig><term>Shows at the top of conversation notifications and as a profile picture on lock screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᎾᎨᏒᎢ ᎾᎢ ᎥᎾᎢ ᏩᎦᎸᎳᏗᏴ ᎠᎾᏟᏃᎮᏍᎬ ᏗᏓᏃᏣᎳᏁᎯ ᎠᎴ ᎯᎢᎾᎢ ᏌᏆᎦᏘ ᎠᏍᏓᏩᏛᏍᏗ ᏗᏓᏟᎶᏍᏔᏅ ᎾᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Subject tracking is enabled, disable it manually to change lens">
                <langSet xml:lang="en-US"><tig><term>Subject tracking is enabled, disable it manually to change lens</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏗ ᎪᎷᏁᎩ ᎾᏍᎩ ᎡᎵᏊ ᏱᎬᏛᏁᏗ, ᎠᎴᏫᏍᏙᏓ ᎾᏍᎩ ᎣᏩᏌ ᎠᏍᏕᎸᏗ ᏗᎦᏁᏟᏴᏍᏗ ᏗᏓᎨᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="No write permission to copy files into this directory">
                <langSet xml:lang="en-US"><tig><term>No write permission to copy files into this directory</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎪᏪᎶᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᏗᏟᎶᏍᏔᏅᎯ ᏗᏍᏆᏂᎪᏙᏗ ᏭᏂᏴᎴ ᎯᎠ ᎠᏓᏎᎮᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="These notifications will be shown silently">
                <langSet xml:lang="en-US"><tig><term>These notifications will be shown silently</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠᏃ ᏗᏓᏃᏣᎳᏁᎯ ᎨᏎᏍᏗ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎡᎳᏪᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="It's \’s birthday">
                <langSet xml:lang="en-US"><tig><term>It's \’s birthday</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ  ᎤᏕᏘᏱᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is using the microphone.">
                <langSet xml:lang="en-US"><tig><term>This app is using the microphone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎥᏗᏍᎬᎢ Ꮎ ᎦᏬᏂᎯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="USB preferences">
                <langSet xml:lang="en-US"><tig><term>USB preferences</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USB ᎤᏟ ᏓᏂᏰᎸᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t access . Check the  app to make sure the control is still available and that the app settings haven\u2019t changed.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t access . Check the  app to make sure the control is still available and that the app settings haven\u2019t changed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎠᏴᏍᏗ . ᎪᏪᎶᏗ ᏥᎩ  ᎬᏙᏗ ᎾᎿᎢ ᎪᏢᏗ ᎤᏙᎯᏳ ᏥᎩ ᏗᏱᎸᏍᏗ ᏄᏍᏛ ᎠᏏᏉ ᎠᏛᏅᎢᏍᏔᏅ ᎠᎴ ᏥᎩ ᎬᏙᏗ ᏕᎦᎧᎲᎢ ᎤᎭ ᎥᏝ ᏧᏓᏁᏟᏴᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shows at the top of conversation notifications and as a profile picture on lock screen, appears as a bubble">
                <langSet xml:lang="en-US"><tig><term>Shows at the top of conversation notifications and as a profile picture on lock screen, appears as a bubble</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᎾᎨᏒᎢ ᎾᎢ ᎥᎾᎢ ᏩᎦᎸᎳᏗᏴ ᎠᎾᏟᏃᎮᏍᎬ ᏗᏓᏃᏣᎳᏁᎯ ᎠᎴ ᎯᎢᎾᎢ ᏌᏆᎦᏘ ᎠᏍᏓᏩᏛᏍᏗ ᏗᏓᏟᎶᏍᏔᏅ ᎾᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏓᏴᎳᏛᏍᎩ, ᏂᎬᏩᏍᏗ ᎯᎾᎢ ᎤᏆᎷᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to restart your phone to turn off safe mode? All of your apps will be restored once safe mode is turned off.">
                <langSet xml:lang="en-US"><tig><term>Do you want to restart your phone to turn off safe mode? All of your apps will be restored once safe mode is turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎾᎿᎢ ᎠᏍᏚᏗ ᏂᎦᎾᏰᎬᎾ ᎬᏙᏗ? ᏂᎦᏓ ᎤᎿ ᏂᏨᎤᎢ ᏗᎬᏙᏗ ᎠᏎᎪᏢᎯᏌᏅ ᏌᏊ ᎢᏳᏩᎫᏗ ᏂᎦᎾᏰᎬᎾ ᎬᏙᏗ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cooling Down">
                <langSet xml:lang="en-US"><tig><term>Cooling Down</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏒᏴᏟ ᏂᎦᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete project(s)?">
                <langSet xml:lang="en-US"><tig><term>Delete project(s)?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏛᎯ ᎢᏯᏛᏁᏗᎢ?</term></tig></langSet>
            </termEntry>
