                <langSet xml:lang="en-US"><tig><term>Easy shortcuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏓ ᏍᏆᎳ ᎢᏗᎬᏁᎯ</term></tig></langSet>
            </termEntry>
