            <termEntry id="This action can't be undone">
                <langSet xml:lang="en-US"><tig><term>This action can't be undone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎢᏯᏛᏁᎵᏓᏍᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎠᏍᏆᏛ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the buttons in the bottom left taskbar to access apps, search, the home screen, and recently used apps.">
                <langSet xml:lang="en-US"><tig><term>Use the buttons in the bottom left taskbar to access apps, search, the home screen, and recently used apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎾᏍᎩ ᏗᏐᎥᏍᏙᏗ ᎾᏍᎩ ᎡᎳᏗᏢ ᎠᏍᎦᏂ ᎢᏯᏛᏁᏗ ᎦᎾᎸᎢ ᎾᎢ ᎠᏴᏍᏗ ᏗᎬᏙᏗ, ᎠᏱᏍᏗ, ᎾᏍᎩ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ, ᎠᎴ ᎾᏞᎬᏭ ᎬᏔᏅᎯ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Welcome to Mobile Desktop">
                <langSet xml:lang="en-US"><tig><term>Welcome to Mobile Desktop</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏨᏓᏂᎸᎩ ᎾᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏍᎩᎶᎩ ᎦᏚ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about Mobile desktop">
                <langSet xml:lang="en-US"><tig><term>Learn more about Mobile desktop</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᎤᏟ ᎢᎦᎢ ᏄᏰᎵᏛ ᎠᏓᏅᏏᏙᎯ ᎦᏍᎩᎶᎩ ᎦᏚ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow Digital Secure to access your photos, media, files, text messages and location in order to check for harmful files. Also, let it access your phone in order to identify you and register the app.">
                <langSet xml:lang="en-US"><tig><term>Allow Digital Secure to access your photos, media, files, text messages and location in order to check for harmful files. Also, let it access your phone in order to identify you and register the app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎠᎾᎦᎵᏍᎩ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎾᎿᎢ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ, ᎦᎶᏙᏗ, ᏗᏍᏆᏂᎪᏙᏗ, ᎠᎪᎵᏰᏗ ᏗᎪᎵᏰᏗ ᏃᎴ ᎤᏙᏢᏒᎢ ᎾᎿ ᎠᏓᏅᏍᏗ to ᎠᎦᏎᏍᏓ ᎤᎬᏩᏟ ᎤᏐᏅ ᏯᏓᏛᏁᎯ ᏗᏍᏆᏂᎪᏙᏗ. ᎾᏍᏉ, ᏩᏂᎩ ᎨᎡᎢ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎾᎿ ᎠᏓᏅᏍᏗ ᎾᎿᎢ ᎪᏟᏍᏗ ᏂᎯ ᏃᎴ ᏚᏙᎥ ᎤᏬᏪᎶᏗ ᏥᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Information">
                <langSet xml:lang="en-US"><tig><term>Information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Ready For Wireless 4K Adapter lets you connect wirelessly to any display.">
                <langSet xml:lang="en-US"><tig><term>The Ready For Wireless 4K Adapter lets you connect wirelessly to any display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᎾᏏᎳᏛᎾ 4K ᏗᏙᎵᎩ ᏱᎬᏁᎯ ᏣᎵᏍᎪᎸᏓᏁᎯ ᎫᏓᎸᏗ ᏂᏓᏏᎳᏛᎾᏉ ᎾᎢ ᏂᎦᎥᏉ ᎬᏂᎨᏒ ᏱᎬᏁᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="256 kbps">
