                <langSet xml:lang="chr"><tig><term>ᎤᏓᏅᎦᎸᏓ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᏄᎳᏘ ᏥᎩ ᎠᏩᏘᏍᎩ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to uninstall this app？ Uninstalling the working package will reset to the preset package style.">
                <langSet xml:lang="en-US"><tig><term>Do you want to uninstall this app？ Uninstalling the working package will reset to the preset package style.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎢ ᏣᏘᏅᏛᏍᏗ ᎯᎠ ᎬᏙᏗ？ ᏥᎯᏘᏅᏓᎩ ᎾᏍᎩ ᏚᏂᎸᏫᏍᏓᏁᎲ ᎦᏇᏅᏛ ᎠᏎ ᏥᎯᎧᎲᎦ ᎾᏍᎩ ᎦᏳᎳ ᎦᎧᏅᎯ ᎦᏇᏅᏛᎢ ᏂᏚᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
