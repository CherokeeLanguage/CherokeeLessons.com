            </termEntry>
            <termEntry id="Now you can do even more from the power button menu. Just tap for quick access to your wallet, smart home device controls, and more.">
                <langSet xml:lang="en-US"><tig><term>Now you can do even more from the power button menu. Just tap for quick access to your wallet, smart home device controls, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏂᎯ ᏰᎵᏊ ᏱᎾᏛᎦ ᎥᏍᏊ ᎤᏥ ᎢᎦᎢ ᏂᏓᏅᏓᎴᏅ ᎾᏍᎩ ᎤᏟᏂᎩᏗ ᎠᏐᏅᏍᏙᏗ ᎪᏪᎳᎾᎥᎢ. ᏍᎩᏋ ᎭᏐᎥᏍᏓ ᎾᏍᎩᎾ ᎤᏟᏍᏓ ᎬᏴᏍᏗ ᎾᎢ ᏣᏤᎵ ᎠᏕᎳ ᏗᎦᎸᏙᏗ, ᎠᏌᎹᏗ ᏧᏪᏅᏒ ᏥᏂᎬᏅᏗᏓᎾ ᏗᏱᎸᏍᏗ, ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Getting started, Shortcuts, and more">
                <langSet xml:lang="en-US"><tig><term>Getting started, Shortcuts, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᏗᏍᎬ ᎤᏂᎩᏍᏙᏗᎢ, ᏍᏆᎳ ᎢᏗᎬᏁᎯ, ᏃᎴ ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Move somewhere with gentler lighting and try again">
                <langSet xml:lang="en-US"><tig><term>Move somewhere with gentler lighting and try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᎾᎿ ᎯᎸᏢᎢ ᎬᏗ ᏧᏓᎴᏅᏓ ᎠᏨᏍᏛᏍᎬ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="National warning messages. Can't be turned off.">
                <langSet xml:lang="en-US"><tig><term>National warning messages. Can't be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎬᎾᏛᎢ ᎠᏓᏕᏯᏔᎲᏍᎩ ᏗᎪᎵᏰᏗ. ᎨᏍᏗ ᏰᎵ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Get more tips &amp; tricks">
                <langSet xml:lang="en-US"><tig><term>Get more tips &amp; tricks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᎤᏥ ᎢᎦᎢ ᏗᏓᏕᏲᎲᏍᎩ &amp; ᎤᏂᎦᏙᎲᏒ ᏧᎾᏓᏕᏲᏗ ᏧᎾᏓᏕᏲᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Android 10\’s latest features make your device more helpful while giving you the balance you need in your digital life.">
                <langSet xml:lang="en-US"><tig><term>Android 10\’s latest features make your device more helpful while giving you the balance you need in your digital life.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android 10\'s ᎢᏤᎯᎨᎢᏍᏗ ᏗᎦᏎᏍᏙᏗ ᎰᏢᎾ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏥ ᎢᎦᎢ ᎠᏓᏍᏕᎵᏍᎩ ᎾᎯᏳᎢ ᏣᏁᎲᎩ ᎾᏍᎩ ᎢᏗᎦᎢ ᏂᎯ ᏣᏂᎬᎬᎢ ᎾᎿᎢ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᎠᎴᏂᏙᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For">
                <langSet xml:lang="en-US"><tig><term>Ready For</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᏄᏰᎵᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to use your Razr like a pro. Razr Tips gives you information about basic functions, shortcuts on the external display, transitioning between the 2 displays, and more.">
                <langSet xml:lang="en-US"><tig><term>Learn how to use your Razr like a pro. Razr Tips gives you information about basic functions, shortcuts on the external display, transitioning between the 2 displays, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏙᎡᎵ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ Razr ᎯᎸᏉᏗ Ꭰ ᎧᎵ ᏗᏙᎳᎩ ᏄᏍᏗ ᏗᏥᎶᏍᏔᏅ. Razr ᎠᏍᏕᎸᏗᎢ ᎠᏓᏁᎭ ᏂᎯ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᎤᎵᏍᎨᏛ ᏧᎸᏫᏍᏓᏁᏗᏱ, ᏍᏆᎳ ᎢᏗᎬᏁᎯ ᎾᎿ ᏥᎩ ᏙᏯᏗᏨ ᎠᏓᏴᎳᏔᏍᎩ, ᏓᏓᏁᏟᏴᏍᎬᎢ ᎤᏜᏅᏛ ᏥᎩ 2 ᎠᏓᏴᎳᏔᏍᎩ, ᏃᎴ ᎤᎪᏗ.</term></tig></langSet>
            </termEntry>
