                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏉ ᎠᎯᏗᎨᎢ ᎤᏚᏓᎴᏗ ᎤᏜᏅᏛᎯ ᎠᎴ ᏗᎧᏃᏗ SD ᏆᎾᏲᏍᏗ ᎠᏍᏆᏂᎪᏙᏗ ᏂᏕᎬᎿᏅᎢ ᎢᏳᏃ ᏂᎯ ᏣᎲᎢ ᏌᏊ ᏫᎪᏣᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down twice to open quick settings.">
                <langSet xml:lang="en-US"><tig><term>Swipe down twice to open quick settings.</term></tig></langSet>
