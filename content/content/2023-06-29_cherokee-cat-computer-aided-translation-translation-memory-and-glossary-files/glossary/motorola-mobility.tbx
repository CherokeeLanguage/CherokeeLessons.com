            <termEntry id="Unable to record. Microphone is being used by another application.">
                <langSet xml:lang="en-US"><tig><term>Unable to record. Microphone is being used by another application.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎢ ᎦᏂᏴᏙᏗ. ᎦᏬᏂᎯᏍᏙᏗ ᏄᏍᏛ ᎬᏔᏂᏓᏍᏗ ᎬᏗ ᏅᏩᏓᎴᎢ ᎠᏔᏲᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure you want to exit?">
                <langSet xml:lang="en-US"><tig><term>Are you sure you want to exit?</term></tig></langSet>
