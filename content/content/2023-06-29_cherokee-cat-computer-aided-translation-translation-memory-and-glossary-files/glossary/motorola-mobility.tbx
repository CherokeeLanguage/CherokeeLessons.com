                <langSet xml:lang="chr"><tig><term>Ꭳnly tᎮ ᏕᎥᎢcᎡ ᎣwᏁr cᎠn ᎥᎢᎡw Ꭰnd ᎹᎾᎨ bᎶckᎡd ᏄmbᎡrᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After you dial or text an emergency number, blocking is turned off to ensure that emergency services can contact you.">
                <langSet xml:lang="en-US"><tig><term>After you dial or text an emergency number, blocking is turned off to ensure that emergency services can contact you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠfᏖr ᏲᎤ ᏗᎠl Ꭳr Ꮦxt Ꭰn ᎡᎺrᎨncy ᏄmbᎡr, bᎶckᎢng ᎢᏍ tᎤrᏁd Ꭳff tᎣ ᎡnᏑrᎡ tᎭt ᎡᎺrᎨncy ᏎrᎥᎢcᎡᏍ cᎠn cᎣnᏔct ᏲᎤ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" blocked">
                <langSet xml:lang="en-US"><tig><term> blocked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎦᏐᎭᎾᎳᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id=" is already blocked.">
