                <langSet xml:lang="chr"><tig><term>ᏧᎾᏁᎸᏙᏗ ᎠᏔᏲᏍᏙᏗ ᏄᏍᏛ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎤᏠᏯᏍᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ultra-wide does not support the current resolution.">
                <langSet xml:lang="en-US"><tig><term>Ultra-wide does not support the current resolution.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏒᏍᏔᏅ-ᎠᏯᏖᎾ ᎥᏝᏃ ᏱᎦᎫᏍᏛᎲᎦ ᎾᏍᎩ ᏃᏊᏥᎩ ᎠᏓᏴᎳᏛᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Background replacement">
                <langSet xml:lang="en-US"><tig><term>Background replacement</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎠᏓᏁᎵᏴᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't connect to Ready For Wireless 4K Adapter.">
                <langSet xml:lang="en-US"><tig><term>Can't connect to Ready For Wireless 4K Adapter.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏍᏗ ᏱᏗᎨᎭᏠᎯᏍᏓ ᎾᎿᎢ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᏂᏓᏏᎳᏛ 4K ᏗᏙᎵᎩ ᏱᎬᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected to ">
                <langSet xml:lang="en-US"><tig><term>Connected to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ ᎾᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Drag the handles to edit">
                <langSet xml:lang="en-US"><tig><term>Drag the handles to edit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎾᏏᏄᎦ ᏥᎩ ᏗᎫᎭᎸᏗ ᎾᎿᎢ ᎦᏁᏟᏴᏓᎪᏪᎸ</term></tig></langSet>
