                <langSet xml:lang="en-US"><tig><term>Avoid bad Wi-Fi connections</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏅᏗᏍᏙᏗ ᎤᏲᎢ Wi-Fi ᏓᎵᎪᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please retry later">
