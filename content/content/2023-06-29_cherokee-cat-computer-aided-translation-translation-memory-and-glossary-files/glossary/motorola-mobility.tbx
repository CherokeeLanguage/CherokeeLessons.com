                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ ᎾᎾᎢ RSA</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to continue">
                <langSet xml:lang="en-US"><tig><term>Tap to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿᎢ ᎠᎯᎸᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="For Easy Prefix to work, it must use: \u26AB Contacts - Checks if dialed number is a known contact.">
                <langSet xml:lang="en-US"><tig><term>For Easy Prefix to work, it must use: \u26AB Contacts - Checks if dialed number is a known contact.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎠᎯᏓ ᎠᎴᏔᏅ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ, ᎾᎿ ᎠᏎ ᎬᏔᏂᏓᏍᏗ: \n\n\u26AB ᏗᏟᏃᎮᏙᏗ-ᏓᎦᏎᏍᏗᏍᎪ ᎾᎿ ᏗᏐᏂᎭ ᏗᏎᏍᏗ ᎠᏎᏍᏗ ᎨᎡᎢ Ꭰ ᎠᎪᎵᏍᏙᏗ ᎠᏟᏃᎮᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down to see notifications">
                <langSet xml:lang="en-US"><tig><term>Swipe down to see notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎡᎳᏗᏟ ᎾᎢ ᎠᎪᏩᏛᏗ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mono audio">
