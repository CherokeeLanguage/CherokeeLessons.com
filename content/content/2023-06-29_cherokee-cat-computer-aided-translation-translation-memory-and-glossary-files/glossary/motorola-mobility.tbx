                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎢᏧᎳᎭ ᏥᏄᎵᏍᏔᏅᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="A Bluetooth device, , wants to access your messages.You haven\u2019t connected to  before.">
                <langSet xml:lang="en-US"><tig><term>A Bluetooth device, , wants to access your messages.You haven\u2019t connected to  before.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Bluetooth ᏥᏂᎬᏅᏗᏓᎾ ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᎪᎵᏰᏗ.ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎫᏓᎸᏅᎯ ᎾᎿᎢ  ᎤᏓᎷᎸ.</term></tig></langSet>
            </termEntry>
