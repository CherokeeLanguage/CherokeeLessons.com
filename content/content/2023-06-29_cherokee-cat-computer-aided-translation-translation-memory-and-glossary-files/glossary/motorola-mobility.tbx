            </termEntry>
            <termEntry id="Default Print Service needs location permission to find nearby devices.">
                <langSet xml:lang="en-US"><tig><term>Default Print Service needs location permission to find nearby devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕfᎠᎤlt PrᎢnt ᏎrᎥᎢcᎡ ᏁᎡdᏍ ᎶcᎠᏘᎣn pᎡrᎻᏍᏏᎣn tᎣ fᎢnd ᏁᎠrby ᏕᎥᎢcᎡᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System Message">
