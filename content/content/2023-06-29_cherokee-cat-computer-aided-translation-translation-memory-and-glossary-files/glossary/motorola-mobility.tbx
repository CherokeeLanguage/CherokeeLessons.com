                <langSet xml:lang="chr"><tig><term>ᎾᏉᏃ ᎠᎩᏍᏗ ᎾᏍᎩ ᎤᎪᏗᏗ 1 ᎢᏯᏔᏬᏍᏔᏅ ᎾᎿ ᎠᎩᏍᏒ GPS ᎣᏍᏓ ᏱᏨᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Minimum font size will only applied in specific applications.">
                <langSet xml:lang="en-US"><tig><term>Minimum font size will only applied in specific applications.</term></tig></langSet>
