                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏟᏃᎮᏙᏗ ᎾᏍᎩ ᎦᎫᏍᏛᏓ ᎤᎾᎵᎪᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure to exit this full test?">
                <langSet xml:lang="en-US"><tig><term>Are you sure to exit this full test?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳᏍᎪᏅ ᎨᏒᎢ ᎾᎢ ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎧᎵᎢ ᎠᏓᎪᎵᏰᏍᎩ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to disconnect from the RSA client?">
                <langSet xml:lang="en-US"><tig><term>Do you want to disconnect from the RSA client?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᏍ ᎾᎢ ᎤᏭᏓᎴᏍᏗ ᏂᏓᏳᏓᏁᏅ ᎾᏍᎩ RSA ᎠᏥᏍᏕᎵᏍᎩ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier is required.">
