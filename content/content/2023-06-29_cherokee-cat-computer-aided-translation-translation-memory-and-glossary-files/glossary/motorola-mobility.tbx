            </termEntry>
            <termEntry id="Can\u2019t verify face.">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t verify face.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏰᎵ ᎰᎯᏳᏓ ᎧᏁᏉᏍᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone is connected to a PC via Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>Your phone is connected to a PC via Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Ꭰ PC ᎤᎶᏒ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data in your work profile is visible to your IT admin">
                <langSet xml:lang="en-US"><tig><term>Data in your work profile is visible to your IT admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏒᎾ Ꮎ ᏗᏣᎸᏫᏍᏓᏁᎸ ᏧᏓᏟᎶᏍᏛᏅ ᎤᎧᏛ ᏯᏂᎪᏩᏔ IT ᎤᎾᏓᏡᎦ</term></tig></langSet>
