                <langSet xml:lang="chr"><tig><term>ᎢᎬᏩᏍᏗᎭ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature may cause an app that depends on background data to stop working when only mobile networks are available.You can find more appropriate data usage controls in the settings available within the app.">
                <langSet xml:lang="en-US"><tig><term>This feature may cause an app that depends on background data to stop working when only mobile networks are available.You can find more appropriate data usage controls in the settings available within the app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎬᏗᏗᏒ ᏰᎵᏉ ᏂᏓᎦᎵᏍᏙᏗᏍᎬᎢ ᎬᏙᏗ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎢᏳᏍᏗᏓᏂ ᎤᎾᎢ ᎭᎴᏫᏍᏓ ᏗᎦᎸᏫᏍᏓᏁᎢ ᎢᏳᏃ ᎠᏂᎩᏍᎩ ᏚᎾᏚᏓᎵ ᎨᏒᎢ ᎠᏛᏅᎢᏍᏔᏅ.ᏲᎤ cᎠn fᎢnd ᎼrᎡ ᎠpprᎣprᎢᎠᏖ ᏓᏔ ᎤᏌᎨ cᎣntrᎣlᏍ Ꭲn tᎮ ᏎtᏘngᏍ ᎠᎥᎠᎢᎳbᎴ ᏫtᎯn tᎮ Ꭰpp.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restricted profiles cannot add accounts">
