            </termEntry>
            <termEntry id="Biometric hardware unavailable">
                <langSet xml:lang="en-US"><tig><term>Biometric hardware unavailable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏃᏗ ᎠᏏᏴᏫ ᎪᎵᏍᏙᏗ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify your video collection.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify your video collection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎤᏃᏢᎯᏐᏗᏱ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏙᏗ ᎤᏂᏟᏐᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can add, remove, or change calendar events on your Android TV device.">
                <langSet xml:lang="en-US"><tig><term>This app can add, remove, or change calendar events on your Android TV device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎧᏁᏉᏍᏗ, ᎠᎲᏍᏗ, ᎠᎴᏃ ᎦᏁᏟᏴᏍᏗ ᏅᏓ ᏗᏎᏍᏗ ᏂᏕᎦᎵᏍᏔᏂᏙᎲ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Scale">
                <langSet xml:lang="en-US"><tig><term>Scale</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to access the vibrator state.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to access the vibrator state.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᏴᏍᏗ ᎾᏍᎩ ᎠᏓᏖᎸᎲᏍᎩ ᏄᏍᏗᏓᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="ISO A1">
                <langSet xml:lang="en-US"><tig><term>ISO A1</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ISO A1</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature shows suggested actions and replies, and organizes your notifications.">
                <langSet xml:lang="en-US"><tig><term>This feature shows suggested actions and replies, and organizes your notifications.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ ᎧᏁᎢᏍᏙᏔᏅ ᎢᏗᏛᏁᏗ ᎠᎴ ᏗᎦᏬᎯᎵᏴᏍᏗ, ᎠᎴ ᏚᎾᏓᏡᎬ ᏣᏤᎵ ᏗᏓᏃᏣᎳᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enhanced notifications can access notification content, including personal information like contact names and messages.">
                <langSet xml:lang="en-US"><tig><term>Enhanced notifications can access notification content, including personal information like contact names and messages.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᏢᎢ ᏗᏓᏃᏣᎳᏁᎯ ᏰᎵᏊ ᎠᏴᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᎦᎸᏛᎢ, ᎤᏠᏯᏍᏗ ᎤᏩᏌ ᎤᏤᎵ ᎧᏃᎮᏢᎥᏍᎩ ᎢᏳᏍᏘ ᎠᏟᏃᎮᏙᏗ ᏚᎾᏙᎥ ᎠᎴ ᏗᎧᏃᎮᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature can also dismiss or respond to notifications, such as answering phone calls, and control Do Not Disturb.">
                <langSet xml:lang="en-US"><tig><term>This feature can also dismiss or respond to notifications, such as answering phone calls, and control Do Not Disturb.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏰᎵᏊ ᎾᏍᏊ ᏗᏲᎯᏍᏗ ᎠᎴᏃ ᎦᏬᎯᎵᏴᏓ ᏗᏓᏃᏣᎳᏁᎯ, ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎦᏬᎯᎵᏴᏍᎬ ᏗᏟᏃᎮᏗ ᏫᏗᎬᏔᏅᎢ, ᎠᎴ ᎠᎯᎸᏍᏗ ᎮᏍᏗ ᎠᏓᏕᏯᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Taking screenshot for bug report in  seconds.">
                <langSet xml:lang="en-US"><tig><term>Taking screenshot for bug report in  seconds.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᎬᎢ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏍᎪᏯ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᎿᎢ ᏓᏓᎾᏩᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Increase hour">
                <langSet xml:lang="en-US"><tig><term>Increase hour</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏉᏍᏗ ᏑᏟᎶᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="selected">
                <langSet xml:lang="en-US"><tig><term>selected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to receive and process SMS messages.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to receive and process SMS messages.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎤᎩᏍᏒ ᎠᎴ ᎠᏂᎯᎵᏒ SMS ᎨᏥᏃᎯᏎᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This means the app could monitor or delete messages sent to your device without showing them to you.">
                <langSet xml:lang="en-US"><tig><term>This means the app could monitor or delete messages sent to your device without showing them to you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎦᏛᎦ ᎾᏍᎩ ᎬᏙᏗ ᎡᎵᏊ ᎤᎦᏎᏍᏗᏕᎩ ᎠᎴᏃ ᏗᏍᎪᎸᏗᏍᎩ ᏗᎧᏃᎮᏍᎩ ᏫᎦᏅᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᏂᎯ ᎬᏂᎨᏒᎢ ᏂᏗᏣᏁᎸᎢ ᏂᎨᏒᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can send messages that may appear to come from calendar owners, or change events without notifying their owners.">
                <langSet xml:lang="en-US"><tig><term>This app can send messages that may appear to come from calendar owners, or change events without notifying their owners.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᏫᏅᎥᎦ ᏗᎪᎵᏰᏗ ᎥᏍᎩᎾ ᏰᎵᏉ ᎬᏂᎨᏒᎢ ᎾᎿᎢ ᏕᎮᎾ ᏅᏓᏳᏓᎴᏅᎯ ᏅᏓ ᏗᏎᏍᏗ ᎠᏓᏃᎯᏎᏗ, ᎠᎴ ᎦᏁᏟᏴᏍᏗ ᏂᏧᎵᏍᏔᏂᏓᏍᏗ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏃᎯᏎᏗ ᎤᎾᏤᎵ ᎤᏤᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to create network sockets and use custom network protocols.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to create network sockets and use custom network protocols.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎪᏢᏗ ᏧᎾᏚᏓᎵ ᏗᎫᏓᎸᏗᎢ ᎠᎴ ᎬᏙᏓ ᏄᏍᏛᎢᏯᏛᏁᏗᎢ ᏧᎾᏚᏓᎵ ᏗᎧᏃᏩᏛᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to reboot into safe mode?">
                <langSet xml:lang="en-US"><tig><term>Do you want to reboot into safe mode?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᏱᏣᏗ ᎾᏍᎩ ᎢᏣᏂᎩᏍᏙᏗ ᎾᏍᎩ ᏄᎾᏰᎯᏍᏛᎾ ᎬᏙᏗᎭ?</term></tig></langSet>
            </termEntry>
            <termEntry id="The browser and other applications provide means to send data to the internet, so this permission is not required to send data to the internet.">
                <langSet xml:lang="en-US"><tig><term>The browser and other applications provide means to send data to the internet, so this permission is not required to send data to the internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏍᏚᎢᏍᎩ ᎠᎴ ᏐᎢ ᏗᏔᏲᏍᏙᏗ ᎠᏓᏁᎳᏁᏗ ᏕᎦᏛᎢ ᎾᎢ ᏫᎦᏅᏗ ᎦᏟᏌᏅᎯ ᎾᏍᎩ ᎠᏏᎳᏕᏫᏒᎢ, ᎯᎠᏃ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ Ꮭ ᎠᏎᏯᏛᏁᏗ ᏱᎩ ᎾᎢ ᏫᎦᏅᏗ ᎦᏟᏌᏅᎯ ᎾᏍᎩ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" is muting some sounds">
                <langSet xml:lang="en-US"><tig><term> is muting some sounds</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎡᎳᏪᏍᏗ ᎢᎦᏓ ᏚᏃᏴᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This notification was ranked lower.">
                <langSet xml:lang="en-US"><tig><term>This notification was ranked lower.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏓᏃᏣᎳᏁᎯ ᎨᏒᎩ ᎦᏙᎬ ᎡᎳᏗᎨᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to provide feedback.">
                <langSet xml:lang="en-US"><tig><term>Tap to provide feedback.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᎦᏬᎯᎵᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Prevent use of all device cameras.">
                <langSet xml:lang="en-US"><tig><term>Prevent use of all device cameras.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᏍᏙᏗᏍᎩ ᎬᏙᏓ ᎥᎿᎢ ᏂᎦᏓ ᏥᏂᎬᏅᏗᏓᎾ ᏗᏓᏟᎶᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify your phone's call log, including data about incoming and outgoing calls.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify your phone's call log, including data about incoming and outgoing calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏓ ᎾᎢ ᎪᏢᎯᏐᏗ ᏣᏤᎵ ᏂᏨᏅᎩ ᏗᏟᏃᎮᏗ ᏂᏨᏅᎩ ᏫᏣᏔᏅᎩ ᎧᏃᎮᏍᎩ, ᎤᏠᏯᏍᏗ ᎦᏟᏌᏅᎯ ᏄᏰᎵᏛ ᎦᎷᎦ ᎠᎴ ᏗᏂᎩᏍᎩ ᎠᎴ ᏫᏗᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For  and all apps and services">
