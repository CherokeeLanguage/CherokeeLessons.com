            </termEntry>
            <termEntry id="Allow 5G">
                <langSet xml:lang="en-US"><tig><term>Allow 5G</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ 5G</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable third party stylus">
                <langSet xml:lang="en-US"><tig><term>Enable third party stylus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᏦᎢᏁ ᎤᎾᏓᏟᏌᎲ ᏗᎪᏪᎳᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="You said">
                <langSet xml:lang="en-US"><tig><term>You said</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Whenever an Xfinity Wi-Fi hotspot is available, your phone is set to auto-connect, so no log-ins are ever needed. Right now you're on our 4G LTE network. To change this feature, visit your Wi-Fi Preferences Settings.">
                <langSet xml:lang="en-US"><tig><term>Whenever an Xfinity Wi-Fi hotspot is available, your phone is set to auto-connect, so no log-ins are ever needed. Right now you're on our 4G LTE network. To change this feature, visit your Wi-Fi Preferences Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ Ꭰ Xfinity Wi-Fi ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ, ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎤᎾᏓᏡᎬ ᎾᎿᎢ ᎤᏩᏌ-ᎫᏓᎸᎢ, ᏓᏛ ᎭᏗ ᎠᏴᏍᏙᏗ ᎨᎡᎩ ᎢᎸᎯᏳᎢ ᎤᏚᎸᏛ. ᎠᎦᏘᏏ Ꭷ ᏂᎯ ᎨᎡᎩ ᎤᎿᎢ 4G LTE ᏧᎾᏚᏓᎵ. ᎾᎿᎢ ᎯᏁᏟᏴᎾ ᎯᎠ ᎤᏩᎬᏗᏗᏒ, ᎠᏩᏛᎯᏓᏍᏗ ᏂᏨᎤᎢ Wi-Fi ᎤᏟ ᎠᏂᏰᎸᏍᎬᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video duration reached.">
                <langSet xml:lang="en-US"><tig><term>Video duration reached.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᎢᏳᏓᏅᎯᏓ ᏭᎷᏨᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Stopping capture.">
                <langSet xml:lang="en-US"><tig><term>Stopping capture.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏗ ᎦᏂᏴᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not sent. Tap to try again.">
                <langSet xml:lang="en-US"><tig><term>Not sent. Tap to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏫᎦᏅᏅᎯ. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿᎢ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To improve location accuracy, apps and services can still scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location-based features and services. You can change this in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.">
                <langSet xml:lang="en-US"><tig><term>To improve location accuracy, apps and services can still scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location-based features and services. You can change this in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏛᏤᎳ ᎮᏙᎲᎢ ᏳᎾᏂᏘ, ᏗᎬᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎲᎵᏊ ᏱᏓᏟᎶᏍᏓ ᏫᎢ\u2011ᏈᎢ ᎠᏏᎸᏓᎢ ᎢᏳᏫ ᎨᏒᎢ, ᏍᏊ ᏯᏍᏚᎭ ᏫᎢ\u2011ᏈᎢ ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ. ᎯᏁᏟᏴᎾ LINK_BEGINWi\u2011FiᏓᏟᎶᏍᏗ ᏕᎦᎧᎲLINK_END</term></tig></langSet>
            </termEntry>
            <termEntry id="When they use Pixel Imprint, images are used to update their fingerprint model. Images used to create your child\u2019s fingerprint model are never stored, but the fingerprint model is stored securely on the phone and never leaves the phone. All processing occurs securely on the phone.">
                <langSet xml:lang="en-US"><tig><term>When they use Pixel Imprint, images are used to update their fingerprint model. Images used to create your child\u2019s fingerprint model are never stored, but the fingerprint model is stored securely on the phone and never leaves the phone. All processing occurs securely on the phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏓᏂᏙᎬ ᏂᎯ ᎬᏔᏂᏓᏍᏗ ᎤᏍᏗ ᏅᎩ ᏧᏅᏏᏯ ᎠᏟᎶᏍᏛ, ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᎬᏔᏅᎯ ᎾᎿᎢ ᏗᎪᏢᎯᏌᏅᎯ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ. ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᎬᏔᏅᎯ ᎪᏒᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎨᏒᎢ ᏤᏍᏗ ᎢᎸᎯᏳᎢ ᎠᏍᏆᏂᎪᏔᏅ, ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᏄᎾᏰᎯᏍᏛᎾ ᎤᎿᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᏃᎴ ᎢᎸᎯᏳᎢ ᏧᎦᎶᎦ ᏥᎩ ᏗᏟᏃᎮᏗ. ᏂᎦᏓ ᎠᏂᎯᎵᏒ ᏂᎦᎳᏍᏗᏍᎬ ᏄᎾᏰᎯᏍᏛᎾ ᎤᎿᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM selector">
                <langSet xml:lang="en-US"><tig><term>SIM selector</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᎠᏑᏰᏍᎩ</term></tig></langSet>
            </termEntry>
