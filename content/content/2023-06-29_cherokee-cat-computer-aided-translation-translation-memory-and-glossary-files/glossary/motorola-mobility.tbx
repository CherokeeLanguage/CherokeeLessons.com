                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎤᏌᎯᎸ </term></tig></langSet>
            </termEntry>
            <termEntry id="Never show notifications in the shade or on peripheral devices">
