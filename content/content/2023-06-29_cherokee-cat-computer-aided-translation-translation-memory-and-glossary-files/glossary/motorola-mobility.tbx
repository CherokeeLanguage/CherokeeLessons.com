            </termEntry>
            <termEntry id="Mobile data">
                <langSet xml:lang="en-US"><tig><term>Mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="The APN can\u2019t be empty.">
                <langSet xml:lang="en-US"><tig><term>The APN can\u2019t be empty.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ APN ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎤᏑᏩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Let apps refresh data automatically">
                <langSet xml:lang="en-US"><tig><term>Let apps refresh data automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏂᎩ ᏗᎬᏙᏗ ᎯᏤᎲᏍᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="The hostname you typed isn\u2019t valid.">
                <langSet xml:lang="en-US"><tig><term>The hostname you typed isn\u2019t valid.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏓᏁᎸᏍᎩ ᏚᏙᎥ ᏂᎯ ᏗᏐᏅᏍᏔᏅᎯ ᏂᎨᏒᎾ ᏓᏓᏂᎸᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="screen, lock time, timeout, lockscreen">
                <langSet xml:lang="en-US"><tig><term>screen, lock time, timeout, lockscreen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ, ᏍᏓᏯ ᎠᏍᏚᏓ ᎠᏥᎢᎵᏒ, ᎠᏲᏍᏙᏗ, ᏍᏓᏯ ᎠᏍᏚᏓ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="data usage">
                <langSet xml:lang="en-US"><tig><term>data usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press the Power button quickly 5 times or more to start the actions below">
                <langSet xml:lang="en-US"><tig><term>Press the Power button quickly 5 times or more to start the actions below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᏥᎫ ᎤᏟᏂᎩᏓ ᎠᏐᏅᏍᏙᏗ ᎤᎵᏍᏓᏊ 5 ᎢᏳᏓᎵ ᎠᎵᏱᎵᏒ ᏃᎴ ᎤᎪᏗᏊ ᎾᎿᎢ ᎭᎴᎾ ᏥᎩ ᎾᎾᏛᏁᎲᎢ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t play sound when inserting or removing phone from dock">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t play sound when inserting or removing phone from dock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎤᎾᏛᏁᎸᏗ ᎦᏃᏴᎵᏍᏗᏍᎩ ᎢᏳᏃ ᎪᏣᎸᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ ᏃᎴ ᏂᎬᏅᏕᏍᎬᎢ ᏗᏟᏃᎮᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏝᏅᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Revoke access to Do Not Disturb for ?">
                <langSet xml:lang="en-US"><tig><term>Revoke access to Do Not Disturb for ?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏎᎯᏍᏗ ᎠᏴᏍᏗ ᎾᎢ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᏍᎩᎾ ?</term></tig></langSet>
            </termEntry>
            <termEntry id="No sound from notifications">
                <langSet xml:lang="en-US"><tig><term>No sound from notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏃᏴᎵᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏗᎾᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Excludes data used by carrier networks">
                <langSet xml:lang="en-US"><tig><term>Excludes data used by carrier networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏃᎯᏯᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏮᏔᏅ ᎬᏗ ᎠᏫᏗᏍᎩ ᏚᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can’t remove all languages">
                <langSet xml:lang="en-US"><tig><term>Can’t remove all languages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎠᎲᏍᏗ ᏂᎦᏓ ᏗᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device administrator can delete all device data">
                <langSet xml:lang="en-US"><tig><term>Device administrator can delete all device data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᏰᎵᏯ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏥᏂᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Admin can delete all device data">
                <langSet xml:lang="en-US"><tig><term>Admin can delete all device data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎦᏎᏍᏗᏕᎩ ᏰᎵᏯ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏥᏂᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select more apps">
                <langSet xml:lang="en-US"><tig><term>Select more apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎤᏥ ᎢᎦᎢ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect PIN on the next attempt, this device's data will be deleted">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect PIN on the next attempt, this device's data will be deleted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ PIN ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint enrollment time limit reached. Try again.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint enrollment time limit reached. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏕᎪᏪᎸ ᏚᎾᏙᎥ ᎠᏥᎢᎵᏒ ᎠᏎᎸᎯ ᏭᎷᏨᎩ. ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This won’t cancel any mobile service plans. To download replacement SIMs, contact your carrier.">
                <langSet xml:lang="en-US"><tig><term>This won’t cancel any mobile service plans. To download replacement SIMs, contact your carrier.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎨᏍᏗ ᏰᎵ ᎠᏎᏒᏗ ᎾᏂᎥᏉ ᎠᏂᎩᏍᎩ ᎢᏯᏓᏛᏁᏗ ᏗᎫᎪᏔᏂᏓᏍᏗ. ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏓᏁᎵᏴᏍᏗᏍᎩ SIMs, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎠᏫᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When using 2 SIMs, this phone will be limited to 4G. Learn more">
                <langSet xml:lang="en-US"><tig><term>When using 2 SIMs, this phone will be limited to 4G. Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏔᏂᏓᏍᏗ 2 SIMs, ᎯᎠ ᏗᏟᏃᎮᏗ ᎠᏎ ᎨᎡᎩ ᏩᏎᏢᏊ ᎾᎿᎢ 4G. ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use  for mobile data?">
                <langSet xml:lang="en-US"><tig><term>Use  for mobile data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ  ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Rule not found.">
                <langSet xml:lang="en-US"><tig><term>Rule not found.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᎾᏩᏛᏍᏙᏗ ᎭᏗ ᎠᏩᏛᏓ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Let notifications silenced by Do Not Disturb turn on the screen">
                <langSet xml:lang="en-US"><tig><term>Let notifications silenced by Do Not Disturb turn on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏔᏅᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎡᎳᏪᏍᏙᏗ ᎬᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎠᏍᏚᎢᏍᎩ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto-rotate screen">
                <langSet xml:lang="en-US"><tig><term>Auto-rotate screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏆᎴᏅ ᏓᏥᎶᏍᏗᏓᏅ-ᎯᏗᏆᎸᏕᏯᏍᏗ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning off usage access for this app doesn't prevent your admin from tracking data usage for apps in your work profile">
                <langSet xml:lang="en-US"><tig><term>Turning off usage access for this app doesn't prevent your admin from tracking data usage for apps in your work profile</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏓ ᎬᏗᏍᎩ ᎠᏴᏍᏗ ᎾᏍᎩᎾ ᎯᎠ ᎬᏙᏗ ᏝᏍ ᎠᏲᏍᏙᏗᏍᎩ ᏱᎩ ᏣᏤᎵ ᏄᏂᎬᏫᏳᏌᏕᎩ ᏂᏓᏳᏓᎴᏅ ᎪᎷᏁᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎩ ᎾᏍᎩᎾ ᏗᎬᏙᏗ ᎾᎿᎢ ᏣᏤᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Auto-rotate">
                <langSet xml:lang="en-US"><tig><term>Use Auto-rotate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏓᏆᎴᏅ ᏓᏥᎶᏍᏗᏓᏅ-ᎯᏗᏆᎸᏕᏯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only one SIM can be active at a time.Switching won\u2019t cancel your  service.">
                <langSet xml:lang="en-US"><tig><term>Only one SIM can be active at a time.Switching won\u2019t cancel your  service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᏌᏇ SIM ᏰᎵᏯ ᎨᎡᎩ ᎬᏂᎦᎵᏍᏗ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ.ᎠᏓᏁᏟᏴᎢ ᎭᏗ ᏰᎴ ᎠᏎᏒᏗ ᏂᏨᎤᎢ  ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="All apps and data in this profile will be deleted if you continue.">
                <langSet xml:lang="en-US"><tig><term>All apps and data in this profile will be deleted if you continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏗᎬᏙᏗ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿᎢ ᎯᎠ ᎤᎧᏛ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ ᎢᏳᏃ ᏂᎯ ᏂᎦᏯᎢᏒᎢ ᎢᎭᎢᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Always show time and info">
                <langSet xml:lang="en-US"><tig><term>Always show time and info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᎠᎪᏩᏛᏙᏗ ᎠᏥᎢᎵᏒ ᏃᎴ ᎧᏃᎮᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Continue anyway via browser">
                <langSet xml:lang="en-US"><tig><term>Continue anyway via browser</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒ ᏱᏂᎦᎵᏍᏗᏉ ᎾᎿ ᎢᏗᏨ ᎠᏍᏚᎢᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera Laser Sensor">
                <langSet xml:lang="en-US"><tig><term>Camera Laser Sensor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎩᎦᎨ ᎤᏗᏞᎩ ᎠᏨᏍᏗ ᎠᏩᏘᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto-sync personal data">
                <langSet xml:lang="en-US"><tig><term>Auto-sync personal data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏆᎴᏅ ᏓᏟᎶᏍᏗᏓᏅ-ᎢᏧᎳᎭ ᏥᏄᎵᏍᏔᏅᎢ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi scanning allows apps and services to scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location\u2011based features and services.">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi scanning allows apps and services to scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location\u2011based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᎵᏍᎪᎵᏗ ᏗᎬᏙᏗ ᏃᎴ ᏴᏛᏁᏗ ᏧᏓᏟᎶᏍᏙᏗ Wi\u2011Fi ᏓᏏᎸᏓ ᎢᏳᏫ ᎨᏎᏍᏗ, ᏍᏊ Wi\u2011Fi ᏯᏍᏚᎭ ᎯᎠ ᏴᏓ, ᏓᏟᎶᏍᏓ, ᎪᏝᎯᏐᏗ ᎮᏙᎲᎢ \u2011 ᏗᎦᏎᏍᏙᏗ ᏃᎴ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect pattern on the next attempt, your work profile and its data will be deleted">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect pattern on the next attempt, your work profile and its data will be deleted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᏂᏨᎤᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Maximum attempts reached.">
                <langSet xml:lang="en-US"><tig><term>Maximum attempts reached.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨ ᏓᏁᎸᏗᏍᎬᎢ ᏭᎷᏨᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect pattern on the next attempt, this device's data will be deleted">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect pattern on the next attempt, this device's data will be deleted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t unmount USB storage. Try again later.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t unmount USB storage. Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎥᏝ ᎤᏌᎯᎸ USB ᎠᏍᏆᏂᎪᏙᏗ. ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb is on for  with custom settings.">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb is on for  with custom settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᏍᎩ ᎤᎾᎢ ᎾᏍᎩᎾ  ᎬᏗ ᏄᏍᏛ ᎢᏯᎾᏛᏁᎯ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t compute package size.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t compute package size.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᏎᎯᏍᏗᏍᎩ ᎦᏇᏅᏛ ᎢᎩᏓ ᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency calls over Wi\u2011Fi Calling are not supported by your carrier.The device switches automatically to a cellular network to place an emergency call.Emergency calls are only possible in areas with cellular coverage.">
                <langSet xml:lang="en-US"><tig><term>Emergency calls over Wi\u2011Fi Calling are not supported by your carrier.The device switches automatically to a cellular network to place an emergency call.Emergency calls are only possible in areas with cellular coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᏓᏯᏂ ᎢᏴᏛ Wi\u2011Fi ᏓᏯᏂᏍᎬ ᎨᎡᎩ ᎥᏝ ᎤᏩᎫᏍᏓᎠ ᎬᏗ ᏂᏨᎤᎢ ᎠᏫᏗᏍᎩ. ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏱᎬᏁᏟᏴᎾ ᎤᏩᏌ Ꮎ ᏕᎫᏓᎸ ᏧᎾᏚᏓᎵ (2G/3G) ᏱᏣᏚᎵ ᎤᏟᏍᏗ ᏪᏯᏁᏗTᎤᏟᏍᏗ ᎤᎵᏍᎨᏛ ᏪᏯᎾ ᎠᏎ ᎮᏙᎲ ᏕᎫᏓᎸ ᎫᏝᎢ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Add time schedule">
                <langSet xml:lang="en-US"><tig><term>Add time schedule</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎠᏥᎢᎵᏒ ᏓᏒᏍᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Trust work  with your personal data?">
                <langSet xml:lang="en-US"><tig><term>Trust work  with your personal data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᎨᏅᏯ ᏗᎦᎸᏫᏍᏓᏁᏗ  ᎬᏗ ᏣᏤᎵ ᎠᏏᏴᏫ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase all the data on the SD card, such as music or photos">
                <langSet xml:lang="en-US"><tig><term>Erase all the data on the SD card, such as music or photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ ᏥᎩ SD ᏆᎾᏲᏍᏗ, ᏕᎧᏁᎢᏍᏔᏅᎯ ᏗᎧᏃᎩᏙᏗ ᏃᎴ ᏗᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sounds great. I know of a good place not too far from here.">
                <langSet xml:lang="en-US"><tig><term>Sounds great. I know of a good place not too far from here.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᏉᏗ ᎤᏃᏴᎦ. ᎠᏆᏅᏔ ᎥᎿᎢ ᎣᏍᏓ ᎤᏙᏢᏒᎢ ᎭᏗ ᎢᎾ ᏱᎩ ᏂᏓᏳᏓᎴᏅ ᎠᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera access is required for screen attention. Tap to manage permissions for Device Personalization Services">
                <langSet xml:lang="en-US"><tig><term>Camera access is required for screen attention. Tap to manage permissions for Device Personalization Services</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏴᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎤᎬᏩᏟ ᎠᏴᏙᎳᏛᎢ ᎭᎧᏎᏍᏓ ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᎬᏩᏟ ᏥᏂᎬᏅᏗᏓᎾ ᎮᎵᏒᏊ ᏅᎦ ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Priority conversations show at the top of the pull-down shade. You can also set them to bubble and interrupt Do Not Disturb.">
                <langSet xml:lang="en-US"><tig><term>Priority conversations show at the top of the pull-down shade. You can also set them to bubble and interrupt Do Not Disturb.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᎨᏗ ᏓᎾᏟᏃᎮᏍᎬ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᏍᎩ ᎦᏚᎢ ᎥᎿᎢ ᎦᏌᏁᏍᏗ-ᎡᎳᏗ ᎠᏯᏙᎳᏛᎢ ᏂᎯ ᏰᎵᏊ ᎾᏍᏉ ᏘᎧᎲᎦ ᎾᎢ ᎠᎵᏆᎷᎲᏍᎬ ᏃᎴ ᎤᏓᏲᏍᏓᏁᎸᎩ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="cellular, mobile, cell carrier, wireless, data, 4g,3g, 2g, lte, sims">
                <langSet xml:lang="en-US"><tig><term>cellular, mobile, cell carrier, wireless, data, 4g,3g, 2g, lte, sims</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏚᏍᏗᎬ, ᎠᏓᏅᏏᏙᎯ, ᎠᏙᏢᏍᎩ ᎠᎯᏙᎯ, ᎾᏏᎳᏛᎾ, ᎦᏘᏍᎩᏌᏅᎯ, 4g,3g, 2g, lte, sims</term></tig></langSet>
            </termEntry>
            <termEntry id="Up time">
                <langSet xml:lang="en-US"><tig><term>Up time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to select a data SIM">
                <langSet xml:lang="en-US"><tig><term>Tap to select a data SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᎢ ᎠᏑᏰᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't be able to use your fingerprint to unlock your phone or verify it's you in apps.">
                <langSet xml:lang="en-US"><tig><term>You won't be able to use your fingerprint to unlock your phone or verify it's you in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᎰᎯᏳᏓ ᎢᎩ ᏂᎯ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can\u2019t connect to this network right now. Try again later.">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t connect to this network right now. Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎵᎪᏙᏗ ᎯᎠ ᏧᎾᏚᏓᎵ ᎠᎭᏂ ᏃᏊ. ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Let notifications silenced by Do Not Disturb turn on the screen and blink the light">
                <langSet xml:lang="en-US"><tig><term>Let notifications silenced by Do Not Disturb turn on the screen and blink the light</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏔᏅᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎡᎳᏪᏍᏙᏗ ᎬᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎠᏍᏚᎢᏍᎩ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏃᎴ ᎠᎦᏔᎾᏩᏍᎬ ᎾᏍᎩ ᎢᎦᎦᏘ</term></tig></langSet>
