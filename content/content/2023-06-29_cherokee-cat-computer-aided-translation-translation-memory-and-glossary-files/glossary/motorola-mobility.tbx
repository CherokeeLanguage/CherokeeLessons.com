                <langSet xml:lang="en-US"><tig><term>Private key required to install a certificate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏕᎸᎢ ᎠᏍᏚᎢᏍᏗ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎯᏘᏅᏛᎦ Ꭰ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fades after a few seconds so it\u2019s easier to see your screen">
                <langSet xml:lang="en-US"><tig><term>Fades after a few seconds so it\u2019s easier to see your screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᎩ ᎤᎶᏐᏅ Ꭰ ᎢᎸᏍᎩ ᏓᏓᎾᏩᏍᎬ ᏓᏛ ᎾᏍᎩ ᎠᎯᏗᏳ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏂᏨᏅᎢ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Auto-rotate">
