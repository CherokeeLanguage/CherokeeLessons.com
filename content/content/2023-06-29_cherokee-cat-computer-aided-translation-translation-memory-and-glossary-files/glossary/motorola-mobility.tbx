            <termEntry id="Recommended">
                <langSet xml:lang="en-US"><tig><term>Recommended</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᏉᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Roaming charges may apply. Tap to modify.">
                <langSet xml:lang="en-US"><tig><term>Roaming charges may apply. Tap to modify.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏙᎵᏙᎲ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎲᏓ. ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎤᏃᏒᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use an accessibility feature, swipe up from the bottom of the screen with 3 fingers.To switch between features, swipe up with 3 fingers and hold.">
                <langSet xml:lang="en-US"><tig><term>To use an accessibility feature, swipe up from the bottom of the screen with 3 fingers.To switch between features, swipe up with 3 fingers and hold.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎬᏴᏍᏗ ᎨᏒ ᎤᏩᎬᏗᏗᏒ, ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎡᎳᏗᏢ ᎠᏂ ᎠᏴᏙᎳᏛᎢ ᎬᏗ 3 ᏕᎦᏰᏌᏛ.ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᎠᏰᏟ ᏗᎦᏎᏍᏙᏗ, ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎬᏗ 3 ᏕᎦᏰᏌᏛ ᎠᎴ ᏣᏂᏴᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 98.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 98.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 98</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete ">
                <langSet xml:lang="en-US"><tig><term>Delete </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ </term></tig></langSet>
