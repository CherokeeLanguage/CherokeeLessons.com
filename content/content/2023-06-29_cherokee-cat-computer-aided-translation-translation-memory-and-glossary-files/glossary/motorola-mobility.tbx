                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera can't capture video because the recorder is busy.">
                <langSet xml:lang="en-US"><tig><term>Camera can't capture video because the recorder is busy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏟᎶᏍᏗᏍᎩ ᏝᏰᎵ ᏱᎬᏴᎦᏂᏯ ᎠᏓᏴᎳᏛᏍᎩ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᏍᎩ ᎥᎦᏫᏁᏍᎬ ᎦᏂᏱᏍᎩ ᎾᏍᎩ ᏚᎸᏫᏍᏓᏁᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To record a video, stop the current recording or restart.">
                <langSet xml:lang="en-US"><tig><term>To record a video, stop the current recording or restart.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎦᏂᏴᏙᏗ ᎾᏍᎩ ᎠᏓᏴᎳᏛᏍᎩ, ᎭᎴᏫᏍᏙᏓ ᎾᏍᎩ ᏃᏊ ᏥᎩ ᎦᏂᏴᏗᏍᎬ ᎠᎴᏃ ᏥᎭᏂᎩᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="END CURRENT CALL">
                <langSet xml:lang="en-US"><tig><term>END CURRENT CALL</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏆᏓ ᏃᏊ ᏥᎩ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Receive emergency alert: Exercise/Drill message">
                <langSet xml:lang="en-US"><tig><term>Receive emergency alert: Exercise/Drill message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏍᏗ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏗᏓᏃᏎᎯ: ᏗᎵᏏᎾᎯᏍᏙᏗ/ᎠᏔᎳᏱᏍᏘ ᏗᎦᏃᏣᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You may need to see the instructions that came with that device.">
                <langSet xml:lang="en-US"><tig><term>You may need to see the instructions that came with that device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏥᎩ ᏗᎾᏓᏕᏲᎲᏍᎦ ᎥᏍᎩᎾ ᎤᎷᏨᎩ ᎬᏗ ᎥᏍᎩᎾ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you have access to the LTE network and your device is enabled to make calls over LTE(VoLTE), your calls will seamlessly transition to the  LTE network.">
                <langSet xml:lang="en-US"><tig><term>If you have access to the LTE network and your device is enabled to make calls over LTE(VoLTE), your calls will seamlessly transition to the  LTE network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏂᎯ ᎤᎭ ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᏥᎩ LTE ᎫᏓᎸᎢ ᎠᎴ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᎾᎿᎢ ᎪᏢᏗ ᏓᏯᏂ ᎢᏴᏛ LTE(VoLTE), ᏂᏨᎤᎢ ᏓᏯᏂ ᎠᏎ ᎦᏰᏫᏒ ᎬᎾᎨᏒ ᏂᎨᏒᎾ ᎠᏁᏟᏔᏅᎢ ᎾᎿᎢ ᏥᎩ  LTE ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Calls and messages made over Wi-Fi will be charged like cellular calls for certain plans.">
                <langSet xml:lang="en-US"><tig><term>Calls and messages made over Wi-Fi will be charged like cellular calls for certain plans.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏯᏂ ᎠᎴ ᏗᎪᎵᏰᏗ ᏄᎵᏍᏔᏅ ᎢᏴᏛ Wi-Fi ᎠᏎ ᎨᎡᎢ ᏗᎬᏩᎶᏔᏅ ᎯᎸᏉᏗ ᏫᏚᏍᏗᎬᎢ ᏓᏯᏂ ᎤᎬᏩᏟ ᏑᏓᎴᎩ ᏗᎫᎪᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Only one SIM can be active at a time.">
                <langSet xml:lang="en-US"><tig><term>Only one SIM can be active at a time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᏌᏇ SIM ᏰᎵᏯ ᎨᎡᎩ ᎬᏂᎦᎵᏍᏗ ᎤᎿᎢ Ꭰ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep this setting turned ON to connect to the latest available 5G network.">
                <langSet xml:lang="en-US"><tig><term>Keep this setting turned ON to connect to the latest available 5G network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎬᏁᏍᏗ ᎯᎠ ᏕᎦᎧᎲᎢ ᎠᏍᏚᎢᏓ ᎫᏓᎸᏗᎢ ᎾᎢ ᎢᏤᎯᎨᎢᏍᏗ ᎠᏛᏅᎢᏍᏔᏅ 5G ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Receive emergency alert: Operator defined">
                <langSet xml:lang="en-US"><tig><term>Receive emergency alert: Operator defined</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏍᏗ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏗᏓᏃᏎᎯ: ᎠᎯᎵᏙᎯ ᏗᎪᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bold text">
