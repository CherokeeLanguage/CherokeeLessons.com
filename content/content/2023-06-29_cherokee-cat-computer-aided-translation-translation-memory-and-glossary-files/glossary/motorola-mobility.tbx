            </termEntry>
            <termEntry id="Wait for debugger">
                <langSet xml:lang="en-US"><tig><term>Wait for debugger</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎦᏘᏓ ᏗᎪᎷᏩᏘᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Strict mode enabled">
                <langSet xml:lang="en-US"><tig><term>Strict mode enabled</term></tig></langSet>
