            </termEntry>
            <termEntry id="It will now turn off to cool down.">
                <langSet xml:lang="en-US"><tig><term>It will now turn off to cool down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᎲᏍᎩ ᎤᏁᏒᏴᏟ ᏂᏛᎦᎵᏍᏔᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Require PIN to start up your device. While off, this device can't receive calls, messages, notifications, or alarms.">
                <langSet xml:lang="en-US"><tig><term>Require PIN to start up your device. While off, this device can't receive calls, messages, notifications, or alarms.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᎠᏎᏯᏛᏁᏗ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᎠᏂᎩᏍᏙᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.ᎾᎿᎢ ᎠᏂᎩᏍᏙᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎾᎯᏳᎢ ᎠᏍᏚᎭ, ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᏓᏯᏂ, ᏗᎪᎵᏰᏗ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᏗᏓᏕᏯᏙᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Easily access your most-used apps right on the Home screen.">
                <langSet xml:lang="en-US"><tig><term>Easily access your most-used apps right on the Home screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᏳ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᎤᎪᏗᏗ-ᎬᏔᏅᎯ ᏗᎬᏙᏗ ᎠᎦᏘᏏ ᎤᎿᎢ ᏥᎩ ᎣᏪᏅᏒ ᎠᏴᏙᎳᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Why did my phone turn off by itself?">
                <langSet xml:lang="en-US"><tig><term>Why did my phone turn off by itself?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎲ ᏗᏝᏃᎮᏗ ᎤᏩᏌ ᏣᎵᏍᏚᎲᎦ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone got hot.">
                <langSet xml:lang="en-US"><tig><term>Your phone got hot.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏗᏞᎩ ᏂᎦᎵᏍᏓ ᏗᏝᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Logging level">
