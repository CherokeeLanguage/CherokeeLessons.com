                <langSet xml:lang="en-US"><tig><term>Get Music Premium to listen ad-free and offline</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ Music Premium ᎾᎿᎢ ᎭᏛᏓᏍᏓ ᎦᏃᏣᎶᏗ-ᎠᏎᏊᎢ ᎠᎴ ᏂᎫᏓᎸᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Glance presents full-screen visuals on the lockscreen every time.">
