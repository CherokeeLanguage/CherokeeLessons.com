                <langSet xml:lang="chr"><tig><term>ᏓᏅᏖᏍᎬᎫᏝᎢ ᎠᏂᎩᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Other devices can still connect to your HotSpot by entering its network name manually.">
