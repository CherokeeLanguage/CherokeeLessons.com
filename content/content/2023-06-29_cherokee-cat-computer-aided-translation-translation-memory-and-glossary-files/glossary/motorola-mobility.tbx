                <langSet xml:lang="en-US"><tig><term>Connecting to PC </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏍᎬᎢ ᎾᎾᎢ PC </term></tig></langSet>
            </termEntry>
            <termEntry id="Transfer text">
                <langSet xml:lang="en-US"><tig><term>Transfer text</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᎪᏪᎳᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="quick view display,external display,small display, cli">
                <langSet xml:lang="en-US"><tig><term>quick view display,external display,small display, cli</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᎪᏩᏛᏗ ᎠᏓᏴᎳᏔᏍᎩ,ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ,ᎤᏍᏗ ᎠᏓᏴᎳᏔᏍᎩ, cli</term></tig></langSet>
            </termEntry>
            <termEntry id="Once you start Mobile hotspot your currently active  session would be closed.">
                <langSet xml:lang="en-US"><tig><term>Once you start Mobile hotspot your currently active  session would be closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏊᏃ ᎭᎴᏅᎲᎢ ᎠᏓᏅᏏᏙᎯ ᎤᏗᏞᎩ ᏣᏤᎵ ᏃᏊᎨᏒᎢ ᎠᎵᏖᎸᎲᏍᎩ  ᏗᎦᎳᏫᎢᏍᏗ ᎨᏒᎢ ᎠᏍᏚᎮᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Install Ready for Assistant on your Windows PC ">
                <langSet xml:lang="en-US"><tig><term>Install Ready for Assistant on your Windows PC </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏘᏅᏛᎦ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ ᎤᎾᎢ ᏣᏤᎵ Windows PC </term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data limit reached">
                <langSet xml:lang="en-US"><tig><term>Mobile data limit reached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ ᏭᎷᏨᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to start recording.">
                <langSet xml:lang="en-US"><tig><term>Unable to start recording.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎭᎴᎾ ᎦᏂᏴᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Subject tracking">
                <langSet xml:lang="en-US"><tig><term>Subject tracking</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏗ ᎪᎷᏁᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Persistent">
                <langSet xml:lang="en-US"><tig><term>Persistent</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎫᏩᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read data about your contacts stored on your Android TV device. Apps will also have access to the accounts on your Android TV device that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read data about your contacts stored on your Android TV device. Apps will also have access to the accounts on your Android TV device that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏍᎾᎩ ᎬᏙᏗ ᎠᎪᎵᏰᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏰᎵᏛ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᏓᏍᏆᏂᎪᏛ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᏗᎬᏙᏗ ᎠᏎ ᎾᏍᏊ ᎤᎭ ᎤᏴᏍᏗ ᎾᏍᎩ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩᎢ ᎤᏂᎭ ᎤᏬᏢᏗᎢ ᏗᏟᏃᎮᏙᏗ. ᎯᎠ ᏰᎵᏉ ᎠᏠᏯᏍᏓ ᏗᏚᏓᎸᏙᏗ ᎪᏢᏅᎢ ᏄᏩᏅ ᏗᎬᏙᏗ ᎯᎠ ᎯᏘᏅᏛᎦ. ᎯᎠ ᏗᎵᏍᎪᎸᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎠᎳᏏᏅᏗᏍᎪ ᏣᏤᎵ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ, ᏃᎴ ᎤᏁᎫᏥᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎠᏯᏙᎯᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᏂᏣᏅᏛᎾᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For mode is enabled">
                <langSet xml:lang="en-US"><tig><term>Ready For mode is enabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎬᏙᏗᎭ ᏄᏍᏛ ᎡᎵᏊ ᎢᏳᎵᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't use special characters: \u003c \u003e * / | \u005C ? : &quot;">
                <langSet xml:lang="en-US"><tig><term>Can't use special characters: \u003c \u003e * / | \u005C ? : "</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎦᏴᏓ ᎤᏓᏤᏟᏓ ᏕᎪᏪᎸ:\u003c\u003e*\ \ \u005C?:*</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth permission is not granted for Ready For Engine.">
                <langSet xml:lang="en-US"><tig><term>Bluetooth permission is not granted for Ready For Engine.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏄᏍᏛ ᎥᏝ ᎤᎵᏍᎪᎸᏔᏅ ᏂᎨᏒᎾ ᎾᏍᎩᎾ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎠᏥᎳ ᎠᏂᎩᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you've turned on Wi-Fi on both your phone and PC or connected with a USB cable.">
                <langSet xml:lang="en-US"><tig><term>Make sure you've turned on Wi-Fi on both your phone and PC or connected with a USB cable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎢᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ PC ᎠᎴᏃ ᎫᏓᎸᏅᎯ ᎬᏗ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connection failed.">
                <langSet xml:lang="en-US"><tig><term>Connection failed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎤᏓᏄᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again or use a USB cable to connect instead.">
                <langSet xml:lang="en-US"><tig><term>Try again or use a USB cable to connect instead.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ ᎠᎴᏃ ᎬᏙᏓ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᎾᎢ ᏗᎵᎪᏙᏗ ᎤᎬᏫᏳᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Alarm off">
                <langSet xml:lang="en-US"><tig><term>Alarm off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏙᏗᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Text saved to  clipboard">
