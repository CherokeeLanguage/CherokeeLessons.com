            </termEntry>
            <termEntry id="Only turn off 5G Standalone if advised by your wireless carrier. Turning off 5G Standalone could downgrade the type of network your phone is connected to.">
                <langSet xml:lang="en-US"><tig><term>Only turn off 5G Standalone if advised by your wireless carrier. Turning off 5G Standalone could downgrade the type of network your phone is connected to.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎠᏍᏚᏗ 5G ᎦᏙᎬᎤᏩᏒ ᎢᏳᏃ ᎤᏓᏬᏅᏔᏅᎩ ᎬᏗ ᏂᏨᏅᎢ ᏂᏓᏏᎳᏛᎾ ᎠᏓᏁᎸᏍᎩ. ᎥᏍᏚᎲᏍᎬ 5G ᎦᏙᎬᎤᏩᏒ ᎡᎵᏊ ᎡᎳᏗ ᎢᏯᏛᏁᎯ ᏄᏍᏛᎢ ᏧᎾᏚᏓᎸ ᏂᏨᏅᎯ ᏗᏟᏃᎮᏗ ᏫᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove existing face scan and create a new scan">
                <langSet xml:lang="en-US"><tig><term>Remove existing face scan and create a new scan</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᎬᏂᎨᏒ ᏄᏍᏛᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᏃᎴ ᎪᏒᏗ Ꭰ ᏗᏤ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="A SIM card is required to connect to . You may not have inserted your sim card yet or it may be inserted incorrectly.Please turn Off your phone and make sure your SIM card is properly inserted, then turn your phone back on, and try connecting again">
                <langSet xml:lang="en-US"><tig><term>A SIM card is required to connect to . You may not have inserted your sim card yet or it may be inserted incorrectly.Please turn Off your phone and make sure your SIM card is properly inserted, then turn your phone back on, and try connecting again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ SIM ᏆᎾᏲᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎫᏓᎸᎢ ᎾᎿᎢ . ᏂᎯ ᏰᎵᏯ ᎥᏝ ᎤᎭ ᏫᎪᏣᎸᏅᎢ ᏂᏨᎤᎢ sim ᏆᎾᏲᏍᏗ ᎩᎳ ᏃᎴ ᎨᎡᎢ ᏰᎵᏯ ᎨᎡᎢ ᏫᎪᏣᎸᏅᎢ ᏂᏚᏳᎪᏛᎾ.ᎰᏩᏊ ᎠᏍᏚᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᏨᎤᎢ SIM ᏆᎾᏲᏍᏗ ᎨᎡᎢ ᏗᏙᎳᏤᎩ ᏫᎪᏣᎸᏅᎢ, ᎢᏳᏃ ᎠᎦᏔᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏨᏍᏗ ᎤᎿᎢ, ᏃᎴ ᏣᏁᎸᏙᏗ ᏓᎾᎵᎪᏗᏍᎬ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some messages not downloaded in Messages">
                <langSet xml:lang="en-US"><tig><term>Some messages not downloaded in Messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᎪᎵᏰᏗ Ꮭ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᎾᎿ ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically adjust 5G connection and data transfer mode to save battery">
                <langSet xml:lang="en-US"><tig><term>Automatically adjust 5G connection and data transfer mode to save battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᎣᏍᏓ ᏱᎬᏁᎸᎢ 5Ꮆ ᎫᏓᎸᎢ ᏃᎴ ᎦᏟᏌᏅ ᎠᎲᏍᏗ ᎬᏙᏗ ᎠᎵᏏᏅᏙᏗ ᎠᎾᎦᎵᏍᎩ</term></tig></langSet>
            </termEntry>
