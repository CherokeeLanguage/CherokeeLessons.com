            </termEntry>
            <termEntry id="Change carrier location access settings">
                <langSet xml:lang="en-US"><tig><term>Change carrier location access settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏁᏟᏴᎾ ᏣᎯᏙ ᎠᏙᎲ ᎠᏴᏍᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You have unsaved changes">
                <langSet xml:lang="en-US"><tig><term>You have unsaved changes</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ  ᏣᎭ ᏍᏆᏂᎪᏓᏅ ᏂᎨᏒᎾ ᏗᎦᏁᏟᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="During an RTT call, you will not be able to change it to a video call.">
                <langSet xml:lang="en-US"><tig><term>During an RTT call, you will not be able to change it to a video call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ Ꭰ RTT ᏪᏯᎾ, ᏂᎯ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎢᏯᏛᏁᏗ to ᎦᏁᏟᏴᏍᏗ ᎨᎡᎢ ᎾᎿᎢ Ꭰ ᎠᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Adaptive performance collects this data at appropriate times and only stores the information on your device.">
                <langSet xml:lang="en-US"><tig><term>Adaptive performance collects this data at appropriate times and only stores the information on your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᏧᎸᏫᏍᏓᏁᎯ ᏗᎦᏟᏌᏅᎩ ᎯᎠ ᎦᏟᏌᏅᎯ ᎤᎾᎢ ᏗᏙᎳᎩ ᏓᏟᎢᎵᏒ ᎠᎴ ᎤᏩᏌ ᎠᏍᏆᏂᎪᏛ ᏓᏍᏆᏂᎪᏗᏍᎬ ᎾᏍᎩ ᎧᏃᎮᏢᎥᏍᎩ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dual SIM settings is running on Guest User mode.">
                <langSet xml:lang="en-US"><tig><term>Dual SIM settings is running on Guest User mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᎲ SIM ᏕᎦᎧᎲᎢ ᎠᏂᎩᏍᏛ on ᎠᏓᏩᏛᎯᏙᎯ ᎠᏅᏗᏍᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Preloaded Contacts Loader needs permission to access some things in your device.">
                <langSet xml:lang="en-US"><tig><term>Preloaded Contacts Loader needs permission to access some things in your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮟ ᏄᎪᎲᎾᏊ ᏫᏗᎦᏁᏍᏗ ᎠᎵᏍᎪᎵᏙᏗ ᎤᏚᎵ ᎤᏴᏍᏗ ᎢᎦᏓ ᏥᏂᎬᏅᏗᏓᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select each app for more information.">
                <langSet xml:lang="en-US"><tig><term>Select each app for more information.</term></tig></langSet>
