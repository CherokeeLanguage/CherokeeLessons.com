            </termEntry>
            <termEntry id="Moto Photo Editor">
                <langSet xml:lang="en-US"><tig><term>Moto Photo Editor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto Photo Editor</term></tig></langSet>
            </termEntry>
            <termEntry id="There are no tips available">
                <langSet xml:lang="en-US"><tig><term>There are no tips available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝᏰᏃ ᏗᏓᏃᎯᏎᎯ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Click to control musicWhen music is playing you can single click the stylus button to play / pause.">
                <langSet xml:lang="en-US"><tig><term>Click to control musicWhen music is playing you can single click the stylus button to play / pause.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎫᎪᏔᏂᏓᏍᏗ ᏗᎧᏃᎩᏙᏗ ᎭᏐᏅᏍᏓᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎠᏐᏅᏍᏙᏗ ᏌᏊᎢᏳᎪᏗ ᎭᏐᏅᏍᏓ ᏂᎯ ᏰᎵᏊ ᎢᏳᏃ ᏗᎧᏃᎩᏙᏗ ᏓᏁᎶᎲᏍᎦ ᎾᎿᎢ ᏗᏁᎸᏙᏗᎢ / ᎯᏲᎯᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Or you can double click to play the next song.">
                <langSet xml:lang="en-US"><tig><term>Or you can double click to play the next song.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴ ᏔᎵᏳᏩᎪᏗ ᎭᏐᏅᏍᏓ ᏂᎯ ᏰᎵᏊ ᎾᎿᎢ ᏗᏁᎸᏙᏗᎢ ᏗᎧᏃᎩᏓ ᏐᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You’ll see the cursor moving on the external display.">
                <langSet xml:lang="en-US"><tig><term>You’ll see the cursor moving on the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎪᏪᎵᏍᎬ ᎠᎴᏅᏙᏗ ᎠᏂᎩᏍᎩ ᏂᎯᏊᏃ ᎤᎾᎢ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="OCR">
                <langSet xml:lang="en-US"><tig><term>OCR</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>OCR</term></tig></langSet>
            </termEntry>
            <termEntry id="Click to switch pen typesIn Coloring book you can switch between your current and last used pen stylus by single clicking the stylus button.">
                <langSet xml:lang="en-US"><tig><term>Click to switch pen typesIn Coloring book you can switch between your current and last used pen stylus by single clicking the stylus button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᏗᎪᏪᎶᏗ ᎢᏧᏍᏗᎾᎿ Coloring book ᏃᏊ ᏥᎩ ᎠᎴ ᎣᏂ ᎬᏔᏅᎯ ᏗᎪᏪᎶᏗ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎦᏁᏟᏴᏍᏗ ᎠᏰᎵ ᏂᎯ ᏰᎵᏊ ᏌᏊᎢᏳᎪᏗ ᎠᏐᏅᏍᏗᏍᎩ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎠᏐᏅᏍᏙᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Click to switch pen typesIn Screenshot editor you can switch between your current and last used stylus by single clicking the stylus button.">
                <langSet xml:lang="en-US"><tig><term>Click to switch pen typesIn Screenshot editor you can switch between your current and last used stylus by single clicking the stylus button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᏗᎪᏪᎶᏗ ᎢᏧᏍᏗᎾᎿ Screenshot ᎣᏍᏓ ᏗᎦᎧᎲᏍᎩ ᏃᏊ ᏥᎩ ᎠᎴ ᎣᏂ ᎬᏔᏅᎯ ᏗᎪᏪᎶᏗ ᎠᎾᎦᎵᏍᎩ ᎦᏁᏟᏴᏍᏗ ᎠᏰᎵ ᏂᎯ ᏰᎵᏊ ᏌᏊᎢᏳᎪᏗ ᎠᏐᏅᏍᏗᏍᎩ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎠᏐᏅᏍᏙᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="In drawing mode, draw a shape and leave your stylus on the canvas for 1.5 seconds">
                <langSet xml:lang="en-US"><tig><term>In drawing mode, draw a shape and leave your stylus on the canvas for 1.5 seconds</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎠᏍᏓᏅᎿᏂᏙᎸ ᎬᏙᏗ, ᎠᏂᎾᏏᏁᎩ ᎤᏙᏢᏒᎢ ᎠᎴ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎤᎾᎢ ᎦᎵᏦᏙᏗ  ᎯᏅᏅᎢ ᎾᏍᎩᎾ 1.5 ᏓᏓᎾᏩᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="If it doesn't look good, you can change it back in Ready For settings on your phone.">
