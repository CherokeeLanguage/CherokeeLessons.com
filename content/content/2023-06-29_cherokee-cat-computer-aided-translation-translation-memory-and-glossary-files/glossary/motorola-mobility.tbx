            </termEntry>
            <termEntry id="You may need to approve this connection on your printer's front panel">
                <langSet xml:lang="en-US"><tig><term>You may need to approve this connection on your printer's front panel</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏛ ᎾᎢ ᎪᎯᏳᏙᏗ ᎯᎠ ᎫᏓᎸᎢ ᎤᎾᎢ ᏣᏤᎵ ᏗᎦᎴᏴᏗᏍᎩ ᏄᏩᏅ ᎠᎬᏱᏗᏨ ᎠᏯᏔᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't remind me again">
                <langSet xml:lang="en-US"><tig><term>Don't remind me again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏅᏓᏗᏍᏙᏗ ᎠᏯ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot place any call during video calls">
                <langSet xml:lang="en-US"><tig><term>Cannot place any call during video calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎤᏙᏢᏒ ᎾᏂᎥᏉ ᏪᏯᎾ ᎾᎯᏳ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT is not available for this 911 call. Your call has been connected as a voice-only call. If you experience difficulties, please place a voice or relay call to 911">
                <langSet xml:lang="en-US"><tig><term>RTT is not available for this 911 call. Your call has been connected as a voice-only call. If you experience difficulties, please place a voice or relay call to 911</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᎭᏗ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎬᏩᏟ ᎯᎠ 911 ᏪᏯᎾ. ᏂᏨᏅᎢ ᏪᏯᎾ ᎫᏓᎸᏅᎯ ᎯᎢᎾᎢ ᎥᎧᏁᎬᎢ-ᎤᏅᏒ ᏪᏯᎾ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏙᎲᏒ ᎤᏦᏎᏍᏗ, ᎰᏩᏊ ᎤᏙᏢᏒ ᎥᎧᏁᎬᎢ ᏃᎴ ᎦᏓᏁᏟᏴᏍᏗ ᏪᏯᎾ ᎾᎿᎢ 911</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT is not available for this call. Your call has been connected as a voice-only call.">
                <langSet xml:lang="en-US"><tig><term>RTT is not available for this call. Your call has been connected as a voice-only call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᎭᏗ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎬᏩᏟ ᎯᎠ ᏪᏯᎾ ᏂᏨᏅᎢ ᏪᏯᎾ ᎫᏓᎸᏅᎯ ᎯᎢᎾᎢ ᎥᎧᏁᎬᎢ-ᎤᏅᏒ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot place a video call during calls">
                <langSet xml:lang="en-US"><tig><term>Cannot place a video call during calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎤᏙᏢᏒ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎾᎯᏳ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call cannot be added at this time.">
                <langSet xml:lang="en-US"><tig><term>Call cannot be added at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᏊᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call cannot be added at this time.">
                <langSet xml:lang="en-US"><tig><term>Call cannot be added at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᏊᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Real-Time Text (RTT) Calling">
                <langSet xml:lang="en-US"><tig><term>Real-Time Text (RTT) Calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ-ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT) ᏫᏗᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This service requires cellular data connection. Please turn it on to continue.">
                <langSet xml:lang="en-US"><tig><term>This service requires cellular data connection. Please turn it on to continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎢᏯᏓᏛᏁᏗ ᎠᏎᎢᏯᏛᏁᏗ ᏫᏚᏍᏗᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ. ᎰᏩᏊ ᎯᏍᏚᎢᏃ ᎤᎾᎢ ᏂᎦᏯᎢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="5G/4G/3G/2G(Auto)">
                <langSet xml:lang="en-US"><tig><term>5G/4G/3G/2G(Auto)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>5G/4G/3G/2G(Auto)</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT sends what you are typing instantly during a phone call, giving you the ability to communicate using texts in real time. You will be able to see partial responses before the entire message is complete.">
                <langSet xml:lang="en-US"><tig><term>RTT sends what you are typing instantly during a phone call, giving you the ability to communicate using texts in real time. You will be able to see partial responses before the entire message is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏫᏗᎦᏅᏍᎩ ᎢᏳᏍᏗ ᏂᎯ ᎨᏒᎢ ᏗᏐᎥᏍᏙᏗ ᎤᎵᏍᏗᏓᏬ ᎾᎯᏳ ᏗᏟᏃᎮᏗ ᏫᎬᏔᏅ, ᎡᏣᏁᎲᎢ ᎾᏍᎩ ᎢᎬᏩᏛᏗ ᎨᏒ ᎾᎢ ᎠᏓᏛᎪᏔᏅ ᎬᏗᏍᎬ ᏗᎪᏪᎳᏅᎢ ᎾᎿᎢ ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ. ᏂᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᎠᎪᏩᏛᏗ ᎢᎦᏓᏊ ᏗᎦᏬᎯᎵᏴᏓ ᎤᏓᎷᎸ ᎾᏍᎩ ᎧᎵᏬ ᎧᏃᎮᏍᎩ ᎾᏍᎩ ᎠᏍᏆᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Text">
                <langSet xml:lang="en-US"><tig><term>Real Time Text</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call is not connected.Would you like to retry?">
                <langSet xml:lang="en-US"><tig><term>Call is not connected.Would you like to retry?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᏔᏅ ᎾᏍᎩ ᎭᏗ ᏱᏣᏚᏓᎵ.ᏂᎯᏍ ᏯᏓᎯᏓ ᎾᎢ ᎢᏣᏁᎸᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT allows you to use text to communicate during a call. The other person will see each letter typed in real time. What you need to know when using RTT:">
                <langSet xml:lang="en-US"><tig><term>RTT allows you to use text to communicate during a call. The other person will see each letter typed in real time. What you need to know when using RTT:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏂᏕᎬᎦ AT&amp;T ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ, ᎠᏍᏚᏓ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ, ᎿᏉᏃ ᎯᏍᏚᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ. RTT ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᎾᎢ ᎬᏙᏓ ᎪᏪᎳᏅᎢ ᎾᏍᎩ ᎠᏓᏛᎪᏔᏅ ᎾᎯᏳ ᏫᎬᏔᏅ. ᎦᏙᎨᏃ ᏂᎯ ᎤᏚᎸᏓ ᎾᎢ ᎠᎦᏙᎥᏒ ᎾᎯᏳ ᎬᏗᏍᎬ RTT:</term></tig></langSet>
            </termEntry>
            <termEntry id="To make AT&amp;T video calls, turn off Airplane mode, then turn on Mobile data.">
                <langSet xml:lang="en-US"><tig><term>To make AT&amp;T video calls, turn off Airplane mode, then turn on Mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏂᏕᎬᎦ AT&amp;T ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ, ᎠᏍᏚᏓ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ, ᎿᏉᏃ ᎯᏍᏚᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn More">
                <langSet xml:lang="en-US"><tig><term>Learn More</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Text (RTT) Call">
                <langSet xml:lang="en-US"><tig><term>Real Time Text (RTT) Call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT) ᏫᎬᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="This action can be performed only when mobile network is available.">
                <langSet xml:lang="en-US"><tig><term>This action can be performed only when mobile network is available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎢᏯᏓᏛᏁᏗ ᎠᏎᎢᏯᏛᏁᏗ ᏫᏚᏍᏗᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT setting can not be modified during this call.">
                <langSet xml:lang="en-US"><tig><term>RTT setting can not be modified during this call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏕᎦᎧᎲᎢ ᏰᎵᏊ ᎨᏍᏗ ᏰᎵ ᎦᏁᏟᏴᏗ ᎾᎯᏳ ᎯᎠ ᏫᎬᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To make AT&amp;T video calls, turn on Mobile data.">
                <langSet xml:lang="en-US"><tig><term>To make AT&amp;T video calls, turn on Mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏂᏕᎬᎦ AT&amp;T ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ, ᎯᏍᏚᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on  may cause you cannot receive voicemails for calling accounts . To avoid this conflict, please turn off Moto voicemail first and then tap continue.">
                <langSet xml:lang="en-US"><tig><term>Turning on  may cause you cannot receive voicemails for calling accounts . To avoid this conflict, please turn off Moto voicemail first and then tap continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᎢᏍᎬ  ᏰᎵᏯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᎥᎧᏁᎬᎢ ᎤᎬᏩᏟ ᏓᏯᏂᏍᎬ ᏗᏚᏓᎸᏙᏗ . ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎯᎠ ᏂᏓᏙᎵᎬᎾ, ᎰᏩᏊ ᎠᏍᏚᏗ Moto ᎥᎧᏁᎬᎢ ᎠᎬᏱ ᏃᎴ ᎢᏳᏃ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎯᎸᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Text (RTT)">
                <langSet xml:lang="en-US"><tig><term>Real Time Text (RTT)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT)</term></tig></langSet>
            </termEntry>
            <termEntry id="Call cannot be added at this time. You can try to reach out by sending a message.">
                <langSet xml:lang="en-US"><tig><term>Call cannot be added at this time. You can try to reach out by sending a message.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᏊᎨᏒ. ᏂᎯ ᏰᎵᏊ ᏣᏁᎸᏙᏗ ᎾᎿᎢ ᎭᏙᏯᏅᎯᏓ ᎬᏗ ᏫᎦᏅᎥᏍᎬᎢ ᏗᎦᏃᏣᎳᏅᎯ ᏃᎴ ᎧᏁᎬ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When using the Real Time Text (RTT) keyboard during a call, your device sends text instantly as you type. The recipient can immediately read your message while it is being written without waiting.">
                <langSet xml:lang="en-US"><tig><term>When using the Real Time Text (RTT) keyboard during a call, your device sends text instantly as you type. The recipient can immediately read your message while it is being written without waiting.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎬᏗᏍᎬ ᎾᏍᎩ ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒᎢ ᎪᏪᎳᏅᎢ (RTT) ᏗᏐᏅᏍᏙᏗ ᎾᎯᏳ ᏫᎬᏔᏅ, ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏫᏗᎦᏅᏍᎩ ᎪᏪᎳᏅᎢ ᎤᎵᏍᏗᏓᏬ ᎯᎢᎾᎢ ᏂᎯ ᎢᏳᏍᏗ. ᎾᏍᎩᏃ ᏗᎦᏁᏍᎩ ᏰᎵᏊ ᎠᎴᏉ ᎠᎪᎵᏰᏗ ᏣᏤᎵ ᎧᏃᎮᏍᎩ ᎾᎯᏳᎢ ᎾᏍᎩ ᎠᏃᏪᎵᏍᎬ ᏄᏂᎦᏘᏛᎾᏬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call forwarding function is not allowed while roaming.">
                <langSet xml:lang="en-US"><tig><term>Call forwarding function is not allowed while roaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᏔᏅ ᎠᎬᏱᏗᏨ ᎠᎾᎩᏍᏗ ᏚᎸᏫᏍᏓᏁᎲ ᏝᏱᎩ ᎠᎵᏍᎪᎸᏔᏅ ᎾᎯᏳᎢ ᎡᏙᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call not connected.">
                <langSet xml:lang="en-US"><tig><term>Call not connected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᏔᏅ ᎭᏗ ᏱᏣᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot perform this action, needs mobile network.">
