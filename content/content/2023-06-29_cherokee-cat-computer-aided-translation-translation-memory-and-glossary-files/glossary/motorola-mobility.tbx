                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎠᏰᎸᏅ ᎤᏍᎪᏍᏗᏴ ᎨᎡᎢ ᎤᏟᏃ ᎡᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on bubbles for this app will also turn on bubbles for your device.">
                <langSet xml:lang="en-US"><tig><term>Turning on bubbles for this app will also turn on bubbles for your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢᏍᎬ ᏓᎵᏆᎷᎲᏍᎦ ᎾᏍᎩᎾ ᎯᎠ ᎬᏙᏗ ᎠᏎ ᎾᏍᏉ ᎯᏍᏚᎢ ᎤᎾᎢ ᏓᎵᏆᎷᎲᏍᎬ ᎾᎾᏍᎩ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="On / Conversations can appear as floating icons">
                <langSet xml:lang="en-US"><tig><term>On / Conversations can appear as floating icons</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏓ / ᏓᎾᏟᏃᎮᏍᎬᎢ ᏰᎵᏊ ᎤᎾᏄᎪᎢᏍᏗ ᎾᏍᎩ ᎠᏟᏲᎷᎲᏍᎩ ᏗᏱᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Nothing can bubble">
                <langSet xml:lang="en-US"><tig><term>Nothing can bubble</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎪᎱᏍᏗ ᏰᎵᏊ ᎠᎵᏆᎷᎲᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you switch the Hide my device option on, your phone will not be visible to other devices and will not appear in the list of available Wi-Fi networks. Other devices can still connect to your HotSpot by entering its network name manually.">
                <langSet xml:lang="en-US"><tig><term>If you switch the Hide my device option on, your phone will not be visible to other devices and will not appear in the list of available Wi-Fi networks. Other devices can still connect to your HotSpot by entering its network name manually.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏨᏁᏟᏴᏍᏌ ᎤᏗᏍᎬᏢ ᏥᏂᏕᎬᏅᎾ ᏱᏍᏚᎢᏏ, ᏕᏢᏃᎮᏗ ᎭᏗ ᏴᏂᎪᏩᏔ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏃᎴ ᎭᏗ ᏴᎯᎪᏩᏔ ᏚᏓᏅᏅ ᏗᏛᏅᎢᏍᏔᏅ WiFi ᎤᎾᏚᏓᎸᎢ. ᏗᏐᎢ ᏥᏂᏕᎬᏅᎾ Ꮟ ᎱᏓᎸᎥᎦ ᏂᎯ ᏣᏤᎵ ᎤᏗᏟᎩᎫᏓᎸ ᏱᏦᏪᎳᎾ ᏚᏙᎥᎢ ᏕᎯᏐᏍᏗᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If the Ready For Assistant is not installed, you can download it from ">
                <langSet xml:lang="en-US"><tig><term>If the Ready For Assistant is not installed, you can download it from </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ Ꮎ Ready For ᎠᎵᏍᏕᎵᏍᎩ Ꮭ ᎦᏘᏅᏔᏅ, ᏂᎯᏃ ᎨᎵᏉ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎾᏓᏳᏓᎴᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Organ donor">
