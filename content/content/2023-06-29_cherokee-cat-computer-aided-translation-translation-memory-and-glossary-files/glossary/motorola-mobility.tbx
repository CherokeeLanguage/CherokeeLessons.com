            </termEntry>
            <termEntry id="Reset device settings restores your phone to its original settings. Any changes you've made to the following settings will be undone: BatteryDisplayStorage">
                <langSet xml:lang="en-US"><tig><term>Reset device settings restores your phone to its original settings. Any changes you've made to the following settings will be undone: BatteryDisplayStorage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎧᎯᎲᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎦᎬᎲᎢ ᏱᏙᎪᏢᎯᏌ ᏗᏢᏃᎮᏗ ᎠᎬᏱ ᏕᏣᎧᏅᎢ. ᎢᏳᏍᏓ ᏕᏨᏁᏟᏴᏒ ᏕᎦᎧᎲ ᏙᎠᏓᏛᏁᏟᏴᏌ: ᎠᎾᎦᎵᏍᎩ ᎠᎾᎦᎵᏍᎩᎠᏓᏴᎳᏔᏍᎩᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 total • ^2 backgroundfrom last full charge">
                <langSet xml:lang="en-US"><tig><term>^1 total • ^2 backgroundfrom last full charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᏂᎦᏛ ᎦᏟᏌᏅ • ^2 ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎾᎯᏳ ᎣᏂᎧᎵ ᎬᏂᏗᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 total from last full charge">
                <langSet xml:lang="en-US"><tig><term>^1 total from last full charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᏂᎦᏛ ᎦᏟᏌᏅ ᎾᎯᏳ ᎣᏂ ᎧᎵ ᎬᏂᏗᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Computed power use">
                <langSet xml:lang="en-US"><tig><term>Computed power use</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏙᎥᎲᏍᏔᏅ ᎤᏟᏂᎩᏓ ᎬᏔᏂᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't open file">
                <langSet xml:lang="en-US"><tig><term>Can't open file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎯᏍᏚᎢ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make your screen darker so it\u2019s more comfortable to read.This can be helpful when:\u00a0Your tablet\u2019s default minimum brightness is still too bright\u00a0You\u2019re using your tablet in dark situations, like at night or in a dark room before bed ">
                <langSet xml:lang="en-US"><tig><term>Make your screen darker so it\u2019s more comfortable to read.This can be helpful when:\u00a0Your tablet\u2019s default minimum brightness is still too bright\u00a0You\u2019re using your tablet in dark situations, like at night or in a dark room before bed </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏩᎬᏂᎨᏍᏛ ᎠᏰᏙᎳᏛᎢ ᎾᏍᎩ ᎤᏟ ᎢᎦᎢ ᏄᏦᏎᏛᎾ ᎾᎿᎢ ᎠᎪᎵᏰᏗ .TᎯᏍ cᎠn bᎡ ᎮlpfᎤl wᎮn\u00a0ᏰᎵᏊ ᎨᏒᎩ ᎠᎵᏍᏕᎵᏍᎩ:\u00a0ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ\u2019s ᎡᏍᎦᏊ ᎤᏍᎪᏍᏗᏴ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎾᏍᏊ ᎤᏍᎪᏍᏗ ᏙᎢ\u00a0ᏂᏨᏅᎢ ᎬᏗᏍᎬ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ ᎾᎿ ᎤᎵᏏᎩ ᏂᏚᏍᏗᏓᏅ, ᎤᏠᏱᏉ ᎤᎿᎢ ᎤᏒᏗᎵ ᎠᎴ ᎾᎿ Ꭰ ᎤᎵᏏᎩ ᎧᏅᏑᎸ ᎢᎬᏱ ᎠᏥᏍᏔ </term></tig></langSet>
            </termEntry>
            <termEntry id="Camera is locked">
                <langSet xml:lang="en-US"><tig><term>Camera is locked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏄᏍᏛ ᏍᏓᏯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Color inversion turns light screens dark.Note:\u00a0Color inversion also turns dark screens light.\u00a0Colors will change in media and images.\u00a0Dark theme can be used to display a dark background. Dark theme works with supported apps. Color inversion works on all apps. ">
                <langSet xml:lang="en-US"><tig><term>Color inversion turns light screens dark.Note:\u00a0Color inversion also turns dark screens light.\u00a0Colors will change in media and images.\u00a0Dark theme can be used to display a dark background. Dark theme works with supported apps. Color inversion works on all apps. </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ ᎠᏨᏍᏔᏅᎩ ᎠᎦᏔᎲᎠ ᎢᎦᎦᏅ ᎠᏰᏙᎳᏛᎢ ᎤᎵᏏᎩ.ᏃᏖ\u00a0ᎠᏑᏫᏓ ᎠᏨᏍᏔᏅᎩ ᎠlᏐ tᎤrnᏍ Ꮣrk ᏍcrᎡᎡnᏍ Ꮅght.\u00a0ᏗᏑᏫᏓ ᎠᏎ ᎯᏁᏟᏴᎾ ᎾᎿ ᎦᎶᏙᏗ ᎠᎴ ᏚᏓᏴᎳᏛ.\u00a0ᎤᎵᏏᎩ ᎤᏓᏤᏟᏓ ᏰᎵᏊ ᎬᏔᏅᎯ ᎾᎿᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ Ꭰ ᎤᎵᏏᎩ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ. ᎤᎵᏏᎩ ᎤᏓᏤᏟᏓ ᏗᎧᏃᏗᏱ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᎦᎫᏍᏛᏅᎢ ᏗᎬᏙᏗ. ᎠᏑᏫᏓ ᎠᏨᏍᏔᏅᎩ ᏚᎸᏫᏍᏓᏁᎲ ᎤᎾᎢ ᏂᎦᏓ ᏗᎬᏙᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly access accessibility features from any screen.To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.To use the accessibility button in the navigation bar instead, switch to 2-button navigation or 3-button navigation.">
                <langSet xml:lang="en-US"><tig><term>Quickly access accessibility features from any screen.To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.To use the accessibility button in the navigation bar instead, switch to 2-button navigation or 3-button navigation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏴᏍᏗᎢ ᎬᏴᏍᏗ ᎨᏒᎢ ᏗᎦᏎᏍᏙᏗ ᏂᎦᎥᏉ ᎠᏴᏙᎳᏛᎢ ᏅᏛᏓᎵᏂᏍᎩ.TᎣ Ꭸt ᏍᏔrᏖd, Ꭺ tᎣ ᎠccᎡᏍᏏbᎢᎵty ᏎtᏘngᏍ Ꭰnd ᏎᎴct Ꭰ fᎡᎠtᎤrᎡ. Ꮤp Ꭳn tᎮ ᏍᎰrtcᎤt Ꭰnd ᏎᎴct tᎮ ᎠccᎡᏍᏏbᎢᎵty bᎤttᎣn.TᎣ ᎤᏎ tᎮ ᎠccᎡᏍᏏbᎢᎵty bᎤttᎣn Ꭲn tᎮ ᎾᎥᎢᎦᏘᎣn bᎠr ᎢnᏍᏖᎠd, ᏍᏫtch tᎣ 2-bᎤttᎣn ᎾᎥᎢᎦᏘᎣn Ꭳr 3-bᎤttᎣn ᎾᎥᎢᎦᏘᎣn.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make your screen dimmer so it\u2019s more comfortable to read.This can be helpful when:\u00a0Your phone\u2019s default minimum brightness is still too bright\u00a0You\u2019re using your phone in dark situations, like at night or in a dark room before bed ">
                <langSet xml:lang="en-US"><tig><term>Make your screen dimmer so it\u2019s more comfortable to read.This can be helpful when:\u00a0Your phone\u2019s default minimum brightness is still too bright\u00a0You\u2019re using your phone in dark situations, like at night or in a dark room before bed </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏩᎬᏂᎨᏍᏛ ᎠᏰᏙᎳᏛᎢ ᎾᏍᎩ ᎤᏟ ᎢᎦᎢ ᏄᏦᏎᏛᎾ ᎾᎿᎢ ᎠᎪᎵᏰᏗ .TᎯᏍ cᎠn bᎡ ᎮlpfᎤl wᎮn\u00a0ᏰᎵᏊ ᎨᏒᎩ ᎠᎵᏍᏕᎵᏍᎩ:\u00a0ᏣᏤᎵ ᏗᎳᏃᎮᏗ\u2019s ᎡᏍᎦᏊ ᎤᏍᎪᏍᏗᏴ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎾᏍᏊ ᎤᏍᎪᏍᏗ ᏙᎢ\u00a0ᏂᏨᏅᎢ ᎬᏗᏍᎬ ᏂᏨᏅᎢ ᏗᎳᏃᎮᏗ ᎾᎿ ᎤᎵᏏᎩ ᏂᏚᏍᏗᏓᏅ, ᎤᏠᏱᏉ ᎤᎿᎢ ᎤᏒᏗᎵ ᎠᎴ ᎾᎿ Ꭰ ᎤᎵᏏᎩ ᎧᏅᏑᎸ ᎢᎬᏱ ᎠᏥᏍᏔ </term></tig></langSet>
            </termEntry>
            <termEntry id="Restricted apps">
                <langSet xml:lang="en-US"><tig><term>Restricted apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎨᏗᏍᎩ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly access accessibility features from any screen. To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.">
                <langSet xml:lang="en-US"><tig><term>Quickly access accessibility features from any screen. To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏴᏍᏗᎢ ᎬᏴᏍᏗ ᎨᏒᎢ ᏗᎦᏎᏍᏙᏗ ᏂᎦᎥᏉ ᎠᏴᏙᎳᏛᎢ ᏅᏛᏓᎵᏂᏍᎩ. ᎾᎿᎢ ᎭᎴᏅᎲᎩ, Ꭷ ᎬᏴᏍᏗ ᎨᏒ ᏕᎦᎧᎲᎢ ᎠᎴ ᎠᏑᏰᏍᏗ Ꭰ ᎤᏩᎬᏗᏗᏒ. ᏥᏳᎪᏗ ᎢᎬᏁᎯ ᎠᎴ ᎬᏴᏍᏗ ᎨᏒᎢ ᎦᏛᏗ ᎠᏑᏰᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:">
                <langSet xml:lang="en-US"><tig><term>To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎭᎵᏏᏅᏓ ᎠᎾᎦᎵᏍᎩ, ᎭᎴᏫᏍᏓ ᎯᎠᏃ ᏗᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ. ᎠᏓᎨᏗᏍᎩ ᏗᎬᏙᏗ ᏗᏙᎳᏤᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏰᎵᏊ Ꮭ ᎠᎴ ᏗᏓᏃᏣᎳᏁᎯ ᎤᏬᎯᏛ.ᏗᎬᏙᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:.">
                <langSet xml:lang="en-US"><tig><term>To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎭᎵᏏᏅᏓ ᎠᎾᎦᎵᏍᎩ, ᎭᎴᏫᏍᏓ ᎯᎠᏃ ᏗᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ. ᎠᏓᎨᏗᏍᎩ ᏗᎬᏙᏗ ᏗᏙᎳᏤᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏰᎵᏊ Ꮭ ᎠᎴ ᏗᏓᏃᏣᎳᏁᎯ ᎤᏬᎯᏛ.ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="RAW (DNG)">
                <langSet xml:lang="en-US"><tig><term>RAW (DNG)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏍᏓ (DNG)</term></tig></langSet>
            </termEntry>
            <termEntry id="Text scanner only works with printed text and can’t recognize handwriting">
                <langSet xml:lang="en-US"><tig><term>Text scanner only works with printed text and can’t recognize handwriting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎳᏅᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏙᏗᏍᎩ ᎤᏩᏌ ᏧᏂᎸᏫᏍᏓᏁᏗ ᎤᏠᏯᏍᏗ ᎦᎴᏴᏙᏗ ᎪᏪᎳᏅᎢ ᎠᎴ ᏝᏰᎵ ᎨᎪᏟᏍᏗ ᏱᎩ  ᎤᏬᏰᏂ ᎬᏔᏅ ᎪᏪᎶᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on location services to add a new location">
                <langSet xml:lang="en-US"><tig><term>Turn on location services to add a new location</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎤᏙᏢᏒᎢ ᎢᏗᏓᏛᏁᏗ ᎾᎢ ᎧᏁᏉᏍᏗ ᎢᏤ ᎤᏙᏢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Next, place a compatible device on top of your phone.">
                <langSet xml:lang="en-US"><tig><term>Next, place a compatible device on top of your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵᏁ, ᏫᎲᎦ ᎾᏍᎩ ᏗᏙᎵᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎦᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Easily charge another device with your phone.">
                <langSet xml:lang="en-US"><tig><term>Easily charge another device with your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᏳ ᎬᏂᏗᏍᏙᏗ ᏅᏩᏓᎴᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏠᏯᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="First, place your phone face down on a flat surface.">
                <langSet xml:lang="en-US"><tig><term>First, place your phone face down on a flat surface.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᏱ, ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎡᎳᏗᏢ ᏫᏜᎲᎦ ᎤᎾᎢ ᎤᏩᎾᏕᏍᎩ ᎦᏚ ᎠᏠᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You'll feel a short buzz when the devices connect.">
                <langSet xml:lang="en-US"><tig><term>You'll feel a short buzz when the devices connect.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏃ ᏔᏕᎳᎰᏏ ᎾᏍᎩ ᎤᏟᏍᏗ ᎤᏍᏆᏃᏴᎦ ᎾᎯᏳ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏓᎵᎪᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Confirm main space pattern">
                <langSet xml:lang="en-US"><tig><term>Confirm main space pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎯᏳᏙᏗ ᏄᎬᏫᏳᏒ ᎤᏜᏅᏛ ᏓᏟᎶᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a PIN for privacy space">
                <langSet xml:lang="en-US"><tig><term>Set a PIN for privacy space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎾᏍᎩ PIN ᎾᏍᎩᎾ ᎤᏕᎵᏓ ᎤᏜᏅᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="Please make sure your device network is normal">
                <langSet xml:lang="en-US"><tig><term>Please make sure your device network is normal</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏚᏓᎵ ᏄᏍᏛ ᏱᎬᏩᏍᏗᏭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a password for privacy space">
                <langSet xml:lang="en-US"><tig><term>Set a password for privacy space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎾᏍᎩ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎾᏍᎩᎾ ᎤᏕᎵᏓ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a PIN for main space">
                <langSet xml:lang="en-US"><tig><term>Set a PIN for main space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎾᏍᎩ PIN ᎾᏍᎩᎾ ᏄᎬᏫᏳᏒ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a pattern for main space">
                <langSet xml:lang="en-US"><tig><term>Set a pattern for main space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎾᏍᎩ ᏓᏟᎶᏍᏛᎢ ᎾᏍᎩᎾ ᏄᎬᏫᏳᏒ ᎤᏜᏅᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="Confirm privacy space pattern">
                <langSet xml:lang="en-US"><tig><term>Confirm privacy space pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎯᏳᏙᏗ ᎤᏕᎵᏓ ᎤᏜᏅᏛ ᏓᏟᎶᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="For best results when charging another phone, position the devices as shown above.">
                <langSet xml:lang="en-US"><tig><term>For best results when charging another phone, position the devices as shown above.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾ ᏫᏓᏤᏢ ᏂᏚᎵᏍᏔᏅ ᎾᎯᏳ ᎬᎾᎦᎵᏍᏗᏍᎬᎢ ᏅᏩᏓᎴᎢ ᏗᏟᏃᎮᏗ, ᎾᎯᏳ ᎯᎧᎲᎦ ᎾᏍᎩ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᎿᎢ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎦᎸᎳᏗᏢ.</term></tig></langSet>
