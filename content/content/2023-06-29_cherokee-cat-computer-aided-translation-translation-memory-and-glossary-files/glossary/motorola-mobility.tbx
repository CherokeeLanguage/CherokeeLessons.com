                <langSet xml:lang="chr"><tig><term>ᎪᏪᎳᏅᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Could not find certification for current connecting AP">
                <langSet xml:lang="en-US"><tig><term>Could not find certification for current connecting AP</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎯᏩᏔ ᎪᏪᎵ ᎬᏂᎨᏒ ᎢᏳᏩᏁᎯ ᎾᏍᎩᎾ ᏃᏊ ᏥᎩ ᏓᏠᎯᏍᏔᏅ AP</term></tig></langSet>
            </termEntry>
            <termEntry id="Color (RAW+JPG)">
                <langSet xml:lang="en-US"><tig><term>Color (RAW+JPG)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ (ᎠᎪᏍᏓ+JPG)</term></tig></langSet>
            </termEntry>
            <termEntry id="Video Capture">
                <langSet xml:lang="en-US"><tig><term>Video Capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Atmos provides a premium listening experience through your phone's loudspeakers and connected devices.">
                <langSet xml:lang="en-US"><tig><term>Dolby Atmos provides a premium listening experience through your phone's loudspeakers and connected devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Atmos ᏙᏓᎨᏥᏁᎵ ᎾᏍᎩ ᏫᏓᏤᏢᎢ ᏗᏛᏓᏍᏙᏗ ᎠᎦᏙᎲᏒᎢ ᎤᎶᏒᎯ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try tapping this to view the screen differently">
                <langSet xml:lang="en-US"><tig><term>Try tapping this to view the screen differently</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᎭᏐᎥᏍᏗᏍᎬᎢ ᎯᎠ ᎾᎢ ᎠᎪᏩᏛᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏅᏓᎴᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try capturing 360° in different modes!">
                <langSet xml:lang="en-US"><tig><term>Try capturing 360° in different modes!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᎦᏂᏱᏍᎬᎢ 360° ᎾᎿᎢ ᏧᏓᎴᎾᎢ ᏗᎬᏙᏗᎭ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Atmos delivers a premium listening experience through your phone's loudspeaker and connected devices. This feature is always on when you're listening through the loudspeaker, and you can adjust the settings for headphones and connected speakers.To disable this feature when you’re listening through the loudspeaker, tap the screen 3 times.">
                <langSet xml:lang="en-US"><tig><term>Dolby Atmos delivers a premium listening experience through your phone's loudspeaker and connected devices. This feature is always on when you're listening through the loudspeaker, and you can adjust the settings for headphones and connected speakers.To disable this feature when you’re listening through the loudspeaker, tap the screen 3 times.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Atmos ᏙᏓᎨᏥᏁᎵ ᎾᏍᎩ ᏫᏓᏤᏢᎢ ᏗᏛᏓᏍᏙᏗ ᎠᎦᏙᎲᏒᎢ ᎤᎶᏒᎯ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏄᏍᏛ ᏂᎪᎯᎸᎢ ᎤᎾᎢ ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ  ᎾᎢ ᎠᎴᏫᏍᏙᏓ ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᏕᏣᏛᏓᏍᏛ ᎤᎶᏒᎯ ᎾᏍᎩ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ, ᎭᏐᏅᏍᏓ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ 3 ᏓᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There are no saved settings for this device, so smart audio effects are enabled. You can customize the audio for this device in Dolby Audio settings.">
                <langSet xml:lang="en-US"><tig><term>There are no saved settings for this device, so smart audio effects are enabled. You can customize the audio for this device in Dolby Audio settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᏃ ᎾᏍᎩ Ꮭ ᏕᎦᎧᎲᎢ ᏗᎵᏏᏅᏔᏅ ᏱᎩ ᎾᏍᎩᎾ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ, ᎾᏃ ᎠᏌᎹᏗ ᎤᏃᏴᎬ ᏄᎵᏍᏔᏅ ᎨᏒᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏔᏅᎢ. ᏂᎯ ᏰᎵᏊ ᏯᏤᎲᏍᏙᏓ ᎾᏍᎩ ᎤᏃᏴᎬ ᎾᏍᎩᎾ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ Dolby Audio ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart audio identifies the content you're listening to and makes adjustments for optimal sound. Whether you're streaming a movie, listening to music, or playing a game, Dolby technology gives you clearer dialog, crisper detail, and more engaging sound.">
                <langSet xml:lang="en-US"><tig><term>Smart audio identifies the content you're listening to and makes adjustments for optimal sound. Whether you're streaming a movie, listening to music, or playing a game, Dolby technology gives you clearer dialog, crisper detail, and more engaging sound.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᎤᏃᏴᎬ ᏗᎪᏟᏍᏗ ᎾᏍᎩ ᎦᎸᏛᎢ ᏂᎯ ᎾᏍᎩ ᏕᏣᏛᏓᏍᏛᎢ ᏃᎴ ᏗᎪᏢᏅ ᎣᏍᏛ ᏱᏧᏅᏁᎸᎢ ᎾᏍᎩᎾ ᏫᏓᏤᏢᎢ ᎤᏃᏴᎬᎢ. ᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᏃᏊᏥᎩ ᎠᏥᎢᎵᏒᎢ ᎾᏍᎩ ᎠᏓᏴᎳᏛᏍᎩ, ᏕᏣᏛᏓᏍᏛᎢ ᏗᎧᏃᎩᏍᏗ, ᎠᎴᏃ ᏓᏁᎶᏗᏍᎬ ᎾᏍᎩ ᏗᏁᎸᏙᏗ, Dolby ᎢᏤ ᎠᎦᏙᎲᏒᎩ ᏕᏣᏁᎭ ᎬᏂᎨᏒᎢ ᏗᏟᏃᎮᏗ, ᎬᏂᎦᏒ ᏱᎬᏁᎯ ᏄᏍᏗᏓᏅᎢ, ᏃᎴ ᎤᏥ ᎢᎦᎢ ᎤᎵᎶᎯ ᎤᏃᏴᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Audio provides a premium listening experience through your phone's loudspeaker and connected devices.">
                <langSet xml:lang="en-US"><tig><term>Dolby Audio provides a premium listening experience through your phone's loudspeaker and connected devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Audio ᏙᏓᎨᏥᏁᎵ ᎾᏍᎩ ᏫᏓᏤᏢᎢ ᏗᏛᏓᏍᏙᏗ ᎠᎦᏙᎲᏒᎢ ᎤᎶᏒᎯ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
