                <langSet xml:lang="en-US"><tig><term>Active / SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᎲᏍᎩ / SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to set a lock screen PIN or password before you can start encryption.">
                <langSet xml:lang="en-US"><tig><term>You need to set a lock screen PIN or password before you can start encryption.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎦᎧᎲᎢ aᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ PIN ᎠᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎤᏓᎷᎸ ᏂᎯ ᏰᎴᏯ ᎭᎴᎾ ᎠᏕᎵᏍᏙᏗ.</term></tig></langSet>
