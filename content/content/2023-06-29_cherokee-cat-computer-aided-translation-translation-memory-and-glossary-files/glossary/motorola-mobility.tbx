                <langSet xml:lang="en-US"><tig><term>Learn more about your phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ ᎢᎸᏨ ᏂᏨᏅᎢ ᏗᏟᏃᎮᏗ</term></tig></langSet>
