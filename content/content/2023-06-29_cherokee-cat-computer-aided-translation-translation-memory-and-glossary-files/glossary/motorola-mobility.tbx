                <langSet xml:lang="chr"><tig><term>ᎤᎩᏍᏒ ᏂᏓᏳᏓᎴᏅ {deviceName}</term></tig></langSet>
            </termEntry>
            <termEntry id="Password in the privacy space should be different from that in the main space">
                <langSet xml:lang="en-US"><tig><term>Password in the privacy space should be different from that in the main space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎥᎾᎢ ᎤᏕᎵᏓ ᎤᏜᏅᏛ ᎾᎢᏳᏃ ᏧᏓᎴᎿᎢ ᎾᏍᎩᎾ ᎥᎿᎢ ᏄᎬᏫᏳᏒ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
