                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="For added security, set a pattern to unlock the tablet">
                <langSet xml:lang="en-US"><tig><term>For added security, set a pattern to unlock the tablet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎧᏁᏉᏓ ᎤᎦᏎᏍᏗ, ᎦᎧᎲᎢ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏗᎪᏪᎶᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use dock for audio">
