            <termEntry id="Select SIM">
                <langSet xml:lang="en-US"><tig><term>Select SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏏᎻ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Action Cam lets you take wide angle videos with one hand">
                <langSet xml:lang="en-US"><tig><term>The Action Cam lets you take wide angle videos with one hand</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᎵᏖᎸᏗ ᎦᎻ ᏗᏣᎵᏍᎪᎸᏓᏁᎯ ᏣᏫᏓ ᎠᏯᏖᎾ ᎠᏍᏓᏅᏅ ᎤᎷᏨ ᏗᏓᏴᎳᏛᏍᎩ ᎤᏠᏯᏍᏗ ᏌᏊ ᎤᏬᏰᏂ</term></tig></langSet>
            </termEntry>
