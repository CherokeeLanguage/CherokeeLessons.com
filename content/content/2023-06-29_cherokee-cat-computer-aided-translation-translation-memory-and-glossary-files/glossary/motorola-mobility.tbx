                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ ᏄᏪᏌᏴᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cool">
                <langSet xml:lang="en-US"><tig><term>Cool</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏌᏴᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Short ( second)">
                <langSet xml:lang="en-US"><tig><term>Short ( second)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏆᎳ ( ᏔᎵᏁᏃ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep in mind:\u25CF Your device may unlock any time you look at it.\u25CF Your device can be unlocked by someone else if they hold it in front of your face while your eyes are open.\u25CF Your device may also be unlocked by someone who looks a lot like you, such as a child or identical sibling.">
                <langSet xml:lang="en-US"><tig><term>Keep in mind:\u25CF Your device may unlock any time you look at it.\u25CF Your device can be unlocked by someone else if they hold it in front of your face while your eyes are open.\u25CF Your device may also be unlocked by someone who looks a lot like you, such as a child or identical sibling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᎣᏓᏅᏛ:\u25CF ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎠᏐᎭᎾᎸᏗ ᏂᎦᎵᏍᏘᏴᏊ ᏱᏣᎪᎵᏰᎠ.\u25CF ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᏱᎩ ᎠᏐᎭᎾᎸᏗ ᎩᎳ ᏄᏓᎴᎢ ᎢᏳᏃ ᏱᏄᏅᏁᎳ ᎢᎬᏱᏗᏢ ᏣᎧᏛᎢ ᏕᎯᎦᏅ ᏧᎵᏍᏚᎢᏓ ᏱᎩ.\u25CF ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎾᏍᏊ ᎤᏂᏐᎭᎾᎸᏗ ᎩᎶ ᎠᏏᏴᏫᏱᎩ ᎥᏠᏱ ᏤᎦᎦᏅᏗ ᏂᎯ ᎾᏣᏍᏛ, ᎾᏍᎩᏯ ᎠᏲᏟ ᎠᎴ ᎧᎵᏗᏙᎳᎩ ᎤᏠᏱ ᏏᏓᏁᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dual SIM">
                <langSet xml:lang="en-US"><tig><term>Dual SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵᏳᏩᎪᏗ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Less smooth, but ideal for longer battery life">
                <langSet xml:lang="en-US"><tig><term>Less smooth, but ideal for longer battery life</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏲᎵᎨ ᎤᏓᏲᏍᏓᏁᏗ, ᎠᏎᏃ ᎠᏑᏰᏓ ᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Captions, closed captions, CC, Live Transcribe, hard of hearing, hearing loss, CART, speech to text, subtitle">
                <langSet xml:lang="en-US"><tig><term>Captions, closed captions, CC, Live Transcribe, hard of hearing, hearing loss, CART, speech to text, subtitle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏬᏂᏍᎬ ᏕᎪᏪᎸᎢ, ᎠᏍᏚᏅᎩ ᎠᏂᏬᏂᏍᎬᎢ ᏕᎪᏪᎸᎢ, CC, ᏃᏊᏥᎩ ᏗᏟᎶᏍᏙᏗ, ᎠᏍᏓᏯ ᎥᎿᎢ ᎠᏛᎩᏍᎬ, ᎠᏛᎩᏍᎬ ᎤᏲᎱᏎᎸ, CART, ᎧᏁᏍᏗ ᎾᎿᎢ ᎠᎪᎵᏰᏗ, ᎡᎳᏗᏜ ᎤᏙᏢᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Making changes to the network will disconnect any devices currently connected to the Mobile Hotspot">
                <langSet xml:lang="en-US"><tig><term>Making changes to the network will disconnect any devices currently connected to the Mobile Hotspot</term></tig></langSet>
