            </termEntry>
            <termEntry id="Do you want to continue?">
                <langSet xml:lang="en-US"><tig><term>Do you want to continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎠᎯᎸᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Can not change call forwarding settings from your phone while you are roaming.">
                <langSet xml:lang="en-US"><tig><term>Can not change call forwarding settings from your phone while you are roaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᎦᏴᎦᏁᏟᏴᎾ ᏫᎬᏔᏅ ᎠᎬᏱᏗᏨ ᎠᎾᎩᏍᏗ ᏕᎦᎧᎲᎢ ᏂᏛᏓᎴᏂᏍᎩ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎾᎯᏳ ᏂᎯ ᎨᏒᎢ ᎡᏙᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Over your Wi-Fi data limit">
                <langSet xml:lang="en-US"><tig><term>Over your Wi-Fi data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏬᎯᎸᏙᏗ ᏂᏨᏅᎢ Wi-Fi ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This privileged or system app can take pictures and record videos using a system camera at any time. Requires the android.permission.CAMERA permission to be held by the app as well">
                <langSet xml:lang="en-US"><tig><term>This privileged or system app can take pictures and record videos using a system camera at any time. Requires the android.permission.CAMERA permission to be held by the app as well</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏪᎿᎢ ᎠᎴᏃ ᏄᏍᏗᏓᏅᎢ ᏄᏍᏗᏓᏅᎢ ᎬᏙᏗ ᏰᎵᏊ ᏔᎵᎶᏍᏓ ᏃᎴ ᎦᏂᏴᏙᏗ ᏗᏓᏴᎳᏛᏍᎩ ᎬᏗᏍᎬ ᏄᏍᏗᏓᏅᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᏴᏊ ᎨᏒᎢ. ᎠᏎᏱᏗᏛᏗ ᎾᏍᎩ android.permission.CAMERA ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎨᏒᎢ ᎤᏒᎦᏢ ᏄᏩᎾ ᎾᏍᎩ ᎬᏙᏗ ᎾᏍᏊᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Saver is off">
                <langSet xml:lang="en-US"><tig><term>Data Saver is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᎵᏏᏅᏗᏍᎩ ᏄᏍᏛ ᎾᎿ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Until you turn off Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>Until you turn off Do Not Disturb</term></tig></langSet>
