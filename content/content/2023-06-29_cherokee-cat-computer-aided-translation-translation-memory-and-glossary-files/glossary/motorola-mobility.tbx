            </termEntry>
            <termEntry id="Not charging">
                <langSet xml:lang="en-US"><tig><term>Not charging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᏓᎬᏩᎶᏗᏍᎬ</term></tig></langSet>
            </termEntry>
