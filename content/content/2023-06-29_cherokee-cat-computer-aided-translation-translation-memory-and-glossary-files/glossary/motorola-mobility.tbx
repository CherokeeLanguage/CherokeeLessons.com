            </termEntry>
            <termEntry id="Select the area to keep in focus">
                <langSet xml:lang="en-US"><tig><term>Select the area to keep in focus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏥᎩ ᎢᎬᎾᏕᎾ ᎾᎿᎢ ᎯᏍᏆᏂᎪᏓ ᎾᎿ ᎤᎿᏊ ᎢᎦ ᏔᎧᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For makes it easy to enjoy immersive video chats while you’re connected to a display.">
                <langSet xml:lang="en-US"><tig><term>Ready For makes it easy to enjoy immersive video chats while you’re connected to a display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏂᎦᎵᏍᏗᏍᎬᎢ ᎠᎯᏓ ᎨᏒᎢ ᎠᎵᎮᎵᏍᏗ ᎭᏓᏠᏯᏍᏗ ᎠᏓᏴᎳᏛᏙᏗ ᏓᎾᏟᏃᎮᏍᎬᎢ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᎫᏓᎸᏅᎯ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Total memory">
                <langSet xml:lang="en-US"><tig><term>Total memory</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏅᏓᏗᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="While you're gaming, you can access settings through the toolkit.">
                <langSet xml:lang="en-US"><tig><term>While you're gaming, you can access settings through the toolkit.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏓᏁᎸᏗᏍᎬᎢ, ᏂᎯ ᏰᎵᏊ ᏱᏴᎯ ᏕᎦᎧᎲᎢ ᎠᎦᏛᎴᏍᎩ ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ ᏧᏓᎴᏅᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Applied Effects">
                <langSet xml:lang="en-US"><tig><term>Applied Effects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᎾᏔᏅᎯ ᏂᏙᏗᎦᎵᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="More control over your privacy">
                <langSet xml:lang="en-US"><tig><term>More control over your privacy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎠᎯᎸᏍᏗ ᎢᏴᏛ ᏣᏤᎵ ᎤᏕᎵᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can open the sidebar the following ways:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select">
                <langSet xml:lang="en-US"><tig><term>You can open the sidebar the following ways:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎨᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎠᏍᏓᏩᏛᏍᏗ ᏱᏗᎬᏁᏗ: ᏥᏍᏕᏥ: ᏗᏐᏅᏍᏙᏗ: ᎠᏐᎥᏍᏙᏗ {W} + TᎢᎾ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ {M} ᏗᏁᎸᏙᏗ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ L1 + R1 + ᎠᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Android 12 provides a more human smartphone experience.">
                <langSet xml:lang="en-US"><tig><term>Android 12 provides a more human smartphone experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android 12 ᏗᎾᏓᏁᏢᏍᎩ ᎤᏟ ᎢᎦᎢ ᏴᏫ ᎠᏌᏑᏗ ᏗᏟᏃᎮᏗ ᏓᏤᏢᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Monitor the number of incorrect passwords typed when unlocking the screen, and lock your Android TV device or erase all your Android TV device's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed when unlocking the screen, and lock your Android TV device or erase all your Android TV device's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎦᏎᏍᏗᏕᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎥᎿᎢ ᏂᏚᏳᎪᏛᎾ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᏗᏐᏅᏍᏔᏅᎩ ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏰᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎥᎿᏃ ᎾᏍᎩ ᎤᏣᏖ ᏂᏚᏳᎪᏛᎾ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎨᏒᎢ ᏗᏐᏅᏍᏔᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Shapes are softer, buttons and fonts are bigger, and color is infused throughout the device.">
                <langSet xml:lang="en-US"><tig><term>Shapes are softer, buttons and fonts are bigger, and color is infused throughout the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏂᎨᎢ ᏚᏙᏢᏒᎢ ᎨᏒᎢ, ᏗᏐᎥᏍᏙᏗ ᎠᎴ ᏄᏍᏛ ᏗᏙᏪᎵᏍᎩ ᎤᏔᎾ ᎨᏒᎢ, ᎠᎴ ᎠᏑᏫᏓ ᏂᎬᎾᏛ ᏥᏂᎬᏅᏗᏓᎾ ᎧᏁᏉᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To activate, let us know the address to send emergency responders if you call 911 and we are unable to determine your location, and then accept the terms.">
                <langSet xml:lang="en-US"><tig><term>To activate, let us know the address to send emergency responders if you call 911 and we are unable to determine your location, and then accept the terms.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ, ᏗᎵᏍᎪᎸᏔᏅ ᎠᎦᏙᎥᏒ ᏥᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎾᎿᎢ ᏫᏅᎥᎦ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎤᏁᏨᎯ ᎾᎿ ᏂᎯ ᏪᏯᎾ 911 ᎠᎴ ᎢᏗ ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ, ᎠᎴ ᎾᏉᏃ ᏗᏓᏂᎸᎢᏍᏗ ᏥᎩ ᏗᏓᏁᏤᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can talk to the Google Assistant anytime, even when the flip is closed.">
                <langSet xml:lang="en-US"><tig><term>You can talk to the Google Assistant anytime, even when the flip is closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎦᏬᏂᎭ ᎾᎢ ᎾᏍᎩ Google ᎤᏂᏍᏕᎸᎯᏙᎯ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ, ᎥᏍᏊ ᎾᎯᏳ ᎾᏍᎩ ᏗᏁᏍᏆᏕᎦ ᎾᏍᎩ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="About magnification">
                <langSet xml:lang="en-US"><tig><term>About magnification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ ᎠᏔᏃᎯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock your device by another method.">
                <langSet xml:lang="en-US"><tig><term>Unlock your device by another method.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ ᏄᏓᎴ ᎢᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To update your stylus, Moto Note needs your Nearby devices permission to connect and search via bluetooth">
                <langSet xml:lang="en-US"><tig><term>To update your stylus, Moto Note needs your Nearby devices permission to connect and search via bluetooth</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎾᎿᎢ ᏙᏢᎯᏌ, Moto Note ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᏣᏤᎵ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎭᏫᏂ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎫᏓᎸᎢ ᎠᎴ ᎠᏱᏍᏗ ᎤᎶᏒ bluetooth</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure your stylus is in the folio and bluetooth is on.">
                <langSet xml:lang="en-US"><tig><term>Make sure your stylus is in the folio and bluetooth is on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᏄᏍᏛ ᎾᎯᏳ ᏗᏜᏩᏛ ᎠᎴ bluetooth ᏄᏍᏛ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Checking version…">
                <langSet xml:lang="en-US"><tig><term>Checking version…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏍᎩ ᏄᏓᎴᏒᎢ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio layer is already being used by another application.">
                <langSet xml:lang="en-US"><tig><term>Audio layer is already being used by another application.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏗᏰᎦᏟ ᎨᎡᎢ ᎦᏳᎳ ᏰᎵᏉ ᎬᏔᏅᎯ ᎬᏗ ᏄᏓᎴ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This action can't be undone">
                <langSet xml:lang="en-US"><tig><term>This action can't be undone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎢᏯᏛᏁᎵᏓᏍᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎠᏍᏆᏛ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Check">
                <langSet xml:lang="en-US"><tig><term>Check</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏎᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Service not provisioned.">
                <langSet xml:lang="en-US"><tig><term>Service not provisioned.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎢᏯᏓᏛᏁᏗ ᎠᏛᏅᎢᏍᏔᏅᎢ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can not connect with or search out the stylus">
                <langSet xml:lang="en-US"><tig><term>Can not connect with or search out the stylus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵ ᎫᏓᎸᎢ ᎬᏗ ᎠᎴ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎠᏱᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Install the new version to update your stylus.">
                <langSet xml:lang="en-US"><tig><term>Install the new version to update your stylus.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏤ ᏄᏓᎴᏒᎢ ᎯᏘᏅᎦ ᎾᎿᎢ ᏙᏢᎯᏌ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap Save to finish or drag thehandles to continue editing">
                <langSet xml:lang="en-US"><tig><term>Tap Save to finish or drag thehandles to continue editing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎭᎵᏏᏅᏓ ᎾᎿᎢ ᎯᏍᏆᏓ ᎠᎴ ᏱᎾᏏᏄᎦ ᏥᎩᏗᎫᎭᎸᏗ ᎾᎿᎢ ᏂᎦᏯᎢᏎᏍᏗ ᎦᏁᏟᏴᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not support">
                <langSet xml:lang="en-US"><tig><term>Not support</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎦᎫᏍᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Current version New version\ What's new:">
                <langSet xml:lang="en-US"><tig><term>Current version New version\ What's new:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ ᏄᏓᎴᏒᎢ ᎢᏤ ᏄᏓᎴᏒᎢ\ ᎦᏙᎤᏍᏗ ᎢᏤ:</term></tig></langSet>
            </termEntry>
            <termEntry id="When connected to an external display the stylus acts as a mouse.">
                <langSet xml:lang="en-US"><tig><term>When connected to an external display the stylus acts as a mouse.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎫᏓᎸᏅᎯ ᎾᎢ ᏙᏯᏗᏜ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎯᎢᎾᎢ ᏥᏍᏕᏥ ᎢᏳᏍᏗ ᎾᏛᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To scroll, press and hold the stylus button and move your hand.">
                <langSet xml:lang="en-US"><tig><term>To scroll, press and hold the stylus button and move your hand.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎦᏅᏍᎩ, ᎭᏐᎥᏍᏓ ᎠᎴ ᎯᏂᏯ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏐᎥᏍᏙᏗ ᎠᎴ ᎯᎲᎾ ᏦᏰᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase all data">
                <langSet xml:lang="en-US"><tig><term>Erase all data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio layer is already being used by another application.">
                <langSet xml:lang="en-US"><tig><term>Audio layer is already being used by another application.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏗᏰᎦᏟ ᎨᎡᎢ ᎦᏳᎳ ᏰᎵᏉ ᎬᏔᏅᎯ ᎬᏗ ᏄᏓᎴ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Check your stylus version by putting it in the folio and keeping your bluetooth on.">
                <langSet xml:lang="en-US"><tig><term>Check your stylus version by putting it in the folio and keeping your bluetooth on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᏄᏓᎴᏒᎢ ᎬᏗ ᎠᏂᎲᏍᎦ ᏄᏍᏛ ᎾᎯᏳ ᏗᏜᏩᏛ ᎠᎴ ᏣᏤᎵ bluetooth ᎤᏍᏆᏂᎪᏙᏗᏱ ᏄᏍᏛ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Invalid file">
                <langSet xml:lang="en-US"><tig><term>Invalid file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏓᏂᎸᎬᎾ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Get a reminder when the stylus has been removed from case for a long period of time without use, or lost bluetooth connection">
                <langSet xml:lang="en-US"><tig><term>Get a reminder when the stylus has been removed from case for a long period of time without use, or lost bluetooth connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᎾᏍᎩ ᎠᏓᏅᏓᏗᏍᏗᏍᎩ ᎾᎯᏳ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᏂᎦᎵᏍᏗᎭ ᎠᎲᏍᏓ ᎾᎯᏳ ᎢᏳᎵᏍᏔᏅᎢ ᎾᏍᎩᎾ ᎪᎯᏓ ᎢᎪᎯᏛ ᏄᏠᏯᏍᏛᎾ ᎬᏙᏓ, ᎠᎴ ᎤᏂᏲᎱᏎᎸ bluetooth ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to change your Android TV device's time zone.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to change your Android TV device's time zone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᎤᎬᏩᏟ Android TV ᏥᏂᎬᏅᏗᏓᎾ ᎠᏥᎢᎵᏒ ᎠᏎᏢᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose the SETTINGS menu below to activate your WiFi Calling service on your mobile device.">
                <langSet xml:lang="en-US"><tig><term>Choose the SETTINGS menu below to activate your WiFi Calling service on your mobile device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏥᎩ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᎡᎳᏗᏢ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ; WiFi ᏓᏯᏂᏍᎬ ᎢᏯᏓᏛᏁᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap app icon to see unlock menu.">
                <langSet xml:lang="en-US"><tig><term>Tap app icon to see unlock menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎬᏙᏗ ᎠᎢᎧᏂ ᎠᎪᏛᏗ ᎠᏂᏐᎭᎾᎸᏗ ᎪᏪᎳᎾᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select USB mode">
                <langSet xml:lang="en-US"><tig><term>Select USB mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Click to captureWhen you’re in the camera app you can single click the stylus button to take a picture or start recording a video.">
                <langSet xml:lang="en-US"><tig><term>Click to captureWhen you’re in the camera app you can single click the stylus button to take a picture or start recording a video.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎦᏂᏱᏍᎩᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᎾᎯᏳ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎬᏙᏗ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎠᏐᏅᏍᏙᏗ ᏌᏊᎢᏳᎪᏗ ᎭᏐᏅᏍᏓ ᏂᎯ ᏰᎵᏊ ᎢᏳᏃ ᏗᎧᏃᎩᏙᏗ ᏓᏁᎶᎲᏍᎦ ᎾᎿᎢ ᎠᎦᏍᎩ ᏗᏟᎶᏍᏔᏅ ᎠᎴ ᎠᏂᎩᏍᏙᏗ ᎦᏂᏴᎲᎢ ᏗᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Night landscape">
                <langSet xml:lang="en-US"><tig><term>Night landscape</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏒᏃᏱ ᎦᏙᎯ ᏄᏍᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also press and hold to use the eraser.">
                <langSet xml:lang="en-US"><tig><term>You can also press and hold to use the eraser.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᎾᎯᏍᏓ ᏂᎯ ᏰᎵᏊ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎠᏍᎪᎸᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth disconnectedSome actions unavailable">
                <langSet xml:lang="en-US"><tig><term>Bluetooth disconnectedSome actions unavailable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Bluetooth ᎫᏓᎴᏓᏃᎢᎦᏓ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎾᎾᏛᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Object eraser">
                <langSet xml:lang="en-US"><tig><term>Object eraser</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏓᎴᏅᏗ ᎠᏍᎪᎸᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To left click, single click the stylus button.">
                <langSet xml:lang="en-US"><tig><term>To left click, single click the stylus button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏍᎦᏂ ᎭᏐᎥᏍᏗ, ᏌᏊᎢᏳᎪᏗ ᎭᏐᏅᏍᏓ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏐᎥᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you’re streaming a movie, listening to music, or playing a game, Dolby Atmos helps you enjoy rich and engaging sound.">
                <langSet xml:lang="en-US"><tig><term>When you’re streaming a movie, listening to music, or playing a game, Dolby Atmos helps you enjoy rich and engaging sound.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏃᏊᏥᎩ ᎠᏥᎢᎵᏒᎢ ᎠᏓᏴᎳᏛᏍᎬᎢ, ᎤᎾᏛᏓᏍᏛ ᎾᎢ ᏗᎧᏃᎩᏍᏛ, ᎠᎴᏃ ᏓᏁᎶᎲᏍᎬ ᏗᏁᎶᏙᏗ, ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎦᎧᎲᏍᏗ ᏂᎯ ᏥᏍᏕᎵᏍᎩ ᎠᎵᎮᎵᏍᏗ ᎤᏣᏘ ᏃᎴ ᎤᎵᎶᎯ ᎠᏛᎪᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also press and hold to use the eraser.">
                <langSet xml:lang="en-US"><tig><term>You can also press and hold to use the eraser.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᎾᎯᏍᏓ ᏂᎯ ᏰᎵᏊ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎠᏍᎪᎸᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Pixel eraser">
                <langSet xml:lang="en-US"><tig><term>Pixel eraser</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏗ ᏅᎩ ᏧᏅᏏᏯ ᎠᏍᎪᎸᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enable GPS and network">
                <langSet xml:lang="en-US"><tig><term>Please enable GPS and network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ GPS ᎠᎴ ᏧᎾᏚᏓᎵ ᎡᎵᏊ ᏱᎬᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select &quot;Permissions&quot; in AppInfo to re-enable.">
                <langSet xml:lang="en-US"><tig><term>Select "Permissions" in AppInfo to re-enable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᎡᏗ ᎣᏃᎮᏍᎩ ᎾᎿᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A slide inside the home screen evokes a global search">
                <langSet xml:lang="en-US"><tig><term>A slide inside the home screen evokes a global search</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗ ᎦᎶᎯᏍᏗᏍᎩ ᎭᏫᎾᏗᏢ ᎠᏲᏢᏗᎭ ᎡᎶᎯ ᎢᎬᎾᏕᎾ ᎠᏱᏍᏗ ᎠᏔᏲᏍᏗ ᎠᎵᏍᏕᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Global Search">
                <langSet xml:lang="en-US"><tig><term>Global Search</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎶᎯ ᎢᎬᎾᏕᎾ ᎠᏱᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow on external display">
                <langSet xml:lang="en-US"><tig><term>Allow on external display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎾᎿᎢ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To drag, double click and hold the stylus button.">
                <langSet xml:lang="en-US"><tig><term>To drag, double click and hold the stylus button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎤᏠᏱ ᏯᏛᏁᎯ ᎦᎾᏏᏅᏍᏗ, ᎭᏐᎥᏍᏓ ᎠᎴ ᎯᏂᏯ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏐᎥᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Limit of 5 audio files">
                <langSet xml:lang="en-US"><tig><term>Limit of 5 audio files</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎿ 5 ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn bluetooth on automatically">
                <langSet xml:lang="en-US"><tig><term>Turn bluetooth on automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ bluetooth ᎯᏍᏚᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="set time zone">
                <langSet xml:lang="en-US"><tig><term>set time zone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎠᏥᎢᎵᏒ ᎠᏎᏢᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can copy files between your phone and PC.">
                <langSet xml:lang="en-US"><tig><term>You can copy files between your phone and PC.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᎶᏍᏔᏅᎯ ᏗᏍᏆᏂᎪᏙᏗ ᎤᏜᏅᏛ ᏂᎯᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ PC.</term></tig></langSet>
            </termEntry>
            <termEntry id="After a file is copied from PC, you can save it on phone by accessing the copied files icon in the taskbar.">
                <langSet xml:lang="en-US"><tig><term>After a file is copied from PC, you can save it on phone by accessing the copied files icon in the taskbar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂ ᎠᏍᏆᏂᎪᏗ ᏱᏓᏟᎶᏍᏔᏅᎯ PC ᎾᎯᏳ, ᎯᏍᏆᏂᎪᏓ ᎤᎾᎢ ᏗᏟᏃᎮᏗ ᎬᏗ ᎦᏁᏟᏴᎢ Ꮎ ᏓᏟᎶᏍᏔᏅᎯ ᏗᏍᏆᏂᎪᏙᏗ ᎠᎢᎧᏂ ᎥᎿᎢᎾ ᎢᏯᏛᏁᏗ ᎠᏓᏃᎯᏎᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Time Zone Data">
                <langSet xml:lang="en-US"><tig><term>Time Zone Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᎠᏟᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="OPEN SETTINGS">
                <langSet xml:lang="en-US"><tig><term>OPEN SETTINGS</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="VoNR high fidelity voice call">
                <langSet xml:lang="en-US"><tig><term>VoNR high fidelity voice call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>VoNR ᎧᏁᎬ ᏫᎬᏗᏍᎩ ᏚᏳᎪᏛᎢ ᎦᎸᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="6-digit PIN">
                <langSet xml:lang="en-US"><tig><term>6-digit PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>6-ᎠᏎᏍᏗ PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="When unlock screen, PIN will be confirmed automatically">
                <langSet xml:lang="en-US"><tig><term>When unlock screen, PIN will be confirmed automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᏐᎭᎾᎸᏗ ᎠᏰᏙᎳᏛᎢ ᎯᎳᏴᎢ, PIN ᎦᎫᏍᏛᏁᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏰᎵᏉ ᎨᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disabled by IT admin">
                <langSet xml:lang="en-US"><tig><term>Disabled by IT admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎴᏫᏍᏔᏅᎢ ᎨᏒᎢ IT ᏅᎬᏫᏌᏁᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Audio delivers a premium listening experience through your phone's loudspeaker and connected devices. This feature is always on when you're listening through the loudspeaker, and you can adjust the settings for headphones and connected speakers.">
                <langSet xml:lang="en-US"><tig><term>Dolby Audio delivers a premium listening experience through your phone's loudspeaker and connected devices. This feature is always on when you're listening through the loudspeaker, and you can adjust the settings for headphones and connected speakers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Audio ᏙᏓᎨᏥᏁᎵ ᎾᏍᎩ ᏫᏓᏤᏢᎢ ᏗᏛᏓᏍᏙᏗ ᎠᎦᏙᎲᏒᎢ ᎤᎶᏒᎯ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏄᏍᏛ ᏂᎪᎯᎸᎢ ᎠᏍᏚᎢᏓ ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᏕᏣᏛᏓᏍᏛ ᎤᎶᏒᎯ ᎾᏍᎩ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ, ᎠᎴ ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾ ᏗᏟᏳᏙᎾᏗᏍᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏗᎦᏬᏂᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Confirm PIN with tapping -&gt;">
                <langSet xml:lang="en-US"><tig><term>Confirm PIN with tapping -&gt;</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ PIN ᎦᎫᏍᏛᏗ ᎬᏗ -&gt;</term></tig></langSet>
            </termEntry>
            <termEntry id="Some apps aren't optimized for the external display size and may not appear or work as expected">
                <langSet xml:lang="en-US"><tig><term>Some apps aren't optimized for the external display size and may not appear or work as expected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᎬᏙᏗ Ꮭ ᏱᎩ ᏩᎧᎵᏏᏌᏅ ᎤᎬᏩᏟ ᏥᎩ ᏙᏱᏗᏢ ᎠᏰᏙᎳᏛᎢ ᎢᎩᏓ ᎠᎴ ᏰᎵᏊ Ꮭ ᎬᏂᎨᏒᎢ ᎠᎴ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎿᎢ ᎤᏚᎩ ᎤᏩᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down on the home screen to launch the global search">
