                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎸ VPN ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not secure. Update to an IKEv2 VPN">
                <langSet xml:lang="en-US"><tig><term>Not secure. Update to an IKEv2 VPN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏢᎯᏌᏅᎯ ᎤᎿᎢ Ꭰ IKEv2 VPN</term></tig></langSet>
            </termEntry>
            <termEntry id="Included packages">
