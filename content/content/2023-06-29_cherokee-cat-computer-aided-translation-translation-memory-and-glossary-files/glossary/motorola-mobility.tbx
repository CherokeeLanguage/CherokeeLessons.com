            <termEntry id="This notification shows the user new features and more details">
                <langSet xml:lang="en-US"><tig><term>This notification shows the user new features and more details</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏓᏃᏣᎳᏁᎯ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ ᏥᎩ ᎬᏗᏍᎩ ᏗᏤ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᎤᏟ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This gesture always takes you to the Home screen.">
                <langSet xml:lang="en-US"><tig><term>This gesture always takes you to the Home screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏧᏬᏯᏂᏍᎩ ᏂᎪᎯᎸᎢ ᎠᎩᏍᎪᎢ ᏂᎯ ᎾᎿᎢ ᏥᎩ ᎣᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
