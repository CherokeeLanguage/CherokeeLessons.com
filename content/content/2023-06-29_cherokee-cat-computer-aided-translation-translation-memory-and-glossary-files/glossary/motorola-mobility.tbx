                <langSet xml:lang="chr"><tig><term>Bluetooth MIDI ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Temporary poor network conditions">
                <langSet xml:lang="en-US"><tig><term>Temporary poor network conditions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᎦᏊ ᎤᎴᏌᏓᎢ ᏧᎾᏚᏓᎵ ᏂᏚᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bug reports contain data from the system's various log files, which may include data you consider sensitive (such as app-usage and location data).">
                <langSet xml:lang="en-US"><tig><term>Bug reports contain data from the system's various log files, which may include data you consider sensitive (such as app-usage and location data).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎪᏯ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ ᏕᎪᏣᎸ ᎦᏟᏌᏅᎯ ᎾᏍᎩᎾ ᏂᏚᏍᏗᏓᏅᎢ ᏧᏓᎴᏅᏓ ᏄᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ ᏗᏍᏆᏂᎪᏙᏗ, ᏰᎵᏉ ᎠᏠᏯᏍᏗ ᎦᏟᏌᏅᎯ ᏂᎯ ᎭᏓᏅᏛᎵ ᎡᏍᎦ ᏄᎵᏍᏓᏁ (ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎬᏙᏗ-ᎬᏙᏗᎢ ᎠᎴ ᎤᎿ ᎢᎬᎾᏕᎾ ᎦᏟᏌᏅᎯ).</term></tig></langSet>
            </termEntry>
            <termEntry id="Try moving closer to the router.">
                <langSet xml:lang="en-US"><tig><term>Try moving closer to the router.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᎠᏂᎩᏍᎩ ᎾᎥᏂᎨᏍᏗ ᎾᎿᎢ ᏫᏗᎦᎶᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't provide internet.">
                <langSet xml:lang="en-US"><tig><term>Can't provide internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏰᎵ ᎠᏓᏁᎳᏁᏗ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to renew subscription and connect">
