                <langSet xml:lang="chr"><tig><term>ᎦᎷᎦ ᏪᏯᎾ ᎬᏗ ᏗᏟᎶᏍᏔᏅ ᏃᎴ ᏗᎦᏃᏣᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Important incoming call with photo and location">
                <langSet xml:lang="en-US"><tig><term>Important incoming call with photo and location</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᎨᏓ ᎦᎷᎦ ᏪᏯᎾ ᎬᏗ ᏗᏟᎶᏍᏔᏅ ᏃᎴ ᎤᏙᏢᏒᎢ</term></tig></langSet>
