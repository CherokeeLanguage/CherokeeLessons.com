            </termEntry>
            <termEntry id="Do you want to continue?">
                <langSet xml:lang="en-US"><tig><term>Do you want to continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎠᎯᎸᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick launch uses extra RAM to open apps faster.">
                <langSet xml:lang="en-US"><tig><term>Quick launch uses extra RAM to open apps faster.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏂᎩᏍᏙᏗ ᏗᎬᏙᏓ ᎧᏁᏉᏓ RAM ᎾᎢ ᎠᏍᏚᎢᏓ ᏗᎬᏙᏗ ᎦᏣᏄᎳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you don't subscribe, you won't hear about software updates, new products, or exclusive offers">
                <langSet xml:lang="en-US"><tig><term>If you don't subscribe, you won't hear about software updates, new products, or exclusive offers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᏁᏍᎦᎾ ᏱᎩ, Ꮭ ᏱᏌᏃᏎᎮᏍᏗ ᎦᎾᏗᏅᏗ ᎪᏢᎯᏐᏗ, ᎢᏤ ᏗᎪᏢᏅᎢ, ᎠᎴ ᎠᏂᏍᎪᎸᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Subscribe">
                <langSet xml:lang="en-US"><tig><term>Subscribe</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏁᏍᏗ ᎠᏔᏲᏢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Standard data rates may apply.">
                <langSet xml:lang="en-US"><tig><term>Standard data rates may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏠᏱᎭ ᎦᏟᏌᏅᎢ ᏗᎪᏣᎴᏒᏛ ᎨᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="I may unsubscribe to push notifications by selecting &quot;Unsubscribe&quot; in the notifications I receive.">
                <langSet xml:lang="en-US"><tig><term>I may unsubscribe to push notifications by selecting "Unsubscribe" in the notifications I receive.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏓᏃᏣᎳᏁᎯ ᏱᏂᎬᏁᏕᎩ ᏯᎩᏘᏲᏢ “ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ” Ꮎ ᏯᎩᏁᏌ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="I agree to receive product information and special promotional offers by the selected channels above from Motorola, and I confirm that I am 16 years of age or older.">
                <langSet xml:lang="en-US"><tig><term>I agree to receive product information and special promotional offers by the selected channels above from Motorola, and I confirm that I am 16 years of age or older.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎭᏓᏂᎸᎩ ᎠᎩᎩᏍᏗ ᏗᎪᏢᏅᎢ ᎧᏃᎮᏢᎥᏍᎩ ᎠᎴ ᏅᏓᏤᏟᏓ ᏗᏓᏌᎳᏗᏍᎩ ᎠᏂᏍᎪᎸᏗᏍᎬ Ꮎ ᎤᏂᏑᏰᏓ ᏕᎦᏔᏅᏛ ᎦᎸᎳᏗᏟ Ꮎ ᎼᏙᏙᎳ, ᎠᎴ ᏥᏚᏍᏗᎭ ᏑᏓᎵᏚ ᎢᏴᏩᏕᏘᏴᏓ ᎠᎦᏴᎳᎯᎨᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="I understand that my consent is not required and is not a condition of any purchase.">
                <langSet xml:lang="en-US"><tig><term>I understand that my consent is not required and is not a condition of any purchase.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏩᏅᏔ ᎯᎠ ᎣᏏ ᎠᎩᏰᎸᏅᎢ ᏤᎩ Ꮭ ᎠᏎ ᎢᏯᏩᏛᏁᏗ ᏱᎩ ᎠᎴ Ꮭ ᎠᏎ ᏄᏍᏗᏛᏅᎢ ᎠᏎ ᎠᎩᏩᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use password to access">
                <langSet xml:lang="en-US"><tig><term>Use password to access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏗᏍᎬ ᎠᏍᏚᎢᏍᏙ ᎥᎧᏁᎬᎢ ᏅᏛᏴᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can encrypt your accounts, settings, downloaded apps and their data, media, and other files. After you encrypt your phone, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the phone every time you power it on. The only other way to decrypt is to perform a factory data reset, erasing all your data.Encryption takes an hour or more. You must start with a charged battery and keep your phone plugged in throughout the process. If you interrupt it, you\u2019ll lose some or all of your data.">
                <langSet xml:lang="en-US"><tig><term>You can encrypt your accounts, settings, downloaded apps and their data, media, and other files. After you encrypt your phone, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the phone every time you power it on. The only other way to decrypt is to perform a factory data reset, erasing all your data.Encryption takes an hour or more. You must start with a charged battery and keep your phone plugged in throughout the process. If you interrupt it, you\u2019ll lose some or all of your data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᏚᏓᎸᏙᏗ, ᏕᎦᎧᎲᎢ, ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏗᎬᏙᏗ ᏃᎴ ᎤᎾᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ, ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ, ᏃᎴ ᏐᎢ ᏗᏍᏆᏂᎪᏙᏗ. ᎤᎶᏐᏅ ᏂᎯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ, ᏃᎵᏍᎬᎢ ᏂᎯ\u2019ve ᏘᎧᎲᎦ Ꭰ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ (ᎥᏍᎩᎾ, Ꭰ ᎤᎾᎶᎢᏓ ᏃᎴ ᏗᏎᏍᏙᏗ PIN ᏃᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ), ᏂᎯ\u2019ll ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᏂᎪᎯᎸ ᏂᎯ ᎤᏟᏂᎩᏓ ᎾᎿ ᎤᎿᎢ. ᏥᎩ ᎤᏅᏒ ᏐᎢ ᏳᎵᏍᏙᏗ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏄᏍᏛ ᎾᎿᎢ ᏱᏣᏛᏁᏗ Ꭰ ᎤᏃᏢᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎢᎦᎧᎯᎲᏍᏗ, ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ.ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᏃᎴ ᎤᎪᏗᏊ. ᏂᎯ ᎠᏎ ᎭᎴᎾ ᎬᏗ ᏗᎬᏩᎶᏔᏅ ᎠᎾᎦᎵᏍᎩ ᏃᎴ ᏣᎮᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎤᏊᏄᎾᏘ ᎾᎿ ᏂᎦᏅᎯᏒ ᏥᎩ ᎠᏂᎯᎵᏒ. ᎢᏳᏃ ᏂᎯ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎢᎦᏓ ᏃᎴ ᏂᎦᏓ ᎾᎿ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Subnet mask">
                <langSet xml:lang="en-US"><tig><term>Subnet mask</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏫᏂᏗᏨᎢ ᎠᏚᏢᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete schedules">
                <langSet xml:lang="en-US"><tig><term>Delete schedules</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᏓᏒᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi calling will be enabled on the device">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi calling will be enabled on the device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏫᎩᏗᎭ ᎠᎵᏍᎪᎸᏓᏁᎯ ᎯᎠ ᏥᏂᎬᏅᏗᏓᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Would like to try again?">
                <langSet xml:lang="en-US"><tig><term>Would like to try again?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏯᏓᎢᏗᏏ ᏔᎵᏁ ᎢᏣᏁᎸᏙᏗᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="It can be used for up to 3 apps.">
                <langSet xml:lang="en-US"><tig><term>It can be used for up to 3 apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᎾᏍᎩᎾ ᎦᎸᎳᏗ ᎾᎢ 3 ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If allowed, this app can modify or delete media files created with other apps without asking you. App must have permission to access files and media.">
                <langSet xml:lang="en-US"><tig><term>If allowed, this app can modify or delete media files created with other apps without asking you. App must have permission to access files and media.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎠᎵᏍᎪᎸᏔᏅ, ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎤᏃᏒᎯᏐᏗ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎪᏢᏅᎢ ᎬᏗ ᏐᎢ ᏗᎬᏙᏗ ᎾᏍᎩ ᏂᎯ ᏍᏔᏲᏎᎸ ᏂᎨᏒᎾ. ᎬᏙᏗ ᎠᏎ ᎤᎭ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᏃᎴ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="At least 10 of your phone’s storage is needed to turn on this feature.">
                <langSet xml:lang="en-US"><tig><term>At least 10 of your phone’s storage is needed to turn on this feature.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏲᎵᎨ ᎨᏒ 10 ᎥᎿᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏩᏅ ᎠᏍᏆᏂᎪᏙᏗ ᏄᏍᏛ ᎤᏚᎸᏛ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎯᎠ ᎠᎦᏎᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Custom shape">
                <langSet xml:lang="en-US"><tig><term>Custom shape</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛᎢᏯᏛᏁᏗᎢ ᎤᏙᏢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM  will be used by  hour">
                <langSet xml:lang="en-US"><tig><term>SIM  will be used by  hour</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM  ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᏑᏟᎶᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM  will be used by  hours">
                <langSet xml:lang="en-US"><tig><term>SIM  will be used by  hours</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM  ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᏑᏟᎶᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use pattern to access">
                <langSet xml:lang="en-US"><tig><term>Use pattern to access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏗᏍᎬ ᎤᎾᎶᎢᏓ ᏅᏛᏴᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Restore default categories">
                <langSet xml:lang="en-US"><tig><term>Restore default categories</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᎯᏐᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏗᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="How long would you like to use SIM  for data?">
                <langSet xml:lang="en-US"><tig><term>How long would you like to use SIM  for data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎳᎢᎪᎯᏓ ᏯᏓᎢᏗᏏ ᏥᏍᏙᏗᎢ SIM  ᎾᏍᎩᎾᎢ ᎦᏟᏌᏅᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Custom time">
                <langSet xml:lang="en-US"><tig><term>Custom time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛ ᎢᏯᏛᏁᏗ ᎠᏟᎵᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="At what time would you like to switch back to default data SIM?">
                <langSet xml:lang="en-US"><tig><term>At what time would you like to switch back to default data SIM?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎳᏴᎢ ᎠᏟᎵᏒᎢ ᏯᏓᎢᏗᏏ ᎢᏣᏁᏟᏴᏍᏗᎢ ᎾᎢ ᎠᏓᏁᏟᏴᏍᏗᏍᎬ ᎦᏟᏌᏅᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again after 10 minutes.">
                <langSet xml:lang="en-US"><tig><term>Please try again after 10 minutes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏏᏊ ᏥᎭᏂᎵᏓ ᎤᎶᏐᏅᎭ 10 ᎢᏗᏔᏬᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your connection was restored.">
                <langSet xml:lang="en-US"><tig><term>Your connection was restored.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏣᏤᎵ ᏗᎵᎪᏔᏅᎯ ᎪᏢᎯᏌᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You are almost there!">
                <langSet xml:lang="en-US"><tig><term>You are almost there!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥ ᎾᎿᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="PIN will be confirmed automatically">
                <langSet xml:lang="en-US"><tig><term>PIN will be confirmed automatically</term></tig></langSet>
