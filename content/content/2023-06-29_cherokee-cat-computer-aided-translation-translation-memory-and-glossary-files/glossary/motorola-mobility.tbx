                <langSet xml:lang="en-US"><tig><term>receive WAP push</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ WAP ᎦᏌᏙᏯᏍᏗ</term></tig></langSet>
