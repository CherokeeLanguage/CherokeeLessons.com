                <langSet xml:lang="en-US"><tig><term>Emergency Alert</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎤᏟᏍᏗ ᎠᏓᏃᏎᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="When roaming internationally, enable this feature for apps and services that require an internet connection.">
