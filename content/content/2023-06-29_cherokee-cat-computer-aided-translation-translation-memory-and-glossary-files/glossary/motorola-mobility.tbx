                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏄᎦᎾᏮᎢ ᎠᏎᎯᎯ ᎾᏍᏉ ᎦᎸᎳᏗ,ᏗᎳᏃᎮᏗ ᎠᏎᎢ ᎠᏎᏒᏗ ᏚᏂᎸᏫᏍᏓᏁᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="The power will be turned off due to the device overheating.">
                <langSet xml:lang="en-US"><tig><term>The power will be turned off due to the device overheating.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏂᎩᏓ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᏍᏚᏅᎢ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎢᏴᏛ ᎠᎦᎾᏩᏗᏍᎩ.</term></tig></langSet>
