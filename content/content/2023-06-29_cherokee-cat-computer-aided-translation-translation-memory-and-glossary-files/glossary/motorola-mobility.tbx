                <langSet xml:lang="chr"><tig><term>ᎠᎵᏏᏅᏙᏗ ᎾᏍᎩ ᎤᏍᏗ ᎯᏂᏴᏓ ᎥᎿᎢ ᎾᏍᎩ ᏂᏚᎵᏍᏔᏅᎩ ᎤᏓᎷᎸ ᎠᎴ ᎤᎶᏐᏅ ᏂᎯ ᏣᏂᏴᎲᎢ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Maintains the format, but you can't edit the text">
                <langSet xml:lang="en-US"><tig><term>Maintains the format, but you can't edit the text</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᎦᏘᎭ ᎢᏗᎬᏁᏗ ᎾᏍᎩ ᏱᎬᏁᎸᎯ, ᎠᏎᏃ ᏂᎯ ᏝᏰᎵ ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᎾᏍᎩ ᎪᏪᎳᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby can improve the sound of your messages by reducing background noise and boosting voice clarity.">
                <langSet xml:lang="en-US"><tig><term>Dolby can improve the sound of your messages by reducing background noise and boosting voice clarity.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby ᏰᎵᏊ ᏱᎪᏢᎯᏌ ᎾᏍᎩ ᎤᏃᏴᎬ ᎥᎿᎢ ᏣᏤᎵ ᏗᎧᏃᎮᏍᎩ ᎬᏗ ᎠᎦᏲᎳᎨᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎤᏃᏴᎵᏛ ᏃᎴ ᎠᎰᎵ ᎤᏃᏴᎬ ᎤᏃᏴᎵᏓ ᏳᏍᎪᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Torch On">
                <langSet xml:lang="en-US"><tig><term>Torch On</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏙᏗ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="send emails">
