            </termEntry>
            <termEntry id="Cancel move">
                <langSet xml:lang="en-US"><tig><term>Cancel move</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏒᏗ ᎠᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Does the volume bar move in the direction you expect?">
                <langSet xml:lang="en-US"><tig><term>Does the volume bar move in the direction you expect?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏛᏁᏍ ᎾᏍᎩ ᎢᎦᎢ ᎤᏃᏴᎬ ᎦᎾᎸᎢ ᎠᏓᏅᏍᎬ ᎾᎿᎢ ᏫᏚᏳᎪᏛ ᏂᎯ ᎤᏚᎩ ᏨᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Consider using a faster ^1 for better performance.">
                <langSet xml:lang="en-US"><tig><term>Consider using a faster ^1 for better performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏓᏅᏛᎵ ᎬᏗᎭ Ꭰ ᎦᏣᎸᎳᎯᎨ ^1 ᎤᎬᏩᏟ ᏓᏤᎳ ᎾᎾᏛᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The ^2 app on this device won\u2019t be available until the move is complete.">
                <langSet xml:lang="en-US"><tig><term>The ^2 app on this device won\u2019t be available until the move is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ^2 ᎬᏙᏗ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏝᏰᎵ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎩᎳ ᏥᎩ ᎠᎲᏍᏗ ᎨᎡᎢ ᎧᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can continue, but apps moved to this location may stutter and data transfers may take a long time.">
                <langSet xml:lang="en-US"><tig><term>You can continue, but apps moved to this location may stutter and data transfers may take a long time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏂᎦᏯᎢᏒ, ᎠᏎᏃ ᏗᎬᏙᏗ ᎤᎲᏒ ᎾᎿᎢ ᎯᎠ ᎤᏙᏢᏒᎢ ᏰᎵᏯ ᎧᏁᎬ ᎤᏲᏍᏓᏁᎯ ᎠᎵ ᎦᏟᏌᏅᎯ ᏙᏓᏰᏣᏲᎯᏎᎵ ᏰᎵᏯ ᎠᎩᏍᏗ Ꭰ ᎦᏅᎯᏓ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you haven't found answers to your questions within the helpful articles in this app, you can chat with a representative during the hours listed below">
                <langSet xml:lang="en-US"><tig><term>If you haven't found answers to your questions within the helpful articles in this app, you can chat with a representative during the hours listed below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎥᏝᏃ ᏣᏩᏛᎲᎢ ᏱᎩ ᏗᎦᏬᎯᎵᏴᏍᏓ ᎾᎢ ᏣᏤᎵ ᏗᏛᏛᎲᏍᎩ ᎠᏫᏂᏗᏢ ᎾᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᏚᏓᏡᏅᏒᎢ ᎾᎿᎢ ᎯᎠ ᎬᏙᏗ, ᏂᎯ ᏰᎵᏊ ᏗᏟᏃᎮᏗ ᎤᏠᏯᏍᏗ ᎾᏍᎩ ᏗᎦᎳᏫᎩ ᎾᎯᏳᎢ ᎾᏍᎩ ᎢᏧᏟᎶᏓ ᏕᎦᏅᏛᎢ ᎡᎵᏗᏢ</term></tig></langSet>
            </termEntry>
            <termEntry id="I didn't find my answer with Device Help, but I didn't try using other service channels">
                <langSet xml:lang="en-US"><tig><term>I didn't find my answer with Device Help, but I didn't try using other service channels</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯ Ꮭ ᏱᏥᏩᏔ ᎠᎩᏬᎯᎵᏴᏛ ᎤᏠᏯᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏕᎵᏍᎩ, ᎠᏎᏃ ᎠᏯ Ꮭ ᎭᏁᎵᏓ ᎬᏗᏍᎬ ᏐᎢ ᎢᏯᏓᏛᏁᏗ ᏧᎶᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Back to MotoCare?">
                <langSet xml:lang="en-US"><tig><term>Back to MotoCare?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᎾᏗᏜ ᏫᎦᎶᎯᏍᏗ MotoCare?</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow this app to interact with Device Help app.">
                <langSet xml:lang="en-US"><tig><term>Allow this app to interact with Device Help app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎬᏙᏗ ᎾᎢ ᎤᏪᎳᏗᏓᏍᏗ ᎤᏠᏯᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎵᏍᏕᎵᏍᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to view details.">
                <langSet xml:lang="en-US"><tig><term>Tap to view details.</term></tig></langSet>
