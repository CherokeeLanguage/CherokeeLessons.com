            </termEntry>
            <termEntry id="Must stay turned on because notification access is on">
                <langSet xml:lang="en-US"><tig><term>Must stay turned on because notification access is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎠᏎ ᏣᏛᏅᏍᏕᏍᏗ ᏍᏚᎢᏍᏗᎢ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏴᏍᏗ ᎤᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="If locked, you must contact your carrier to unlock your device.">
                <langSet xml:lang="en-US"><tig><term>If locked, you must contact your carrier to unlock your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>If locked, you must contact your carrier to unlock your device. ᏍᏓ ᏯᏍᏚᎭ, ᎠᏎ ᏫᏃᏎᏗ ᏧᏛᎴᏅᎲ ᎤᏂᏍᏚᎢᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᏅ </term></tig></langSet>
            </termEntry>
            <termEntry id="Available devices">
                <langSet xml:lang="en-US"><tig><term>Available devices</term></tig></langSet>
