            </termEntry>
            <termEntry id="Adjust between vivid and accurate colors">
                <langSet xml:lang="en-US"><tig><term>Adjust between vivid and accurate colors</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᎩ ᎤᏜᏅᏛ ᎬᏂᎦᎵᏍᏗ ᎠᎴ ᏗᏙᎳᎩ ᏗᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="You will then need to obtain a PIN Unlock Key (PUK) from your carrier to enable your SIM card again.">
                <langSet xml:lang="en-US"><tig><term>You will then need to obtain a PIN Unlock Key (PUK) from your carrier to enable your SIM card again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏣᏚᎵᏍᎨᏍᏗ ᎠᎩᏍᎥ PIN ᎠᏂᏐᎭᎾᎳᎩ ᏍᏚᎢᏍᏗ ᏧᏛᎴᏅᎲ ᎠᎵᏊᎢᏳᎵᏍᏙᏗ Ꮎ SIM ᏗᏉᎾᏲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter the current SIM PIN">
