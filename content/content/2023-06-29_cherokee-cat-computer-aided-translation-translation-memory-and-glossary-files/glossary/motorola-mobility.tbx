                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏔᏅ ᏕᎦᏇᏅᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This admin app is active and allows the app  to perform the following operations:">
                <langSet xml:lang="en-US"><tig><term>This admin app is active and allows the app  to perform the following operations:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᎦᏎᏍᏗᏕᎩ ᎬᏙᏗ ᎨᏒᎢ ᎬᏂᎦᎵᏍᏗ ᎠᎴ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏥᎩ ᎬᏙᏗ  ᎾᎿᎢ ᎠᎵᏂᎬᏁᏗ ᏥᎩ ᎠᏍᏓᏩᏓ ᏓᏂᏱᎵᏒᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow background data">
                <langSet xml:lang="en-US"><tig><term>Allow background data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Metered networks are treated like mobile networks when background data is restricted. Apps may warn before using these networks for large downloads.">
                <langSet xml:lang="en-US"><tig><term>Metered networks are treated like mobile networks when background data is restricted. Apps may warn before using these networks for large downloads.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎯᎯ ᏚᎾᏚᏓᎵ ᎨᏒᎢ ᎠᏓᏁᎸᎯ ᎢᏳᏍᏘ ᎠᏂᎩᏍᎩ ᏚᎾᏚᏓᎵ ᎢᏳᏃ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎨᏒᎢ ᎦᏅᏍᏙᏒᎯ. ᏗᎬᏙᏗ ᏰᎵᏉ ᎤᎦᎾᏩ ᎠᏏᏅ ᎬᏗᎭ ᎯᎠᏃ ᏚᎾᏚᏓᎵ ᎤᎬᏩᏟ ᎡᏆ ᎡᎳᏗᏟ ᏕᎦᏢᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Trust">
                <langSet xml:lang="en-US"><tig><term>Trust</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎪᎯᏳᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="DNS server addresses must be numeric for always-on VPN">
                <langSet xml:lang="en-US"><tig><term>DNS server addresses must be numeric for always-on VPN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>DNS ᎠᏯᏙᎯᎯ ᎪᏪᎵ ᏗᎦᏁᏍᏗᎢ ᎠᏎ ᏗᏎᏍᏙᏗ ᎤᎬᏩᏟ ᏂᎪᎯᎸᎢ-ᎤᎾᎢ VPN</term></tig></langSet>
            </termEntry>
            <termEntry id="Show Ethernet usage">
                <langSet xml:lang="en-US"><tig><term>Show Ethernet usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎫᏓᎸᎢ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Receive invitations to participate in studies or surveys that improve our products and services.">
                <langSet xml:lang="en-US"><tig><term>Receive invitations to participate in studies or surveys that improve our products and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏍᏗ ᏗᏓᏯᏅᏙᏗ ᎠᏖᎳᏗᏓᏍᏗ ᎾᎿᎢ ᏧᎾᎦᏎᏍᏙᏗᎢ ᎠᎴᏃ ᏗᎦᏛᏂᏗᏍᏗ ᎾᏍᎩᎾᎢ ᎪᏢᎯᏐᏗᎢ ᏃᎬᏅᎢ ᏗᎬᏔᏂᏓᏍᏗ ᎠᎴ ᎢᏗᏓᏛᏁᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="5s">
                <langSet xml:lang="en-US"><tig><term>5s</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>5s</term></tig></langSet>
            </termEntry>
            <termEntry id="Please install a browser">
                <langSet xml:lang="en-US"><tig><term>Please install a browser</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᏘᏅᏛᎦ ᎾᏍᎩ ᎠᏍᏚᎢᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set always-on VPN?">
                <langSet xml:lang="en-US"><tig><term>Set always-on VPN?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏡᎬ ᏂᎪᎯᎸᎢ-ᎤᎾᎢ VPN?</term></tig></langSet>
            </termEntry>
            <termEntry id=" has installed a certificate authority for your work profile, which may allow them to monitor work network activity, including emails, apps, and secure websites.For more information about this certificate, contact your admin.">
                <langSet xml:lang="en-US"><tig><term> has installed a certificate authority for your work profile, which may allow them to monitor work network activity, including emails, apps, and secure websites.For more information about this certificate, contact your admin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᏚᏩᎿ ᎦᏘᏅᏔᏅ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᎾᏒᎦᎸᎢ ᎤᎬᏩᏟ ᏂᏨᏅᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛᎢ, ᎦᏙᎤᏍᏗ ᏰᎵᏉ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎢᏯᏂᎢ ᎾᎿᎢ ᎠᏓᏴᎵᏛᏍᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᎾᏚᏓᎵ ᎠᎾᎵᏖᎸᎲᏍᎬ, ᎤᏠᏯᏍᏗ ᏗᎾᎦᎵᏍᎩ ᏗᎪᏪᎵ, ᏗᎬᏙᏗ, ᎠᎴ ᏄᎾᏰᎯᏍᏛᎾᏉ ᏓᏏᎳᏕᏫᏒ.ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎤᎦᏎᏍᏗᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you pull out the stylus with your device unlocked, you'll see a selection of shortcuts to apps &amp; helpful actions.">
                <langSet xml:lang="en-US"><tig><term>When you pull out the stylus with your device unlocked, you'll see a selection of shortcuts to apps &amp; helpful actions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎯᏍᏌᏁᎩ ᏗᎪᏪᎳᏅ ᎠᏠᏯᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎦᏐᎭᎾᎳᎩᏍᏗ, ᏂᎯᏊᏃ ᎯᎪᏩᏘ ᎠᏑᏰᏓ ᎥᎿᎢ ᏥᏳᎪᏓᏃ ᎾᎢ ᎬᏙᏗ &amp; ᎠᎵᏍᏕᎵᏍᎩ ᏗᎵᏖᎸᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Latin">
                <langSet xml:lang="en-US"><tig><term>Latin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎴᏘᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="4G data">
                <langSet xml:lang="en-US"><tig><term>4G data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>4G ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you're connected to a network">
                <langSet xml:lang="en-US"><tig><term>Make sure you're connected to a network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯ ᎾᏍᎩ ᎫᏓᎸᏅᎢ ᎾᎢ ᎤᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.This setting affects all users on this tablet.">
                <langSet xml:lang="en-US"><tig><term>If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.This setting affects all users on this tablet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏓᏍᏚᏁᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ, ᎢᎦᏓ ᏗᎬᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏝᏰᎵᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏳᏍᎩᏂ ᏂᏨᏅᎢ ᎫᏓᎸᏅᎯ ᎤᎾᎢ Wi\u2011Fi.ᎯᎠ ᏕᎦᎧᎲᎢ ᏂᏙᏓᎬᏂᏌᏂ ᏂᎦᏓ ᏗᏅᏗᏍᎩ ᎤᎾᎢ ᎯᎠ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app will be able to use battery in the background. Your battery may run out sooner than expected.">
                <langSet xml:lang="en-US"><tig><term>This app will be able to use battery in the background. Your battery may run out sooner than expected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᏰᎵᏉ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏜ ᏄᏍᏗᏓᏅ. ᏂᏨᏅᎢ ᎠᎾᎦᎵᏍᎩ ᏰᎵᏉ ᎠᎢᏎᏍᏗ ᎦᏅᎪᏫᏛ ᏞᎯᎨᏍᏗ ᎡᏍᎦᏉ ᎤᏚᎩ ᎤᏩᏒ.</term></tig></langSet>
            </termEntry>
