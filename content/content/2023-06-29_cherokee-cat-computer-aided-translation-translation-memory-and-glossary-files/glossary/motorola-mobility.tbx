                <langSet xml:lang="chr"><tig><term>ᎤᏃᏒᎯᏐᏗ Motorola ᏄᏍᏗᏛᏅᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can connect your device and use Ready For PC features.">
                <langSet xml:lang="en-US"><tig><term>Now you can connect your device and use Ready For PC features.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎿᏉ ᏂᎯ ᏰᎵᏊ ᏱᏕᎭᎵᎪᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴ ᎬᏙᏓ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ PC ᏗᎦᏎᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically run when PC start">
                <langSet xml:lang="en-US"><tig><term>Automatically run when PC start</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᎠᏂᎩᏍᎩ ᎾᎯᏳ PC ᎠᏂᎩᏍᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you want to see this tutorial again, you can find it in the sidebar.">
                <langSet xml:lang="en-US"><tig><term>If you want to see this tutorial again, you can find it in the sidebar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏱᏣᏚᎵ ᏣᎪᏩᏛᏗ ᎯᏍᎠᏓᏕᏲᎲᏍᎩ ᏏᏊ, ᏂᎯ ᏰᎵᏊ ᏱᏩᏔ ᎾᎿᎢ ᎤᏟᏗᏢ ᎪᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Scan the QR code">
                <langSet xml:lang="en-US"><tig><term>Scan the QR code</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎪᎵᏰᏍᎩ ᎾᏍᎩᎾ QR ᎠᏍᏓᏩᏛᏍᏙᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Block Moto Actions">
                <langSet xml:lang="en-US"><tig><term>Block Moto Actions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ Moto ᎢᏗᏛᏁᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Motorola Thermal Service">
                <langSet xml:lang="en-US"><tig><term>Motorola Thermal Service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Motorola ᎠᎦᏃᏩᏗᏍ ᎢᏯᏓᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data used">
                <langSet xml:lang="en-US"><tig><term>Data used</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᎬᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi P2P is occupied.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi P2P is occupied.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎢ-ᏈᎢ P2P ᏄᏍᏛ ᎠᏯᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can create custom profiles for Bluetooth and USB-C audio devices. Each time you connect a device, Moto Audio will remember the last settings you used.">
                <langSet xml:lang="en-US"><tig><term>You can create custom profiles for Bluetooth and USB-C audio devices. Each time you connect a device, Moto Audio will remember the last settings you used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏲᏢᎾ ᏄᏍᏛ ᎢᏳᎾᏛᏁᏗ ᏚᎧᏛᎢ ᎾᏍᎩᎾ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎠᎴ USB-C ᎤᏃᏴᎬ ᏥᏂᏕᎬᏅᏗᏓᎾ. ᏂᏓᏟᏱᎵᏒᎢ ᏂᎯ ᎱᏓᎸᏍᎬᎢ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ, Moto ᎤᏃᏴᎬ ᎠᏎ ᏛᏓᏗᏍᏔᎾ ᎾᏍᎩ ᎣᏂ ᏕᎦᎧᎲᎢ ᏂᎯ ᏨᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The new version failed to download, try again">
                <langSet xml:lang="en-US"><tig><term>The new version failed to download, try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎢᏤ ᏄᏓᎴᏒᎢ ᎤᏓᏄᎸᏅᎢ ᎾᎢ ᎡᎳᏗ ᏫᏓᏲᎯᏍᏗ, ᏏᏊ ᏥᎭᏁᎵᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="or">
                <langSet xml:lang="en-US"><tig><term>or</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏃ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the tabs in the Assistant sidebar to access different functionalities.">
                <langSet xml:lang="en-US"><tig><term>Use the tabs in the Assistant sidebar to access different functionalities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎾᏍᎩ ᎤᏟᏍᏓ ᏗᏒᏂᎸ ᎾᎿᎢ ᎾᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎾᎢ ᎠᏴᏍᏗ ᏧᏓᎴᎾᎢ ᏓᏤᏢ ᎦᏂᎸᏫᏍᏓᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
