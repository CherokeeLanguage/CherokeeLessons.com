            <termEntry id="This requires the ^1 to be formatted to make it secure. After formatting, this ^1 will only work in this device. Formatting erases all data currently stored on the ^1. To avoid losing the data, consider backing it up.">
                <langSet xml:lang="en-US"><tig><term>This requires the ^1 to be formatted to make it secure. After formatting, this ^1 will only work in this device. Formatting erases all data currently stored on the ^1. To avoid losing the data, consider backing it up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎᏳᎾᏛᏁᏗ ᏥᎩ ^1 ᎾᎿᎢ ᎨᎡᎢ ᎪᏢᏅᎯ ᎾᎿᎢ ᎪᏒᏗ ᎨᎡᎢ ᏄᎾᏰᎯᏍᏛᎾᏉ. ᎣᏂᏗᏢ ᎪᏢᏗᏍᎬᎢ, ᎯᎠ ^1 ᎠᏎ ᎤᏅᏒ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎿ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᎪᏢᏗᏍᎬᎢ ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᏃᏊ ᏥᎩ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏥᎩ ^1. ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎠᏓᏲᎱᏎᎲ ᏥᎩ ᎦᏘᏍᎩᏌᏅᎯ, ᎭᏓᏅᏛᎵ ᎠᏍᏕᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t be activated right now">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t be activated right now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎨᎡᎩ ᎤᏂᎩᏍᏗᏍᎩ ᎠᎦᏘᏏ Ꭷ</term></tig></langSet>
            </termEntry>
            <termEntry id="You don\u2019t have a data connection. To view this information now, go to  from any computer connected to the internet.">
                <langSet xml:lang="en-US"><tig><term>You don\u2019t have a data connection. To view this information now, go to  from any computer connected to the internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏝᏍᏗ ᎤᎭ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ. ᎾᎿᎢ ᏗᎧᏃᏗ ᎯᎠ ᎧᏃᎮᏢᏗ Ꭷ, ᏤᏅᏍᏗ  ᏅᏓᏳᏓᎴᏅᎯ ᎾᏂᎥᏉ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎫᏓᎸᎢ ᎾᎿᎢ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
