            </termEntry>
            <termEntry id="To transfer files, make sure Ready For Assistant is open on your PC or the mobile device is set to visible to other devices in settings.">
                <langSet xml:lang="en-US"><tig><term>To transfer files, make sure Ready For Assistant is open on your PC or the mobile device is set to visible to other devices in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᎲᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ, ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ ᏄᏍᏛ ᎠᏍᏚᎢᏓ ᎤᎾᎢ ᏣᏤᎵ PC ᎠᎴᏃ ᎾᏍᎩ ᎠᏓᏅᏏᏙᎯ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏛ ᎦᎧᎲᎢ ᎾᎢ ᎬᎪᏩᏛᏗ ᏅᏩᏓᎴᎢr ᏥᏂᏕᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Aac">
                <langSet xml:lang="en-US"><tig><term>Aac</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Aac</term></tig></langSet>
            </termEntry>
            <termEntry id="Your admin requested a bug report to help troubleshoot this device. Apps and data may be shared.">
                <langSet xml:lang="en-US"><tig><term>Your admin requested a bug report to help troubleshoot this device. Apps and data may be shared.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏄᏂᎬᏫᏳᏌᏕᎩ ᏗᏔᏲᏢᎩ ᏍᎪᏯ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᎢ ᎠᏍᏕᎵᏍᎩ ᎣᏍᏓᏱᎬᏁᎯ ᎠᏓᏃᎯᏎᎭ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᏗᎬᏙᏗ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏒᎢ ᎠᏯᏙᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Onboarding">
                <langSet xml:lang="en-US"><tig><term>Onboarding</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏖᎳᏗᏍᎬᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use another cable or make sure you've turned on Wi-Fi on both your phone and PC and try to connect again.">
                <langSet xml:lang="en-US"><tig><term>Use another cable or make sure you've turned on Wi-Fi on both your phone and PC and try to connect again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᏄᏓᎴ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᎠᎴᏃ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎢᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ PC ᎠᎴ ᎭᏁᎵᏓ ᏏᏊ ᏗᎵᎪᏙᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Files successfully transferred to ">
                <langSet xml:lang="en-US"><tig><term>Files successfully transferred to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏍᏆᏂᎪᏙᏗ ᏄᏓᏄᎸᏅᎾ ᎤᎲᏒᎢ ᎾᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Disable by admin">
                <langSet xml:lang="en-US"><tig><term>Disable by admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ ᎾᎢ ᏄᏂᎬᏫᏳᏌᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you've turned on Wi-Fi on both your phone and PC, or connect your devices with a USB data cable">
                <langSet xml:lang="en-US"><tig><term>Make sure you've turned on Wi-Fi on both your phone and PC, or connect your devices with a USB data cable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎢᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ PC, ᎠᎴᏃ ᏔᎵᎪᏙᏗ ᏣᏤᎵ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᏠᏯᏍᏗ ᎾᏍᎩ USB ᎦᏟᏌᏅᎯ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sending files to ">
                <langSet xml:lang="en-US"><tig><term>Sending files to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎦᏅᏍᎩ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="CrystalTalk AI for recording is on.">
                <langSet xml:lang="en-US"><tig><term>CrystalTalk AI for recording is on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CrystalTalk AI ᎤᎬᏩᏟ ᎦᏂᏴᎲᎢ ᎨᎡᎢ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature toggle is also available from the quick settings">
                <langSet xml:lang="en-US"><tig><term>This feature toggle is also available from the quick settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᎤᏗᏞᎩ ᎨᎡᎢ ᎾᏍᏊ ᎠᏛᏅᎢᏍᏔᏅ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to see and control ongoing calls on the device. This includes information such as call numbers for calls and the state of the calls.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to see and control ongoing calls on the device. This includes information such as call numbers for calls and the state of the calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᎪᏩᏛᏗ ᏃᎴ ᎠᎯᎸᏍᏗ ᏂᎬᏯᎢᏒ ᏫᏗᎬᏔᏅᎢ ᎤᎾᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᏧᏓᏠᏯᏍᏗ ᎧᏃᎸᎥᏍᎩ ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᏫᎬᏙᏗ ᏗᏎᏍᏗ ᎾᏍᎩᎾ ᏫᏗᎬᏙᏗ ᏃᎴ ᎾᏍᎩ ᏗᎪᏏᏐᏗ ᎥᎿᎢ ᎾᏍᎩ ᏫᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to receive file from ">
                <langSet xml:lang="en-US"><tig><term>Failed to receive file from </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅᎢ ᎾᎢ ᎠᎩᏍᏗ ᎠᏍᏆᏂᎪᏙᏗ ᏂᏓᏳᏓᎴᏅ </term></tig></langSet>
            </termEntry>
            <termEntry id="1 - Install Ready for Assistant on your Windows PC, then set up the Ready For Assistant ">
                <langSet xml:lang="en-US"><tig><term>1 - Install Ready for Assistant on your Windows PC, then set up the Ready For Assistant </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>1 - ᎯᏘᏅᏛᎦ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ ᎤᎾᎢ ᏣᏤᎵ Windows PC, ᎿᏉᏃ ᎦᎪᏗ ᎾᏍᎩ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="CrystalTalk AI for recording is turned off">
                <langSet xml:lang="en-US"><tig><term>CrystalTalk AI for recording is turned off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CrystalTalk AI ᎤᎬᏩᏟ ᎦᏂᏴᎲᎢ ᎨᎡᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="This is a notification to warning users that CrystalTalk AI for recording is on or off">
                <langSet xml:lang="en-US"><tig><term>This is a notification to warning users that CrystalTalk AI for recording is on or off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎨᎡᎢ Ꭰ ᎠᏓᏃᏣᎳᏁᎯ ᎾᎿᎢ ᎠᏓᏕᏯᏔᎲᏍᎩ ᏗᏅᏗᏍᎩ ᎥᏍᎩᎾ CrystalTalk AI ᎤᎬᏩᏟ ᎦᏂᏴᎲᎢ ᎨᎡᎢ ᎤᎿ ᎠᎴ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone is busy with another file transfer.">
                <langSet xml:lang="en-US"><tig><term>Your phone is busy with another file transfer.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎤᎪᏓ ᏚᎸᏫᏍᏓᏁ ᎤᏠᏯᏍᏗ ᏄᏓᎴ ᎠᏍᏆᏂᎪᏙᏗ ᎠᎲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Create a PIN for modifying restrictions">
                <langSet xml:lang="en-US"><tig><term>Create a PIN for modifying restrictions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᎾᏍᎩ PIN ᎾᏍᎩᎾ ᎠᏃᏢᎯᏏᏍᎬ ᏗᏓᏲᏍᏓᏁᎯ</term></tig></langSet>
            </termEntry>
