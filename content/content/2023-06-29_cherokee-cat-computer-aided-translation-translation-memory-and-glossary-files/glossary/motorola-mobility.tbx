                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᏕᎦᎧᎲᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Motorola ID identifies you across all Motorola services.">
                <langSet xml:lang="en-US"><tig><term>Motorola ID identifies you across all Motorola services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Motorola ID ᎪᏟᏍᏙᏔᏅ ᏂᎯ ᏧᎾᏗᏫᏍᏒᎢ ᏂᎦᏓ Motorola ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call Settings error">
                <langSet xml:lang="en-US"><tig><term>Call Settings error</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᏫᎬᏙᏗ ᏕᎦᎧᎲᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Manage which apps to keep enabled.">
                <langSet xml:lang="en-US"><tig><term>Manage which apps to keep enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏚᎦᏛ ᎢᏳᏍᏗ ᏗᎬᏙᏗ ᏕᏣᏚᎵᎲ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please select which apps want to keep enabled.">
                <langSet xml:lang="en-US"><tig><term>Please select which apps want to keep enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᏑᏰᎦᎢᏳᏍᏗ ᏗᎬᏙᏗ ᏕᏣᏚᎵᎲ ᎢᏧᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Default ISODEP AID route">
                <langSet xml:lang="en-US"><tig><term>Default ISODEP AID route</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ISODEP AID ᏭᎶᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="NFC Overflow Notifications">
                <langSet xml:lang="en-US"><tig><term>NFC Overflow Notifications</term></tig></langSet>
