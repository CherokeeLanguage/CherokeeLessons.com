            </termEntry>
            <termEntry id="To switch between features, touch &amp; hold the accessibility button.">
                <langSet xml:lang="en-US"><tig><term>To switch between features, touch &amp; hold the accessibility button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎥᎦᏁᏟᏴᏍᎬᎢ ᎤᏜᏅᏛ ᏗᎦᏎᏍᏙᏗ, ᎠᏒᏂᏍᏗ &amp; ᎯᏂᏯ ᏥᎩ ᎬᏴᏍᏗ ᎨᏒᎢ ᎠᏐᏅᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Projects you create will appear here.">
                <langSet xml:lang="en-US"><tig><term>Projects you create will appear here.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏛᏁᏗ ᏂᎯ ᎪᏢᏗ ᏰᎵᏉ ᎤᎾᏄᎪᎢᏍᏗ ᎠᎭᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Convert to template">
                <langSet xml:lang="en-US"><tig><term>Convert to template</term></tig></langSet>
