                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ ᎾᏍᎩᎾ ᏗᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs permission to access background data to identify apps as games.">
                <langSet xml:lang="en-US"><tig><term>Gametime needs permission to access background data to identify apps as games.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏚᏚᎸᏛᎢ ᎢᎦᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎾᎢ ᎪᏟᏍᏙᏗ ᏗᎬᏙᏗ ᎾᏍᎩ ᏧᎾᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap &quot;Continue&quot; to grant permission.">
