                <langSet xml:lang="chr"><tig><term>ᎤᎦᎾᏩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face unlock lets you unlock your device by looking at it.">
                <langSet xml:lang="en-US"><tig><term>Face unlock lets you unlock your device by looking at it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᎧᏛ ᎠᏐᎭᎾᎸᏗ ᎣᎵᏍᎸᏓᏁ ᎠᏐᎭᎾᎸᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎢ ᎥᏘᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen lock, fingerprint, face unlock">
                <langSet xml:lang="en-US"><tig><term>Screen lock, fingerprint, face unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏍᏓᏱ ᎠᏍᏚᎭ, ᎦᏰᏌᏛᏔᏅᏙᏪᎸᎢ, ᎧᏁᏉᏍᏗᏍᎬ ᎤᏂᏐᎭᎾᎸᎩ</term></tig></langSet>
            </termEntry>
