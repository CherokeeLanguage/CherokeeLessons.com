                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ \u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="To change the color of your trigger buttons, tap onone of the options above">
                <langSet xml:lang="en-US"><tig><term>To change the color of your trigger buttons, tap onone of the options above</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᎠᏑᏫᏓ ᎥᎿᎢ ᏣᏤᎵ ᎪᏕᏍᏗᏒ ᏗᏐᎥᏍᏙᏗ, ᎭᏐᎥᏍᏓ ᎤᎿᎢᏌᏊ ᎥᎿᎢ ᏗᏑᏰᏍᏗ ᎦᎸᎳᏗᏟ </term></tig></langSet>
            </termEntry>
            <termEntry id="Unacknowledged Emergency alerts">
                <langSet xml:lang="en-US"><tig><term>Unacknowledged Emergency alerts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>not ᎪᎯᏳᏙᏗ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎠᏓᏃᏎᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="To make emergency call, press the power key thrice.">
                <langSet xml:lang="en-US"><tig><term>To make emergency call, press the power key thrice.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>To make emergency call, press the power key thrice. ᎤᏟᏍᏗ ᏫᏴᏅᏗ, ᎭᏐᎥᏍᏓ Ꮎ ᎤᏟᏂᎩᏓ ᏍᏚᎢᏍᏗ ᏦᎢ ᏱᏩᎦᏘ</term></tig></langSet>
