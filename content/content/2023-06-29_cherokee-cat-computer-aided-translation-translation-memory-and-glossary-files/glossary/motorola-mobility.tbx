                <langSet xml:lang="chr"><tig><term>ᏅᎪᎵᎬᎾ ᏗᎬᏙᏗ ᏤᏍᏗ ᎨᏒᎢ ᎦᏘᏅᏔᏅ ᏄᏩᎾ ᎯᎠ ᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't uninstall active device admin app">
                <langSet xml:lang="en-US"><tig><term>Can't uninstall active device admin app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏥᎯᏘᏅᏓᎩ ᎠᎵᏖᎸᎲᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏂᎬᏫᏳᏌᏕᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't uninstall active device admin app for ">
                <langSet xml:lang="en-US"><tig><term>Can't uninstall active device admin app for </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏥᎯᏘᏅᏓᎩ ᎠᎵᏖᎸᎲᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏂᎬᏫᏳᏌᏕᎩ ᎬᏙᏗ ᎾᏍᎩᎾ </term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to uninstall this app for allusers? The application and its data will be removed from all users on the device.">
                <langSet xml:lang="en-US"><tig><term>Do you want to uninstall this app for allusers? The application and its data will be removed from all users on the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍ ᏣᏚᎵ ᎾᎢ ᎢᏣᏘᏅᏕᏍᏗ ᎯᎠ ᎬᏙᏗ ᎾᏍᎩᎾ ᏂᎦᏓᏗᏅᏗᏍᎩ? ᎾᏍᎩᏃ ᎠᏔᏲᏍᏙᏗ ᏃᎴ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏒ ᎠᎲᏍᏓ ᎾᏍᎩᎾ ᏂᎦᏓ ᏗᏅᏗᏍᎩ ᎤᎾᎢ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Replace this app with the factory version? All data will be removed.">
                <langSet xml:lang="en-US"><tig><term>Replace this app with the factory version? All data will be removed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏓ ᎯᎠ ᎬᏙᏗ ᎬᏗ ᎾᏍᎩ ᎤᏃᏢᏅᏗ ᏄᏓᎴᏒᎢ? ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏒ ᎠᎲᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't display preview">
                <langSet xml:lang="en-US"><tig><term>Can't display preview</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏱᏂᎦᏰᎬᎦ ᎠᏓᎪᏩᏛᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your document may pass through one or more servers on its way to the printer.">
                <langSet xml:lang="en-US"><tig><term>Your document may pass through one or more servers on its way to the printer.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎪᏪᎳᏅᎢ ᏰᎵᏉ ᎦᎶᎯᏍᏔᏅ ᏬᎶᎯᏍᏗ ᏌᏊ ᎠᎴᏃ ᎤᏥ ᎢᎦᎢ ᏗᏯᏙᎯᎯ ᎤᎾᎢ ᏫᎦᎶᏍᎩ ᎾᎾᎢ ᎾᏍᎩ ᎦᎴᏴᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Streaming: ">
                <langSet xml:lang="en-US"><tig><term>Streaming: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊᏥᎩ ᎠᏥᎢᎵᏒᎢ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Before you can create a restricted profile, you\u2019ll need to set up a screen lock to protect your apps and personal data.">
                <langSet xml:lang="en-US"><tig><term>Before you can create a restricted profile, you\u2019ll need to set up a screen lock to protect your apps and personal data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᎷᎸ ᏂᎯ ᏰᎵᏊ ᎪᏒᏗ ᎠᏓᎨᏗᏍᎩ ᎤᎧᏛ, ᎤᏚᎸᏛ ᎾᎢ ᎦᎪᏗ ᎠᏰᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᎢ ᎠᎵᏍᏕᎸᏙᏗ ᏣᏤᎵ ᏗᎬᏙᏗ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Trigger Bluetooth Audio LDAC\u000ACodec Selection: Playback Quality">
                <langSet xml:lang="en-US"><tig><term>Trigger Bluetooth Audio LDAC\u000ACodec Selection: Playback Quality</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏣᏁᏍᏗᎢ Bluetooth ᎤᏃᏴᎬ LDAC\u000AᏂᎬᏅᏗᏓᏅ ᎠᏑᏰᏛ: ᎠᏏᏅᏍᏔᏅ ᏗᏁᎸᏙᏗ ᎢᏲᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show hardware layers updates">
                <langSet xml:lang="en-US"><tig><term>Show hardware layers updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᏓᏰᎦᏢᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't scan for networks">
                <langSet xml:lang="en-US"><tig><term>Can't scan for networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎬᏟᎶᏍᏙᏗ ᏱᎩ ᎾᏍᎩ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow window-level blurs">
                <langSet xml:lang="en-US"><tig><term>Allow window-level blurs</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᏦᎳᏂ-ᎠᏥᎶᏍᎩ ᏧᏍᎪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When we no longer are monitoring with the persistent logger, we are required to erase the logger data resident on your device.">
                <langSet xml:lang="en-US"><tig><term>When we no longer are monitoring with the persistent logger, we are required to erase the logger data resident on your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎦᏛᏉ ᎭᏗ ᏃᏊᏃ ᎨᏒᎢ ᎠᎦᏎᏍᏙᏗ ᎬᏗ ᎾᏍᎩ ᏂᏓᏓᏲᏍᎬᎾ ᏄᏛᏁᎸ ᎧᏃᎮᏢᏍᎩ, ᏂᎦᏛᏉ ᎨᏒᎢ ᎠᏎᏯᏛᏁᏗ ᎾᎢᎠᏍᎪᎸᏗᏍᏗ ᎾᏍᎩ ᏄᏛᏁᎸ ᎧᏃᎮᏢᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎦᏁᎳ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to create a new user">
                <langSet xml:lang="en-US"><tig><term>Failed to create a new user</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎢ ᎪᏒᏗ ᎢᏤ ᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Revoke access to USB debugging from all computers you\u2019ve previously authorized?">
                <langSet xml:lang="en-US"><tig><term>Revoke access to USB debugging from all computers you\u2019ve previously authorized?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏎᎯᏍᏗ ᎠᏴᏍᏗ ᎾᎢ USB ᎪᎷᏩᏘᏍᎬ ᏂᏓᏳᏓᎴᏅ ᏂᎦᏓ ᏗᎦᏙᎥᎯᏍᏗ ᏗᏍᏆᏂᎪᏗᏍᎩ ᏧᏩᎫᏔᏅᏒ ᎤᎾᎵᏍᎪᎸᏔᏅᎯ?</term></tig></langSet>
            </termEntry>
