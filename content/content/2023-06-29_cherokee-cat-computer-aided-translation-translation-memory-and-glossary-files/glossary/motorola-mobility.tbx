            </termEntry>
            <termEntry id="Ring &amp; notification set to high">
                <langSet xml:lang="en-US"><tig><term>Ring &amp; notification set to high</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏍᏔᎫ &amp; ᎠᏓᏃᏣᎳᏁᎯ ᎤᎾᏓᏡᎬ ᎾᎿᎢ ᎦᎷᎾᎳᏘ</term></tig></langSet>
