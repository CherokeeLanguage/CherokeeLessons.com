            </termEntry>
            <termEntry id="Please enter your device encryption password below.">
                <langSet xml:lang="en-US"><tig><term>Please enter your device encryption password below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏕᎵᏍᏙᏗ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Power sharing stopped because your device is too warm">
                <langSet xml:lang="en-US"><tig><term>Power sharing stopped because your device is too warm</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ ᎠᎴᏫᏍᏓ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᏉ ᎤᎦᎾᏩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Since your device is encrypted, you are required to encrypt your backup.">
