            </termEntry>
            <termEntry id="Use extra RAM to open apps faster">
                <langSet xml:lang="en-US"><tig><term>Use extra RAM to open apps faster</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎧᏁᏉᏓ RAM ᎠᏍᏚᎢᏍᏗ ᏗᎬᏙᏗ ᎤᏟᏍᏓ ᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Games will use mobile data when Wi-fi is not available">
                <langSet xml:lang="en-US"><tig><term>Games will use mobile data when Wi-fi is not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏁᎸᏙᏗ ᎠᏎᎢ ᎬᏙᏓ ᎠᏓᏅᏏᏙᎯ ᎦᏟᏌᏅᎯ ᎾᎯᏳ ᏫᎢ-ᏈᎢ ᏄᏍᏛ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some games may not work well with Acoustic lights.">
                <langSet xml:lang="en-US"><tig><term>Some games may not work well with Acoustic lights.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏧᎾᏁᎸᏙᏗ ᏰᎵᏉ ᎥᏝ ᎣᏍᏓ ᏱᏗᎬᏙᎩ ᎬᏗ ᏃᏌᏅ ᎤᏃᏴᎵᏓ ᏓᏨᏍᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For the best experience, try using this feature with battle royale shooting games.">
                <langSet xml:lang="en-US"><tig><term>For the best experience, try using this feature with battle royale shooting games.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾ ᏫᏓᏤᏢ ᎠᎦᏙᎲᏒᎢ, ᎭᏁᎵᏓ ᎲᏗᏍᎬᎢ ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎤᏠᏯᏍᏗ ᏚᎾᏟᏴᎲᎢ ᎤᏓᎵᎩ ᏗᏍᏓᏲᏍᏗ ᏧᎾᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect to\u2026">
                <langSet xml:lang="en-US"><tig><term>Connect to\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎾᎿᎢ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Disabled by IT admin">
                <langSet xml:lang="en-US"><tig><term>Disabled by IT admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎴᏫᏍᏔᏅᎢ ᎨᏒᎢ IT ᏅᎬᏫᏌᏁᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id=" is the only active SIM in your device.">
                <langSet xml:lang="en-US"><tig><term> is the only active SIM in your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏄᏍᏛ ᎾᏍᎩ ᎤᏩᏌ ᎾᎵᏖᎸᎲᏍᎬᎾ SIM inᎾᎿᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to use this SIM for mobile data, calls, and SMS messages?">
                <langSet xml:lang="en-US"><tig><term>Do you want to use this SIM for mobile data, calls, and SMS messages?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᏨᏙᏗ ᎯᎠ SIM ᎾᏍᎩᎾ ᎠᏓᏅᏏᏙᎯ ᎦᏟᏌᏅᎯ, ᏫᏗᎬᏔᏅᎢ, ᎠᎴ SMS ᏗᎧᏃᎮᏍᎩ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Telephoto does not support the current resolution.">
                <langSet xml:lang="en-US"><tig><term>Telephoto does not support the current resolution.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎯᏓ ᎠᏓᎨᏗ ᎥᏝᏃ ᏱᎦᎫᏍᏛᎲᎦ ᎾᏍᎩ ᏃᏊᏥᎩ ᎠᏓᏴᎳᏛᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Macro mode helps you take detailed photos of subjects as close as 1.0 inches away from the lens">
                <langSet xml:lang="en-US"><tig><term>Macro mode helps you take detailed photos of subjects as close as 1.0 inches away from the lens</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎹᎧᎣ ᎬᏙᏗᎭ ᏍᏕᎵᏍᎪᎢ ᎠᎩᏍᏗ ᎠᏎᎸᎩ ᎢᎬᏁᏗ ᏗᏓᏟᎶᏍᏔᏅ ᎥᎿ ᏗᎧᏃᎮᏗ ᎾᏍᎩ ᎾᎥᏂᎨ ᎾᏍᎩ 1.0 ᎢᏯᏏᏔᏘᏍᏗ ᎢᏴᎢ ᎾᏍᎩ ᏗᏓᎨᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Macro mode helps you take detailed photos of subjects as close as 2.5 cm away from the lens">
                <langSet xml:lang="en-US"><tig><term>Macro mode helps you take detailed photos of subjects as close as 2.5 cm away from the lens</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎹᎧᎣ ᎬᏙᏗᎭ ᏍᏕᎵᏍᎪᎢ ᎠᎩᏍᏗ ᎠᏎᎸᎩ ᎢᎬᏁᏗ ᏗᏓᏟᎶᏍᏔᏅ ᎥᎿ ᏗᎧᏃᎮᏗ ᎾᏍᎩ ᎾᎥᏂᎨ ᎾᏍᎩ 2.5 cm ᎢᏴᎢ ᎠᏓᎴᏂᏍᎬ ᎾᏍᎩ ᏗᏓᎨᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This is an example of how messages will look">
                <langSet xml:lang="en-US"><tig><term>This is an example of how messages will look</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏄᏍᏛ Ꭰ ᏱᏓᏟᎶᏍᏔᎾ ᎾᎿᎢ ᏙᎡᎵ ᏗᎪᎵᏰᏗ ᎠᏎᎢ ᏩᎦᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="Replace background">
                <langSet xml:lang="en-US"><tig><term>Replace background</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏁᏟᏴᏍᏓ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select the area to keep in color">
                <langSet xml:lang="en-US"><tig><term>Select the area to keep in color</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏥᎩ ᎢᎬᎾᏕᎾ ᎾᎿᎢ ᎯᏍᏆᏂᎪᏓ ᎾᎿ ᎠᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't load the photo">
                <langSet xml:lang="en-US"><tig><term>Can't load the photo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏰᎵ ᎯᏢᎦ ᏥᎩ ᏗᏓᏟᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning Bluetooth on\u2026">
                <langSet xml:lang="en-US"><tig><term>Turning Bluetooth on\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᎬ Bluetooth ᎤᎾᎢ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Hotspot is on.">
                <langSet xml:lang="en-US"><tig><term>Hotspot is on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᏄᏍᏛ ᎾᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To connect your device, turn it off.">
                <langSet xml:lang="en-US"><tig><term>To connect your device, turn it off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏗᎵᎪᏙᏗᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏍᏚᎲᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you've turned on Wi-Fi on both your phone and PC, or connected by a USB data cable.Then enter the Wi-Fi or USB related IP address in PC client">
                <langSet xml:lang="en-US"><tig><term>Make sure you've turned on Wi-Fi on both your phone and PC, or connected by a USB data cable.Then enter the Wi-Fi or USB related IP address in PC client</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎢᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ PC, ᎠᎴᏃ ᎫᏓᎸᏅᎯ ᎬᏗ USB ᎦᏟᏌᏅᎯ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ. ᎿᏉᏃ ᎯᏴᏓ ᎾᏍᎩ ᏫᎢ-ᏈᎢ ᎠᎴᏃ USB ᏧᏠᏱ IP ᎪᏪᎵ ᏗᎦᏁᏍᏗ ᎤᎾᎢ PC ᎠᏥᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the dual cameras to create a portrait effect.">
                <langSet xml:lang="en-US"><tig><term>Use the dual cameras to create a portrait effect.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎾᏍᎩ ᎤᏠᏯ ᏗᏟᎶᏍᏙᏗ ᎾᎢ ᎪᏢᏗ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏔᏅ ᏂᏨᏁᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="While you’re chatting, you can rotate your camera, blur the background, and more from the left sidebar.">
                <langSet xml:lang="en-US"><tig><term>While you’re chatting, you can rotate your camera, blur the background, and more from the left sidebar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᎯᏬᏂᏍᎬᎢ, ᏂᎯ ᏰᎵᏊ ᎠᏗᏆᎸᏕᏯᏍᏓ ᏣᏤᎵ ᏗᏓᏟᎶᏍᏙᏗ, ᎤᏍᎪᎸ ᎾᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ, ᎠᎴ ᎤᏟ ᎢᎦᎢ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎠᏍᎦᏂ ᎤᏟᏗᏢ ᎪᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To transfer text, make sure Ready For Assistant is open on your PC or the mobile device is set to visible to other devices in settings.">
                <langSet xml:lang="en-US"><tig><term>To transfer text, make sure Ready For Assistant is open on your PC or the mobile device is set to visible to other devices in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᎲᏍᏗ ᎪᏪᎳᏅᎢ, ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎠᏛᏅᎢᏍᏙᏗ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ ᏄᏍᏛ ᎠᏍᏚᎢᏓ ᎤᎾᎢ ᏣᏤᎵ PC ᎠᎴᏃ ᎾᏍᎩ ᎠᏓᏅᏏᏙᎯ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏛ ᎦᎧᎲᎩ ᎾᎢ ᎬᎪᏩᏛᏗ ᏅᏩᏓᎴ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wallpaper colors">
                <langSet xml:lang="en-US"><tig><term>Wallpaper colors</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᏗᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="GNSS Time Update Service">
                <langSet xml:lang="en-US"><tig><term>GNSS Time Update Service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>GNSS ᎠᏥᎢᎵᏒ ᎪᏢᎯᏐᏗ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Visit a repair provider.">
                <langSet xml:lang="en-US"><tig><term>Visit a repair provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏩᏛᎯᏓᏍᏗ ᎣᏍᏓ ᏱᎬᏗᎢ ᎠᏓᏁᎸᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Custom colors">
                <langSet xml:lang="en-US"><tig><term>Custom colors</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛᎢᏯᏛᏁᏗᎢ ᏗᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For brings your favorite video apps into one place for easy access while you’re connected to a display.">
                <langSet xml:lang="en-US"><tig><term>Ready For brings your favorite video apps into one place for easy access while you’re connected to a display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏣᏤᎵ ᏫᏣᎸᏉᏛᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏗᎬᏙᏗ ᎾᎿᎢ ᏌᏊ ᎤᏙᏢᏒᎢ ᎾᏍᎩᎾ ᎠᎯᏓ ᎠᏴᏍᏗ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏣᏚᏓᎸᏅᎯ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The quick brownfox jumps over thelazy dog">
                <langSet xml:lang="en-US"><tig><term>The quick brownfox jumps over thelazy dog</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎤᏟᏍᏓᎤᏬᏗᎨᎢ ᏧᎳᏗᎵᏔᏕᎩ ᎢᏴᏛ ᏥᎩ ᎤᏓᏄᎸᎯ ᎩᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Depth isn't supported for this photo">
                <langSet xml:lang="en-US"><tig><term>Depth isn't supported for this photo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏫᏂᏴ ᏝᏰᏃ ᎦᎫᏍᏛᏅᎢ for this ᏗᏓᏟᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Blur">
                <langSet xml:lang="en-US"><tig><term>Blur</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᎪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Selective focus">
                <langSet xml:lang="en-US"><tig><term>Selective focus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏑᏰᏒᎢ ᎤᎿᏊ ᎢᎦ ᏔᎧᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Result">
                <langSet xml:lang="en-US"><tig><term>Result</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to record.">
                <langSet xml:lang="en-US"><tig><term>Unable to record.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᏕᎦᏅᏅᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can open in the following ways:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select">
                <langSet xml:lang="en-US"><tig><term>You can open in the following ways:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎨᏍᏚᎢᏍᏗ ᏱᎩ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᏱᏗᎬᏁᏗ: ᏥᏍᏕᏥ: ᏗᏐᏅᏍᏙᏗ: ᎠᏐᎥᏍᏙᏗ {W} + TᎢᎾ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ {M} ᏗᏁᎸᏙᏗ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ L1 + R1 + ᎠᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read the history of all URLs that the Browser has visited, and all of the Browser's bookmarks. Note: this permission may not be enforced by third-party browsers or other applications with web browsing capabilities.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read the history of all URLs that the Browser has visited, and all of the Browser's bookmarks. Note: this permission may not be enforced by third-party browsers or other applications with web browsing capabilities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᎪᎵᏰᏗ ᎾᏍᎩ ᏂᏧᎵᏍᏔᏅᏒ ᎥᎿᎢ ᏂᎦᏓ URLs ᎾᏍᎩᎾᎢ ᎠᏍᏚᎢᏍᎩ ᏄᏩᏅᎢ ᎤᏓᏩᏛᎯᏙᎸᎩ, ᏃᎴ ᏂᎦᏓ ᎾᏍᎩ ᎠᏍᏚᎢᏍᎩ ᏄᏩᏅᎢ ᏗᎪᏪᎵ ᏗᏩᏛᏙᏗ. ᎤᏍᏗ ᎪᏪᎸ: ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏰᎵᏉ ᎨᏍᏗ ᏰᎵ ᎦᏌᏙᏴᎢ ᎨᏒ ᏦᎢᏁ-ᎤᎾᏓᏟᏌᎲ ᏗᏍᏚᎢᏍᎩ ᎠᎴᏃ ᏐᎢ ᎠᏔᏲᏍᏙᏗ ᎬᏗ ᎤᏂᎳᏛᎢ ᏓᏍᏚᎢᏍᎬᎢ ᏰᎵ ᎢᏯᏛᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't download messages in Airplane mode">
                <langSet xml:lang="en-US"><tig><term>Can't download messages in Airplane mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏗᎦᏃᏣᎳᏅᎯ ᎾᎿ ᏥᏳ ᏄᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Five">
                <langSet xml:lang="en-US"><tig><term>Five</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can open the sidebar using any of these methods:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select">
                <langSet xml:lang="en-US"><tig><term>You can open the sidebar using any of these methods:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎨᏍᏚᎢᏍᏗ ᏱᎩ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎲᏗᏍᎬ ᏂᎦᎥᏉ ᎯᎠᏃ ᎢᏗᎬᏁᏗ:ᏥᏍᏕᏥ: ᏗᏐᏅᏍᏙᏗ: ᎠᏐᎥᏍᏙᏗ {W} + T ᎢᎾ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ {M} ᏗᏁᎸᏙᏗ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ L1 + R1 + ᎠᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Send videos">
                <langSet xml:lang="en-US"><tig><term>Send videos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᏗᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some messages not sent in Messages">
