                <langSet xml:lang="chr"><tig><term>ᎤᏓᏠᎯᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Add AI visual effects to your wallpapers">
                <langSet xml:lang="en-US"><tig><term>Add AI visual effects to your wallpapers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ AI ᏕᎦᏅᏛᎢ ᎠᎪᏩᏛᏗ ᏄᎵᏍᏔᏅ ᎾᎢ ᏣᏤᎵ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device couldn't install this update.">
                <langSet xml:lang="en-US"><tig><term>Your device couldn't install this update.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ Ꮭ ᏰᎵ ᎯᏘᏅᎦ ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Checking if the memory is sufficient">
                <langSet xml:lang="en-US"><tig><term>Checking if the memory is sufficient</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᎠ ᎾᎿ ᏥᎩ ᎠᏅᏓᏗᏍᏙ ᎨᎡᎢ ᏰᎵ ᏂᎦᎡᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Protect your device from security threats">
                <langSet xml:lang="en-US"><tig><term>Protect your device from security threats</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏅᏓᏳᏓᎴᏅᎯ ᏧᎾᎦᏎᏍᏗ ᏗᎦᏁᏄᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Send and receive confirmation when messages are read">
                <langSet xml:lang="en-US"><tig><term>Send and receive confirmation when messages are read</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᎠᎴ ᎦᏁᏍᏗ ᎦᎫᏍᏛᏗᏱ ᎢᏳᏃ ᏗᎪᎵᏰᏗ ᎨᏒᎩ ᎠᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This process is secure">
                <langSet xml:lang="en-US"><tig><term>This process is secure</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏱᎵᏒ ᎨᎡᎢ ᏄᎾᏰᎯᏍᏛᎾᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="A security update is ready">
                <langSet xml:lang="en-US"><tig><term>A security update is ready</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏧᎾᎦᏎᏍᏗ ᎪᏢᎯᏐᏗ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Updates are downloaded and installed automatically when you're connected to Wi-Fi">
                <langSet xml:lang="en-US"><tig><term>Updates are downloaded and installed automatically when you're connected to Wi-Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏢᎯᏐᏗ ᎨᎡᎩ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏃᎴ ᎦᏘᏅᏔᏅ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Device will auto install on ">
                <langSet xml:lang="en-US"><tig><term>Device will auto install on </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎤᏩᏒ ᎯᏘᏅᎦ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Your device will restart automatically">
                <langSet xml:lang="en-US"><tig><term>Your device will restart automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="System Update is available in home network only.">
                <langSet xml:lang="en-US"><tig><term>System Update is available in home network only.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎪᏢᎯᏐᏗ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎾᎿ ᎣᏪᏅᏒ ᏧᎾᏚᏓᎵ ᎤᏅᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Go to Settings &gt; Network &amp; internet &gt; Wi-Fi to setup a connection now.">
                <langSet xml:lang="en-US"><tig><term>Go to Settings &gt; Network &amp; internet &gt; Wi-Fi to setup a connection now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏧᎾᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ &gt; Wi-Fi ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ Ꭰ ᎫᏓᎸᎢ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Download now">
                <langSet xml:lang="en-US"><tig><term>Download now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ Ꭷ</term></tig></langSet>
            </termEntry>
            <termEntry id="There's not enough space on the SD Card to complete the download.">
                <langSet xml:lang="en-US"><tig><term>There's not enough space on the SD Card to complete the download.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎭᎢ ᎥᏝ ᏰᎵᏉ ᎤᏜᏅᏛ ᎤᎿᎢ ᏥᎩ SD ᏆᎾᏲᏍᏗ ᎾᎿᎢ ᎧᎵᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please don't remove the SD Card Until installation is complete.">
                <langSet xml:lang="en-US"><tig><term>Please don't remove the SD Card Until installation is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏝᏍᏗ ᏱᎬᎾᏕᏍᏗ ᏥᎩ SD ᏆᎾᏲᏍᏗ ᎩᎳ ᎦᏘᏅᏔᏅ ᎨᎡᎢ ᎧᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap here to check memory and proceed.">
                <langSet xml:lang="en-US"><tig><term>Tap here to check memory and proceed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎭᏂ ᎾᎿᎢ ᏫᏣᎦᏛᎲᎦ ᎠᏅᏓᏗᏍᏙ ᎠᎴ ᎠᎯᎸᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System update is blocked.">
                <langSet xml:lang="en-US"><tig><term>System update is blocked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎢ ᎦᏐᎭᎾᎳᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap this button to create a new folder in the app tray">
                <langSet xml:lang="en-US"><tig><term>Tap this button to create a new folder in the app tray</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᏐᎥᏍᏙᏗ ᎪᏒᏗ ᎢᏤ ᏗᏴᏈᏛᎥᏍᎩ ᏫᏗᎬᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Software update is downloading to SD Card.">
                <langSet xml:lang="en-US"><tig><term>Software update is downloading to SD Card.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏗᏅᏗ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ ᎾᎿᎢ SD ᏆᎾᏲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again by manually checking for updates via Phone settings.">
                <langSet xml:lang="en-US"><tig><term>Please try again by manually checking for updates via Phone settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏁᎸᏓ ᎬᏗ ᎣᏩᏌ ᏱᎬᏁᏗ ᎠᎪᎵᏰᎠ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏐᏗ ᎤᎶᏒ ᏗᏟᏃᎮᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please contact your device admin for more info.">
                <langSet xml:lang="en-US"><tig><term>Please contact your device admin for more info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᎤᎬᏩᏟ ᎤᏟ ᎢᎦᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The image will disappear when you look away from screen.">
                <langSet xml:lang="en-US"><tig><term>The image will disappear when you look away from screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᎪᏩᏘ ᎠᏎ ᎠᏗᏍᎦᎶᏗ ᎢᏳᏃ ᏂᎯ ᏩᎦᏔ ᎤᏤᎵᏛ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏓᏎᎮᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The update could not be properly validated.">
                <langSet xml:lang="en-US"><tig><term>The update could not be properly validated.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ Ꮭ ᏰᎵ ᎨᎡᎢ ᏗᏙᎳᏤᎩ ᎪᎯᏳᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No changes have been made.">
                <langSet xml:lang="en-US"><tig><term>No changes have been made.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏗᎦᏁᏟᏴᏓ ᎤᏒᎦᎵ ᏱᎨᏎ ᎪᏢᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The upgrade attempt has encountered an error due to failed log in.">
                <langSet xml:lang="en-US"><tig><term>The upgrade attempt has encountered an error due to failed log in.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏦᏢᎯᏐᏗ ᎤᏁᎸᏙᏗ ᏂᏚᏩᎿ ᏗᏠᎯᏍᏗ Ꭰ ᏓᏓᎴᎬᎢ ᎠᎵᏍᎪᏗᏍᏗ ᎢᏴᎢ ᎾᎿᎢ ᎤᏄᎸᏅᎢᎯᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Android  is here!">
                <langSet xml:lang="en-US"><tig><term>Android  is here!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android  ᎨᎡᎢ ᎠᎭᏂ!</term></tig></langSet>
            </termEntry>
            <termEntry id="It'll only take about 90 seconds to restart your device.">
                <langSet xml:lang="en-US"><tig><term>It'll only take about 90 seconds to restart your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᎠᏎ ᎤᏅᏒ ᎯᏫᏓ ᎢᎸᏢ 90 ᏓᏓᎾᏩᏍᎬ ᎾᎿᎢ ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There was an update error.">
                <langSet xml:lang="en-US"><tig><term>There was an update error.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ Ꭰ ᏗᎪᏢᎯᏌᏅᎯ ᏓᏓᎴᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Explore new devices">
                <langSet xml:lang="en-US"><tig><term>Explore new devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏣᎦᏛᏂᏗ ᏗᏤ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please restart by .">
                <langSet xml:lang="en-US"><tig><term>Please restart by .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᎬᏗ .</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't be able to use your device until it completes.">
                <langSet xml:lang="en-US"><tig><term>You won't be able to use your device until it completes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏝᏰᎵ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎩᎳ ᎨᎡᎢ ᎠᏍᏆᏛᏃᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Otherwise you will miss out on security updates, as well as new features and bug fixes.">
                <langSet xml:lang="en-US"><tig><term>Otherwise you will miss out on security updates, as well as new features and bug fixes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏰᎵ ᏂᎯ ᎠᏎ ᎦᏅᏗᏍᏗ ᎦᏅᎪᏫᏛ ᎤᎿᎢ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ, ᎤᎿᎢ ᎣᏍᏓ ᎤᎿᎢ ᏗᏤ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There's not enough light to see your face.">
                <langSet xml:lang="en-US"><tig><term>There's not enough light to see your face.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎭᎢ ᎥᏝ ᏰᎵᏉ ᎢᎦᎯ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Add Label">
                <langSet xml:lang="en-US"><tig><term>Add Label</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏗ ᎦᏯᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tips">
                <langSet xml:lang="en-US"><tig><term>Tips</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᎯᏎᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please move to a different environment.">
                <langSet xml:lang="en-US"><tig><term>Please move to a different environment.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᎲᏍᏗ ᎾᎿᎢ Ꭰ ᏧᏓᎴᎿᎢ ᎡᎶᎯ ᏄᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to hold your phone and look directly at the screen.">
                <langSet xml:lang="en-US"><tig><term>You need to hold your phone and look directly at the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎯᎾᎯᏍᏓ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᎴ ᏩᎦᏔ ᎠᏓᏎᎮᎸᎢ ᎤᎿᎢ ᏂᎩ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows application communicate with Micro Screen Receiver.">
                <langSet xml:lang="en-US"><tig><term>Allows application communicate with Micro Screen Receiver.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎬᏙᏗ ᏗᏓᏛᎪᏙᏗ ᎬᏗ ᎥᏳᎩ ᎠᏓᏠᎩ ᎠᏓᏎᎮᎸᎢ ᎠᎩᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the application to turn the Micro Screen feature on.">
                <langSet xml:lang="en-US"><tig><term>Allows the application to turn the Micro Screen feature on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎬᏙᏗ ᏗᏓᏛᎪᏙᏗ ᎬᏗ ᎥᏳᎩ ᎠᏓᏠᎩ ᎠᏓᏎᎮᎸᎢ ᎤᏩᎬᏗᏗᏒ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="An image will appear in the circle below when Attentive Display sees you.">
                <langSet xml:lang="en-US"><tig><term>An image will appear in the circle below when Attentive Display sees you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎠᏅᏓᏗᏍᏙ ᎠᏎ ᎬᏂᎨᏒᎢ ᎾᎿ ᏥᎩ ᎦᏐᏆᎸᎢ ᎡᎳᏗᏢ ᎢᏳᏃ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎠᎪᏩᏘ ᏂᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="send broadcast to Micro Screen Receiver">
                <langSet xml:lang="en-US"><tig><term>send broadcast to Micro Screen Receiver</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᎠᏗᎦᎴᏯᏍᏗ ᎾᎿᎢ ᎥᏳᎩ ᎠᏓᏠᎩ ᎠᏓᏎᎮᎸᎢ ᎠᎩᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Look at the screen">
                <langSet xml:lang="en-US"><tig><term>Look at the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᎦᏔ ᎤᎿᎢ ᏥᎩ ᎠᏓᏎᎮᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not enough light">
                <langSet xml:lang="en-US"><tig><term>Not enough light</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᏉ ᎢᎦᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Start at the center of the screen and swipe down to the left or right as shown in the animation">
                <langSet xml:lang="en-US"><tig><term>Start at the center of the screen and swipe down to the left or right as shown in the animation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᎾ ᎤᎿᎢ ᏥᎩ ᎠᏰᏟ ᎾᎿ ᏥᎩ ᎠᏓᏎᎮᎸᎢ ᎠᎴ ᎦᎶᎯᏍᏗᏍᎩ ᎡᎳᏗᏜ ᎾᎿᎢ ᏥᎩ ᎤᏓᎷᎵ ᎠᎴ ᎠᎦᏘᏏ ᎤᎿᎢ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎾᎿ ᏥᎩ ᎠᏓᏅᏏᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎠᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Take screenshots with a tap">
                <langSet xml:lang="en-US"><tig><term>Take screenshots with a tap</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎬᏗ Ꭰ ᎤᏟᏍᏓ ᎠᏒᏂᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock your device by picking it up and looking at the screen">
                <langSet xml:lang="en-US"><tig><term>Unlock your device by picking it up and looking at the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏌᎳᏙᏗ ᎨᎡᎢ ᎠᎴ ᎠᎦᏖᏃᎲᎩ ᎤᎿᎢ ᏥᎩ ᎠᏓᏎᎮᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To go to the next or previous track when the screen is off, press and hold the volume up or down key.">
                <langSet xml:lang="en-US"><tig><term>To go to the next or previous track when the screen is off, press and hold the volume up or down key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎠᎴ ᏧᏩᎫᏔᏅ ᎪᎷᏅᏍᏗ ᎢᏳᏃ ᏥᎩ ᎠᏓᏎᎮᎸᎢ ᎨᎡᎢ ᎠᏍᏚᏗ, ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᎾᎯᏍᏓ ᏥᎩ ᏂᎦᎥ ᎤᏜᏅᏛᎢ ᎦᎸᎳᏗ ᎠᎴ ᎡᎳᏗᏜ ᎤᎵᏍᎨᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Click to allow permissions">
                <langSet xml:lang="en-US"><tig><term>Click to allow permissions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᎿᎢ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your fingertips are too close to each other.">
                <langSet xml:lang="en-US"><tig><term>Your fingertips are too close to each other.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏕᎯᏰᏌᏛ ᏫᏚᎵᏍᏛᎢ ᎨᎡᎩ ᎾᏍᏉ ᎠᏍᏚᏗ ᎾᎿᎢ ᏌᏊᎭ ᏐᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not exactly.">
                <langSet xml:lang="en-US"><tig><term>Not exactly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎧᎵ ᏗᏙᎳᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Update Current Emergency Address">
                <langSet xml:lang="en-US"><tig><term>Update Current Emergency Address</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᏃᏊ ᏥᎩ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your work apps can’t send you notifications, use your battery, or access your location">
                <langSet xml:lang="en-US"><tig><term>Your work apps can’t send you notifications, use your battery, or access your location</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᎬᏃᏙᏓ ᎭᏗ ᏫᎬᎯᏅᎦ ᏗᎾᏍᎣᏣᎳᏅ, ᎲᏓ ᎠᎾᎦᎵᏍᎩ, ᏃᎴ ᏫᏨᏴᏍᏗ ᎤᏙᏢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="The screen will remain on while you're looking at it">
                <langSet xml:lang="en-US"><tig><term>The screen will remain on while you're looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏓᏎᎮᎸᎢ ᎠᏎ ᎤᏓᏃᎯᏴ ᎤᎿᎢ ᎠᏏᏉ ᏂᎯ ᎨᎡᎩ ᎠᎦᏖᏃᎲᎩ ᎤᎿᎢ ᎾᎿ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fast flashlight isn’t available while you’re using this app">
