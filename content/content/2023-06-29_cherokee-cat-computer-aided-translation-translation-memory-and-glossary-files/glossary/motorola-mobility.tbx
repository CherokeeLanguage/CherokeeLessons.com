            <termEntry id="Ready For makes it easy to enjoy full-screen video chats while you’re connected to a display">
                <langSet xml:lang="en-US"><tig><term>Ready For makes it easy to enjoy full-screen video chats while you’re connected to a display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏂᎦᎵᏍᏗᏍᎬᎢ ᎠᎯᏓ ᎨᏒᎢ ᎠᎵᎮᎵᏍᏗ ᎭᏓᏠᏯᏍᏗ ᎠᏓᏴᎳᏛᏙᏗ ᏓᎾᏟᏃᎮᏍᎬᎢ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᎫᏓᎸᏅᎯ ᎾᎢ ᎧᎵ ᎠᏰᏙᎳᏛᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to mobile data when Wi-Fi connection is not available">
                <langSet xml:lang="en-US"><tig><term>Switch to mobile data when Wi-Fi connection is not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏗᎵᎪᏔᏅᎯ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For lets you enjoy your favorite mobile games on a larger connected display">
                <langSet xml:lang="en-US"><tig><term>Ready For lets you enjoy your favorite mobile games on a larger connected display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏣᎵᏍᎪᎸᏓᏁᎯ ᏗᏣᎵᎮᎵᏍᏗ ᏣᏤᎵ ᏫᏣᎸᏉᏛᎢ ᎠᏓᏅᏏᏙᎯ ᏧᎾᏁᎸᏙᏗ ᎤᎾᎢ ᎡᏉᎯᎨᏍᏗ ᎫᏓᎸᏅᎯ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For brings your favorite video apps into one place for easy access while you’re connected to a display">
                <langSet xml:lang="en-US"><tig><term>Ready For brings your favorite video apps into one place for easy access while you’re connected to a display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏣᏤᎵ ᏫᏣᎸᏉᏛᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏗᎬᏙᏗ ᎾᎿᎢ ᏌᏊ ᎤᏙᏢᏒᎢ ᎾᏍᎩᎾ ᎠᎯᏓ ᎠᏴᏍᏗ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏣᏚᏓᎸᏅᎯ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can customize your phone's color palette with Moto's Personalize feature found in the home screen menu or within the Moto App.">
                <langSet xml:lang="en-US"><tig><term>You can customize your phone's color palette with Moto's Personalize feature found in the home screen menu or within the Moto App.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᏑᏫᏓ ᏧᏂᏠᏗ ᎠᏤᎲᏍᏙᏗ ᏂᎯ ᏰᎵᏊ ᎬᏗ Moto’s Personalize ᎤᏩᎬᏗᏗᏒ ᎠᎩᏩᏛᎲᎩ ᎾᎯᏳ ᎪᏪᎳᎾᎥᎢ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᎠᏫᏂᏗᏢ Moto App.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now, in Android 12, a helpful status bar indicator will show you anytime your camera or microphone are in use.">
                <langSet xml:lang="en-US"><tig><term>Now, in Android 12, a helpful status bar indicator will show you anytime your camera or microphone are in use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ, ᎾᎿᎢ Android 12, ᎧᏃᎮᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᏣᏤᎵ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎠᎴᏃ ᎦᏬᏂᎯᏍᏙᏗ ᎨᏒᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏍᎩᎪᏩᏛᏓ ᎨᏒᎢ ᎾᎿᎢ ᎬᏙᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about your device privacy in the new Privacy dashboard in device settings.">
                <langSet xml:lang="en-US"><tig><term>Learn more about your device privacy in the new Privacy dashboard in device settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ ᏄᏰᎵᏛi ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏕᎵᏓ ᎾᎿᎢ ᎢᏤ ᎤᏕᎵᏓ ᎠᏝᏅᏗ ᎠᏯᏔᎾᎸ ᎾᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Click to switch pen typesIn Coloring book you can switch between your current and last used pen styles by single clicking the stylus button.">
                <langSet xml:lang="en-US"><tig><term>Click to switch pen typesIn Coloring book you can switch between your current and last used pen styles by single clicking the stylus button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᏗᎪᏪᎶᏗ ᎢᏧᏍᏗᎾᎿ Coloring book ᏃᏊ ᏥᎩ ᎠᎴ ᎣᏂ ᎬᏔᏅᎯ ᏗᎪᏪᎶᏗ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎦᏁᏟᏴᏍᏗ ᎠᏰᎵ ᏂᎯ ᏰᎵᏊ ᏌᏊᎢᏳᎪᏗ ᎠᏐᏅᏍᏗᏍᎩ ᏂᏚᏍᏛ ᎠᏐᏅᏍᏙᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Widget">
                <langSet xml:lang="en-US"><tig><term>Widget</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏥᏘ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically add newly installed apps to home screen">
                <langSet xml:lang="en-US"><tig><term>Automatically add newly installed apps to home screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎧᏁᏉᏍᏗ ᎾᏞᎬᏭᏃ ᎦᏘᏅᏔᏅ ᏗᎬᏙᏗ ᎾᎿᎢ ᏧᏪᏅᏒ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now we need location services so we can check your stylus stays.">
                <langSet xml:lang="en-US"><tig><term>Now we need location services so we can check your stylus stays.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎠᏴ ᎤᏚᎸᏓ ᎢᎬᎾᏕᎾ ᎢᏗᏓᏛᏁᏗ ᏓᏛ ᎠᏴ ᏰᎵᏊ ᎪᎯᏳᏔᏅ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎡᏙᎮᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your bluetooth is already on.">
                <langSet xml:lang="en-US"><tig><term>Your bluetooth is already on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ bluetooth ᎤᎾᎢ ᎦᏳᎳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To activate your stylus, we need Bluetooth and location services enabled.">
                <langSet xml:lang="en-US"><tig><term>To activate your stylus, we need Bluetooth and location services enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ,  ᎠᏴ ᎤᏚᎸᏓ Bluetooth ᎠᎴ ᎢᎬᎾᏕᎾ ᎢᏗᏓᏛᏁᏗ ᎠᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Put the stylus in the folio and keep Bluetooth on during the update">
                <langSet xml:lang="en-US"><tig><term>Put the stylus in the folio and keep Bluetooth on during the update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᎦ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎾᎿ folio ᎠᎴ ᏣᎮᏍᏗ Bluetooth ᎤᎾᎢ ᎾᎯᏳ ᏙᏢᎯᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="Add contacts to start using this feature">
                <langSet xml:lang="en-US"><tig><term>Add contacts to start using this feature</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᏗᏟᏃᎮᏙᏗ ᎾᎿᎢ ᎭᎴᎾ ᎬᏗᏍᎬ ᎠᎦᏎᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch and hold Back key to unpin.">
                <langSet xml:lang="en-US"><tig><term>Touch and hold Back key to unpin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᎠᏨᏍᏗ ᏍᏚᎢᏍᏗ ᎾᎿᎢ ᎥᏝ ᎦᎭᏛᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery temperature is too low,your device will be shut down.">
                <langSet xml:lang="en-US"><tig><term>Battery temperature is too low,your device will be shut down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏄᎦᎾᏮᎢ ᎠᏎᎯᎯ ᎾᏍᏉ ᎡᎳᏗ,ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎨᏎᏍᏗ ᏍᏓᏱᏍᏚᎲᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To make a call to contact, Ready For needs permission of reading contact and phone call">
                <langSet xml:lang="en-US"><tig><term>To make a call to contact, Ready For needs permission of reading contact and phone call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᏗ ᏪᏯᎾ ᎾᎿᎢ ᎠᏟᏃᎮᏙᏗ, Ready For ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿ ᎠᎪᎵᏰᏗ ᎠᏟᏃᎮᏙᏗ ᎠᎴ ᏗᎳᏃᎮᏗ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can manage them in contact management screen.">
                <langSet xml:lang="en-US"><tig><term>You can manage them in contact management screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏇ ᎠᏱᎸᏍᏗ ᎾᎿ ᎠᏟᏃᎮᏙᏗ ᎠᏓᏅᏖᎵᏙᎲ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Some contact can't be found.">
                <langSet xml:lang="en-US"><tig><term>Some contact can't be found.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᎠᏟᏃᎮᏙᏗ ᏝᏰᎵ ᎨᏒᎢ ᎠᏩᏛᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Motorola Experience Hub needs mobile data when Wi-Fi isn't available.">
                <langSet xml:lang="en-US"><tig><term>Motorola Experience Hub needs mobile data when Wi-Fi isn't available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Motorola Experience Hub ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎢᏳᏃ Wi-Fi ᏝᏰᏃ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sidebar shortcuts">
                <langSet xml:lang="en-US"><tig><term>Sidebar shortcuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᏍᏆᎳ ᎢᏗᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can open the sidebar using:-Mouse: -Keyboard: Press {W} + T-Ready For Air Remote: Press {M} -Game controller: Press L1 + R1 + Select">
                <langSet xml:lang="en-US"><tig><term>You can open the sidebar using:-Mouse: -Keyboard: Press {W} + T-Ready For Air Remote: Press {M} -Game controller: Press L1 + R1 + Select</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎡᎵᏊ ᏱᏍᏚᎢ Ꮎ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎲᏗᏍᎬ:-ᎢᏗᎬᏁᏗ: -ᎭᏐᎥᏍᏓ {W} + T-Ready For Air Remote: ᎭᏐᎥᏍᏓ {M} -ᏗᏁᎸᏙᏗ ᎦᏁᏟᏴᏍᏗ: ᎭᏐᎥᏍᏓ L1 + R1 + ᎠᏑᏰᎩᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Will make a call to this contact.">
                <langSet xml:lang="en-US"><tig><term>Will make a call to this contact.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎢ ᎪᏢᏗ ᏪᏯᎾ ᎾᎿᎢ ᎠᏟᏃᎮᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call this contact?">
                <langSet xml:lang="en-US"><tig><term>Call this contact?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎠᏟᏃᎮᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="-Fresh, easy-to-use dashboard-New ways to open the sidebar-Mute/unmute video calls from the sidebar-Blur background in video calls">
                <langSet xml:lang="en-US"><tig><term>-Fresh, easy-to-use dashboard-New ways to open the sidebar-Mute/unmute video calls from the sidebar-Blur background in video calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>-ᎢᏤᎢ, ᎠᎯᏓ-ᎾᎿᎢ-ᎬᏙᏗ ᎠᏝᏅᏗ ᏯᏖᎾ-ᎢᏤ ᏱᏗᎬᏁᏗ ᎾᎿᎢ ᎯᏍᏚᎢ ᎤᏟᏗᏢ ᎪᏪᎸᎢ-ᎤᏩᎨᏫ/ᎡᏝᏪ ᏱᎬᏕᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎾᏍᎩᎾ ᎤᏟᏗᏢ ᎪᏪᎸᎢ-ᎤᏍᎪᎸ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎾᎿ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For couldn't send the files">
                <langSet xml:lang="en-US"><tig><term>Ready For couldn't send the files</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ready For ᎥᏝ ᏰᎵᎢ ᏫᎦᏅᏗ ᏗᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to access video call effects">
                <langSet xml:lang="en-US"><tig><term>Tap to access video call effects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿᎢ ᎬᏴᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᏄᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="While you're in a video call, you can tap on the toolkit bubble to access effects.">
                <langSet xml:lang="en-US"><tig><term>While you're in a video call, you can tap on the toolkit bubble to access effects.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏏᏉ ᎾᎿ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ, ᏂᎯ ᏰᎵᏇ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎬᏔᏂᏓᏍᏗ ᏧᏓᎴᏅᏛ ᏓᎵᏆᎷᎲᏍᎬ ᎾᎿᎢ ᎬᏴᏍᏗ ᏄᎵᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select video effects">
                <langSet xml:lang="en-US"><tig><term>Select video effects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏄᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Settings menu">
                <langSet xml:lang="en-US"><tig><term>Settings menu</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᏓᎵᏆᎷᎲᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use video effects during video calls">
                <langSet xml:lang="en-US"><tig><term>Use video effects during video calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏄᎵᏍᏔᏅ ᎾᎯᏳ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can tap on different effects to select or change them.">
                <langSet xml:lang="en-US"><tig><term>You can tap on different effects to select or change them.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᎯ ᏰᎵᏇ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎬᏔᏂᏓᏍᏗ ᏧᏓᎴᎿᎢ ᏄᎵᏍᏔᏅ ᎾᎿᎢ ᎠᏑᏰᏍᏗ ᎠᎴ ᎯᏁᏟᏴᎾ ᎢᏯᏂᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Or, you can long press on an effect to access more settings.">
                <langSet xml:lang="en-US"><tig><term>Or, you can long press on an effect to access more settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴ,  ᏂᎯ ᏰᎵᏇ ᎢᎪᎯᏓ ᎭᏐᏅᏍᏓ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎾᎿᎢ ᎬᏴᏍᏗ ᎤᏟ ᎢᎦᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you're in a video call you can enhance your experience with effects like background blur, subject tracking, and more">
                <langSet xml:lang="en-US"><tig><term>When you're in a video call you can enhance your experience with effects like background blur, subject tracking, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᎾᎿ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᏂᎯ ᏰᎵᏇ ᏓᏤᏞᏍᏗ ᏣᏤᎵ ᏄᎵᏍᏔᏂᏙᎸᎢ ᎬᏗ ᏄᎵᏍᏔᏅ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎤᏍᎪᎸ, ᎧᏃᎮᏗ ᎪᎷᏁᎩ, ᎠᎴ ᎤᏟ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Video effect toolkit">
                <langSet xml:lang="en-US"><tig><term>Video effect toolkit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏄᎵᏍᏔᏅ </term></tig></langSet>
            </termEntry>
            <termEntry id="Film">
                <langSet xml:lang="en-US"><tig><term>Film</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎵᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to send emails.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to send emails.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᏫᏅᎥᎦ ᏗᎾᎦᎵᏍᎩ ᎪᏪᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Using WiFi Calling is rated according to the service rates provided by your mobile operator.Details on www.orange.pl/wificallingPlease note that calls to Emergency Numbers eg. 122 will be routed through a mobile network.">
                <langSet xml:lang="en-US"><tig><term>Using WiFi Calling is rated according to the service rates provided by your mobile operator.Details on www.orange.pl/wificallingPlease note that calls to Emergency Numbers eg. 122 will be routed through a mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᎭ WiFi Calling ᎠᏟᎶᏓ ᏂᎬᏅ ᎾᎿᎢ ᎢᏯᏓᏛᏁᏗ ᏗᎪᏣᎴᏒᏛ ᎠᏛᏅᎢᏍᏛ ᎬᏗ ᎠᏂᎩᏍᎩ ᎠᎯᎵᏙᎯ.ᏧᏍᏗᎩᏓ ᎤᎾᎢ www.orange.pl/wificallingᎰᏩᏊ ᎠᏓᏅᏓᏗᏍᏙᏗ ᎾᎿᎢ Emergency Numbers eg. 122 ᏰᎵᏉ ᎨᏎᏍᏗ ᎦᎶᎯᏍᏗ ᏭᎵᏍᏗ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Detailed description of your WiFi Calling service could be found at www.orange.pl/wificallingPlease note that in order to enable routing of your emergency calls (eg. such as 112 calls) to the closest emergency centre , suitable for your actual location, your emergency calls in the WiFi Calling services will be carried by your device through any mobile network available at a given moment Only in the cases where no mobile network is available an emergency call will be routed via WiFi Calling service.">
                <langSet xml:lang="en-US"><tig><term>Detailed description of your WiFi Calling service could be found at www.orange.pl/wificallingPlease note that in order to enable routing of your emergency calls (eg. such as 112 calls) to the closest emergency centre , suitable for your actual location, your emergency calls in the WiFi Calling services will be carried by your device through any mobile network available at a given moment Only in the cases where no mobile network is available an emergency call will be routed via WiFi Calling service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏪᎳᏅ ᏗᏍᏆᏂᎪᏛᎾ Ꮎ WiFi ᏫᏘᏯᏂᏘ ᎢᏯᏛᏁᏗ ᏱᏕᎯᏩᏛ www.orange.pl/wificallingᏣᏅᏖᏍᏗ ᏱᏣᏚᎵ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᏭᎶᎯᏍᏗ Ꮎ ᎤᏟᏍᏗ ᏩᏴᏅᏗ (eg. Ꮎ ᏍᏈᏍᏗ ᏫᏘᏯᏅᏗ 112 calls) ᎾᎥᏂᎨᎢ ᎤᏟᏍᏗ ᎠᏓᏁᎸ, ᎾᎥ ᎠᎾ ᎮᏙᎲ, ᎤᏟᏍᏗ ᏫᏘᏴᏂᎲ Ꮎ WiFi ᏩᏴᏅᏗ ᎢᏯᏛᏁᏗ ᏕᎪᏪᎴᏍᏗ Ꮎ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎢᏳᏍᏚᏩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏰᎵ ᎠᏩᏛᏗ ᏍᏊ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏂᎬᏅᎾ ᏱᎩ ᎾᏊ WiFi ᏫᏘᏯᏂᏘ ᎢᏯᏅᏛᏁ ᎨᏍᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please read the description of the service provided by your operator: WiFi Calling service enables you to make and receive voice calls over any WiFi internet connection, even in a situation where you are outside any mobile network’s coverage.">
                <langSet xml:lang="en-US"><tig><term>Please read the description of the service provided by your operator: WiFi Calling service enables you to make and receive voice calls over any WiFi internet connection, even in a situation where you are outside any mobile network’s coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎪᎵᏰᎥᎢ Ꮎ ᏄᏍᏛ ᎠᎯᎵᏙᎯ ᎠᏛᏅᎢᏍᏔᏅ ᏂᎯ ᏣᏤᎵ ᎠᏂᎩᏍᎩ: WiFi ᎫᏓᎸᏗᏍᎩ ᎢᏯᏛᏁᏗᎢ ᎡᎵᏊ ᏳᎵᏍᏙᏗ ᏫᏘᏯᏅᏗ ᎠᎴ ᎦᏁᏍᏗ ᎧᏁᎬ WiFi ᎠᏏᎳᏕᏫᏢᎢ ᏚᏚᏓᎸᎢ, ᏍᏊᏂᏯᎥᎾᏱᎩ ᎤᎾᎢ ᏙᏯᏗᏜ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎫᏝᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We will process these data for the duration of the agreement on providing telecommunication services between you and us, and after its termination - for the period of recovery of claims and of performing other tasks defined in the provisions of law.">
                <langSet xml:lang="en-US"><tig><term>We will process these data for the duration of the agreement on providing telecommunication services between you and us, and after its termination - for the period of recovery of claims and of performing other tasks defined in the provisions of law.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎾᎯᎴᏏ ᎦᏟᏌᏅ ᎢᏱᎪᎯᏛ ᏕᏨᏓᏁᏤᎸᎢ Ꮎ ᎠᏓᏁᎳᏅ ᎢᎾ ᏫᏓᏝᏃᎮᏗ ᎢᏳᏅᏛᏁᏗ ᎠᏯ ᎠᎴ ᏂᎯ, ᎠᎵᏍᏋᏛ-ᎢᏱᎪᎯᏛ ᎠᏟᎢᏱᎵᏙᎸ ᎠᎩᎩᏍᏗ ᎠᎴ ᏕᎦᏓᏁᏤᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Or, you can long press on an effect to access more settings.">
                <langSet xml:lang="en-US"><tig><term>Or, you can long press on an effect to access more settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏃ, ᏂᎯ ᏰᎵᏊ ᎦᏅᎯᏓ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎾᏍᎩ ᏂᏨᏁᎸ ᎾᎢ ᎠᏴᏍᏗ ᎤᏟ ᎢᎦᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can customize your video call experience">
                <langSet xml:lang="en-US"><tig><term>Now you can customize your video call experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎡᎵ ᏂᎯ ᏰᎵᏊ ᏯᏑᎯᏍᏙᏓ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅᎢ ᎠᎦᏙᎲᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="While you're in a video call, you can tap on the toolkit bubble to access effects.">
                <langSet xml:lang="en-US"><tig><term>While you're in a video call, you can tap on the toolkit bubble to access effects.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯZ ᎾᏍᎩ ᎾᎿᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅᎢ, ᏂᎯ ᏰᎵᏊ ᏯᏐᎥᏍᏓ ᎤᎾᎢ ᎬᏔᏂᏓᏍᏗ ᏧᏓᎴᏅᏛ ᎠᎵᏆᎷᎲᏍᎬ ᎾᎢ ᎠᏴᏍᏗ ᏄᎵᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select video effects">
                <langSet xml:lang="en-US"><tig><term>Select video effects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏄᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose which applications can use video call effects">
                <langSet xml:lang="en-US"><tig><term>Choose which applications can use video call effects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᏔᏲᏍᏙᏗ ᏰᎵᏊ ᎬᏙᏓ ᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅᎢ ᏄᎵᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="While you're in a video call you can apply effects like background blur, subject tracking, and audio zoom to enhance your video call experience">
                <langSet xml:lang="en-US"><tig><term>While you're in a video call you can apply effects like background blur, subject tracking, and audio zoom to enhance your video call experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯZ ᎾᏍᎩ ᎾᎿᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅᎢ ᏂᎯ ᏰᎵᏊ ᎢᎬᏁᏗᎢ ᏄᎵᏍᏔᏅᎢ ᎤᏠᏱᏉ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎤᏍᎪᎸ, ᎧᏃᎮᏗ ᎪᎷᏅᏍᏗ, ᎠᎴ ᎤᏃᏴᎬ ᏧᎻ ᎾᎢ ᏓᏤᏞᏍᏗ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅᎢ ᎠᎦᏙᎲᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Within the manage apps page, you can choose which apps can use video call effects">
                <langSet xml:lang="en-US"><tig><term>Within the manage apps page, you can choose which apps can use video call effects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗᎭᏫᏂᏗᏢ ᎾᏍᎩ ᎠᏓᏅᏖᎵᏙᎯ ᏗᎬᏙᏗ ᎤᎦᏅᏓᏛ, hᎯ ᏣᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᎬᏙᏗ ᏰᎵᏊ ᎬᏙᏓ ᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅᎢ ᏄᎵᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can tap on different effects to select or change them.">
                <langSet xml:lang="en-US"><tig><term>You can tap on different effects to select or change them.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᏧᏓᎴᎾᎢ ᏄᎵᏍᏔᏅ ᎾᎢ ᎠᏑᏰᏍᏗ ᎠᎴᏃ ᎦᏁᏟᏴᏍᏗ ᏂᎬᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video effect toolkit">
                <langSet xml:lang="en-US"><tig><term>Video effect toolkit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏂᏨᏁᎸ ᎬᏔᏂᏓᏍᏗ ᏧᏓᎴᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Error code: 8X">
                <langSet xml:lang="en-US"><tig><term>Error code: 8X</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 8X</term></tig></langSet>
            </termEntry>
            <termEntry id="Try after  minutes.">
                <langSet xml:lang="en-US"><tig><term>Try after  minutes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᎤᎶᏐᏅ  ᎢᏯᏔᏬᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Configuring you phone...">
                <langSet xml:lang="en-US"><tig><term>Configuring you phone...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᎵᏍᏙᏗ ᎨᏒ ᏅᎦ ᏣᏤᎵ ᏗᎳᏃᎮᏗ...</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎾᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera, even when the flip is closed">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera, even when the flip is closed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎠᏍᏚᎢᏓ ᏥᎩ ᏗᏓᏟᎶᏍᏗᏍᎩ, ᎥᏍᏊ ᎢᏳᏃ ᏥᎩ ᏓᏁᏍᏆᏕᎦ ᎠᏍᏚᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="One Button Nav">
                <langSet xml:lang="en-US"><tig><term>One Button Nav</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊ ᎠᏐᎥᏍᏙᏗ ᎠᏱᎴᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="People also say the motion is like revving a motorcycle or turning a screwdriver">
                <langSet xml:lang="en-US"><tig><term>People also say the motion is like revving a motorcycle or turning a screwdriver</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏴᏫ ᎾᏍᏊ ᎠᎾᏗᏍᎩ ᎠᏓᏅᏏᏙᎲᎢ ᎤᏠᏱ ᎠᏥᎳ ᎠᏂᎩᏍᏗᏍᎩ ᎢᎦᏣᏄᎳ ᎠᎴ ᎦᏚᎸᏕᏲᎲ ᎾᏍᎩ ᎦᎭᏗ ᏗᎦᏚᎸᏑᏯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Media controls">
                <langSet xml:lang="en-US"><tig><term>Media controls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏗ ᎠᏗᎦᎴᏯᏍᏗ ᏗᎯᎸᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist to launch the camera">
                <langSet xml:lang="en-US"><tig><term>Twist to launch the camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎸ ᎾᎢ ᎭᏂᎩᏍᏙᏗ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip for DND vibrations">
                <langSet xml:lang="en-US"><tig><term>Flip for DND vibrations</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᏍᏆᏗᏅᏓ ᎾᏍᎩᎾ DND ᎠᎵᏖᎸᎲᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose now">
                <langSet xml:lang="en-US"><tig><term>Choose now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏃᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip for DND">
                <langSet xml:lang="en-US"><tig><term>Flip for DND</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᏍᏆᏗᏅᏓ ᎾᏍᎩᎾ DND</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick capture">
                <langSet xml:lang="en-US"><tig><term>Quick capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎦᏂᏱᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="New Dolby Audio provides you a landscape stereo. Rotate your phone and try it.To create your own profile, you can use custom profile to adjust equalizer, audio effect, etc.">
                <langSet xml:lang="en-US"><tig><term>New Dolby Audio provides you a landscape stereo. Rotate your phone and try it.To create your own profile, you can use custom profile to adjust equalizer, audio effect, etc.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏤ Dolby Audio ᏓᎾᏓᏁᏢᏍᎬ ᏂᎯ ᎦᏅᎯᏒᎢ ᏗᎦᏃᎩᏍᏙᏗ. ᎯᏗᏆᎸᏕᏯᎦ ᏂᎯᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ ᎭᏁᎵᏓ.ᏦᏢᏗ ᏂᎯᏣᏤᎵ ᏤᏣᏟᎶᏍᏔᏅ, ᏂᎯ ᎡᎵᏊ ᏄᏍᏛ ᎢᏯᏛᏁᏗ ᏌᏆᎦᏘ ᎠᏍᏓᏩᏛᏍᏗ ᎥᎾᎢ ᎣᏍᏛ ᎢᎬᏁᏗ ᎢᏗᎦᏘᎭ ᎢᎬᏁᎯ, ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ, etc.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can create custom profiles for Bluetooth and USB-C audiodevices.Each time you connect a device, Dolby Audio will remember the last settings you used.">
                <langSet xml:lang="en-US"><tig><term>You can create custom profiles for Bluetooth and USB-C audiodevices.Each time you connect a device, Dolby Audio will remember the last settings you used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎡᎵᏊ ᎪᏢᏗ ᏄᏍᏛ ᎢᏯᏛᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎬᏩᏟ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎠᎴ USB-C ᏚᏃᏴᎬᏥᏂᏕᎬᏅᏗᏓᎾ.ᏂᏓᏟᏱᎵᏒᎢ ᏂᎯ ᎱᏓᎸᏍᎬᎢ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ, Dolby Audio ᎠᏎ ᏛᏓᏗᏍᏔᎾ ᎾᏍᎩ ᎣᏂ ᏕᎦᎧᎲᎢ ᏂᎯ ᏨᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Current Wi-Fi network can\’t coexist with cast screen connection.">
                <langSet xml:lang="en-US"><tig><term>Current Wi-Fi network can\’t coexist with cast screen connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ Wi-Fi ᏧᎾᏚᏓᎵ ᏝᏰᎵ ᏔᎵ ᎡᎲᎢ ᎬᏗ ᏩᏗᏅᏗ ᎠᏴᏙᎳᏛᎢ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your earphones are not compatible with the Phone.Please try another ones">
                <langSet xml:lang="en-US"><tig><term>Your earphones are not compatible with the Phone.Please try another ones</term></tig></langSet>
