                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᎠᏎ Ꮭ ᎦᏅᎯᏓᎨ ᎨᏒᎩ ᏗᎵᎪᏙᏗ ᎬᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will no longer be paired with ">
                <langSet xml:lang="en-US"><tig><term>Your phone will no longer be paired with </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ Ꮭ ᎦᏅᎯᏓᎨ ᎨᏒᎩ ᏗᎵᎪᏙᏗ ᎬᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="You can change this in LINK_BEGINscanning settingsLINK_END.">
                <langSet xml:lang="en-US"><tig><term>You can change this in LINK_BEGINscanning settingsLINK_END.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᎯᎠ ᎾᎿ LINK_BEGINᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᏕᎦᎧᎲᎢLINK_END.</term></tig></langSet>
            </termEntry>
            <termEntry id="To improve location accuracy, system apps and services can still detect Bluetooth devices.">
                <langSet xml:lang="en-US"><tig><term>To improve location accuracy, system apps and services can still detect Bluetooth devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ ᎤᏓᏐᏍᏗ, ᏄᏍᏗᏓᏅᎢ ᏗᎬᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏰᎵᏊ ᏙᎢ ᏯᏕᎳᎰᏌ Bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
