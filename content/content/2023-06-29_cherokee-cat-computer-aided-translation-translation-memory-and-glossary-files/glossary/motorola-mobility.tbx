                <langSet xml:lang="chr"><tig><term>ᎯᏃᏴᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Let Storage manager automatically free up space by removing backed up content from your device?">
                <langSet xml:lang="en-US"><tig><term>Let Storage manager automatically free up space by removing backed up content from your device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏂᎩ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏓᏅᏖᎵᏓᏍᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏚᏓᎴᎩ ᎤᏜᏅᏛ ᎬᏗ ᏂᎬᏅᏕᏍᎬᎢ ᎠᏨᏍᏗ ᎦᎸᎳᏗ ᏄᏍᏗᏓᏅ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
