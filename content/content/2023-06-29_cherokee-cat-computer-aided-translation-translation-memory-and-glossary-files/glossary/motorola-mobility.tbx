                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 87.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 87.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 87</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 29.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 29.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 29</term></tig></langSet>
            </termEntry>
            <termEntry id="Control behavior &amp; exceptions">
