            </termEntry>
            <termEntry id="This file will be available within  after you start using it.">
                <langSet xml:lang="en-US"><tig><term>This file will be available within  after you start using it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏫᏂᏗᏢ  ᎤᎶᏐᏅ ᏂᎯ ᎠᏂᎩᏍᏙᏗ ᎬᏗᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use the number, first turn off Airplane mode.">
                <langSet xml:lang="en-US"><tig><term>To use the number, first turn off Airplane mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏙᏗ ᎠᏎᏍᏗ, ᎢᎬᏱᏱ ᎠᏍᏚᏗ ᏥᏳ ᏄᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM off">
                <langSet xml:lang="en-US"><tig><term>SIM off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᏱᎬᏕᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use the number, first turn off Airplane mode and turn the SIM on.">
                <langSet xml:lang="en-US"><tig><term>To use the number, first turn off Airplane mode and turn the SIM on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏙᏗ ᎠᏎᏍᏗ, ᎢᎬᏱᏱ ᎠᏍᏚᏗ ᏥᏳ ᏄᏍᏛᎢ ᎠᎴ ᎯᏍᏚᎢ SIM.</term></tig></langSet>
            </termEntry>
            <termEntry id="UIM off">
                <langSet xml:lang="en-US"><tig><term>UIM off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>UIM ᏱᎬᏕᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It will open the browser, continue?">
                <langSet xml:lang="en-US"><tig><term>It will open the browser, continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏎ ᎯᏍᏚᎢ ᎠᏍᏚᎢᏍᎩ, ᎬᎵᏱᎵᏒ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Please release some storage or change the default write disk in the settings.">
                <langSet xml:lang="en-US"><tig><term>Please release some storage or change the default write disk in the settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏘᏲᎯ ᎢᎦᏓ ᎠᏍᏆᏂᎪᏙᏗ ᎠᎴ ᎯᏁᏟᏴᎾ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎪᏪᎶᏗ ᎠᏠᏗ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dataprotection">
                <langSet xml:lang="en-US"><tig><term>Dataprotection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dataprotection</term></tig></langSet>
            </termEntry>
            <termEntry id="Please release some storage or insert a SD card.">
                <langSet xml:lang="en-US"><tig><term>Please release some storage or insert a SD card.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏘᏲᎯ ᎢᎦᏓ ᎠᏍᏆᏂᎪᏙ ᎠᎴ ᎰᏣᎸᎥᎦ SD ᏆᎾᏲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The SD card does not have enough space.">
                <langSet xml:lang="en-US"><tig><term>The SD card does not have enough space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SD ᏆᎾᏲᏍᏗ ᎥᏝ ᎤᎭ ᏰᎵᏊ ᎤᏜᏅᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network Rejection Cause">
                <langSet xml:lang="en-US"><tig><term>Network Rejection Cause</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᏓᎵ ᎠᎦᏓᏯᎸᎩ ᏅᏓᎦᎵᏍᏙᏗᏍᎬᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bandwidth is set">
                <langSet xml:lang="en-US"><tig><term>Bandwidth is set</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏯᏛᎢᏴ ᎠᏓᏠᏍᏗ ᏗᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Slide right to dismiss">
                <langSet xml:lang="en-US"><tig><term>Slide right to dismiss</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᏢᏗᎭ ᎠᏍᏆᎨᏂ ᎾᎿᎢ ᎠᏲᎯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Slide down to snooze">
                <langSet xml:lang="en-US"><tig><term>Slide down to snooze</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᏢᏗᎭ ᎡᎳᏗ ᎾᎿᎢ ᎦᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press on Color to apply">
                <langSet xml:lang="en-US"><tig><term>Press on Color to apply</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎤᎾᎢ ᎠᏑᏫᏓ ᎾᎿᎢ ᎲᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless display will be turned off when you turn on HDMI.">
                <langSet xml:lang="en-US"><tig><term>Wireless display will be turned off when you turn on HDMI.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᏍᏚᏅᎢ ᎢᏳᏃ ᎯᏍᏚᎢ HDMI.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unstable connection">
                <langSet xml:lang="en-US"><tig><term>Unstable connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎷᎶᎩ ᏕᎫᎪᏛᎢ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="The current connection of wireless display is not steady.">
                <langSet xml:lang="en-US"><tig><term>The current connection of wireless display is not steady.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ ᎫᏓᎸᎢ ᎾᎿ ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎥᏝ ᎠᎵᏏᎾᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The current connection of wireless display is not steady, please try to get closer to your display device.">
                <langSet xml:lang="en-US"><tig><term>The current connection of wireless display is not steady, please try to get closer to your display device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ ᎫᏓᎸᎢ ᎾᎿ ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎥᏝ ᎠᎵᏏᎾᎯᏍᏗ, ᎰᏩᏊ ᎭᏁᎵᏓ ᎾᎿᎢ ᎠᎩᏍᏗᏱ ᎾᎥᏂᎨᏍᏗ ᎾᎿᎢ ᎠᏓᏴᎳᏔᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless display disconnect.">
                <langSet xml:lang="en-US"><tig><term>Wireless display disconnect.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎱᏓᎳᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to reconnect?">
                <langSet xml:lang="en-US"><tig><term>Do you want to reconnect?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᏙᎫᏓᎸᎲᏍᎩ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Current Wi-Fi Direct connection will be disconnected when you connect to the wireless display device.">
                <langSet xml:lang="en-US"><tig><term>Current Wi-Fi Direct connection will be disconnected when you connect to the wireless display device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ Wi-Fi Direct ᎫᏓᎸᎢ ᏰᎵᏉ ᎨᏎᏍᏗ ᎫᏓᎴᏓᏃ ᎢᏳᏃ ᎫᏓᎸᎢ ᎾᎿᎢ ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless display disconnected.">
                <langSet xml:lang="en-US"><tig><term>Wireless display disconnected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎫᏓᎴᏓᏃ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again in a few minutes.">
                <langSet xml:lang="en-US"><tig><term>Please try again in a few minutes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏏᏊ ᏥᎭᏁᎵᏓ ᎾᎿᎢ ᎢᎸᏍᎩᏉ ᎢᏯᏔᏬᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless display and Wi-Fi are turned on.">
                <langSet xml:lang="en-US"><tig><term>Wireless display and Wi-Fi are turned on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎠᎴ Wi-Fi ᎠᏍᏚᎢᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Change resolution will reconnect wireless display automatically.">
                <langSet xml:lang="en-US"><tig><term>Change resolution will reconnect wireless display automatically.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏁᏟᏴᎾ ᏫᏓᏤᎸ ᎤᏓᏴᎳᏛ ᎠᏎ ᏙᎫᏓᎸᎲᏍᎩ ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎤᏩᏌᏊ ᏱᎬᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not remind again.">
                <langSet xml:lang="en-US"><tig><term>Do not remind again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᎠᏓᏅᏓᏗᏍᏙᏗ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Current Wi-Fi AP may affect the quality of Wireless display.">
                <langSet xml:lang="en-US"><tig><term>Current Wi-Fi AP may affect the quality of Wireless display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ Wi-Fi AP ᏰᎵᏉ ᎠᏓᏕᏯᏙᏗ ᏂᏓᏏᎳᏛ ᎠᏓᏴᎳᏔᏍᎩ ᎢᏲᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for connection invitations from other devices.">
                <langSet xml:lang="en-US"><tig><term>Waiting for connection invitations from other devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏯ ᎾᏍᎩᎾ ᎫᏓᎸᎢ ᏓᎾᏓᏯᏂᏍᎬ ᎾᏍᎩᎾ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi network  disconnected.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi network  disconnected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏧᎾᏚᏓᎵ  ᎫᏓᎴᏓᏃ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Channel confliction">
                <langSet xml:lang="en-US"><tig><term>Channel confliction</term></tig></langSet>
