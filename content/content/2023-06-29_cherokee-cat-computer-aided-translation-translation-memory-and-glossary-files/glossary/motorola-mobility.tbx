            </termEntry>
            <termEntry id="Connecting to Unsecure Wi-Fi">
                <langSet xml:lang="en-US"><tig><term>Connecting to Unsecure Wi-Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏚᏛᎸᎥᎦ ᎤᏰᎯᏍᏛᎾ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps may need to restart before the change takes effect.">
                <langSet xml:lang="en-US"><tig><term>Apps may need to restart before the change takes effect.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᏥᏙᎭᏂᎩᏍᏓ Ꮟ ᏂᏗᏣᏁᏟᏴᏒᎾ ᎠᎴᏂᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off my mobile data connection when I've used this amount of mobile data:">
                <langSet xml:lang="en-US"><tig><term>Turn off my mobile data connection when I've used this amount of mobile data:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᏅ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎢ ᎫᏓᎸ ᎯᎠ ᎢᎦ ᎠᎬᏛᏅ ᎨᏍᏎᏍᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage is measured by your phone and may differ from what is shown on your bill.">
                <langSet xml:lang="en-US"><tig><term>Data usage is measured by your phone and may differ from what is shown on your bill.</term></tig></langSet>
