                <langSet xml:lang="chr"><tig><term>ᏙᎢ ᏣᏂᏴᏎᏍᏗ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎾᏍᎩᎾ ᏫᏓᏤᏢ ᏂᏧᎵᏍᏙᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Pick a color to highlight in your photo and turn everything else black &amp; white">
