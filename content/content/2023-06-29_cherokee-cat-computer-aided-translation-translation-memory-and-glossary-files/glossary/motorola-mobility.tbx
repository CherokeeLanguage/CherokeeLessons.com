            </termEntry>
            <termEntry id="Users have their own apps and content">
                <langSet xml:lang="en-US"><tig><term>Users have their own apps and content</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏅᏗᏍᎩ ᎤᏂᎭ ᎤᏅᏏ ᏧᎾᏤᎵ ᏗᎬᏙᏗ ᎠᎴ ᎦᎸᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can share this device with other people by creating additional users.">
                <langSet xml:lang="en-US"><tig><term>You can share this device with other people by creating additional users.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>YᏂᎯ ᏰᎵᏊ ᎠᏯᏙᎯᏍᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ ᎠᏂᏐᎢ ᎠᏂᏴᏫ Ꮕ ᏂᏚᏅᏅ ᎪᏢᏍᎬᎢ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏗᏅᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Users can also adjust device settings like Wi\u2011Fi that affect everyone.">
                <langSet xml:lang="en-US"><tig><term>Users can also adjust device settings like Wi\u2011Fi that affect everyone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏅᏗᏍᎩ ᏰᎵᏊ ᎾᏍᏉ ᎦᏁᏟᏴᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᏕᎦᎧᎲᎢ ᎢᏳᏍᏘ Wi\u2011Fi ᎾᏍᎩᎾᎢ ᎠᏕᏯᏙᏗ ᏂᎦᏗᏳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set up user now?">
                <langSet xml:lang="en-US"><tig><term>Set up user now?</term></tig></langSet>
