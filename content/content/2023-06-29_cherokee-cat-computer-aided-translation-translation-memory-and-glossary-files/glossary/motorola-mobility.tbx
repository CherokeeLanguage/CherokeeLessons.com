            <termEntry id="This can be used, for example, to improve location-based features and services.">
                <langSet xml:lang="en-US"><tig><term>This can be used, for example, to improve location-based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏟᎶᏍᏔᎾ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Broadcasting">
                <langSet xml:lang="en-US"><tig><term>Broadcasting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No application available to open the file">
                <langSet xml:lang="en-US"><tig><term>No application available to open the file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎬᏙᏗ ᎠᏛᏅᎢᏍᏔᏅ to ᎠᏍᏚᎢᏓ ᏥᎩ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow apps and services to scan for nearby devices at any time, even when Bluetooth is off.">
                <langSet xml:lang="en-US"><tig><term>Allow apps and services to scan for nearby devices at any time, even when Bluetooth is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏗᎬᏙᏗ and ᎢᏗᏛᏁᎵᏓᏍᏗ ᏰᎵᏯ ᏙᎢ ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᎤᎬᏩᏟ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ, ᎥᏍᏊ ᎢᏳᏃ Bluetooth ᏄᏍᏛ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use an accessibility feature, swipe up from the bottom of the screen with 3 fingers.">
                <langSet xml:lang="en-US"><tig><term>To use an accessibility feature, swipe up from the bottom of the screen with 3 fingers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎣ ᎤᏎ Ꭰn ᎠccᎡᏍᏏbᎢᎵty fᎡᎠtᎤrᎡ, ᏍᏫpᎡ Ꭴp frᎣm tᎮ bᎣttᎣm Ꭳf tᎮ ᏍcrᎡᎡn Ꮻth 3 fᎢnᎨrᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To switch between features, swipe up with 3 fingers and hold.">
                <langSet xml:lang="en-US"><tig><term>To switch between features, swipe up with 3 fingers and hold.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎣ ᏍᏫtch bᎡtᏪᎡn fᎡᎠtᎤrᎡᏍ, ᏍᏫpᎡ Ꭴp Ꮻth 3 fᎢnᎨrᏍ Ꭰnd Ꮀld.</term></tig></langSet>
            </termEntry>
            <termEntry id="Portuguese">
