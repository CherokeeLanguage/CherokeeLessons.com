                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏓ ᎯᎠ ᎠᏓᏴᎳᏛᏍᎩ ᎬᏗ Moto 360 ᏗᎦᎧᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Volume, vibration, Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>Volume, vibration, Do Not Disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎢ ᎤᏃᏴᎬ, ᎠᎵᏖᎸᎲᏍᎬ, ᏤᏍᏗ ᏥᎭᏓᏁᏙᏔᎾ</term></tig></langSet>
