                <langSet xml:lang="chr"><tig><term>ᏓᏤᏢᎢ ᏗᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Location permission is not granted for Ready For app. To make sure Ready For can connect nearby device, turn it on.">
                <langSet xml:lang="en-US"><tig><term>Location permission is not granted for Ready For app. To make sure Ready For can connect nearby device, turn it on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᏢᏒᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎨᎡᎢ ᎥᏝ ᎤᎵᏍᎪᎸᏔᏅ ᎤᎬᏩᏟ Ready For ᎬᏙᏗ. ᎾᎿᎢ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ Ready For ᏰᎵᏯ ᎫᏓᎸᎢ ᎭᏫᏂ ᏥᏂᎬᏅᏗᏓᎾ ᎯᏍᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Finger removed too fast from fingerprint sensor.">
                <langSet xml:lang="en-US"><tig><term>Finger removed too fast from fingerprint sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛ ᎠᎲᏍᏓ ᎾᏍᏉ ᎦᏣᏄᎵ ᏅᏓᏳᏓᎴᏅᎯ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
