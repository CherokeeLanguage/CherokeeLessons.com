                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t add device">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t add device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ\u2019 ᏯᎯᏁᏉᏍᏓ ᏥᏂᎬᏅᏗᏓᏂ</term></tig></langSet>
