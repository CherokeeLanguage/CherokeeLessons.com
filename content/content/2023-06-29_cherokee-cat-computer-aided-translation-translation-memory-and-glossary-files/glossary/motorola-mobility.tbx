                <langSet xml:lang="chr"><tig><term>1 ᎬᏙᏗ ᎠᎵᏍᎪᎸᏔᏅ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗᏯ ᎨᏍᏗ ᎦᏅᏍᏙᏒᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎢᏳᏃ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎵᏏᏅᏗᏍᎩ ᎨᎡᎩ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Share tablet\u2019s internet connection via Bluetooth">
                <langSet xml:lang="en-US"><tig><term>Share tablet\u2019s internet connection via Bluetooth</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᏍᏗᎢ ᏗᎪᏪᎶᏗᎢ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎢᏗᏨ Bluetooth</term></tig></langSet>
            </termEntry>
            <termEntry id="The assistant will be able to read information about apps in use on your system, including information visible on your screen or accessible within the apps.">
                <langSet xml:lang="en-US"><tig><term>The assistant will be able to read information about apps in use on your system, including information visible on your screen or accessible within the apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᎵᏍᏕᎵᏍᎩ ᎨᏎᏍᏗ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᎪᎵᏰᎥᏍᎩ ᏄᏰᎵᏛ ᏗᎬᏙᏗ ᎾᎿ ᎬᏙᏓ ᎾᎿ ᏣᏤᎵ ᏄᏍᏗᏓᏅᎢ, ᎤᏠᏯᏍᏗ ᎧᏃᎮᏢᎥᏍᎩ ᎬᎪᏩᏛᏗ ᎾᎿ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᎠᎴᏃ ᏅᏛᏴᏍᏙᏗᎢ ᎠᏫᏂᏗᏢ ᎾᏍᎩ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Downloaded SIMs can\u2019t be erased due to an error.Restart your device and try again.">
                <langSet xml:lang="en-US"><tig><term>Downloaded SIMs can\u2019t be erased due to an error.Restart your device and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ SIMs ᎨᏍᏗ ᏰᎵ\u2019 ᎨᏒᎩ ᏛᏍᏍᎪᎸᏥ ᏂᎨᏒ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᏓᏓᎴᎬᎢ.ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
