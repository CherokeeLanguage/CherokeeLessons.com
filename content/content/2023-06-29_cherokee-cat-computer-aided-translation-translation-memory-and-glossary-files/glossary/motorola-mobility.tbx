            </termEntry>
            <termEntry id="Remove selected participant from group?">
                <langSet xml:lang="en-US"><tig><term>Remove selected participant from group?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᎾᏕᏍᏗ ᎠᏑᏰᏒᎢ ᎠᏖᎳᏗᏙᎯ ᏅᏓᏳᏓᎴᏅᎯ ᎤᎾᏓᏡᎬᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="One or more of the included participants are not Advanced Messaging capable*. Tap Yes to create a new group conversation with these recipients. \*Advanced Messaging capable contacts are shown with a blue dot.">
                <langSet xml:lang="en-US"><tig><term>One or more of the included participants are not Advanced Messaging capable*. Tap Yes to create a new group conversation with these recipients. \*Advanced Messaging capable contacts are shown with a blue dot.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊ ᎠᎴ ᎤᏟ ᎢᎦᎢ ᎠᏂ ᎠᏠᏯᏍᏔᏅ ᏗᏁᎳᏗᏙᎯ ᎨᏒᎩ Ꮭ Advanced Messaging ᏰᎵᏉ ᎢᎬᏁᏗ*. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ii ᎾᎿᎢ ᎪᏢᏗ Ꭰ ᏗᏤ ᎤᎾᏓᏡᎬᎢ ᏗᏟᏃᎮᏗ ᎬᏗ ᎯᎠᏃ ᏗᏂᏁᏍᎩ. Advanced Messaging ᏰᎵᏉ ᎢᎬᏁᏗ ᏗᏟᏃᎮᏙᏗ ᎨᏒᎩ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎬᏗ Ꭰ ᏌᎭᏂ ᎤᏓᏓᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Big screen gaming">
                <langSet xml:lang="en-US"><tig><term>Big screen gaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏔᎾ ᎠᏴᏙᎳᏛᎢ ᏣᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Take a peek">
                <langSet xml:lang="en-US"><tig><term>Take a peek</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎦᏙᏍᏓ</term></tig></langSet>
