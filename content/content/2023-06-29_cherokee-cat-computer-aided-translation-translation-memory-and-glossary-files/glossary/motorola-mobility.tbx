            </termEntry>
            <termEntry id="Application does not have External Storage Permission.">
                <langSet xml:lang="en-US"><tig><term>Application does not have External Storage Permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏝᏍ ᎤᎭ ᏙᏯᏗᏢ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" created this group with  and  other">
