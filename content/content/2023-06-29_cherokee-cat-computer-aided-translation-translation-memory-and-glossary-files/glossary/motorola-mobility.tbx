                <langSet xml:lang="en-US"><tig><term>lpsust not provided</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>lpsust ᎥᏝ ᎠᏓᏁᎳᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="To quickly resume playback, media player stays open in Quick Settings">
                <langSet xml:lang="en-US"><tig><term>To quickly resume playback, media player stays open in Quick Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᎵᏍᏓᏊ ᎠᎴᏂᏐᏗᏍᎩ ᏙᎠᏁᎶᏗᏍᎩ, ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏗᏁᎶᎲᏍᎩ ᎡᏙᎮᏍᏗ ᎯᏍᏚᎢ ᎤᎿᎢ ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Each user has a personal space on your device for custom Home screens, accounts, apps, settings, and more.">
