            </termEntry>
            <termEntry id="Couldn\u2019t unmount USB storage. Try again later.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t unmount USB storage. Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎥᏝ ᎤᏌᎯᎸ USB ᎠᏍᏆᏂᎪᏙᏗ. ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to activate ">
                <langSet xml:lang="en-US"><tig><term>Tap to activate </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ to ᎤᏂᎩᏍᏗᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to use the tablet's infrared transmitter.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to use the tablet's infrared transmitter.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎬᏔᏂᏓᏍᏗ ᎾᏍᎩ ᏗᎪᏪᎶᏙᏗ ᎩᎦᎨ ᏚᎸᏌᏛ ᎭᏫᏂᏗᏢ ᎦᎶᎯᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to prevent the tablet from going to sleep.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to prevent the tablet from going to sleep.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᏲᏍᏙᏗᏍᎩ ᎾᎿᎢ ᏗᎪᏪᎶᏗᎢ ᏅᏓᏳᏓᎴᏅᎯ ᏓᏰᏏ ᎾᎿᎢ ᎦᏟᏔᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete some files to free space.">
                <langSet xml:lang="en-US"><tig><term>Delete some files to free space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᎢᎦᏓ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎿᎢ ᏗᏣᏲᎯᏍᏗ ᎤᏜᏅᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Monarch">
                <langSet xml:lang="en-US"><tig><term>Monarch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎬᏫᏳᏌᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You've gone  over your set limit">
                <langSet xml:lang="en-US"><tig><term>You've gone  over your set limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏃ ᏱᏣᏁᎸᎢ  ᏣᎶᏒᏍᏔᏅᎩ ᏣᏤᎵ ᎠᏎᎸᎯ ᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="reroute outgoing calls">
                <langSet xml:lang="en-US"><tig><term>reroute outgoing calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏓᎴᏍᏛ ᏥᏫᏙᎲᏓ ᏗᏂᎩᏍᎩ ᏫᏗᎬᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb is on for  with custom settings.">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb is on for  with custom settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᏍᎩ ᎤᎾᎢ ᎾᏍᎩᎾ  ᎬᏗ ᏄᏍᏛ ᎢᏯᎾᏛᏁᎯ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not visible to other Bluetooth devices">
                <langSet xml:lang="en-US"><tig><term>Not visible to other Bluetooth devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎬᎪᏩᏛᏗ ᎾᎿᎢ ᏐᎢ Bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id=" wants to turn on Bluetooth and make your tablet visible to other devices for  seconds.">
                <langSet xml:lang="en-US"><tig><term> wants to turn on Bluetooth and make your tablet visible to other devices for  seconds.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎯᏍᏚᎢ Bluetooth ᎠᎴ ᎪᏢᏗ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᎬᎪᏩᏛᏗ ᎾᎿᎢ ᏐᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎬᏩᏟ  ᏓᏓᎾᏩᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tablet storage is full.">
                <langSet xml:lang="en-US"><tig><term>Tablet storage is full.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏪᎶᏗᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏧᎧᎵᏨᎯ.</term></tig></langSet>
            </termEntry>
