                <langSet xml:lang="en-US"><tig><term>Phone ringtone (SIM slot )</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏝᏃᎮᏗ ᎤᏃᏴᎬ (SIM ᎤᏜᏅᏓ )</term></tig></langSet>
            </termEntry>
            <termEntry id="Invalid PIN.">
                <langSet xml:lang="en-US"><tig><term>Invalid PIN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏓᏂᎸᎬᎾ PIN.</term></tig></langSet>
            </termEntry>
            <termEntry id="Android security update">
                <langSet xml:lang="en-US"><tig><term>Android security update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android ᎤᎦᏎᏍᏗ ᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tips: Hold phone in natural way as you use normally.">
                <langSet xml:lang="en-US"><tig><term>Tips: Hold phone in natural way as you use normally.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᎯᏎᎯ ᏗᏢᏃᎮᏗ  : ᏦᏰᏂ ᎬᏗ ᎯᏱᏙᎮᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once the service is active for your mobile number, every time you connect to a WiFi network, your voice calls will be performed using WiFi Calling.">
                <langSet xml:lang="en-US"><tig><term>Once the service is active for your mobile number, every time you connect to a WiFi network, your voice calls will be performed using WiFi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎢᏯᏓᏛᏁᏗ ᎤᏂᎩᏍᏗᏍᎩ ᏂᎯ ᎠᏂᎩᏍᎩ ᏗᏎᏍᏗ, ᏂᎪᎯᎸ ᏱᎫᏓᎳ WiFi ᏗᏗᎠᎸ, ᎧᏁᎬ ᏫᏯᏅᏗ ᏚᎸᏫᏍᏁᎲ WiFi ᎥᏗᏍᎬ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Unfortunately, in such cases we will not know your precise location and therefore your emergency call may be routed to the not to the closest emergency centre, regarding your actual location.">
                <langSet xml:lang="en-US"><tig><term>Unfortunately, in such cases we will not know your precise location and therefore your emergency call may be routed to the not to the closest emergency centre, regarding your actual location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲᎢ, ᎢᏱᏄᎵᏍᏛᎾ Ꮭ ᏲᎦᏁᏖᏍᏗ ᎠᎾ ᎮᏙᎲ ᎠᎴ ᎤᏟᏍᏗ ᏩᏴᏅᏗ Ꮭ ᏳᏩᎦᎶᏍᎨᏍᏗ ᎾᎥᏂᎨᏍᏗ ᎮᏙᎲᎢ Ꮩ ᎠᎾ ᎮᏙᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Partially supported language">
                <langSet xml:lang="en-US"><tig><term>Partially supported language</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏛᏭ ᏕᎦᎫᏍᏓᏁᎭ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="WiFi Calling is a service of your mobile operator, Orange Polska S.A.">
                <langSet xml:lang="en-US"><tig><term>WiFi Calling is a service of your mobile operator, Orange Polska S.A.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏗ ᎥᏍᎩ ᎢᏓᏛᏁᏗᎢ ᏂᏣᏤᎵ ᎠᏂᎩᏍᎩ ᎠᎯᎵᏙᎯ, ᏍᎦᏚᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will be presented to you by a dedicated icon on the notification bar.">
                <langSet xml:lang="en-US"><tig><term>This will be presented to you by a dedicated icon on the notification bar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎨᏎᏍᏗ ᎡᏣᏓᏁᎸᎩ ᎾᎢ ᎠᏑᏰᏓ ᎠᎧᏂ ᎥᎾᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Incoming calls in Poland are free of charge.">
                <langSet xml:lang="en-US"><tig><term>Incoming calls in Poland are free of charge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎷᎬᎢ ᏛᏯᏂᏍᎬ ᏉᎳᏂ ᎠᏎᏊ ᏓᎬᏩᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We will process these data for the duration of the agreement on providing telecommunication services between you and us, and after its termination - for the period of recovery of claims and of performing other tasks defined in the provisions of law.">
                <langSet xml:lang="en-US"><tig><term>We will process these data for the duration of the agreement on providing telecommunication services between you and us, and after its termination - for the period of recovery of claims and of performing other tasks defined in the provisions of law.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎾᎯᎴᏏ ᎦᏟᏌᏅ ᎢᏱᎪᎯᏛ ᏕᏨᏓᏁᏤᎸᎢ Ꮎ ᎠᏓᏁᎳᏅ ᎢᎾ ᏫᏓᏝᏃᎮᏗ ᎢᏳᏅᏛᏁᏗ ᎠᏯ ᎠᎴ ᏂᎯ, ᎠᎵᏍᏋᏛ-ᎢᏱᎪᎯᏛ ᎠᏟᎢᏱᎵᏙᎸ  ᎠᎩᎩᏍᏗ ᎠᎴ ᏕᎦᏓᏁᏤᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Any changes you've made to the following settings will be undone: Battery">
                <langSet xml:lang="en-US"><tig><term>Any changes you've made to the following settings will be undone: Battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏓ ᏕᏨᏁᏟᏴᏒ ᏕᎦᎧᎲ ᏙᎠᏓᏛᏁᏟᏴᏌ: ᎠᎾᎦᎵᏍᎩ Battery</term></tig></langSet>
            </termEntry>
            <termEntry id="If you switch the Hide my device option on, your phone will not be visible to other devices and will not appear in the list of available Wi-Fi networks.">
                <langSet xml:lang="en-US"><tig><term>If you switch the Hide my device option on, your phone will not be visible to other devices and will not appear in the list of available Wi-Fi networks.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏨᏁᏟᏴᏍᏌ ᎤᏗᏍᎬᏢ ᏥᏂᏕᎬᏅᎾ ᏱᏍᏚᎢᏏ, ᏕᏢᏃᎮᏗ Ꮭ ᏴᏂᎪᏩᏔ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎴ Ꮭ ᏴᎯᎪᏩᏔ ᏚᏓᏅᏅ ᏗᏛᏅᎢᏍᏔᏅ WiFi ᎤᎾᏚᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select WPA2 security instead if you want to require a password.">
                <langSet xml:lang="en-US"><tig><term>Select WPA2 security instead if you want to require a password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏑᏰᎩ WPA2 ᎤᎦᏎᏍᏗ ᏱᏣᏚᎵ ᏱᏨᏁᏗ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="GSM Only">
                <langSet xml:lang="en-US"><tig><term>GSM Only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>GSM ᎾᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Missing SIM Card">
                <langSet xml:lang="en-US"><tig><term>Missing SIM Card</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᎾᏠᎦ SIM ᏗᏆᏂᏲᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set mobile data limit">
