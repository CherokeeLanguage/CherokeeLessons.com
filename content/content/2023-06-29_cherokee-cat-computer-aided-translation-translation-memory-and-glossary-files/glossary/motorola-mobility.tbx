                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏁᎸᏓ ᎣᏂᏯᎨᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show text in sidebar">
