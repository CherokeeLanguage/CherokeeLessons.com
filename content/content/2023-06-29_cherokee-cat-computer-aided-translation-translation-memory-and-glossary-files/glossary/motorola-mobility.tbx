            </termEntry>
            <termEntry id="This SIM can\u2019t be erased due to an error.Restart your device and try again.">
                <langSet xml:lang="en-US"><tig><term>This SIM can\u2019t be erased due to an error.Restart your device and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ eSIM ᎨᏍᏗ ᏰᎵ\u2019 ᎨᏒᎩ ᏛᏍᏍᎪᎸᏥ ᏂᎨᏒ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᏓᏓᎴᎬᎢ.ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use, select a network rating provider">
                <langSet xml:lang="en-US"><tig><term>To use, select a network rating provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ, ᎠᏑᏰᏍᏗ Ꭰ ᏧᎾᏚᏓᎵ ᎢᎦᎢ ᎤᏂᏅᏅᎢ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To move data you need to unlock user ^1.">
                <langSet xml:lang="en-US"><tig><term>To move data you need to unlock user ^1.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎲᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎬᏗᏍᎩ ^1.</term></tig></langSet>
            </termEntry>
            <termEntry id="Only connect apps if you trust them not to share personal data with your IT admin.">
                <langSet xml:lang="en-US"><tig><term>Only connect apps if you trust them not to share personal data with your IT admin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᎱᏓᎸᎥᎦ ᏗᎬᏙᏗ if ᏂᎯ ᎰᏩ ᎯᏰᎵᏎᎭ ᎢᏯᏂᎢ ᎥᏝ ᎾᎿᎢ ᎠᏯᏙᏍᏗᎢ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗ ᏂᏨᎤᎢ IT ᎤᎦᏎᏍᏗᏕᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect password on the next attempt, this device's data will be deleted">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect password on the next attempt, this device's data will be deleted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id=" recommends a new pattern, PIN, or password and may not work as expected without one">
                <langSet xml:lang="en-US"><tig><term> recommends a new pattern, PIN, or password and may not work as expected without one</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎦᎸᏉᏙᏗ ᏗᏤ ᎤᎾᎶᎢᏓ, PIN, ᏃᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᏃᎴ ᏰᎵᏉ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎯᎢᎾᎢ ᎤᏚᎩ ᎤᏩᏌ ᏄᏠᏯᏍᏛᎾ ᏌᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 data warning / ^2 data limit">
                <langSet xml:lang="en-US"><tig><term>^1 data warning / ^2 data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᎦᏘᏍᎩᏌᏅᎯ ᎠᏓᏕᏯᏔᎲᏍᎩ / ^2 ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Downloaded SIMs can\u2019t be erased due to an error.Restart your device and try again.">
                <langSet xml:lang="en-US"><tig><term>Downloaded SIMs can\u2019t be erased due to an error.Restart your device and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ SIMs ᎨᏍᏗ ᏰᎵ\u2019 ᎨᏒᎩ ᏛᏍᏍᎪᎸᏥ ᏂᎨᏒ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᏓᏓᎴᎬᎢ.ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t open supported links">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t open supported links</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ\u2019 ᏥᎯᏍᏚᎢᏏ ᎦᎫᏍᏛᏅᎢ ᏕᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi advanced settings are not available for this user">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi advanced settings are not available for this user</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᎢᏴᏛ ᎠᏱᎸᏛ ᏕᎦᎧᎲ ᎭᏗ ᏧᏛᏅᎢᏍᏔᎾ ᏱᎩ ᎯᎠ ᎠᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your IT admin requested a bug report to help troubleshoot this device. Apps and data may be shared.">
                <langSet xml:lang="en-US"><tig><term>Your IT admin requested a bug report to help troubleshoot this device. Apps and data may be shared.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ IT ᏄᏂᎬᏫᏳᏌᏕᎩ ᎤᏂᏔᏲᏢᎩ ᏍᎪᏯ ᎬᏂᎨᏒ ᎧᏃᎮᏗ ᎾᎢ ᎠᏍᏕᎸᏗ ᎣᏍᏓᏱᎬᏁᎯ ᎠᏓᏃᎯᏎᎭ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᏗᎬᏙᏗ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏒᎢ ᎠᏯᏙᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Total memory">
                <langSet xml:lang="en-US"><tig><term>Total memory</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏅᏓᏗᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps can create a hotspot to share content with nearby devices.">
                <langSet xml:lang="en-US"><tig><term>Apps can create a hotspot to share content with nearby devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᏱᎪᏢᎾ ᎤᏗᎴᎩᏕᎫᏓᎸ ᏐᎢ ᏄᏍᏗᏓᏅ ᎾᎥ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="There are  of files in the trash. All items will be deleted forever, and you won\u2019t be able to restore them.">
                <langSet xml:lang="en-US"><tig><term>There are  of files in the trash. All items will be deleted forever, and you won\u2019t be able to restore them.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏂᎠ  ᎾᎿ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎿ ᏥᎩ ᎤᏲ ᏩᏗᏅᏓ. ᏂᎦᏓ items ᎠᏎ ᎨᎡᎩ deleted forever, ᏃᎴ ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎪᏢᎯᏐᏗ ᎢᏯᏂᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase all data">
                <langSet xml:lang="en-US"><tig><term>Erase all data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="A pattern protects your phone if it\u2019s lost or stolen.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A pattern protects your phone if it\u2019s lost or stolen.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D ᎤᎾᎶᎢᏓ ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᏃᎴ ᎦᏃᏍᎩᏓᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dock not found">
                <langSet xml:lang="en-US"><tig><term>Dock not found</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏝᏅᏗᏱ ᎭᏗ ᎠᏩᏛᏗ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="android security patch level, baseband version, kernel version">
                <langSet xml:lang="en-US"><tig><term>android security patch level, baseband version, kernel version</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏁᏉᎢᏗ ᎤᎦᏎᏍᏗ ᎦᏯᎸᏗ ᎠᏥᎶᏍᎩ, ᎤᏙᏢᎯ ᎠᏓᏠᏍᏗ ᏄᏓᎴᏒᎢ, ᏚᎷᏍᏓ ᏄᏓᎴᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Will never turn off automatically">
                <langSet xml:lang="en-US"><tig><term>Will never turn off automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᏤᏍᏗ ᎢᎸᎯᏳᎢ ᎯᏍᏚᎢ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your face to unlock your phone or approve purchases.Note: You can\u2019t use your face to unlock this device. For more information, contact your organization\u2019s admin.">
                <langSet xml:lang="en-US"><tig><term>Use your face to unlock your phone or approve purchases.Note: You can\u2019t use your face to unlock this device. For more information, contact your organization\u2019s admin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ your ᎧᏁᏉᏍᏗᏍᎬ to ᎠᏂᏐᎭᎾᎳᎩ your ᏗᏟᏃᎮᏗ or ᎪᎯᏳᏙᏗ ᏗᏩᎯᏍᏗ.ᎤᏍᏗ ᎪᏪᎸ: ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎢᏣᏙᏢᏒᎢ\u2019s ᎤᎦᏎᏍᏗᏕᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Awake time">
                <langSet xml:lang="en-US"><tig><term>Awake time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏰᏨᎩ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="No sound from notifications">
                <langSet xml:lang="en-US"><tig><term>No sound from notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏃᏴᎵᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏗᎾᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="App pinning allows you to keep the current app in view until you unpin it. This feature can be used, for example, to let a trusted friend play a specific game.">
                <langSet xml:lang="en-US"><tig><term>App pinning allows you to keep the current app in view until you unpin it. This feature can be used, for example, to let a trusted friend play a specific game.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎯ ᎾᎢ ᏍᏆᏂᎪᏙᏗ ᎾᏍᎩ ᏃᏊ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᎩᎳ ᏂᎯ ᎯᎥᏍᏈᏛᎲᎢ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏰᎵᏊ ᎨᏒᎢ ᏗᏔᏅᎯ, ᎾᏍᎩᎾ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎢ ᎠᎵᏍᎪᎸᏔᏅᎢ ᎨᎦᎨᏅᏛ ᎤᎾᎵᎢ ᏗᏁᎸᏙᏗ ᏗᏙᎳᎩ ᏗᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network rating provider">
                <langSet xml:lang="en-US"><tig><term>Network rating provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ ᎢᎦᎢ ᎤᏂᏅᏅᎢ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can’t use camera">
                <langSet xml:lang="en-US"><tig><term>Can’t use camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone won\u2019t show, vibrate or make sound for new or existing notifications. Keep in mind, critical notifications for phone activity and status will still appear.When you turn off Do Not Disturb, find missed notifications by swiping down from the top of your screen.">
                <langSet xml:lang="en-US"><tig><term>Your phone won\u2019t show, vibrate or make sound for new or existing notifications. Keep in mind, critical notifications for phone activity and status will still appear.When you turn off Do Not Disturb, find missed notifications by swiping down from the top of your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏝᏃ ᎬᏂᎨᏒ ᏱᎬᏁᎯ ᎯᏍᏆᏂᎪᏓ ᎾᏍᎩ ᏣᏓᏅᏛᎢ, ᎤᏓᏚᎯᏌᏘ ᏗᏓᏃᏣᎳᏁᎯ ᎾᏍᎩᎾ ᏗᏟᏃᎮᏗ ᎠᎵᏖᎸᎲᏍᎬᎢ ᏃᎴ ᏄᏍᏗᏓᏅᎢ ᎠᏎ ᏏᏊ ᎤᎾᏄᎪᎢᏍᏗ.ᎾᎯᏳ ᏂᎯ ᎯᏍᏚᏅ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ, ᎯᏩᏔ ᎦᏅᏛᎢ ᏗᏓᏃᏟᎳᏁᎯ ᎬᏗ ᎦᏅᎦᏗᏍᎬ ᎡᎳᏗᏟ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎦᏚᎢ ᎥᎿᎢ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Require password to start up your device. While off, this device can't receive calls, messages, notifications, or alarms.">
                <langSet xml:lang="en-US"><tig><term>Require password to start up your device. While off, this device can't receive calls, messages, notifications, or alarms.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎾᎿᎢ ᎠᏂᎩᏍᏙᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎾᎯᏳᎢ ᎠᏍᏚᎭ, ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᏓᏯᏂ, ᏗᎪᎵᏰᏗ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᏗᏓᏕᏯᏙᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Primary data">
                <langSet xml:lang="en-US"><tig><term>Primary data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎬᏫᏳᏒ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="A pattern protects your phone if it\u2019s lost or stolen.This deletes the fingerprint model stored on your device. Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face or fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A pattern protects your phone if it\u2019s lost or stolen.This deletes the fingerprint model stored on your device. Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face or fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D ᎤᎾᎶᎢᏓ ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᏃᎴ ᎦᏃᏍᎩᏓᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᏃᎴ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb is on until ">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb is on until </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎤᎾᎢ ᎩᎳᏃ </term></tig></langSet>
            </termEntry>
