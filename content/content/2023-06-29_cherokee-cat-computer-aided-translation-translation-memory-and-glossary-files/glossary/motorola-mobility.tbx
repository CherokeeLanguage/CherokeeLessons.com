            </termEntry>
            <termEntry id=" apps behaving abnormally">
                <langSet xml:lang="en-US"><tig><term> apps behaving abnormally</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏗᎬᏙᏗ ᎠᎵᏏᎾᎯᏍᏗᏍᎨᏍᏗ ᎧᎵᏂᎨᏒᎾᏉ</term></tig></langSet>
