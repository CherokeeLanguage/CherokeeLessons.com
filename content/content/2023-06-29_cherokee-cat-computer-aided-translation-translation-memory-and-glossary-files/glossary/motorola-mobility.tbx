                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅᎯ ᏗᏆᏤᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="My photo">
                <langSet xml:lang="en-US"><tig><term>My photo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅᎯ ᏗᏆᏤᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Additionally, it is not possible to bypass this error because the device is currently running a VPN.">
                <langSet xml:lang="en-US"><tig><term>Additionally, it is not possible to bypass this error because the device is currently running a VPN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏙᏔᏅ, ᎨᎡᎢ ᎭᏗ ᎡᎵᏊ ᎾᎿᎢ ᎠᏕᏯᏍᏗ ᎯᎠ ᏓᏓᎴᎬᎢ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᏃᏊ ᏥᎩ ᎠᏓᎾᏫᏍᏓ Ꭰ VPN.</term></tig></langSet>
            </termEntry>
            <termEntry id="For example, the login page may not belong to the organization shown.">
                <langSet xml:lang="en-US"><tig><term>For example, the login page may not belong to the organization shown.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᏥᎩ ᎯᏴᏍᏗ ᎤᎦᏅᏓᏛᎢ ᏰᎵᏉ ᎥᏝ ᎤᏓᏤᎵᎢ ᎾᎿᎢ ᏥᎩ ᎢᏣᏙᏢᏒᎢ ᎬᏂᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For example, the login page may require a specific application for authentication">
                <langSet xml:lang="en-US"><tig><term>For example, the login page may require a specific application for authentication</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᏥᎩ ᎯᏴᏍᏗ ᎤᎦᏅᏓᏛᎢ ᏰᎵᏯ ᎠᏎᏯᏛᏁᏗ Ꭰ ᎬᏂᎨᏒ ᎪᏟᏍᏗ ᎬᏙᏗ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tethering or hotspot active">
                <langSet xml:lang="en-US"><tig><term>Tethering or hotspot active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᏙᏗ ᏃᎴ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎬᏂᎦᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tracking sensitivity:">
                <langSet xml:lang="en-US"><tig><term>Tracking sensitivity:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏁᎩ ᎠᏒᏅᏍᏗᎢ:</term></tig></langSet>
