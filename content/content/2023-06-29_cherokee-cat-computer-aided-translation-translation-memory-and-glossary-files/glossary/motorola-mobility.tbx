                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ, ᎭᏗ ᎬᏂᏗᏍᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure you want to delete this shared data?">
                <langSet xml:lang="en-US"><tig><term>Are you sure you want to delete this shared data?</term></tig></langSet>
