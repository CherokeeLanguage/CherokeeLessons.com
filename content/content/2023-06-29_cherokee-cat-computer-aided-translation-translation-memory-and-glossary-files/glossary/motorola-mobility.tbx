                <langSet xml:lang="en-US"><tig><term>Verifying update ...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᎯᏳᏓ ᏗᎪᏒᎯᏌᏅᎯ ...</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow network operations for software updates">
                <langSet xml:lang="en-US"><tig><term>Allow network operations for software updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏧᎾᏚᏓᎵ ᏓᏂᏱᎵᏒᎢ ᎾᏍᎩᎾ ᎦᎾᏗᏅᏗ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="In this step, you will copy the update to system memory. The update will be installed on the next step. Connect your phone to a power source to ensure you don't run out of battery power.">
                <langSet xml:lang="en-US"><tig><term>In this step, you will copy the update to system memory. The update will be installed on the next step. Connect your phone to a power source to ensure you don't run out of battery power.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎯᎠ ᎠᎳᏏᏗ, ᏂᎯ ᎠᏎ ᏗᏟᎶᏍᏔᏅᎯ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎾᎿᎢ ᏄᏍᏗᏓᏅᎢ ᎠᏅᏓᏗᏍᏙ. ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᎦᏘᏅᏔᏅ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎠᎳᏏᏗ. ᎫᏓᎸᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎾᎿᎢ Ꭰ ᎤᎵᏂᎩᏗ ᏧᏓᎴᏅᎲᎢ ᎾᎿᎢ ᏦᎯᏳᏙᏗᏊ ᏂᎯ ᏝᏍᏗ ᎠᏓᎾᏫᏍᏗ ᎾᎿ ᎠᎾᎦᎵᏍᎩ ᎤᎵᏂᎩᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="An update is downloading \u0026 installing. You can continue using your device.">
                <langSet xml:lang="en-US"><tig><term>An update is downloading \u0026 installing. You can continue using your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ \u0026 ᎦᏘᏅᏛᏍᎬ. ᏂᎯ ᏰᎵᏯ ᎠᎯᎸᏍᏗ ᎬᏗᎭ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
