                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏗᎭ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="After deletion, you will need your fingerprint, PIN, pattern, or password to unlock your phone or for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>After deletion, you will need your fingerprint, PIN, pattern, or password to unlock your phone or for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎫᏗᏗᏒ ᏱᎬᏅᏕᏍᏗ, ᎤᏚᎸᏓ ᎨᏎᏍᏗ ᏣᏩᎵ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ, PIN, ᎤᎾᎶᎢᏓ, ᎠᎴ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎤᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In addition to using your fingerprint to unlock your device, you can further protect this device by requiring your password before it starts up.">
                <langSet xml:lang="en-US"><tig><term>In addition to using your fingerprint to unlock your device, you can further protect this device by requiring your password before it starts up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎧᏁᏉᏍᏓ ᎾᎢ ᎬᏗᏍᎬ ᏣᏤᎵ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎾᎢ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᏂᎯ ᏰᎵᏊ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎸᏙᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᏎᎾᏛᏁᎮᏍᏗ ᏣᏤᎵ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎤᏓᎷᎸ ᎾᏍᎩ ᏓᏂᎩᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Block notifications is off">
                <langSet xml:lang="en-US"><tig><term>Block notifications is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ ᏗᏓᏃᏣᎳᏁᎯ ᎾᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
