            <termEntry id="Allow this app to set alarms and schedule time-sensitive actions. This lets the app run in the background, which may use more battery.If this permission is off, existing alarms and time-based events scheduled by this app won\u2019t work.">
                <langSet xml:lang="en-US"><tig><term>Allow this app to set alarms and schedule time-sensitive actions. This lets the app run in the background, which may use more battery.If this permission is off, existing alarms and time-based events scheduled by this app won\u2019t work.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎬᏙᏗ ᎾᎢᎦᎧᎲᎢ ᏗᏓᏕᏯᏙᏗᏍᎩ ᏃᎴ ᏓᏒᏍᏛ ᎠᏥᎢᎵᏒ-ᎤᏁᏟᏴᏌᏘ ᎢᏗᏛᏁᏗ. ᎯᎠ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎠᎢᏎᏍᏗ ᎾᎿᎢ ᎾᏍᎩ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ, ᏱᏅᎦᎵᏍᏙᏓ ᎬᏙᏓ ᎤᏥ ᎢᎦᎢ ᎠᎾᎦᎵᏍᎩ.ᎢᏳᏃ ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᏳᏂᏍᏚᎾ, ᎪᎯᏓᎲᎢ ᏗᏓᏕᏯᏙᏗᏍᎩ ᏃᎴ ᎠᏥᎢᎵᏒ-ᏓᎳᏏᏔᏅᎩ ᏂᏕᎦᎵᏍᏔᏂᏙᎲ ᏓᏒᏍᏔᏅᎢ ᏄᏩᏅ ᎯᎠ ᎬᏙᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There was an error fetching shared data. Try again.">
                <langSet xml:lang="en-US"><tig><term>There was an error fetching shared data. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᎦᎵᏓᏍᏔᏅ ᎠᎩᏍᏗᏍᎬ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Check apps installed via ADB/ADT for harmful behavior.">
                <langSet xml:lang="en-US"><tig><term>Check apps installed via ADB/ADT for harmful behavior.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎦᏛᎲᎦ ᏗᎬᏙᏗ ᎦᏘᏅᏔᏅ ᎾᎿ ᎢᏗᏨ ADB/ADT ᎾᏍᎩᎾ ᎤᏐᏅ ᏯᏓᏛᏁᎯ ᎾᏛᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you add a new user, that person needs to set up their space.Any user can update apps for all other users.">
                <langSet xml:lang="en-US"><tig><term>When you add a new user, that person needs to set up their space.Any user can update apps for all other users.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏗᎧᏁᏉᏍᏗ ᏗᏤ ᎬᏗᏍᎩ, ᎥᏍᎩᎾ ᎠᏂᏴᏫ ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᎾᎿᎢ ᏘᎧᎲᎦ ᎤᎾᏤᎵ ᎤᏜᏅᏛ.ᎾᏂᎥᏉ ᎬᏗᏍᎩ ᏰᎵᏊ ᏗᎪᏒᎯᏌᏅᎯ ᏗᎬᏙᏗ ᎤᎬᏩᏟ ᏂᎦᏓ ᏐᎢ ᏗᏅᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Available via ">
                <langSet xml:lang="en-US"><tig><term>Available via </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅ ᎾᎿ ᎢᏗᏨ </term></tig></langSet>
            </termEntry>
            <termEntry id="Available via ">
                <langSet xml:lang="en-US"><tig><term>Available via </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅ ᎾᎿ ᎢᏗᏨ </term></tig></langSet>
            </termEntry>
            <termEntry id="This choice is no longer valid. Try again.">
                <langSet xml:lang="en-US"><tig><term>This choice is no longer valid. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏑᏰᏍᏗ ᏄᏍᏛ Ꮭ ᎦᏅᎯᏓᎨ ᏓᏓᏂᎸᎬᎢ. ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can share this device with other people by creating additional users. Each user has their own space, which they can customize with apps, wallpaper, and so on. Users can also adjust device settings like Wi\u2011Fi that affect everyone.When you add a new user, that person needs to set up their space.Any user can update apps for all other users. Accessibility settings and services may not transfer to the new user.">
                <langSet xml:lang="en-US"><tig><term>You can share this device with other people by creating additional users. Each user has their own space, which they can customize with apps, wallpaper, and so on. Users can also adjust device settings like Wi\u2011Fi that affect everyone.When you add a new user, that person needs to set up their space.Any user can update apps for all other users. Accessibility settings and services may not transfer to the new user.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>YᏂᎯ ᏰᎵᏊ ᎠᏯᏙᎯᏍᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ ᎠᏂᏐᎢ ᎠᏂᏴᏫ Ꮕ ᏂᏚᏅᏅ ᎪᏢᏍᎬᎢ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏗᏅᏗᏍᎩ. ᏧᏤᎵᏛ ᎬᏗᏍᎩ ᎤᏂᎭ ᎤᏅᏌ ᎤᏜᏅᏛᎯ, ᎾᏍᎩᏃ ᏰᎵᏊ ᎠᏤᎲᏍᏙᏗ ᎬᏗ ᏗᎬᏙᏗ, ᎧᏑᎧᏡ ᎪᏪᎵ, ᏃᎴ ᏅᏍᏗᏓᏅᎢ. ᏗᏅᏗᏍᎩ ᏰᎵᏊ ᎾᏍᏉ ᎦᏁᏟᏴᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᏕᎦᎧᎲᎢ ᎢᏳᏍᏘ Wi\u2011Fi ᎾᏍᎩᎾᎢ ᎠᏕᏯᏙᏗ ᏂᎦᏗᏳ.ᎢᏳᏃ ᏂᎯ ᏗᎧᏁᏉᏍᏗ ᏗᏤ ᎬᏗᏍᎩ, ᎥᏍᎩᎾ ᎠᏂᏴᏫ ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᎾᎿᎢ ᏘᎧᎲᎦ ᎤᎾᏤᎵ ᎤᏜᏅᏛ.ᎾᏂᎥᏉ ᎬᏗᏍᎩ ᏰᎵᏊ ᏗᎪᏒᎯᏌᏅᎯ ᏗᎬᏙᏗ ᎤᎬᏩᏟ ᏂᎦᏓ ᏐᎢ ᏗᏅᏗᏍᎩ. ᎬᏴᏍᏗᎨᏒ ᏕᎦᎧᎲᎢ ᏃᎴ ᎢᏗᏓᏛᏁᏗ ᏰᎵᏊ ᎭᏗ ᎠᎲᏍᏗ ᎾᏍᎩ ᎢᏤ ᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data in this error report comes from system log files and may contain sensitive information, such as app usage and location data. By continuing, you acknowledge that the app service provider will use this data to help you solve technical or maintenance issues. Make sure you only share this error report with people or apps you trust.">
                <langSet xml:lang="en-US"><tig><term>Data in this error report comes from system log files and may contain sensitive information, such as app usage and location data. By continuing, you acknowledge that the app service provider will use this data to help you solve technical or maintenance issues. Make sure you only share this error report with people or apps you trust.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎾᎢ ᎯᎠ ᎦᎵᏓᏍᏔᏅ ᎾᏍᎩ ᏂᏓᏳᏓᎴᏅᎩ ᏄᏍᏗᏓᏅᎢ ᏄᏛᏁᎸ ᎧᏃᎮᏍᎩ ᏗᏍᏆᏂᎪᏙᏗ ᏃᎴ ᎦᎸᏛᎢ ᎤᏁᏟᏴᏌᏘ ᎧᏃᎸᎥᏍᎩ, ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎬᏙᏗ ᎬᏗᏍᎬ ᏃᎴ ᎢᎬᎾᏕᎾ ᎦᏘᏍᎩᏌᏅᎯ. ᏫᎬᎵᏱᎴᎬ, ᏂᎯ ᏗᏓᏂᎸᏨᎯ ᎥᏍᎩᎾ ᎬᏙᏗ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎩ ᎬᏔᏂᏓᏍᏗ ᎦᏟᏌᏅᎯ ᎠᏎᎢ ᎠᏍᏕᎸᏗᎢ ᏂᎯ ᎣᏍᏓ ᏱᎬᏁᏗ ᎤᏦᏍᏗ ᏂᎬᎿᏅ ᎠᎴ ᎣᏍᏓᎢᏯᏅᏁᎯ ᏓᏓᎴᎬᎢ. ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯ ᎤᏩᏌ ᎠᏯᏙᎯᏍᏗ ᎯᎠ ᎦᎵᏓᏍᏔᏅ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎬᏗ ᎠᏂᏴᏫ ᎠᎴᏃ ᏗᎬᏙᏗ ᏂᎯ ᎯᎦᏕᏅᏴᏯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Pattern required after device restarts">
                <langSet xml:lang="en-US"><tig><term>Pattern required after device restarts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎶᎢᏓ ᎢᏯᏛᏁᏗ ᎣᏂᏗᏨ ᏥᏂᎬᏅᏗᏓᎾ ᏥᎭᏂᎩᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="You have incorrectly attempted to unlock the phone  times. After  more unsuccessful attempts, this user will be removed, which will delete all user data.">
