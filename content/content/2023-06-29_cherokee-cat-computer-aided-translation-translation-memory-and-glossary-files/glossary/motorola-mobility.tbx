                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᏗᏤ ᎤᏓᏤᏟᏓ ᏗᎧᏃᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Create theme">
                <langSet xml:lang="en-US"><tig><term>Create theme</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᎤᏓᏤᏟᏓ ᏗᎧᏃᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="See when a contact is replying to your messages">
                <langSet xml:lang="en-US"><tig><term>See when a contact is replying to your messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ ᎢᏳᏃ Ꭰ ᎠᏟᏃᎮᏙᏗ ᎨᏒᎩ ᎦᏬᎯᎵᏴᏍᏗ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Theme name cannot be blank">
                <langSet xml:lang="en-US"><tig><term>Theme name cannot be blank</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏤᏟᏓ ᏗᎧᏃᏗᏱ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎤᎾᎫᎱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Timer Off">
                <langSet xml:lang="en-US"><tig><term>Timer Off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᏱᎵᏒ ᎠᎦᏘᏯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically enable dark theme at sunset and disable at sunrise, theme transition schedules begin when your screen is off">
                <langSet xml:lang="en-US"><tig><term>Automatically enable dark theme at sunset and disable at sunrise, theme transition schedules begin when your screen is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᎢᏯᏓᏛᏁᎯ ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎤᎵᏏᎩ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᎤᎿᎢ ᎤᏓ ᎢᎦ ᎡᎯ ᏭᏕᎵᎬ ᏃᎴ ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎤᎿᎢ ᏕᎦᏅᏱ, ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᏓᏓᏁᏟᏴᏍᎬᎢ ᏓᏒᏍᏛᎢ ᎠᎴᏅᏗ ᎢᏳᏃ ᏂᏨᎤᎢ ᎠᏰᏙᎳᏛᎢ ᎨᎡᎢ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can not add color anymore">
                <langSet xml:lang="en-US"><tig><term>Can not add color anymore</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎧᏁᏉᏍᏗ ᎠᏑᏫᏓ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Photo Editor">
                <langSet xml:lang="en-US"><tig><term>Photo Editor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ ᏗᎦᎧᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Share files up to \(Each file counts as one message.\)">
                <langSet xml:lang="en-US"><tig><term>Share files up to \(Each file counts as one message.\)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᏍᏗᎢ ᏗᏍᏆᏂᎪᏙᏗᎢ ᏯᏍᏘ \(ᏌᏊᎭ ᎠᏍᏆᏂᎪᏙᏗ ᏗᏎᏍᏗ ᎯᎢᎾᎢ ᏌᏊ ᏗᎦᏃᏣᎳᏅᎯ.\)</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto is syncing data.">
                <langSet xml:lang="en-US"><tig><term>Moto is syncing data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎢᏧᎳᎭ ᏥᏂᎦᎵᏍᏗᏍᎬᎢ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe for more experiences">
                <langSet xml:lang="en-US"><tig><term>Swipe for more experiences</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎾᏍᎩᎾ ᎤᏥ ᎢᎦᎢ ᎤᏂᎦᏙᎲᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to use your Razr like a pro. Razr Tips gives you information about basic functions, shortcuts on the external display, transitioning between the 2 displays, and more.">
                <langSet xml:lang="en-US"><tig><term>Learn how to use your Razr like a pro. Razr Tips gives you information about basic functions, shortcuts on the external display, transitioning between the 2 displays, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏙᎡᎵ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ Razr ᎯᎸᏉᏗ Ꭰ ᎧᎵ ᏗᏙᎳᎩ ᏄᏍᏗ ᏗᏥᎶᏍᏔᏅ. Razr ᎠᏍᏕᎸᏗᎢ ᎠᏓᏁᎭ ᏂᎯ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᎤᎵᏍᎨᏛ ᏧᎸᏫᏍᏓᏁᏗᏱ, ᏍᏆᎳ ᎢᏗᎬᏁᎯ ᎾᎿ ᏥᎩ ᏙᏯᏗᏨ ᎠᏓᏴᎳᏔᏍᎩ, ᏓᏓᏁᏟᏴᏍᎬᎢ ᎤᏜᏅᏛ ᏥᎩ 2 ᎠᏓᏴᎳᏔᏍᎩ, ᏃᎴ ᎤᎪᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do more with your phone hands-free. Talk to Me reads out your calls and messages so you can stay engaged when your hands and eyes need to focus on something else.">
                <langSet xml:lang="en-US"><tig><term>Do more with your phone hands-free. Talk to Me reads out your calls and messages so you can stay engaged when your hands and eyes need to focus on something else.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎾᏛᎦ ᎤᏠᏯᏍᏓ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏧᏬᏰᏂ-ᏂᏗᎬᏔᏅᎾ. ᏍᏆᏟᏃᎮᏓ ᏗᎪᎵᏰᏍᎩ ᏫᎦᏅᎪᎩ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏃᎴ ᏗᎧᏃᎮᏍᎩ ᎾᏍᎩ ᏂᎯ ᏰᎵᏊ ᏂᎦᏯᎢᏒᎢ ᎠᎾᏜᏂᎬᏁᎸᎢ ᎾᎯᏳ ᏗᏦᏰᏂ ᏃᎴ ᏗᎦᏙᎵ ᎤᏚᎸᏛ ᎾᎢ ᎤᎿᏊ ᎢᎦ ᏫᏔᎧᏅᎦ ᎤᎾᎢ ᎪᎱᏍᏗ ᏄᏓᎴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Information">
                <langSet xml:lang="en-US"><tig><term>Information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some of your phone's best features are waiting for you in Moto app. Personalize your device, find helpful tips, explore gestures, and more!">
                <langSet xml:lang="en-US"><tig><term>Some of your phone's best features are waiting for you in Moto app. Personalize your device, find helpful tips, explore gestures, and more!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᎥᎿᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᏫᏓᏤᏢ ᏗᎦᏎᏍᏙᏗ ᎨᏒᎢ ᎾᏍᎩᎾ ᏣᎦᏘᏯ ᎾᎿᎢ Moto ᎬᏙᏗ. ᎣᏤᎵᎢ ᎢᎬᏁᎵᏓᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏩᏔ ᎠᎵᏍᏕᎵᏍᎩ ᏗᏓᏕᏲᎲᏍᎩ, ᎪᎷᏅᏓ ᏧᏬᏯᏂᏍᎩ, ᏃᎴ ᎤᏥ ᎢᎦᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose fonts, colors &amp; more">
                <langSet xml:lang="en-US"><tig><term>Choose fonts, colors &amp; more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏄᏍᏛ ᏗᏙᏪᎵᏍᎩ, ᏗᏑᏫᏛ &amp; ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto requires permission to access your photos. Please update the permission settings by granting access to Files and Media">
                <langSet xml:lang="en-US"><tig><term>Moto requires permission to access your photos. Please update the permission settings by granting access to Files and Media</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎠᏎᏳᎾᏛᏁᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ. ᎰᏩᏊ ᏗᎪᏢᎯᏌᏅᎯ ᏥᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏕᎦᎧᎲᎢ ᎬᏗ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎠᏴᏍᏗ ᎾᎿᎢ ᏗᏍᏆᏂᎪᏙᏗ ᏃᎴ ᎦᎶᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can talk to the Google Assistant anytime, even when the flip is closed. Just double tap on the power key or say “Hey Google” to make calls, get the weather, and more.">
                <langSet xml:lang="en-US"><tig><term>You can talk to the Google Assistant anytime, even when the flip is closed. Just double tap on the power key or say “Hey Google” to make calls, get the weather, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᎵᏃᎮᏓ ᎾᏍᎩ Google ᎠᎵᏍᏕᎵᏍᎩ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ, ᎥᏍᏊ ᎾᎯᏳ ᏗᏁᏍᏆᏕᎦ ᏄᏍᏛ ᎠᏍᏚᏅᎩ. ᏍᎩᏋ ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏐᎥᏍᏙᏗ ᎠᎴᏃ ᏫᏂᏫ “ᏂᏃ Google” ᎾᎢ ᏫᏗᎬᏙᏗ, ᎠᎩᏍᏗ ᎾᏍᎩ ᏙᏱᏗᏜ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ, ᎠᎴᏃ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When the screen is locked, open the camera by twisting your wrist twice. When the screen is unlocked, open the camera by swiping right on the external display. Then, either tap on the screen or press the volume up or down key.">
                <langSet xml:lang="en-US"><tig><term>When the screen is locked, open the camera by twisting your wrist twice. When the screen is unlocked, open the camera by swiping right on the external display. Then, either tap on the screen or press the volume up or down key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏄᏍᏛ ᏍᏓᏱ ᎠᏍᏚᎭ, ᎯᏍᏚᎢ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏄᏩᏅ ᏣᏄᏖᏲᏍᏓ ᏣᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ. ᎾᎯᏳ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏄᏍᏛ ᎦᏐᎭᎾᎳᏕᏗ, ᎯᏍᏚᎢ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏄᏩᏅ ᎦᏅᎦᎵᏗᏍᎬ ᎠᎦᏘᏏ ᎤᎾᎢ ᏙᏯᏗᏨ ᎬᏂᎨᏒ ᏱᎬᏁᏗ. ᎾᏉᏃ, ᎢᏳᏍᏗᏊ ᎤᏟᏍᏓ ᎠᏒᏂᎸᎢ ᎤᎾᎢ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎠᎴᏃ ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎢᎦᎢ ᎤᏃᏴᎬ ᎦᎸᎳᏗ ᎠᎴᎬ ᎡᎳᏗᏟ ᎠᏐᎥᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can talk to the Google Assistant anytime, even when the flip is closed. Just double tap on the power key or say “Hey Google”.When you’re using the Google Assistant on the external display, specific commands work best (e.g. “Play my cooking playlist on Spotify” or “Set a timer for 3 minutes”).">
                <langSet xml:lang="en-US"><tig><term>You can talk to the Google Assistant anytime, even when the flip is closed. Just double tap on the power key or say “Hey Google”.When you’re using the Google Assistant on the external display, specific commands work best (e.g. “Play my cooking playlist on Spotify” or “Set a timer for 3 minutes”).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᎵᏃᎮᏓ ᎾᏍᎩ Google ᎠᎵᏍᏕᎵᏍᎩ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ, ᎥᏍᏊ ᎾᎯᏳ ᏗᏁᏍᏆᏕᎦ ᏄᏍᏛ ᎠᏍᏚᏅᎩ. ᏍᎩᏋ ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏐᎥᏍᏙᏗ ᎠᎴᏃ ᏫᏂᏫ “ᏂᏃ Google”.ᎾᎯᏳ ᎲᏗᏍᎬ ᎾᏍᎩ Google ᎠᎵᏍᏕᎵᏍᎩ ᎾᎿᎢ ᏙᏯᏗᏨ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᏗᏙᎳᎩ ᏗᏓᏁᏤᏗ ᏚᎸᏫᏍᏓᏁᎰ ᏫᏓᏤᎸᎢ (e. g. "ᏔᏁᎶᏓ ᎠᏆᏤᎵ ᎦᏓᏍᏓᏴᎲᏍᎬᎢ ᎤᎾᏛᏁᎸᏗ ᏗᏁᎸᏙᏗ ᎤᎾᎢ ᎤᏓᏓᏢᏃ ᎢᏗᏓᏛᏁᏗ" ᎠᎴᏃ "ᎦᎧᎲᎢ ᎾᏍᎩ ᎠᏥᏱᎵᏒ ᎠᎦᏘᏯ ᎾᏍᎩᎾ 3 ᎢᏯᏔᏬᏍᏔᏅ"</term></tig></langSet>
            </termEntry>
            <termEntry id="All recipients have left the group. To send a message, add recipients.">
                <langSet xml:lang="en-US"><tig><term>All recipients have left the group. To send a message, add recipients.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏗᏂᏁᏍᎩ ᎤᎭ ᎠᎦᏍᎦᏂ ᏥᎩ ᎤᎾᏓᏡᎬᎢ. ᎾᎿᎢ ᏫᏅᎥᎦ Ꭰ ᏗᎦᏃᏣᎳᏅᎯ, ᏗᎧᏁᏉᏍᏗ ᏗᏂᏁᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unsent message to : . Time: .">
                <langSet xml:lang="en-US"><tig><term>Unsent message to : . Time: .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏗᎦᏅᏅᎾ ᏗᎦᏃᏣᎳᏅᎯ ᎾᎿᎢ : . ᎠᏥᎢᎵᏒ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Disable dark mode">
                <langSet xml:lang="en-US"><tig><term>Disable dark mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎤᎵᏏᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Messages failed to load attachment.">
                <langSet xml:lang="en-US"><tig><term>Messages failed to load attachment.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᎵᏰᏗ ᎤᏄᎸᏅᎢ ᎾᎿᎢ ᎯᏢᎦ ᎠᏠᏯᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To adjust the keyboard height for more comfortable typing, go to Gboard settings &gt; Preferences &gt; Keyboard height. Then, drag the bar to your preferred height.">
                <langSet xml:lang="en-US"><tig><term>To adjust the keyboard height for more comfortable typing, go to Gboard settings &gt; Preferences &gt; Keyboard height. Then, drag the bar to your preferred height.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏄᏍᏛ ᎢᎬᏁᏗ ᎾᏍᎩ ᏗᏐᏅᏍᏙᏗ ᏂᎦᏛᎢ ᎾᏍᎩᎾ ᎤᏥ ᎢᎦᎢ ᎤᏦᎠᏎᏗ ᏂᎨᏒᎾ ᏗᏐᎥᏍᏙᏗ, ᎡᏅᏍᏗ ᎾᎾᎢ GᏯᏖᎾ ᏕᎦᎧᎲᎢ &gt; ᎤᏟ ᏕᎯᏰᎸᏍᎬᎢ &gt; ᏗᏐᏅᏍᏙᏗ ᏂᎦᏛᎢ. ᎿᏉᏃ, ᎦᎾᏏᏅᏍᏗ ᎾᏍᎩ ᎦᎾᎸ ᎾᎢ ᏂᏨᏅ ᎤᏟ ᎠᏰᎸᏅ ᏂᎦᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dump received SMS raw data into external storage file">
                <langSet xml:lang="en-US"><tig><term>Dump received SMS raw data into external storage file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᏩᏗᏅᏗ ᏓᏥᏁᎸᎩ SMS ᎠᎪᏍᏘ ᎦᏟᏌᏅᎯ ᎾᎿᎢ ᏙᏱᏗᏢ ᎠᏍᏆᏂᎪᏙᏗ ᏓᏥᏁᎸᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To change the wallpaper, long press on the internal display home screen and tap on “External Wallpapers”. To use one of your photos as a wallpaper, open the photo &gt; tap on the three buttons in the upper right corner &gt; tap on “Use as” &gt; choose “External Wallpapers”.">
                <langSet xml:lang="en-US"><tig><term>To change the wallpaper, long press on the internal display home screen and tap on “External Wallpapers”. To use one of your photos as a wallpaper, open the photo &gt; tap on the three buttons in the upper right corner &gt; tap on “Use as” &gt; choose “External Wallpapers”.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ Ꮎ ᎣᎾᏗᏢ ᎤᏓᏴᎳᏛ, ᎪᎯᏓ ᎠᏐᏅᏍᏙᏗ ᎥᎿᎢ ᎭᏫᏂ ᎠᏓᏴᎳᏛᏍᎩ ᏄᎬᏫᏳᏒ ᎠᏓᏴᎳᏛᏍᎩ ᏃᎴ ᎤᎵᏍᏓ ᎠᏒᏂᎸ ᎥᎿ ᏙᏱᏗᏢ ᎣᎾᏗᏢ ᏚᏓᏴᎳᏛ. ᏍᏙᏗ ᏌᏊ ᏂᏣᏤᎵ ᏗᏥᎶᏍᏔᏅᎯ ᎥᎩ ᎣᎾᏗᏢ ᎤᏓᏴᎳᏛ, ᎠᏍᏚᎢᏍᏗ Ꮎ ᏗᏟᎶᏍᏔᏅ&gt;</term></tig></langSet>
            </termEntry>
            <termEntry id="Enhance your sound">
                <langSet xml:lang="en-US"><tig><term>Enhance your sound</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᎴᏍᏗ ᏣᏤᎵ ᎤᎬᏴᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When the external display is locked, you can control the media player, read notifications, and send quick replies. When the external display is unlocked, you can take more actions on notifications and get access to contacts &amp; app shortcuts.">
                <langSet xml:lang="en-US"><tig><term>When the external display is locked, you can control the media player, read notifications, and send quick replies. When the external display is unlocked, you can take more actions on notifications and get access to contacts &amp; app shortcuts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ Ꮎ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ ᏯᏍᏚᎭ, ᏂᎯ ᏰᎵᏊ ᏱᎭᎷᎩ Ꮎ ᏗᎦᏃᎩᏍᏙᏗ, ᏣᎪᎵᏰᏗ ᏗᎾᏓᏣᎳᏁᎯ, ᏃᎴ ᏫᎦᏅᏗ ᎤᏟᏍᏓ ᏗᎦᏬᎯᎵᏴᏍᏗ. ᎾᎯᏳ Ꮎ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ ᎾᏍᏚᎲᎾ ᏱᎩ, ᏂᎯ ᏰᎵᏊ ᏣᎦᏍᏗ ᎤᏥ ᎢᎦᎢ ᎢᏯᏛᏁᏗ ᎾᎿ ᏗᎾᏓᏣᎳᏁᎯ ᏃᎴ ᏣᎩᏍᏗ ᎤᎵᏍᏚᎢᏓ ᏗᏟᏃᎮᏙᏗ ᏃᎴ ᎬᏙᏗ ᎠᏍᏆᎳ ᎢᏗᎬᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Message not sent">
