                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To check my device's warranty information">
                <langSet xml:lang="en-US"><tig><term>To check my device's warranty information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏣᎦᏛᎲᎦ ᏣᏤᎵᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏄᏩᎾ ᎠᏚᏓᎸᎢ ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id=" person in the queue before you, sorry to keep you waiting">
                <langSet xml:lang="en-US"><tig><term> person in the queue before you, sorry to keep you waiting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎩᎶ ᎾᎿᎢ ᎤᏓᏅᏅ ᎠᎬᏱᏗᏨ ᏂᎯ, ᎤᏲ ᎠᏰᎸᏗ ᎾᎢ ᏥᎦᏘᏗᏍᏗ ᏥᏂᎦᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot find Wi-Fi signal. Continuing to next test.">
                <langSet xml:lang="en-US"><tig><term>Cannot find Wi-Fi signal. Continuing to next test.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᎨᏥᏩᏔ ᏫᎢ-ᏈᎢ ᎦᏂᏴᏙᏗᎢ. ᏫᎬᎵᎵᏒᎢ ᎾᎢ ᏐᎢ ᎠᏓᎪᎵᏰᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device Help can't contact the server right now. Check your network connection, and try again.">
                <langSet xml:lang="en-US"><tig><term>Device Help can't contact the server right now. Check your network connection, and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏕᎵᏍᎩ ᎨᏍᏗ ᏰᎵ ᎠᏟᏃᎮᏙᏗ ᎾᏍᎩ ᎠᏯᏙᎯᎯ ᏃᏊᏥᎩᎢᏃ. ᏣᎦᏛᎲᎦ ᏣᏤᎵ ᎤᏚᏓᎵ ᎫᏓᎸᎢ, ᏃᎴ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No warranty info found. This could be due to a network issue.">
                <langSet xml:lang="en-US"><tig><term>No warranty info found. This could be due to a network issue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎠᏚᏓᎸᎢ ᎧᏃᎸᎥᏍᎩ ᎠᏩᏛᏓ ᏱᎩ. ᎯᎠ ᏰᎵᏊ ᎨᏒ ᎢᏳᏍᏗ ᎾᎢ ᎤᏚᏓᎵ ᎠᏓᎴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Services are invisible now since you denied the permission of making and managing phone calls. We need to get IMEI and call info to check available services for you, so please tap to allow the permission.">
                <langSet xml:lang="en-US"><tig><term>Services are invisible now since you denied the permission of making and managing phone calls. We need to get IMEI and call info to check available services for you, so please tap to allow the permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏓᏛᏁᏗ ᎨᏒᎢ ᎤᏍᎪᎸᏨ ᏃᏊ ᏂᏓᏳᏓᎴᏅᏓ ᏂᎯ ᎤᏓᏱᎸᎢ ᎾᏍᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎥᎿᎢ ᏕᎱᎪᏗᏍᎬ ᏃᎴ ᎠᎯᎸᏍᏗ ᏗᏟᏃᎮᏗ ᏫᏗᎬᏔᏅᎢ. ᏂᎦᏛᏉ ᎣᎦᏚᎸᏓ ᎾᎢ ᎠᎩᏍᏗ IMEI ᏃᎴ ᏫᎬᏔᏅ ᎧᏃᎸᎥᏍᎩ ᎾᎢ ᏣᎦᏛᎲᎦ ᎠᏛᏅᎢᏍᏔᏅ ᎢᏗᏓᏛᏁᏗ ᎾᏍᎩᎾ ᏂᎯ, ᎰᏩᏊ ᎭᏐᎥᏍᏓ ᎾᎢ ᎠᎵᏍᎪᎸᏙᏗ ᎾᏍᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data backup">
                <langSet xml:lang="en-US"><tig><term>Data backup</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᏍᏆᏂᎪᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Find more details here:">
                <langSet xml:lang="en-US"><tig><term>Find more details here:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏩᏔ ᎤᏥ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ ᎠᎭᏂ:</term></tig></langSet>
            </termEntry>
            <termEntry id="GPS needs at least 4 satellites to accurately calculate location. There may be physical barriers interfering with the GPS on your device. Move to an open area or outdoors to reset your GPS.">
                <langSet xml:lang="en-US"><tig><term>GPS needs at least 4 satellites to accurately calculate location. There may be physical barriers interfering with the GPS on your device. Move to an open area or outdoors to reset your GPS.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>GPS ᏚᏚᎸᏛᎢ ᎦᏲᎵᎨ ᎨᏒ 4 ᏧᏯᏅᎢᏗᏍᏕᏱᏛ ᎬᏔᏅ ᏗᏓᏴᎳᏛᏍᎩ ᎾᎢ ᎧᎵᏗᏙᎳᎩ ᏗᏎᏍᏗᏍᎩ ᎤᏙᏢᏒᎢ. ᎾᎿᏃ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏓᎵᏂᎩᏓ ᏧᏦᏎᏗ ᏂᏚᏍᏗᏓᏅᎢ ᎠᏲᏍᏗᏍᎬᎢ ᎬᏗ ᎾᏍᎩ GPS ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎠᏓᏅᏍᏗ ᎤᏍᎩ ᎠᏍᏚᎢᏓ ᎢᎬᎾᏕᎾ ᎠᎴᏃ ᏙᏯᏗᏨ ᏱᏙᎯᎧᎲᎦ ᏣᏤᎵ GPS.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you haven't found answers to your questions within the helpful articles in this app, you can chat with a Motorola representative during the hours listed below.">
                <langSet xml:lang="en-US"><tig><term>If you haven't found answers to your questions within the helpful articles in this app, you can chat with a Motorola representative during the hours listed below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎥᏝᏃ ᎤᏩᏛᎲᎩ ᏱᎩ ᏗᎦᏬᎯᎵᏴᏍᏓ ᎾᎢ ᏣᏤᎵ ᏗᏛᏛᎮᎸᏓ ᎠᏫᏂᏗᏢ ᎾᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᏚᏓᏡᏅᏒᎢ ᎾᎿᎢ ᎯᎠ ᎬᏙᏗ, ᏂᎯ ᏰᎵᏊ ᎦᏬᏂᎯᏍᏗ ᎬᏗ Motorola ᏗᎦᎳᏫᎩ ᎾᎯᏳᎢ ᎾᏍᎩ ᎢᏧᏟᎶᏓ ᏕᎦᏅᏛ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="CHECK">
                <langSet xml:lang="en-US"><tig><term>CHECK</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏎᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Upload test total time">
                <langSet xml:lang="en-US"><tig><term>Upload test total time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎵᏙᏓ ᎠᎦᏛᏗ ᏂᎦᏛ ᎦᏟᏌᏅ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Attachments cannot exceed 20MB.">
                <langSet xml:lang="en-US"><tig><term>Attachments cannot exceed 20MB.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏠᏯᏍᏛᎢ ᎨᏍᏗ ᏰᎵ ᎤᎶᏒᏍᏛᎢ 20MB.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure your camera is clean and nothing is blocking it. Can you see what it's capturing?">
                <langSet xml:lang="en-US"><tig><term>Make sure your camera is clean and nothing is blocking it. Can you see what it's capturing?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᏨᎤᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎨᎡᎩ ᏧᏓᏅᎦᎸᏓ ᏃᎴ ᎠᏎᏉᏉ ᎨᎡᎢ ᎠᏍᏚᎲ it. ᏰᎴᏯ ᏂᎯ ᎠᎪᏩᏛᏗ ᎦᏙᎤᏍᏗ ᎨᎡᎢ ᎦᏂᏴᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio effects identifies content and automatically chooses the best profile">
                <langSet xml:lang="en-US"><tig><term>Audio effects identifies content and automatically chooses the best profile</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᏕᎪᏟᏍᏗᏍᎪᎢ ᏕᎸᏛᎢ ᏃᎴ ᎤᏩᏌ ᎢᏯᏛᏁᎯ ᏓᏑᏰᏍᎬᎢ ᎾᏍᎩ ᏫᏓᏤᏢ ᏧᏓᏟᎶᏍᏔᏅᎯ ᎤᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio effects delivers a premium listening experience through your phone\’s loudspeakers and connected devices.You can also create custom profiles for each audio device. Each time you connect a device, Audio effects will remember the last settings you used.">
                <langSet xml:lang="en-US"><tig><term>Audio effects delivers a premium listening experience through your phone\’s loudspeakers and connected devices.You can also create custom profiles for each audio device. Each time you connect a device, Audio effects will remember the last settings you used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᏫᏓᏤᏢ ᏂᏕᎬᏁᎰᎢ ᏕᏣᏛᏓᏍᏛ ᏣᎦᏙᎲᏒᎢ ᎤᎶᎯᏍᏗ ᏣᏤᎵ ᏗᎳᏃᎮᏗ\’s ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᏃᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᎪᏒᏗ ᏄᏍᏛ ᏱᏗᎬᏁᎸᎯ ᏧᎾᏓᏟᎶᏍᏔᏅᎯ ᎾᏍᎩᎾ ᏌᏊᎭ ᎤᏃᏴᎬ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᏓᏟᏱᎵᏒᎢ ᏂᎯ ᎱᏓᎸᎥᏍᎬ ᏥᏂᎬᏅᏗᏓᎾ, ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎠᏎᎢ ᏛᏅᏓᏗ ᎾᏍᎩ ᎣᏂ ᏕᎦᎧᎲᎢ ᏂᎯ ᏕᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio effects delivers a premium listening experience through your phone\’s loudspeaker and connected devices.You can also create custom profiles for each audio device. Each time you connect a device, Audio effects will remember the last settings you used.">
                <langSet xml:lang="en-US"><tig><term>Audio effects delivers a premium listening experience through your phone\’s loudspeaker and connected devices.You can also create custom profiles for each audio device. Each time you connect a device, Audio effects will remember the last settings you used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᏫᏓᏤᏢ ᏂᏕᎬᏁᎰᎢ ᏕᏣᏛᏓᏍᏛ ᏣᎦᏙᎲᏒᎢ ᎤᎶᎯᏍᏗ ᏣᏤᎵ ᏗᎳᏃᎮᏗ\’s ᎠᏍᏓᏯ ᎦᏬᏂᎯᏍᏙᏗ ᏃᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᎪᏒᏗ ᏄᏍᏛ ᏱᏗᎬᏁᎸᎯ ᏧᎾᏓᏟᎶᏍᏔᏅᎯ ᎾᏍᎩᎾ ᏌᏊᎭ ᎤᏃᏴᎬ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᏓᏟᏱᎵᏒᎢ ᏂᎯ ᎱᏓᎸᎥᏍᎬ ᏥᏂᎬᏅᏗᏓᎾ, ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎠᏎᎢ ᏛᏅᏓᏗ ᎾᏍᎩ ᎣᏂ ᏕᎦᎧᎲᎢ ᏂᎯ ᏕᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Whether you’re streaming a movie, listening to music, or playing a game, Audio effects presets help you enjoy rich and engaging sound.">
                <langSet xml:lang="en-US"><tig><term>Whether you’re streaming a movie, listening to music, or playing a game, Audio effects presets help you enjoy rich and engaging sound.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏃᏊᏥᎩ ᎠᏥᎢᎵᏒᎢ ᎠᏓᏴᎳᏛᏍᎬᎢ, ᎤᎾᏛᏓᏍᏛ ᎾᎢ ᏗᎧᏃᎩᏍᏛ, ᎠᎴᏃ ᏓᏁᎶᎲᏍᎬ ᏗᏁᎶᏙᏗ, ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎦᎧᎲᏍᏗ ᏂᎯ ᏥᏍᏕᎵᏍᎩ ᎠᎵᎮᎵᏍᏗ ᎤᏣᏘ ᏃᎴ ᎤᎵᎶᎯ ᎠᏛᎪᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Active for ^1">
                <langSet xml:lang="en-US"><tig><term>Active for ^1</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏛᏁᎲ ᎾᏍᎩᎾ ^1</term></tig></langSet>
            </termEntry>
