                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="SD card was removed while still in use!">
                <langSet xml:lang="en-US"><tig><term>SD card was removed while still in use!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SD ᏆᎾᏲᏍᏗ ᎨᏎᎢ ᎠᎲᏍᏓ ᎾᎯᏳᎢ ᎠᏏᏉ ᎾᎿ ᎬᏔᏂᏓᏍᏗ!</term></tig></langSet>
            </termEntry>
            <termEntry id="When the screen is off, unlock by touching the fingerprint sensor.">
                <langSet xml:lang="en-US"><tig><term>When the screen is off, unlock by touching the fingerprint sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>When the screen is off, unlock by touching the fingerprint sensor. ᎠᏴᏙᎸᏛᎢ ᎠᏍᏚᏗ, ᎭᏐᎭᎾᎳᎩ ᎠᏒᏂᏍᏗ ᎦᏰᏒᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This helps protect data on lost or stolen devices.">
                <langSet xml:lang="en-US"><tig><term>This helps protect data on lost or stolen devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏓᎵᏍᏕᎵᏍᎪ ᎠᎵᏍᏕᎸᏙᏗ ᎦᏟᏌᏅᎯ ᎤᎾᎢ ᎤᏂᏲᎱᏎᎸ ᎠᎴᏃ ᎦᏃᏍᎩᏓ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Require pattern to start your device?">
                <langSet xml:lang="en-US"><tig><term>Require pattern to start your device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᏗᏟᎶᏍᏙᏗ ᎾᎢ ᎠᏂᎩᏍᏙᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="You can further protect this device by requiring your password before it starts up.">
                <langSet xml:lang="en-US"><tig><term>You can further protect this device by requiring your password before it starts up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎸᏙᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᏎᎾᏛᏁᎮᏍᏗ ᏣᏤᎵ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎤᏓᎷᎸ ᎾᏍᎩ ᏓᏂᎩᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Images used to create your child\u2019s fingerprint model are never stored, but the fingerprint model is stored securely on the phone and never leaves the phone.">
                <langSet xml:lang="en-US"><tig><term>Images used to create your child\u2019s fingerprint model are never stored, but the fingerprint model is stored securely on the phone and never leaves the phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᎬᏔᏅᎯ ᎪᏢᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎨᏒᎢ ᏞᏍᏗ ᎢᎸᎯᏳᎢ ᎠᏍᏆᏂᎪᏔᏅ, ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᏄᎾᏰᎯᏍᏛᎾ ᎤᎿᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᎠᎴ ᎢᎸᎯᏳᎢ ᏧᎦᎶᎦ ᏥᎩ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
