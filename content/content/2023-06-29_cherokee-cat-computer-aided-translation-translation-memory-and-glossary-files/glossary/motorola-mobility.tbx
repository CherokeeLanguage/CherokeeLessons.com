            <termEntry id="Do you agree to turn on your mobile data for the testing?">
                <langSet xml:lang="en-US"><tig><term>Do you agree to turn on your mobile data for the testing?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍ ᎣᏏ ᏣᏰᎸᏅᎢ ᎾᎢ ᎠᏍᏚᎢᏓ ᏣᏤᎵ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾ ᎠᏂᎪᎵᏰᏍᎬᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn’t get warranty info. Tap to authorize.">
