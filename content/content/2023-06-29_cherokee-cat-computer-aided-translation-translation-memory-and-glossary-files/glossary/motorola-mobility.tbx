                <langSet xml:lang="en-US"><tig><term>Version\</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏓᎴᏒᎢ\</term></tig></langSet>
            </termEntry>
            <termEntry id="Use stylus button to control media playback">
                <langSet xml:lang="en-US"><tig><term>Use stylus button to control media playback</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᏗᎪᏪᎳᏅ ᎠᏐᎥᏍᏙᏗ ᎾᎢ ᎠᎯᎸᏍᏗ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏥᎭᏏᏅᏍᏓ ᏗᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Saver is on">
