            <termEntry id=" credentials have been added to Wi-Fi saved networks.">
                <langSet xml:lang="en-US"><tig><term> credentials have been added to Wi-Fi saved networks.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏍᏆᏂᎪᏙᏗ ᎤᎭ ᏄᎵᏍᏔᏅ ᎧᏁᏉᏓ ᎾᎿᎢ Wi-Fi ᎠᎵᏏᏅᏔᏅᎢ ᏚᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
