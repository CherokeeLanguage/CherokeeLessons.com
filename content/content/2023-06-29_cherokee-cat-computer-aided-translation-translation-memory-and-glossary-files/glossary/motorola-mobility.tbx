            <termEntry id="Ask Alexa">
                <langSet xml:lang="en-US"><tig><term>Ask Alexa</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏴᏛᏛᎲᎦ Alexa</term></tig></langSet>
            </termEntry>
            <termEntry id="If you feel that is too sensitive, please set the level to medium">
