                <langSet xml:lang="chr"><tig><term>ᎮᎵᏍᎬ ᎠᏒᏅᏍᏗᎢ ᎤᎪᏗ ᏱᎩ, ᎦᎧᎲᎢ ᎠᏰᎵᏇ ᎢᏯ ᎯᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="ThinkShield for mobile">
