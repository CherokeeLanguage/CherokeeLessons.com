                <langSet xml:lang="chr"><tig><term>ᎠᏥᏱᏍᎬ ᎥᎿᎢ ᎾᏍᎩ ᏧᏂᎦᏘᏗᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the switch button to move between both options">
