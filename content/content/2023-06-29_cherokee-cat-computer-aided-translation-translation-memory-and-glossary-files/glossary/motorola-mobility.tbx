                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
