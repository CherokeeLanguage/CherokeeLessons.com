                <langSet xml:lang="chr"><tig><term>HDR ᎨᏎᏍᏗ ᎠᏍᏚᏗ ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᎤᏍᏆᎳ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can do even more from the power button menu. Just tap for quick access to your wallet, Google Home controls, and more.">
                <langSet xml:lang="en-US"><tig><term>Now you can do even more from the power button menu. Just tap for quick access to your wallet, Google Home controls, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏂᎯ ᏰᎵᏊ ᏱᎬᎩ ᎥᏍᏊ ᎤᏥ ᎢᎦᎢ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎤᏟᏂᎩᏓ ᎠᏐᏅᏍᏙᏗ ᎪᏪᎳᎾᎥᎢ. ᏍᎩᏋ ᎭᏐᎥᏍᏓ ᎾᏍᎩᎾ ᎤᏟᏍᏓ ᎠᏴᏍᏗ ᎾᎢ ᏣᏤᎵ ᎠᏕᎳ ᏗᎦᎸᏙᏗ, Google ᏧᏪᏅᏒ ᏗᎯᎸᏍᏗ, ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera anytime">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᎸᎯᏳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Timelapse mode active">
                <langSet xml:lang="en-US"><tig><term>Timelapse mode active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᎦᏃᎳ ᎠᏥᎢᎵᏒ ᏗᏓᏥᎶᏍᏔᏅᎯ ᎬᏙᏗᎭ ᎠᎵᏖᎸᎲᏍᎩ</term></tig></langSet>
            </termEntry>
