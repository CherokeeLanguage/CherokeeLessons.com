            <termEntry id="Audio effects detects when you’re in a noisy environment and improves the clarity of dialogue in podcasts, videos, and games">
                <langSet xml:lang="en-US"><tig><term>Audio effects detects when you’re in a noisy environment and improves the clarity of dialogue in podcasts, videos, and games</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᏗᏕᎳᎰᏍᎩ ᎾᎯᏳ ᎤᏃᏴᎵᏓ ᏄᏍᏛᎢ ᎮᏙᎲᎢ ᎠᎴ ᎾᏍᎩ ᏗᏤᎳᏍᏙᏗ ᎾᏍᎩ ᎬᏂᎨᏒᎢ ᏗᏟᏃᎮᏓ ᎾᎿᎢ ᏆᏗ ᏗᎦᏃᏣᎵᏍᎩ, ᏗᏓᏴᎳᏛᏍᎩ, ᎠᎴ ᏧᎾᏁᎶᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor at the bottom of the screen">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor at the bottom of the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎠᏩᏘᏍᎩ ᎤᎿᎢ ᎡᎳᏗᏢ ᎥᎿᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can unlock, log in, and make payments with your fingerprint">
                <langSet xml:lang="en-US"><tig><term>Now you can unlock, log in, and make payments with your fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᏰᎵᏊ ᎠᏂᏐᎭᎾᎳᎩ, ᎯᏴᏍᏗ, ᎠᎴ ᎪᏢᏗ ᏗᏈᏴᎲᏍᏗ ᎬᏗ ᏂᏨᏅᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio effects delivers a premium listening experience through your phone\’s loudspeakers and connected devices.">
                <langSet xml:lang="en-US"><tig><term>Audio effects delivers a premium listening experience through your phone\’s loudspeakers and connected devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᏫᏓᏤᏢ ᏂᏕᎬᏁᎰᎢ ᏕᏣᏛᏓᏍᏛ ᏣᎦᏙᎲᏒᎢ ᎤᎶᎯᏍᏗ ᏣᏤᎵ ᏗᎳᏃᎮᏗ\’s ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You may need to see the instructions that came with that device.">
