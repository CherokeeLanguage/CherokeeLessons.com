                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎡᎷᏪ ᏅᎦ ᎦᏃᏟᏍᏗᏍᎩ ᎾᎯᏳ ᎦᎷᎬ ᏗᏟᏃᎮᏗ ᏗᏅᏗᏍᎬ ᎾᏍᎩ ᎥᏌᎳᏗᏍᎬ ᏗᏟᏃᎮᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For example, asthma">
