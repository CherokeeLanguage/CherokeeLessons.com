            </termEntry>
            <termEntry id="Make a chopping motion twice to turn the flashlight on and off">
                <langSet xml:lang="en-US"><tig><term>Make a chopping motion twice to turn the flashlight on and off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎷᏱᏓᏍᏗ ᎠᏌᎳᏙᏗ ᎤᏃᏢᏗᏱ ᏔᎵ ᎢᏳᏩᎫᏗ ᎠᎦᏔᎲᏍᏗ ᏥᎩ ᎠᏨᏍᏗ ᎤᎿᎢ ᎠᎴ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Do Not Disturb by turning the phone face down">
                <langSet xml:lang="en-US"><tig><term>Turn on Do Not Disturb by turning the phone face down</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏞᏍᏗ ᏣᏓᏕᏯᏙᏔᏅᎢ ᎬᏗ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᎡᎳᏗᏟ ᎯᎦᏔᎲᏍᏓ ᏭᎧᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the screen with three fingers to take a screenshot">
                <langSet xml:lang="en-US"><tig><term>Touch the screen with three fingers to take a screenshot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏒᏂᏍᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᏦᎢ ᏕᎦᏰᏌᏛ ᎬᏗ ᎠᏓᏴᎳᏔᏍᎩ ᏗᏥᎶᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharge protection">
                <langSet xml:lang="en-US"><tig><term>Overcharge protection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᏓᎵᏍᎦᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Find better ways to get things done">
                <langSet xml:lang="en-US"><tig><term>Find better ways to get things done</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏩᏔ ᏱᏗᎬᏁᏗ ᎣᏍᏓ ᎾᎿᎢ ᎢᏳᏍᏗ ᎠᏍᏆᏗᏍᏗ ᎠᎩᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn the flashlight on/off with two chopping motions. This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>Turn the flashlight on/off with two chopping motions. This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎠᏨᏍᏗ ᎯᏨᏍᏛᎦ/ᎲᏜᏓ ᎤᏠᏯᏍᏗ ᏔᎵ ᎯᏌᎳᏗᏍᎬ ᎯᎷᏍᎬᎢ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏚᏂᎸᏫᏍᏓᏁᎲᎢ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎠᏍᏚᎢᏍᎩ ᎠᎴ ᎠᏍᏚᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep the screen on while you're looking at it">
                <langSet xml:lang="en-US"><tig><term>Keep the screen on while you're looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᎠᏴᏙᎳᏛᎢ ᎤᎿᎢ ᎢᏳᏃ ᎠᎦᏖᏃᎲ ᎤᎿᎢ ᎨᎡᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Play a better way">
                <langSet xml:lang="en-US"><tig><term>Play a better way</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗᎢ ᎣᏍᏓ ᏳᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a password">
                <langSet xml:lang="en-US"><tig><term>Set a password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎯᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="clock, military">
                <langSet xml:lang="en-US"><tig><term>clock, military</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏁᏍᎩ, ᎠᏂᏯᏫᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Place the phone face down to turn on Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>Place the phone face down to turn on Do Not Disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎳᏃᎮᏗ ᎤᏙᏢᏒ ᎡᎳᏗ ᏭᎧᏔ ᎾᎿᎢ ᎯᏍᏚᎢ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Overcharge protection">
                <langSet xml:lang="en-US"><tig><term>Use Overcharge protection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎦᎸᎳᏗ ᏗᎬᏩᎶᏙᏗ ᎠᏓᎵᏍᎦᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting in portrait opens the selfie camera. Twisting in landscape opens the rear camera.">
                <langSet xml:lang="en-US"><tig><term>Twisting in portrait opens the selfie camera. Twisting in landscape opens the rear camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᎾᎿ ᎠᏰᎵ ᎠᎪᏩᏛᏙᏗ ᏓᏍᏚᎢ ᏥᎩ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᎠᏓᏄᏖᏲᎭ ᎾᎿ ᎦᏅᎯᏒᎢ ᏓᏍᏚᎢ ᏥᎩ ᎣᏂᏗᏨ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
