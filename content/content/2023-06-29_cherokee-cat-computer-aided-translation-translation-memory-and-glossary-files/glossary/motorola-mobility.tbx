            </termEntry>
            <termEntry id="If you enter an incorrect PIN on the next attempt, this device\u2019s data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect PIN on the next attempt, this device\u2019s data will be deleted.</term></tig></langSet>
