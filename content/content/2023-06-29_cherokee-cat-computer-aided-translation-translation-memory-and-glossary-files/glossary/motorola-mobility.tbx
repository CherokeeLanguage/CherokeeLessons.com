            <termEntry id="You and your child can delete their fingerprint images and model, or turn off Fingerprint Unlock at any time in Settings.">
                <langSet xml:lang="en-US"><tig><term>You and your child can delete their fingerprint images and model, or turn off Fingerprint Unlock at any time in Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏍᎪᎸᏗᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏚᏓᏴᎳᏛ ᎠᎴ ᎪᎱᏍᏗ, ᎠᎴ ᎠᏍᏚᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone encrypted">
                <langSet xml:lang="en-US"><tig><term>Phone encrypted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᏕᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Encryption &amp; credentials">
                <langSet xml:lang="en-US"><tig><term>Encryption &amp; credentials</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏙᏗ &amp; ᏧᎦᏙᎲᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="This helps protect data on lost or stolen devices.">
                <langSet xml:lang="en-US"><tig><term>This helps protect data on lost or stolen devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏓᎵᏍᏕᎵᏍᎪ ᎠᎵᏍᏕᎸᏙᏗ ᎦᏟᏌᏅᎯ ᎤᎾᎢ ᎤᏂᏲᎱᏎᎸ ᎠᎴᏃ ᎦᏃᏍᎩᏓ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Until the device starts up, it can\u2019t receive calls, messages, or notifications, including alarms.">
                <langSet xml:lang="en-US"><tig><term>Until the device starts up, it can\u2019t receive calls, messages, or notifications, including alarms.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎩᎳ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏂᎩᏍᏒᎢ, ᎾᏍᎩ ᏝᏰᎵ\u2019 ᎬᎩᏍᏗ ᏙᏓᏳᏅᏔᏅᎢ, ᏗᎧᏃᎮᏍᎩ, ᎠᎴᏃ ᏗᏓᏃᏣᎳᏁᎯ, ᎤᏠᏯᏍᏗ ᏗᏓᏕᏯᏙᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call cannot be placed due to your  calls.">
                <langSet xml:lang="en-US"><tig><term>Call cannot be placed due to your  calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎠll cᎠnᏃt bᎡ pᎳcᎡd ᏚᎡ tᎣ ᏲᎤr  ccᎠllᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="Continue without Face Unlock">
                <langSet xml:lang="en-US"><tig><term>Continue without Face Unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒ ᏄᏠᏯᏍᏛᎾ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint + Pattern">
                <langSet xml:lang="en-US"><tig><term>Fingerprint + Pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ + ᎤᎾᎶᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Audio feature">
                <langSet xml:lang="en-US"><tig><term>Moto Audio feature</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎤᏃᏴᎬ ᎤᏩᎬᏗᏗᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Require PIN to start your device?">
                <langSet xml:lang="en-US"><tig><term>Require PIN to start your device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ PIN ᎾᎢ ᏓᏂᎩᏍᏙᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Set data limit">
                <langSet xml:lang="en-US"><tig><term>Set data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face Unlock + PIN">
                <langSet xml:lang="en-US"><tig><term>Face Unlock + PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ + PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Continue without fingerprint">
                <langSet xml:lang="en-US"><tig><term>Continue without fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒ ᏄᏠᏯᏍᏛᎾ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Government Alert">
                <langSet xml:lang="en-US"><tig><term>Government Alert</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵ ᎤᏙᏢᏒ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock with your face">
                <langSet xml:lang="en-US"><tig><term>Unlock with your face</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩ ᎬᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="In addition to using your fingerprint to unlock your device, you can further protect this device by requiring your pattern before it starts up.">
                <langSet xml:lang="en-US"><tig><term>In addition to using your fingerprint to unlock your device, you can further protect this device by requiring your pattern before it starts up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎧᏁᏉᏍᏓ ᎾᎢ ᎬᏗᏍᎬ ᏣᏤᎵ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎾᎢ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᏂᎯ ᏰᎵᏊ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎸᏙᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᏎᎾᏛᏁᎮᏍᏗ ᏣᏤᎵ ᏗᏟᎶᏍᏙᏗ ᎤᏓᎷᎸ ᎾᏍᎩ ᏓᏂᎩᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" will be able to see information about callers not in your contacts and will be able to block these calls.">
                <langSet xml:lang="en-US"><tig><term> will be able to see information about callers not in your contacts and will be able to block these calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> Ꮻll bᎡ ᎠbᎴ tᎣ ᏎᎡ ᎢnfᎣrᎹᏘᎣn ᎠbᎣᎤt cᎠlᎴrᏍ Ꮓt Ꭲn ᏲᎤr cᎣnᏔctᏍ Ꭰnd Ꮻll bᎡ ᎠbᎴ tᎣ bᎶck tᎮᏎ cᎠllᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your face to unlock your phone or approve purchases.">
                <langSet xml:lang="en-US"><tig><term>Use your face to unlock your phone or approve purchases.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ your ᎧᏁᏉᏍᏗᏍᎬ to ᎠᏂᏐᎭᎾᎳᎩ your ᏗᏟᏃᎮᏗ or ᎪᎯᏳᏙᏗ ᏗᏩᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For more information, contact your organization\u2019s admin.">
