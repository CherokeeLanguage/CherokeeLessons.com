            </termEntry>
            <termEntry id="Dual time">
                <langSet xml:lang="en-US"><tig><term>Dual time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏐᏱ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="GOT IT">
                <langSet xml:lang="en-US"><tig><term>GOT IT</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Under demo mode, password is needed to do factory reset.">
                <langSet xml:lang="en-US"><tig><term>Under demo mode, password is needed to do factory reset.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏫᏂᏗᏢ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎬᏙᏗ, ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎨᎡᎢ ᎤᏚᎸᏛ ᎾᎿᎢ ᎤᏃᏢᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure you want to run Verizon store demo mode? To exit this mode, a factory data reset is required and all user information and files will be erased">
                <langSet xml:lang="en-US"><tig><term>Are you sure you want to run Verizon store demo mode? To exit this mode, a factory data reset is required and all user information and files will be erased</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎩ ᏂᎯ ᎤᏙᎯᏳ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎠᏓᎾᏫᏍᏗ Verizon ᎠᏓᎾᏅ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎬᏙᏗ? ᎾᎿᎢ ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎬᏙᏗ, Ꭰ ᎤᏃᏢᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏥᎯᎧᎲᎦ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᏃᎴ ᏂᎦᏓ ᎬᏗᏍᎩ ᎧᏃᎮᏢᏗ ᏃᎴ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏎ ᎨᎡᎢ ᎤᏍᎪᎸᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 total • background less than a minutefor past 24 hr">
                <langSet xml:lang="en-US"><tig><term>^1 total • background less than a minutefor past 24 hr</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᏂᎦᏛ ᎦᏟᏌᏅ • ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᏩᎦᏲᏢ ᎢᏯᏛᏬᏍᏔᏅᎯᎾᏍᎩᎾ ᎨᏎᎢ 24 hr</term></tig></langSet>
            </termEntry>
            <termEntry id="A Video call cannot be added at this time.">
                <langSet xml:lang="en-US"><tig><term>A Video call cannot be added at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᏊᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling and RTT keyboard cannot be on at the same time. RTT keyboard will be turned off.">
                <langSet xml:lang="en-US"><tig><term>Video calling and RTT keyboard cannot be on at the same time. RTT keyboard will be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᏃᎴ RTT ᏗᏐᏅᏍᏙᏗ ᎨᏍᏗ ᏰᎵ ᎠᏍᏚᎢᏓ ᎾᎿᎢ ᎾᏍᎩ ᎾᎯᏳᏉ ᎠᏥᎢᎵᏒ. RTT ᏗᏐᏅᏍᏙᏗ ᎠᏎ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Data Usage that you set on your device has reached its limit. Your Video call requires data. To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.">
                <langSet xml:lang="en-US"><tig><term>Your Data Usage that you set on your device has reached its limit. Your Video call requires data. To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎥᏍᎩᎾ ᏂᎯ ᎦᎧᎲᎢ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ ᏭᎷᏨᎩ ᎨᎡᎢ ᎠᏎᎸᎯ. ᏂᏨᎤᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎠᏎᏳᎾᏛᏁᏗ ᎦᏘᏍᎩᏌᏅᎯ. ᎾᎿᎢ ᎠᎦᏎᏍᏔᏅ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ, ᎡᏅᏍᏙᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ &gt; ᏧᎾᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ &gt; ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't remind me again">
                <langSet xml:lang="en-US"><tig><term>Don't remind me again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏅᏓᏗᏍᏙᏗ ᎠᏯ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on data roaming">
                <langSet xml:lang="en-US"><tig><term>Turn on data roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Mobile Data">
                <langSet xml:lang="en-US"><tig><term>Turn on Mobile Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will not be able to make or receive HD voice and video calls when you turn this setting off.">
                <langSet xml:lang="en-US"><tig><term>Your phone will not be able to make or receive HD voice and video calls when you turn this setting off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎪᏒᏗ ᏃᎴ ᎠᎩᏍᏗ HD ᎧᏁᎬ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎯᎠ ᏕᎦᎧᎲᎢ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When using the Verizon Wireless network, the voice portion of a video call will appear on your bill as mobile-to-mobile voice usage, and the video portion will be billed as data.When Video calling is turned on, others can see that your phone has Video calling.">
                <langSet xml:lang="en-US"><tig><term>When using the Verizon Wireless network, the voice portion of a video call will appear on your bill as mobile-to-mobile voice usage, and the video portion will be billed as data.When Video calling is turned on, others can see that your phone has Video calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏗᎭ ᏥᎩ Verizon Wireless ᏧᎾᏚᏓᎵ, ᏥᎩ ᎧᏁᎬ ᎢᎦᏛ ᎾᎿ Ꭰ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎠᏎ ᎬᏂᎨᏒᎢ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏓᏚᎬᎢ ᎾᎿ ᎠᏂᎩᏍᎩ-ᎾᎿᎢ-ᎠᏂᎩᏍᎩ ᎧᏁᎬ ᎬᏗᏍᎬ, ᏃᎴ ᏥᎩ ᏗᏓᏴᎳᏛᏍᎩ ᎢᎦᏛ ᎠᏎ ᎨᎡᎢ ᎠᏎᎯᎯ ᎢᎦ ᎠᏓᏚᏅᎢ ᎤᎿᎢ ᎦᏘᏍᎩᏌᏅᎯ.ᎢᏳᏃ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᎢ, ᏐᎢ ᏰᎵᏯ ᎯᎪᏩᏔ ᎥᏍᎩᎾ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏂᏚᏩᎿ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="can't receive video calls at this time.">
                <langSet xml:lang="en-US"><tig><term>can't receive video calls at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎤᎿᎢ ᎯᎠ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will not be able to make or receive video calls when you turn this setting on.">
                <langSet xml:lang="en-US"><tig><term>Your phone will not be able to make or receive video calls when you turn this setting on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎪᏒᏗ ᏃᎴ ᎠᎩᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎯᎠ ᏕᎦᎧᎲᎢ ᎠᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will not be able to make or receive video calls when you turn this setting off.">
                <langSet xml:lang="en-US"><tig><term>Your phone will not be able to make or receive video calls when you turn this setting off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎪᏒᏗ ᏃᎴ ᎠᎩᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎯᎠ ᏕᎦᎧᎲᎢ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To make video calls, Mobile data roaming needs to be turned on. Would you like to turn it on?">
                <langSet xml:lang="en-US"><tig><term>To make video calls, Mobile data roaming needs to be turned on. Would you like to turn it on?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎪᏒᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ, ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏓᏍᏗ ᏧᏚᎸᏓ ᎾᎿᎢ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᎢ. ᏯᏓᎯᏗᏏ ᏂᎯ ᎤᎸᏉᏔᏅ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ it ᎠᎢ?</term></tig></langSet>
            </termEntry>
