            </termEntry>
            <termEntry id="Back Sensitivity">
                <langSet xml:lang="en-US"><tig><term>Back Sensitivity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ ᎠᏒᏅᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gesture Settings">
                <langSet xml:lang="en-US"><tig><term>Gesture Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏬᏯᏂᏍᎩ ᏕᎦᎧᎲᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="gesture navigation, back sensitivity, back gesture">
                <langSet xml:lang="en-US"><tig><term>gesture navigation, back sensitivity, back gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏬᏯᏂᏍᎩ ᎠᏓᏘᏂᏙᎯ, ᎠᏨᏍᏗ ᎤᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Higher sensitivity may conflict with any app gestures along the edges of the screen.">
                <langSet xml:lang="en-US"><tig><term>Higher sensitivity may conflict with any app gestures along the edges of the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨᏍᏗ ᎠᏒᏅᏍᏗᎢ ᏰᎵᏯ ᏂᏓᏙᎵᎬᎾ ᎬᏗ ᎾᏂᎥᏉ ᎬᏙᏗ ᎤᏬᏯᏂᏍᎩ ᎦᎸᏩᎳᏗᏒ ᏥᎩ ᎠᏍᏛᎢ ᎾᎿ ᏥᎩ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Double-tap to check tablet">
                <langSet xml:lang="en-US"><tig><term>Double-tap to check tablet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎪᏘ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎪᏪᎶᏗ ᏗᎪᏪᎶᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="One-handed mode">
                <langSet xml:lang="en-US"><tig><term>One-handed mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏇ-ᏭᏓᏁᎸᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use one-handed mode">
                <langSet xml:lang="en-US"><tig><term>Use one-handed mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏌᏇ-ᏭᏓᏁᎸᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down to">
                <langSet xml:lang="en-US"><tig><term>Swipe down to</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎡᎳᏗᏟ ᎾᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the shortcut to">
                <langSet xml:lang="en-US"><tig><term>Use the shortcut to</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᏍᏆᎳ ᎢᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="App label">
                <langSet xml:lang="en-US"><tig><term>App label</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᏴᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Double-tap to check phone">
                <langSet xml:lang="en-US"><tig><term>Double-tap to check phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎪᏘ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎪᏪᎶᏗ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Double-tap to check device">
                <langSet xml:lang="en-US"><tig><term>Double-tap to check device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎪᏘ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎪᏪᎶᏗ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Notifications and settings will appear.">
                <langSet xml:lang="en-US"><tig><term>Notifications and settings will appear.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏓᏃᏣᎳᏁᎯ ᎠᎴ ᏕᎦᎧᎲᎢ ᎠᏎ ᎬᏂᎨᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lift to check phone">
                <langSet xml:lang="en-US"><tig><term>Lift to check phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎳᏙᏗ ᎾᎿᎢ ᎪᏪᎶᏗ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wake up display">
                <langSet xml:lang="en-US"><tig><term>Wake up display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏰᎩ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off adaptive brightness while you're gaming">
                <langSet xml:lang="en-US"><tig><term>Turn off adaptive brightness while you're gaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏓ ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᎤᏍᎪᏍᏗᏴ ᎾᎯᏳᎢ ᎨᎡᎩ ᏕᎭᏁᎸᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Loading image...">
                <langSet xml:lang="en-US"><tig><term>Loading image...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏢᏍᎬ ᎤᏓᏴᎳᏛ...</term></tig></langSet>
            </termEntry>
            <termEntry id="To use this feature, make sure gesture navigation is turned on in system navigation settings.">
                <langSet xml:lang="en-US"><tig><term>To use this feature, make sure gesture navigation is turned on in system navigation settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎯᎠ ᎤᏩᎬᏗᏗᏒ, ᎪᏢᏗ ᎤᏙᎯᏳ ᎤᏬᏯᏂᏍᎩ ᎠᏓᏘᏂᏙᎯ ᎨᎡᎩ ᏭᎪᎸᏍᏔᏁᎢ ᎤᎿᎢ ᎾᎿ ᏄᏍᏗᏓᏅᎢ ᎠᏓᏘᏂᏙᎯ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This ^1 appears to be slow. You can continue, but apps moved to this location may stutter and data transfers may take a long time. Consider using a faster ^1 for better performance.">
                <langSet xml:lang="en-US"><tig><term>This ^1 appears to be slow. You can continue, but apps moved to this location may stutter and data transfers may take a long time. Consider using a faster ^1 for better performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ^1 ᏂᎬᏩᏍᏓ ᎾᎿᎢ ᎨᎡᎢ ᎤᏍᎦᏃᎵ. ᏂᎯ ᏰᎵᏯ ᏂᎦᏯᎢᏒ, ᎠᏎᏃ ᏗᎬᏙᏗ ᎤᎲᏒ ᎾᎿᎢ ᎯᎠ ᎤᏙᏢᏒᎢ ᏰᎵᏯ ᎧᏁᎬ ᎤᏲᏍᏓᏁᎯ ᎠᎵ ᎦᏘᏍᎩᏌᏅᎯ ᏙᏓᏰᏣᏲᎯᏎᎵ ᏰᎵᏯ ᎠᎩᏍᏗ Ꭰ ᎦᏅᎯᏓ ᎠᏥᎢᎵᏒ. ᎭᏓᏅᏛᎵ ᎬᏗᎭ Ꭰ ᎦᏣᎸᎳᎯᎨ ^1 ᎤᎬᏩᏟ ᏓᏤᎳ ᎾᎾᏛᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to check phone">
                <langSet xml:lang="en-US"><tig><term>Tap to check phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏩᎪᏘ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎪᏪᎶᏗ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to check tablet">
                <langSet xml:lang="en-US"><tig><term>Tap to check tablet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏩᎪᏘ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎪᏪᎶᏗ ᏗᎪᏪᎶᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Decrease icon size">
                <langSet xml:lang="en-US"><tig><term>Decrease icon size</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎳᏗᏍᏗ ᎠᎢᎧᏂ ᎢᎩᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Locked mode">
                <langSet xml:lang="en-US"><tig><term>Locked mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏱ ᎠᏍᏚᎭ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Pull screen into reach">
                <langSet xml:lang="en-US"><tig><term>Pull screen into reach</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏌᏁᏍᏗ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎠᏙᏯᏅᎯᏗᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Open style settings">
                <langSet xml:lang="en-US"><tig><term>Open style settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᏍᏚᎢ ᎢᏳᏍᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning Bluetooth off\u2026">
                <langSet xml:lang="en-US"><tig><term>Turning Bluetooth off\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᎬ Bluetooth ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stock Photos">
                <langSet xml:lang="en-US"><tig><term>Stock Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎠᏍᏆᏂᎪᏛ ᏓᏓᏟᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="The objects are too close to the background to capture a portrait photo.">
                <langSet xml:lang="en-US"><tig><term>The objects are too close to the background to capture a portrait photo.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏧᏓᎴᏅᏓ ᎾᏍᎩᏃ ᎠᏍᏚᎭ ᎾᏍᎩ ᎤᎾᏗᏜ ᏄᏍᏗᏓᏅ ᎾᎢ ᎦᏂᏴᏗ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏔᏅ ᏗᏟᎶᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The top of the screen will move into reach of your thumb.">
                <langSet xml:lang="en-US"><tig><term>The top of the screen will move into reach of your thumb.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏩᎦᎸᎳᏗᏴ ᎾᎿ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎠᏎ ᎠᎲᏍᏗ ᎾᎿᎢ ᎠᏙᏯᏅᎯᏗᏍᏗ ᎾᎿ ᏂᏨᎤᎢ ᎠᏚᏂᎯ ᏯᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lift to check tablet">
                <langSet xml:lang="en-US"><tig><term>Lift to check tablet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎳᏙᏗ ᎾᎿᎢ ᎪᏪᎶᏗ ᏗᎪᏪᎶᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="No devices connected">
                <langSet xml:lang="en-US"><tig><term>No devices connected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏕᎫᏓᎸᎥᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To check time, notifications, and other info, pick up your tablet.">
                <langSet xml:lang="en-US"><tig><term>To check time, notifications, and other info, pick up your tablet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎦᏎᏍᏔᏅ ᎠᏥᎢᎵᏒ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᏐᎢ, ᎤᏬᏖᏒᎢ ᎭᏐᏅᏍᏓ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After you encrypt your phone, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the phone every time you power it on.">
                <langSet xml:lang="en-US"><tig><term>After you encrypt your phone, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the phone every time you power it on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᏂᎯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ, ᏃᎵᏍᎬᎢ ᏂᎯ\u2019ve ᏘᎧᎲᎦ Ꭰ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ (ᎥᏍᎩᎾ, Ꭰ ᎤᎾᎶᎢᏓ ᎠᎴ ᏗᏎᏍᏙᏗ PIN ᎠᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ), ᏂᎯ\u2019ll ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᏂᎪᎯᎸ ᏂᎯ ᎤᏟᏂᎩᏓ ᎾᎿ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Contact carrier for details.">
                <langSet xml:lang="en-US"><tig><term>Contact carrier for details.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᏃᎮᏙᏗ ᎠᏫᏗᏍᎩ ᎤᎬᏩᏟ ᏂᏕᎬᎿᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lift to check device">
                <langSet xml:lang="en-US"><tig><term>Lift to check device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎳᏙᏗ ᎾᎿᎢ ᎪᏪᎶᏗ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="This may allow the app to erase or modify Browser data.">
                <langSet xml:lang="en-US"><tig><term>This may allow the app to erase or modify Browser data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏉ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏛᏍᏍᎪᎸᏥ ᎤᎿ ᏍᏆᎳ ᎢᎬᏁᏗ ᏗᏍᏚᎢᏍᎩ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Encryption takes an hour or more.">
                <langSet xml:lang="en-US"><tig><term>Encryption takes an hour or more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᎠᎴ ᎤᎪᏗᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Encryption takes an hour or more, during which the tablet will restart several times.">
                <langSet xml:lang="en-US"><tig><term>Encryption takes an hour or more, during which the tablet will restart several times.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᎠᎴ ᎤᎪᏗᏊ, ᎾᎯᏳ ᎦᏙᎤᏍᏗ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎢᎸᏍᎩ ᎢᏳᏩᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi: ">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi: </term></tig></langSet>
            </termEntry>
            <termEntry id="USB: ">
                <langSet xml:lang="en-US"><tig><term>USB: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USB: </term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify the Browser's history or bookmarks stored on your phone.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify the Browser's history or bookmarks stored on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏍᏆᎳ ᎢᎬᏁᏗ ᏥᎩ ᏗᏍᏚᎢᏍᎩ ᏂᏧᎵᏍᏔᏅᏒ ᎤᎿ ᎪᏪᎵ ᎠᏩᏛᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎾᎿ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Needs notification access permission to continue.">
                <langSet xml:lang="en-US"><tig><term>Needs notification access permission to continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏴᏍᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᏂᎦᏯᎢᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="FM Radio requires the following permissions:">
                <langSet xml:lang="en-US"><tig><term>FM Radio requires the following permissions:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>FM ᎦᏬᏂᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏎᎢᏯᏛᏁᏗ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Data warning &amp; limit">
                <langSet xml:lang="en-US"><tig><term>Data warning &amp; limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᏓᏕᏯᏔᎲᏍᎩ &amp; ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch &amp; hold each time the fingerprint icon moves.">
                <langSet xml:lang="en-US"><tig><term>Touch &amp; hold each time the fingerprint icon moves.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ &amp; ᎯᏂᏯ ᎢᏧᎳ ᎠᏟᎢᎵᏒ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᎢᎧᏂ ᏓᎲᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: this permission may note be enforced by third-party browsers or other applications with web browsing capabilities.">
                <langSet xml:lang="en-US"><tig><term>Note: this permission may note be enforced by third-party browsers or other applications with web browsing capabilities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏗ ᎪᏪᎸ: ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏰᎵᏉ ᎤᏍᏗ ᎪᏪᎸ ᎨᏒᎩ ᎦᏌᏙᏯᏍᎩ ᎬᏗ ᏦᎢᏁ-ᎤᎾᏓᏟᏌᎲ ᏗᏍᏚᎢᏍᎩ ᎤᎿ ᏐᎢ ᏗᎬᏙᏗ ᎬᏗ ᎤᏂᎳᏛᎢ ᏓᏍᏚᎢᏍᎬ ᏰᎵ ᎢᏯᏛᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No lock screen PIN or password">
                <langSet xml:lang="en-US"><tig><term>No lock screen PIN or password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ PIN ᎠᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ</term></tig></langSet>
