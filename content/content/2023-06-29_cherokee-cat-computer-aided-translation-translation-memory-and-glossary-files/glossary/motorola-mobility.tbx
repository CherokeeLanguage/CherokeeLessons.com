            </termEntry>
            <termEntry id="Sender not in your contact list">
                <langSet xml:lang="en-US"><tig><term>Sender not in your contact list</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎦᏅᏍᎩ Ꮭ ᎾᎿ ᏂᏨᏅᎢ ᎠᏟᏃᎮᏙᏗ ᏕᎦᏅᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Welcome to T-MobileBot! We can help you in many ways, just ask me here! Cheers!">
                <langSet xml:lang="en-US"><tig><term>Welcome to T-MobileBot! We can help you in many ways, just ask me here! Cheers!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎬᏯᏓᏁᎸᎦ ᎾᎿᎢ T-MobileBot! ᏂᎦᏛᏉ ᏰᎵᏊ ᏱᏨᏍᏕᎸ ᏂᎯ ᎾᎿ ᎤᎪᏗᏗ ᏱᏗᎬᏁᏗ, ᏚᏳᎪᏛᏉ ᎠᏓᏛᏗ ᎠᏯ ᎠᎭᏂ! ᎠᏓᎦᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure to make  admin of the group and leave?">
                <langSet xml:lang="en-US"><tig><term>Are you sure to make  admin of the group and leave?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏒᎢ ᏂᎯ ᎤᏙᎯᏳ ᎾᎿᎢ ᎪᏢᏗ  ᎤᎦᏎᏍᏗᏕᎩ ᎾᎿᎢ ᏥᎩ ᎤᎾᏓᏡᎬᎢ ᎠᎴ ᎠᏂᎩᏍᎬ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Show my typing status to receiver">
                <langSet xml:lang="en-US"><tig><term>Show my typing status to receiver</term></tig></langSet>
