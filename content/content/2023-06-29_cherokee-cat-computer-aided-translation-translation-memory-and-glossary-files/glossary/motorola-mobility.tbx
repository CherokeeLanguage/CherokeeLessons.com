            <termEntry id="Choose an app below to start a video chat">
                <langSet xml:lang="en-US"><tig><term>Choose an app below to start a video chat</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ Ꭰ ᎬᏙᏗ ᎡᎳᏗᏨ ᎾᎿᎢ ᎭᎴᎾ Ꭰ ᏗᏓᏴᎳᏛᏍᎩ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Join millions of Motorola fans who receive exclusive information about product launches, events, tips, software updates, and much more!">
                <langSet xml:lang="en-US"><tig><term>Join millions of Motorola fans who receive exclusive information about product launches, events, tips, software updates, and much more!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏛᎵᎪᎲᏍᏏ ᏍᏈᏍᏗ Motorola ᎥᏂᏗᏍᎩ ᎠᏂᎩᏍᎩ ᎠᏓᏃᎯᏎᎯ ᎢᏤ ᎤᏂᎾᎥ, ᎾᏅᏛᏁᎭ, ᏗᏓᏃᎯᏎᎯ, ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᏙᏢᎯᏌ, ᎠᎴ ᏐᎢ ᏍᏈᏍᏗ ᎪᎱᏍᏗ</term></tig></langSet>
            </termEntry>
