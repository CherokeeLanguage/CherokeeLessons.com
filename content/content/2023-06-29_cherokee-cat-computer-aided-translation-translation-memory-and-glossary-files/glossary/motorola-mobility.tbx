                <langSet xml:lang="chr"><tig><term>ᏘᎧᎭᎦ ᏄᎾᏛᏁᎸᏅ ᎠᎦᏎᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you discard, changes will be lost.">
                <langSet xml:lang="en-US"><tig><term>If you discard, changes will be lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏱᏫᏣᏗᎾ, ᏗᎦᏁᏟᏴᏓ ᏦᏲᏎᎸ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Only applicable in case your device has been financed.">
                <langSet xml:lang="en-US"><tig><term>Only applicable in case your device has been financed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎤᏩᏒ ᏗᏓᏂᎸᎩ Ꮎ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎵᏍᏕᎸᏙᏗ ᎠᏕᎸ ᎬᏗ ᏱᏂᎬᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM Key">
                <langSet xml:lang="en-US"><tig><term>SIM Key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᎠᏍᏚᎢᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It locks the device to be used only with the Telcel network when associated with an imposed term and / or financing.">
                <langSet xml:lang="en-US"><tig><term>It locks the device to be used only with the Telcel network when associated with an imposed term and / or financing.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏯ ᎠᏍᏚᎰ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩ ᎤᏩᏒ Ꮎ Telcel ᏧᎾᏚᏓᎵ ᏧᎾᏙᎵᏒ ᏱᎩ ᏓᏓᏁᏤᎸ ᎠᎴ ᎠᎵᏍᏕᎵᏙᏗ ᎠᏕᎸ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Loading APNs">
                <langSet xml:lang="en-US"><tig><term>Loading APNs</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏢᏍᎬᎢ APNs</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 data limit">
                <langSet xml:lang="en-US"><tig><term>^1 data limit</term></tig></langSet>
