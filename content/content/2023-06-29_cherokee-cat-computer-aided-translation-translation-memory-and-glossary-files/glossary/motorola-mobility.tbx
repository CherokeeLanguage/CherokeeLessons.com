            <termEntry id="No Notifications">
                <langSet xml:lang="en-US"><tig><term>No Notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏗᎾᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect password on the next attempt, your work profile and its data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect password on the next attempt, your work profile and its data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᏂᏨᎤᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id=" will have access to all of the information that is visible on your screen or played from your device while recording or casting. This includes information such as passwords, payment details, photos, messages, and audio that you play.">
                <langSet xml:lang="en-US"><tig><term> will have access to all of the information that is visible on your screen or played from your device while recording or casting. This includes information such as passwords, payment details, photos, messages, and audio that you play.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏎ ᎤᎭ ᎠᏴᏍᏗ ᎾᎿᎢ ᏂᎦᏓ ᎤᎿᎢ ᏥᎩ ᎧᏃᎮᏢᏗ ᎥᏍᎩᎾ ᏄᏍᏛ ᎬᎪᏩᏛᏗ ᎤᎾᎢ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᏃᎴ ᏚᎾᏁᎶᏅ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏏᏉ ᎦᏂᏴᎲᎢ ᏃᎴ ᏫᏚᏕᎦ. ᎯᎠ ᏚᏠᏯᏍᏗ ᏗᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ, ᎠᏈᏴᏗ ᎧᏃᎮᏢᏗ, ᏗᏥᎶᏍᏔᏅᎯ, ᏗᎪᎵᏰᏗ, ᏃᎴ ᎤᏃᏴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="These notifications will be shown silently">
                <langSet xml:lang="en-US"><tig><term>These notifications will be shown silently</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠᏃ ᏗᏓᏃᏣᎳᏁᎯ ᎨᏎᏍᏗ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎡᎳᏪᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is using the microphone.">
                <langSet xml:lang="en-US"><tig><term>This app is using the microphone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎥᏗᏍᎬᎢ Ꮎ ᎦᏬᏂᎯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" remaining, about  left">
                <langSet xml:lang="en-US"><tig><term> remaining, about  left</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᎾᏕᎯᏯᏍᎬᎢ, ᎢᎸᏨ  ᏥᏣᏂᎩᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="All apps and data in this session will be deleted.">
                <langSet xml:lang="en-US"><tig><term>All apps and data in this session will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏗᎬᏙᏗ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿ ᎯᎠ ᎤᎾᏓᏡᎩ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect pattern on the next attempt, your work profile and its data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect pattern on the next attempt, your work profile and its data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᏂᏨᎤᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To improve location accuracy, apps and services can still scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location-based features and services. You can change this in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.">
                <langSet xml:lang="en-US"><tig><term>To improve location accuracy, apps and services can still scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location-based features and services. You can change this in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏛᏤᎳ ᎮᏙᎲᎢ ᏳᎾᏂᏘ, ᏗᎬᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎲᎵᏊ ᏱᏓᏟᎶᏍᏓ ᏫᎢ\u2011ᏈᎢ ᎠᏏᎸᏓᎢ ᎢᏳᏫ ᎨᏒᎢ, ᏍᏊ ᏯᏍᏚᎭ ᏫᎢ\u2011ᏈᎢ ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ. ᎯᏁᏟᏴᎾ LINK_BEGINWi\u2011FiᏓᏟᎶᏍᏗ ᏕᎦᎧᎲLINK_END</term></tig></langSet>
            </termEntry>
            <termEntry id="Exit Do Not Disturb on volume up">
                <langSet xml:lang="en-US"><tig><term>Exit Do Not Disturb on volume up</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎪᎢᏍᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎤᎾᎢ ᏂᎦᎥ ᎤᏜᏅᏛᎢ ᎦᎸᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Saver unavailable.">
                <langSet xml:lang="en-US"><tig><term>Data Saver unavailable.</term></tig></langSet>
