                <langSet xml:lang="en-US"><tig><term>Delete profile</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᎵ ᎠᏍᎪᎸᏛᎯ ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Standard data rates may apply.">
