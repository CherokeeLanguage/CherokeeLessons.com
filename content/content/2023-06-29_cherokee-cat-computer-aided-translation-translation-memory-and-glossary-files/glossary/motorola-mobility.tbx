                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏝᏃ ᎠᏔᏲᎯᎭ ᎾᏍᎩ ᎪᏢᎯᏐᏗ ᏨᏌᏊ, ᏝᏃ ᎠᏓᎵᏍᎪᎸᏓᏁᎸ ᏱᎩ ᎾᏍᎩ ᎠᎯᎸᏍᏗ ᎾᎢ ᏚᎸᏫᏍᏓᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This will replace any data currently on the device!">
                <langSet xml:lang="en-US"><tig><term>This will replace any data currently on the device!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎦᏁᏟᏴᏍᏓ ᏂᎯᎥ ᎦᏟᏌᏅᎯ ᏃᏊᎨᏒᎢ ᎤᎾᎢ ᏥᏂᎬᏅᏗᏓᎾ!</term></tig></langSet>
            </termEntry>
