                <langSet xml:lang="en-US"><tig><term>Moto Active Stylus permission</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎠᎵᏖᎸᎲᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
