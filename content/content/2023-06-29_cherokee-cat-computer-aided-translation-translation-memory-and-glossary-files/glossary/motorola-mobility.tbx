            </termEntry>
            <termEntry id="Cannot add current location. Please enable a location service in Settings &gt; Location">
                <langSet xml:lang="en-US"><tig><term>Cannot add current location. Please enable a location service in Settings &gt; Location</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎧᏁᏉᏍᏗ ᏃᏊ ᏥᎩ ᎤᏙᏢᏒᎢ. ᎰᏩᏊ ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎤᏙᏢᏒᎢ ᎤᎾᏓᏍᏕᎸᏗ ᎾᎿ ᏕᎦᎧᎲᎢ &gt; ᎤᏙᏢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To display weather information for your current location, Moto Widget needs permission to access location data even when the app is closed or not in use.">
                <langSet xml:lang="en-US"><tig><term>To display weather information for your current location, Moto Widget needs permission to access location data even when the app is closed or not in use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ ᏙᏱᏗᏜ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ ᎧᏃᎮᏢᏗ ᎤᎬᏀᏳ ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᎤᏙᏢᏒᎢ, Moto Widget ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏴᏍᏗ ᎤᏙᏢᏒᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᏊ ᎢᏳᏃ ᏥᎩ ᎬᏙᏗ ᎨᎡᎢ ᎠᏍᏚᏅᎩ ᏃᎴ ᎥᏝ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To display weather information for your current location, this app needs permission to access location data even when the app is closed or not in use. To grant this permission, tap &quot;Allow in Settings&quot; on the following screen. Then, go to Permissions &gt; Location, and select &quot;Allow all the time&quot;.">
                <langSet xml:lang="en-US"><tig><term>To display weather information for your current location, this app needs permission to access location data even when the app is closed or not in use. To grant this permission, tap "Allow in Settings" on the following screen. Then, go to Permissions &gt; Location, and select "Allow all the time".</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ ᏙᏱᏗᏜ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ ᎧᏃᎮᏢᏗ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᎤᏙᏢᏒᎢ, ᎯᎠ ᎬᏙᏗ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏴᏍᏗ ᎤᏙᏢᏒᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᏊ ᎢᏳᏃ ᏥᎩ ᎬᏙᏗ ᎨᎡᎢ ᎠᏍᏚᏅᎩ ᏃᎴ ᎥᏝ ᎾᎿ ᎬᏔᏂᏓᏍᏗ. ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ, ᎤᏟᏍᏓ ᎠᏒᏂᎸ "ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿ ᏕᎦᎧᎲᎢ" ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ. ᎾᏉᏃ, Ꭷ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ &gt; ᎤᏙᏢᏒᎢ, ᏃᎴ ᎠᏑᏰᏍᏗ "ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ".</term></tig></langSet>
            </termEntry>
            <termEntry id="Location data temporarily unavailable">
                <langSet xml:lang="en-US"><tig><term>Location data temporarily unavailable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᏢᏒᎢ ᎦᏘᏍᎩᏌᏅᎯ ᏞᎦᏊ ᏄᏛᏅᎢᏍᏛᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Time">
                <langSet xml:lang="en-US"><tig><term>Time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stylus disconnectedStylus button won't work">
                <langSet xml:lang="en-US"><tig><term>Stylus disconnectedStylus button won't work</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎫᏓᎴᏓᏃᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎠᏐᏅᏍᏙᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏝᏰᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="More weather details">
                <langSet xml:lang="en-US"><tig><term>More weather details</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile Hotspot uses your mobile data connection. Your Wi-Fi connection will be turned off.">
                <langSet xml:lang="en-US"><tig><term>Mobile Hotspot uses your mobile data connection. Your Wi-Fi connection will be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Mobile Hotspot ᏗᏅᏗᏍᎩ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎱᏓᎸᎦ. ᏂᏨᎤᎢ Wi-Fi ᎱᏓᎸᎦ ᎨᏎᏍᏗ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Discovery">
                <langSet xml:lang="en-US"><tig><term>Moto Discovery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎠᏩᏛᎲᎢ</term></tig></langSet>
            </termEntry>
