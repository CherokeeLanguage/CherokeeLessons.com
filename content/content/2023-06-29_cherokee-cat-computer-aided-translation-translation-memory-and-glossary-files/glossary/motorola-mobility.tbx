                <langSet xml:lang="chr"><tig><term>The ᎠᎦᏙᎥᎯᏍᏗ ᏗᏍᏆᏂᎪᏗᏍᎩ RSA ᎠᏍᏚᎢᏍᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏄᏍᏛ:</term></tig></langSet>
            </termEntry>
            <termEntry id="The user currently signed in to this device can't turn on USB debugging.">
                <langSet xml:lang="en-US"><tig><term>The user currently signed in to this device can't turn on USB debugging.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎬᏗᏍᎩ ᏃᏊ ᏥᎩ ᏚᏙᎥ ᎪᏪᎸᎦ ᎤᎿ ᎾᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏝᏰᎵ ᎯᏍᏚᎢ USB ᎯᏩᏔ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use this feature, switch to the primary user.">
                <langSet xml:lang="en-US"><tig><term>To use this feature, switch to the primary user.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>To ᎬᏔᏂᏓᏍᏗ ᎯᎠ ᎤᏩᎬᏗᏗᏒ, ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ ᏥᎩ ᏄᎬᏫᏳᏒ ᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Capture more">
