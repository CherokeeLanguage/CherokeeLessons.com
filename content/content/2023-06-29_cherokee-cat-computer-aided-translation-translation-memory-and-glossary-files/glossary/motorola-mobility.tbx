            </termEntry>
            <termEntry id="{count, plural, =0 {None} =1 {1 schedule set} other {# schedules set} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, =0 {None} =1 {1 schedule set} other {# schedules set} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, =0 {ᎧᏂᎩᏓ} =1 {1 ᏓᏒᏍᏛᎢ ᎠᏎᏢᎩ} other {# ᏓᏒᏍᏛᎢ ᎠᏎᏢᎩ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="There isn't enough space on the SD card to save the file.">
                <langSet xml:lang="en-US"><tig><term>There isn't enough space on the SD card to save the file.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᏰᎵᎢ ᏱᏂᎦᎠ ᎤᏜᏅᏛᎯ ᎤᎾᎢ ᎾᏍᎩ SD ᎠᏆᎾᏲᏍᏗ ᎠᎳᏏᏅᏙᏗ ᎾᏍᎩ ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="{count, plural, =0 {None} =1 {1 contact} other {# contacts} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, =0 {None} =1 {1 contact} other {# contacts} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, =0 {ᎧᏂᎩᏓ} =1 {1 ᎠᎾᏟᏃᎮᏍᎬ} other {# ᏗᏟᏃᎴᏙᏗ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="{count, plural, offset:2 =0 {None} =1 {{contact_1}} =2 {{contact_1} and {contact_2}} =3 {{contact_1}, {contact_2}, and {contact_3}} other {{contact_1}, {contact_2}, and # others} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, offset:2 =0 {None} =1 {{contact_1}} =2 {{contact_1} and {contact_2}} =3 {{contact_1}, {contact_2}, and {contact_3}} other {{contact_1}, {contact_2}, and # others} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, offset:2 =0 {ᎧᏂᎩᏓ} =1 {{contact_1}} =2 {{contact_1} ᎠᎴ {contact_2}} =3 {{contact_1}, {contact_2}, ᎠᎴ {contact_3}} other {{contact_1}, {contact_2}, ᎠᎴ # ᎠᏂᏐᎢ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="You've chosen to unsubscribe from information from Motorola on this device. Are you sure? You'll no longer receive notifications about the following:">
                <langSet xml:lang="en-US"><tig><term>You've chosen to unsubscribe from information from Motorola on this device. Are you sure? You'll no longer receive notifications about the following:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᎠᏑᏰᏔ ᎾᎿᎢ ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎧᏃᎮᏢᏗ ᏅᏓᏳᏓᎴᏅᎯ Motorola ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᎨᏒᎢ ᏂᎯ ᎤᏙᎯᏳ? ᏂᎯ ᎠᏎ ᎥᏝ ᎦᏅᎯᏓᎨ ᎦᏁᏍᏗ ᏗᎾᏓᏃᏣᎳᏁᎯ ᎢᎸᏨ ᏥᎩ ᎠᏍᏓᏩᏓ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᎠᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To allow this service to access your device location, enable location permission at the Allow all the time level.">
                <langSet xml:lang="en-US"><tig><term>To allow this service to access your device location, enable location permission at the Allow all the time level.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎢᏯᏓᏛᏁᏗ ᎾᎢ ᎠᏴᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏙᏢᏒᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎦᏓ ᎾᏍᎩ ᎠᏥᎢᎵᏒᎢ ᎠᏟᎶᎲᎢ.</term></tig></langSet>
            </termEntry>
