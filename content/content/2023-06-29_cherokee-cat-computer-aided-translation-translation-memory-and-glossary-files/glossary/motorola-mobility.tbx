            </termEntry>
            <termEntry id="Muted">
                <langSet xml:lang="en-US"><tig><term>Muted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎨᏩ</term></tig></langSet>
