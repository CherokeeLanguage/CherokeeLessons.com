                <langSet xml:lang="en-US"><tig><term>To open a bubble, tap it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏍᏚᎢᏓ ᎾᏍᎩ ᎠᎵᏆᎷᎲᏍᎬ, ᎭᏐᎥᏍᏓ ᎾᏍᎩ.</term></tig></langSet>
            </termEntry>
