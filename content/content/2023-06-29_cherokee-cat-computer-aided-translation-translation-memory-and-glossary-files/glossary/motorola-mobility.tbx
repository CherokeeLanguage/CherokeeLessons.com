            </termEntry>
            <termEntry id="This service is not entitled to access">
                <langSet xml:lang="en-US"><tig><term>This service is not entitled to access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎢᏯᏓᏛᏁᏗ ᎾᏍᎩ ᎭᏗ ᎤᏓᏁᏜᏅ ᎾᎢ ᎤᏴᏍᏗᎢ</term></tig></langSet>
