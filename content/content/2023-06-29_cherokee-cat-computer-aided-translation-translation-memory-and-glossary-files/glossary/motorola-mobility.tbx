                <langSet xml:lang="chr"><tig><term> ᏗᎬᏙᏗ ᎬᏔᏅᎯ ᎠᏅᏓᏗᏍᏙᏗ ᎾᎿᎢ ᎣᏂ </term></tig></langSet>
            </termEntry>
            <termEntry id="From:Pair with this device?">
                <langSet xml:lang="en-US"><tig><term>From:Pair with this device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᎵᎪᏙᏗ ᎬᏗ:ᎢᏳᏍᏗ ᎾᎿᎢ ᎿᏉᏃ ᎭᏐᎥᏍᏓ ᎠᏨᏗ ᎠᎴ ᎠᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Maximum usage">
