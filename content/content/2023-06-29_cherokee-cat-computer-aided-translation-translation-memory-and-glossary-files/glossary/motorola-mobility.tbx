            </termEntry>
            <termEntry id="Tap the icon again for more options">
                <langSet xml:lang="en-US"><tig><term>Tap the icon again for more options</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎠᎢᎧᏂ ᏏᏊ ᎾᏍᎩᎾ ᎤᏟ ᎢᎦᎢ ᏗᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="During the move: \u2022 Don\u2019t remove the ^1. \u2022 Some apps won\u2019t work correctly. \u2022 Keep the device charged.">
                <langSet xml:lang="en-US"><tig><term>During the move: \u2022 Don\u2019t remove the ^1. \u2022 Some apps won\u2019t work correctly. \u2022 Keep the device charged.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏥᎩ ᎠᎲᏍᏗ: \u2022 ᏝᏍᏗ ᎠᎲᏍᏗ ᏥᎩ ^1. \u2022 ᎢᎦᏓ ᏗᎬᏙᏗ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏚᏳᎪᏛᏊ. \u2022 ᏣᎮᏍᏗ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏗᎬᏩᎶᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The user currently signed in to this device can\u2019t turn on wireless debugging. To use this feature, switch to the primary user.">
                <langSet xml:lang="en-US"><tig><term>The user currently signed in to this device can\u2019t turn on wireless debugging. To use this feature, switch to the primary user.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎬᏗᏍᎩ ᏃᏊ ᏥᎩ ᏚᏙᎥ ᎪᏪᎸᎦ ᎤᎿ ᎾᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏍᏚᎢ ᏂᏓᏏᎳᏛ ᎯᏩᏔ. ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎯᎠ ᎤᏩᎬᏗᏗᏒ, ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ ᏥᎩ ᏄᎬᏫᏳᏒ ᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To simulate acroll, press and hold the stylus button and move your hand">
                <langSet xml:lang="en-US"><tig><term>To simulate acroll, press and hold the stylus button and move your hand</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎤᏠᏱ ᏯᏛᏁᎯ ᎠᏉᎳ, ᎭᏐᎥᏍᏓ ᎠᎴ ᎯᏂᏯ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏐᎥᏍᏙᏗ ᎠᎴ ᎯᎲᎾ ᏦᏰᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="System gestures are unlocked">
                <langSet xml:lang="en-US"><tig><term>System gestures are unlocked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎤᏬᏯᏂᏍᎩ ᎨᏒᎢ ᎦᏐᎭᎾᎳᎩᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Erase with your finger when you’re using the stylus">
                <langSet xml:lang="en-US"><tig><term>Erase with your finger when you’re using the stylus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᏕᎯᏰᏌᏛᎢ ᎬᏗ ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᎬᏗᏍᎬ ᎾᏍᎩ ᏗᎪᏪᎳᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Screenshot and edit">
                <langSet xml:lang="en-US"><tig><term>Screenshot and edit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎠᎴ ᎦᏁᏟᏴᏓ ᎪᏪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature is always on when you're listening through the loudspeakers, and you can adjust the settings for headphones and connected speakers.">
                <langSet xml:lang="en-US"><tig><term>This feature is always on when you're listening through the loudspeakers, and you can adjust the settings for headphones and connected speakers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏄᏍᏛ ᏂᎪᎯᎸᎢ ᎠᏍᏚᎢᏓ ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᏕᏣᏛᏓᏍᏛ ᎤᎶᏒᎯ ᎾᏍᎩ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ, ᎠᎴ ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾ ᏗᏟᏳᏙᎾᏗᏍᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏗᎦᏬᏂᏍᏙᏗ. </term></tig></langSet>
            </termEntry>
