                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎨᎡᎢ ᎾᏍᏉ ᎡᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="May drain your battery more quickly.">
                <langSet xml:lang="en-US"><tig><term>May drain your battery more quickly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏉ ᎡᎳᏗᏱᎬᏁᎯ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᎤᏟ ᎢᎦᎢ ᎤᏏᏄᎵ.</term></tig></langSet>
            </termEntry>
