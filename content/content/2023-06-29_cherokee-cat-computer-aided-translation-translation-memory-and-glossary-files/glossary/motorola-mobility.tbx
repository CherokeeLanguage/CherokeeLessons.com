            <termEntry id="This app can use your personal  app\u2019s permissions, like access to location, storage, or contacts.">
                <langSet xml:lang="en-US"><tig><term>This app can use your personal  app\u2019s permissions, like access to location, storage, or contacts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎬᏙᏓ ᏣᏤᎵ ᎠᏏᏴᏫ  } ᏗᎬᏙᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ, ᎾᏍᎩᏯᎢ ᎠᏴᏍᏗ ᎾᎢ ᎤᏙᏢᏒᎢ, ᎠᏍᏆᏂᎪᏙᏗ, ᎠᎴᏃ ᏗᏟᏃᎮᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This setting disables 2G service. If 2G service is disabled, some apps and functions may not work in locations where LTE or 3G is unavailable.">
                <langSet xml:lang="en-US"><tig><term>This setting disables 2G service. If 2G service is disabled, some apps and functions may not work in locations where LTE or 3G is unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎬᏙᏗ ᏂᎨᏒᎾ 2Ꮆ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏛᏁᏗ ᎬᏙᏗ ᏂᎨᏒᎾ ᏱᎩ, ᎢᎦᏓ ᏗᎬᏙᏗ ᏃᎴ ᏧᎸᏫᏍᏓᏁᏗᏱ ᏳᏄᎸᎲᎦ ᎤᏙᏢᏒᎢ Ꮎ LTE ᏃᎴ 3G ᎭᏗ ᎬᏙᏗ ᏱᎩ.</term></tig></langSet>
