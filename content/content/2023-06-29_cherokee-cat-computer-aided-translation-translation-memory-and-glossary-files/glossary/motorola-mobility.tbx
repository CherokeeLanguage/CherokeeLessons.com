            </termEntry>
            <termEntry id="Edit subject">
                <langSet xml:lang="en-US"><tig><term>Edit subject</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᎧᏃᎮᏗ</term></tig></langSet>
            </termEntry>
