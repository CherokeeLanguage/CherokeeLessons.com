            </termEntry>
            <termEntry id="NR Available:">
                <langSet xml:lang="en-US"><tig><term>NR Available:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>NR ᎠᏛᏅᎢᏍᏔᏅ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint enrollment time limit reached. Try again.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint enrollment time limit reached. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏕᎪᏪᎸ ᏚᎾᏙᎥ ᎠᏥᎢᎵᏒ ᎠᏎᎸᎯ ᏭᎷᏨᎩ. ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone can be unlocked when you don\u2019t intend to, like if someone holds it up to your finger.">
                <langSet xml:lang="en-US"><tig><term>Your phone can be unlocked when you don\u2019t intend to, like if someone holds it up to your finger.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏰᎵᏊ ᎨᏒᎢ ᏱᏐᎭᎾᎳᎩ ᎾᎯᏳ ᏂᎯ ᏞᏍᏗ ᎾᏁᎵᏍᎬ ᎾᎢ, ᎾᏍᎩᏯᎢ ᎥᏳᏃ ᎩᎶ ᎩᎶᎢ ᎠᏌᎳᏗᏍᎨᏍᏗ ᎾᎢ ᎯᏰᏌᏛᎢ.</term></tig></langSet>
            </termEntry>
