            <termEntry id="Accessibility settings help everyone enjoy an engaging Android experience.">
                <langSet xml:lang="en-US"><tig><term>Accessibility settings help everyone enjoy an engaging Android experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒᎢ ᏕᎦᎧᎲᎢ ᎠᏓᏍᏕᎵᏍᎩ ᎾᏂᎥᏉ ᎠᎵᎮᎵᏍᏗ ᎾᏍᎩ ᎠᏓᏁᏤᎮᏍᏗ Android ᎠᎦᏙᎲᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless debugging is intended for development purposes only. Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.">
                <langSet xml:lang="en-US"><tig><term>Wireless debugging is intended for development purposes only. Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏏᎳᏛᎾ ᎪᎷᏩᏘᏍᎬ ᎾᏍᎩ ᏄᏪᎵᏒ ᎾᏍᎩᎾ ᎤᏙᎷᏩᏛᏗ ᏂᏚᏰᎵᏛᎢ ᎤᏩᏌ. ᎬᏙᏓ ᎾᏍᎩ ᎾᎢ ᏗᏟᎶᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏰᏟ ᏣᏤᎵ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏃᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏘᏅᏛᎦ ᏗᎬᏙᏗ ᎤᎾᎢ ᏣᏤᏨ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎠᎪᎵᏰᏗ ᎸᏛᏁᎸ ᎧᏃᎮᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't connect to ''">
                <langSet xml:lang="en-US"><tig><term>Can't connect to ''</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᎨᎫᏓᎸᎥᎦ ᎾᎾᎢ ''</term></tig></langSet>
            </termEntry>
            <termEntry id="USB debugging is intended for development purposes only. Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.">
                <langSet xml:lang="en-US"><tig><term>USB debugging is intended for development purposes only. Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USB ᎪᎷᏩᏘᏍᎬᎢ ᎾᏍᎩ ᏄᏪᎵᏒ ᎾᏍᎩᎾ ᎤᏙᎷᏩᏛᏗ ᏂᏚᏰᎵᏛᎢ ᎤᏩᏌ. ᎬᏙᏓ ᎾᏍᎩ ᎾᎢ ᏗᏟᎶᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏰᏟ ᏣᏤᎵ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏃᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏘᏅᏛᎦ ᏗᎬᏙᏗ ᎤᎾᎢ ᏣᏤᏨ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎠᎪᎵᏰᏗ ᎸᏛᏁᎸ ᎧᏃᎮᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="User info">
                <langSet xml:lang="en-US"><tig><term>User info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎩ ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Always keep mobile data active, even when Wi\u2011Fi is active (for fast network switching).">
                <langSet xml:lang="en-US"><tig><term>Always keep mobile data active, even when Wi\u2011Fi is active (for fast network switching).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᏂᏨᏁᏍᏗ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎵᏖᎸᎲᏍᎩ, ᎢᏧᎳᎭ ᎾᎯᏳ Wi\u2011Fi ᎾᏍᎩ ᎠᎵᏖᎸᎲᏍᎩ (ᎾᏍᎩᎾ ᎦᏯᏄᎵ ᎤᏚᏓᎵ ᎠᏓᏁᏟᏴᎢ).</term></tig></langSet>
            </termEntry>
