            <termEntry id="You can open the sidebar using any of these methods:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select">
                <langSet xml:lang="en-US"><tig><term>You can open the sidebar using any of these methods:Mouse: Keyboard: Press {W} + TRemote controller: Press {M} Game controller: Press L1 + R1 + Select</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎨᏍᏚᎢᏍᏗ ᏱᎩ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎲᏗᏍᎬ ᏂᎦᎥᏉ ᎯᎠᏃ ᎢᏗᎬᏁᏗ:ᏥᏍᏕᏥ: ᏗᏐᏅᏍᏙᏗ: ᎠᏐᎥᏍᏙᏗ {W} + TᎢᎾ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ {M} ᏗᏁᎸᏙᏗ ᎤᎦᏎᏍᏗᏕᎩ: ᎠᏐᎥᏍᏙᏗ L1 + R1 + ᎠᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Loading contact card">
                <langSet xml:lang="en-US"><tig><term>Loading contact card</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏢᏍᎬ ᎠᏟᏃᎮᏙᏗ ᏆᎾᏲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Monitor the number of incorrect passwords typed when unlocking the screen, and lock the phone or erase all this user's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed when unlocking the screen, and lock the phone or erase all this user's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎵᏛᏍᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎾᏍᎩ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᏗᏐᏅᏍᏔᏅᎯ ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏰᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᏍᎩ ᎪᏪᎶᏙᏗᎢ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᎯᎠ ᎬᏗᏍᎩ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏳᏃ ᎤᎪᏗᏗ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᎾᏍᎩ ᏗᏐᏅᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Photo Editor needs permission to access the storage on your device.">
                <langSet xml:lang="en-US"><tig><term>Moto Photo Editor needs permission to access the storage on your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto Photo Editor ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎬᏴᏍᏗ ᏥᎩ ᎠᏍᏆᏂᎪᏙᏗ ᎤᏂ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select &quot;Permissions&quot; in App Info to enable.">
                <langSet xml:lang="en-US"><tig><term>Select "Permissions" in App Info to enable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᏙᏗ ᎣᏃᎮᏍᎩ ᎾᎿᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
