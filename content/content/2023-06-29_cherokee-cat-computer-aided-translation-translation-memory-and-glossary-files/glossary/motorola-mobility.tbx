                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏱᎦᎧᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="You may lose access to any remaining time or data. Check with your provider before removing.">
                <langSet xml:lang="en-US"><tig><term>You may lose access to any remaining time or data. Check with your provider before removing.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏣᎫᎯ ᎠᏴᏍᏗ ᎾᎿᎢ ᎾᏂᎥᏉ ᎤᎾᎵᏃᎯᏴᎯ ᎠᏥᎢᎵᏒ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ. ᎠᎦᏎᏍᏔᏅ ᎬᏗ ᏂᏨᎤᎢ ᎠᏓᏁᎸᏍᎩ ᎤᏓᎷᎸ ᏂᎬᏅᏕᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wait while your tablet is being encrypted. Time remaining: ^1">
                <langSet xml:lang="en-US"><tig><term>Wait while your tablet is being encrypted. Time remaining: ^1</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎦᏘᏓ ᎾᎯᏳᎢ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᏄᏍᏛ ᎠᎴᏂᏙᎲ ᎠᏕᎵᏍᏔᏅ. ᎠᏥᎢᎵᏒ ᎠᎾᏕᎯᏯᏍᎬᎢ: ^1</term></tig></langSet>
            </termEntry>
            <termEntry id="Device protection features will not work without your screen lock.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>Device protection features will not work without your screen lock.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᏗᎦᏎᏍᏙᏗ ᎠᏎ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏄᏠᏯᏍᏛᎾ ᏂᏨᎤᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ.ᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎾᎿ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
