                <langSet xml:lang="chr"><tig><term>ᏗᏴᏈᏛᎠ Ꮎ ᎡᏊ ᎪᏪᎵ ᎠᏴᏈᏏᏅ ᎣᏂᏗᏢ ᏂᎯᏣᏤᎵ ᏥᏂᎬᏅᏓᏗᎾ ᎥᎾᎢ ᎯᎫᏍᏛᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To switch between features, swipe up with 2 fingers and hold.">
                <langSet xml:lang="en-US"><tig><term>To switch between features, swipe up with 2 fingers and hold.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎣ ᏍᏫtch bᎡtᏪᎡn fᎡᎠtᎤrᎡᏍ, ᏍᏫpᎡ Ꭴp Ꮻth 2 fᎢnᎨrᏍ Ꭰnd Ꮀld.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unmount USB storage?">
