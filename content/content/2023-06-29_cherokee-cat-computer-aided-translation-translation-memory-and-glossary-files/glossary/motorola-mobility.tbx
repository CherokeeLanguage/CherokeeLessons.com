                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᏓᎬᏩᎶᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your mobile data will be used for the speed test. Do you want to continue?">
                <langSet xml:lang="en-US"><tig><term>Your mobile data will be used for the speed test. Do you want to continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᎾᏍᎩᎾ ᎦᏣᏄᎳ ᎠᏓᎪᎵᏰᏍᎩ. ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎠᎯᎸᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="The information I found was incorrect or out of date">
                <langSet xml:lang="en-US"><tig><term>The information I found was incorrect or out of date</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎧᏃᎸᎥᏍᎩ ᎠᎩᏩᏛᎲᎩ ᎨᏍᏒ ᏂᏚᏳᎪᏛᎾ ᎠᎴᏃ ᎢᎪ ᎠᏎᎯᎯ ᎤᎶᏒᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
