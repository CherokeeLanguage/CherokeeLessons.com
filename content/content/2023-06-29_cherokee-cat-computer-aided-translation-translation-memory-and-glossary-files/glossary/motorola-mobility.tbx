            </termEntry>
            <termEntry id="Must contain at least 1 lowercase letter">
                <langSet xml:lang="en-US"><tig><term>Must contain at least 1 lowercase letter</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎦᎸᏛᎢ ᎦᏲᎵᎨ 1 ᏧᏍᏗ ᏗᎪᏪᎵ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not show this again">
                <langSet xml:lang="en-US"><tig><term>Do not show this again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᎪᏩᏛᏗ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Time remaining: ^1">
                <langSet xml:lang="en-US"><tig><term>Time remaining: ^1</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᎢᎵᏒ ᎠᎾᏕᎯᏯᏍᎬᎢ: ^1</term></tig></langSet>
            </termEntry>
            <termEntry id="Alert reminder">
                <langSet xml:lang="en-US"><tig><term>Alert reminder</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ ᎠᏓᏅᏓᏗᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Account already exists">
                <langSet xml:lang="en-US"><tig><term>Account already exists</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᏓᎸᏗ ᎦᏳᎳ ᎬᏂᎨᏒ ᏂᏚᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Must contain at least one digit">
                <langSet xml:lang="en-US"><tig><term>Must contain at least one digit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎦᎸᏛᎢ ᎦᏲᎵᎨ ᏌᏊ ᎠᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="To unlock your tablet, turn it off and then on.">
                <langSet xml:lang="en-US"><tig><term>To unlock your tablet, turn it off and then on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ, ᎠᏍᏚᏗ ᎠᎴ ᎿᏉᏃ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you wish to continue?">
                <langSet xml:lang="en-US"><tig><term>Do you wish to continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Do you wish to continue? ᏣᏚᎵᏍ ᎢᎦᏯᎢᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off 5G Standalone?">
                <langSet xml:lang="en-US"><tig><term>Turn off 5G Standalone?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ 5G ᎦᏙᎬᎤᏩᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="This SIM can\u2019t be erased due to an error.">
                <langSet xml:lang="en-US"><tig><term>This SIM can\u2019t be erased due to an error.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ eSIM ᏝᏰᎵ\u2019 ᎨᏒᎩ ᏛᏍᏍᎪᎸᏥ ᏂᎨᏒ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᏓᏓᎴᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't be notified for new voicemails.">
                <langSet xml:lang="en-US"><tig><term>You won't be notified for new voicemails.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏝᏰᎵ be ᎠᏓᏃᎯᏎᏗ ᎤᎬᏩᏟ ᏗᏤ ᎧᏁᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notwithstanding, your WiFi connections may be charged independently by the provider of your WiFi connection.">
                <langSet xml:lang="en-US"><tig><term>Notwithstanding, your WiFi connections may be charged independently by the provider of your WiFi connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏍᎦᏗᏢᏃ, ᏂᏨᏅᎯ WiFi ᏓᎾᎵᎪᏗᏍᎬ ᎡᎵᏊ ᏗᎬᏩᎶᏔᏅ ᎤᏩᏒᎯᎢ ᎠᏁᏢᏍᎩ ᏂᏨᏅᎢ WiFi ᏓᎾᎵᎪᏗᏍᎬ..</term></tig></langSet>
            </termEntry>
            <termEntry id="You can disable the WiFi Calling at any time using the phone menu.">
                <langSet xml:lang="en-US"><tig><term>You can disable the WiFi Calling at any time using the phone menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏣᎴᏫᏍᏙᏗ Ꮎ WiFi ᏓᏯᏂᏍᎬ ᎢᏳᏊ ᎲᏗᏍᎬ Ꮎ ᏗᏟᏃᎮᏗ ᎪᏪᎳᎾᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Advanced settings for your connected device.">
                <langSet xml:lang="en-US"><tig><term>Advanced settings for your connected device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏱᎸᏛ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾ ᏣᏤᎵ ᎫᏓᎸᏅᎯ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For added security, set a PIN to unlock the device">
                <langSet xml:lang="en-US"><tig><term>For added security, set a PIN to unlock the device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎧᏁᏉᏓ ᎤᎦᏎᏍᏗ, ᎦᎧᎲᎢ PIN ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="For security, set PIN">
                <langSet xml:lang="en-US"><tig><term>For security, set PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎤᎦᏎᏍᏗ, ᎦᎧᎲᎢ PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Request Permissions Notification">
                <langSet xml:lang="en-US"><tig><term>Request Permissions Notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏲᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once you press the [CONTINUE] button and your phone connects to a WiFi network, your WiFi Calling service will be activated.">
                <langSet xml:lang="en-US"><tig><term>Once you press the [CONTINUE] button and your phone connects to a WiFi network, your WiFi Calling service will be activated.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>.ᏌᏊ ᎢᏳᏩᎫᏗ ᏱᏣᏐᏍᏔᎾ Ꮎ ᏂᎦᏯᎢᏎᏍᏗ ᎠᏐᎥᏍᏙᏗ ᎠᎴ ᏂᏨᏅᎯ ᏗᏟᏃᎮ ᏕᎱᏓᎸᏍᎬ ᎾᎢ WiFi ᏧᏅᏚᏓᎵ, ᏂᏨᏅᎯ WiFi ᏛᏯᏂᏍᎬ ᎢᏯᏛᏁᏗ ᎨᏎᏍᏗ ᎤᎵᎩᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Model &amp; hardware">
                <langSet xml:lang="en-US"><tig><term>Model &amp; hardware</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎱᏍᏗ ᎪᏢᏅ &amp; ᏍᏓᏯ ᎦᎾᏗᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you make WiFi Calling calls outside Poland your calls may be charged with a dedicated price specified in your mobile tariff plan's price list.">
                <langSet xml:lang="en-US"><tig><term>If you make WiFi Calling calls outside Poland your calls may be charged with a dedicated price specified in your mobile tariff plan's price list.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᏨᏁᎳ WiFi ᏛᏯᏂᏍᎬ ᏙᏯᏗᏜ ᏉᎳᏂ ᏂᏨᏅᎯ ᏕᎯᏯᏂᏍᎬ ᎡᎵᏊ ᏗᎬᏩᎶᏔᏅ ᎬᏗ ᏧᏚᎪᏔᏅᎯ ᏓᎬᏩᎶᏔᏅ ᏕᎪᎥᎢ ᎾᎿᎢ ᏂᏨᏅᎯ ᎠᏂᎩᏍᎩ ᎠᎫᏴᏗ ᎠᏍᏓᎶᏛᏓ ᏗᎪᏩᎶᏔᏅ ᏓᏎᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Detailed description of your WiFi Calling service could be found at www.orange.pl/wificallingPlease note that in order to enable routing of your emergency calls (eg. such as 112 calls) to the closest emergency centre, suitable for your actual location, your emergency calls in the WiFi Calling services will be carried by your device through any mobile network available at a given moment only in the cases where no mobile network is available an emergency call will be routed via WiFi Calling service.">
                <langSet xml:lang="en-US"><tig><term>Detailed description of your WiFi Calling service could be found at www.orange.pl/wificallingPlease note that in order to enable routing of your emergency calls (eg. such as 112 calls) to the closest emergency centre, suitable for your actual location, your emergency calls in the WiFi Calling services will be carried by your device through any mobile network available at a given moment only in the cases where no mobile network is available an emergency call will be routed via WiFi Calling service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏪᎳᏅ ᏗᏍᏆᏂᎪᏛᎾ Ꮎ WiFi ᏫᏘᏯᏂᏘ ᎢᏯᏛᏁᏗ ᏱᏕᎯᏩᏛ www.orange.pl/wificallingᏣᏅᏖᏍᏗ ᏱᏣᏚᎵ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᏭᎶᎯᏍᏗ Ꮎ ᎤᏟᏍᏗ ᏩᏴᏅᏗ (eg. such asᎾ ᏍᏈᏍᏗ ᏫᏘᏯᏅᏗ 112 calls) ᎾᎥᏂᎨᎢ ᎤᏟᏍᏗ ᎠᏓᏁᎸ, ᎾᎥ ᎠᎾ ᎮᏙᎲ, ᎤᏟᏍᏗ ᏫᏘᏴᏂᎲ Ꮎ WiFi ᏩᏴᏅᏗ ᎢᏯᏛᏁᏗ ᏕᎪᏪᎴᏍᏗ Ꮎ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎢᏳᏍᏚᏩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏰᎵ ᎠᏩᏛᏗ ᏍᏊ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏂᎬᏅᎾ ᏱᎩ ᎾᏊ WiFi ᏫᏘᏯᏂᏘ ᎢᏯᏅᏛᏁ ᎨᏍᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use fingerprint, set pattern">
                <langSet xml:lang="en-US"><tig><term>To use fingerprint, set pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ, ᎦᎧᎲᎢ ᎤᎾᎶᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once you enable Wi-Fi Calling, you can make a call over Wi-Fi just like any other call.">
                <langSet xml:lang="en-US"><tig><term>Once you enable Wi-Fi Calling, you can make a call over Wi-Fi just like any other call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊᏊ ᏂᎯ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ Wi-Fi ᏓᏯᏂᏍᎬ, ᏂᎯ ᏰᎴᏯ ᎪᏢᏗ Ꭰ ᏪᏯᎾ ᎢᏴᏛ Wi-Fi ᏚᏳᎪᏛᏉ ᎯᎸᏉᏗ ᎾᏂᎥᏉ ᏐᎢ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notification displayed when the user revoked any permissions required by the application.">
                <langSet xml:lang="en-US"><tig><term>Notification displayed when the user revoked any permissions required by the application.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᏣᎳᏁᎯ ᎬᏂᎨᏒ ᏁᎬᏅᎢ ᎥᏍᎩᏴ Ꮎ ᏗᏍᎩ ᎠᏥᎾᎡᎸ ᏂᎦᎥ ᏗᏚᎵᏍᎪᎸᏓᏁᏗ ᎢᏯᏛᏁᏗ ᎾᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Settings updated for wired device">
                <langSet xml:lang="en-US"><tig><term>Settings updated for wired device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ ᎪᏢᎯᏌᏅ ᎾᏍᎩᎾ ᎠᏏᎳᏛ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Face Unlock, set PIN">
                <langSet xml:lang="en-US"><tig><term>To use Face Unlock, set PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ, ᎦᎧᎲᎢ PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Video call will remain on the mobile network. Standard data charges may apply.">
                <langSet xml:lang="en-US"><tig><term>Video call will remain on the mobile network. Standard data charges may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎠᏎ ᎤᏓᏃᎯᏯᏍᏗ ᎤᎿᎢ ᏥᎩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ. ᎢᎬᏩᏍᏗᎭ ᎦᏘᏍᎩᏌᏅᎯ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏯ ᎲᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Face Unlock, set password">
                <langSet xml:lang="en-US"><tig><term>To use Face Unlock, set password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ, ᎦᎧᎲᎢ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Restart your device and try again.">
                <langSet xml:lang="en-US"><tig><term>Restart your device and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Face Unlock, set pattern">
                <langSet xml:lang="en-US"><tig><term>To use Face Unlock, set pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ, ᎦᎧᎲᎢ ᎤᎾᎶᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Surround">
                <langSet xml:lang="en-US"><tig><term>Surround</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏩᏕᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Settings updated for AUX device">
                <langSet xml:lang="en-US"><tig><term>Settings updated for AUX device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ ᎪᏢᎯᏌᏅ ᎾᏍᎩᎾ AUX ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Asian Radio">
                <langSet xml:lang="en-US"><tig><term>Asian Radio</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Asian Radio</term></tig></langSet>
