                <langSet xml:lang="chr"><tig><term>ᏦᎢᏁ-ᎤᎾᏓᏟᏌᎲ ᎠᏚᏓᎸᏗ ᏂᎦᎵᏍᏓ ᎦᏢᎯᏓ ᏄᏓᎴ ᎴᏃᏉ ID</term></tig></langSet>
            </termEntry>
            <termEntry id="To contact Motorola for support">
                <langSet xml:lang="en-US"><tig><term>To contact Motorola for support</term></tig></langSet>
