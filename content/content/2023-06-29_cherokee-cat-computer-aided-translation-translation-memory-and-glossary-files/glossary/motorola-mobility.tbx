            <termEntry id="White text, red background">
                <langSet xml:lang="en-US"><tig><term>White text, red background</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᎦ ᎪᏪᎳᏅᎢ, ᎩᎦᎨ ᎣᎾᏗᏜ ᏄᏍᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id=" out of ">
                <langSet xml:lang="en-US"><tig><term> out of </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎤᎾᏙᏣᎴᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Face unlock lets you unlock your device by looking at it. Keep in mind:\u25CF Your device may unlock any time you look at it.\u25CF Your device can be unlocked by someone else if they hold it in front of your face while your eyes are open.\u25CF Your device may also be unlocked by someone who looks a lot like you, such as a child or identical sibling.">
                <langSet xml:lang="en-US"><tig><term>Face unlock lets you unlock your device by looking at it. Keep in mind:\u25CF Your device may unlock any time you look at it.\u25CF Your device can be unlocked by someone else if they hold it in front of your face while your eyes are open.\u25CF Your device may also be unlocked by someone who looks a lot like you, such as a child or identical sibling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᎧᏛ ᎠᏐᎭᎾᎸᏗ ᎣᎵᏍᎸᏓᏁ ᎠᏐᎭᎾᎸᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎢ ᎥᏘᏍᎬᎢ. ᏣᎮᏍᏗ ᎣᏓᏅᏛ:\u25CF ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎠᏐᎭᎾᎸᏗ ᏂᎦᎵᏍᏘᏴᏊ ᏱᏣᎪᎵᏰᎠ.\u25CF ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᏱᎩ ᎠᏐᎭᎾᎸᏗ ᎩᎳ ᏄᏓᎴᎢ ᎢᏳᏃ ᏱᏄᏅᏁᎳ ᎠᎬᏱᏗᏨ ᏣᎧᏛᎢ ᏕᎯᎦᏅ ᏧᎵᏍᏚᎢᏓ ᏱᎩ.\u25CF ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎾᏍᏊ ᎤᏂᏐᎭᎾᎸᏗ ᎩᎶ ᎠᏏᏴᏫᏱᎩ ᎥᏠᏱ ᏤᎦᎦᏅᏗ ᏂᎯ ᎾᏣᏍᏛ, ᎾᏍᎩᏯ ᎠᏲᏟ ᏃᎴ ᎧᎵᏗᏙᎳᎩ ᎤᏠᏱ ᏏᏓᏁᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="While you’re playing a game, you can access helpful tools like screenshots and notification blocking in the left sidebar.">
                <langSet xml:lang="en-US"><tig><term>While you’re playing a game, you can access helpful tools like screenshots and notification blocking in the left sidebar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏕᎭᏁᎶᏗᏍᎬᎢ ᎾᏍᎩ ᏗᏁᎸᏙᏗ, ᏂᎯ ᏰᎵᏊ ᏱᏴᎯ ᎠᎵᏍᏕᎵᏍᎩ ᏗᎬᏔᏂᏓᏍᏗ ᎾᏍᎩᏯᎢ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎠᎴ ᏗᏓᏃᏣᎳᏁᎯ ᎦᏐᎭᎾᎳᏗᏍᎬᎢ ᎾᎿᎢ ᎠᏍᎦᏂ ᎤᏟᏗᏢ ᎪᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can’t change volume">
                <langSet xml:lang="en-US"><tig><term>Can’t change volume</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎦᏁᏟᏴᏍᏗ ᏂᎦᎥ ᎤᏜᏅᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="GIF maker is running">
                <langSet xml:lang="en-US"><tig><term>GIF maker is running</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>GIF ᎤᏬᏢᏅᎯ ᎾᏍᎩ ᎠᏓᎾᏫᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't install now as the navigation is on">
                <langSet xml:lang="en-US"><tig><term>The device can't install now as the navigation is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏘᏅᎦ Ꭷ ᎤᎿᎢ ᏥᎩ ᎠᏱᎴᎩ ᎨᎡᎢ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use hotspot and tethering to provide internet to other devices through your mobile data connection. Apps can also create a hotspot to share content with nearby devices.">
                <langSet xml:lang="en-US"><tig><term>Use hotspot and tethering to provide internet to other devices through your mobile data connection. Apps can also create a hotspot to share content with nearby devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᏃᎴ ᏗᎵᎪᏙᏗ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᎠᏏᎳᏕᏫᏒᎢ ᎾᎿᎢ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎦᏛᎴᏍᎩ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ. ᏗᎬᏙᏗ ᏰᎴᏯ ᎾᏍᏊ ᎪᏒᏗ Ꭰ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏄᏍᏗᏓᏅ ᎬᏗ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can find more appropriate data usage controls in the settings available within the app.">
                <langSet xml:lang="en-US"><tig><term>You can find more appropriate data usage controls in the settings available within the app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤ cᎠn fᎢnd ᎼrᎡ ᎠpprᎣprᎢᎠᏖ ᏓᏔ ᎤᏌᎨ cᎣntrᎣlᏍ Ꭲn tᎮ ᏎtᏘngᏍ ᎠᎥᎠᎢᎳbᎴ ᏫtᎯn tᎮ Ꭰpp.</term></tig></langSet>
            </termEntry>
            <termEntry id="Some accounts may also automatically copy any changes you make on the tablet to the web.">
                <langSet xml:lang="en-US"><tig><term>Some accounts may also automatically copy any changes you make on the tablet to the web.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏐᎺ ᎠccᎣᎤntᏍ Ꮉy ᎠlᏐ ᎠᎤtᎣᎹᏘcᎠlly cᎣpy Ꭰny cᎭnᎨᏍ ᏲᎤ ᎹkᎡ Ꭳn tᎮ pᎰᏁ tᎣ tᎮ Ꮺb.</term></tig></langSet>
            </termEntry>
            <termEntry id="A Google Account works this way.">
                <langSet xml:lang="en-US"><tig><term>A Google Account works this way.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎪᎣgᎴ ᎠccᎣᎤnt ᏬrkᏍ tᎯᏍ Ꮹy.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature may cause an app that depends on background data to stop working when only mobile networks are available.">
                <langSet xml:lang="en-US"><tig><term>This feature may cause an app that depends on background data to stop working when only mobile networks are available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎯᏍ fᎡᎠtᎤrᎡ Ꮉy cᎠᎤᏎ Ꭰn Ꭰpp tᎭt ᏕpᎡndᏍ Ꭳn bᎠckgrᎣᎤnd ᏓᏔ tᎣ ᏍtᎣp ᏬrkᎢng wᎮn Ꭳnly ᎼbᎢᎴ ᏁtᏬrkᏍ ᎠrᎡ ᎠᎥᎠᎢᎳbᎴ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Time to take action">
                <langSet xml:lang="en-US"><tig><term>Time to take action</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᎢᎵᏒ ᎾᎿᎢ ᎯᏫᏓ ᎢᏯᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flash off">
                <langSet xml:lang="en-US"><tig><term>Flash off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning Bluetooth on\u2026">
                <langSet xml:lang="en-US"><tig><term>Turning Bluetooth on\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᎬ Bluetooth ᎤᎾᎢ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Any changes you make to your accounts on the web will be automatically copied to your tablet.">
                <langSet xml:lang="en-US"><tig><term>Any changes you make to your accounts on the web will be automatically copied to your tablet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰny cᎭnᎨᏍ ᏲᎤ ᎹkᎡ tᎣ ᏲᎤr ᎠccᎣᎤntᏍ Ꭳn tᎮ Ꮺb Ꮻll bᎡ ᎠᎤtᎣᎹᏘcᎠlly cᎣpᎢᎡd tᎣ ᏲᎤr pᎰᏁ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Any changes you make to your accounts on the web will be automatically copied to your phone.">
                <langSet xml:lang="en-US"><tig><term>Any changes you make to your accounts on the web will be automatically copied to your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰny cᎭnᎨᏍ ᏲᎤ ᎹkᎡ tᎣ ᏲᎤr ᎠccᎣᎤntᏍ Ꭳn tᎮ Ꮺb Ꮻll bᎡ ᎠᎤtᎣᎹᏘcᎠlly cᎣpᎢᎡd tᎣ ᏲᎤr pᎰᏁ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Some accounts may also automatically copy any changes you make on the phone to the web.">
                <langSet xml:lang="en-US"><tig><term>Some accounts may also automatically copy any changes you make on the phone to the web.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏐᎺ ᎠccᎣᎤntᏍ Ꮉy ᎠlᏐ ᎠᎤtᎣᎹᏘcᎠlly cᎣpy Ꭰny cᎭnᎨᏍ ᏲᎤ ᎹkᎡ Ꭳn tᎮ pᎰᏁ tᎣ tᎮ Ꮺb.</term></tig></langSet>
            </termEntry>
