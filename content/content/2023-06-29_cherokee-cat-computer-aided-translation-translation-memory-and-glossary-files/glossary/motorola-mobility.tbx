            </termEntry>
            <termEntry id="Upgrading…">
                <langSet xml:lang="en-US"><tig><term>Upgrading…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᎯᏐᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Forwarding routes (e.g. 10.0.0.0/8)">
                <langSet xml:lang="en-US"><tig><term>Forwarding routes (e.g. 10.0.0.0/8)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎬᏱᏗᏜ ᎠᏂᎩᏍᏗᏍᎩ ᎦᎶᎯᏍᏗ (e.g. 10.0.0.0/8)</term></tig></langSet>
            </termEntry>
            <termEntry id=" received,  sent">
                <langSet xml:lang="en-US"><tig><term> received,  sent</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏓᏥᏁᎸᎩ,  ᏫᎦᏅᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Since this app is not set to optimize battery, you can\u2019t restrict it.To restrict the app, first turn on battery optimization.">
                <langSet xml:lang="en-US"><tig><term>Since this app is not set to optimize battery, you can\u2019t restrict it.To restrict the app, first turn on battery optimization.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎨᏒ ᎯᎠ ᎬᏙᏗ ᎾᎿ Ꮭ ᎦᎧᎲᎢ ᎾᎿᎢ ᏩᎧᎵᎢᏴ ᎠᎾᎦᎵᏍᎩ, ᏂᎯ ᏝᏰᎵ ᎠᏓᏍᏚᏁᏗ ᎾᎿ.ᎾᎿᎢ ᎠᏓᏍᏚᏁᏗ ᏥᎩ ᎬᏙᏗ, ᎢᎬᏱᏱ ᎯᏍᏚᎢ ᎠᎾᎦᎵᏍᎩ ᎾᎥᏂᎨᎢᏍᏗ ᏬᏌᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Day of month to reset data usage cycle:">
                <langSet xml:lang="en-US"><tig><term>Day of month to reset data usage cycle:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦ ᎾᎿᎢ ᎢᏯᏅᏓ ᎾᎿᎢ ᏥᎯᎧᎲᎦ ᎦᏟᏌᏅᎯ ᎬᏗᏍᎬ ᎤᏕᏲᏅ:</term></tig></langSet>
            </termEntry>
