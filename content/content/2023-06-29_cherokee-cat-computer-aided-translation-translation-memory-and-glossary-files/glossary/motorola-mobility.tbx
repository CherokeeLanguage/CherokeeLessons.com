            <termEntry id="I understand that my consent is not required and is not a condition of any purchase. Standard data rates may apply. I may unsubscribe to push notifications by selecting &quot;Unsubscribe&quot; in the notifications I receive. ">
                <langSet xml:lang="en-US"><tig><term>I understand that my consent is not required and is not a condition of any purchase. Standard data rates may apply. I may unsubscribe to push notifications by selecting "Unsubscribe" in the notifications I receive. </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯ ᎪᎵᎦ ᎾᏍᎩᎾᎢ ᎠᏆᏤᎵ ᎣᏏ ᏥᏰᎸᏍᎬᎢ ᎾᏍᎩ ᎥᏝ ᎠᏎᏯᏛᏁᏗ ᏱᎩ ᏃᎴ ᎥᏝ ᎾᏍᎩ ᏄᏍᏗᏓᏅ ᎥᎿᎢ ᏂᎦᎥ ᎠᏩᎯᏍᏗ. ᎢᎬᏩᏍᏗᎭ ᎦᏘᏍᎩᏌᏅᎯ ᏓᏟᎶᎲᎢ ᏰᎵᏉ ᏱᏂᎦᎵᏍᏓ. ᎠᏯ ᏰᎵᏉ ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ ᎾᎢ ᎦᏌᏙᏯᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᏄᏅᏅ ᎠᏑᏰᏍᏗ "ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ" ᎾᎿᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏯ ᎠᎩᏁᏒᎩ. </term></tig></langSet>
            </termEntry>
            <termEntry id="More Info">
                <langSet xml:lang="en-US"><tig><term>More Info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You have opted in for push notifications from Motorola about the following services and benefits. Click here  to unsubscribe.">
                <langSet xml:lang="en-US"><tig><term>You have opted in for push notifications from Motorola about the following services and benefits. Click here  to unsubscribe.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᎠᏑᏰᏍᏗ ᏗᎫᎪᏙᏗ ᎤᎬᏩᏟ ᎦᏌᏙᏯᏍᏗ ᏗᎾᏓᏃᏣᎳᏁᎯ ᏅᏓᏳᏓᎴᏅᎯ Motorola ᎢᎸᏨ ᏥᎩ ᎠᏍᏓᏩᏓ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏃᎴ ᏧᎾᎵᏍᏕᎸᏙᏗ. ᎭᏐᎥᏍᏓ ᎠᎭᏂ  ᎾᎿᎢ ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ.</term></tig></langSet>
            </termEntry>
