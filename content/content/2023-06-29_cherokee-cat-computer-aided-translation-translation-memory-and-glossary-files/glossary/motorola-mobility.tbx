                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏙᏗ Ꮭ ᏒᎵᎢ ᎨᏒᎢ ᎡᎵᏉ ᏱᎬᏯᏛᏁᏗ ᏱᎨᏎᏍᏗ ᎾᎢ ᎦᏂᏴᏙᏗ ᎤᏃᏴᎬᎢ ᎢᏳᏍᎩᏂ ᏂᎯ ᏱᏣᎵᏍᎪᎸᏔᎾ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
