                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="There are no leases acquired for this shared data. Would you like to delete it?">
                <langSet xml:lang="en-US"><tig><term>There are no leases acquired for this shared data. Would you like to delete it?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᎭᏗ ᏗᏓᏙᎳᏍᏙᏗ ᎠᎩᏓ ᎾᏍᎩᎾ ᎯᎠ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ. ᏱᏣᏚᎵᏍ ᎾᎢ ᎠᏍᎪᎸᏗᏍᏗᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Wi-Fi networks for voice calls">
                <langSet xml:lang="en-US"><tig><term>Use Wi-Fi networks for voice calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ Wi-Fi ᏚᎾᏚᏓᎵ ᎤᎬᏩᏟ ᎥᎧᏁᎬᎢ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to pair the device. Either the QR code was incorrect, or the device is not connected to the same network.">
                <langSet xml:lang="en-US"><tig><term>Failed to pair the device. Either the QR code was incorrect, or the device is not connected to the same network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎢ ᏗᎵᎪᏙᏗ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᎢᏧᎳ ᎾᏍᎩ QR ᎠᏍᏓᏩᏛᏍᏙᏗ ᏂᏚᏳᎪᏛᎾ ᎨᏎᎢ, ᎠᎴᏃ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎭᏗ ᎫᏓᎸᏅᎯ ᎾᏍᎩ ᎤᏠᏱ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" Adjust how colors display on your device. This can be helpful when you want to: See colors more accurately Remove colors to help you focus ">
                <langSet xml:lang="en-US"><tig><term> Adjust how colors display on your device. This can be helpful when you want to: See colors more accurately Remove colors to help you focus </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᏰᎵ ᏗᏑᏫᏓ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᏰᎵᏊ ᎨᏒᎢ ᎠᎵᏍᏕᎵᏍᎩ ᎾᎯᏳ ᏂᎯ ᏱᏣᏚᎵ ᎾᎾᎢ: ᎠᎪᏩᏛᏗ ᏗᏑᏫᏓ ᎤᏥ ᎢᎦᎢ ᎧᎵᏗᏙᎳᎩ ᎠᎲᏍᏗ ᏗᏑᏫᏓ ᎾᎢ ᏂᎯ ᏱᏍᏕᎵ ᎤᎿᏊ ᎢᎦ ᏫᏔᎧᏅᎦ </term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data off">
                <langSet xml:lang="en-US"><tig><term>Mobile data off</term></tig></langSet>
