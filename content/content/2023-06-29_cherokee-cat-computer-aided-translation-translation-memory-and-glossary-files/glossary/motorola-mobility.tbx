                <langSet xml:lang="chr"><tig><term>ᏫᏛᏢᏃᎮᏗ ᎤᏅᏓᏢᎬᎢ, ᏱᎨᏍᏕᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="The fingerprint sensor is on your screen.">
                <langSet xml:lang="en-US"><tig><term>The fingerprint sensor is on your screen.</term></tig></langSet>
