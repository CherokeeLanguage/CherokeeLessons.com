                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Normal data rates may apply during automatic system check.">
                <langSet xml:lang="en-US"><tig><term>Normal data rates may apply during automatic system check.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎬᏩᏍᏗᏭ ᎦᏘᏍᎩᏌᏅᎯ ᏗᎪᏣᎴᏒᏛ ᏰᎵᏯ ᏱᏂᎦᎵᏍᏓ ᎾᎯᏳ ᎤᏩᏌ ᏱᎬᏁᎯ ᏄᏍᏗᏓᏅᎢ ᎪᏪᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone will no longer automatically check for updates. Regular checking is strongly recommended for optimal performance.">
                <langSet xml:lang="en-US"><tig><term>Phone will no longer automatically check for updates. Regular checking is strongly recommended for optimal performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᏎ ᎭᏗ ᎦᏅᎯᏓᎨ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎪᏪᎶᏗ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏐᏗ. ᎤᏐᏱᎭᏊ ᎠᎪᎵᏰᎠ ᎨᎡᎢ ᎤᎳᏂᎩᏗᏳ ᎦᎸᏉᏔᏅ ᎤᎬᏩᏟ ᏫᏓᏤᏢᎢ ᎾᎾᏛᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Baghdad">
                <langSet xml:lang="en-US"><tig><term>Baghdad</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏇᎬᏕᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please install the update or else the device will install automatically in the next reboot. Make sure the battery level is more than ">
                <langSet xml:lang="en-US"><tig><term>Please install the update or else the device will install automatically in the next reboot. Make sure the battery level is more than </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᏘᏅᎦ ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᏃᎴ ᏰᎨᏎᏍᏗ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎯᏘᏅᎦ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎾᎿ ᏥᎩ ᏐᎢ ᏥᎭᏂᎩᏍᏗ. ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏥᎩ ᎠᎾᎦᎵᏍᎩ ᏄᏟᏂᎬᎬ ᎧᏃᎮᏍᎩ ᎨᎡᎢ ᎤᏥ ᎢᎦᎢ ᎡᏍᎦᏉ </term></tig></langSet>
            </termEntry>
            <termEntry id="If you don't restart by , your device will automatically restart at a time when it's least used.">
                <langSet xml:lang="en-US"><tig><term>If you don't restart by , your device will automatically restart at a time when it's least used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᏝᏍᏗ ᏥᎭᏂᎩᏍᏓ ᎬᏗ , ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ ᎢᏳᏃ ᎨᎡᎢ ᎤᏍᏗᎧᏂ ᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't update now as the call is in progress">
                <langSet xml:lang="en-US"><tig><term>The device can't update now as the call is in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᏗᎪᏢᎯᏌᏅᎯ Ꭷ ᎤᎿᎢ ᏥᎩ ᏪᏯᎾ ᎨᎡᎢ ᎾᎿ ᎠᎵᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to clear  of space before updating. Try deleting unused apps or moving photos &amp; videos to another storage device.">
                <langSet xml:lang="en-US"><tig><term>You need to clear  of space before updating. Try deleting unused apps or moving photos &amp; videos to another storage device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎯᎵᎦᎵᏯ  ᎾᎿ ᎤᏜᏅᏛ ᎠᏏᏅ ᎠᏤᎲᏍᏗᏍᎬ. ᏣᏁᎸᏙᏗ ᎠᏍᎪᎸᏗᏍᏗ ᎬᏔᏅᏂᎨᏒᎾ ᏗᎬᏙᏗ ᏃᎴ ᏩᎲᏍᎩ ᏗᏥᎶᏍᏔᏅᎯ &amp; ᏗᏓᏴᎳᏛᏍᎩ ᎾᎿᎢ ᏄᏓᎴ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We were not able to download this update. If you'd like to get this update later, please restart your device and then go to Settings &gt; System updates.">
                <langSet xml:lang="en-US"><tig><term>We were not able to download this update. If you'd like to get this update later, please restart your device and then go to Settings &gt; System updates.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎨᏒᎩ ᎥᏝ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ. ᎨᎡᎢ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎠᎩᏍᏗ ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ ᎣᏂᏯᎨᏍᏗ, ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᎾᏉᏃ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't install now as the call is in progress">
                <langSet xml:lang="en-US"><tig><term>The device can't install now as the call is in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏘᏅᎦ Ꭷ ᎤᎿᎢ ᏥᎩ ᏪᏯᎾ ᎨᎡᎢ ᎾᎿ ᎠᎵᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Using Wi-Fi is recommended. Downloading with mobile data or using mobile data while roaming may result in additional charges.Downloading this software won't impact the operation of your device.">
                <langSet xml:lang="en-US"><tig><term>Using Wi-Fi is recommended. Downloading with mobile data or using mobile data while roaming may result in additional charges.Downloading this software won't impact the operation of your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᎭ Wi-Fi ᎨᎡᎢ ᎦᎸᏉᏔᏅ. ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ ᎬᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏃᎴ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎯᏳᎢ ᎡᏙᎵᏙᎲ ᏰᎵᏯ ᏄᎵᏍᏔᏅ ᎾᎿ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏓᎬᏩᎶᏗᏍᎬ.ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ ᎯᎠ ᎦᎾᏗᏅᏗ ᏝᏍᏗ ᏓᏓᏛᏅᏍᏗᏍᎬ ᏥᎩ ᎠᎢᏒᎢ ᎾᎿ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Because of its importance, this update will download automatically using mobile data on ">
                <langSet xml:lang="en-US"><tig><term>Because of its importance, this update will download automatically using mobile data on </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎾᎿ ᎨᎡᎢ ᏭᎵᏍᎨᏗᏴ, ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏎ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently. When you turn them on, all future security updates will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently. When you turn them on, all future security updates will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᏃᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏓ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ. ᎤᎶᏐᏅ Ꭰ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎩ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᏃᎴ ᎯᏘᏅᎦ ᎤᎿᎢ ᏥᎩ ᎠᏟᎵᏒᎢ ᏂᎯ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to complete the download. There's not enough space on the SD Card. Free up some space and go to Settings &gt; System updates to try again.">
                <langSet xml:lang="en-US"><tig><term>Unable to complete the download. There's not enough space on the SD Card. Free up some space and go to Settings &gt; System updates to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎠᏍᏆᏛᏃᏅ ᏥᎩ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ. ᏓᎭᎢ ᎥᏝ ᏰᎵᏉ ᎤᏜᏅᏛ ᎤᎿᎢ ᏥᎩ SD ᏆᎾᏲᏍᏗ. ᏚᏓᎴᎩ ᎢᎦᏓ ᎤᏜᏅᏛ ᏃᎴ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently. When you turn them on, all future security updates and bug fixes will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently. When you turn them on, all future security updates and bug fixes will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᏃᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏚ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᏃᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ. ᎤᎶᏐᏅ an ᏗᎪᏢᎯᏌᏅᎯ is ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, your ᏥᏂᎬᏅᏗᏓᎾ will ᏥᎭᏂᎩᏍᏓ and ᎯᏘᏅᎦ at the ᎠᏟᎵᏒᎢ you ᏣᏑᏰᏍᏗ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to download update. The update package is not available at this time. No further action is required.">
                <langSet xml:lang="en-US"><tig><term>Failed to download update. The update package is not available at this time. No further action is required.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏗᎪᏢᎯᏌᏅᎯ. ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᎦᏇᏅᏛ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎿᎢ ᎯᎠ ᎠᏥᎢᎵᏒ. Ꮭ ᎤᏗᏗᏢ ᎢᏯᏛᏁᎵᏓᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Updates are downloaded and installed automatically">
                <langSet xml:lang="en-US"><tig><term>Updates are downloaded and installed automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏢᎯᏐᏗ ᎨᎡᎩ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏃᎴ ᎦᏘᏅᏔᏅ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Download will continue on mobile data. Data charges may be applicable.">
                <langSet xml:lang="en-US"><tig><term>Download will continue on mobile data. Data charges may be applicable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏎ ᎠᎯᎸᏍᏗ ᎾᎿᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ. ᎦᏘᏍᎩᏌᏅᎯ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎨᎡᎢ ᏗᏓᏂᎸᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep your device safe and secure with automatic updates">
                <langSet xml:lang="en-US"><tig><term>Keep your device safe and secure with automatic updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᎦᎾᏰᎬᎾ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎬᏗ ᎤᏩᏌ ᏱᎬᏁᎯ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="USSD via Wi-Fi Calling">
                <langSet xml:lang="en-US"><tig><term>USSD via Wi-Fi Calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USSD Ꮎ Wi-Fi ᏫᏴᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Low SMS storage. You may need to delete messages.">
                <langSet xml:lang="en-US"><tig><term>Low SMS storage. You may need to delete messages.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗ SMS ᎠᏍᏆᏂᎪᏙᏗ. ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏍᎪᎸᏗᏍᏗ ᏗᎪᎵᏰᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The SD Card was removed. Download process was not completed. Please re-insert the SD Card and go to Settings &gt; System updates to try again.">
                <langSet xml:lang="en-US"><tig><term>The SD Card was removed. Download process was not completed. Please re-insert the SD Card and go to Settings &gt; System updates to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ SD ᏆᎾᏲᏍᏗ ᎨᏎᎢ ᎠᎲᏍᏓ. ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏱᎵᏒ ᎨᏎᎢ ᎥᏝ ᎠᏍᏆᏙᎾ. ᎰᏩᏊ ᎰᏣᎸᎥᎦ ᏥᎩ SD ᏆᎾᏲᏍᏗ ᏃᎴ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device could be prone to security risks. Execute the below command for continued updatesadb enable-verity">
                <langSet xml:lang="en-US"><tig><term>Your device could be prone to security risks. Execute the below command for continued updatesadb enable-verity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏯ ᎨᎡᎢ ᎠᏞᏴᏍᏙᏗ ᎾᎿᎢ ᏧᎾᎦᏎᏍᏗ ᏗᎦᎾᏰᎩ. ᎠᎴᏅᏗᏱ ᏥᎩ ᎡᎳᏗᏨ ᎤᏁᏤᎸᎩ ᎤᎬᏩᏟ ᎤᎵᏱᎸᏛ ᏗᎪᏢᎯᏐᏗadb ᎡᎵᏊ ᏱᎬᏛᏁᏗ-ᎤᏙᎯᏳᎯᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently. When you turn them on, all future security updates will automatically download when they're available. After an update is downloaded, your device will restart at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently. When you turn them on, all future security updates will automatically download when they're available. After an update is downloaded, your device will restart at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᏃᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏓ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ. ᎤᎶᏐᏅ Ꭰ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ ᏥᎩ ᎠᏟᎵᏒᎢ ᏂᎯ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Because of its importance, this update will install automatically using mobile data on ">
                <langSet xml:lang="en-US"><tig><term>Because of its importance, this update will install automatically using mobile data on </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎾᎿ ᎨᎡᎢ ᏭᎵᏍᎨᏗᏴ, ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏎ ᎯᏘᏅᎦ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Delete all messages with media">
                <langSet xml:lang="en-US"><tig><term>Delete all messages with media</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏗᎪᎵᏰᏗ ᎬᏗ ᎦᎶᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space. Once done, you can go to Settings &gt; System updates to start the update any time.">
                <langSet xml:lang="en-US"><tig><term>This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space. Once done, you can go to Settings &gt; System updates to start the update any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏎᏳᎾᏛᏁᏗ  ᎾᎿ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏍᏆᏂᎪᏙᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎰᏩᏊ ᎠᏍᎪᎸᏗᏍᏗ ᎬᏔᏅᏂᎨᏒᎾ ᏗᎬᏙᏗ ᏃᎴ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎤᎿᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎤᏚᏓᎴᏗ  ᎾᎿ ᎤᏜᏅᏛᎯ. ᏌᏊᏊ ᎠᏍᏆᏛᎯ, ᏂᎯ ᏰᎵᏯ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᎭᎴᎾ ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to update. The update version does not match your phone. Please download the correct version for your phone and try again.">
                <langSet xml:lang="en-US"><tig><term>Failed to update. The update version does not match your phone. Please download the correct version for your phone and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎾᎿᎢ ᏗᎪᏢᎯᏌᏅᎯ. ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᏄᏓᎴᏒᎢ ᏝᏍᏗ ᏗᏙᎵᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ. ᎰᏩᏊ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏥᎩ ᏚᏳᎪᏛᎢ ᏄᏓᎴᏒᎢ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more online">
                <langSet xml:lang="en-US"><tig><term>Learn more online</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ ᏓᏏᎳᏕᏫᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for Wi-Fi or Zero Rated network to resume background download and installation…">
                <langSet xml:lang="en-US"><tig><term>Waiting for Wi-Fi or Zero Rated network to resume background download and installation…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏯ ᎤᎬᏩᏟ Wi-Fi ᏃᎴ ᎧᏂᎩᏗ ᎠᏟᎶᏓ ᏧᎾᏚᏓᎵ ᎾᎿᎢ ᎠᎴᏂᏐᏗᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏃᎴ ᎦᏘᏅᏛᏍᏗ...</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device couldn't install this update. Use the Software Upgrade Assistant tool to install. Tap for more info.">
                <langSet xml:lang="en-US"><tig><term>Your device couldn't install this update. Use the Software Upgrade Assistant tool to install. Tap for more info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏘᏅᎦ ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ. ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎦᎾᏗᏅᏗ ᏦᏢᎯᏐᏗ ᎠᎵᏍᏕᎵᏍᎩ ᎬᏔᏂᏓᏍᏗ ᎾᎿᎢ ᎯᏘᏅᎦ. ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Updates are downloaded and installed automatically when you're connected to Wi-Fi">
                <langSet xml:lang="en-US"><tig><term>Updates are downloaded and installed automatically when you're connected to Wi-Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏢᎯᏐᏗ ᎨᎡᎩ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏃᎴ ᎦᏘᏅᏔᏅ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space.">
                <langSet xml:lang="en-US"><tig><term>This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏎᏳᎾᏛᏁᏗ  ᎾᎿ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏍᏆᏂᎪᏙᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎰᏩᏊ ᎠᏍᎪᎸᏗᏍᏗ ᎬᏔᏅᏂᎨᏒᎾ ᏗᎬᏙᏗ ᏃᎴ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎤᎿᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎾᎿ ᎤᏜᏅᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use mobile data">
                <langSet xml:lang="en-US"><tig><term>Use mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="There's not enough space on the SD Card to complete the download. Please free up  space and go to Settings &gt; System updates to try the download again.">
                <langSet xml:lang="en-US"><tig><term>There's not enough space on the SD Card to complete the download. Please free up  space and go to Settings &gt; System updates to try the download again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎭᎢ ᎥᏝ ᏰᎵᏉ ᎤᏜᏅᏛ ᎤᎿᎢ ᏥᎩ SD ᏆᎾᏲᏍᏗ ᎾᎿᎢ ᎧᎵᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎰᏩᏊ ᏚᏓᎴᎩ ᎢᎦᏓ ᎤᏜᏅᏛ ᏃᎴ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't reboot now as the navigation is on">
                <langSet xml:lang="en-US"><tig><term>The device can't reboot now as the navigation is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᏥᎭᏂᎩᏍᏗ Ꭷ ᎤᎿᎢ ᏥᎩ ᎠᏱᎴᎩ ᎨᎡᎢ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="System update is blocked. Please contact your device admin for more info.">
                <langSet xml:lang="en-US"><tig><term>System update is blocked. Please contact your device admin for more info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎢ ᎦᏐᎭᎾᎳᏓ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᎤᎬᏩᏟ ᎤᏥ ᎢᎦᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Installation should take about  minutes. You won't be able to use your device until it completes.">
                <langSet xml:lang="en-US"><tig><term>Installation should take about  minutes. You won't be able to use your device until it completes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏅᏛᏍᏗ ᎾᎢᏳᏃ ᎯᏫᏓ ᎢᎸᏨ  ᎢᏯᏔᏬᏍᏔᏅᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎩᎳ ᎨᎡᎢ ᎠᏍᏆᏛᏃᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't reboot now as the call is in progress">
                <langSet xml:lang="en-US"><tig><term>The device can't reboot now as the call is in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᏥᎭᏂᎩᏍᏗ Ꭷ ᎤᎿᎢ ᏥᎩ ᏪᏯᎾ ᎨᎡᎢ ᎾᎿ ᎠᎵᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data is off">
                <langSet xml:lang="en-US"><tig><term>Mobile data is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sending…">
                <langSet xml:lang="en-US"><tig><term>Sending…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎦᏅᎥᏍᎬᎢ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Bubble settings">
                <langSet xml:lang="en-US"><tig><term>Bubble settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏆᎷᎲᏍᎬ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use MMS to send a single message when there are multiple recipients">
                <langSet xml:lang="en-US"><tig><term>Use MMS to send a single message when there are multiple recipients</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ MMS ᎾᎿᎢ ᏫᏅᎥᎦ Ꭰ ᏏᏴᏫ ᏗᎦᏃᏣᎳᏅᎯ ᎢᏳᏃ ᎾᏂᎠ ᎢᎸᏍᎩ ᏗᏂᏁᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable mobile data for apps and services such as email, web browsing, AT&amp;T Video Call, and push notifications over the cellular network.">
                <langSet xml:lang="en-US"><tig><term>Enable mobile data for apps and services such as email, web browsing, AT&amp;T Video Call, and push notifications over the cellular network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾ ᏗᎬᏙᏗ ᏃᎴ ᎢᏗᏛᏁᏗ ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ, ᎤᏂᎳᏛᎢ ᎠᎦᏖᎾᏍᏗ, AT&amp;TᎢᏓᏴᎳᏛᏍᎩ ᏪᏴᎾ, ᏃᎴ ᎦᏌᏙᏯᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᎦᏬᎯᎸᏙᏗ ᎾᏍᎩ ᏫᏚᏍᏗᎬ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="International Data Roaming">
                <langSet xml:lang="en-US"><tig><term>International Data Roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable mobile data for apps and services such as email, web browsing, AT&amp;T Video Call, and push notifications over the cellular network when roaming outside the U.S., Puerto Rico and USVI. International roaming data charges may apply.">
                <langSet xml:lang="en-US"><tig><term>Enable mobile data for apps and services such as email, web browsing, AT&amp;T Video Call, and push notifications over the cellular network when roaming outside the U.S., Puerto Rico and USVI. International roaming data charges may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾ ᏗᎬᏙᏗ ᏃᎴ ᎢᏗᏓᏛᏁᏗ ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ, ᎤᏂᎳᏛᎢ ᎠᎦᏖᎾᏍᏗ , AT&amp;T ᏗᏓᏴᎳᏛᏍᎩ ᎪᏎᏗ, ᏃᎴ ᎦᏌᏙᏯᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᎦᏬᎯᎸᏙᏗ ᎾᏍᎩ ᏫᏚᏍᏗᎬ ᏧᎾᏚᏓᎵ ᎾᎯᏳ ᎡᏙᎵᏙᎲ ᏙᏯᏗᏨ ᎾᏍᎩ U.S., ᏇᎡᏙ ᎵᎢᎪ ᏃᎴ USVI. ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎡᏙᎵᏙᎲ ᎦᏘᏍᎩᏌᏅᎯ ᏓᎬᏩᎶᏛ ᏰᎵᏉ ᏱᏂᎦᎵᏍᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Add more participants">
                <langSet xml:lang="en-US"><tig><term>Add more participants</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏗ ᎤᏟ ᎢᎦᎢ ᏗᏁᎳᏗᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Attach audio">
                <langSet xml:lang="en-US"><tig><term>Attach audio</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏯᎸᎥᎦ ᎤᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage is measured by your phone. Your carrier may account for usage differently. Set the dates to match the period on your bill.">
                <langSet xml:lang="en-US"><tig><term>Data usage is measured by your phone. Your carrier may account for usage differently. Set the dates to match the period on your bill.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ ᎾᏍᎩ ᎢᏳᏨᎶᏛ ᎬᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ. ᏣᏤᎵ ᎠᎯᏙᎯ ᏰᎵᏉ ᎠᏚᏓᎸᏗ ᎾᏍᎩᎾ ᎬᏔᏂᏓᏍᏗ ᏅᏓᎴᎢ. ᎾᏍᎩ ᎯᎧᎲᎦ ᏧᏒᎯᏓ ᏫᏓᏎᎸᎢ ᏗᏙᎵᎩ ᎾᏍᎩ ᎾᎢ ᎠᏥᏱᎵᏒ ᎤᎾᎢ ᏣᏤᎵ ᎡᏍᏚᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unless you use Wi-Fi, you won't be able to use the Internet, Email or other apps that require a data connection.Turn off the mobile data connection?">
                <langSet xml:lang="en-US"><tig><term>Unless you use Wi-Fi, you won't be able to use the Internet, Email or other apps that require a data connection.Turn off the mobile data connection?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᎩᏂ ᏂᎯ ᎬᏔᏂᏓᏍᏗ Wi-Fi, ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎠᏏᎳᏕᏫᏒᎢ, ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏃᎴ ᎬᏗ ᏗᎬᏙᏗ ᎥᏍᎩᎾ ᎠᏎᏯᏛᏁᏗ a ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ.ᎠᏍᏚᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage is measured by your phone. Your carrier may account for usage differently. Set the dates to match the period on your bill.">
                <langSet xml:lang="en-US"><tig><term>Data usage is measured by your phone. Your carrier may account for usage differently. Set the dates to match the period on your bill.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ ᎾᏍᎩ ᎢᏳᏨᎶᏛ ᎬᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ. ᏣᏤᎵ ᎠᎯᏙᎯ ᏰᎵᏉ ᎠᏚᏓᎸᏗ ᎾᏍᎩᎾ ᎬᏔᏂᏓᏍᏗ ᏅᏓᎴᎢ. ᎾᏍᎩ ᎯᎧᎲᎦ ᏧᏒᎯᏓ ᏫᏓᏎᎸᎢ ᏗᏙᎵᎩ ᎾᏍᎩ ᎾᎢ ᎠᏥᏱᎵᏒ ᎤᎾᎢ ᏣᏤᎵ ᎡᏍᏚᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor below the screen">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor below the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎠᏩᏘᏍᎩ ᎡᎳᏗᏨ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Locate the fingerprint sensor on the bottom front of your phone. You\’ll need to touch the sensor several times to record your fingerprint.">
                <langSet xml:lang="en-US"><tig><term>Locate the fingerprint sensor on the bottom front of your phone. You\’ll need to touch the sensor several times to record your fingerprint.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏩᏛᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎤᎾᎢ ᎡᎳᏗᏨ ᎠᎬᏱᏗᏨ ᏂᏨᏅᎢ ᏗᏟᏃᎮᏗ. ᏂᎯᏊᏃ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏒᏂᏍᏗ ᎠᏩᏘᏍᎩ ᎢᎸᏍᎩ ᎢᏳᏩᏗ ᎾᎿᎢ ᏕᎦᏅᏅᏛᎢ ᏂᏨᏅᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device Data Collection">
                <langSet xml:lang="en-US"><tig><term>Device Data Collection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎦᏟᏌᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're not connected to a data service.To view this information now, go to https://t-mo.co/2CqebHM from any computer connected to the Internet.">
                <langSet xml:lang="en-US"><tig><term>You're not connected to a data service.To view this information now, go to https://t-mo.co/2CqebHM from any computer connected to the Internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎥᏝ ᎫᏓᎸᏅᎯ ᎾᎿᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎢᏯᏓᏛᏁᏗ.ᎾᎿᎢ ᏗᎧᏃᏗ ᎯᎠ ᎧᏃᎮᏢᏗ Ꭷ, ᏤᏅᏍᏗ https://t-mo.co/2CqebHM ᏂᏙᏓᏳᏓᎴᏅᎯ ᎾᏂᎥᏉ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎫᏓᎸᏅᎯ ᎾᎿᎢ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You've reached your specified data usage limit, so mobile data has been turned off. If you turn mobile data back on, you may be charged for data usage by your carrier.">
                <langSet xml:lang="en-US"><tig><term>You've reached your specified data usage limit, so mobile data has been turned off. If you turn mobile data back on, you may be charged for data usage by your carrier.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏃ ᏫᏣᎷᏨ ᏣᏤᎵ ᎠᎪᎥᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎲᏗᏍᎬ ᎠᏎᎸᎯ, ᎾᏍᎩᏃ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎦᏳᎳ ᎤᏂᏍᏚᏅᎢ. IfᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏱᎵᏍᏚᎢᏌ, ᏂᎯ ᏰᎵᏉ ᏰᏣᏂᏢᎦ ᎾᏍᎩᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎲᏗᏍᎬᎢ ᎾᏍᎩ ᏣᏤᎵ ᎠᎯᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data is now off.">
                <langSet xml:lang="en-US"><tig><term>Mobile data is now off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᏃᏊ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Find the sensor">
                <langSet xml:lang="en-US"><tig><term>Find the sensor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏩᏘᏍᎩ ᎯᏩᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="You have new voicemails. Visual Voicemail is not supported on this device. Tap to call the voicemail center.">
                <langSet xml:lang="en-US"><tig><term>You have new voicemails. Visual Voicemail is not supported on this device. Tap to call the voicemail center.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏣᎭ ᎢᏤ ᎧᏁᎬ Ꮎ ᎠᎪᏩᏛᏗ ᎧᏁᎬ ᎭᏗ ᏱᎫᎫᏍᏓ ᎯᎠᎾ ᏥᏂᎬᏅᏗᏓᎾ ᎯᏐᏍᏓ ᏪᏴᎾ Ꮎ ᎧᏁᎬ ᎠᏰᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Read Attentive Display camera state">
                <langSet xml:lang="en-US"><tig><term>Read Attentive Display camera state</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎧᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can open the camera quickly and never miss a moment you want to capture">
                <langSet xml:lang="en-US"><tig><term>Now you can open the camera quickly and never miss a moment you want to capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᏰᎵᏯ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᎵᏍᏓᏊ ᏃᎴ ᎢᎸᎯᏳᎢ ᎦᏅᏗᏍᏗ Ꭰ ᏞᎦ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't demo Attentive Display as the camera is not available.">
                <langSet xml:lang="en-US"><tig><term>Can't demo Attentive Display as the camera is not available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎤᎿᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="An image will appear in the circle below when Attentive Display sees you. The image will disappear when you look away from screen.">
                <langSet xml:lang="en-US"><tig><term>An image will appear in the circle below when Attentive Display sees you. The image will disappear when you look away from screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎠᏅᏓᏗᏍᏙ ᎠᏎ ᎬᏂᎨᏒᎢ ᎾᎿ ᏥᎩ ᎦᏐᏆᎸᎢ ᎡᎳᏗᏨ ᎢᏳᏃ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎠᎪᏩᏘ ᏂᎯ. ᏥᎩ ᎠᎪᏩᏘ ᎠᏎ ᎠᏗᏍᎦᎶᏗ ᎢᏳᏃ ᏂᎯ ᏩᎦᏔ ᎤᏤᎵᏛ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏓᏎᎮᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the application to determine when Attentive Display is using the camera.">
                <langSet xml:lang="en-US"><tig><term>Allows the application to determine when Attentive Display is using the camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᎢᏳᏃ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎨᎡᎢ ᎬᏗᎭ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not vibrate on tap and swipe">
                <langSet xml:lang="en-US"><tig><term>Do not vibrate on tap and swipe</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏍᏗ ᎠᎵᏖᎸᏗ ᎾᎿ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏃᎴ ᎦᎶᎯᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera anytime. This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera anytime. This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᎸᎯᏳ. ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᏃᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge lights appear for alerts, notifications, and more. You can customize edge lights in settings.">
                <langSet xml:lang="en-US"><tig><term>Edge lights appear for alerts, notifications, and more. You can customize edge lights in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᏗᏨᏍᏗ ᎬᏂᎨᏒᎢ ᎤᎬᏩᏟ ᏗᏓᏕᏯᏔᎲᏍᎩ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎤᏥ ᎢᎦᎢ. ᏂᎯ ᏰᎵᏯ ᎠᏤᎲᏍᏙᏗ ᎤᏥ ᎢᎦᎢ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Three finger screenshot won't work when you're using the apps below">
                <langSet xml:lang="en-US"><tig><term>Three finger screenshot won't work when you're using the apps below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎢ ᏕᎦᏰᏌᏛ ᎬᏗ ᎠᏓᏴᎳᏔᏍᎩ ᏗᏥᎶᏍᏓ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎬᏗᎭ ᏥᎩ ᎬᏙᏗ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Over time, your device will learn your typical charging pattern. It may take several days for your device to provide optimized charging.">
                <langSet xml:lang="en-US"><tig><term>Over time, your device will learn your typical charging pattern. It may take several days for your device to provide optimized charging.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛ ᎠᏥᎢᎵᏒ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᎤᏠᏱᏊ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎤᎾᎶᎢᏓ. ᎾᎿ ᏰᎵᏯ ᎠᎩᏍᏗ ᎢᎸᏍᎩ ᏧᏒᎯᏓ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notifications to grant access to sensors and camera">
                <langSet xml:lang="en-US"><tig><term>Notifications to grant access to sensors and camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏓᏃᏣᎳᏁᎯ Ꭷ ᎭᎵᏍᎪᎸᏓ ᎠᏴᏍᏗ ᎾᎿᎢ ᎠᏩᏘᏍᎩ ᏃᎴ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Navigate faster, and get more screen space. Instead of on screen buttons, use the fingerprint sensor to navigate.">
                <langSet xml:lang="en-US"><tig><term>Navigate faster, and get more screen space. Instead of on screen buttons, use the fingerprint sensor to navigate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏗ ᎦᏣᏄᎳᎯᎨ, ᏃᎴ ᎠᎩᏍᏗ ᎤᏥ ᎢᎦᎢ ᎠᏴᏙᎳᏛᎢ ᎤᏜᏅᏛ. ᎤᎬᏫᏳᏎᏍᏗ ᎾᎿ ᎤᎿᎢ ᎠᏰᏙᎳᏛᎢ ᏗᏐᎥᏍᏙᏗ, ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎾᎿᎢ ᎠᏂᎩᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting opens the rear camera">
                <langSet xml:lang="en-US"><tig><term>Twisting opens the rear camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏓᏍᏚᎢ ᏥᎩ ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor below the screen to continue">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor below the screen to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎠᏩᏘᏍᎩ ᎡᎳᏗᏨ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᏂᎦᏯᎢᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to split helps you quickly enter split screen mode. This permission commands the system to enter split screen mode when you slide your finger back and forth on the screen. When this service is turned off, Swipe to split will also turn off.">
                <langSet xml:lang="en-US"><tig><term>Swipe to split helps you quickly enter split screen mode. This permission commands the system to enter split screen mode when you slide your finger back and forth on the screen. When this service is turned off, Swipe to split will also turn off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏍᏡᏍᏗ ᎠᎵᏍᏕᎵᏍᎪᎢ ᏂᎯ ᎤᎵᏍᏓᏊ ᎠᏴᏍᏗ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ. ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏚᏁᏤᎸᎩ ᏥᎩ ᏄᏍᏗᏓᏅᎢ ᎾᎿᎢ ᎠᏴᏍᏗ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ ᎢᏳᏃ ᏂᎯ ᎠᏲᏢᏗᎭ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᎠᏨᏍᏗ ᏃᎴ ᎦᏌᏙᏯᏍᏗ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ. ᎢᏳᏃ ᎯᎠ ᎤᎾᏓᏍᏕᎸᏗ ᎨᎡᎢ ᎠᏍᏚᏅᎢ, ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏍᏡᏍᏗ ᎠᏎ ᎾᏍᏊ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up below">
                <langSet xml:lang="en-US"><tig><term>Swipe up below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="That same gesture also lets you switch between the rear and selfie cameras">
                <langSet xml:lang="en-US"><tig><term>That same gesture also lets you switch between the rear and selfie cameras</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏍᎩᎾ ᎤᏠᏱ ᏧᏬᏯᏂᏍᎩ ᎾᏍᏊ ᏗᎵᏍᎪᎸᏔᏅ ᏂᎯ ᎦᏁᏟᏴᏍᏗ ᎤᏜᏅᏛ ᏥᎩ ᎣᏂᏗᏢ ᏃᎴ ᎣᏩᏌ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏟᎶᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try it out below">
                <langSet xml:lang="en-US"><tig><term>Try it out below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏁᎸᏙᏗ ᎨᎡᎢ ᎦᏅᎪᏫᏛ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharging your battery causes strain that can shorten its lifespan. Optimized charging helps your battery stay healthy by reducing the amount of time spent charging over .Your battery will be fully charged at .">
                <langSet xml:lang="en-US"><tig><term>Overcharging your battery causes strain that can shorten its lifespan. Optimized charging helps your battery stay healthy by reducing the amount of time spent charging over .Your battery will be fully charged at .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᏢ ᏗᎬᏩᎶᏙᏗ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᏂᏗᎬᏂᏏᏍᎩ ᎦᏅᏐᎸᏍᏙᏗ ᎥᏍᎩᎾ ᏰᎵᏯ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎨᎡᎢ ᎠᎴᏂᏙᎲᎢ ᏫᎬᏍᏗ. ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᏓᎵᏍᏕᎵᏍᎪ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᎡᏙᎮᏍᏗ ᏙᎯ ᎬᏗ ᎠᎦᏲᎳᎨᏍᏗ ᏥᎩ ᎢᎦᎢ ᎤᎿ ᎠᏥᎢᎵᏒ ᎤᏂᏩᏒᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎢᏴᏛ .ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᎠᏎ ᎨᎡᎢ ᎠᏂᎧᎵ ᎠᎫᏍᏗ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Open camera">
                <langSet xml:lang="en-US"><tig><term>Open camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the sensor quickly">
                <langSet xml:lang="en-US"><tig><term>Tap on the sensor quickly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᎠᏩᏘᏍᎩ ᎤᎵᏍᏓᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby update broadcast">
                <langSet xml:lang="en-US"><tig><term>Dolby update broadcast</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby ᎪᏢᎯᏐᏗ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly see 2 apps at once">
                <langSet xml:lang="en-US"><tig><term>Quickly see 2 apps at once</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᏓᏊ ᎠᎪᏩᏛᏗ 2 ᏗᎬᏙᏗ ᎤᎿᎢ ᏌᏊᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Actions needs permission to access some things on your device. Select &quot;Permissions&quot; in AppInfo to re-enable.">
                <langSet xml:lang="en-US"><tig><term>Moto Actions needs permission to access some things on your device. Select "Permissions" in AppInfo to re-enable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎾᎾᏛᏁᎲᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎢᎦᏓ ᏧᏓᎴᏅᏛ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎠᏑᏰᏍᏗ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᎡᏗ ᎣᏃᎮᏍᎩ ᏏᏊ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the One Button Navigation below to continue">
                <langSet xml:lang="en-US"><tig><term>Touch the One Button Navigation below to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎡᎳᏗᏨ ᎾᎿᎢ ᎠᎯᎸᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold below">
                <langSet xml:lang="en-US"><tig><term>Hold below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏂᏯ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions. Use the toggles to turn gestures on &amp; off, and tap on the descriptions for tutorials and more information.">
                <langSet xml:lang="en-US"><tig><term>Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions. Use the toggles to turn gestures on &amp; off, and tap on the descriptions for tutorials and more information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᎨᎢ ᏧᏬᏯᏂᏍᎩ ᏃᎴ ᎠᏒᏂᏍᏗ ᏂᏓᏓᎳᏗᏍᎬ ᎠᎵᏍᏕᎸᏓ ᏂᎯ ᎠᎵᏂᎬᏁᏗ ᏂᏚᎩᏨᏂᏒ ᎢᎦ ᎢᏗᏛᏁᏗ ᎬᏗ ᎤᏟᏍᏓ ᏃᎴ ᎭᏕᎳᎰᏍᎬᎢ ᏗᏓᏅᏏᏙᎯ. ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎤᏗᏞᎩ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎤᏬᏯᏂᏍᎩ ᎤᎿᎢ &amp; ᎠᏍᏚᎭ, ᏃᎴ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᏂᏚᏍᏛ ᏗᎧᏃᏗ ᎤᎬᏩᏟ ᏗᏓᏕᏲᎲᏍᎩ ᏃᎴ ᎤᏥ ᎢᎦᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Receive service messages">
                <langSet xml:lang="en-US"><tig><term>Receive service messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏍᏗ ᎤᎾᏓᏍᏕᎸᏗ ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show edge lighting for alerts, notifications, and more">
                <langSet xml:lang="en-US"><tig><term>Show edge lighting for alerts, notifications, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎠᏍᏛᎢ ᏗᏨᏍᏗ ᎤᎬᏩᏟ ᏗᏓᏕᏯᏔᎲᏍᎩ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting opens the selfie camera">
                <langSet xml:lang="en-US"><tig><term>Twisting opens the selfie camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏓᏍᏚᎢ ᏥᎩ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera anytime">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᎸᎯᏳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do more with the screen off">
                <langSet xml:lang="en-US"><tig><term>Do more with the screen off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏉ ᎤᏥ ᎢᎦᎢ ᎬᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to back facing camera">
                <langSet xml:lang="en-US"><tig><term>Switch to back facing camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ ᎠᏨᏍᏗ ᎧᏁᏉᏍᏗᏍᎬ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose which camera to open with the twist gesture">
                <langSet xml:lang="en-US"><tig><term>Choose which camera to open with the twist gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎠᏓᏄᏖᏲᎭ ᎤᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera permission must be enabled to use Moto Actions. Please go to the permissions settings in App Info to grant it.">
                <langSet xml:lang="en-US"><tig><term>Camera permission must be enabled to use Moto Actions. Please go to the permissions settings in App Info to grant it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎠᏎ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ Moto ᎾᎾᏛᏁᎲᎢ. ᎰᏩᏊ Ꭷ ᏥᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏕᎦᎧᎲᎢ ᎾᎿ ᎬᏙᏗ ᎧᏃᎮᏢᏗ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎨᎡᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the One Button Navigation quickly">
                <langSet xml:lang="en-US"><tig><term>Tap on the One Button Navigation quickly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎤᎵᏍᏓᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your wallpaper couldn’t be downloaded because your device doesn’t have enough storage.">
                <langSet xml:lang="en-US"><tig><term>Your wallpaper couldn’t be downloaded because your device doesn’t have enough storage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏝᏍᏗ ᎤᎭ ᏰᎵᏉ ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For Attentive Display to work, Moto Actions needs permission to use your camera so it knows when you’re looking at the screen. Tap ALLOW on the following screen to grant permission.">
                <langSet xml:lang="en-US"><tig><term>For Attentive Display to work, Moto Actions needs permission to use your camera so it knows when you’re looking at the screen. Tap ALLOW on the following screen to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ, Moto ᎾᎾᏛᏁᎲᎢ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏓᏛ ᎨᎡᎢ ᎠᏂᎦᏔᎭ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎠᎦᏙᏍᏛ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose a camera">
                <langSet xml:lang="en-US"><tig><term>Choose a camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb settings">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="All 3 fingertips should touch the screen at the same time">
                <langSet xml:lang="en-US"><tig><term>All 3 fingertips should touch the screen at the same time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ 3 ᏕᎯᏰᏌᏛ ᏫᏚᎵᏍᏛᎢ ᎾᎢᏳᏃ ᎠᏒᏂᏍᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎤᎿᎢ ᏥᎩ ᎤᏠᏱ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose which camera to open with the twist gesture">
                <langSet xml:lang="en-US"><tig><term>Choose which camera to open with the twist gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎠᏓᏄᏖᏲᎭ ᎤᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting in portrait opens the selfie camera. Twisting in landscape opens the rear camera.">
                <langSet xml:lang="en-US"><tig><term>Twisting in portrait opens the selfie camera. Twisting in landscape opens the rear camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᎾᎿ ᎠᏰᎵ ᎠᎪᏩᏛᏙᏗ ᏓᏍᏚᎢ ᏥᎩ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᎠᏓᏄᏖᏲᎭ ᎾᎿ ᎦᏅᎯᏒᎢ ᏓᏍᏚᎢ ᏥᎩ ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="End time">
                <langSet xml:lang="en-US"><tig><term>End time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ ᎠᎵᏍᏆᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically adjust 5G connection and data transfer mode to save battery">
                <langSet xml:lang="en-US"><tig><term>Automatically adjust 5G connection and data transfer mode to save battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᎣᏍᏓ ᏱᎬᏁᎸᎢ 5Ꮆ ᎫᏓᎸᎢ ᏃᎴ ᎦᏟᏌᏅ ᎠᎲᏍᏗ ᎬᏙᏗ ᎠᎵᏏᏅᏙᏗ ᎠᎾᎦᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your wallpaper couldn’t be downloaded. Try again later.">
                <langSet xml:lang="en-US"><tig><term>Your wallpaper couldn’t be downloaded. Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ. ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Live wallpapers can’t be previewed in the work profile version of this app.">
                <langSet xml:lang="en-US"><tig><term>Live wallpapers can’t be previewed in the work profile version of this app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊᏥᎩ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎠᏓᎪᏩᏛᏗᏍᎩ ᎾᎿ ᏥᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏄᏍᏗᏓᏅᎢ ᏄᏓᎴᏒᎢ ᎾᎿ ᎯᎠ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Service to download wallpapers in foreground">
                <langSet xml:lang="en-US"><tig><term>Service to download wallpapers in foreground</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏍᏕᎸᏗ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ ᎾᎿ ᎠᎬᏱᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="About">
                <langSet xml:lang="en-US"><tig><term>About</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Never">
                <langSet xml:lang="en-US"><tig><term>Never</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your wallpaper couldn’t be downloaded because your network connection was interrupted.">
                <langSet xml:lang="en-US"><tig><term>Your wallpaper couldn’t be downloaded because your network connection was interrupted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏂᏨᎤᎢ ᏧᎾᏚᏓᎵ ᎫᏓᎸᎢ ᎨᏎᎢ ᎤᏓᏲᏍᏓᏁᎸᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Text is too long, remove some characters.">
                <langSet xml:lang="en-US"><tig><term>Text is too long, remove some characters.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ ᎨᏒᎩ ᏯᎪᎯᎳ, ᎢᎬᎾᏕᏍᏗ ᎢᎦᏓ ᎪᏪᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Version info">
                <langSet xml:lang="en-US"><tig><term>Version info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏓᎴᏒᎢ ᎧᏃᎮᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No preferred SIM selected for sending SMS messages">
                <langSet xml:lang="en-US"><tig><term>No preferred SIM selected for sending SMS messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎤᏟ ᎠᏰᎸᏅ SIM ᎠᏑᏰᏒᎢ ᎤᎬᏩᏟ ᏫᎦᏅᎥᏍᎬᎢ SMS ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Storage space is low. Some data may be lost.">
                <langSet xml:lang="en-US"><tig><term>Storage space is low. Some data may be lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗ ᎤᏜᏅᏛ ᎨᏒᎢ ᎡᎳᏗ. ᎢᎦᏓ ᎦᏟᏌᏅᎯ ᎡᎵᏊ ᎤᏂᏲᎱᏎᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Read:\u0020">
                <langSet xml:lang="en-US"><tig><term>Read:\u0020</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ:\u0020</term></tig></langSet>
            </termEntry>
            <termEntry id=" attachment saved to &quot;&quot; album">
                <langSet xml:lang="en-US"><tig><term> attachment saved to "" album</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏠᏯᏍᏛᎢ ᎠᎵᏏᏅᏔᏅᎢ ᎾᎿᎢ "" ᎠᏜᏩᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Image preview is unavailable">
                <langSet xml:lang="en-US"><tig><term>Image preview is unavailable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏅᏓᏗᏍᏙ ᎠᏓᎪᏩᏛᏗᏍᎩ ᎨᏒᎢ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't load attachment. Try again.">
                <langSet xml:lang="en-US"><tig><term>Can't load attachment. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎯᏢᎦ ᎠᏠᏯᏍᏛᎢ. ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No messages on SIM">
                <langSet xml:lang="en-US"><tig><term>No messages on SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏗᎪᎵᏰᏗ ᎤᎾᎢ SIM</term></tig></langSet>
            </termEntry>
