            <termEntry id="To set the time zone using your location, turn on location, then update time zone settings">
                <langSet xml:lang="en-US"><tig><term>To set the time zone using your location, turn on location, then update time zone settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᎧᎲᎢ ᏥᎩ ᎠᏥᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ ᎬᏗᎭ ᏂᏨᎤᎢ ᎤᎿ ᎢᎬᎾᏕᎾ, ᎯᏍᏚᎢ ᎤᎿ ᎢᎬᎾᏕᎾ, ᎢᏳᏃ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏥᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You and your child can delete their fingerprint images and model, or turn off Fingerprint Unlock at any time in Settings. Fingerprint images and models are stored on the phone until they\u2019re deleted.">
                <langSet xml:lang="en-US"><tig><term>You and your child can delete their fingerprint images and model, or turn off Fingerprint Unlock at any time in Settings. Fingerprint images and models are stored on the phone until they\u2019re deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏍᎪᎸᏗᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏚᏓᏴᎳᏛ ᏃᎴ ᎪᎱᏍᏗ, ᏃᎴ ᎠᏍᏚᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ ᎾᎿ ᏕᎦᎧᎲᎢ. ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏚᏓᏴᎳᏛ ᏃᎴ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᎩᎳ ᏂᎯ ᎠᏍᎪᎸᏗᏍᏗ ᎢᏯᏂᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open camera quickly">
                <langSet xml:lang="en-US"><tig><term>Open camera quickly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᏟᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatic rule set to turn on Do Not Disturb during specified times">
                <langSet xml:lang="en-US"><tig><term>Automatic rule set to turn on Do Not Disturb during specified times</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᏗᎧᎾᏩᏛᏍᏙᏗ ᎦᎧᎲᎢ ᎾᎢ ᎠᏍᏚᎢᏓ ᎦᎧᎲᎢ ᎠᏍᏚᎢᏓ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᎯᏳ ᎠᏎᎸᏃ ᏓᏟᎢᎵᏒᎢ</term></tig></langSet>
            </termEntry>
