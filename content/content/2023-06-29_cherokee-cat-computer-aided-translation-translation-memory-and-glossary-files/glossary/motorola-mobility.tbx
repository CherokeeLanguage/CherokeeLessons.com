            <termEntry id="To mute your phone while recording a video, Camera needs permission to access Do Not Disturb. Tap CONTINUE to grant permission.">
                <langSet xml:lang="en-US"><tig><term>To mute your phone while recording a video, Camera needs permission to access Do Not Disturb. Tap CONTINUE to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏣᏤᎵ ᎡᎳᏪᎢ ᏅᎦ ᏗᏟᏃᎮᏗ ᎾᎯᏳᎢ ᏕᎯᏂᏴᏗᏍᎬ ᎾᏍᎩ ᎠᏓᏴᎳᏛᏍᎩ, ᏗᏓᏥᎶᏍᏗᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ. ᎭᏐᎥᏍᏓ ᏂᎦᏯᎢᏒᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera Busy">
                <langSet xml:lang="en-US"><tig><term>Camera Busy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᎪᏓ ᏚᎸᏫᏍᏓᏁᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Resolution can't be changed in this mode">
                <langSet xml:lang="en-US"><tig><term>Resolution can't be changed in this mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᏙᏗ ᎨᏍᏗ ᏰᎵ ᎦᏁᏟᏴᏓ ᎨᏎᏍᏗ ᎾᎿᎢ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="HDR will be turned off when you turn on Active Photos">
                <langSet xml:lang="en-US"><tig><term>HDR will be turned off when you turn on Active Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>HDR ᎨᏎᏍᏗ ᎠᏍᏚᏗ ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᎤᏍᏆᎳ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected camera isn\’t supported. Disconnect to open the Camera app.">
                <langSet xml:lang="en-US"><tig><term>Connected camera isn\’t supported. Disconnect to open the Camera app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏝᏰᏃ ᎦᎫᏍᏛᏅᎢ ᏱᎩ. ᏭᏓᎳᎩ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera couldn't capture media because the SD card is unavailable.">
                <langSet xml:lang="en-US"><tig><term>Camera couldn't capture media because the SD card is unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᏄᎸᏅᎢ ᎦᏂᏴᏗ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᏍᎩ SD ᏆᏂᏲᏍᏗ ᏄᏍᏛ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically enhance blurry photos">
                <langSet xml:lang="en-US"><tig><term>Automatically enhance blurry photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏓᏤᎴᏍᏗ ᎤᏍᎪᎸ ᏓᏓᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Welcome! Don\’t forget, you can also open the camera by twisting your wrist twice.">
                <langSet xml:lang="en-US"><tig><term>Welcome! Don\’t forget, you can also open the camera by twisting your wrist twice.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏨᏓᏂᎸ! ᏤᏍᏗ\ ᏥᏠᎨᏫᏏ, ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᏱᏍᏚᎢ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎬᏗ ᎯᏄᏖᏯᏍᏗᏍᎬ ᏣᏤᎵ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera needs permission to access some things on your device. To grant permissions, tap on \“Permissions\” in App info.">
                <langSet xml:lang="en-US"><tig><term>Camera needs permission to access some things on your device. To grant permissions, tap on \“Permissions\” in App info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎢᎦᏓ ᏧᏓᎴᏅᏛ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ, ᎤᎾᎢ ᎭᏐᎥᏍᏓ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᏙᏗ ᎧᏃᎸᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
