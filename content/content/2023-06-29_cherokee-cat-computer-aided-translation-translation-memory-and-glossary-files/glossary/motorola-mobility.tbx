            </termEntry>
            <termEntry id="Unable to activate Wi-Fi calling at this time.">
                <langSet xml:lang="en-US"><tig><term>Unable to activate Wi-Fi calling at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ Wi-Fi ᏓᏯᏂᏍᎬ ᎤᎿᎢ ᎯᎠ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again later.">
                <langSet xml:lang="en-US"><tig><term>Please try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We could not find the address that you entered because the street address could not be found, or the city, state, and zip code may not be correct.">
                <langSet xml:lang="en-US"><tig><term>We could not find the address that you entered because the street address could not be found, or the city, state, and zip code may not be correct.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ Ꮭ ᏰᎵ ᎠᏩᏛᏗ ᏥᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎥᏍᎩᎾ ᏂᎯ ᎠᏴᏍᏙᏗ ᏂᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏥᎩ ᎦᎳᏅᏛᎢ ᎪᏪᎵ ᏧᏁᏍᏗᎢ Ꮭ ᏰᎵ be ᎠᏩᏛᏓ, ᎠᎴ ᏥᎩ ᎦᏚᎲ, ᎧᏃᎮᏗ, ᎠᎴ ᏫᎦᏅᏗ ᎠᏎᏍᏗ ᏰᎵᏯ ᎥᏝ ᎨᎡᎢ ᏚᏳᎪᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If your city, state, and zip are not correct tap Edit, otherwise tap Save Anyway.">
                <langSet xml:lang="en-US"><tig><term>If your city, state, and zip are not correct tap Edit, otherwise tap Save Anyway.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᏨᎤᎢ ᎦᏚᎲ, ᎧᏃᎮᏗ, ᎠᎴ ᎯᎧᏁᎦ ᎨᎡᎩ ᎥᏝ ᏚᏳᎪᏛᎢ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎦᏁᏟᏴᏓ ᎪᏪᎸ, ᎢᏳᏃ ᏰᎵ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎭᎵᏏᏅᏓ ᏱᏂᎦᎵᏍᏗᏉ.</term></tig></langSet>
            </termEntry>
            <termEntry id="(Roaming charges may apply)">
                <langSet xml:lang="en-US"><tig><term>(Roaming charges may apply)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>(ᎡᏙᎵᏙᎲ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎲᏓ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Calling lets you make calls using Wi-Fi when the mobile network is not available.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi Calling lets you make calls using Wi-Fi when the mobile network is not available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᏗᎵᏍᎪᎸᏔᏅ ᏂᎯ ᎪᏢᏗ ᏓᏯᏂ ᎬᏗᎭ Wi-Fi ᎢᏳᏃ ᏥᎩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To set up Wi-Fi Calling you will need to enter a US address.">
                <langSet xml:lang="en-US"><tig><term>To set up Wi-Fi Calling you will need to enter a US address.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ Wi-Fi ᏓᏯᏂᏍᎬ ᏂᎯ ᎠᏎ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏴᏍᏗ Ꭰ US ᎪᏪᎵ ᏧᏁᏍᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This address will be used by emergency services as your location if you make an emergency \(E911\) call over Wi-Fi from this phone within the US.">
                <langSet xml:lang="en-US"><tig><term>This address will be used by emergency services as your location if you make an emergency \(E911\) call over Wi-Fi from this phone within the US.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎠᏎ ᎨᎡᎢ ᎬᏔᏅᎢ ᎬᏗ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ ᎨᎡᎢ ᏂᎯ ᎪᏢᏗ Ꭰ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ \(E911\) ᏪᏯᎾ ᎢᏴᏛ Wi-Fi ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᏗᏟᏃᎮᏗ ᎠᏫᏂᏗᏢ ᏥᎩ US.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap for details on battery and data usage">
                <langSet xml:lang="en-US"><tig><term>Tap for details on battery and data usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎬᏩᏟ ᏂᏕᎬᎿᏅᎢ ᎾᎿ ᎠᎾᎦᎵᏍᎩ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
