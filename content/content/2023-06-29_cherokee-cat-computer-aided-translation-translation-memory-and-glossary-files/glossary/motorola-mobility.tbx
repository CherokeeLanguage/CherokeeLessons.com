                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᏗᎬᏁᏗ ᏗᏨᏍᏗ ᎾᏍᎩ ᎤᎾᎢ ᎠᏍᏛᎢ ᎤᎾᏃ ᏗᏁᎶᏗ ᎤᏃᏴᎬᎢ ᏄᏍᏛ ᎪᎷᏩᏛᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch sensitivity enhances touch response for quicker interactions. This feature increases battery usage.">
                <langSet xml:lang="en-US"><tig><term>Touch sensitivity enhances touch response for quicker interactions. This feature increases battery usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎩᎶᏈᏴ ᎤᏓᏁᏟᏴᏌᏓ ᏓᏤᏢᎩ ᎠᏒᏂᏍᏗ ᏄᏛᏁᎸᎩ ᎾᏍᎩᎾ ᏄᎵᏍᏛᏊ ᏂᏓᏔᎳᏗᏍᎬ. ᎯᎠ ᎠᏠᏯᏍᏛᎢ ᎧᏁᏉᎪᎢ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch sensitivity">
                <langSet xml:lang="en-US"><tig><term>Touch sensitivity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎩᎶᏈᏴ ᎤᏓᏁᏟᏴᏌᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="No games">
                <langSet xml:lang="en-US"><tig><term>No games</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏧᎾᏁᎸᏙᏗ</term></tig></langSet>
