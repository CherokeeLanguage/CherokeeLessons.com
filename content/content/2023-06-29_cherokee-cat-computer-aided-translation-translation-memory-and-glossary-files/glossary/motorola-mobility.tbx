                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ APN</term></tig></langSet>
            </termEntry>
            <termEntry id="Face Unlock">
                <langSet xml:lang="en-US"><tig><term>Face Unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Conversation space is a dedicated area in the notification curtain where you can easily access chat conversations.">
                <langSet xml:lang="en-US"><tig><term>Conversation space is a dedicated area in the notification curtain where you can easily access chat conversations.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎤᏜᏅᏛ ᎾᏍᎩ ᎣᏏ ᎠᏰᎸᏅ ᎢᎬᎾᏕᎾ ᎾᎿᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏯᏙᎳᏛᏗ ᎤᎾᏃ ᏂᎯ ᎠᎯᏗᎨᎢ ᏣᏴᏍᏗ ᎦᏬᏂᎯᏍᏗ ᏓᎾᏟᏃᎮᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Also, when you mark contacts and conversations as important, they can bypass Do Not Disturb and always show up at the top of your notifications.">
                <langSet xml:lang="en-US"><tig><term>Also, when you mark contacts and conversations as important, they can bypass Do Not Disturb and always show up at the top of your notifications.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᏊ, ᎾᎯᏳ ᏂᎯ ᎰᏪᎸᎦ ᏗᏟᏃᎮᏙᏗ ᎠᎴ ᏓᎾᏟᏃᎮᏍᎬᎢ ᎾᏍᎩ ᎤᎵᏍᎨᏓ, ᎾᏍᎩ ᏰᎵᏊ ᏯᎾᏕᏯᏍᎩ ᏞᏍᏗ ᏣᏓᏕᏯᏙᏔᏅᎩ ᎠᎴ ᏂᎪᎯᎸ ᎬᎿᎨᏒᎢ ᏂᎦᎵᏍᏗᏍᎪ ᎦᏚᎢ ᎾᏍᎩ ᏣᏤᎵ ᏗᏓᏃᏣᎳᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="GSM call settings ()">
                <langSet xml:lang="en-US"><tig><term>GSM call settings ()</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>GSM ᏫᎬᏔᏅ ᏕᎦᎧᎲᎢ ()</term></tig></langSet>
            </termEntry>
            <termEntry id="An app wants to turn off Bluetooth">
                <langSet xml:lang="en-US"><tig><term>An app wants to turn off Bluetooth</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎬᏙᏗ ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎠᏍᏚᏗ Bluetooth</term></tig></langSet>
            </termEntry>
            <termEntry id="Android 10\’s new gesture navigation makes it easier than ever to go Home, back, see recent apps, and open the Google Assistant.">
                <langSet xml:lang="en-US"><tig><term>Android 10\’s new gesture navigation makes it easier than ever to go Home, back, see recent apps, and open the Google Assistant.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android 10\’s ᎢᏤ ᎤᏬᏯᏂᏍᎩ ᎠᏓᏘᏂᏙᎯ ᎠᎯᏗᎨ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎿᏉᏃ ᎢᎸᎯᏳᎢ ᎠᏂᎩᏍᏗ, ᎠᏨᏓ, ᎯᎪᏩᏔ ᎾᏞᎬ ᏗᎬᏙᏗ, ᎠᎴ ᎯᏍᏚᎢ ᎾᏍᎩ Google ᎠᎵᏍᏕᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Full control is appropriate for apps that help you with accessibility needs, but not for most apps.">
                <langSet xml:lang="en-US"><tig><term>Full control is appropriate for apps that help you with accessibility needs, but not for most apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎧᎵᏨᎯ ᏗᎫᎪᏔᏂᏓᏍᏗ ᏚᏳᎪᏛᎢ ᎤᎬᏩᏟ ᏗᎬᏙᏗ ᎥᏍᎩᎾ ᎠᎵᏍᏕᎸᏓ ᏂᎯ ᎬᏗ ᎬᏴᏍᏗ ᎨᏒᎢ ᎤᏚᎸᏗ ᏄᎾᏛᏅ, ᎠᏎᏍᎩᏂ ᎥᏝ ᎤᎬᏩᏟ ᎤᎪᏗᏗ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Stop Recording button">
                <langSet xml:lang="en-US"><tig><term>Stop Recording button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᏫᏍᏓ ᎦᏂᏴᎲᎢ ᎦᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen">
                <langSet xml:lang="en-US"><tig><term>Screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Scan and connect stylus">
                <langSet xml:lang="en-US"><tig><term>Scan and connect stylus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏚᏟᎶᏍᏗᏍᎩ ᎠᎴ  ᏗᎵᎪᏙᏗ ᎠᎾᎦᎵᏍᎩᏗᎪᏪᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Tips">
                <langSet xml:lang="en-US"><tig><term>Moto Tips</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎠᏍᏕᎸᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bug report">
                <langSet xml:lang="en-US"><tig><term>Bug report</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎪᏯ ᎬᏂᎨᏒ ᎢᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you mark notifications as “Silent”, they won’t make a noise or appear on your lock screen, so you\’ll only see the notifications that matter to you.">
                <langSet xml:lang="en-US"><tig><term>When you mark notifications as “Silent”, they won’t make a noise or appear on your lock screen, so you\’ll only see the notifications that matter to you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎰᏪᎸᎦ ᏗᏓᏃᏣᎳᏁᎯ ᎾᏍᎩ “ᎡᎳᏪᎢ”, ᏞᏍᏗ ᎾᏍᎩ ᏱᏛᏓᏃᏟᏍᏔᎾ ᎠᎴᏃ ᎦᎾᏄᎪᎦ ᎤᎾᎢ ᏣᏤᎵ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ, ᎾᏍᎩ ᏂᎯ\’ll ᎤᏩᏌ ᎯᎪᏩᏔ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎾᏍᎩᎾᎢ ᎤᎵᏍᎨᏗᏳ ᏂᏨᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Additionally, Android 10 uses on-device machine learning to predict what you\’ll type next and suggest responses that are tailored to the messages you receive.">
                <langSet xml:lang="en-US"><tig><term>Additionally, Android 10 uses on-device machine learning to predict what you\’ll type next and suggest responses that are tailored to the messages you receive.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏨ, Android 10 ᏗᎬᏔᏂᏓᏍᏗ ᎤᎾᎢ-ᏥᏂᎬᏅᏗᏓᎾ ᎠᏢᏅᏙᏗ ᎠᏕᎶᏆᏍᎬ ᎾᎢ ᎨᏴ ᏩᎪᏩᏛᏗ ᎢᏳᏍᏗ ᏂᎯᎾᎢ ᎠᏐᎥᏍᏙᏗ ᏔᎵᏁᎢ ᎠᎴ ᎧᏁᎢᏍᏙᏔᏅ ᏗᎦᏬᎯᎵᏴᏓ ᎾᏍᎩᎾᎢ ᏓᏤᏢ ᏱᎬᏁᎸᎩ ᎾᏍᎩ ᏗᎧᏃᎮᏍᎩ ᏕᏣᏁᏒᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Stop vibration, tap, keyboard">
                <langSet xml:lang="en-US"><tig><term>Stop vibration, tap, keyboard</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᏫᏍᏙᏓ ᎠᎵᏖᎸᎲᏍᎬ, ᎦᏛᏗ, ᏗᏐᏅᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Using a controller">
                <langSet xml:lang="en-US"><tig><term>Using a controller</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎬ ᏗᏱᎴᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your stylus lost its connection">
                <langSet xml:lang="en-US"><tig><term>Your stylus lost its connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏣᏤᏁ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᏣᏲᎱᏏ ᏗᎵᎪᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart Reply also suggests actions, such as opening an address in Google Maps, to save you even more time.">
                <langSet xml:lang="en-US"><tig><term>Smart Reply also suggests actions, such as opening an address in Google Maps, to save you even more time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᎦᏬᎯᎵᏴᏓ ᎾᏍᏉ ᏗᎧᏁᎢᏍᏙᏗ  ᎢᏗᏛᏁᏗ, ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎠᏍᏚᎢᏍᎬ ᎾᏍᎩ ᎤᏃᎮᏓ ᎾᎿᎢ Google Maps, ᎾᎢ ᎭᎵᏏᏅᏓ ᎥᏍᏊ ᎤᏟ ᎢᎦᎢ ᎠᏟᎢᎵᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It can track your interactions with an app or a hardware sensor, and interact with apps on your behalf.">
                <langSet xml:lang="en-US"><tig><term>It can track your interactions with an app or a hardware sensor, and interact with apps on your behalf.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏊ ᎪᎷᏅᏍᏗ ᏂᏨᎤᎢ ᏓᎾᎵᏃᎮᏍᎬᎩ ᎬᏗ Ꭰ ᎬᏙᏗ ᎠᎴ Ꭰ ᏔᎷᎩᏍᎩ ᎠᏓᎾᏅᎢ ᎠᏩᏘᏍᎩ, ᎠᎴ ᎤᏪᎳᏗᏓᏍᏗ ᎬᏗ ᎬᏙᏗ ᎾᎿ ᏂᏨᎤᎢ ᎾᏍᎩ ᎤᎵᏍᏕᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can hear sound from your phone, a connected audio device, or your display.">
                <langSet xml:lang="en-US"><tig><term>You can hear sound from your phone, a connected audio device, or your display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎠᏛᎬᎦ ᏯᏛᎬᎦ ᎤᏃᏴᎬᎢ ᏂᏓᏳᏓᎴᏅ ᏣᏤᎵ ᏗᏟᏃᎴᏗ, ᎾᏍᎩ ᎫᏓᎸᏅᎯ ᎤᏃᏴᎬ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᎴᏃ ᏣᏤᎵ ᎬᏂᎨᏒ ᏱᎬᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Channel to notify the user about changing the default SMS application">
                <langSet xml:lang="en-US"><tig><term>Channel to notify the user about changing the default SMS application</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎳᏅᏛ ᎾᎿᎢ ᎠᏓᏃᎯᏎᏗ ᏥᎩ ᎬᏗᏍᎩ ᎢᏳᏰᎸᏛ ᏕᎦᏁᏟᏴᏒᎢ ᏥᎩ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ SMS ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM network unlock PIN">
                <langSet xml:lang="en-US"><tig><term>SIM network unlock PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᏧᎾᏚᏓᎵ ᎠᏂᏐᎭᎾᎳᎩ PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Easier sharing">
                <langSet xml:lang="en-US"><tig><term>Easier sharing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᏳ ᎠᏯᏙᎯᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Turn your head a little less.">
                <langSet xml:lang="en-US"><tig><term>Turn your head a little less.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᏗ ᏂᏨᎤᎢ ᎠᏍᎪᎳ Ꭰ ᎦᏲᎵ ᎦᏲᎵᎨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Voice Assist">
                <langSet xml:lang="en-US"><tig><term>Voice Assist</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎬ ᎠᏓᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Analytics Service">
                <langSet xml:lang="en-US"><tig><term>Analytics Service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎫᎪᏙᏗ ᎢᏯᏓᏛᏁᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switched to ">
                <langSet xml:lang="en-US"><tig><term>Switched to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="ON">
                <langSet xml:lang="en-US"><tig><term>ON</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Chat head, system, alert, window, dialog, display, on top other apps, draw">
                <langSet xml:lang="en-US"><tig><term>Chat head, system, alert, window, dialog, display, on top other apps, draw</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏬᏂᎯᏍᏗ ᎠᏍᎪᎵ, ᏄᏍᏗᏓᏅᎢ, ᎠᏓᏃᏎᎯ, ᏦᎳᏂ, ᏗᏟᏃᎮᏗ, ᎬᏂᎨᏒ ᎢᎬᏁᏗ, ᎤᎾᎢ ᎦᏚᎢ ᏐᎢ ᏗᎬᏙᏗ, ᏗᎵᎶᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency call">
                <langSet xml:lang="en-US"><tig><term>Emergency call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᏓᏯᏂ </term></tig></langSet>
            </termEntry>
            <termEntry id="Minutes circular slider">
                <langSet xml:lang="en-US"><tig><term>Minutes circular slider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏔᏬᏍᏔᏅᎯ ᎬᏩᏕᏫᏛ ᏗᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Forgot your username or password\?">
                <langSet xml:lang="en-US"><tig><term>Forgot your username or password\?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏩᎨᏫᏒᎢ ᏂᏨᎤᎢ ᎬᏗᏍᎩ ᏚᏙᎥᎢ ᎠᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ\?</term></tig></langSet>
            </termEntry>
            <termEntry id="Unpin from taskbar">
                <langSet xml:lang="en-US"><tig><term>Unpin from taskbar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎭᏕᎦ ᏂᏛᏓᎴᏂᏍᎩ ᎢᏯᏛᏁᏗ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Nearby Share lets you send files to another Android device without relying on an internet or data connection.">
                <langSet xml:lang="en-US"><tig><term>Nearby Share lets you send files to another Android device without relying on an internet or data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥᏂᎨᏍᏗ ᎠᏯᏙᎯᏍᏗ ᏣᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᏫᏗᏣᏅᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎢ ᏄᏓᎴ Android ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᎠᎵᏍᎨᏍᏗᏍᎬ ᎤᎾᎢ ᎠᏏᎳᏕᏫᏒᎢ ᎠᎴᏃ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It’s a fast, convenient, and secure way to share content with a device that’s near you.">
                <langSet xml:lang="en-US"><tig><term>It’s a fast, convenient, and secure way to share content with a device that’s near you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏣᏄᎳ, ᎠᎯᏗᎨᏍᏗ, ᎠᎴ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎢᏳᏍᏗ ᎠᏯᏙᎯᏍᏗ ᎦᎸᏛᎢ ᎤᏠᏯᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩᎾᎢ ᏄᏍᏛ ᎾᎥᏂᎨᏍᏗ ᎮᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No SIM card in tablet.">
                <langSet xml:lang="en-US"><tig><term>No SIM card in tablet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ SIM ᏆᎾᏲᏍᏗ ᎾᎿ ᏗᎪᏪᎶᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Flashlight, Light, Torch">
                <langSet xml:lang="en-US"><tig><term>Flashlight, Light, Torch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ, ᎢᎦᎦᏘ, ᎠᏨᏍᏓᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It can read all content on the screen and display content over other apps.">
                <langSet xml:lang="en-US"><tig><term>It can read all content on the screen and display content over other apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏊ ᎠᎪᎵᏰᏗ ᏂᎦᏓ ᏄᏍᏗᏓᏅ ᎾᎿ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᎠᏓᏴᎳᏔᏍᎩ ᏄᏍᏗᏓᏅ ᎠᏓᏬᎯᎳᏗᏍᎬ ᏐᎢ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To unlock, sign in with your Google account.">
                <langSet xml:lang="en-US"><tig><term>To unlock, sign in with your Google account.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ, ᏚᏙᎥ ᎪᏪᎶᏗ ᎬᏗ ᏂᏨᎤᎢ Google ᎠᏚᏓᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Shows at top of conversation section, appears as floating bubble, displays profile picture on lock screen">
                <langSet xml:lang="en-US"><tig><term>Shows at top of conversation section, appears as floating bubble, displays profile picture on lock screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏱᏗᎬᏁᎯ ᎤᎿᎢ ᎦᏚ ᏗᏟᏃᎮᏗ ᎤᏓᏡᎬ, ᎦᎾᏄᎪᎦ ᎾᏍᎩ ᎠᏟᏲᎷᎲᏍᎦ ᎠᎵᏆᎷᎲᏍᎬ, ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᎤᎾᎢ  ᏍᏓᏯ ᎦᏐᎭᎾᎳ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Better privacy protection">
                <langSet xml:lang="en-US"><tig><term>Better privacy protection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᎳ ᎤᏕᎵᏓ  ᎠᏓᎵᏍᎦᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Default home country">
                <langSet xml:lang="en-US"><tig><term>Default home country</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎣᏪᏅᏒ ᎠᏰᎵ ᎤᏙᏢᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Account status">
                <langSet xml:lang="en-US"><tig><term>Account status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏚᏓᎸᏙᏗ ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To scroll, swipe on the OK button.">
                <langSet xml:lang="en-US"><tig><term>To scroll, swipe on the OK button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏆᎴᏯᏍᏗ ᎾᎾᎢ, ᎦᏅᎦᏙᏓ ᎭᏂᎩᏍᏗ ᎾᏍᎩ ᏛᏓᏁᎸᎬ ᎠᏐᏅᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Font size">
                <langSet xml:lang="en-US"><tig><term>Font size</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛ ᎠᏙᏪᎵᏍᎩ ᎢᎩᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Display available shortcuts">
                <langSet xml:lang="en-US"><tig><term>Display available shortcuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎠᏛᏅᎢᏍᏔᏅ ᏍᏆᎳ ᎢᏗᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="To display the current wallpaper here,  needs access to your device's storage.">
                <langSet xml:lang="en-US"><tig><term>To display the current wallpaper here,  needs access to your device's storage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎾᏍᎩ ᏃᏊᏥᎩ ᎠᏂ ᎧᏑᎧᏡ ᎪᏪᎵT,  ᎠᏴᏍᏗ ᏚᏚᎸᏛᎢ ᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏍᏛ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Display size">
                <langSet xml:lang="en-US"><tig><term>Display size</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎢᎩᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Other options are disabled by your admin">
                <langSet xml:lang="en-US"><tig><term>Other options are disabled by your admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏐᎢ ᏗᏑᏰᏍᏗ ᎾᏍᎩ ᎠᎴᏫᏍᏙᏔᏅᎢ ᏄᏩᏅ ᏣᏤᎵ ᎤᎦᏎᏍᏗᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold the top of your phone to another device to send app content like browser pages, contacts and more.">
                <langSet xml:lang="en-US"><tig><term>Hold the top of your phone to another device to send app content like browser pages, contacts and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏚ ᏣᏂᏴᏎᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎾᎢ ᏅᏩᏓᎴᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏫᎦᏅᏗ ᎬᏙᏗ ᎦᎸᏛᎢ ᎾᏍᎩ ᎢᏳᏍᏗ ᏗᏍᏚᎢᏍᎩ ᏚᎦᏅᏓᏛᎢ, ᏗᏟᏃᎮᏙᏗ ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure both devices have Android Beam turned on.">
                <langSet xml:lang="en-US"><tig><term>Make sure both devices have Android Beam turned on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎡᏧᎳ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏂᏚᏍᏕᏍᏗ Android Beam ᎾᏍᎩ ᎠᏍᏚᎢᏓ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold the top of your phone to NFC capable terminals for quick and secure payments.">
                <langSet xml:lang="en-US"><tig><term>Hold the top of your phone to NFC capable terminals for quick and secure payments.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏚ ᏣᏂᏴᏎᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎾᎾᎢ NFC ᏰᎵᏉ ᎢᏗᎬᏁᏗ ᎠᎾᎦᎵᏍᎩ ᏓᏠᎯᏍᏛᎢ ᎾᏍᎩᎾ ᎤᏟᏍᏓ ᎠᎴ ᏄᎾᏰᎯᏍᏛᎾᏉ ᏗᏈᏴᎲᎯᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use with Tap and Pay">
                <langSet xml:lang="en-US"><tig><term>Use with Tap and Pay</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎤᏠᏯᏍᏗ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎴ ᎠᏈᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will allow data to be exchanged when you touch another NFC device.">
                <langSet xml:lang="en-US"><tig><term>This will allow data to be exchanged when you touch another NFC device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎦᏟᏌᏅᎯ ᎦᏁᏟᏴᏓ ᎾᎯᏳ ᏂᎯ ᏱᏒᏂᎳ  ᏅᏩᏓᎴᎢ NFC ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="ResearchReceive invitations to participate in studies or surveys that improve our products and services.">
                <langSet xml:lang="en-US"><tig><term>ResearchReceive invitations to participate in studies or surveys that improve our products and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᎦᏛᏂᏙᎸᎢᎠᏂᏁᏒᎢ ᏗᏓᏯᏅᏙᏗ ᎾᏍᎩ ᎨᎳᏗᏓᏍᏗ ᎾᎿᎢ ᏧᎾᎦᏎᏍᏙᏗᎢ ᎠᎴᏃ ᏗᎦᏛᏂᏗᏍᏗ ᎾᏍᎩᎾᎢ ᏗᏤᎳᏍᏙᏗ ᏗᎦᎾᏗᎤᏗ ᎠᎴᏃ ᎢᏗᏓᏛᏁᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="News and updatesBe the first to know about software updates, upcoming products, and special offers.">
                <langSet xml:lang="en-US"><tig><term>News and updatesBe the first to know about software updates, upcoming products, and special offers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏃᏣᎸᏗ ᎠᎴ ᏗᎪᏢᎯᏐᏗᎤᏂᎲ ᎾᏍᎩ ᎠᎬᏱ ᎤᎾᏅᏘᏍᏗ ᏄᏰᎵᏛᎢ ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᏗᎪᏢᎯᏐᏗ, ᎤᎾᏄᎪᎢᏍᏗ ᏗᎦᎾᏗᎤᏗ, ᎠᎴ ᎤᏓᏤᏟᏓ ᏓᏂᏍᎪᎸᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="ID number*">
                <langSet xml:lang="en-US"><tig><term>ID number*</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ID ᎠᏎᏍᏗ*</term></tig></langSet>
            </termEntry>
            <termEntry id="Write Notifications">
                <langSet xml:lang="en-US"><tig><term>Write Notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᏗᏓᏃᏣᎳᏁᎯ </term></tig></langSet>
            </termEntry>
            <termEntry id="Open Log">
                <langSet xml:lang="en-US"><tig><term>Open Log</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏄᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Copy Logs to SDCard">
                <langSet xml:lang="en-US"><tig><term>Copy Logs to SDCard</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᎶᏍᏔᏅᎯ  ᏂᏚᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ ᎾᎾᎢ SDCard</term></tig></langSet>
            </termEntry>
            <termEntry id="Please use the following command to get the minimal log:">
                <langSet xml:lang="en-US"><tig><term>Please use the following command to get the minimal log:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎾᏍᎩ ᎬᏙᏗ ᎠᏍᏓᏩᏛᏍᏗ ᎤᏁᏤᎸ ᎾᎢ ᎠᎩᏍᎬ ᎾᏍᎩ ᏭᏍᏗᎬᏊ ᏄᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Close Log">
                <langSet xml:lang="en-US"><tig><term>Close Log</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎲᎦ ᏄᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Motorola Privacy">
                <langSet xml:lang="en-US"><tig><term>Motorola Privacy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Motorola ᎤᏕᎵᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="Allows sending to the internal BroadcastReceiver.">
                <langSet xml:lang="en-US"><tig><term>Allows sending to the internal BroadcastReceiver.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏫᎦᏅᏍᎩ ᎾᏍᎩ ᎭᏫᏂ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᎠᎩᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the control panel to set daily screen time limits, view app activity, manage content restrictions, and more.">
                <langSet xml:lang="en-US"><tig><term>Use the control panel to set daily screen time limits, view app activity, manage content restrictions, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎾᏍᎩ ᎠᎯᎸᏍᏗ ᎠᏯᏔᎾᎸ ᎾᎢ ᏧᎩᏨᏅᏓ ᎦᎧᎲᎢ ᎠᏴᏙᎳᏛ ᎠᏟᏰᎵᏒ ᏓᏎᎸᎯ, ᎯᎪᎵᏯ ᎬᏙᏗ ᎠᎵᏖᎸᎲᏍᎬᎢ, ᎠᏓᏅᏖᎵᏙᎯ  ᎦᎸᏛᎢ ᏗᏓᏲᏍᏓᏁᎯ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep the conversation going">
                <langSet xml:lang="en-US"><tig><term>Keep the conversation going</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏗᎦᏩᎢᏒ ᏗᏟᏃᎮᏗ ᎢᏥᏱᎵᏎᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Please use the following command to get the detailed log:">
                <langSet xml:lang="en-US"><tig><term>Please use the following command to get the detailed log:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎾᏍᎩ ᎬᏙᏗ ᎠᏍᏓᏩᏛᏍᏗ ᎤᏁᏤᎸ ᎾᎢ ᎠᎩᏍᎬ ᎾᏍᎩ ᎠᏎᎸᎩ ᎢᎬᏁᏗ ᏄᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Check the logs for more information.">
                <langSet xml:lang="en-US"><tig><term>Check the logs for more information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎦᏛᎲᎩ ᎾᏍᎩ ᏂᏚᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ ᎾᏍᎩᎾ ᎤᏟ ᎢᎦᎢ ᎧᏃᎮᏢᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable detailed logging">
                <langSet xml:lang="en-US"><tig><term>Enable detailed logging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎠᏎᎸᎩ ᎢᎬᏁᏗ ᏄᏛᏁᎸᏅ ᎧᏃᎮᏠᏍᎩ</term></tig></langSet>
