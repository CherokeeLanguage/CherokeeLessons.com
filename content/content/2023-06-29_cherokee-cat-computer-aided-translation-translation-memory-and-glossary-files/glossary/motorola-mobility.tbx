                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ ᎠᏎᎢ ᎠᏍᏚᏗ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᏌᏊ ᎢᏳᏩᎫᏗ ᎨᏒᎢ ᎠᏙᏯᏅᎯᏗᎠ ᏥᎩ ᎠᏎᎸᎯ ᏂᎯ ᎤᎾᏓᏡᎬ.ᏂᏓᏳᏓᎴᏅᏓ ᎦᏟᏌᏅᎯ ᎬᏗᏍᎬ ᎨᏒᎢ ᎢᏳᏟᎶᏛ ᎬᏗ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ, ᎠᎴ ᏂᏨᏅᎢ ᎠᏫᏗᏍᎩ ᏰᎵᏉ ᎠᏚᏓᎸᏗ ᎤᎬᏩᏟ ᎬᏗᏍᎬ ᏧᏓᎴᎿᎢᎭ, ᎭᏓᏅᏛᎵ ᏕᎦᎧᎲᎢ Ꭰ ᏗᎪᎯᏍᏗᏍᎩ ᎨᏎᏍᏗ ᎠᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use details">
                <langSet xml:lang="en-US"><tig><term>Use details</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏗᏍᎬ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
