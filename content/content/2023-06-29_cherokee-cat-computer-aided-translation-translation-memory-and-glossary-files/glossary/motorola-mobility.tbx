                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᎢ ᎾᎿᎢ  Ꮭ ᏰᎵ ᎠᏎᏒᏗ ᏂᏨᎤᎢ  ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to ">
