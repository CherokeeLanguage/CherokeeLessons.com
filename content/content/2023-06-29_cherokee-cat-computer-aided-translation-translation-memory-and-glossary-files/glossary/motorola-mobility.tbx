            </termEntry>
            <termEntry id="The lock is removed automatically once that the device cost is fully recovered or the imposed term expires.">
                <langSet xml:lang="en-US"><tig><term>The lock is removed automatically once that the device cost is fully recovered or the imposed term expires.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓ ᎠᏍᏚᎭ ᏯᎵᏍᏚᎢ ᎤᏩᏌ Ꮎ ᏥᏂᎬᏅᏗᏓᎾ ᏚᎬᏮᏢᎾ ᏂᎦᏓ ᏯᏩᏛᎢ ᎠᎴ Ꮎ ᏚᏅᏓᏁᏤᎸ ᏳᎵᏍᏆᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Extend RAM &amp; improve performance">
                <langSet xml:lang="en-US"><tig><term>Extend RAM &amp; improve performance</term></tig></langSet>
