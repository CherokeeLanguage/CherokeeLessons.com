                <langSet xml:lang="chr"><tig><term>ᎠᏓᎨᏗᏍᎩ ᏚᎧᏛᎢ ᎨᏍᏗ ᏰᎵ ᏱᎨᎧᏁᏉᏥ ᎠᏚᏓᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically sync work data">
