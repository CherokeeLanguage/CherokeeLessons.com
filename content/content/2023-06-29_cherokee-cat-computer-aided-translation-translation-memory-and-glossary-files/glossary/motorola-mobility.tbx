            <termEntry id="About time to take action (Accessibility timeout)">
                <langSet xml:lang="en-US"><tig><term>About time to take action (Accessibility timeout)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ ᎠᎴᏰᏑ ᎾᎿᎢ ᎠᎩᏍᏗ ᎢᏯᏛᏁᎵᏓᏍᏗ (ᏴᏍᏗ ᎨᏒ ᏙᏖᏙᎵ)</term></tig></langSet>
            </termEntry>
