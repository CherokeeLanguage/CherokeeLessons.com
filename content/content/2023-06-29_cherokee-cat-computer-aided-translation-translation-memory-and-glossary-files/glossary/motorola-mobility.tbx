            <termEntry id="Monitor the number of incorrect passwords typed when unlocking the screen, and lock the phone or erase all this user's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed when unlocking the screen, and lock the phone or erase all this user's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎵᏛᏍᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎾᏍᎩ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᏗᏐᏅᏍᏔᏅᎯ ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏰᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᏍᎩ ᎪᏪᎶᏙᏗᎢ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᎯᎠ ᎬᏗᏍᎩ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏳᏃ ᎤᎪᏗᏗ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᎾᏍᎩ ᏗᏐᏅᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use 2G or 3G only when LTE and Wi-Fi are not available">
                <langSet xml:lang="en-US"><tig><term>Use 2G or 3G only when LTE and Wi-Fi are not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏗᎮᏍᏗ 2Ꮆ ᎠᎴ 3Ꮆ ᎠᏛᏅᎢᏍᏔᏅ ᏂᎨᏒᎾ ᏱᎩ LTE ᎠᎴ Wi-FI</term></tig></langSet>
            </termEntry>
            <termEntry id="Your IT admin may be able to see your data and activity on this device.">
                <langSet xml:lang="en-US"><tig><term>Your IT admin may be able to see your data and activity on this device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ IT ᎤᎾᏓᏡᎦ ᏯᏂᎪᏩᏛ Ꮎ ᎦᏟᏌᏅ ᎠᎴ ᎾᏛᏁᎲ ᏥᏂᎬᏅᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint images and models are stored on the phone until they\u2019re deleted.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint images and models are stored on the phone until they\u2019re deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏚᏓᏴᎳᏛ ᎠᎴ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᎩᎳ ᏂᎯ ᎠᏍᎪᎸᏗᏍᏗ ᎢᏯᏂᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lenovo can provide you with a more personalized experience by identifying you across devices.">
                <langSet xml:lang="en-US"><tig><term>Lenovo can provide you with a more personalized experience by identifying you across devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎴᏃᏉ ᏰᎵᏊ ᏂᎯ ᏱᏣᏓᏁᎳᏍᏏ ᎤᏠᏯᏍᏗ ᎤᏟ ᎢᎦᎢ ᎣᏤᎵᎢ ᎢᎬᏁᎵᏓᏍᏗ ᎠᎦᏙᎲᏒᎢ ᎨᏒᎢ ᎪᏟᏍᏙᏗᏍᎩ ᏂᎯ ᏗᎦᎾᏗᏫᏍᏒᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ. </term></tig></langSet>
