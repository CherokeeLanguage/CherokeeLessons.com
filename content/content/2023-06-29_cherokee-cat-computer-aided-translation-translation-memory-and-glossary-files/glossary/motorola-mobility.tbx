                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏡᎬᎢ ᏗᏁᎵ ᏝᏰᎵ ᎨᏒᎩ ᎤᏟ ᎢᎦᎢ ᎡᏍᎦᏉ </term></tig></langSet>
            </termEntry>
            <termEntry id="Indicates this contact is capable of Advanced Messaging. You are allowed to communicate with such contacts using all features of Advanced Messaging.">
                <langSet xml:lang="en-US"><tig><term>Indicates this contact is capable of Advanced Messaging. You are allowed to communicate with such contacts using all features of Advanced Messaging.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏎᎮᏗ ᎯᎠ ᎠᏟᏃᎮᏙᏗ ᎨᏒᎢ ᏰᎵᏉ ᎢᎬᏁᏗ ᎾᎿᎢ Advanced Messaging. ᏂᎯ ᎨᏒᎢ ᎠᎵᏍᎪᎸᏔᏅ ᎾᎿᎢ ᏗᏓᏛᎪᏙᏗ ᎬᏗ ᎾᏍᎩᏯ ᏗᏟᏃᎮᏙᏗ ᎬᏗᎭ ᏂᎦᏓ ᏗᎦᏎᏍᏙᏗ ᎾᎿᎢ Advanced Messaging.</term></tig></langSet>
            </termEntry>
            <termEntry id=" created group icon">
                <langSet xml:lang="en-US"><tig><term> created group icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎪᏢᏅᎢ ᎤᎾᏓᏡᎬᎢ ᎠᎢᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist two times">
