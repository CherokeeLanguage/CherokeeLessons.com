                <langSet xml:lang="en-US"><tig><term>Discard attachments</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏗᏅᏗ ᏓᏠᏯᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Next &gt;">
                <langSet xml:lang="en-US"><tig><term>Next &gt;</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏐᎢ &gt;</term></tig></langSet>
            </termEntry>
            <termEntry id="Could not find an appropriate application">
                <langSet xml:lang="en-US"><tig><term>Could not find an appropriate application</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎯᏩᏔ Ꭰ ᏚᏳᎪᏛᎢ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="To receive messages, set Messages as the default SMS app">
                <langSet xml:lang="en-US"><tig><term>To receive messages, set Messages as the default SMS app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᏁᏍᏗ ᏗᎦᏃᏣᎳᏅᎯ, ᎤᎾᏓᏡᎬ ᏗᎦᏃᏣᎳᏅᎯ ᎯᎢᎾᎢ ᏥᎩ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ SMS ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Exposure compensation">
                <langSet xml:lang="en-US"><tig><term>Exposure compensation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏠᎯᏍᏔᏅ ᎨᎦᏈᏴᎡᏗᏱ ᎨᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="New MMS message">
                <langSet xml:lang="en-US"><tig><term>New MMS message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏤ MMS ᏗᎦᏃᏣᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't download messages in Airplane mode">
                <langSet xml:lang="en-US"><tig><term>Can't download messages in Airplane mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏗᎦᏃᏣᎳᏅᎯ ᎾᎿ ᏥᏳ ᏄᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Five">
                <langSet xml:lang="en-US"><tig><term>Five</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unarchive">
                <langSet xml:lang="en-US"><tig><term>Unarchive</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This includes files, settings, databases, and other app data.">
                <langSet xml:lang="en-US"><tig><term>This includes files, settings, databases, and other app data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏓᏠᏯᏍᏛ ᏗᏍᏆᏂᎪᏙᏗ, ᏕᎦᎧᎲᎢ, ᏗᎪᎵᏰᏗᎢ, ᎠᎴ ᏐᎢ ᎬᏙᏗ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="MULTIPLE PDN CONNECTIONS FOR A GIVEN APN NOT ALLOWED -55-">
                <langSet xml:lang="en-US"><tig><term>MULTIPLE PDN CONNECTIONS FOR A GIVEN APN NOT ALLOWED -55-</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎪᏗᏗ ᎢᎦᏛᎭ PDN ᏓᎾᎵᎪᏗᏍᎬ ᎤᎬᏩᏟ ᎠᏓᏁᎸ ᎭᏗ ᎠᎵᏍᎪᎸᏔᏅ APN -55-</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows an app to modify the sync settings for an account. For example, this can be used to enable sync of the People app with an account.">
                <langSet xml:lang="en-US"><tig><term>Allows an app to modify the sync settings for an account. For example, this can be used to enable sync of the People app with an account.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎿᎢ ᎤᏃᏢᎯᏐᏗᏱ ᏥᎩ ᎢᏧᎳᎭ ᏕᎦᎧᎲᎢ ᎤᏩᎬᏟ ᎠᏚᏓᎸᏗ. ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᎯᎠ ᏰᎵᎦᏯ ᎬᏔᏅᎯ ᎾᎿᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎢᏧᎳᎭ ᎾᎿ ᏥᎩ People ᎬᏙᏗ ᎬᏗ ᎠᏚᏓᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Never">
                <langSet xml:lang="en-US"><tig><term>Never</term></tig></langSet>
