                <langSet xml:lang="chr"><tig><term>ᎠᏲᏍᏙᏗ ᏗᎾᏓᏃᏣᎳᏁᎯ ᎾᏍᎩᎾ ᎥᎪᏩᏛᏗᏍᎬ ᎥᎿᎢ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Includes high-power background activity">
