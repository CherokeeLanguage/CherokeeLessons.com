                <langSet xml:lang="chr"><tig><term>ᎠᏓᏙᎵᏍᏙᏗ ᎢᏳᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you turn off notification access for , Do Not Disturb access may also be turned off.">
                <langSet xml:lang="en-US"><tig><term>If you turn off notification access for , Do Not Disturb access may also be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏱᏍᏚᎾ ᎠᏓᏃᏣᎳᏁᎯ ᎠᏴᏍᏗ ᎾᏍᎩᎾ, ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎠᏴᏍᏗ ᏰᎵᏉ ᎾᏍᎩᏊ ᎨᏒ ᎠᏍᏚᏗ.</term></tig></langSet>
