            <termEntry id="Open the camera anytime">
                <langSet xml:lang="en-US"><tig><term>Open the camera anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again later.">
                <langSet xml:lang="en-US"><tig><term>Please try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This download will continue if you go back or close this window.">
                <langSet xml:lang="en-US"><tig><term>This download will continue if you go back or close this window.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏎ ᎠᎯᎸᏍᏗ ᎾᎿ ᏂᎯ ᎮᎾ ᎠᏨᏍᏗ ᎠᎴ ᎠᏍᏚᏗ ᎯᎠ ᏦᎳᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The update will be installed on the next step.">
                <langSet xml:lang="en-US"><tig><term>The update will be installed on the next step.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᎦᏘᏅᏔᏅ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎠᎳᏏᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="An error has occurred on the Server.">
                <langSet xml:lang="en-US"><tig><term>An error has occurred on the Server.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏓᏓᎴᎬᎢ ᏂᏚᏩᎿ ᏄᎵᏍᏔᏅᎩ ᎤᎿᎢ ᏥᎩ ᎠᏯᏙᎯᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Voicemail number">
                <langSet xml:lang="en-US"><tig><term>Voicemail number</term></tig></langSet>
