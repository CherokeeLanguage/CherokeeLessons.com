                <langSet xml:lang="en-US"><tig><term>Type your current full backup password here</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᏂᏨᏅᎢ ᏃᏊ ᏥᎩ ᎧᎵ ᎤᏠᏱ ᎪᏢᏅᏗ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎠᎭᏂ</term></tig></langSet>
            </termEntry>
