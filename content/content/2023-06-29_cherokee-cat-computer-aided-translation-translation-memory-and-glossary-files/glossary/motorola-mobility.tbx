                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᎬᏁᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe back and forth on the screen to see 2 apps at once">
                <langSet xml:lang="en-US"><tig><term>Swipe back and forth on the screen to see 2 apps at once</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ ᎠᎴ ᎦᏌᏙᏯᏍᏗ ᎯᏅᎦᎵᏓ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎯᎪᏩᏔ 2 ᏗᎬᏙᏗ ᎡᏧᎳᎭᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make it easy on yourself">
