            </termEntry>
            <termEntry id="To allow this service to access your device location, enable location permission at the Allow all the time level.">
                <langSet xml:lang="en-US"><tig><term>To allow this service to access your device location, enable location permission at the Allow all the time level.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎢᏯᏓᏛᏁᏗ ᎾᎢ ᎠᏴᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏙᏢᏒᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎦᏓ ᎾᏍᎩ ᎠᏥᎢᎵᏒᎢ ᎠᏟᎶᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Wonderful Wizard of Oz">
                <langSet xml:lang="en-US"><tig><term>The Wonderful Wizard of Oz</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎤᎵᎮᎵᏍᏓ ᎠᏓᏪᎯ ᎥᎿᎢ ᎠᏏ</term></tig></langSet>
            </termEntry>
            <termEntry id="Both Wi\u2011Fi and Bluetooth scanning are off">
                <langSet xml:lang="en-US"><tig><term>Both Wi\u2011Fi and Bluetooth scanning are off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᏃ ᏫᎢ\u2011ᏈᎢ ᎠᎴ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎠᎾᎦᎵᏍᎩ ᎬᏗ ᏗᏟᎶᏍᏗᏍᎩ ᎨᏒᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Modern">
