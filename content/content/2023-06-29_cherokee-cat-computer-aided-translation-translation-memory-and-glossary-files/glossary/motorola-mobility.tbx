            </termEntry>
            <termEntry id="Wizard can't proceed due to an internal error.">
                <langSet xml:lang="en-US"><tig><term>Wizard can't proceed due to an internal error.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wizard ᎨᏍᏗ ᏰᎵ ᎠᎯᎸᏍᏗ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᎭᏫᏂ ᏓᏓᎴᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Default Data SIM Assistant">
                <langSet xml:lang="en-US"><tig><term>Default Data SIM Assistant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ SIM ᎠᎵᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Default data SIM">
                <langSet xml:lang="en-US"><tig><term>Default data SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Select below how you would like to assign contacts to one SIM or another:">
                <langSet xml:lang="en-US"><tig><term>Select below how you would like to assign contacts to one SIM or another:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎡᎳᏗᏨ ᏙᎡᎵ ᏂᎯ ᏯᏓᎯᏗᏏ ᎯᎸᏉᏗ ᎾᎿᎢ ᎠᏯᏙᎮᎸ ᏗᏟᏃᎮᏙᏗ ᎾᎿᎢ ᏌᏇ SIM ᏃᎴ ᏄᏓᎴ:</term></tig></langSet>
            </termEntry>
            <termEntry id="If this is your phone, tap the pencil icon to add information that will be displayed here in case of emergency">
                <langSet xml:lang="en-US"><tig><term>If this is your phone, tap the pencil icon to add information that will be displayed here in case of emergency</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎯᎠ ᏗᏟᏃᎮᏗ ᏣᏤᎵᎢ ᏱᎩ, ᎤᎵᏍᏓ ᎭᏐᏅᏍᏓ ᏗᎪᏪᎶᏗ ᎠᎢᎧᏂ ᎾᎿᎢ ᏗᎧᏁᏉᏍᏗ ᎧᏃᎮᎸᏗ ᎥᏍᎩᎾ ᎠᏎ ᎨᎡᎢ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎭᏂ ᎾᎿ ᏗᎪᏪᎵ ᎾᎿ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wizard can't proceed because device without 2 SIM's.">
                <langSet xml:lang="en-US"><tig><term>Wizard can't proceed because device without 2 SIM's.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wizard ᎨᏍᏗ ᏰᎵ ᎠᎯᎸᏍᏗ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ 2 SIM's.</term></tig></langSet>
            </termEntry>
            <termEntry id="One of your SIM cards can't support video calls">
