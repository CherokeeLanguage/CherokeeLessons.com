            <termEntry id="Phone has typical background battery usage">
                <langSet xml:lang="en-US"><tig><term>Phone has typical background battery usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎳᏃᎮᏗ ᏂᏚᏩᎿ ᎤᏠᏱᏊ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬ</term></tig></langSet>
