            <termEntry id="Error code: 8X">
                <langSet xml:lang="en-US"><tig><term>Error code: 8X</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 8X</term></tig></langSet>
            </termEntry>
            <termEntry id="Using Slow Motion at 120 or 240fps lets you focus on people and objects moving quickly, like athletes in play, a running dog, or moving water.">
                <langSet xml:lang="en-US"><tig><term>Using Slow Motion at 120 or 240fps lets you focus on people and objects moving quickly, like athletes in play, a running dog, or moving water.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎬ ᎤᏍᎦᏃᎳ ᎠᏓᏅᏏᏙᎭ ᎥᎿᎢ 120 ᎠᎴᏃ 240fps ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᎤᎿᏊ ᎢᎦ ᏫᏔᎧᏅᎦ ᎤᎾ ᎠᏂᏴᏫ ᎠᎴ ᏧᏓᎴᏅᏓ ᎠᎲᏍᎦ ᏄᏟᏍᏛ, ᎢᏳᏍᏗ ᏗᎾᏁᎶᎲᏍᎩ ᎾᎿᎢ ᏗᏁᎸᏙᏗ, ᎾᏍᎩ ᏓᎾᏟᏓᏍᏗ ᎩᏟ, ᎠᎴᏃ ᎠᏂᎩᏍᎬ ᎠᎹ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Vocalizer">
                <langSet xml:lang="en-US"><tig><term>Vocalizer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏨᎢ ᎤᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="No contacts with phone numbers">
                <langSet xml:lang="en-US"><tig><term>No contacts with phone numbers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏗᏟᏃᎮᏙᏗ ᎬᏗ ᏗᏟᏃᎮᏗ ᏗᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="That's too fast.">
                <langSet xml:lang="en-US"><tig><term>That's too fast.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᎾᎢᏃ ᎦᏯᏅᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off Mobile Data?">
                <langSet xml:lang="en-US"><tig><term>Turn off Mobile Data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Add &quot;&quot; to contacts?">
                <langSet xml:lang="en-US"><tig><term>Add "" to contacts?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏗ "" ᎾᎿᎢ ᏗᏟᏃᎮᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Please slow down.">
                <langSet xml:lang="en-US"><tig><term>Please slow down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎤᏍᎦᏃᎳ ᎾᏛᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="ISO selector">
                <langSet xml:lang="en-US"><tig><term>ISO selector</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ISO ᏗᏑᏰᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="360fps">
                <langSet xml:lang="en-US"><tig><term>360fps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>360fps</term></tig></langSet>
            </termEntry>
            <termEntry id="You can move your photos, files, and some apps to this new ^1. The move takes about ^2 and will free ^3 on internal storage. Some apps won\u2019t work while it\u2019s underway.">
                <langSet xml:lang="en-US"><tig><term>You can move your photos, files, and some apps to this new ^1. The move takes about ^2 and will free ^3 on internal storage. Some apps won\u2019t work while it\u2019s underway.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ, ᏗᏍᏆᏂᎪᏙᏗ, ᏃᎴ ᎢᎦᏓ ᏗᎬᏙᏗ ᎾᎿᎢ ᎯᎠ ᏗᏤ ^1. ᏥᎩ ᎠᎲᏍᏗ ᎠᎩᏍᎪᎢ ᎢᎸᏨ ^2 ᏃᎴ ᎠᏎ ᏗᏣᏲᎯᏍᏗ ^3 ᎤᎿᎢ ᎭᏫᏂ ᎠᏍᏆᏂᎪᏙᏗ. ᎢᎦᏓ ᏗᎬᏙᏗ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎯᏳᎢ ᎨᎡᎢ ᎤᏓᏄᏴᏛᎢ ᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete document?">
                <langSet xml:lang="en-US"><tig><term>Delete document?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏛᎯ ᎪᏪᎳᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data. Encryption takes an hour or more, during which the tablet will restart several times.">
                <langSet xml:lang="en-US"><tig><term>The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data. Encryption takes an hour or more, during which the tablet will restart several times.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏕᎵᏍᏙᏗ ᎠᎢᏒᎢ ᏄᏍᏛ ᎪᎯᏓ ᏗᎨᏛᏍᎩ ᏃᎴ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎦᏘᏍᎩᏌᏅᎯ. ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᏃᎴ ᎤᎪᏗᏊ, ᎾᎯᏳ ᎦᏙᎤᏍᏗ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎢᎸᏍᎩ ᎢᏳᏩᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can take higher quality selfies with the flip closed">
                <langSet xml:lang="en-US"><tig><term>You can take higher quality selfies with the flip closed</term></tig></langSet>
