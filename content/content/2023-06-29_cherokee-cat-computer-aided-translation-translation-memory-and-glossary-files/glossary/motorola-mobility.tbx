            <termEntry id="You can change this later in Bluetooth settings.">
                <langSet xml:lang="en-US"><tig><term>You can change this later in Bluetooth settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎦᏁᏟᏴᏍᏗ ᎯᎠ ᎪᎯᏴᎢ ᎾᎿ Bluetooth ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read data about your contacts stored on your phone.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read data about your contacts stored on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎠᎪᎵᏰᏗ ᎦᏟᏌᏅᎯ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You won\u2019t be able to prevent others from using this phone if it\u2019s lost or stolen.">
                <langSet xml:lang="en-US"><tig><term>You won\u2019t be able to prevent others from using this phone if it\u2019s lost or stolen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏂᎨᏒᎾ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᏲᏍᏙᏗᏍᎩ ᏐᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎯᎠ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᎠᎴ ᎦᏃᏍᎩᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Skip anyway">
                <langSet xml:lang="en-US"><tig><term>Skip anyway</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎾᏫᏓ ᎾᏂᎥᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.">
                <langSet xml:lang="en-US"><tig><term>This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎵᏍᎪᎸᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎠᎳᏏᏅᏗᏍᎪ ᏣᏤᎵ ᎠᏟᏃᎮᏙᏗ ᎦᏟᏌᏅᎯ, ᎠᎴ ᎤᏁᎫᏥᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎠᏯᏙᎯᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏟᏌᏅᎯ ᎾᏍᎩ ᏂᏣᏅᏛᎾᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera access is required for screen attention. Tap to manage permissions for Device Personalization Services">
                <langSet xml:lang="en-US"><tig><term>Camera access is required for screen attention. Tap to manage permissions for Device Personalization Services</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏴᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎤᎬᏩᏟ ᎠᏴᏙᎳᏛᎢ ᎭᎧᏎᏍᏓ ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᎬᏩᏟ ᏥᏂᎬᏅᏗᏓᎾ ᎮᎵᏒᏊ ᏅᎦ ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Transfer files from ">
                <langSet xml:lang="en-US"><tig><term>Transfer files from </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᎬᎢ ᏗᏍᏆᏂᎪᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ </term></tig></langSet>
            </termEntry>
            <termEntry id="PC">
                <langSet xml:lang="en-US"><tig><term>PC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PC</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile networks">
                <langSet xml:lang="en-US"><tig><term>Mobile networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᏚᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can read all SMS (text) messages stored on your phone.">
                <langSet xml:lang="en-US"><tig><term>This app can read all SMS (text) messages stored on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎠᎪᎵᏰᏗ ᏂᎦᏓ SMS (ᎠᎪᎵᏰᏗ) ᎨᏥᏃᎯᏎᏗ ᎠᏍᏆᏂᎪᏗ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="{count, plural, =0 {None} =1 {1 conversation} other {# conversations} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, =0 {None} =1 {1 conversation} other {# conversations} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, =0 {ᎧᏂᎩᏓ} =1 {1 ᎠᎾᏟᏃᎮᏍᎬ} other {# ᏓᎾᏟᏃᎮᏍᎬᎢ} }</term></tig></langSet>
            </termEntry>
