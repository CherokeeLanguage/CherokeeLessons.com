                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᎠ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏐᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏟᎵᏒᎢ ᎾᎿᎢ ᎠᏟᎵᏒᎢ ᏰᎵᏯ ᏣᎮᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏄᎾᏰᎯᏍᏛᎾᏊ ᎠᎴ ᏦᎦᏤᎳᏍᏙᏗ ᎨᎡᎢ ᎾᎾᏛᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Immerse yourself in sound">
                <langSet xml:lang="en-US"><tig><term>Immerse yourself in sound</term></tig></langSet>
