            </termEntry>
            <termEntry id="When you turn them on, all future security updates and bug fixes will automatically download when they're available.">
                <langSet xml:lang="en-US"><tig><term>When you turn them on, all future security updates and bug fixes will automatically download when they're available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏚ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After an update is downloaded, your device will restart at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>After an update is downloaded, your device will restart at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ Ꭰ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ ᏥᎩ ᎠᏟᎵᏒᎢ ᏂᎯ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Go to Photos">
                <langSet xml:lang="en-US"><tig><term>Go to Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏅᏍᏗ ᎾᎢ ᏓᏓᏥᎶᏍᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Finding your favorites">
                <langSet xml:lang="en-US"><tig><term>Finding your favorites</term></tig></langSet>
