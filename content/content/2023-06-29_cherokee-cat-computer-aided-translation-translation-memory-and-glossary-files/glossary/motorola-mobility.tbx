                <langSet xml:lang="chr"><tig><term>256 kbps</term></tig></langSet>
            </termEntry>
            <termEntry id="+">
                <langSet xml:lang="en-US"><tig><term>+</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>+</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For Mobile Desktop lets you connect your phone to a PC for a immersive desktop experience.">
                <langSet xml:lang="en-US"><tig><term>Ready For Mobile Desktop lets you connect your phone to a PC for a immersive desktop experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᎦᏍᎩᎶᎩ ᎦᏚ ᏗᏣᎵᏍᎪᎸᏓᏁᎯ ᎫᏓᎸᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎾᎢ ᎤᏩᏌ ᎣᏤᎵ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎾᏍᎩᎾ ᎤᏠᏯᏍᏗ ᎦᏍᎩᎶᎩ ᎦᏚ ᎠᎦᏙᎲᏒᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For makes it easy to find your favorite content.">
                <langSet xml:lang="en-US"><tig><term>Ready For makes it easy to find your favorite content.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᏍᏙᏗ ᎤᎬᏩᏟ ᎠᎯᏗᎨ ᏂᎬᏁᎲ ᏣᏩᏔᏗᎢ ᏗᏣᎸᏉᏛᎢ ᏄᏍᏗᏓᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" y">
                <langSet xml:lang="en-US"><tig><term> y</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> y</term></tig></langSet>
            </termEntry>
            <termEntry id="Go to the Experience Hub to easily switch between TV, Game, Video Chat, and Mobile Desktop.">
                <langSet xml:lang="en-US"><tig><term>Go to the Experience Hub to easily switch between TV, Game, Video Chat, and Mobile Desktop.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏁᏟᏴᏍᏗ ᎠᏂᎩᏍᎩ ᎦᏍᎩᎶᎩ ᎦᏚ, ᎠᏛᏰᎸᏛᏍᎩ, ᏗᏁᎸᏙᏗ, ᎠᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎦᏬᏂᎯᏍᏗ ᎭᏐᏅᏍᏓ ᎠᎦᏙᎲᏒ ᎠᏐᎥᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please disable Airplane Mode first.">
                <langSet xml:lang="en-US"><tig><term>Please disable Airplane Mode first.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᎴᏫᏍᏙᏓ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ ᎢᎬᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please log out on the previous device before switching to a new device">
                <langSet xml:lang="en-US"><tig><term>Please log out on the previous device before switching to a new device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᏅᎪᎢ ᎤᎾᎢ ᎾᏍᎩ ᏧᏩᎫᏔᏅ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏓᎷᎸ ᎦᏁᏟᏴᏍᎩ ᎾᎢ ᎢᏤ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Registered successfully.">
