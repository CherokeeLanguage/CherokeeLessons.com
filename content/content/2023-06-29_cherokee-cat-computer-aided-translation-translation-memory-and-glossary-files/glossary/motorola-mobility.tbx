                <langSet xml:lang="en-US"><tig><term>Your device is configured for the data connection with </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏒᎢ ᎢᏳᎵᏍᏙᏗ ᎢᎬᏁᎸ ᎤᎬᏩᏟ Ꮎ ᎦᏘᏍᎩᏌᏅᎯ ᏗᎵᎪᏔᏅᎯ ᎬᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Here's your photo enhanced for low light">
