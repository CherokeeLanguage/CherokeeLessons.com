                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎧᏁᏉᏓ ᎤᎦᏎᏍᏗ, ᎦᎧᎲᎢ PIN ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Type the pairing code then press Return or Enter">
                <langSet xml:lang="en-US"><tig><term>Type the pairing code then press Return or Enter</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᏥᎩ ᏗᎵᎪᏙᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ ᎿᏉᏃ ᎭᏐᎥᏍᏓ ᎠᏨᏗ or ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
