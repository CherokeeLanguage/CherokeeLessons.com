            </termEntry>
            <termEntry id="You can manage the app tray and permissions in External display settings.">
                <langSet xml:lang="en-US"><tig><term>You can manage the app tray and permissions in External display settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵ ᎠᏓᏅᏖᎵᏓᏍᏗ app ᏗᏓᎵᏍᎪᎸᏓᏁᎯ in ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Adaptive brightness">
                <langSet xml:lang="en-US"><tig><term>Adaptive brightness</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᎤᏍᎪᏍᏗᏴ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick settings editor">
                <langSet xml:lang="en-US"><tig><term>Quick settings editor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ ᎣᏍᏓ ᏗᎦᎧᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn this feature on in Camera settings.">
                <langSet xml:lang="en-US"><tig><term>You can turn this feature on in Camera settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵ ᏍᏚᎢᏍᏗ ᎯᎠ ᏄᏍᏛ ᏗᎧᏃᏗ  ᎥᎾᎢ ᏗᏓᏟᎶᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Capture the sound">
                <langSet xml:lang="en-US"><tig><term>Capture the sound</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏗ Ꮎ ᎤᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the Action Cam to record landscape videos in the portrait position.">
                <langSet xml:lang="en-US"><tig><term>Use the Action Cam to record landscape videos in the portrait position.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏗᏍᎬ Ꮎ ᎾᏛᏁᎲ ᎦᏂᏱᏍᎬ ᎦᏂᏱᏍᎬ ᎦᏅᎯᏒᎢ ᏗᏓᏴᎳᏛᏍᎩ ᎥᎾᎢ ᎠᏰᎵ ᎠᎪᎶᏛᏙᏗ ᎦᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the “Nearby” button underneath the Share Wi-Fi QR code to send your signal to other devices.">
                <langSet xml:lang="en-US"><tig><term>Tap the “Nearby” button underneath the Share Wi-Fi QR code to send your signal to other devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ Ꮎ "ᎭᏫᏂ" ᎠᏐᏅᏍᏙᏗ ᎡᎳᏗᏓ Ꮎ ᎠᏯᏙᏍᏗᎢ Wi-Fi QR ᎠᏍᏓᏩᏛᏍᏙᏗ ᏫᎦᏅᏗ ᏂᏣᏤᎵ ᏎᎮᎲᎢ Ꮎ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can manage how and when they appear in Edge lights settings.">
                <langSet xml:lang="en-US"><tig><term>You can manage how and when they appear in Edge lights settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏗᏧᎪᏔᏂᏓᏍᏗ ᎢᏳᎵᏍᏙᏗ ᎠᎴ ᎯᎳᎢᏴ ᎬᏂᎨᏒ ᏂᎦᏍᏗᎠᎬ ᎾᎢ ᎠᏍᏛᎢ ᏗᏧᏍᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smile to capture">
                <langSet xml:lang="en-US"><tig><term>Smile to capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏤᏍᏙᏗ ᎦᏂᏴᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stay in touch">
                <langSet xml:lang="en-US"><tig><term>Stay in touch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏓᏓᏛᏔᏍᏗᏍᎨᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen brightness adjusts to environment">
                <langSet xml:lang="en-US"><tig><term>Screen brightness adjusts to environment</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᎤᏍᎪᏍᏗᏴ ᎠᏓᏁᏟᏴᏍᎩ ᎾᎿᎢ ᎡᎶᎯ ᏄᏍᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Preferred brightness is high">
                <langSet xml:lang="en-US"><tig><term>Preferred brightness is high</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎠᏰᎸᏅ ᎤᏍᎪᏍᏗᏴ ᎨᎡᎢ ᎦᎸᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When this feature is on, you can still adjust brightness temporarily.">
                <langSet xml:lang="en-US"><tig><term>When this feature is on, you can still adjust brightness temporarily.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᎨᎡᎢ ᎤᎿᎢ, ᏂᎯ ᏰᎵᏯ ᎠᏏᏉ ᎠᏓᏁᏟᏴᏍᎩ ᎤᏍᎪᏍᏗᏴ ᏞᎦᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Attendees">
                <langSet xml:lang="en-US"><tig><term>Attendees</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sharing Wi-Fi is easier than ever.">
                <langSet xml:lang="en-US"><tig><term>Sharing Wi-Fi is easier than ever.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏙᎯᏍᏗᏍᎬ Wi-Fi ᎠᎯᎢᏗᏯ ᏏᏅ ᎢᏳᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect to a display for immersive entertainment and video chats, as well as a powerful desktop experience.">
                <langSet xml:lang="en-US"><tig><term>Connect to a display for immersive entertainment and video chats, as well as a powerful desktop experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᏙᎩ ᎥᎾᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏄᏰᎸᏛ ᎦᏃᏴᏘᏍᏦᏗ ᎤᎾᏛᏁᎸᏗ ᎠᎴ ᎠᏓᏴᎳᏛᏍᎩ  ᏗᏂᏬᏂᏍᎩ,  ᎾᏍᎩᏯᏊᏃ ᎤᎳᏂᎩᏛ  ᎠᏓᏁᏟᏴᏍᏗᏍᎩ  ᎠᏓᏴᎳᏛᏍᎩ ᏄᎵᏍᏔᏂᏙᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch to unlock lets you unlock your device anytime just by touching the fingerprint sensor.">
                <langSet xml:lang="en-US"><tig><term>Touch to unlock lets you unlock your device anytime just by touching the fingerprint sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᎾᏍᏗ ᎠᏍᏚᎢᏍᏗ ᎤᎵᏍᎪᎸᏓᏁᏍᎬ ᏂᎯ ᎠᏍᏚᎢᏍᎬ ᏂᏣᏤᎵ ᏥᏂᎡᏅᏗᏓᎾ ᏂᎦᎵᏍᏗᏴᏊ ᎾᏊ  ᎾᎢ ᎥᏒᏂᎲ Ꮎ ᎥᎦᏰᏌᏛᎢᏅ ᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Preferred brightness is low">
                <langSet xml:lang="en-US"><tig><term>Preferred brightness is low</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎠᏰᎸᏅ ᎤᏍᎪᏍᏗᏴ ᎨᎡᎢ ᎡᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Scan captured without adjustments">
                <langSet xml:lang="en-US"><tig><term>Scan captured without adjustments</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᎦᏂᏴᎲᎩ ᏄᏠᏯᏍᏛᎾ ᎣᏍᏛ ᏂᏗᎬᏁᎸᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can talk to LeVoice anytime, even when the flip is closed.">
                <langSet xml:lang="en-US"><tig><term>You can talk to LeVoice anytime, even when the flip is closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤ cᎠn Ꮤlk tᎣ tᎮ ᎪᎣgᎴ ᎠᏍᏏᏍᏔnt ᎠnyᏘᎺ, ᎡᎥᎡn wᎮn tᎮ fᎵp ᎢᏍ cᎶᏎd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Very low">
                <langSet xml:lang="en-US"><tig><term>Very low</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏃ ᎡᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Very high">
                <langSet xml:lang="en-US"><tig><term>Very high</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏃ ᎦᎸᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Power &amp; Emergency Menu:Press Power and Volume up at the same time.">
                <langSet xml:lang="en-US"><tig><term>Power &amp; Emergency Menu:Press Power and Volume up at the same time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏆᏂᏲᏍᏗ &amp; ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎪᏪᎳᎾᎥᎢ:ᎭᏐᏅᏍᏓ ᏗᏆᏂᏲᏍᏗ ᏃᎴ ᏂᎦᎥ ᎤᏜᏅᏛᎢ ᎦᎸᎳᏗ ᎤᎿᎢ ᏥᎩ ᎤᏠᏱ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your preferred brightness level">
                <langSet xml:lang="en-US"><tig><term>Your preferred brightness level</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎤᏟ ᎠᏰᎸᏅ ᎤᏍᎪᏍᏗᏴ ᎤᏩᎾᏕᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Just long press on the power key to make calls, get the weather, and more.">
                <langSet xml:lang="en-US"><tig><term>Just long press on the power key to make calls, get the weather, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>JᎤᏍt ᏙᎤbᎴ Ꮤp Ꭳn tᎮ pᎣᏪr kᎡy Ꭳr Ꮜy “Ꭾy ᎪᎣgᎴ” tᎣ ᎹkᎡ cᎠllᏍ, Ꭸt tᎮ ᏪᎠtᎮr, Ꭰnd ᎼrᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Subject tracking on your phone’s camera keeps everyone in the field of view for more natural conversation.">
                <langSet xml:lang="en-US"><tig><term>Subject tracking on your phone’s camera keeps everyone in the field of view for more natural conversation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᎧᏃᎮᏗ ᎥᎪᎷᏁᎬ ᎥᎾ ᏂᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏂᎬᏅ ᏗᏓᏟᎶᏍᏗᏍᎩ ᏂᎦᏓ ᎤᏂᎮᏍᏗ ᎥᎾᎢ  ᏄᏍᏗᏓᏅ ᏗᎧᏃᏗᏗ ᏄᏰᎸᏛ ᎤᎪᏛ ᏂᎬᏩᏍᏛ ᏓᎾᎵᏃᎮᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tired of your photos turning out too dark?">
                <langSet xml:lang="en-US"><tig><term>Tired of your photos turning out too dark?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏣᏯᏫᎦ ᏗᏣᏤᎵ ᏗᏓᏟᎶᏍᏔᏅ ᎤᎶᏒᏔᏅ ᎫᎳᏏᎩ ᏂᏕᎦᎵᏍᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Preferred brightness is very high">
                <langSet xml:lang="en-US"><tig><term>Preferred brightness is very high</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎠᏰᎸᏅ ᎤᏍᎪᏍᏗᏴ ᎨᎡᎢ ᎤᏟᏃ ᎦᎸᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="With Night Vision, you can capture detailed photos in any low light condition.">
                <langSet xml:lang="en-US"><tig><term>With Night Vision, you can capture detailed photos in any low light condition.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗ ᏒᏃᏱ ᎠᎪᏩᏛᏗᎢ, ᏰᎵᏊ ᏂᎯ ᏱᏂᏯ ᎤᏎᎸᎩ ᎢᎬᏁᏗ ᏗᏓᏟᎶᏍᏔᏅᎢ ᎾᎿᎢ ᏂᎦᎵᏍᏗᏍᎬᎫ ᎡᎳᏗ ᎠᏨᏍᏛ ᏄᏍᏗᏓᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When the external display is locked, you can control the media player, read notifications, and send quick replies.">
                <langSet xml:lang="en-US"><tig><term>When the external display is locked, you can control the media player, read notifications, and send quick replies.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ Ꮎ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ  ᏯᏍᏚᎭ, ᏂᎯ ᏰᎵᏊ ᏱᎭᎷᎩ Ꮎ ᏗᎦᏃᎩᏍᏙᏗ, ᏣᎪᎵᏰᏗ ᏗᎾᏓᏣᎳᏁᎯ, ᎠᎴ ᏫᎦᏅᏗ ᎤᏟᏍᏓ ᏗᎦᏬᎯᎵᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for a data connection to resume background download and installation…">
                <langSet xml:lang="en-US"><tig><term>Waiting for a data connection to resume background download and installation…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏯ ᎤᎬᏩᏟ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎾᎿᎢ ᎠᎴᏂᏐᏗᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏃᎴ ᎦᏘᏅᏛᏍᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM PIN changed successfully">
                <langSet xml:lang="en-US"><tig><term>SIM PIN changed successfully</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM PIN ᎦᏁᏟᏴᏓ ᏄᏓᏄᎸᏅᎾᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Multiple SIMs found">
                <langSet xml:lang="en-US"><tig><term>Multiple SIMs found</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏍᎩ SIMs ᎠᏩᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn this feature off if you prefer to unlock by pressing down on the power key.">
                <langSet xml:lang="en-US"><tig><term>You can turn this feature off if you prefer to unlock by pressing down on the power key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ  ᏱᏍᏚᎲᎦ ᎢᏳᏃ ᎤᏟᎨᏣᏰᎸᏗ ᏍᏚᎢᏍᏗ ᎢᎬᏗ  ᎡᎳᏗ ᎥᏐᎥᏍᏗᏍᎬ ᎥᎿᎢ ᏄᏟᏂᎬᎬ ᎠᏍᏚᎢᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Watch from anywhere">
                <langSet xml:lang="en-US"><tig><term>Watch from anywhere</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏙᏍᏙᏗ ᎾᏍᎩᎾ ᏂᎬᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enjoy clearer calls">
                <langSet xml:lang="en-US"><tig><term>Enjoy clearer calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᎮᎵᏍᏗ ᎠᏰᎸᏗ ᏗᎪᏍᏔᏅ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Equipment ID">
                <langSet xml:lang="en-US"><tig><term>Equipment ID</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ID</term></tig></langSet>
            </termEntry>
            <termEntry id="Your screen brightness will automatically adjust to your environment and activities.">
                <langSet xml:lang="en-US"><tig><term>Your screen brightness will automatically adjust to your environment and activities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᎤᏍᎪᏍᏗᏴ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎾᎿᎢ ᏂᏨᎤᎢ ᎡᎶᎯ ᏄᏍᏗᏓᏅ ᎠᎴ ᏄᎾᏛᏁᎸᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To change the wallpaper, long press on the internal display home screen and tap on “External Wallpapers”.">
                <langSet xml:lang="en-US"><tig><term>To change the wallpaper, long press on the internal display home screen and tap on “External Wallpapers”.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ Ꮎ ᎣᎾᏗᏢ ᎤᏓᏴᎳᏛ,  ᎪᎯᏓ ᎠᏐᏅᏍᏙᏗ ᎥᎿᎢ ᎭᏫᏂ ᎠᏓᏴᎳᏛᏍᎩ ᏄᎬᏫᏳᏒ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴ ᎤᎵᏍᏓ ᎠᏒᏂᎸ ᎥᎿ  ᏙᏱᏗᏢ ᎣᎾᏗᏢ ᏚᏓᏴᎳᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use one of your photos as a wallpaper, open the photo &gt; tap on the three buttons in the upper right corner &gt; tap on “Use as” &gt; choose “External Wallpapers”.">
                <langSet xml:lang="en-US"><tig><term>To use one of your photos as a wallpaper, open the photo &gt; tap on the three buttons in the upper right corner &gt; tap on “Use as” &gt; choose “External Wallpapers”.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏙᏗ ᏌᏊ ᏂᏣᏤᎵ ᏗᏟᎶᏍᏔᏅᎯ ᎥᎩ ᎣᎾᏗᏢ ᎤᏓᏴᎳᏛ, ᎠᏍᏚᎢᏍᏗ Ꮎ ᏗᏟᎶᏍᏔᏅ&gt;</term></tig></langSet>
            </termEntry>
            <termEntry id="Three finger screenshot makes it easier to capture what you see on your screen.">
                <langSet xml:lang="en-US"><tig><term>Three finger screenshot makes it easier to capture what you see on your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎢ ᎦᏰᏌᏛ ᎠᏓᏴᎳᏛᏍᎩ ᏗᏟᎶᏍᏔᏅᎢ ᏂᎬᏂᏏᎠ ᎠᎯᏗᎨᎢ ᎦᏂᏴᏗᎢ ᎢᏳᏍᏗ ᎯᎪᏩᏘᏍᎬ ᏂᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Display white balance">
                <langSet xml:lang="en-US"><tig><term>Display white balance</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏔᏍᎩ ᎠᏂᏲᏁᎦ ᎢᏗᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smooth Display">
                <langSet xml:lang="en-US"><tig><term>Smooth Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏫᏍᎦᎨ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can move the slider manually to help adaptive brightness learn your preferences.">
                <langSet xml:lang="en-US"><tig><term>You can move the slider manually to help adaptive brightness learn your preferences.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎲᏍᏗ ᏥᎩ ᏗᎲᏍᎩ ᎣᏩᏌ ᏱᎬᏁᏗ ᎾᎿᎢ ᎠᎵᏍᏕᎸᏓ ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᎤᏍᎪᏍᏗᏴ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᎤᏟᎠᏰᎸᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Media Switch">
                <langSet xml:lang="en-US"><tig><term>Media Switch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏍᎩ ᎦᏁᏟᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Increases battery usage.">
                <langSet xml:lang="en-US"><tig><term>Increases battery usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᎥᎯ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Force peak refresh rate">
                <langSet xml:lang="en-US"><tig><term>Force peak refresh rate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏌᏙᏯᏍᏗ ᏫᎪᏍᏓᏴ ᎯᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically raises the refresh rate from 60 to 90 Hz for some content.">
                <langSet xml:lang="en-US"><tig><term>Automatically raises the refresh rate from 60 to 90 Hz for some content.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎤᎪᏙᎯᏍᏗᏱ ᏥᎩ ᎯᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ ᏅᏓᏳᏓᎴᏅᎯ 60 ᎾᎿᎢ 90 Hz ᎤᎬᏩᏟ ᎢᎦᏓ ᏄᏍᏗᏓᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Highest refresh rate for improved touch responsiveness &amp; animation quality.">
                <langSet xml:lang="en-US"><tig><term>Highest refresh rate for improved touch responsiveness &amp; animation quality.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎪᏗᏗ ᎯᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ ᎤᎬᏩᏟ ᎪᏢᎯᏌᏅ ᎠᏒᏂᏍᏗ ᏛᏓᏓᏂᎸᎬ &amp; ᎠᏓᏅᏏᏙᎯ ᎢᏲᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Increases battery usage.">
                <langSet xml:lang="en-US"><tig><term>Increases battery usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᎥᎯ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb was automatically turned on by a schedule ()">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb was automatically turned on by a schedule ()</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎨᏍᏒ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᏍᏚᎢᏓ ᎨᏒᎢ ᎾᏍᎩ ᏓᏒᏍᏛ ()</term></tig></langSet>
            </termEntry>
            <termEntry id="Increases battery usage.">
                <langSet xml:lang="en-US"><tig><term>Increases battery usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᎪᎢ ᎠᎾᎦᎵᏍᎩ ᎥᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Share your phone with a connected display">
                <langSet xml:lang="en-US"><tig><term>Share your phone with a connected display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᎯᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎵᏗ ᎤᏠᏯᏍᏕᏍᏗ ᎫᏓᎸᏅᎯ ᎬᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch Output">
                <langSet xml:lang="en-US"><tig><term>Switch Output</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎤᏅᎪᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Just double tap on the power key or say “Hey Google” to make calls, get the weather, and more.">
                <langSet xml:lang="en-US"><tig><term>Just double tap on the power key or say “Hey Google” to make calls, get the weather, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>JᎤᏍt ᏙᎤbᎴ Ꮤp Ꭳn tᎮ pᎣᏪr kᎡy Ꭳr Ꮜy “Ꭾy ᎪᎣgᎴ” tᎣ ᎹkᎡ cᎠllᏍ, Ꭸt tᎮ ᏪᎠtᎮr, Ꭰnd ᎼrᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Because turning on  affects data encryption, you need to confirm your password.">
                <langSet xml:lang="en-US"><tig><term>Because turning on  affects data encryption, you need to confirm your password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎠᏍᏚᎢᏓ  ᏱᏗᎬᏂᏏᏍᎩ ᎦᏟᏌᏅᎯ ᎠᏕᎵᏍᏔᏅ, ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᏦᎯᏳᏙᏗ ᏂᏨᏅᎢ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to manage permissions for Device Personalization Services">
                <langSet xml:lang="en-US"><tig><term>Tap to manage permissions for Device Personalization Services</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᎬᏩᏟ ᏥᏂᎬᏅᏗᏓᎾ ᎮᎵᏒᏊ ᏅᎦ ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Prevents your screen from turning off if you\u2019re looking at it">
                <langSet xml:lang="en-US"><tig><term>Prevents your screen from turning off if you\u2019re looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏗ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎦᏔᎲᏍᎬ ᎠᏍᏚᎭ ᎨᎡᎢ ᏂᏨᎤᎢ ᎠᎦᏖᏃᎲ ᎾᎿᎢ ᎨᎡᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't disable PIN.">
                <langSet xml:lang="en-US"><tig><term>Can't disable PIN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎦᎬᏙᏗ ᏂᎨᏒᎾ PIN.</term></tig></langSet>
            </termEntry>
            <termEntry id="No visuals or sound from notifications">
                <langSet xml:lang="en-US"><tig><term>No visuals or sound from notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏓᏟᎶᏍᏛ ᏃᎴ ᎦᏃᏴᎵᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏗᎾᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Invalid PIN.">
                <langSet xml:lang="en-US"><tig><term>Invalid PIN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏓᏂᎸᎬᎾ PIN.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you're using the Google Assistant, suggestion chips will appear at the bottom of the screen to offer easy shortcuts to additional information that may be helpful.">
                <langSet xml:lang="en-US"><tig><term>When you're using the Google Assistant, suggestion chips will appear at the bottom of the screen to offer easy shortcuts to additional information that may be helpful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎲᏗᏍᎬ Ꮎ ᎫᎦᎵ ᎠᎵᏍᏕᎵᏍᎩ, ᎧᏁᎢᏍᏙᏗ chips ᎠᏎᎢ ᎬᏂᎨᏒᎢ ᎾᎿᎢ Ꮎ ᎭᏫᏂ ᎥᎿᎢ Ꮎ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎵᏍᎪᎸᏙᏗ ᎠᏂᏓ ᎠᏍᏆᎳ ᎢᏗᎬᏁᎯ ᏗᎦᏟᏌᏅᎯ ᎦᏃᎮᏢᏗ Ꮎ ᎡᎵᏊᏃ ᎠᎵᏍᏕᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To control media playback on the external display, swipe up on the media player icon.">
                <langSet xml:lang="en-US"><tig><term>To control media playback on the external display, swipe up on the media player icon.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᎸᏍᏗ ᎦᎶᏙᏗ ᏙᎠᏁᎶᏗᏍᎩ ᎥᎿᎢ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ,  ᎦᎶᎯᏍᏗᏍᎩ ᎥᎿᎢ ᏗᎦᏃᎩᏍᏗᏍᎩ ᎠᎢᎧᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Too many incorrect attempts. This work profile and its data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>Too many incorrect attempts. This work profile and its data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏍᏈᏯ ᏂᏚᏳᎪᏛᎾ ᎠᏁᏗᏍᎪᎢ. ᎯᎠ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎾᎿ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open the flip to answer an incoming call.">
                <langSet xml:lang="en-US"><tig><term>Open the flip to answer an incoming call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>FᎵp ᎣpᎡn tᎣ ᎠnᏍᏪr Ꭰn ᎢncᎣᎻng cᎠll.</term></tig></langSet>
            </termEntry>
            <termEntry id="Closing the flip will end the call unless you’re using the speaker, a Bluetooth device, or a headset.">
                <langSet xml:lang="en-US"><tig><term>Closing the flip will end the call unless you’re using the speaker, a Bluetooth device, or a headset.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏗᏍᏗ ᏫᏗᎬᏔᏅ ᎢᏳᏍᎩᏂ ᏂᎯ ᎾᏍᎩ ᎲᏗᏍᎬ ᎾᏍᎩ ᎧᏁᎩ ᏗᏟᏃᎵᏗ, ᎾᏍᎩ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᎴᏃ ᎾᏍᎩ ᏗᏟᏳᏦᎾᏗᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn this on in Camera settings.">
                <langSet xml:lang="en-US"><tig><term>You can turn this on in Camera settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵ ᏍᏚᎢᏍᏗ ᎯᎠ ᏄᏍᏛ ᏗᎧᏃᏗ  ᎥᎾᎢ ᏗᏓᏟᎶᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="What has been using the battery">
                <langSet xml:lang="en-US"><tig><term>What has been using the battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎤᏍᏗ ᏂᎦᎵᏍᏓ ᎬᏗᎭ ᏥᎩ ᎠᎾᎦᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Night Light tints your screen amber.">
                <langSet xml:lang="en-US"><tig><term>Night Light tints your screen amber.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏒᏃᏱ ᎠᏨᏍᏛ ᎢᎦᎢ ᏗᏑᏫᏓ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᎤᏬᏗᎨᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Media center">
                <langSet xml:lang="en-US"><tig><term>Media center</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᎠᏰᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camcorder">
                <langSet xml:lang="en-US"><tig><term>Camcorder</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎻᎪᏓᏅᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Capture even more">
                <langSet xml:lang="en-US"><tig><term>Capture even more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏗ ᎤᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="When to show">
                <langSet xml:lang="en-US"><tig><term>When to show</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎾᎿᎢ ᎠᎪᏩᏛᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When screen is dark, it turns on for new notifications">
                <langSet xml:lang="en-US"><tig><term>When screen is dark, it turns on for new notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎠᏴᏙᎳᏛᎢ ᎨᎡᎢ ᎤᎵᏏᎩ, ᎨᎡᎢ ᎠᎦᏔᎲᎠ ᎤᎿᎢ ᎤᎬᏩᏟ ᏗᏤ ᏗᎾᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Locking &amp; unlocking">
                <langSet xml:lang="en-US"><tig><term>Locking &amp; unlocking</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏍᏚᎲᏍᎬ ᎠᎴ ᎥᏍᏚᎢᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Limit background activity?">
                <langSet xml:lang="en-US"><tig><term>Limit background activity?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎯ ᎠᎾᎦᎵᏍᎩ ᎠᎾᎵᏖᎸᎲᏍᎬ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again later.">
                <langSet xml:lang="en-US"><tig><term>Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Ambient display">
                <langSet xml:lang="en-US"><tig><term>Ambient display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎪᏗ ᏓᏨᏍᏛ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This makes it easier to look at your screen or read in dim light, and may help you fall asleep more easily.">
                <langSet xml:lang="en-US"><tig><term>This makes it easier to look at your screen or read in dim light, and may help you fall asleep more easily.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏂᎦᎵᏍᏗᏍᎬᎢ ᎨᎡᎢ ᎠᎯᏗᎨ ᎾᎿᎢ ᏩᎦᏔ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᎠᎪᎵᏰᏗ ᎾᎿ ᎯᏍᎪᎸᏓ ᎠᏨᏍᏛ, ᎠᎴ ᏰᎴᏯ ᎠᎵᏍᏕᎸᏓ ᏂᎯ ᎤᎳᎪᎲᏍᎩ ᎦᎵᎭ ᎤᎪᏗᏊ ᎠᎯᏗᏳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device location needed to determine your sunset and sunrise times.">
                <langSet xml:lang="en-US"><tig><term>Device location needed to determine your sunset and sunrise times.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎤᏙᏢᏒᎢ ᎤᏚᎸᏛ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᏂᏨᎤᎢ ᎤᏗᎦᎷᏱ ᎠᎴ ᏕᎦᏅᏱ ᎢᏳᏩᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dark aware">
                <langSet xml:lang="en-US"><tig><term>Dark aware</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏏᎩ ᎯᎦᏔᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For webcam">
                <langSet xml:lang="en-US"><tig><term>Ready For webcam</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ready For ᎠᏏᎳᏕᏫᏒ ᏗᏓᏟᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly zoom in on the screen to make content larger.To zoom in:{0,number,integer}. Use shortcut to start magnification{1,number,integer}. Tap the screen{2,number,integer}. Drag 2 fingers to move around screen{3,number,integer}. Pinch with 2 fingers to adjust zoom{4,number,integer}. Use shortcut to stop magnificationTo zoom in temporarily:{0,number,integer}. Use shortcut to start magnification{1,number,integer}. Touch &amp; hold anywhere on the screen{2,number,integer}. Drag finger to move around screen{3,number,integer}. Lift finger to stop magnification ">
                <langSet xml:lang="en-US"><tig><term>Quickly zoom in on the screen to make content larger.To zoom in:{0,number,integer}. Use shortcut to start magnification{1,number,integer}. Tap the screen{2,number,integer}. Drag 2 fingers to move around screen{3,number,integer}. Pinch with 2 fingers to adjust zoom{4,number,integer}. Use shortcut to stop magnificationTo zoom in temporarily:{0,number,integer}. Use shortcut to start magnification{1,number,integer}. Touch &amp; hold anywhere on the screen{2,number,integer}. Drag finger to move around screen{3,number,integer}. Lift finger to stop magnification </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᏓᏊ ᎾᎥ ᏅᎦ ᎤᎿᎢ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎪᏒᏗ ᏄᏍᏗᏓᏅ ᎡᏉᎯᎨᏍᏙᏗ.ᎾᎿᎢ ᎾᎥ ᏅᎦ:{0,number,integer}. ᎬᏔᏂᏓᏍᏗ ᏥᏳᎪᏗᏊ ᎾᎿᎢ ᎭᎴᎾ ᎠᏔᏃᎲᏍᏗᏍᎩ{1,number,integer}. ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᏥᎩ ᎠᏴᏙᎳᏛᎢ{2,number,integer}. ᎦᎾᏏᏁᎦ 2 ᏕᎦᏰᏌᏛ ᎾᎿᎢ ᎠᎲᏍᏗ ᎠᏕᏯᏍᏗ ᎠᏴᏙᎳᏛᎢ{3,number,integer}. ᎠᏇᏄᎩᏍᏗ ᎬᏗ 2 ᏕᎦᏰᏌᏛ ᎾᎿᎢ ᎠᏓᏁᏟᏴᏍᎩ ᏑᎻ{4,number,integer}. ᎬᏔᏂᏓᏍᏗ ᏥᏳᎪᏗᏊ ᎾᎿᎢ ᎭᎴᏫᏍᏓ ᎠᏔᏃᎲᏍᏗᏍᎩᎾᎿᎢ ᎾᎥ ᏅᎦ ᏞᎦᏊ:{0,number,integer}. ᎬᏔᏂᏓᏍᏗ ᏥᏳᎪᏗᏊ ᎾᎿᎢ ᎭᎴᎾ ᎠᏔᏃᎲᏍᏗᏍᎩ{1,number,integer}. ᎭᏒᏂᎦ ᏃᎴ ᎯᎾᎯᏍᏓ ᏂᎬᏉ ᎤᎿᎢ ᏥᎩ ᎠᏴᏙᎳᏛᎢ{2,number,integer}. ᎦᎾᏏᏁᎦ ᎦᏰᏌᏛ ᎾᎿᎢ ᎠᎲᏍᏗ ᎠᏕᏯᏍᏗ ᎠᏴᏙᎳᏛᎢ{3,number,integer}. ᎠᏌᎳᏙᏗ ᎦᏰᏌᏛ ᎾᎿᎢ ᎭᎴᏫᏍᏓ ᎠᏔᏃᎲᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM card lock settings">
                <langSet xml:lang="en-US"><tig><term>SIM card lock settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᏆᎾᏲᏍᏗ ᏓᎩᏍᏏ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
