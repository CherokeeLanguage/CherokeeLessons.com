                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏂᎯ ᎨᎡᎩ ᎾᎿ Ꭰ ᎢᎬᎾᏕᎾ ᎬᏗ ᎤᎴᏌᏓᎢ ᎫᏝᎢ ᎠᎴ Ꮭ ᎫᏝᎢ ᎤᎿᎢ ᏂᎦᏓ, Wi-Fi ᏓᏯᏂᏍᎬ ᎠᏎ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᎯ ᎾᎿᎢ ᎪᏢᏗ ᏓᏯᏂ ᎢᏴᏛ Wi-Fi ᎢᏳᏃ ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Calling lets you make and receive voice calls and text/multimedia messages over Wi-Fi when your phone is connected to a Wi-Fi network and registered with the  network for Wi-Fi Calling.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi Calling lets you make and receive voice calls and text/multimedia messages over Wi-Fi when your phone is connected to a Wi-Fi network and registered with the  network for Wi-Fi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᏩᏂᎩ ᏂᎯ ᎪᏢᏗ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ ᎠᎴ ᎯᏪᏗ/ᎢᎸᏍᎩ ᎧᏃᎮᎸᏍᎩ ᏗᎪᎵᏰᏗ ᎢᏴᏛ Wi-Fi ᎢᏳᏃ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᎫᏓᎸᎢ ᎠᎴ ᎠᎪᏪᎳᏅᎯ  ᎤᎬᏩᏟ Wi-Fi ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Settings managed by your IT admin">
                <langSet xml:lang="en-US"><tig><term>Settings managed by your IT admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ ᏗᎦᏅᏏᏙᎯ ᎬᏗ ᏂᏨᎤᎢ IT ᎤᎦᏎᏍᏗᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bug report handler">
