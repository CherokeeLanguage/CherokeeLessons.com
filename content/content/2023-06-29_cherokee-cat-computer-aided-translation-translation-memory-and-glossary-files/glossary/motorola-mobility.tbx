                <langSet xml:lang="chr"><tig><term>COSMOTE WiFi ᏫᏴᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Warning: If you enter an incorrect PIN code multiple times, your SIM card will be completely disabled.">
