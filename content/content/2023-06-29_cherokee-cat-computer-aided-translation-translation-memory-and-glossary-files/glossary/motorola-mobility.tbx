                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏗᎧᏁᏉᏍᏗ ᎦᎸᎳᏗ ᎾᎿᎢ  ᏚᎾᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face enrollment didn't work.">
                <langSet xml:lang="en-US"><tig><term>Face enrollment didn't work.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᏕᎪᏪᎸ ᏚᎾᏙᎥ ᏗᎦᎸᏫᏍᏓᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This helps protect data on lost or stolen devices.">
                <langSet xml:lang="en-US"><tig><term>This helps protect data on lost or stolen devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏓᎵᏍᏕᎵᏍᎪ ᎠᎵᏍᏕᎸᏙᏗ ᎦᏟᏌᏅᎯ ᎤᎾᎢ ᎤᏂᏲᎱᏎᎸ ᎠᎴᏃ ᎦᏃᏍᎩᏓ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
