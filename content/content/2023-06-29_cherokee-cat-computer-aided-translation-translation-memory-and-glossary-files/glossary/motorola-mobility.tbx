                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ &amp; ᏗᏟᏃᎮᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set up when to use each SIM card for data, calls and messages">
                <langSet xml:lang="en-US"><tig><term>Set up when to use each SIM card for data, calls and messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᏍᎬᎢ ᎢᏳᏃ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎢᏧᎳ SIM ᏆᎾᏲᏍᏗ ᎤᎬᏩᏟ ᎦᏘᏍᎩᏌᏅᎯ, ᏓᏯᏂ ᏃᎴ ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Take your gaming to the next level with big screen performance on your TV or display.">
                <langSet xml:lang="en-US"><tig><term>Take your gaming to the next level with big screen performance on your TV or display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏫᏓ ᏂᏨᏅᎢ ᏕᎭᏁᎸᏗᏍᎬᎢ ᎾᎢ ᎾᏍᎩ ᏐᎢ ᎠᏟᎶᏍᎩ ᎬᏗ ᎤᏔᎾ ᎠᏴᏙᎳᏛᎢ ᏧᎸᏫᏍᏓᏁᎯ ᎤᎾᎢ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴᏃ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect a Bluetooth game controller for an enhanced experience.">
                <langSet xml:lang="en-US"><tig><term>Connect a Bluetooth game controller for an enhanced experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏗᏁᎸᏙᏗ ᎠᏱᎴᎦ ᎾᏍᎩᎾ ᏓᏤᏢᎢ ᏓᏤᏢᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="light sensitivity, photophobia, dark theme, migraine, headache, reading mode, night mode, reduce brightness, white point">
                <langSet xml:lang="en-US"><tig><term>light sensitivity, photophobia, dark theme, migraine, headache, reading mode, night mode, reduce brightness, white point</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎦᏅ ᎠᏒᏅᏍᏗᎢ, ᏗᏟᎶᏍᏔᏅ ᎤᏍᎦᎡᏂ, ᎤᎵᏏᎩ ᎤᏓᏤᏟᏓ ᏗᎧᏃᏗᏱ, ᎠᏍᎪᎵ ᎤᏪᏍᏓᏁᎲ, ᎠᏍᎪᎵ ᎤᏪᏍᏓᏁᎲ, ᏗᎪᎵᏰᏗᏊ ᎬᏙᏗ, ᎤᏒᎢ ᎬᏙᏗ, ᎠᎦᏲᎳᏅ ᎤᏍᎪᏍᏗᏴ, ᎤᏁᎦ ᏩᏎᎯᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Drag down from the top of the external display to access the first 6 available quick settings tiles.">
                <langSet xml:lang="en-US"><tig><term>Drag down from the top of the external display to access the first 6 available quick settings tiles.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗ ᎦᎾᏏᏅᏍᏗ ᎾᏍᎩᎾ ᎦᏚᎢ ᎾᎢ ᏙᏱᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎾᎢ ᎠᏴᏍᏗ ᎾᏍᎩ ᎢᎬᏱ 6 ᎠᏛᏅᎢᏍᏔᏅ ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ ᏓᏲᏓᏅᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Bring your screen to life">
                <langSet xml:lang="en-US"><tig><term>Bring your screen to life</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᎬᏃᏓᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth permission is not granted for Ready For service.">
                <langSet xml:lang="en-US"><tig><term>Bluetooth permission is not granted for Ready For service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Bluetooth ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎨᎡᎢ ᎥᏝ ᎤᎵᏍᎪᎸᏔᏅ ᎤᎬᏩᏟ Ready For ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again later.">
                <langSet xml:lang="en-US"><tig><term>Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="volte, advanced calling, 4g calling">
                <langSet xml:lang="en-US"><tig><term>volte, advanced calling, 4g calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏉᎵᏖ ᎤᎵᏱᎸᏛ, ᏓᏯᏂᏍᎬ, 4g ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="CALL ENDED -91-">
                <langSet xml:lang="en-US"><tig><term>CALL ENDED -91-</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎠLL ᎡNᏕD -91-</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on &amp; off">
                <langSet xml:lang="en-US"><tig><term>Turning on &amp; off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᎬ &amp; ᎠᏍᏚᎲᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="External display apps">
                <langSet xml:lang="en-US"><tig><term>External display apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏱᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Interactive wallpapers bring vivid motion to the Home screen as they respond to your actions or change throughout the day.">
                <langSet xml:lang="en-US"><tig><term>Interactive wallpapers bring vivid motion to the Home screen as they respond to your actions or change throughout the day.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᎲᏍᎩ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ ᎯᏲᏢᎩ ᎬᏂᎦᎵᏍᏗ ᎠᏓᏅᏏᏙᎲᎢ ᎾᎢ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎾᏍᎩᏛ ᎯᎢᎾᎢ ᎦᏬᎯᎵᏴᏓ ᎾᎢ ᏣᏤᎵ ᏗᎵᏖᎸᏗ ᏂᎦᏅᎯᏒ ᎾᏍᎩ ᎢᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Conversations widget lets you jump into a message thread anytime from the Home screen.">
                <langSet xml:lang="en-US"><tig><term>The Conversations widget lets you jump into a message thread anytime from the Home screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏓᎾᏟᏃᎮᏍᎬᎢ ᏫᏥᏘ ᏣᎵᏍᎪᎸᏓᏁᎯ ᏫᏗᏣᎵᏔᏗᏅᏓ ᎾᎾᎯ ᎧᏃᎮᏍᎩ ᎠᏍᏘ ᎠᏏᎳᏛᎢ ᏱᏂᎦᎵᏍᏗᏊ ᎢᏴ ᎾᏍᎩᎾ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Folder name is empty">
                <langSet xml:lang="en-US"><tig><term>Folder name is empty</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏴᏈᏛᎥᏍᎩ ᏚᏅᏙᎥ ᎨᎡᎢ ᎤᏑᏩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The file transfer function only supports the transfer of single file">
                <langSet xml:lang="en-US"><tig><term>The file transfer function only supports the transfer of single file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏍᏆᏂᎪᏙᏗ ᏗᎲᏍᏗᏱ ᏧᎸᏫᏍᏓᏁᏗᏱ ᎤᏅᏒ ᏗᎦᎫᏍᏛᏍᎩ ᏥᎩ ᏗᎲᏍᏗᏱ ᎾᎿ ᏏᏴᏫ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable custom setting">
                <langSet xml:lang="en-US"><tig><term>Enable custom setting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᏄᏍᏛ ᎢᏯᎾᏛᏁᎯ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When screen is on">
                <langSet xml:lang="en-US"><tig><term>When screen is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎠᏴᏙᎳᏛᎢ ᎾᏍᎩ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Work notifications">
                <langSet xml:lang="en-US"><tig><term>Work notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="CALL ENDED -95-">
                <langSet xml:lang="en-US"><tig><term>CALL ENDED -95-</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎠLL ᎡNᏕD -95-</term></tig></langSet>
            </termEntry>
            <termEntry id="The widget shows you the last message in the chat, so it’s easy to keep the conversation going, even on your busiest days.">
                <langSet xml:lang="en-US"><tig><term>The widget shows you the last message in the chat, so it’s easy to keep the conversation going, even on your busiest days.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏫᏥᏘ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ ᏂᎯ ᎾᏍᎩ ᎣᏂ ᎧᏃᎮᏍᎩ ᎾᎿᎢ ᎾᏍᎩ ᏗᏟᏃᎮᏗ, ᎾᏍᎩ ᎠᎯᏓ ᎾᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏓᎾᏟᏃᎮᏍᎬᎢ ᏄᏍᏗᏗᏎᏍᏗ, ᎥᏍᏊ ᎤᎾᎢ ᏣᏤᎵ ᎤᎪᏓ ᏚᎸᏫᏍᏓᏁᎢ ᏧᏒᎯᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Peek Display lets you read, respond, and interact with notifications while your screen is locked.">
                <langSet xml:lang="en-US"><tig><term>Peek Display lets you read, respond, and interact with notifications while your screen is locked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏗᏣᎵᏍᎪᎸᏓᏁᎯ ᎠᎪᎵᏰᏗ, ᎦᏬᎯᎵᏴᏓ, ᎠᎴ ᎤᏪᎳᏗᏓᏍᏗ ᎤᏠᏯᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᏄᏍᏛ ᏍᏓᏱ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Copy items to clipboard failed.">
                <langSet xml:lang="en-US"><tig><term>Copy items to clipboard failed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᎶᏍᏔᏅᎯ ᏑᏓᎴᎩ ᏗᎪᏪᎵ ᎾᎿᎢ ᏗᎦᏯᎸᏙᏗᎢ ᎠᏓᏄᎸᎲᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Head to the Peek Display tutorial to see all the ways you can interact with notifications on the external display.">
                <langSet xml:lang="en-US"><tig><term>Head to the Peek Display tutorial to see all the ways you can interact with notifications on the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎢ ᏫᎶᎯ ᎾᏍᎩ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏘᎪᎵᏯ ᎠᏓᏕᏲᎲᏍᎩ ᎾᎢ ᎠᎪᏩᏛᏗ ᏂᎦᏓ ᎾᏍᎩ ᏱᏗᎬᏁᏗ ᏂᎯ ᏰᎵᏊ ᎤᏪᎳᏗᏓᏍᏗ ᎤᏠᏯᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᎤᎾᎢ ᎾᏍᎩ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When an app is open on the external display, you can navigate the same way you do on the internal display.">
                <langSet xml:lang="en-US"><tig><term>When an app is open on the external display, you can navigate the same way you do on the internal display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎢ ᎾᏍᎩ ᎬᏙᏗ ᏄᏍᏛ ᎠᏍᏚᎢᏓ ᎤᎾᎢ ᎾᏍᎩ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᏂᎯ ᏰᎵᏊ ᎠᏂᎩᏍᏗ ᎾᏍᎩ ᎤᏠᏱ ᏳᎵᏍᏙᏗ ᏂᎯ ᏱᎦᏚᏗ ᎤᎾᎢ ᎾᏍᎩ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Share your power">
                <langSet xml:lang="en-US"><tig><term>Share your power</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᎯᏍᏗ ᏣᏤᎵ ᎤᏟᏂᎩᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge touch">
                <langSet xml:lang="en-US"><tig><term>Edge touch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᎠᏒᏂᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Forget ?">
                <langSet xml:lang="en-US"><tig><term>Forget ?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏩᎨᏩ ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Indicate adjustments made to notifications and show the option to provide feedback to the system">
                <langSet xml:lang="en-US"><tig><term>Indicate adjustments made to notifications and show the option to provide feedback to the system</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏎᎮᏗ ᎣᏍᏛ ᏂᏓᏅᏁᎲ ᎪᏢᏅᎯ ᎾᎢ ᏗᏓᏃᏣᏫᏁᎯ ᎠᎴ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᏍᎩ ᎠᏑᏰᏍᏗ ᎾᎢ ᎠᏓᏁᎳᏁᏗ ᎦᏬᎯᎵᏴᏓ ᎾᏍᎩ ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow ^1 to move this item out of trash?">
                <langSet xml:lang="en-US"><tig><term>Allow ^1 to move this item out of trash?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ^1 ᎾᎢ ᎠᎲᏍᏗ ᎯᎠ ᎤᏤᎵᏛ ᎪᏪᎵ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow ^1 to move ^2 items out of trash?">
                <langSet xml:lang="en-US"><tig><term>Allow ^1 to move ^2 items out of trash?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ^1 ᎾᎢ ᎠᎲᏍᏗ ^2 ᏧᏤᎵᏛ ᏗᎪᏪᎵ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Moving item out of trash…">
                <langSet xml:lang="en-US"><tig><term>Moving item out of trash…</term></tig></langSet>
