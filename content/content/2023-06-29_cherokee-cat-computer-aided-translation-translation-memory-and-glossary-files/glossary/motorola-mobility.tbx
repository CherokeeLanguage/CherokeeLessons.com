            <termEntry id="Failed password attempts before deleting all device data">
                <langSet xml:lang="en-US"><tig><term>Failed password attempts before deleting all device data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅᎢ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎤᏁᎸᏙᏗ ᎤᏓᎷᎸ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏥᏂᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="All apps and data will be deleted.">
