            </termEntry>
            <termEntry id="Your mobile data will be used for the speed test.">
                <langSet xml:lang="en-US"><tig><term>Your mobile data will be used for the speed test.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᏓᏅᏏᏙᎯ ᎦᏟᏌᏅᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᎾᏍᎩᎾ ᎦᏣᏄᎳ ᎠᏓᎪᎵᏰᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Stylus removed">
                <langSet xml:lang="en-US"><tig><term>Stylus removed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏪᎳᏅ ᏂᎬᎾᏕᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You cannot make a call while the device is in airplane mode. Would you like to turn airplane mode off?">
                <langSet xml:lang="en-US"><tig><term>You cannot make a call while the device is in airplane mode. Would you like to turn airplane mode off?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎪᏒᏗ Ꭰ ᏪᏯᎾ ᎾᎯᏳᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎩ ᎾᎿ ᏥᏳ ᏄᏍᏛᎢ . ᏯᏓᎯᏗᏏ ᏂᏨᎤᎢ ᎯᎸᏉᏗ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᏥᏳ ᏄᏍᏛᎢ ᎠᏍᏚᎭ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Does the device show the correct number of touch points, and do they follow your movements?">
                <langSet xml:lang="en-US"><tig><term>Does the device show the correct number of touch points, and do they follow your movements?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏊᏍ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏂᎨᏒ ᏂᎬᏁᎢ ᎾᏍᎩ ᏚᏳᎪᏛᎢ ᎠᏎᏍᏗ ᎥᎿᎢ ᎠᏒᏂᏍᏗ ᏧᏓᏓᏟ, ᎠᎴ ᎠᏂᏍᏓᏩᏕᎦᏍ ᎭᏓᏅᏏᏙᎲᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Download test total traffic">
                <langSet xml:lang="en-US"><tig><term>Download test total traffic</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏓᎪᎵᏰᏍᎩ ᏂᎦᏓᏊ ᎠᎾᏓᏅᏏᏙᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Move to a quiet environment and then tap OK to start recording.">
                <langSet xml:lang="en-US"><tig><term>Move to a quiet environment and then tap OK to start recording.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᎾᎢ ᎾᏍᎩ ᎡᏝᏪ ᎡᎶᎯ ᏄᏍᏛᎢ ᎠᎴ ᎿᏉᏃ ᎭᏐᎥᏍᏓ ᏗᏓᏂᎸᏍᎩ ᎾᎢ ᎠᎴᏅᏓ ᎦᏂᏴᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After 3 seconds, your recording will play back.">
                <langSet xml:lang="en-US"><tig><term>After 3 seconds, your recording will play back.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ 3 ᏓᏓᎾᏩᏍᎬ, ᏣᏤᎵ ᎦᏂᏴᏗᏍᎬ ᏰᎵᏉ ᏣᏙᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" can't receive video calls right now. Switching to voice call...">
                <langSet xml:lang="en-US"><tig><term> can't receive video calls right now. Switching to voice call...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎠᎦᏘᏏ Ꭷ. ᎠᏓᏁᏟᏴᎢ ᎾᎿᎢ ᎤᏁᎬ ᏪᏯᎾ...</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't disable PIN.">
                <langSet xml:lang="en-US"><tig><term>Can't disable PIN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎦᎬᏙᏗ ᏂᎨᏒᎾ PIN.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will automatically pair with the stylus.">
                <langSet xml:lang="en-US"><tig><term>Your phone will automatically pair with the stylus.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏗᎵᎪᏙᏗᏍᎪᎢ ᎾᏍᎩ ᎬᏗ ᏗᎪᏪᎳᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Scan failed">
                <langSet xml:lang="en-US"><tig><term>Scan failed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᎤᏓᏄᎸᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="During this test, your screen will turn red, then green, and then blue.">
                <langSet xml:lang="en-US"><tig><term>During this test, your screen will turn red, then green, and then blue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᎯᎠ ᎠᎪᎵᏰᏍᎩ, ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᏰᎵᏉ ᎩᎦᎨ ᏯᏓᏁᏓᏴᎾ, ᎿᏉᏃ ᎢᏤᏳᏍᏗ, ᎠᎴ ᎿᏉᏃ ᏌᎪᏂᎨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the screen to begin.">
                <langSet xml:lang="en-US"><tig><term>Tap the screen to begin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎢ ᎠᎴᏅᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Hi, I'm your virtual agent.">
                <langSet xml:lang="en-US"><tig><term>Hi, I'm your virtual agent.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏲ, ᎠᏯᏃ ᎠᏆᏤᎵ ᎠᏤᎸᏅᎢ ᎠᏓᏴᎳᏛᏍᎩ ᎠᏥᏅᏏᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="I can help you solve problems quickly.">
                <langSet xml:lang="en-US"><tig><term>I can help you solve problems quickly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯ ᏰᎵᏊ ᏱᎬᏍᏕᎵ ᎪᎷᏩᏛᏗ ᏓᏓᎴᏍᏗᏍᎬ ᏄᏟᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Clear edits">
                <langSet xml:lang="en-US"><tig><term>Clear edits</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᎪᎸᏓ ᏗᎦᏁᏟᏴᏍᏗ ᏕᎪᏪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Usage Permission">
                <langSet xml:lang="en-US"><tig><term>Data Usage Permission</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your recording won’t be saved.">
                <langSet xml:lang="en-US"><tig><term>Your recording won’t be saved.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎦᏂᏴᎲᎢ Ꮭ ᎡᎵᎢ ᎨᏒᎢ ᎠᎵᏏᏅᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please turn off airplane mode to continue">
                <langSet xml:lang="en-US"><tig><term>Please turn off airplane mode to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏍᏚᏓ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ ᎾᎢ ᏂᎦᏯᎢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you're done using the stylus, insert it into the slot with the notch facing left.">
                <langSet xml:lang="en-US"><tig><term>When you're done using the stylus, insert it into the slot with the notch facing left.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᎠᎵᏍᏆᏓ ᎬᏗᏍᎬ ᎾᏍᎩ ᏗᎪᏪᎳᏅ, ᎪᏣᎸᏗ ᎢᏗᎬᏁᏗᏱ ᎾᏍᎩ ᎤᏜᏅᏛ ᎬᏗ ᎾᏍᎩ ᏗᏰᎳᏍᏗ ᏄᎵᏍᏓᏁᎲᎩ ᎠᏍᎦᏂ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot find Wi-Fi signal.">
                <langSet xml:lang="en-US"><tig><term>Cannot find Wi-Fi signal.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᏱᎨᏥᏩᏔ ᏫᎢ-ᏈᎢ ᎦᏂᏴᏙᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sign in to start chatting with me.">
                <langSet xml:lang="en-US"><tig><term>Sign in to start chatting with me.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏣᏙᎥ ᎰᏪᎸᎦ ᎭᎴᏅᏗᏍᎬ ᏍᏆᎵᏃᎮᏛ ᎠᏯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use reference number # to follow up.">
                <langSet xml:lang="en-US"><tig><term>Use reference number # to follow up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᏩᏎᎸᎯ ᎠᏎᏍᏗ # ᎾᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Min frequency">
                <langSet xml:lang="en-US"><tig><term>Min frequency</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏯᏔᏬᏍᏔᏅ ᎢᏳᏓᎵ ᏂᎦᎵᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Upload">
                <langSet xml:lang="en-US"><tig><term>Upload</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏢᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No warranty info found.">
                <langSet xml:lang="en-US"><tig><term>No warranty info found.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏚᏓᎸᎢ ᎧᏃᎮᏢᎥᏍᎩ ᎠᏩᏛᏓ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This could be due to a network issue.">
                <langSet xml:lang="en-US"><tig><term>This could be due to a network issue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏊ ᎨᏒ ᎢᏳᏍᏗ ᎾᎢ ᎤᏚᏓᎵ ᎠᏓᎴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" Year">
                <langSet xml:lang="en-US"><tig><term> Year</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏑᏕᏘᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dead">
                <langSet xml:lang="en-US"><tig><term>Dead</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏬᏨᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="60fps">
                <langSet xml:lang="en-US"><tig><term>60fps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>60fps</term></tig></langSet>
            </termEntry>
            <termEntry id="To learn how to use my device">
                <langSet xml:lang="en-US"><tig><term>To learn how to use my device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏕᎶᏆᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᎠᏆᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to attach file, your device is out of memory.">
                <langSet xml:lang="en-US"><tig><term>Failed to attach file, your device is out of memory.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎢ ᎦᏯᎸᏗ ᎠᏍᏆᏂᎪᏙᏗ, ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎵᏒᎾ ᎥᏍᎩ ᎠᏅᏓᏗᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you agree to turn on high accuracy location mode for the testing?">
                <langSet xml:lang="en-US"><tig><term>Do you agree to turn on high accuracy location mode for the testing?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍ ᎣᏏ ᎯᏰᎸᏍᎩ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎦᎸᎳᏗ ᎧᎵ ᏗᏙᎳᎩ ᎤᏙᏢᏒᎢ ᎬᏙᏗᎭ ᎾᏍᎩᎾ ᎠᏂᎪᎵᏰᏍᎬᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id=" MHz">
                <langSet xml:lang="en-US"><tig><term> MHz</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> MHz</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Note is the hub for all of your creations.">
                <langSet xml:lang="en-US"><tig><term>Moto Note is the hub for all of your creations.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎼᏙ ᎤᏍᏗ ᎪᏪᎸ ᎾᏍᎩ ᎠᏰᏟ ᎾᏍᎩᎾ ᏂᎦᏓ ᏗᏣᏤᎵ   ᏗᎪᏢᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Go it">
                <langSet xml:lang="en-US"><tig><term>Go it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᏅ ᎤᏩᏌᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device Help can't contact the server right now.">
                <langSet xml:lang="en-US"><tig><term>Device Help can't contact the server right now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏕᎵᏍᎩ ᏝᏰᎵ ᎠᏟᏃᎮᏙᏗ ᎾᏍᎩ ᎠᏯᏙᎯᎯ ᏃᏊᏥᎩᎢᏃ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Check your network connection, and try again.">
                <langSet xml:lang="en-US"><tig><term>Check your network connection, and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎦᏛᎲᎦ ᏣᏤᎵ ᎤᏚᏓᎵ ᎫᏓᎸᎢ, ᎠᎴ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Scan the QR code to connect">
                <langSet xml:lang="en-US"><tig><term>Scan the QR code to connect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᎾᏍᎩ QR ᎠᏍᏓᏩᏛᏍᏙᏗ ᎾᎢ ᎫᏓᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Standard definition">
                <langSet xml:lang="en-US"><tig><term>Standard definition</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>(ᏄᎬᏫᏳᏒ) ᎢᎬᏩᏍᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Multi-touch">
                <langSet xml:lang="en-US"><tig><term>Multi-touch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏍᎩ-ᎢᏯᏒᏂᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disconnect from RSA?">
                <langSet xml:lang="en-US"><tig><term>Disconnect from RSA?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏭᏓᎳᎩ ᏂᏓᏳᏓᎴᏅ RSA?</term></tig></langSet>
            </termEntry>
            <termEntry id="The firmware version of your stylus is the latest version ">
                <langSet xml:lang="en-US"><tig><term>The firmware version of your stylus is the latest version </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏍᏓᏯᎪᏢᏅᎯ ᏄᏓᎴᏒᎢ ᎥᎿᎢ ᏣᏤᎵ ᏗᎪᏪᎳᏅ ᎾᏍᎩ ᏩᏤᎯᏴ ᎢᏤᎯᎨᎢᏍᏗ ᏄᏓᎴᏒᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="To reproduce a radio station, FM Radio needs permission to record audio.">
                <langSet xml:lang="en-US"><tig><term>To reproduce a radio station, FM Radio needs permission to record audio.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>To ᏓᎬᏍᎪᎸᎥᏍᎬᎢ a ᎦᏬᏂᏍᎩ ᎤᎴᏫᏍᏙᏗ, FM ᎦᏬᏂᏍᎩ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ to ᏕᎦᏅᏅᏛᎢ ᎤᏃᏴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="How can we improve Device Help in the future? (optional)">
                <langSet xml:lang="en-US"><tig><term>How can we improve Device Help in the future? (optional)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᏰᎵ ᏂᎦᏛᏉ ᏲᏦᏢᎯᏌ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏕᎵᏍᎩ ᎾᎿᎢ ᎤᏩᎫᏗᏗᏒ? (ᎠᏑᏰᏍᏗ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Available devices not found.">
                <langSet xml:lang="en-US"><tig><term>Available devices not found.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎥᏝ ᎤᏩᏛᎲᎩ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notes in that folder will be moved to Uncategorized.">
                <langSet xml:lang="en-US"><tig><term>Notes in that folder will be moved to Uncategorized.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏍᏗ ᏕᎪᏪᎸ ᎾᎿᎢ ᎾᏍᎩᎾᎢ ᎠᏴᏈᏛᎥᏍᎩ ᏰᎵᏉ ᎨᏎᏍᏗ  ᎠᏂᎲᎾ ᎾᎢ ᏄᏬᎵᏍᏛᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Just pull it out to start a new note.">
                <langSet xml:lang="en-US"><tig><term>Just pull it out to start a new note.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏣᏌᏁᏍᏗᏊ ᎾᎢ ᎠᎴᏅᏓ ᎢᏤ ᎤᏍᏗ ᎪᏪᎸᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to load web content.">
                <langSet xml:lang="en-US"><tig><term>Unable to load web content.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎦᎸᏗ ᎤᏂᎳᏛᎢ ᎦᎸᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No purchase history">
                <langSet xml:lang="en-US"><tig><term>No purchase history</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏩᎯᏍᏗ ᏂᏧᎵᏍᏔᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="There may be a problem with the following part.">
                <langSet xml:lang="en-US"><tig><term>There may be a problem with the following part.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᏃ ᏰᎵᏉ ᏓᏓᎴᎩ ᎨᏎᏍᏗ ᎤᏠᏯᏍᏗ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᎢᎦᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the icon to perform another test or contact us to learn how this part can be fixed.">
                <langSet xml:lang="en-US"><tig><term>Tap the icon to perform another test or contact us to learn how this part can be fixed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎠᎢᎧᏂ ᎢᏯᏛᏁᏗ ᏄᏓᎴ ᎠᏓᎪᎵᏰᏍᎩ ᎠᎴᏃ ᎢᏍᎩᎵᏙᎮᏓ ᎾᎢ ᎠᏕᎶᏆᏍᏗ ᏰᎵ ᎯᎠ ᎢᎦᏛᎭ ᏰᎵᏊ ᎣᏍᏓ ᏱᎨᎬᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There isn't enough storage space for screen recording">
                <langSet xml:lang="en-US"><tig><term>There isn't enough storage space for screen recording</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᏃ ᏝᏰᏃ ᏰᎵᏊ ᏱᏂᎦᎭ ᎠᏍᏆᏂᎪᏙᏗ ᏳᏜᏅᏓ ᎾᏍᎩᎾ ᎠᏴᏙᎳᏛᎢ ᎦᏂᏴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Go to next introduction screen">
                <langSet xml:lang="en-US"><tig><term>Go to next introduction screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᎾ ᎾᎾᎢ ᏐᎢ ᎠᏂᏴᏔᏂᎯᎲᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Continuing to next test.">
                <langSet xml:lang="en-US"><tig><term>Continuing to next test.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᎵᎵᏒᎢ ᎾᎢ ᏐᎢ ᎠᏓᎪᎵᏰᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Yes, and it was easy to use">
                <langSet xml:lang="en-US"><tig><term>Yes, and it was easy to use</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎥ, ᎠᎴ ᎠᎯᏓᏊ ᎨᏒᎢ ᎾᎢ ᎬᏙᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap an icon to perform another test or contact us to learn how these parts can be fixed.">
                <langSet xml:lang="en-US"><tig><term>Tap an icon to perform another test or contact us to learn how these parts can be fixed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎠᏱᎧᏂ ᎢᏯᏛᏁᏗ ᏄᏓᎴ ᎠᏓᎪᎵᏰᏍᎩ ᎠᎴᏃ ᎢᏍᎩᎵᏙᎮᏓ ᎾᎢ ᎠᏕᎶᏆᏍᏗ ᏰᎵ ᎯᎠᏃ ᎢᏗᎦᏛ ᏰᎵᏊ ᎣᏍᏓ ᏱᎨᎬᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Did you hear the ringtone?">
                <langSet xml:lang="en-US"><tig><term>Did you hear the ringtone?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏛᎬᎦᏍᎪ ᎾᏍᎩ ᎤᏃᏴᎵᏍᏙᏓ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Email address is not valid.">
                <langSet xml:lang="en-US"><tig><term>Email address is not valid.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏗᎦᏁᏍᏗᎢ ᎥᏝ ᎪᎯᏳᏙᏗ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep Device Help open to maintain connection">
                <langSet xml:lang="en-US"><tig><term>Keep Device Help open to maintain connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏆᏂᎪᏓ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏕᎵᏍᎩ ᎠᏍᏚᎢᏓ ᎾᎢ ᎢᎦᏘᎭ ᎢᎬᏁᏗ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please input IMEI or serial number*">
                <langSet xml:lang="en-US"><tig><term>Please input IMEI or serial number*</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎦᏬᎯᎵᏴᏓ IMEI ᎠᎴᏃ ᎠᏎᏍᏗ ᏕᎪᏪᎳ*</term></tig></langSet>
            </termEntry>
            <termEntry id="Services are invisible now since you denied the permission of making and managing phone calls.">
                <langSet xml:lang="en-US"><tig><term>Services are invisible now since you denied the permission of making and managing phone calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏓᏛᏁᏗ ᎨᏒᎢ ᎤᏍᎪᎸᏨ ᏃᏊ ᏂᏓᏳᏓᎴᏅᏓ ᏂᎯ ᎤᏓᏱᎸᎢ ᎾᏍᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎥᎿᎢ ᏕᎱᎪᏗᏍᎬ ᎠᎴ ᎠᎯᎸᏍᏗ ᏗᏟᏃᎮᏗ ᏫᏗᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We need to get IMEI and call info to check available services for you, so please tap to allow the permission.">
                <langSet xml:lang="en-US"><tig><term>We need to get IMEI and call info to check available services for you, so please tap to allow the permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏛᏉ ᎣᎦᏚᎸᏓ ᎾᎢ ᎠᎩᏍᏗ IMEI ᎠᎴ ᏫᎬᏔᏅ ᎧᏃᎮᏢᎥᏍᎩ ᎾᎢ ᏣᎦᏛᎲᎦ ᎠᏛᏅᎢᏍᏔᏅ ᎢᏗᏓᏛᏁᏗ ᎾᏍᎩᎾ ᏂᎯ, ᎰᏩᏊ ᎭᏐᎥᏍᏓ ᎾᎢ ᎠᎵᏍᎪᎸᏙᏗ ᎾᏍᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Testing ping speed">
                <langSet xml:lang="en-US"><tig><term>Testing ping speed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎪᎵᏰᏍᎬᎢ ᏗᏍᎩᏅᏁᎸᎢ ᎢᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device is out of warranty">
                <langSet xml:lang="en-US"><tig><term>Device is out of warranty</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏛ ᎤᎶᏐᏅᎯ ᎾᏍᎩ ᎠᏚᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="After capturing a photo on the internal display, the external display can show a preview for your subject to review.">
                <langSet xml:lang="en-US"><tig><term>After capturing a photo on the internal display, the external display can show a preview for your subject to review.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᎦᏂᏱᏍᎬ ᏗᏓᏟᎶᏍᏔᏅᎯ ᎥᎾᎢ ᎭᏫᏂ ᎠᏓᏴᎳᏔᏍᎩ, Ꮎ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ  ᏰᎵ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎠᏓᎪᏩᏛᏗᏍᎩ ᏄᏰᎸᏛ ᏂᏣᏤᎵ ᎧᏃᎮᏗ ᏣᎪᎵᏰᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There may be a problem with the following parts.">
                <langSet xml:lang="en-US"><tig><term>There may be a problem with the following parts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᏃ ᏰᎵᏉ ᏓᏓᎴᎩ ᎨᏎᏍᏗ ᎤᏠᏯᏍᏗ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᎢᏗᎦᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sign in to start chatting.">
                <langSet xml:lang="en-US"><tig><term>Sign in to start chatting.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏣᏙᎥ ᎰᏪᎸᎦ ᎾᎢ ᎠᎴᏅᏓ ᎥᎦᏬᏂᎯᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Maximum pictures reached">
                <langSet xml:lang="en-US"><tig><term>Maximum pictures reached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏭᎪᏛᎢ ᏗᏓᏟᎶᏍᏔᏅ ᏫᎦᎷᏨᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press and hold on an icon to change the order">
                <langSet xml:lang="en-US"><tig><term>Press and hold on an icon to change the order</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᎴ ᏣᏂᏴᏎᏍᏗ ᎤᎾᎢ ᎠᎢᎧᏂ ᎾᎢ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᎠᏓᏅᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="The email you entered has been registered with a Lenovo account, please enter corresponding password for binding.">
                <langSet xml:lang="en-US"><tig><term>The email you entered has been registered with a Lenovo account, please enter corresponding password for binding.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏂᎯ ᏣᏴᏍᏔᏅᎢ ᎪᏪᎳᏅᎯ ᏂᎦᎵᏍᏗᎭ ᎬᏗ ᎴᏃᏉ ᎠᏚᏓᎸᏗ, ᎰᏩᏊ ᎯᏴᏓ ᏗᏓᏙᏪᎳᏅᎯ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎾᏍᎩᎾ ᏗᎧᏛᎢᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="storage permission">
                <langSet xml:lang="en-US"><tig><term>storage permission</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="contacts permission">
                <langSet xml:lang="en-US"><tig><term>contacts permission</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏙᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi status: ">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi status: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎢ-ᏈᎢ ᏄᏍᏗᏓᏅᎢ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Hardware test">
                <langSet xml:lang="en-US"><tig><term>Hardware test</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᎠᏓᎪᎵᏰᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="OTA mode device found, start OTA upgrade...">
                <langSet xml:lang="en-US"><tig><term>OTA mode device found, start OTA upgrade...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>OTA ᎬᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏩᏛᎲᎩ, ᎭᎴᎾ OTA ᏦᏢᎯᏐᏗ...</term></tig></langSet>
            </termEntry>
            <termEntry id="You have lost data connectivity because you left your home network with data roaming turned off.">
                <langSet xml:lang="en-US"><tig><term>You have lost data connectivity because you left your home network with data roaming turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏂᏲᎱᏎᎸ ᎦᏘᏍᎩᏌᏅᎯ ᏗᎫᏓᎸᏗᎢ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏂᎯ ᎠᎦᏍᎦᏂ ᏂᏨᎤᎢ ᎣᏪᏅᏒ ᏚᎾᏚᏓᎵ ᎬᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Start firmware upgrade">
                <langSet xml:lang="en-US"><tig><term>Start firmware upgrade</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏅᏓ ᎠᏍᏓᏯᎪᏢᏅᎯ ᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="select file">
                <langSet xml:lang="en-US"><tig><term>select file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Change the position of your finger slightly each time">
                <langSet xml:lang="en-US"><tig><term>Change the position of your finger slightly each time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᏥᎩ ᎦᎪᏗ ᎾᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᏍᏗᎩᏓ ᎠᏂᏏᏴᏫᎭ ᎠᏥᎢᎵᏒ</term></tig></langSet>
