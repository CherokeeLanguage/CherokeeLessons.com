                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎫᏓᎸᏓ ᎯᎠᏃ ᏗᎬᏙᏗ, ᎯᏘᏅᏛᎦ  ᎾᎿᎢ ᏣᏤᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎧᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="Failed password attempts before deleting device data">
                <langSet xml:lang="en-US"><tig><term>Failed password attempts before deleting device data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅᎢ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎤᏁᎸᏙᏗ ᎤᏓᎷᎸ ᎠᏍᎪᎸᏗᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows read access to edge/power touch app content provider">
                <langSet xml:lang="en-US"><tig><term>Allows read access to edge/power touch app content provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᎠᎪᎵᏰᏗ ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᎠᏍᏛᎢ/ᎤᏬᏯᏂᏍᎩ ᎬᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎬᏙᏗ ᏄᏍᏗᏓᏅ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device admin app">
                <langSet xml:lang="en-US"><tig><term>Device admin app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="They walked over a pavement of the same green marble, and where the blocks were joined together were rows of emeralds, set closely, and glittering in the brightness of the sun.">
                <langSet xml:lang="en-US"><tig><term>They walked over a pavement of the same green marble, and where the blocks were joined together were rows of emeralds, set closely, and glittering in the brightness of the sun.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏄ ᎡᎳᏗ ᎤᏂᎩᏒᎢ ᎠᏓᏬᎯᎳᏗᏍᎬ Ꭰ ᎠᏰᏍᏛᏗ ᎾᎿ ᏥᎩ ᎤᏠᏱ ᎢᏤᏳᏍᏗ ᎦᏓᏲᏍᏗ, ᎠᎴ ᎭᏢᏃ ᏥᎩ ᏍᏆᎳ ᏗᏍᏆᎵᏛ ᎨᏒᎩ ᎤᎾᏖᎳᏛᎩ ᎡᏧᎳᎭᎢ ᎨᏒᎩ ᎤᏓᏅᏅ ᎾᎿ ᎠᏕᎳᏗᏣᏅᏙᏗ, ᎦᎧᎲᎢ ᎾᎥᏂᎨᎢ, ᎠᎴ ᎠᏓᏪᎳᎩᏍᎬ ᎾᎿ ᏥᎩ ᎤᏍᎪᏍᏗᏴ ᎾᎿ ᏥᎩ ᏅᏙ ᎢᎦ ᎡᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="App data can be any data that an app has saved (based on developer settings), including potentially sensitive data such as contacts, messages, and photos.">
                <langSet xml:lang="en-US"><tig><term>App data can be any data that an app has saved (based on developer settings), including potentially sensitive data such as contacts, messages, and photos.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰpp ᏓᏔ cᎠn bᎡ Ꭰny ᏓᏔ tᎭt Ꭰn Ꭰpp ᎭᏍ ᏌᎥᎡd (bᎠᏎd Ꭳn ᏕᎥᎡᎶpᎡr ᏎtᏘngᏍ), ᎢncᎷᏗng pᎣᏖnᏘᎠlly ᏎnᏏᏘᎥᎡ ᏓᏔ Ꮡch ᎠᏍ cᎣnᏔctᏍ, ᎺᏍᏌᎨᏍ, Ꭰnd pᎰtᎣᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No video chat apps">
                <langSet xml:lang="en-US"><tig><term>No video chat apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏱᏄᏍᏓ ᎠᏓᏴᎳᏛᏍᎩ ᏗᏟᏃᎮᏗ ᏗᎬᏙᏗ </term></tig></langSet>
            </termEntry>
