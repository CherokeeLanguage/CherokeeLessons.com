                <langSet xml:lang="en-US"><tig><term>Emergency Dialpad</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎺrᎨncy ᏗᎠlpᎠd</term></tig></langSet>
            </termEntry>
