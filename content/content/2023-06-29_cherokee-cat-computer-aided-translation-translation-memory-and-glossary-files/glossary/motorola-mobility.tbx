            </termEntry>
            <termEntry id="Expires at ">
                <langSet xml:lang="en-US"><tig><term>Expires at </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎶᏐᏅᎢ ᎾᎯᏳᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="There are no leases acquired for this shared data.">
                <langSet xml:lang="en-US"><tig><term>There are no leases acquired for this shared data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ Ꮭ ᏗᏓᏙᎳᏍᏙᏗ ᎠᎩᏓ ᎾᏍᎩᎾ ᎯᎠ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lease expires at ">
                <langSet xml:lang="en-US"><tig><term>Lease expires at </term></tig></langSet>
