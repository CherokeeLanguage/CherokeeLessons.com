                <langSet xml:lang="chr"><tig><term>ᏰᎵᏇ ᎱᏓᎳᎩ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎫᏓᎸᏅᎯ ᎾᎿ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The device switches automatically to a cellular network (2G/3G) to proceed with a USSD service request.">
                <langSet xml:lang="en-US"><tig><term>The device switches automatically to a cellular network (2G/3G) to proceed with a USSD service request.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎦᏁᏟᏴᏍᏗ ᎾᎿᎢ ᏫᏚᏍᏗᎬᎢ ᎤᏚᏓᎵ (2G/3G) ᎾᎿᎢ ᎠᎯᎸᏍᏗ ᎬᏗ USSD ᎢᏯᏓᏛᏁᏗ ᎠᏔᏲᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To view this information now, go to https://www.motorola.com/terms from any computer connected to the Internet.">
                <langSet xml:lang="en-US"><tig><term>To view this information now, go to https://www.motorola.com/terms from any computer connected to the Internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᎧᏃᏗ ᎯᎠ ᎧᏃᎮᏢᏗ Ꭷ, ᏤᏅᏍᏗ https://www.motorola.com/terms ᏅᏓᏳᏓᎴᏅᎯ ᎾᏂᎥᏉ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎫᏓᎸᎢ ᎾᎿᎢ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto join">
                <langSet xml:lang="en-US"><tig><term>Auto join</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ ᎠᏖᎳᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="System functions and applications need enough storage space to work, please free up some space.">
                <langSet xml:lang="en-US"><tig><term>System functions and applications need enough storage space to work, please free up some space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏧᏂᎸᏫᏍᏓᏁᏗᏱ ᏃᎴ ᏗᏔᏲᏍᏙᏗ ᏗᎪᏪᎵ ᎤᏚᎸᏓ ᏰᎵᏉ ᎠᏍᏆᏂᎪᏙᏗ ᎤᏜᏅᏛᎯ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ, ᎰᏩᏊ ᏚᏓᎴᎩ ᎢᎦᏓ ᎤᏜᏅᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically configure the best refresh rate according to usage scenario.">
                <langSet xml:lang="en-US"><tig><term>Automatically configure the best refresh rate according to usage scenario.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᎵᏍᏙᏗ ᎨᏒ ᏅᎦ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏫᏓᏤᏢ ᎯᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ ᏂᎬᏅ ᎾᎿᎢ ᎬᏙᏗᎢ ᏧᏓᎴᏅᏓ ᎢᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smoother, but consumes more power.">
                <langSet xml:lang="en-US"><tig><term>Smoother, but consumes more power.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏫᏍᎦᎨ, ᎠᏎᏃ ᎤᏩᏍᎩ ᎤᏟ ᎢᎦᎢ ᎤᏟᏂᎩᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A higher screen refresh rate will bring a smoother visual experience, but will consume more power.">
                <langSet xml:lang="en-US"><tig><term>A higher screen refresh rate will bring a smoother visual experience, but will consume more power.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎯᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ ᎡᎯᏳᎦ ᏓᏫᏍᎦᎨ ᏓᏟᎶᏍᏛ ᏄᎵᏍᏔᏂᏙᎸᎢ, ᎠᏎᏃ ᎤᏩᏍᎩ ᎤᏟ ᎢᎦᎢ ᎤᏟᏂᎩᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try another one.">
                <langSet xml:lang="en-US"><tig><term>Please try another one.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎭᏁᎵᏓ ᏄᏓᎴ ᏌᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Adjust your finger position to register the edges of your fingerprint">
                <langSet xml:lang="en-US"><tig><term>Adjust your finger position to register the edges of your fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᎩ ᎦᏰᏌᏛ ᎦᎪᏗ ᏚᏙᎥ ᎤᏬᏪᎶᏗ ᎠᏍᏛᎢ ᎾᎿ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to restore camera default settings?">
                <langSet xml:lang="en-US"><tig><term>Do you want to restore camera default settings?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎪᏢᎯᏐᏗ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ?</term></tig></langSet>
