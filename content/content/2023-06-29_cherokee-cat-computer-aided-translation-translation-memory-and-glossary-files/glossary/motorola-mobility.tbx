                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᏧᏓᎴᏅᏓ ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎠᏐᎥᏍᏗᏍᎬ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Channel Closed">
                <langSet xml:lang="en-US"><tig><term>Channel Closed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎳᏅᏛ ᎠᏍᏚᏅᎩ</term></tig></langSet>
