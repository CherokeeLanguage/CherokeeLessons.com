            </termEntry>
            <termEntry id="Open in  in personal profile?">
                <langSet xml:lang="en-US"><tig><term>Open in  in personal profile?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎾᎿ  ᎾᎿ ᎤᏩᏌ ᎤᏤᎵ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ?</term></tig></langSet>
            </termEntry>
