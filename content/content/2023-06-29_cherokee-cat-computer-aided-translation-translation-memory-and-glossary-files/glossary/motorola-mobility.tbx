            </termEntry>
            <termEntry id="Monitor the number of incorrect passwords typed when unlocking the screen, and lock the tablet or erase all this user's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed when unlocking the screen, and lock the tablet or erase all this user's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎵᏛᏍᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎾᏍᎩ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᏗᏐᏅᏍᏔᏅᎯ ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏰᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᏍᎩ ᎪᏪᎶᏙᏗᎢ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᎯᎠ ᎬᏗᏍᎩ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏳᏃ ᎤᎪᏗᏗ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᎾᏍᎩ ᏗᏐᏅᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data warning">
                <langSet xml:lang="en-US"><tig><term>Data warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="App is not available">
                <langSet xml:lang="en-US"><tig><term>App is not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎭᏗ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify your tablet's call log, including data about incoming and outgoing calls. Malicious apps may use this to erase or modify your call log.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify your tablet's call log, including data about incoming and outgoing calls. Malicious apps may use this to erase or modify your call log.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏍᏆᎳ ᎢᎬᏁᏗ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᏪᏯᎾ ᎸᏛᏁᎸ ᎪᏪᎳᏅᎢ, ᎠᏠᏯᏍᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎢᎸᏨ ᎦᎷᎦ ᏃᎴ ᎦᏅᎪᏫᏛ ᏓᏯᏂ. ᎤᏁᎫᏣᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎬᏔᏂᏓᏍᏗ ᎯᎠ ᎾᎿᎢ ᏛᏍᏍᎪᎸᏥ ᏃᎴ ᎢᎬᏁᏗ ᏂᏨᎤᎢ ᏪᏯᎾ ᎸᏛᏁᎸ ᎪᏪᎳᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network subset service provider unlock request unsuccessful.">
                <langSet xml:lang="en-US"><tig><term>Network subset service provider unlock request unsuccessful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ ᎭᏫᏂᏗᏢ ᎦᎧᎲᎢ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎦᏐᎭᎾᎳᎩᏍᏗ ᎠᏔᏲᎯᎭ ᎤᏓᏄᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data is paused">
                <langSet xml:lang="en-US"><tig><term>Data is paused</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᏲᎯᏍᏔᏅ</term></tig></langSet>
            </termEntry>
