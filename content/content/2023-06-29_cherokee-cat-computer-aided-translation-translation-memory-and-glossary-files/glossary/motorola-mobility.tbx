            <termEntry id="On -  app has access to location">
                <langSet xml:lang="en-US"><tig><term>On -  app has access to location</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿᎢ -  ᎬᏙᏗ ᏂᏚᏩᎿ ᎠᏴᏍᏗ ᎾᎿᎢ ᎤᎿ ᎢᎬᎾᏕᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Location access is off for apps and services.">
                <langSet xml:lang="en-US"><tig><term>Location access is off for apps and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿ ᎢᎬᎾᏕᎾ ᎠᏴᏍᏗ ᏄᏍᏛ ᎠᏍᏚᎭ ᎤᎬᏩᏟ ᏗᎬᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For music and media">
                <langSet xml:lang="en-US"><tig><term>For music and media</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏗᎧᏃᎩᏙᏗ ᎠᎴ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Add another">
                <langSet xml:lang="en-US"><tig><term>Add another</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏗ ᏄᏓᎴ</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete screen lock?">
                <langSet xml:lang="en-US"><tig><term>Delete screen lock?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᎠᏴᏙᎳᏛᎢ ᏓᎩᏍᏏ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Device encrypted">
                <langSet xml:lang="en-US"><tig><term>Device encrypted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏕᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device location may still be sent to emergency responders when you call or text an emergency number.">
                <langSet xml:lang="en-US"><tig><term>Your device location may still be sent to emergency responders when you call or text an emergency number.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎿ ᎢᎬᎾᏕᎾ ᏰᎵᏉ ᎠᏏᏉ ᎨᏒᎩ ᏭᏅᏅᎢ ᎾᎿᎢ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎦᏬᎯᎵᏴᏍᏗ ᎢᏳᏃ ᏂᎯ ᏪᏯᎾ ᎠᎴ ᎪᏪᎳᏅᎢ Ꭰ ᎤᎵᏍᎨᏛ ᎠᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone not encrypted">
                <langSet xml:lang="en-US"><tig><term>Phone not encrypted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎥᏝ ᎠᏕᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="You may enable the required permissions in App Info.">
                <langSet xml:lang="en-US"><tig><term>You may enable the required permissions in App Info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏉ ᏳᎵᏍᏙᏗ Ꮎ ᎢᏯᏛᏁᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎲ ᎾᎿᎢ ᎬᏙᏗ ᎣᏃᎮᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you eject this ^1, apps stored on it will stop working, and media files stored on it will not be available until it is reinserted.This ^1 is formatted to work on this device only. It won\u2019t work on any others.">
                <langSet xml:lang="en-US"><tig><term>When you eject this ^1, apps stored on it will stop working, and media files stored on it will not be available until it is reinserted.This ^1 is formatted to work on this device only. It won\u2019t work on any others.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏓᏄᎪᏫᏍᏗ ᎯᎠ ^1, ᏗᎬᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᎨᎡᎢ ᎠᏎ ᎭᎴᏫᏍᏓ ᏗᎦᎸᏫᏍᏓᏁᎢ, ᏃᎴ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᎨᎡᎢ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎩᎳ ᎨᎡᎢ ᎪᏣᎸᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ.ᎯᎠ ^1 ᎨᎡᎢ ᎪᏢᏅᎯ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏅᏒ. ᎨᎡᎢ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎿᎢ ᎾᏂᎥᏉ ᏐᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set data usage limit">
                <langSet xml:lang="en-US"><tig><term>Set data usage limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can access data in your personal  app.">
                <langSet xml:lang="en-US"><tig><term>This app can access data in your personal  app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎠᏴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿᎢ ᏣᏤᎵ ᎠᏏᏴᏫ  ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="How to set up Face Unlock">
                <langSet xml:lang="en-US"><tig><term>How to set up Face Unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎡᎵ ᎾᎿᎢ ᏘᎧᎲᎦ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set My Location, screen unlock, SIM card lock, credential storage lock">
                <langSet xml:lang="en-US"><tig><term>Set My Location, screen unlock, SIM card lock, credential storage lock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ My ᎤᎿ ᎢᎬᎾᏕᎾ, ᎠᏴᏙᎳᏛᎢ ᎠᏂᏐᎭᎾᎳᎩ, SIM ᏆᎾᏲᏍᏗ ᏍᏓᏱ, ᎠᏍᏆᏂᎪᏙᏗ ᎠᏍᏆᏂᎪᏙᏗ ᏍᏓᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Security status">
                <langSet xml:lang="en-US"><tig><term>Security status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎦᏎᏍᏗ ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your apps are using a normal amount of battery.">
                <langSet xml:lang="en-US"><tig><term>Your apps are using a normal amount of battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr ᎠppᏍ ᎠrᎡ ᎤᏏng Ꭰ ᏃrᎹl ᎠᎼᎤnt Ꭳf bᎠtᏖry.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lift finger, then touch sensor again">
                <langSet xml:lang="en-US"><tig><term>Lift finger, then touch sensor again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎳᏙᏗ ᎦᏰᏌᏛ, ᎿᏉᏃ ᎠᏒᏂᏍᏗ ᎠᏩᏘᏍᎩ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Activating visual voicemail">
                <langSet xml:lang="en-US"><tig><term>Activating visual voicemail</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᎩᏍᏗᏍᎩ ᏓᏟᎶᏍᏛ ᎧᏁᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set My Location, screen unlock, credential storage lock">
                <langSet xml:lang="en-US"><tig><term>Set My Location, screen unlock, credential storage lock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ My ᎤᎿ ᎢᎬᎾᏕᎾ, ᎠᏴᏙᎳᏛᎢ ᎠᏂᏐᎭᎾᎳ, ᎠᏍᏆᏂᎪᏙᏗ ᏍᏓᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use hotspot and tethering to provide internet to other devices through your mobile data connection.">
                <langSet xml:lang="en-US"><tig><term>Use hotspot and tethering to provide internet to other devices through your mobile data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎠᎴ ᏗᎵᎪᏙᏗ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᎠᏏᎳᏕᏫᏒᎢ ᎾᎿᎢ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎦᏛᎴᏍᎩ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose how long to show messages that ask you to take action, but are visible only temporarily.">
                <langSet xml:lang="en-US"><tig><term>Choose how long to show messages that ask you to take action, but are visible only temporarily.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎰᎣᏎ Ꮀw Ꮆng tᎣ ᏍᎰw ᎺᏍᏌᎨᏍ tᎭt ᎠᏍk ᏲᎤ tᎣ ᏔkᎡ ᎠcᏘᎣn, bᎤt ᎠrᎡ ᎥᎢᏏbᎴ Ꭳnly ᏖmpᎣrᎠrᎢly.</term></tig></langSet>
            </termEntry>
            <termEntry id="Face Unlock for work">
                <langSet xml:lang="en-US"><tig><term>Face Unlock for work</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳ for ᏗᎦᎸᏫᏍᏓᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile packets sent">
                <langSet xml:lang="en-US"><tig><term>Mobile packets sent</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏇᏅᎯ ᏭᏅᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Improve phone's battery life">
                <langSet xml:lang="en-US"><tig><term>Improve phone's battery life</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎦᏤᎳᏍᏙᏗ ᏗᏟᏃᎮᏗ ᎠᎾᎦᎵᏍᎩ ᎬᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press Power &amp; Volume Up together to">
                <langSet xml:lang="en-US"><tig><term>Press Power &amp; Volume Up together to</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎤᏟᏂᎩᏓ &amp; ᎤᏃᏴᎬᎢ ᎦᎸᎳᏗ ᎡᏧᎳᎭᎢ ᎾᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face added">
                <langSet xml:lang="en-US"><tig><term>Face added</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᎧᏁᏉᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can add up to  fingerprints">
                <langSet xml:lang="en-US"><tig><term>You can add up to  fingerprints</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏗᎧᏁᏉᏍᏗ ᎦᎸᎳᏗ ᎾᎿᎢ  ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to set up face">
                <langSet xml:lang="en-US"><tig><term>Tap to set up face</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᏘᎧᎲᎦ ᎧᏁᏉᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen lock, Find My Device, app security">
                <langSet xml:lang="en-US"><tig><term>Screen lock, Find My Device, app security</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᏍᏓᏱ, ᎠᏩᏛᏗ ᎠᏯ ᏥᏂᎬᏅᏗᏓᎾ, ᎬᏙᏗ ᎤᎦᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When Battery Saver is on, a 60Hz refresh rate will be used.">
                <langSet xml:lang="en-US"><tig><term>When Battery Saver is on, a 60Hz refresh rate will be used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎠᏍᏚᎢᏗ ᏱᎩ, 60ᎻᏃ ᎯᏤᎲᏍᏗᏍᎬᎢ ᎠᎦᏈᏴᏒᎲᎢ ᏓᎬᏛᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="If accessibility Face Unlock is turned off, some setup steps may not work properly with TalkBack.">
                <langSet xml:lang="en-US"><tig><term>If accessibility Face Unlock is turned off, some setup steps may not work properly with TalkBack.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏴᏍᏗ ᎨᏒᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳ ᎠᏍᏚᏗ, ᎢᎦᏓ ᏘᎧᎲᎦ ᏓᎳᏍᎬᏎᎬ ᏰᎵᏉ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᏙᎳᏤᎩ ᎬᏗ TalkBack.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use accessibility setup">
                <langSet xml:lang="en-US"><tig><term>Use accessibility setup</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎬᏴᏍᏗ ᎨᏒᎢ ᏘᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Glance brings stunning wallpapers and latest trends from the world of entertainment, news and sports straight to your lockscreen.">
                <langSet xml:lang="en-US"><tig><term>Glance brings stunning wallpapers and latest trends from the world of entertainment, news and sports straight to your lockscreen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Glance ᎠᏂᏲᎯᎭ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ ᎠᎴ ᎢᏤᎯᎨᎢᏍᏗ ᏕᎦᎶᏎᎬ ᎾᏍᎩᎾ ᎡᎶᎯ ᎤᎾᏛᏁᎸᏗ, ᎧᏃᎮᏓ ᎠᎴ ᏗᎾᎳᏍᎦᎵᏍᎩ ᎦᏥᏃᏍᏓ ᎾᎿ ᏣᏤᎵ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Prevent ringing">
                <langSet xml:lang="en-US"><tig><term>Prevent ringing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏗ ᎤᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shortcut to prevent ringing">
                <langSet xml:lang="en-US"><tig><term>Shortcut to prevent ringing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏳᎪᏗᏊ ᎾᎿᎢ ᎠᎴᏫᏍᏙᏗ ᎤᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your face to unlock your phone, authorize purchases, or sign in to apps.">
                <langSet xml:lang="en-US"><tig><term>Use your face to unlock your phone, authorize purchases, or sign in to apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ, ᎠᎵᏍᎪᏟᏙᏗᎢ ᏗᏩᎯᏍᏗ, ᎠᎴ ᏚᏙᎥ ᎪᏪᎶᏗ ᎾᎿᎢ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Double press power key">
                <langSet xml:lang="en-US"><tig><term>Double press power key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵᏳᏩᎪᏗ ᎭᏐᏅᏍᏓ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow face unlock">
                <langSet xml:lang="en-US"><tig><term>Allow face unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do nothing">
                <langSet xml:lang="en-US"><tig><term>Do nothing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎿᏛᎦ ᎥᏝ ᎪᎱᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Could not connect to printer">
                <langSet xml:lang="en-US"><tig><term>Could not connect to printer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎣᎤld Ꮓt cᎣnᏁct tᎣ prᎢnᏖr</term></tig></langSet>
            </termEntry>
            <termEntry id="This deletes the fingerprint images and model associated with '' that are stored on your device">
                <langSet xml:lang="en-US"><tig><term>This deletes the fingerprint images and model associated with '' that are stored on your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏍᎪᎸᏗᏍᏗ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏚᏓᏴᎳᏛ ᎠᎴ ᎪᎱᏍᏗ ᎪᏢᏅ ᏚᎵᎪᏒᎢ ᎬᏗ '' ᎥᏍᎩᎾ ᎨᏒᎢ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier video">
                <langSet xml:lang="en-US"><tig><term>Carrier video</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏫᏗᏍᎩ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="minutes">
                <langSet xml:lang="en-US"><tig><term>minutes</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏔᏬᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="To enable, first change &quot;Press and hold power button&quot; to the power menu.">
                <langSet xml:lang="en-US"><tig><term>To enable, first change "Press and hold power button" to the power menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ, ᎢᎬᏱ ᎦᏁᏟᏴᏍᏗ "ᎭᏐᎥᏍᏓ ᎠᎴ ᎯᏂᏯ ᎤᏟᏂᎩᏓ ᎠᏐᏅᏍᏙᏗ" ᎾᎿᎢ ᏥᎩ ᎤᏟᏂᎩᏓ ᎪᏪᎳᎾᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can\u2019t connect to this network right now.">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t connect to this network right now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏰᎵ ᏗᎵᎪᏙᏗ ᎯᎠ ᏧᎾᏚᏓᎵ ᎠᎭᏂ ᏃᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In range">
                <langSet xml:lang="en-US"><tig><term>In range</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎢᎬᎾᏕᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Improve Face Unlock performance">
                <langSet xml:lang="en-US"><tig><term>Improve Face Unlock performance</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎦᏤᎳᏍᏙᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ ᎾᎾᏛᏁᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow your child to use their face to unlock their phone or verify it\u2019s them.">
                <langSet xml:lang="en-US"><tig><term>Allow your child to use their face to unlock their phone or verify it\u2019s them.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᏨᎤᎢ ᎠᏲᎵ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎤᎾᏤᎵ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎤᎾᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ ᎰᎯᏳᏓ ᎾᏍᎩ ᎢᏯᏂᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete broadcast">
                <langSet xml:lang="en-US"><tig><term>Delete broadcast</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᎠᏗᎦᎴᏯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This happens when they sign in to apps, approve a purchase, and more.">
                <langSet xml:lang="en-US"><tig><term>This happens when they sign in to apps, approve a purchase, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏂᏚᎵᏍᏔᏅ ᎢᏳᏃ ᏧᏄ ᏚᏙᎥ ᎪᏪᎶᏗ ᎾᎿᎢ ᏗᎬᏙᏗ, ᎪᎯᏳᏙᏗ Ꭰ ᎠᏩᎯᏍᏗ, ᎠᎴ ᎤᎪᏗᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your face to unlock your phone, authorize purchases, or sign in to apps">
                <langSet xml:lang="en-US"><tig><term>Use your face to unlock your phone, authorize purchases, or sign in to apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ, ᎠᎵᏍᎪᏟᏙᏗᎢ ᏗᏩᎯᏍᏗ, ᎠᎵ ᏚᏙᎥ ᎪᏪᎶᏗ ᎾᎿᎢ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Center your face in the circle">
                <langSet xml:lang="en-US"><tig><term>Center your face in the circle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᏟ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎤᎿ ᏥᎩ ᎦᏐᏆᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Could not connect to ">
                <langSet xml:lang="en-US"><tig><term>Could not connect to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎱᏓᎸᎥᎦ </term></tig></langSet>
            </termEntry>
            <termEntry id="Note: You can\u2019t use your face to unlock this device.">
                <langSet xml:lang="en-US"><tig><term>Note: You can\u2019t use your face to unlock this device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏗ ᎪᏪᎸ: ᏂᎯ ᏝᏰᎵ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connects via Wi-Fi Direct">
                <langSet xml:lang="en-US"><tig><term>Connects via Wi-Fi Direct</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎣnᏁctᏍ ᎥᎢᎠ Ꮻ-FᎢ ᏗrᎡct</term></tig></langSet>
            </termEntry>
            <termEntry id="Face only">
                <langSet xml:lang="en-US"><tig><term>Face only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᎤᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Location time zone detection changes are not allowed">
                <langSet xml:lang="en-US"><tig><term>Location time zone detection changes are not allowed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿ ᎢᎬᎾᏕᎾ ᎠᏥᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ ᏚᎾᏄᎪᏫᏍᏒᎢ ᏗᎦᏁᏟᏴᏓ ᎨᎡᎩ ᎥᏝ ᎠᎵᏍᎪᎸᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Alert details">
                <langSet xml:lang="en-US"><tig><term>Alert details</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᏎᎯ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Saved printers">
                <langSet xml:lang="en-US"><tig><term>Saved printers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᎥᎡd prᎢnᏖrᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you set up face and fingerprint unlock, your phone will ask for your fingerprint when you wear a mask or are in a dark area">
                <langSet xml:lang="en-US"><tig><term>When you set up face and fingerprint unlock, your phone will ask for your fingerprint when you wear a mask or are in a dark area</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎦᎧᎲᏍᎬᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎠᎴ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏂᏐᎭᎾᎳᎩ, ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎠᏓᏛᏗ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎢᏳᏃ ᏂᎯ ᎠᎾᏬᏍᏗ Ꭰ ᎠᎵᎬᏚᎶᏗ ᎠᎴ ᎨᏒᎢ ᎾᎿ Ꭰ ᎤᎵᏏᎩ ᎢᎬᎾᏕᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Encrypted">
                <langSet xml:lang="en-US"><tig><term>Encrypted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connects via current network at ">
                <langSet xml:lang="en-US"><tig><term>Connects via current network at </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎣnᏁctᏍ ᎥᎢᎠ cᎤrrᎡnt ᏁtᏬrk Ꭰt </term></tig></langSet>
            </termEntry>
            <termEntry id="Looking good.">
                <langSet xml:lang="en-US"><tig><term>Looking good.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏍᎬ ᎣᏏᏳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data:">
                <langSet xml:lang="en-US"><tig><term>Data:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Always require confirmation">
                <langSet xml:lang="en-US"><tig><term>Always require confirmation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᎠᏎᏯᏛᏁᏗ ᎦᎫᏍᏛᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete your current face model to set up Face Unlock again.">
                <langSet xml:lang="en-US"><tig><term>Delete your current face model to set up Face Unlock again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎾᎿᎢ ᏘᎧᎲᎦ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use face or fingerprint for">
                <langSet xml:lang="en-US"><tig><term>Use face or fingerprint for</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎠᎴ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your face model will be permanently and securely deleted.">
                <langSet xml:lang="en-US"><tig><term>Your face model will be permanently and securely deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᎠᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Improve security and performance">
                <langSet xml:lang="en-US"><tig><term>Improve security and performance</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎦᏤᎳᏍᏙᏗ ᎤᎦᏎᏍᏗ ᎠᎴ ᎾᎾᏛᏁᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Default Print Service provides basic options.">
                <langSet xml:lang="en-US"><tig><term>The Default Print Service provides basic options.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮ ᏕfᎠᎤlt PrᎢnt ᏎrᎥᎢcᎡ prᎣᎥᎢᏕᏍ bᎠᏏc ᎣpᏘᎣnᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Encryption">
                <langSet xml:lang="en-US"><tig><term>Encryption</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete your current face model to set up Face Unlock again.">
                <langSet xml:lang="en-US"><tig><term>Delete your current face model to set up Face Unlock again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎾᎿᎢ ᏘᎧᎲᎦ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use hotspot and tethering to provide internet to other devices through your Wi\u2011Fi or mobile data connection.">
                <langSet xml:lang="en-US"><tig><term>Use hotspot and tethering to provide internet to other devices through your Wi\u2011Fi or mobile data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎠᎴ ᏗᎵᎪᏙᏗ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᎠᏏᎳᏕᏫᏒᎢ ᎾᎿᎢ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎦᏛᎴᏍᎩ ᏂᏨᎤᎢ Wi\u2011Fi ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Other options for this printer may be available from another print service.">
                <langSet xml:lang="en-US"><tig><term>Other options for this printer may be available from another print service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣtᎮr ᎣpᏘᎣnᏍ fᎣr tᎯᏍ prᎢnᏖr Ꮉy bᎡ ᎠᎥᎠᎢᎳbᎴ frᎣm ᎠᏃtᎮr prᎢnt ᏎrᎥᎢcᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After you encrypt your tablet, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the tablet every time you power it on.">
                <langSet xml:lang="en-US"><tig><term>After you encrypt your tablet, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the tablet every time you power it on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᏂᎯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ, ᏃᎵᏍᎬᎢ ᏂᎯ\u2019ve ᏘᎧᎲᎦ Ꭰ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ (ᎥᏍᎩᎾ, Ꭰ ᎤᎾᎶᎢᏓ ᎠᎴ ᏗᏎᏍᏙᏗ PIN ᎠᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ), ᏂᎯ\u2019ll ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᏂᎪᎯᎸ ᏂᎯ ᎤᏟᏂᎩᏓ ᎾᎿ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Android version">
                <langSet xml:lang="en-US"><tig><term>Android version</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android ᏄᏓᎴᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Require eyes to be open">
                <langSet xml:lang="en-US"><tig><term>Require eyes to be open</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᏗᎦᏙᎵ ᎾᎿᎢ ᎯᏍᏚᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To unlock the phone, your eyes must be open">
                <langSet xml:lang="en-US"><tig><term>To unlock the phone, your eyes must be open</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏗᏟᏃᎮᏗ, ᏂᏨᎤᎢ ᏗᎦᏙᎵ ᎠᏎᎢ ᎯᏍᏚᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device name is visible to apps on your phone.">
                <langSet xml:lang="en-US"><tig><term>Your device name is visible to apps on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏚᏅᏙᎥ ᏄᏍᏛ ᎬᏩᏂᎪᏩᏛᏗ ᎾᎿᎢ ᏗᎬᏙᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It may also be seen by other people when you connect to Bluetooth devices, connect to a Wi-Fi network or set up a Wi-Fi hotspot.">
                <langSet xml:lang="en-US"><tig><term>It may also be seen by other people when you connect to Bluetooth devices, connect to a Wi-Fi network or set up a Wi-Fi hotspot.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏰᎵᏯ ᎾᏍᏊ ᎨᎡᎩ ᎠᎪᎲᎩ ᎬᏗ ᏐᎢ ᎠᏂᏴᏫ ᎢᏳᏃ ᏂᎯ ᎫᏓᎸᎢ ᎾᎿᎢ Bluetooth ᏥᏂᎬᏅᏗᏓᎾ, ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᏧᎾᏚᏓᎵ ᎠᎴ ᎦᎧᎲᏍᎬᎢ Ꭰ Wi-Fi ᎤᏗᏞᎩ ᎤᏓᏓᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Devices">
                <langSet xml:lang="en-US"><tig><term>Devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device protection features won\u2019t be turned on.">
                <langSet xml:lang="en-US"><tig><term>Device protection features won\u2019t be turned on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᏗᎦᏎᏍᏙᏗ ᏂᎨᏒᎾ ᎯᏍᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A pattern is required to set up Face Unlock.">
                <langSet xml:lang="en-US"><tig><term>A pattern is required to set up Face Unlock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎤᎾᎶᎢᏓ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="All Settings">
                <langSet xml:lang="en-US"><tig><term>All Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>All ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Requires  SIM to connect">
                <langSet xml:lang="en-US"><tig><term>Requires  SIM to connect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏳᎾᏛᏁᏗ  SIM ᎾᎿᎢ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This service is malfunctioning.">
                <langSet xml:lang="en-US"><tig><term>This service is malfunctioning.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᎾᏓᏍᏕᎸᏗ ᎨᏒᎢ ᎢᏳᏩᏂᏌᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Too many incorrect attempts.">
                <langSet xml:lang="en-US"><tig><term>Too many incorrect attempts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏍᏈᏯ ᏂᏚᏳᎪᏛᎾ ᎠᏁᏗᏍᎪᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose the screen lock you want to use.">
                <langSet xml:lang="en-US"><tig><term>Choose the screen lock you want to use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᏓᎩᏍᏏ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t find networks.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t find networks.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎬᏩᏛᏗ ᏱᎩ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select to install">
                <langSet xml:lang="en-US"><tig><term>Select to install</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏂᎦᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Must contain at least  character">
                <langSet xml:lang="en-US"><tig><term>Must contain at least  character</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎦᎸᏛᎢ ᎦᏲᎵᎨ  ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Higher sensitivity allows you touch contents shown on edges.">
                <langSet xml:lang="en-US"><tig><term>Higher sensitivity allows you touch contents shown on edges.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Higher sensitivity allows you touch contents shown on edges. ᎦᎸᎳᏗ ᎠᏒᏅᏍᏗᎢ ᏱᏨᎵᏍᎪᎵᏓᏏ ᎠᏒᎾᏍᏗ ᏕᎦᎸᏛᎢ ᎤᎾᏓᏎᎮᎸᎩ ᏗᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Maximum connected Bluetooth audio devices">
                <langSet xml:lang="en-US"><tig><term>Maximum connected Bluetooth audio devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨ ᎫᏓᎸᏅᎯ Bluetooth ᎤᏃᏴᎬ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Requires SIM to connect">
                <langSet xml:lang="en-US"><tig><term>Requires SIM to connect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏳᎾᏛᏁᏗ SIM ᎾᎿᎢ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps can also create a hotspot to share content with nearby devices.">
                <langSet xml:lang="en-US"><tig><term>Apps can also create a hotspot to share content with nearby devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᏰᎴᏯ ᎾᏍᏊ ᎪᏢᏗ Ꭰ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏄᏍᏗᏓᏅ ᎬᏗ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't Miss Out!">
                <langSet xml:lang="en-US"><tig><term>Don't Miss Out!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᎦᏅᏗᏍᏗ ᎦᏅᎪᏫᏛ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on NFC">
                <langSet xml:lang="en-US"><tig><term>Turn on NFC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ NFC</term></tig></langSet>
            </termEntry>
            <termEntry id="Require device unlock for NFC">
                <langSet xml:lang="en-US"><tig><term>Require device unlock for NFC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏂᏐᎭᎾᎳᎩ ᎤᎬᏩᏟ NFC</term></tig></langSet>
            </termEntry>
            <termEntry id="The only other way to decrypt is to perform a factory data reset, erasing all your data.">
                <langSet xml:lang="en-US"><tig><term>The only other way to decrypt is to perform a factory data reset, erasing all your data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎤᏅᏒ ᏐᎢ ᏳᎵᏍᏙᏗ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏄᏍᏛ ᎾᎿᎢ ᏱᏣᏛᏁᏗ Ꭰ ᎤᏃᏢᏅᏗ ᎦᏟᏌᏅᎯ ᎢᎦᎧᎯᎲᏍᏗ, ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᏂᏨᎤᎢ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show refresh rate">
                <langSet xml:lang="en-US"><tig><term>Show refresh rate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎯᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Uninstall finished">
                <langSet xml:lang="en-US"><tig><term>Uninstall finished</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏆᏓ ᎠᎯᏘᏅᏓᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id=" wants to access your contacts and call history.">
                <langSet xml:lang="en-US"><tig><term> wants to access your contacts and call history.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᎠᎵ ᏪᏯᎾ ᏂᏧᎵᏍᏔᏅᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show the current display refresh rate">
                <langSet xml:lang="en-US"><tig><term>Show the current display refresh rate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ the ᏃᏊ ᏥᎩ ᎠᏓᏴᎳᏔᏍᎩ ᏤᎲᏍᏓ ᎠᎦᏈᏴᎡᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Lower sensitivity can prevent unintended falsing touch on edges when you simply hold phone with hands">
                <langSet xml:lang="en-US"><tig><term>Lower sensitivity can prevent unintended falsing touch on edges when you simply hold phone with hands</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Lower sensitivity can prevent unintended falsing touch on edges when you simply hold phone with hands ᎡᎳᏗᏝ ᎠᏒᏅᏍᏗᎢ ᏴᎵᏍᎪᎵᏗ ᏂᏣᏚᎵᎲᎾ ᏱᎩ ᎠᏒᏅᏍᏗ ᎠᏍᏛᎢ ᎯᏱᏙᎲ ᏗᏝᏃᎮᏗᎢ ᏦᏰᏂ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth">
                <langSet xml:lang="en-US"><tig><term>Bluetooth</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>BluetoothᎧᏁᎦ ᏴᏛᏁ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow incoming file transfers">
                <langSet xml:lang="en-US"><tig><term>Allow incoming file transfers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎦᎷᎦ ᎠᏍᏆᏂᎪᏙᏗ ᏙᏓᏰᏣᏲᎯᏎᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Verify bytecode of debuggable apps">
                <langSet xml:lang="en-US"><tig><term>Verify bytecode of debuggable apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎰᎯᏳᏓ ᏆᏱᏘ ᎠᏍᏓᏩᏛᏍᏙᏗ ᎤᎿ ᎯᏩᏔ ᎤᏍᏗᎦᎵᏓᏍᏛ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="5G (recommended)">
                <langSet xml:lang="en-US"><tig><term>5G (recommended)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>5G (ᎦᎸᏉᏔᏅ)</term></tig></langSet>
            </termEntry>
            <termEntry id="6 GHz">
                <langSet xml:lang="en-US"><tig><term>6 GHz</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>6 GHz</term></tig></langSet>
            </termEntry>
            <termEntry id="Use for">
                <langSet xml:lang="en-US"><tig><term>Use for</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ for</term></tig></langSet>
            </termEntry>
            <termEntry id=" wants to turn off Wi-Fi">
                <langSet xml:lang="en-US"><tig><term> wants to turn off Wi-Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎠᏍᏚᏗ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap here to sign in to network">
                <langSet xml:lang="en-US"><tig><term>Tap here to sign in to network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎠᏂ ᎾᎿᎢ ᏚᏙᎥ ᎪᏪᎶᏗ ᎾᎿᎢ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select maximum number of connected Bluetooth audio devices">
                <langSet xml:lang="en-US"><tig><term>Select maximum number of connected Bluetooth audio devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎦᎸᎳᏗᎨ ᎠᏎᏍᏗ of ᎫᏓᎸᏅᎯ Bluetooth ᎤᏃᏴᎬ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your SIM card doesn\u2019t allow a connection to this network.">
                <langSet xml:lang="en-US"><tig><term>Your SIM card doesn\u2019t allow a connection to this network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅ ᎠᏆᏂᏲᏍᏗ Ꮭ ᏯᎵᏍᎪᎸᏗ ᏗᎵᎪᏔᏅᎯ ᎯᎠ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remember settings">
                <langSet xml:lang="en-US"><tig><term>Remember settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏅᏓᏛ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="China Unicom">
                <langSet xml:lang="en-US"><tig><term>China Unicom</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎢᎾ ᏳᏂᎧᎻ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dock Settings">
                <langSet xml:lang="en-US"><tig><term>Dock Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏝᏅᏗᏱ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use  to manage your network connections?">
                <langSet xml:lang="en-US"><tig><term>Use  to manage your network connections?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ  ᎾᎿᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏂᏨᎤᎢ ᏧᎾᏚᏓᎵ ᎫᏓᎸᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="By activating you are agreeing to Glance End User Licensing Agreement and Privacy Policy.">
                <langSet xml:lang="en-US"><tig><term>By activating you are agreeing to Glance End User Licensing Agreement and Privacy Policy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗ ᎤᏂᎩᏍᏗᏍᎩ ᏂᎯ ᎾᏍᎩ ᎪᎯᏳᎲᏍᎦ ᎾᎿ Glance End ᎲᏗᏍᎬ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏓᏓᏁᏤᎸ ᎠᎴ ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try Now">
                <langSet xml:lang="en-US"><tig><term>Try Now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏣᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please insert SIM card and restart">
                <langSet xml:lang="en-US"><tig><term>Please insert SIM card and restart</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎪᏣᎸᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ SIM ᏆᎾᏲᏍᏗ ᎠᎴ ᏥᎭᏂᎩᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disconnect app">
                <langSet xml:lang="en-US"><tig><term>Disconnect app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎱᏓᎳᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please connect to the internet">
                <langSet xml:lang="en-US"><tig><term>Please connect to the internet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎫᏓᎸᎢ ᎾᎿᎢ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You might not receive voicemail notifications until visual voicemail is fully activated.">
                <langSet xml:lang="en-US"><tig><term>You might not receive voicemail notifications until visual voicemail is fully activated.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎢᎵᏊ ᎥᏝ ᎦᏁᏍᏗ ᎧᏁᎬ ᏗᎾᏓᏃᏣᎳᏁᎯ ᎩᎳ ᏓᏟᎶᏍᏛ ᎧᏁᎬ ᎾᎿ ᎠᏂᎧᎵ ᎤᏂᎩᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Color inversion turns light screens dark.">
                <langSet xml:lang="en-US"><tig><term>Color inversion turns light screens dark.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ ᎠᏨᏍᏔᏅᎩ tᎤrnᏍ Ꮅght ᏍcrᎡᎡnᏍ Ꮣrk.</term></tig></langSet>
            </termEntry>
            <termEntry id=" will be disconnected from handsfree audio.">
                <langSet xml:lang="en-US"><tig><term> will be disconnected from handsfree audio.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᏎᏍᏗ ᎱᏓᎳᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏗᎪᏱ ᏗᏣᏲᎯᏍᏗ ᎤᏃᏴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect to Bluetooth device">
                <langSet xml:lang="en-US"><tig><term>Connect to Bluetooth device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎾᎿᎢ Bluetooth ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone will automatically switch to this carrier when in range">
                <langSet xml:lang="en-US"><tig><term>Phone will automatically switch to this carrier when in range</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ ᎯᎠ ᎠᏫᏗᏍᎩ ᎢᏳᏃ ᎾᎿᎢ ᎢᎬᎾᏕᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id=": ">
                <langSet xml:lang="en-US"><tig><term>: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>: </term></tig></langSet>
            </termEntry>
            <termEntry id="Calls preference">
                <langSet xml:lang="en-US"><tig><term>Calls preference</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏯᏂᏍᎬ ᎤᏟ ᎠᏰᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Send reset instructions">
                <langSet xml:lang="en-US"><tig><term>Send reset instructions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᎢᎦᎧᎯᎲᏍᏗ ᏓᏁᏲᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id=" will be disconnected from input device.">
                <langSet xml:lang="en-US"><tig><term> will be disconnected from input device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᏎᏍᏗ ᎱᏓᎳᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏛᏴᎯ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set Wi\u2011Fi data limit">
                <langSet xml:lang="en-US"><tig><term>Set Wi\u2011Fi data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ Wi\u2011Fi ᎦᏟᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="No SIM card available">
                <langSet xml:lang="en-US"><tig><term>No SIM card available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ SIM ᏆᎾᏲᏍᏗ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera permissions">
                <langSet xml:lang="en-US"><tig><term>Camera permissions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can encrypt your accounts, settings, downloaded apps and their data, media, and other files.">
                <langSet xml:lang="en-US"><tig><term>You can encrypt your accounts, settings, downloaded apps and their data, media, and other files.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᏚᏓᎸᏙᏗ, ᏕᎦᎧᎲᎢ, ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏗᎬᏙᏗ ᎠᎴ ᎤᎾᏤᎵ ᎦᏟᏌᏅᎯ, ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ, ᎠᎴ ᏐᎢ ᏗᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="SMS preference">
                <langSet xml:lang="en-US"><tig><term>SMS preference</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SMS ᎤᏟ ᎠᏰᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="SendingMessage may incur charges.">
                <langSet xml:lang="en-US"><tig><term>SendingMessage may incur charges.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎦᏅᎥᏍᎬᎢᏗᎦᏃᏣᎳᏅᎯ may ᏂᏓᏳᏓᎴᏅᏛ ᎬᏂᏗᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There is a problem loading the licenses.">
                <langSet xml:lang="en-US"><tig><term>There is a problem loading the licenses.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿᎢ ᎨᎡᎢ Ꭰ ᏓᏓᎴᎬ ᎦᏢᏍᎬ ᏥᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change this in Bluetooth scanning settings.">
                <langSet xml:lang="en-US"><tig><term>You can change this in Bluetooth scanning settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᎯᎠ ᎾᎿ Bluetooth ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This can be used, for example, to improve location-based features and services.">
                <langSet xml:lang="en-US"><tig><term>This can be used, for example, to improve location-based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏟᎶᏍᏔᎾ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Add a network">
                <langSet xml:lang="en-US"><tig><term>Add a network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏗ Ꭰ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you interrupt it, you\u2019ll lose some or all of your data">
                <langSet xml:lang="en-US"><tig><term>If you interrupt it, you\u2019ll lose some or all of your data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎢᎦᏓ ᎠᎴ ᏂᎦᏓ ᎾᎿ ᏂᏨᎤᎢ ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="To view this information now, go to  from any computer connected to the internet.">
                <langSet xml:lang="en-US"><tig><term>To view this information now, go to  from any computer connected to the internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᎧᏃᏗ ᎯᎠ ᎧᏃᎮᏢᏗ Ꭷ, ᏤᏅᏍᏗ  ᏅᏓᏳᏓᎴᏅᎯ ᎾᏂᎥᏉ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎫᏓᎸᎢ ᎾᎿᎢ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Information sent is not encrypted and may be visible to others.">
                <langSet xml:lang="en-US"><tig><term>Information sent is not encrypted and may be visible to others.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Information sent is not encrypted and may be visible to others. ᎧᏃᎮᏢᏗ ᎠᏓᏅᏒ Ꮭ ᎠᏕᎵᏍᏔᏅ ᏱᎩ ᎠᎴ ᎠᏂᏐᎢ ᏯᏂᎪᏩᏘ</term></tig></langSet>
            </termEntry>
            <termEntry id="To improve device experience, apps and services can still scan for nearby devices at any time, even when Bluetooth is off.">
                <langSet xml:lang="en-US"><tig><term>To improve device experience, apps and services can still scan for nearby devices at any time, even when Bluetooth is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎦᏙᎲᏒ, ᏗᎬᏙᏗ and ᎢᏗᏛᏁᎵᏓᏍᏗ ᏰᎵᏯ ᏙᎢ ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᎤᎬᏩᏟ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ, ᎥᏍᏊ ᎢᏳᏃ Bluetooth ᏄᏍᏛ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
