                <langSet xml:lang="en-US"><tig><term>Quick settings &amp; notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᏣᎳᏁᎯ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can save and share files between your phone and PC.">
                <langSet xml:lang="en-US"><tig><term>You can save and share files between your phone and PC.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏆᏂᎪᏓ ᎠᎴ ᏗᏯᏙᎯᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎤᏜᏅᏛ ᏂᎯᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ PC.</term></tig></langSet>
            </termEntry>
            <termEntry id="After a file is copied, you can save or share it by accessing the copied files icon in the taskbar.">
                <langSet xml:lang="en-US"><tig><term>After a file is copied, you can save or share it by accessing the copied files icon in the taskbar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂ ᎠᏍᏆᏂᎪᏗ ᏱᏓᏟᎶᏍᏔᏅᎯ, ᎯᏍᏆᏂᎪᏓ ᎠᎴ ᏣᏯᎪᎯᏍᏗ ᎬᏗ ᎦᏁᏟᏴᎢ Ꮎ ᏓᏟᎶᏍᏔᏅᎯ ᏗᏍᏆᏂᎪᏙᏗ ᎠᎢᎧᏂ ᎥᎿᎢᎾ ᎢᏯᏛᏁᏗ ᎠᏓᏃᎯᏎᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When the display times out, your phone screen will turn off and your phone will lock.">
                <langSet xml:lang="en-US"><tig><term>When the display times out, your phone screen will turn off and your phone will lock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎠᏓᏴᎳᏔᏍᎩ  ᎠᏎᏒᏓ ᎤᏩᏌᏊᏱᎬᏁᎯ, ᏂᎯᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏛᎵᏍᏚᏂ ᎠᎴ ᏂᎯᏣᏤᎵ ᎠᏐ ᏛᎵᏍᏚᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose a new wallpaper">
                <langSet xml:lang="en-US"><tig><term>Choose a new wallpaper</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎧᏑᎧᏡ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the fingerprint sensor to unlock your phone, authorize purchases, or sign in to apps.">
                <langSet xml:lang="en-US"><tig><term>Touch the fingerprint sensor to unlock your phone, authorize purchases, or sign in to apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ, ᎠᎵᏍᎪᏟᏙᏗᎢ ᏗᏩᎯᏍᏗ, ᎠᎵ ᏚᏙᎥ ᎪᏪᎶᏗ ᎾᎿᎢ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The wallpaper moves slightly when the device is tilted">
                <langSet xml:lang="en-US"><tig><term>The wallpaper moves slightly when the device is tilted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎤᏓᏴᎳᏛ ᎠᏓᏅᏍᎬ  ᎦᎸᏙᎳᎨᏍᏗ ᎾᎯᏳ Ꮎ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏗᏌᏗ ᏄᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="ALL APPS">
                <langSet xml:lang="en-US"><tig><term>ALL APPS</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock this app">
                <langSet xml:lang="en-US"><tig><term>Unlock this app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᏐᎭᎾᎸᏗ Ꮎ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone was rebooted and mobile data connection is turned off. Your phone's Video Calling function won't work when mobile data is off. Also, you won't be able to use the Internet, Email or other apps that need a data connection unless you use Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>Your phone was rebooted and mobile data connection is turned off. Your phone's Video Calling function won't work when mobile data is off. Also, you won't be able to use the Internet, Email or other apps that need a data connection unless you use Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᏎᎢ ᏥᎭᏂᎩᏍᏗ ᏃᎴ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎨᎡᎢ ᎠᏍᏚᏅᎢ. ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᏧᎸᏫᏍᏓᏁᏗᏱ ᏝᏍᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏳᏃ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎨᎡᎢ ᎠᏍᏚᎭ. ᎾᏍᏉ, ᏂᎯ ᏝᏰᏍ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ, ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ, ᏃᎴ ᏐᎢ ᏗᎬᏙᏗ ᎥᏍᎩᎾ ᎤᏚᎸᏓ Ꭰ ᏕᎦᎧᎲᎢ ᎫᏓᎸᎢ ᎢᏳᏍᎩᏂ ᏂᎯ ᎬᏔᏂᏓᏍᏗ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="LOCAL RESULTS">
                <langSet xml:lang="en-US"><tig><term>LOCAL RESULTS</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏍᎦᏂ ᏂᏚᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id=" apps are cleared with  MB memory freed up.">
                <langSet xml:lang="en-US"><tig><term> apps are cleared with  MB memory freed up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>  ᏗᎬᏙᏗ ᏧᏝᏅᏓᏛᎢ ᎬᏗ  MB ᎠᏅᏓᏗᏍᏙ ᎠᏍᏚᏗ ᏂᎨᏒᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lock successfully">
