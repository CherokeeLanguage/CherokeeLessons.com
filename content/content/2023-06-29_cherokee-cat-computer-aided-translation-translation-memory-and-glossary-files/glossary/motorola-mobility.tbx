                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳ ᏓᎵᎪᏗᏍᎬ ᎾᏠᏯᏍᏗᏍᎬᎾ VPN</term></tig></langSet>
            </termEntry>
            <termEntry id="Your existing VPN will be replaced, and you won't have an internet connection until the VPN successfully connects">
                <langSet xml:lang="en-US"><tig><term>Your existing VPN will be replaced, and you won't have an internet connection until the VPN successfully connects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎢ ᎬᏂᎨᏒ ᏄᏍᏛᎢ VPN ᏰᎵᏉ ᎨᏎᏍᏗ ᎦᏁᏟᏴᏒᎢ, ᎠᎴ ᏂᎯ ᏝᏰᎵ ᎤᎭ Ꭰ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎩᎳ ᏥᎩ VPN ᏄᏓᏄᎸᏅᎾᏊ ᏕᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To scan nearby device, turn it off.">
                <langSet xml:lang="en-US"><tig><term>To scan nearby device, turn it off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᎭᏫᏂ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.">
                <langSet xml:lang="en-US"><tig><term>If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏓᏍᏚᏁᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ, ᎢᎦᏓ ᏗᎬᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏝᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏳᏍᎩᏂ ᏂᏨᏅᎢ ᎫᏓᎸᏅᎯ ᎤᎾᎢ Wi\u2011Fi.</term></tig></langSet>
            </termEntry>
