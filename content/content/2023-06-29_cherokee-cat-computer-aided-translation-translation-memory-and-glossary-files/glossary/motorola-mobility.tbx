                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎾᎿ ᎨᎡᎢ ᏭᎵᏍᎨᏗᏴ, ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Looks like your device currently disconnected with internet. Tap the bottom button to try again.">
                <langSet xml:lang="en-US"><tig><term>Looks like your device currently disconnected with internet. Tap the bottom button to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᎭ ᏣᎸᏉᏛ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᏊ ᏥᎩ ᎫᏓᎴᏓᏃ ᎬᏗ ᎠᏏᎳᏕᏫᏒᎢ. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏥᎩ ᎭᏫᏂ ᎡᏙᎯ ᎦᏛᏗ ᎾᎿᎢ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi is needed to download this update. The download will resume once your connection is restored.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi is needed to download this update. The download will resume once your connection is restored.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᎨᎡᎢ ᎤᏚᎸᏛ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ. ᏥᎩ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏎ ᎠᎴᏂᏐᏗᏍᎩ ᏌᏊᏊ ᏂᏨᎤᎢ ᎫᏓᎸᎢ ᎨᎡᎢ ᎪᏢᎯᏌᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System update">
                <langSet xml:lang="en-US"><tig><term>System update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎪᏒᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Checking for updates…">
                <langSet xml:lang="en-US"><tig><term>Checking for updates…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᎠ ᎤᎬᏩᏟ ᏗᎪᏒᎯᏌᏅᎯ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose how you'd like to download this update:">
                <langSet xml:lang="en-US"><tig><term>Choose how you'd like to download this update:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏙᎡᎵ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Update is not possible due to insufficient storage space on the device.">
                <langSet xml:lang="en-US"><tig><term>Update is not possible due to insufficient storage space on the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎥᏝ ᎡᎵᏊ ᎠᎵᏍᎪᏗᏍᏗ ᎢᏴᎢ ᎾᎿᎢ ᎦᏲᏟᎢ ᎠᏍᏆᏂᎪᏙᏗ ᎤᏜᏅᏛ ᎤᎿᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This update requires  of available free space on your device. Kindly free up the memory for successful updates">
                <langSet xml:lang="en-US"><tig><term>This update requires  of available free space on your device. Kindly free up the memory for successful updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎᏳᎾᏛᏁᏗ  ᎾᎿ ᎠᏛᏅᎢᏍᏔᏅ ᎤᏚᏓᎴᏗ ᎤᏜᏅᏛᎯ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎤᏓᏅᏘᏴ ᏚᏓᎴᎩ ᏥᎩ ᎠᏅᏓᏗᏍᏙ ᎤᎬᏩᏟ ᏄᏓᏄᎸᏅᎾ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Software update planned">
                <langSet xml:lang="en-US"><tig><term>Software update planned</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏗᏅᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎤᏓᏅᏖᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable the system CA certificate?">
                <langSet xml:lang="en-US"><tig><term>Disable the system CA certificate?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᏥᎩ ᏄᏍᏗᏓᏅᎢ CA ᎠᏓᎵᏍᎪᎸᏓᏁᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Update failed">
                <langSet xml:lang="en-US"><tig><term>Update failed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎤᏓᏄᎸᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stay safe with automatic updates">
                <langSet xml:lang="en-US"><tig><term>Stay safe with automatic updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏙᎮᏍᏗ ᏂᎦᎾᏰᎬᎾ ᎬᏗ ᎤᏩᏌ ᏱᎬᏁᎯ ᏗᎪᏒᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently. When you turn them on, all future security updates will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently. When you turn them on, all future security updates will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᏃᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏓ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ. ᎤᎶᏐᏅ Ꭰ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎩ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᏃᎴ ᎯᏘᏅᎦ ᎤᎿᎢ ᏥᎩ ᎠᏟᎵᏒᎢ ᏂᎯ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We were not able to download this update. If you'd like to get this update later, go to Settings &gt; System updates.">
                <langSet xml:lang="en-US"><tig><term>We were not able to download this update. If you'd like to get this update later, go to Settings &gt; System updates.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎨᏒᎩ ᎥᏝ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ. ᎨᎡᎢ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ to ᎠᎩᏍᏗ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎪᎯᏴᎢ, Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You need a data connection to check for updates. To check your Wi-Fi connection, go to Settings &gt; Network &amp; internet &gt; Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>You need a data connection to check for updates. To check your Wi-Fi connection, go to Settings &gt; Network &amp; internet &gt; Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎾᎿᎢ ᎠᎦᏎᏍᏓ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏐᏗ. ᎾᎿᎢ ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᏫᎢ-ᏈᎢ ᎫᏓᎸᎢ, Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏧᎾᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ &gt; ᏫᎢ-ᏈᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to complete the download. There's not enough space on the SD Card. Free up some space and go to Settings &gt; System updates to try again.">
                <langSet xml:lang="en-US"><tig><term>Unable to complete the download. There's not enough space on the SD Card. Free up some space and go to Settings &gt; System updates to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎠᏍᏆᏛᏃᏅ ᏥᎩ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ. ᏓᎭᎢ ᎥᏝ ᏰᎵᏉ ᎤᏜᏅᏛ ᎤᎿᎢ ᏥᎩ SD ᏆᎾᏲᏍᏗ. ᏚᏓᎴᎩ ᎢᎦᏓ ᎤᏜᏅᏛ ᏃᎴ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="As you have enabled Smart Updates feature, your device will automatically install the update on  if you haven't installed by then. Make sure you have enough battery for installation.">
                <langSet xml:lang="en-US"><tig><term>As you have enabled Smart Updates feature, your device will automatically install the update on  if you haven't installed by then. Make sure you have enough battery for installation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿ ᏂᎯ ᎤᎭ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ ᎤᏩᎬᏗᏗᏒ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎯᏘᏅᎦ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎤᎿᎢ  ᎨᎡᎢ ᏂᎯ ᎤᎭ ᎥᏝ ᎦᏘᏅᏔᏅ ᎬᏗ ᎾᏉᏃ. ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯ ᎤᎭ ᏰᎵᏉ ᎠᎾᎦᎵᏍᎩ ᎤᎬᏩᏟ ᎦᏘᏅᏛᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently. When you turn them on, all future security updates and bug fixes will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently. When you turn them on, all future security updates and bug fixes will automatically download when they're available. After an update is downloaded, your device will restart and install at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᏃᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏚ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᏃᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ. ᎤᎶᏐᏅ ᎠᎴᏃ ᏗᎪᏒᎯᏌᏅᎯ ᏄᏍᏛ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᏅᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᎢ ᏥᎭᏂᎩᏍᏓ ᎠᎴ ᎯᏘᏅᎦ Ꮩ ᎠᏟᎵᏒᎢ ᏂᎯᏃ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Installation is paused due to low battery. Installation will resume when your device is charged.">
                <langSet xml:lang="en-US"><tig><term>Installation is paused due to low battery. Installation will resume when your device is charged.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏅᏛᏍᏗ ᎨᎡᎢ ᎠᏲᎯᏍᏔᏅ ᎠᎵᏍᎪᏗᏍᏗ ᎢᏴᎢ ᎾᎿᎢ ᎡᎳᏗ ᎠᎾᎦᎵᏍᎩ. ᎦᏘᏅᏛᏍᏗ ᎠᏎ ᎠᎴᏂᏐᏗᏍᎩ ᎢᏳᏃ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏛ ᎠᎫᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to download update. The update package is not available at this time. No further action is required.">
                <langSet xml:lang="en-US"><tig><term>Failed to download update. The update package is not available at this time. No further action is required.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏗᎪᏒᎯᏌᏅᎯ. ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎦᏇᏅᏛ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎿᎢ ᎯᎠ ᎠᏥᎢᎵᏒ. Ꮭ ᎤᏗᏗᏢ ᎢᏯᏛᏁᎵᏓᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="An important system update is available. Please select Install to apply the update. If not, the update will be applied automatically on .">
                <langSet xml:lang="en-US"><tig><term>An important system update is available. Please select Install to apply the update. If not, the update will be applied automatically on .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎤᎵᏍᎨᏓ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ. ᎰᏩᏊ ᎠᏑᏰᏍᏗ ᎯᏘᏅᎦ ᎾᎿᎢ ᎲᏓ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ. ᎨᎡᎢ ᎥᏝ, ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᎬᎾᏔᏅᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎤᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Please restart your device to apply this important update as soon as possible. If you don't manually restart, your device will automatically restart on .">
                <langSet xml:lang="en-US"><tig><term>Please restart your device to apply this important update as soon as possible. If you don't manually restart, your device will automatically restart on .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎲᏓ ᎯᎠ ᎤᎵᏍᎨᏓ ᎪᏢᎯᏐᏗ ᎤᎿᎢ ᎾᏞᎬᏉ ᎤᎿᎢ ᏱᎬᏩᎵᏍᏙᏗ. ᎢᏳᏃ ᏂᎯ ᏝᏍᏗ ᎣᏩᏌ ᏱᎬᏁᏗ ᏥᎭᏂᎩᏍᏓ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="An important security update is available. Please select Install to apply the update. If not, the update will be applied automatically on .">
                <langSet xml:lang="en-US"><tig><term>An important security update is available. Please select Install to apply the update. If not, the update will be applied automatically on .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎤᎵᏍᎨᏓ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ. ᎰᏩᏊ ᎠᏑᏰᏍᏗ ᎯᏘᏅᎦ ᎾᎿᎢ ᎲᏓ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ. ᎨᎡᎢ ᎥᏝ, ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᎬᎾᏔᏅᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎤᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Update now">
                <langSet xml:lang="en-US"><tig><term>Update now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ Ꭷ</term></tig></langSet>
            </termEntry>
            <termEntry id="Update later">
                <langSet xml:lang="en-US"><tig><term>Update later</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎣᏂᏯᎨᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Update preferences">
                <langSet xml:lang="en-US"><tig><term>Update preferences</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎤᏟ ᎠᏂᏰᎸᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="A new security update is ready to install">
                <langSet xml:lang="en-US"><tig><term>A new security update is ready to install</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏗᏤ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎯᏘᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try smart updates">
                <langSet xml:lang="en-US"><tig><term>Try smart updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏁᎸᏙᏗ ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed password attempts before deleting all device data">
                <langSet xml:lang="en-US"><tig><term>Failed password attempts before deleting all device data</term></tig></langSet>
