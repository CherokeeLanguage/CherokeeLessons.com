                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᏧᎶᎵᎩ ᎥᎿᎢ ᎾᏞᎬ ᏓᎾᏟᏃᎮᏍᎬᎢ</term></tig></langSet>
            </termEntry>
