                <langSet xml:lang="chr"><tig><term>(ᎧᏃᎮᏍᎩ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Update Warning">
                <langSet xml:lang="en-US"><tig><term>Update Warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏢᎯᏌ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To turn on Auto mute, Adaptive volume needs permission to display information over other apps.">
                <langSet xml:lang="en-US"><tig><term>To turn on Auto mute, Adaptive volume needs permission to display information over other apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎤᏩᏌ ᎡᎳᏪ ᏱᎬᏁᎯ, ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᎢᎦᎢ ᎤᏃᏴᎬ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎧᏃᎮᏢᎥᏍᎩ ᎠᏓᏬᎯᎳᏗᏍᎬ ᏐᎢ ᏗᎬᏙᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="I agree to receive push notifications from Motorola about promotions and offers to my device.">
                <langSet xml:lang="en-US"><tig><term>I agree to receive push notifications from Motorola about promotions and offers to my device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎵᏍᎪᎵᏗ ᏗᎩᎩᏍᏗ ᎦᏌᏙᏴ ᏗᏓᏃᏣᎳᏁᎯ Ꮎ Motorola ᏗᏓᏌᎳᏗᏍᎩ ᎠᎴ ᎤᏂᏍᎪᏢᏛ ᎠᏯ ᎠᏩᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="I understand that my consent is not required and is not a condition of any purchase.">
                <langSet xml:lang="en-US"><tig><term>I understand that my consent is not required and is not a condition of any purchase.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏩᏅᏔ Ꮭ ᎠᏎ ᎠᏩᎵᏍᎪᎵᏔᏅ ᎢᏯᏛᏁᏗ ᎠᎴ Ꮭ ᎠᏎ ᎠᎩᏩᎯᏍᏗᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Standard data rates may apply.">
                <langSet xml:lang="en-US"><tig><term>Standard data rates may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᏩᏍᏗᎭ ᎦᏟᏌᏅ ᏗᎪᏣᎴᏒᏗ ᎨᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not enough space for the application &quot;1&quot; profile '2'.">
                <langSet xml:lang="en-US"><tig><term>Not enough space for the application "1" profile '2'.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎮᎵ ᎢᎦ ᎤᏢᏅᏓ Ꮎ ᎬᏙᏗ "1" ᏗᏓᏟᎶᏍᏛᎾ '2'.</term></tig></langSet>
            </termEntry>
            <termEntry id="I may unsubscribe to push notifications by selecting &quot;Unsubscribe&quot; in the notifications I receive.">
                <langSet xml:lang="en-US"><tig><term>I may unsubscribe to push notifications by selecting "Unsubscribe" in the notifications I receive.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏎ ᏗᎩᏁᏍᏗ ᏱᎩ ᎦᏌᏙᏴ ᏗᏓᏃᏣᎳᏁᎯ ᏴᎬᏑᏰᏏ “ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ” Ꮎ ᏗᏓᏃᏣᎳᏁᎯ ᏕᏥᏁᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Resend">
                <langSet xml:lang="en-US"><tig><term>Resend</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏫᎲᏅᎥᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Add your email so we can communicate via email and push notification about Motorola's services and benefits like the following:">
                <langSet xml:lang="en-US"><tig><term>Add your email so we can communicate via email and push notification about Motorola's services and benefits like the following:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏳᏫᏨᏃᏎ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᎬᏗ ᎠᎴ ᎦᏒᏙᏯ ᏗᏓᏃᏣᎳᏁᎯ Ꮎ Motorola ᎾᏅᏛᏁᎲᎢ ᎠᎴ ᏣᎵᏍᏕᎸᏙᏗ ᎯᎠ ᏥᏂᎬᏅ</term></tig></langSet>
            </termEntry>
