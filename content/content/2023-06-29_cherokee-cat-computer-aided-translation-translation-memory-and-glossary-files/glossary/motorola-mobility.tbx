            <termEntry id="Touch &amp; hold Back and Overview to unpin.">
                <langSet xml:lang="en-US"><tig><term>Touch &amp; hold Back and Overview to unpin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᎠᏨᏍᏗ ᎠᎴ ᏍᏆᎳ ᎧᏃᎮᏓ ᎾᎿᎢ ᎥᏝ ᎦᎭᏛᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This keeps it in view until you unpin.">
