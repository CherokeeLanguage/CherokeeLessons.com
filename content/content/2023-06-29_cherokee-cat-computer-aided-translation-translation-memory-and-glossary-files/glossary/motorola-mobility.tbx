                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎦᏬᏂᎯᏍᏗ ᎠᏯᏙᎯᎯ ᏝᏰᏃ ᏱᏚᎸᏫᏍᏓᏁᎢ ᏃᏩ ᎨᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the edge action bar for quick shortcuts">
                <langSet xml:lang="en-US"><tig><term>Tap on the edge action bar for quick shortcuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎠᏍᏛᎢ ᎠᎵᏖᎸᎲᏍᎩ ᎦᎾᏛᎢ ᎾᏍᎩᎾ ᎤᏟᏍᏓ ᏗᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="To grant permissions, tap on &quot;Permissions&quot; in App info.">
                <langSet xml:lang="en-US"><tig><term>To grant permissions, tap on "Permissions" in App info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ, ᎤᎾᎢ ᎭᏐᎥᏍᏓ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᏙᏗ ᎧᏃᎮᏢᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Double tap on the action bar">
                <langSet xml:lang="en-US"><tig><term>Double tap on the action bar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎠᎵᏖᎸᎲᏍᎩ ᎦᎾᏛᎢ</term></tig></langSet>
            </termEntry>
