                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᎩ ᎾᎢ ᎣᎶᏒ ᏗᏓᏟᎶᏍᏔᏅ ᏗᏓᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Type the password to extract the certificates.">
                <langSet xml:lang="en-US"><tig><term>Type the password to extract the certificates.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᏥᎩ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎾᎿᎢ ᏱᎬᏅᏕᏍᏗ ᏥᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't save media">
                <langSet xml:lang="en-US"><tig><term>Can't save media</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎭᎵᏏᏅᏓ ᎦᎶᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to receive packets sent to all devices on a Wi-Fi network using multicast addresses, not just your tablet. It uses more power than the non-multicast mode.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to receive packets sent to all devices on a Wi-Fi network using multicast addresses, not just your tablet. It uses more power than the non-multicast mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᏗᎩᏍᏗ ᏗᎦᏇᏅᎯ ᏫᎦᏅ ᏫᏗᎦᏅᏁᎸᎢ ᏂᎦᏓ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᎾᎢ Ꮎ ᏫᎢ-ᏈᎢ ᎤᏚᏓᎵ ᎬᏗᏍᎬ ᎢᎸᏍᎩ ᎠᏁᎸᎩ ᏗᎪᏪᎵ ᏧᏂᏁᏍᏗᎢ, ᎭᏗ ᏍᎩᏋ ᏣᏤᎵ ᎪᏪᎶᏙᏗᎢ. ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ ᎤᎪᏗᏊ ᎤᏟᏂᎩᏓ ᎡᏍᎦᏉ ᏥᎩ ᎬᏂᎬᎬ-ᎢᎸᏍᎩ ᏩᏗᏅᏗ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can customize audio settings to suit your preference.">
                <langSet xml:lang="en-US"><tig><term>You can customize audio settings to suit your preference.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎠᏤᎲᏍᏙᏗ ᎤᏃᏴᎬ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᏧᏠᏱᎭ ᏗᎾᏬ ᏂᏨᎤᎢ ᎤᏟ ᎠᏰᎸᏍᎬ.</term></tig></langSet>
            </termEntry>
