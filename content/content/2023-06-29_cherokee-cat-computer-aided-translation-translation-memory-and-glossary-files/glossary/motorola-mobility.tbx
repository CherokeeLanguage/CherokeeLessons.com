            </termEntry>
            <termEntry id="In case of problems with mobile data connection, it will be suggested to temporarily change the sim card used for mobile data">
                <langSet xml:lang="en-US"><tig><term>In case of problems with mobile data connection, it will be suggested to temporarily change the sim card used for mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏱᏄᏍᏗᏓᎾ ᎥᎿᎢ ᏓᏓᎴᏍᏗᏍᎬ ᎬᏗ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ, ᎾᏍᎩ ᏰᎵᏉ ᎨᏎᏍᏗ ᎧᏁᎢᏍᏙᏔᏅ ᎾᎢ ᏞᎩᏊ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᏏᎻ ᏆᏂᏲᏍᏗ ᎬᏔᏅᎯ ᎾᏍᎩ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This mode can't be used on a connected display">
                <langSet xml:lang="en-US"><tig><term>This mode can't be used on a connected display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗᎭ ᎨᏍᏗ ᏰᎵ ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᎤᎾᎢ ᎫᏓᎸᏅᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Process request">
                <langSet xml:lang="en-US"><tig><term>Process request</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᎸᏍᏗ ᎠᏔᏲᎯᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Headphones act as an antenna for the radio, so you may experience lower audio quality if you don’t plug them in.">
                <langSet xml:lang="en-US"><tig><term>Headphones act as an antenna for the radio, so you may experience lower audio quality if you don’t plug them in.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏳᏙᎾᏗᏍᏗ ᎠᎵᏁᎩ ᎤᎿᎢ Ꭰ ᎫᏓᎸᎢ ᎤᎬᏩᏟ ᏥᎩ ᎦᏬᏂᏍᎩ, ᏓᏛ ᏂᎯ ᏰᎵᏯ ᎠᎦᏙᎲᏒᎢ ᎡᎳᏗᏢ ᎤᏃᏴᎬ ᎢᏲᏍᏓ ᎨᎡᎢ ᏂᎯ ᏝᏍᏗ ᎠᏍᏚᏙᏗ ᎢᏯᏂᎢ ᎾᎿ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Received:">
                <langSet xml:lang="en-US"><tig><term>Data Received:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᏓᏥᏁᎸᎩ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Use  instead of  for mobile data?">
                <langSet xml:lang="en-US"><tig><term>Use  instead of  for mobile data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ  ᎤᎬᏫᏳᏎᏍᏗ ᎾᎿ  ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="You went live for ">
                <langSet xml:lang="en-US"><tig><term>You went live for </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏭᎶᏒ ᏊᏥᎩ ᎤᎬᏩᏟ </term></tig></langSet>
            </termEntry>
            <termEntry id="In notifications, browse among your favorite radio stations.">
                <langSet xml:lang="en-US"><tig><term>In notifications, browse among your favorite radio stations.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏗᏣᏱᎦ ᏄᎾᏛᏅ ᏂᏨᎤᎢ ᏩᎩᎸᏉᏛᎢ ᎦᏬᏂᏍᎩ ᏧᎴᏫᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot place a call as there is an unanswered incoming call. Answer or reject the incoming call prior to placing a new call.">
                <langSet xml:lang="en-US"><tig><term>Cannot place a call as there is an unanswered incoming call. Answer or reject the incoming call prior to placing a new call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎤᏙᏢᏒ Ꭰ ᏪᏯᎾ ᎯᎢᎾᎢ ᎤᎿᎢ ᎨᏒᎢ Ꮭ ᎦᏬᎯᎵᏴᏓ ᎦᎷᎦ ᏪᏯᎾ. ᎦᏬᎯᎵᏴᏍᎬᎢ ᎠᎴ ᎠᏓᏯᏍᏗ ᏥᎩ ᎦᎷᎦ ᏪᏯᎾ ᏧᏩᎫᏔᏅᏒ ᎾᎿᎢ ᏩᎲᏍᎬ Ꭰ ᏗᏤ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data use period">
                <langSet xml:lang="en-US"><tig><term>Data use period</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᏗᏍᎦᎬ ᎠᎴᏫᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You are not agreed with Moto Live Stream to post Live Video to your Facebook.">
                <langSet xml:lang="en-US"><tig><term>You are not agreed with Moto Live Stream to post Live Video to your Facebook.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᎡᎩ ᎥᏝ ᏚᏄᎪᏔᏅ ᎬᏗ Moto ᏊᏥᎩ ᎤᏪᎬ ᎾᎿᎢ ᏗᎦᏃᏣᏢᏍᎩ ᏊᏥᎩ ᏗᏓᏴᎳᏛᏍᎩ ᎾᎿᎢ ᏂᏨᎤᎢ Facebook.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please update Google Photos to use Live Filter mode">
                <langSet xml:lang="en-US"><tig><term>Please update Google Photos to use Live Filter mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎪᏢᎯᏐᏗGoogle ᏗᏓᏥᎶᏍᏔᏅᎯ ᎾᎢ ᎬᏙᏓ ᏃᏊᏥᎩ ᏗᎬᎫᏍᏙᏗ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Updating the region will erase all scanned stations and trigger a new scan.">
                <langSet xml:lang="en-US"><tig><term>Updating the region will erase all scanned stations and trigger a new scan.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏤᎲᏍᏗᏍᎬ ᏥᎩ ᎢᎬᎾᏕᎾ ᎠᏎ ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏙᏗ ᏧᎴᏫᏍᏙᏗ ᎠᎴ ᎪᏣᏁᏍᏗᎢ Ꭰ ᏗᏤ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="&quot;Play my favorite station&quot;">
                <langSet xml:lang="en-US"><tig><term>"Play my favorite station"</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>"ᏔᏁᎶᎲᎦ my ᏩᎩᎸᏉᏛᎢ ᎤᎴᏫᏍᏙᏗ"</term></tig></langSet>
            </termEntry>
            <termEntry id="Theme name">
