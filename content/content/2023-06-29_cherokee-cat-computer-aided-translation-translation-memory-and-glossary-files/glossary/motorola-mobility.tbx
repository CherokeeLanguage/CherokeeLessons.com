                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎨᏎᏍᏗ Ꮆ ᎠᏂᎩᏍᏙᏗ ᎾᏍᎩᎾ ᎯᎠ ᎦᏁᏟᏴᏍᏗ ᎾᎢ ᏱᏂᎦᎵᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can restrict access to apps and content from your account">
                <langSet xml:lang="en-US"><tig><term>You can restrict access to apps and content from your account</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎤᏅᏍᏙᏒ ᎠᏴᏍᏗ ᎾᎾᎢ ᏗᎬᏙᏗ ᎠᎴ ᎦᎸᏛᎢ ᏂᏓᏳᏓᎴᏅ ᏣᏤᎵ ᎠᏚᏓᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Each user has their own space, which they can customize with apps, wallpaper, and so on.">
                <langSet xml:lang="en-US"><tig><term>Each user has their own space, which they can customize with apps, wallpaper, and so on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏤᎵᏛ ᎬᏗᏍᎩ ᎤᏂᎭ ᎤᏅᏌ ᎤᏜᏅᏛᎯ, ᎾᏍᎩᏃ ᏰᎵᏊ ᎠᏤᎲᏍᏙᏗ ᎬᏗ ᏗᎬᏙᏗ, ᎧᏑᎧᏡ ᎪᏪᎵ, ᎠᎴ ᏅᏍᏗᏓᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you add a new user, that person needs to set up their space.">
                <langSet xml:lang="en-US"><tig><term>When you add a new user, that person needs to set up their space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏗᎧᏁᏉᏍᏗ ᏗᏤ ᎬᏗᏍᎩ, ᎥᏍᎩᎾ ᎠᏂᏴᏫ ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᎾᎿᎢ ᏘᎧᎲᎦ ᎤᎾᏤᎵ ᎤᏜᏅᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Any user can update apps for all other users.">
