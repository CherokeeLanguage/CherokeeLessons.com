            <termEntry id="To use this feature, swipe up from the bottom of the screen with 3 fingers.">
                <langSet xml:lang="en-US"><tig><term>To use this feature, swipe up from the bottom of the screen with 3 fingers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎣ ᎤᏎ tᎯᏍ fᎡᎠtᎤrᎡ, ᏍᏫpᎡ Ꭴp frᎣm tᎮ bᎣttᎣm Ꭳf tᎮ ᏍcrᎡᎡn Ꮻth 3 fᎢnᎨrᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notification dot on app icon">
                <langSet xml:lang="en-US"><tig><term>Notification dot on app icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᏣᎳᏁᎯ ᎤᏓᏓᏢ ᎤᎾᎢ ᎬᏙᏗ ᎠᎢᎧᏂ</term></tig></langSet>
