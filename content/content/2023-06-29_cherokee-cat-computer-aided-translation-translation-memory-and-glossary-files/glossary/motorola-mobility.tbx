            </termEntry>
            <termEntry id="Cutout lets you change the background after you\’ve taken a photo. To use Cutout, go to the gallery and choose a photo, tap \“Edit\”, and then choose \“Add background\” to modify the photo.">
                <langSet xml:lang="en-US"><tig><term>Cutout lets you change the background after you\’ve taken a photo. To use Cutout, go to the gallery and choose a photo, tap \“Edit\”, and then choose \“Add background\” to modify the photo.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏖᏅᏕᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᏣᏁᏟᏴᏍᏗᎢ ᎾᏍᎩ ᎣᎾᏗᏜ ᏄᏍᏗᏓᏅ ᎤᎶᏐᏅ ᏂᎯᏃ\ ᏕᏣᏥᎶᏍᏔᏅᎢ. ᎾᎢ ᎬᏙᏓ ᎦᏖᏅᏕᏓ, ᎤᎾᎢ ᎮᎾ ᎾᏍᎩ ᎧᏅᏑᎸ ᎤᏂᎿᎥ ᏃᎴ ᎠᏑᏰᏍᏗ ᏗᏓᏥᎶᏍᏔᏅ, ᎭᏐᏅᏍᏓ \“ᎦᏁᏟᏴᏓ ᎪᏪᎸ\”, ᏃᎴ ᎿᏉᏃ ᎠᏑᏰᏍᏗ \“ᎧᏁᏉᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ\” ᎾᎢ ᎤᏃᏒᎯᏐᏗ ᎾᏍᎩᏗᏓᏥᎶᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera Disabled">
                <langSet xml:lang="en-US"><tig><term>Camera Disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᎴᏫᏍᏙᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to store photos and videos on your SD card?">
                <langSet xml:lang="en-US"><tig><term>Do you want to store photos and videos on your SD card?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍᎪᏃ ᏣᏚᎵᎭ ᎾᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎤᎾᎢ ᏣᏤᎵ SD ᏆᏂᏲᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Please restart Camera to continue">
                <langSet xml:lang="en-US"><tig><term>Please restart Camera to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏂᎦᏯᎢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Reduce file size for UHD videos by saving as H.265/HEVC instead of H.264/AVC. Some platforms may not support the HEVC format.">
                <langSet xml:lang="en-US"><tig><term>Reduce file size for UHD videos by saving as H.265/HEVC instead of H.264/AVC. Some platforms may not support the HEVC format.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎳᎨ ᎠᏍᏆᏂᎪᏙᏗ ᎢᎩᏓ ᎾᏍᎩᎾ UHD ᏗᏓᏴᎳᏛᏍᎩ ᎨᏒᎢ ᏗᎵᏏᏅᏗᏍᎩ ᎾᏍᎩ H.265/HEVC ᎤᎬᏫᏳᏎᏍᏗ ᎥᎿᎢ H.264/AVC. ᎢᎦᏓ ᏓᏲᏓᏝᎲ ᏰᎵᏉ ᎭᏗ ᎦᎫᏍᏛᏅ ᏱᎩ ᎾᏍᎩ HEVC ᏱᎬᏁᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To take straighter shots, turn on the leveler in settings">
                <langSet xml:lang="en-US"><tig><term>To take straighter shots, turn on the leveler in settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᎩᏍᏗ ᎦᏥᏃᏍᏓᏊᏃ ᏗᎪᏣᏁᏒᎢ, ᎯᏍᏚᎢ ᎾᏍᎩ ᎠᏥᎶᏍᎩ ᎾᎿᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
