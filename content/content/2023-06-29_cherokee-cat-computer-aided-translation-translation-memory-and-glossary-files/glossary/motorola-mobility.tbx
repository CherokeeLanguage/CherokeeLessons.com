            </termEntry>
            <termEntry id="To stay on a Wi-Fi call, remain in the range of the Wi-Fi network.">
                <langSet xml:lang="en-US"><tig><term>To stay on a Wi-Fi call, remain in the range of the Wi-Fi network.</term></tig></langSet>
