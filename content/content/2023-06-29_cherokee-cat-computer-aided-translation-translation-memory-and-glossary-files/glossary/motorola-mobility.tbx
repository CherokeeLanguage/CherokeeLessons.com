                <langSet xml:lang="chr"><tig><term>ᎯᏩᏔ ᏗᎬᏔᏂᏓᏍᏗ &amp; ᏕᎦᎧᎲᎢ ᎾᎢ ᏓᏤᎴᏍᏗ ᏕᎭᏁᎸᏗᏍᎬᎢ ᏣᎦᏙᎲᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera preview is off">
                <langSet xml:lang="en-US"><tig><term>Camera preview is off</term></tig></langSet>
