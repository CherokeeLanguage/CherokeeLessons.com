                <langSet xml:lang="en-US"><tig><term>Can't have empty subject.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏰᎵ ᎤᎭ ᎤᏑᏩ ᎧᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Start using... Advanced Messaging">
                <langSet xml:lang="en-US"><tig><term>Start using... Advanced Messaging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᎾ ᎲᏗᏍᎬᎢ… Advanced Messaging</term></tig></langSet>
            </termEntry>
            <termEntry id="Chatbot">
                <langSet xml:lang="en-US"><tig><term>Chatbot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎵᎪᎯ ᎦᏬᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set display name for Advanced Messaging">
                <langSet xml:lang="en-US"><tig><term>Set display name for Advanced Messaging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᎲᎦ ᎬᏂᎨᏒ ᏅᎦ ᏚᏙᎥᎢ ᎤᎬᏩᏟ Advanced Messaging</term></tig></langSet>
            </termEntry>
            <termEntry id="Advanced messaging offers a more engaging experience than traditional text messaging. While you're in a chat, you can see when another person is typing. You can also easily manage groups and share large files.">
                <langSet xml:lang="en-US"><tig><term>Advanced messaging offers a more engaging experience than traditional text messaging. While you're in a chat, you can see when another person is typing. You can also easily manage groups and share large files.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Advanced messaging ᎠᏂᏍᎪᎸᏗᏍᎬ Ꭰ ᎤᏟ ᎢᎦᎢ ᎤᎵᎶᎯ ᎠᎦᏙᎲᏒᎢ ᎡᏍᎦᏉ ᎤᏂᎲ ᏳᎾᏛᏁᎵᏓᏍᏗ ᎠᎪᎵᏰᏗ ᏓᎾᏓᏙᏪᎳᏁᎲ. ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᎾᎿ Ꭰ ᎦᏬᏂᎯᏍᏗ, ᏂᎯ ᏰᎵᏊ ᎠᎪᏩᏛᏗ ᎢᏳᏃ ᏄᏓᎴ ᏴᏫ ᎨᏒᎢ ᏗᏐᎥᏍᏙᏗ. ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᎠᎯᏓ ᎫᎪᏔᏂᏙᎯ ᏚᎾᏓᏡᎬᎢ ᎠᎴ ᎠᏯᏙᏍᏗᎢ ᎡᏆ ᏗᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Chatbots">
                <langSet xml:lang="en-US"><tig><term>Chatbots</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎵᎪᎯ ᎦᏬᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id=", ,  and  left">
                <langSet xml:lang="en-US"><tig><term>, ,  and  left</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>, ,  ᎠᎴ  ᎠᎦᏍᎦᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your group name update to &quot;&quot; failed for others">
                <langSet xml:lang="en-US"><tig><term>Your group name update to "" failed for others</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎢ ᎤᎾᏓᏡᎬᎢ ᏚᏅᏙᎥ ᎪᏢᎯᏌᏅ ᎾᎿᎢ "" ᎤᏄᎸᏅᎢ ᎤᎬᏩᏟ ᎠᏂᏐᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Report as spam">
                <langSet xml:lang="en-US"><tig><term>Report as spam</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎯᎢᎾᎢ ᎤᏲᎢ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id=" couldn't be added to contacts.">
                <langSet xml:lang="en-US"><tig><term> couldn't be added to contacts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎤᏄᎸᏅᎢ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᎿᎢ ᏗᏟᏃᎮᏙᏗ .</term></tig></langSet>
            </termEntry>
            <termEntry id="If you turn off Advanced Messaging, you cannot share files over 1MB, see read receipts, or see when the recipient is typing.You will also no longer be able to send or receive group messages from your current Advanced Messaging group threads.">
                <langSet xml:lang="en-US"><tig><term>If you turn off Advanced Messaging, you cannot share files over 1MB, see read receipts, or see when the recipient is typing.You will also no longer be able to send or receive group messages from your current Advanced Messaging group threads.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏍᏚᏗ Advanced Messaging, ᏂᎯ ᏝᏰᎵ ᎠᏯᏙᏍᏗᎢ ᏗᏍᏆᏂᎪᏙᏗ ᎢᏴᏛ 1MB, ᎠᎪᏩᏛᏗ ᎠᎪᎵᏰᏗ ᎠᎩᏒᏅ ᎧᏃᎮᏍᎩ ᎪᏪᎵ, ᎠᎴ ᎠᎪᏩᏛᏗ ᎢᏳᏃ ᏥᎩ ᏗᎦᏁᏍᎩ ᎨᏒᎢ ᏗᏐᎥᏍᏙᏗ.ᏂᎯ ᎠᏎᎢ ᎾᏍᏊ Ꮭ ᏃᏊᏃ ᎨᏒᎩ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᏫᏅᎥᎦ ᎠᎴ ᎦᏁᏍᏗ ᎤᎾᏓᏡᎬᎢ ᏗᎪᎵᏰᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᏅᎢ ᏃᏊ ᏥᎩ Advanced Messaging ᎤᎾᏓᏡᎬᎢ ᎧᏃᎮᏢᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Contact unblocked">
                <langSet xml:lang="en-US"><tig><term>Contact unblocked</term></tig></langSet>
