            </termEntry>
            <termEntry id="Lock device when unpinning">
                <langSet xml:lang="en-US"><tig><term>Lock device when unpinning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏯ ᎠᏍᏚᏓ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎯᏳ ᎯᎥᏍᏈᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap and hold">
                <langSet xml:lang="en-US"><tig><term>Tap and hold</term></tig></langSet>
