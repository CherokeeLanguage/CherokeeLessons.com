                <langSet xml:lang="en-US"><tig><term>Default</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to change recordings sorting">
                <langSet xml:lang="en-US"><tig><term>Tap to change recordings sorting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿᎢ ᎯᏁᏟᏴᎾ ᎦᏂᏴᏗᏍᎬᎢ ᏛᏑᏰᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your recording won't be saved. This action can't be undone">
                <langSet xml:lang="en-US"><tig><term>Your recording won't be saved. This action can't be undone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎦᏂᏴᏗᏍᎩ Ꮭ ᎡᎵᎢ ᎨᏒᎢ ᏱᎬᎵᏏᏅᏓ. ᎯᎠ ᎠᎵᏖᎸᏗ ᏝᏰᎵ ᎨᏒ ᏱᏂᎦᏴᎬᎾᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Privacy Policy">
                <langSet xml:lang="en-US"><tig><term>Privacy Policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to init the Player">
                <langSet xml:lang="en-US"><tig><term>Failed to init the Player</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎢ ᎠᏛᏅᎢᏍᏙᏗ ᏥᎩ ᎾᏍᎩ ᏗᏁᎶᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edit name">
                <langSet xml:lang="en-US"><tig><term>Edit name</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᏚᏙᎥᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to start playback. Audio layer is already being used by another application.">
                <langSet xml:lang="en-US"><tig><term>Unable to start playback. Audio layer is already being used by another application.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎠᎴᏅᏗ ᏔᎵᏁ ᏥᏙᎭᏁᎸᏓ. ᎤᏃᏴᎬ ᎠᏰᎦᏢᎢ ᏄᏍᏛ ᎦᏳᎳ ᎠᏅᏗᏍᎬᎢ ᎬᏗ ᏅᏩᏓᎴᎢ ᎠᏔᏲᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't use special characters: \u003c \u003e * / | ? \ :">
                <langSet xml:lang="en-US"><tig><term>Can't use special characters: \u003c \u003e * / | ? \ :</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏰᎵ ᎬᏙᏓ ᏱᎩ ᎤᏓᏤᏟᏓ ᏕᎪᏪᎸ: \u003c \u003e * / | ? \ :</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, you don't have permission to connect to ">
                <langSet xml:lang="en-US"><tig><term>Sorry, you don't have permission to connect to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎠᏰᎸᏗ, ᏂᎯ ᏞᏍᏗ ᎡᏣᎵᏍᎪᎸᏓᏁᎸ ᏱᎩ ᎾᎢ ᏗᎵᎪᏙᏗ ᎾᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Calling Activation Unsuccessful. Please update the emergency address and turn on the Wi-Fi Calling">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi Calling Activation Unsuccessful. Please update the emergency address and turn on the Wi-Fi Calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᎠᎴᏅᏙᏗ ᎤᏓᏄᎸᏅᏊ. ᎰᏩᏊ ᏗᎪᏒᎯᏌᏅᎯ ᏥᎩ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎠᎴ ᎯᏍᏚᎢ ᏥᎩ Wi-Fi ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to connect to mobile network via AT&amp;T Microcell. Try again.">
                <langSet xml:lang="en-US"><tig><term>Failed to connect to mobile network via AT&amp;T Microcell. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅᎢ ᎾᎿᎢ ᎫᏓᎸᎢ ᎾᎿᎢ ᎠᏂᎩᏍᎩ ᎫᏓᎸᎢ ᎾᎿ ᎢᏗᏨ AT&amp;T Microcell. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please update the emergency address by pressing Update to enable and turn on the Wi-Fi Calling">
                <langSet xml:lang="en-US"><tig><term>Please update the emergency address by pressing Update to enable and turn on the Wi-Fi Calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏗᎪᏒᎯᏌᏅᎯ ᏥᎩ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎬᏗ ᎠᏐᎥᏍᏗᏍᎬ ᏗᎪᏒᎯᏌᏅᎯ ᎾᎿᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎠᎴ ᎯᏍᏚᎢ ᏥᎩ Wi-Fi ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Magnify with shortcut">
                <langSet xml:lang="en-US"><tig><term>Magnify with shortcut</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏃᏍᎩ ᎬᏗ ᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on Airplane Mode disables all network features including calling, messaging, mobile data, Wi-Fi, and Bluetooth. To still use Wi-Fi or Bluetooth, turn them on in Settings or in the notification panel.">
                <langSet xml:lang="en-US"><tig><term>Turning on Airplane Mode disables all network features including calling, messaging, mobile data, Wi-Fi, and Bluetooth. To still use Wi-Fi or Bluetooth, turn them on in Settings or in the notification panel.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᏄᏍᏛᎢ ᏗᎬᏙᏗ ᏂᎨᏒᎾ ᏂᎦᏓ ᏧᎾᏚᏓᎵ ᏗᎦᏎᏍᏙᏗ ᎤᏐᏯᏍᏗ ᏓᏯᏂᏍᎬ, ᏛᎦᏃᏣᎵᏍᎬ, ᎠᏂᎩᏍᎩ ᏕᎦᎧᎲᎢ, Wi-Fi, ᏃᎴ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ. ᎾᎿᎢ ᎠᏏᏉ ᎬᏔᏂᏓᏍᏗ ᏫᎢ-ᏈᎢ Bluetooth, ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ ᎾᎿ ᏕᎦᎧᎲᎢ ᏃᎴ ᎾᎿ ᏥᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏯᏔᎾᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This preloaded app came with your device, but now has a critical update available. This will ensure this app's settings are up to date and may eliminate performance problems.">
                <langSet xml:lang="en-US"><tig><term>This preloaded app came with your device, but now has a critical update available. This will ensure this app's settings are up to date and may eliminate performance problems.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏄᎪᎲᎾᏊ ᏫᏗᎦᏁᏍᏗ ᎬᏙᏗ ᎤᎷᏨ ᎬᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ, ᎢᏳᏃ Ꭷ ᎤᎭ Ꭰ ᎤᎵᏲᎵᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏛᏅᎢᏍᏔᏅ. ᎯᎠ ᎠᏎ ᏦᎯᏳᏙᏗᏊ ᎯᎠ ᏗᎬᏙᏗ ᏕᎦᎧᎲᎢ ᎨᎡᎩ ᎠᏤᎲᏍᏔᏅᎢ-ᎾᎢ-ᎢᎦ ᎠᎴ ᏰᎵᏯ ᎪᏣᎴᏍᏓ ᎾᎾᏛᏁᎲ ᏓᏓᎴᏍᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Power sharing lets your phone charge another wireless charging compatible device. Your phone may not be able to charge another device when your battery is low.">
                <langSet xml:lang="en-US"><tig><term>Power sharing lets your phone charge another wireless charging compatible device. Your phone may not be able to charge another device when your battery is low.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ ᏩᏂᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎬᏂᏗᏍᏗᏍᎩ ᏄᏓᎴ ᏂᏓᏏᎳᏛ ᏓᎬᏩᎶᏗᏍᎬ ᏗᏙᎵᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏂᏗᏍᏗᏍᎩ ᏄᏓᎴ ᏥᏂᎬᏅᏗᏓᎾ ᎢᏳᏃ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᎨᎡᎢ ᎡᎳᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Power sharing setup">
                <langSet xml:lang="en-US"><tig><term>Power sharing setup</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ ᎦᎧᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow power sharing">
                <langSet xml:lang="en-US"><tig><term>Allow power sharing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Power sharing is on">
                <langSet xml:lang="en-US"><tig><term>Power sharing is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Power sharing">
                <langSet xml:lang="en-US"><tig><term>Power sharing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Charge another device with your phone">
                <langSet xml:lang="en-US"><tig><term>Charge another device with your phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᏗᏍᏗᏍᎩ ᏄᏓᎴ ᏥᏂᎬᏅᏗᏓᎾ ᏗᏟᏃᎮᏗ ᏣᏤᎵ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app will be able to use battery in the background. Your battery may run out sooner than expected.">
                <langSet xml:lang="en-US"><tig><term>This app will be able to use battery in the background. Your battery may run out sooner than expected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᏰᎵᏉ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ. ᏂᏨᏅᎢ ᎠᎾᎦᎵᏍᎩ ᏰᎵᏉ ᎠᎢᏎᏍᏗ ᎦᏅᎪᏫᏛ ᏞᎯᎨᏍᏗ ᎡᏍᎦᏉ ᎤᏚᎩ ᎤᏩᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Power sharing makes it easy to charge another device with your phone. First, place your phone face down on a flat surface.">
                <langSet xml:lang="en-US"><tig><term>Power sharing makes it easy to charge another device with your phone. First, place your phone face down on a flat surface.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏟᏂᎬᎬ ᎠᏯᏙᎯᏍᏗ ᎠᏍᏚᎭ ᎦᎧᎲᏍᎬᎢ ᏂᎦᎵᏍᏗᏍᎬᎢ ᎨᎡᎢ ᎠᎯᏗᎨᎢ ᎾᎿᎢ ᎬᏂᏗᏍᏗᏍᎩ ᏄᏓᎴ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ. ᎢᎬᏱ, ᎤᏙᏢᏒ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎡᎳᏗ ᏭᎧᏔ ᎾᎿᎢ Ꭰ ᎤᏯᏔᎳᏨ ᎦᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your current rate plan does not include the Smartphone Mobile HotSpot service which enables sharing your phone's data connection with other devices. Do you want to add the Smartphone Mobile HotSpot service to your rate plan? You can also add it online at https://my.t-mobile.com under Manage &gt; Plans and Services.">
                <langSet xml:lang="en-US"><tig><term>Your current rate plan does not include the Smartphone Mobile HotSpot service which enables sharing your phone's data connection with other devices. Do you want to add the Smartphone Mobile HotSpot service to your rate plan? You can also add it online at https://my.t-mobile.com under Manage &gt; Plans and Services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᎠᎦᏈᏴᎡᎲᎢ ᏗᎫᎪᏔᏂᏙᎸᎯ ᏝᏍ ᎠᏠᏯᏍᏙᏗ ᏥᎩ ᎠᏌᎹᏗ ᏗᏟᏃᎮᏗ ᎬᎯᏓᏍᏗ ᎤᏙᏢᏒᎢ ᎢᏯᏓᏛᏁᏗ ᎦᏙᎤᏍᏗ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎠᏯᏙᎯᏍᏗᏍᎬ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎬᏗ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ. ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᏗᎧᏁᏉᏍᏗ ᏥᎩ ᎠᏌᎹᏗ ᏗᏟᏃᎮᏗ ᎬᎯᏓᏍᏗ ᎤᏙᏢᏒᎢ ᎢᏯᏓᏛᏁᏗ ᎾᎿᎢ ᏂᏨᎤᎢ ᎠᎦᏈᏴᎡᎲᎢ ᏗᎫᎪᏔᏂᏙᎸᎯ? ᏂᎯ ᏰᎵᏯ ᎾᏍᏊ ᏗᎧᏁᏉᏍᏗ ᎨᎡᎢ ᏓᏏᎳᏕᏫᏒ ᎤᎿᎢ https://my.t-mobile.com ᎤᏓᏄᏴᏛᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ &gt; ᏗᎫᎪᏔᏂᏙᎸᎯ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To tune to a station by name, it must be in your Favorites list. Try again using the station number, or choose another station.">
                <langSet xml:lang="en-US"><tig><term>To tune to a station by name, it must be in your Favorites list. Try again using the station number, or choose another station.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎭᏃᏴᎬ ᎾᎿᎢ Ꭰ ᎤᎴᏫᏍᏙᏗ ᎬᏗ ᏚᏅᏙᎥ, ᎨᎡᎢ ᎠᏎ ᎾᎿ ᏂᏨᎤᎢ ᏗᏣᎸᏉᏛᎢ ᏓᏎᏍᏛᎢ. ᏏᏊ ᏥᎭᏁᎸᏓ ᎬᏗᎭ ᏥᎩ ᎤᎴᏫᏍᏙᏗ ᎠᏎᏍᏗ, ᎠᎴ ᏣᏑᏰᏍᏗ ᏄᏓᎴ ᎤᎴᏫᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to find any audio player installed">
                <langSet xml:lang="en-US"><tig><term>Unable to find any audio player installed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎢ ᎠᏩᏛᏗ ᏂᎦᎥ ᎤᏃᏴᎬ ᏗᏁᎶᎲᏍᎩ ᎦᏘᏅᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tune to station KISS FM">
                <langSet xml:lang="en-US"><tig><term>Tune to station KISS FM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏃᏟᏍᏗ ᎾᎢ ᎤᏙᏢᏒᎢ KISS FM</term></tig></langSet>
            </termEntry>
            <termEntry id="To reproduce a radio station, FM Radio needs permission to record audio.Tap ALLOW on the following screen to grant permission.">
                <langSet xml:lang="en-US"><tig><term>To reproduce a radio station, FM Radio needs permission to record audio.Tap ALLOW on the following screen to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎰᏢᎯᏍᏌ ᎤᏠᏯ ᏗᎧᏃᎩᏍᏙᏗ ᎤᏙᏢᏒᎢ ᎠᎴᏫᏍᏙᏗ, FM ᏗᎧᏃᎩᏍᏙᏗ ᏚᏚᎸᏛᎢ ᎤᎾᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎦᏂᏴᏙᏗ ᎤᏃᏴᎬ.ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Region update">
                <langSet xml:lang="en-US"><tig><term>Region update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᎾᏕᎾ ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="&quot;Tune to station KISS FM&quot;">
                <langSet xml:lang="en-US"><tig><term>"Tune to station KISS FM"</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>"ᎦᏃᏟᏍᏗ ᎾᎢ ᎤᏙᏢᏒᎢ KISS FM"</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime">
                <langSet xml:lang="en-US"><tig><term>Gametime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs to be turned on before you can customize settings. You can turn it on in .">
                <langSet xml:lang="en-US"><tig><term>Gametime needs to be turned on before you can customize settings. You can turn it on in .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏣᏱᎶᎦ ᏧᏚᎸᏓ ᎾᎿᎢ ᎨᎡᎢ ᎠᏍᏚᎢᏓ ᎠᏏᏅ ᏂᎯ ᏰᎵᏯ ᎠᏤᎲᏍᏙᏗ ᏕᎦᎧᎲᎢ ᏂᎯ ᏰᎵᏯ ᎠᎦᏔᎲᏍᏗ ᎨᎡᎢ ᎤᎿᎢ ᎾᎿ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Dolby game audio enhancements while you're gaming">
                <langSet xml:lang="en-US"><tig><term>Turn on Dolby game audio enhancements while you're gaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ Dolby ᏗᏁᎸᏙᏗ ᎤᏃᏴᎬ ᎠᏔᏃᎯᏍᏔᏅᎩ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏕᎭᏁᎸᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime needs permission to access background data to identify apps as games. Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime needs permission to access background data to identify apps as games. Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏚᏚᎸᏛᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎢ ᎪᏟᏍᏙᏗ ᏗᎬᏙᏗ ᎾᏍᎩ ᏧᎾᏁᎸᏙᏗ. ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="While you're gaming, you can access settings through the sidebar. You can also find settings in the Moto app anytime.">
                <langSet xml:lang="en-US"><tig><term>While you're gaming, you can access settings through the sidebar. You can also find settings in the Moto app anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏕᎭᏁᎸᏗᏍᎬᎢ, ᏂᎯ ᏰᎵᏊ ᎠᏴᏍᏗ ᏕᎦᎧᎲᎢ ᏬᎶᎯᏍᏗ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ. ᏂᎯ ᏰᎵᏊ ᎾᏍᏉ ᏱᏩᏔ ᏕᎦᎧᎲᎢ ᎾᎿᎢ Moto ᎬᏙᏗ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to remove  from the list? You won't be able to use Moto Gametime tools and settings after it's removed.">
                <langSet xml:lang="en-US"><tig><term>Do you want to remove  from the list? You won't be able to use Moto Gametime tools and settings after it's removed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎢ ᎠᎲᏍᏗ  ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᏕᎦᏅᏛᎢ? ᏂᎯ Ꮭ ᎨᏨᏙᏗ ᏱᎨᏎᏍᏗ Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏗᎬᏔᏂᏓᏍᏗ ᎠᎴ ᏕᎦᎧᎲᎢ ᎤᏟ ᏭᏩᏚᏛᎢ ᎾᏍᎩ ᎠᎲᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Games">
                <langSet xml:lang="en-US"><tig><term>Games</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs permission to use background data">
                <langSet xml:lang="en-US"><tig><term>Gametime needs permission to use background data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎬᏙᏓ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime can display content around the camera cutout for a full screen experience. You can turn it on anytime by going to Moto &gt; Moto Gametime &gt; Settings. Games may restart after you turn on full screen">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime can display content around the camera cutout for a full screen experience. You can turn it on anytime by going to Moto &gt; Moto Gametime &gt; Settings. Games may restart after you turn on full screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏰᎵᏊ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎦᎸᏛᎢ ᎬᏩᏕᏱᏛ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎦᏖᏅᏕᏓ ᎾᏍᎩ ᎧᎵᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎦᏙᎲᏒᎢ. ᏂᎯ ᏰᎵᏊ ᏱᏍᏚᎢ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ ᎬᏗ ᎮᎬᎢ ᎾᎾᎢ Moto &gt; Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ &gt; ᏕᎦᎧᎲᎢ. ᏧᎾᏁᎶᏗ ᏰᎵᏊ ᏥᎭᏂᎩᏍᏓ ᎤᏟ ᏭᏩᏚᏛᎢ ᎯᏍᏚᎢᏍᎬ ᎧᎵᎢ ᎠᏴᏙᎳᏛᎢ ᎪᏕᏍᏗᎢ ᏗᏐᎥᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission label to read Moto Gametime provider">
                <langSet xml:lang="en-US"><tig><term>Permission label to read Moto Gametime provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎦᏯᎸᏗ ᎾᎢ ᎠᎪᎵᏰᏗ Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime gives you easy access to tools and settings that enhance your gaming experience.">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime gives you easy access to tools and settings that enhance your gaming experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏕᏣᏁᎭ ᎠᎯᏗᎨᎢ ᎠᏴᏍᏗ ᎾᎢ ᏗᎬᏔᏂᏓᏍᏗ ᏃᎴ ᎦᎦᎧᎲᎢ ᎾᏍᎩᎾᎢ ᏓᏤᎴᏍᏗ ᏕᎭᏁᎸᏗᏍᎬᎢ ᏣᎦᏙᎲᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Some Moto Actions may conflict with game controls, so blocking them will prevent potential disruptions. They will only be blocked while you're gaming.">
                <langSet xml:lang="en-US"><tig><term>Some Moto Actions may conflict with game controls, so blocking them will prevent potential disruptions. They will only be blocked while you're gaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ Moto ᏗᎵᏖᎸᏗ ᏰᎵᏉ ᏗᎦᏘᎴᎩ ᎬᏗ ᏗᏁᎸᏙᏗ ᏗᎯᎸᏍᏗ, ᎾᏍᎩᎾᏃ ᏓᏂᏐᎭᎾᎳᏗᏍᎬᎢ ᎠᏎᎢ ᎠᏲᏍᏙᏗᏍᎩ ᎢᏳᎵᏍᏙᏗ ᏗᏲᏍᏔᏅᎯ ᏱᏂᎦᎵᏍᏓ. ᎾᏍᎩᏛ ᎠᏎ ᎤᏩᏌ ᎦᏐᎭᎾᎳ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏕᎭᏁᎶᎲᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery Saver turns on if your battery is likely to run out before your next typical charge">
                <langSet xml:lang="en-US"><tig><term>Battery Saver turns on if your battery is likely to run out before your next typical charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎯᏍᏚᎢ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᎠᎢᏎᏍᏗ ᎦᏅᎪᏫᏛ ᎠᏏᏅ ᏣᏤᎵ ᎬᏂᏗᏍᏔᏅᎢ ᏐᎢ ᎤᏠᏱᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime enhances your gaming experience">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime enhances your gaming experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏓᏤᏢᎩ ᏣᏤᎵ ᏕᎭᏕᎶᎲᏍᎬᎢ ᎠᎦᏙᎲᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you add games to this list, Moto Gametime will open automatically when you start playing">
                <langSet xml:lang="en-US"><tig><term>When you add games to this list, Moto Gametime will open automatically when you start playing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎯᏁᏉᏍᏔᏅ ᏧᎾᏁᎸᏙᏗ ᎯᎠ ᏕᎦᏅᏛᎢ, Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᎠᏎᎢ ᏛᎵᏍᏚᎢᏏ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎾᎯᏳ ᏂᎯ ᎭᎴᏅᎲᎢ ᏕᎭᏁᎸᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime needs permission to use background data">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime needs permission to use background data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎨᎬᏙᏓ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime doesn't control how third party apps appear in freeform mode. Certain app features may not be available or fully functioning in freeform mode.">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime doesn't control how third party apps appear in freeform mode. Certain app features may not be available or fully functioning in freeform mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏝᏍᏓ ᎠᎯᎸᏍᏗ ᏰᎵ ᏦᎢᏁ ᎤᎾᏓᏟᏌᎲ ᏗᎬᏙᏗ ᎤᎾᏄᎪᎢᏍᏗ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ. ᏑᏓᎴᎩ ᎬᏙᏗ ᏗᎦᏎᏍᏙᏗ ᏰᎵᏉ ᎭᏗ ᎨᏒᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎠᎴᏃ ᎧᎵᏬᏒᎢ ᏧᏂᎸᏫᏍᏓᏗ ᎾᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No usage from last full charge">
                <langSet xml:lang="en-US"><tig><term>No usage from last full charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎬᏙᏗᎢ ᎾᏍᎩᎾ ᎣᏂ ᎧᎵ ᎬᏂᏗᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Moto Gametime, it needs permission to be displayed over other apps. Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>To use Moto Gametime, it needs permission to be displayed over other apps. Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ, ᎾᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎨᏒᎢ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᎦᏬᎯᎸᏓ ᏐᎢ ᏗᎬᏙᏗ. ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime is on">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᎾᏍᎩ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Take your gaming to the next level with Moto's tools &amp; settings">
                <langSet xml:lang="en-US"><tig><term>Take your gaming to the next level with Moto's tools &amp; settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏫᏓ ᏣᏤᎵ ᏕᎭᏁᎶᎲᏍᎬᎢ ᎾᎢ ᎾᏍᎩ ᏗᏐᎢ ᎬᏗ Moto ᏧᏤᎵ ᏗᎬᏔᏅᏓᏍᏗ &amp; ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows Moto Gametime to know when a game starts so it can open at the right time">
                <langSet xml:lang="en-US"><tig><term>Allows Moto Gametime to know when a game starts so it can open at the right time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ Moto ᏗᏁᎸᏙᏗ ᎠᏣᏱᎶᎦ ᎾᎢ ᎠᎦᏙᎥᏒ ᎾᎯᏳ ᏗᏁᎸᏙᏗ ᏓᏓᎴᏂᏍᎬᎢ ᎾᏍᎩᎾᏃ ᏰᎵᏊ ᏯᎵᏍᏚᎢ ᎾᏍᎩ ᏚᏳᎪᏛᎢ ᎠᏥᎢᎵᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Head to Moto Gametime settings to start enjoying a better way to game.">
                <langSet xml:lang="en-US"><tig><term>Head to Moto Gametime settings to start enjoying a better way to game.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏙᏓ ᎾᎾᎢ Moto ᏗᏁᎸᏙᏗ ᎠᏣᏱᎶᎦ ᏕᎦᎧᎲᎢ ᎾᎢ ᎠᎴᏅᏗᎢ ᎠᎵᎮᎵᏍᏓ ᎾᏍᎩ ᏓᏤᏢᎩ ᏯᏛᏁᏗ ᎾᎢ ᏗᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to navigate with simple gestures">
                <langSet xml:lang="en-US"><tig><term>Learn how to navigate with simple gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏙᎡᎵ ᎾᎿᎢ ᎪᏪᎸ ᎠᏓᏅᏏᏓᏍᏗ ᎠᎯᏓ ᏧᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to get around your phone with simple gestures. You can change your navigation preferences in Settings anytime.">
                <langSet xml:lang="en-US"><tig><term>Learn how to get around your phone with simple gestures. You can change your navigation preferences in Settings anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏙᎡᎵ ᎾᎿᎢ ᎠᎩᏍᏗ ᎠᏕᏯᏍᏗ ᏗᏟᏃᎮᏗ ᏣᏤᎵ ᎬᏗ ᎠᎯᏓ ᏧᏬᏯᏂᏍᎩ. ᏰᎵᏯ ᏣᏁᏟᏴᏍᏗ ᎠᏓᏘᏂᏙᎯ ᏣᏤᎵ ᎤᏟᎠᏰᎸᏍᎬᎢ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from the bottom of the screen and hold">
                <langSet xml:lang="en-US"><tig><term>Swipe up from the bottom of the screen and hold</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎾᎿᎢ ᎡᎳᏗᏨ ᎾᎿ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᎯᏂᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Almost, try again">
                <langSet xml:lang="en-US"><tig><term>Almost, try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥᏂᎨᏍᏗ, ᏏᏊ ᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from the bottom of the screen">
                <langSet xml:lang="en-US"><tig><term>Swipe up from the bottom of the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎭᏫᏂ ᎾᎿᎢ ᎠᏴᏙᎳᏛᎢ ᏣᏤᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not Now">
                <langSet xml:lang="en-US"><tig><term>Not Now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart contacts">
                <langSet xml:lang="en-US"><tig><term>Smart contacts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᏗᏟᏃᎮᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart SIM makes calls based on your history of calls, just like you did in your recent calls.">
                <langSet xml:lang="en-US"><tig><term>Smart SIM makes calls based on your history of calls, just like you did in your recent calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ SIM ᎪᏢᏗ ᏓᏯᏂ ᏓᎳᏏᏔᏅᎩ ᎤᎿᎢ ᏂᏨᎤᎢ ᏂᏧᎵᏍᏔᏅᏒ ᎾᎿᎢ ᏓᏯᏂ, ᎩᎳ ᎯᎸᏉᏗ ᏂᎯ ᏄᏛᏁᎸ ᎾᎿ ᏂᏨᎤᎢ ᎾᏞᎬ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notification displayed to suggest Smart SIM Profile setup">
                <langSet xml:lang="en-US"><tig><term>Notification displayed to suggest Smart SIM Profile setup</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᏣᎳᏁᎯ ᎠᏓᏴᎳᏔᏍᎩ ᎾᎿᎢ ᎧᏁᎢᏍᏙᏗ ᎠᏌᎹᏗ SIM ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use  for mobile data?">
                <langSet xml:lang="en-US"><tig><term>Use  for mobile data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ  ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart SIM">
                <langSet xml:lang="en-US"><tig><term>Smart SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart SIM makes calls based on your contacts's carrier, just like you did in your recent calls.">
                <langSet xml:lang="en-US"><tig><term>Smart SIM makes calls based on your contacts's carrier, just like you did in your recent calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ SIM ᎪᏢᏗ ᏓᏯᏂ ᏓᎳᏏᏔᏅᎩ ᎤᎿᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᎠᏫᏗᏍᎩ, ᎩᎳ ᎯᎸᏉᏗ ᏂᎯ ᏄᏛᏁᎸ ᎾᎿ ᏂᏨᎤᎢ ᎾᏞᎬ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Operation is not allowed since the phone is either in an active call or in Emergency Callback Mode. Please try again after the call.">
                <langSet xml:lang="en-US"><tig><term>Operation is not allowed since the phone is either in an active call or in Emergency Callback Mode. Please try again after the call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎢᏒᎢ ᏝᏯᎵᏍᎪᎸᏗ ᏏᏅ Ꮎ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎢᏧᎳᏊ ᎾᎿ Ꭰ ᎬᏂᎦᎵᏍᏗ ᏪᏯᎾ ᏃᎴ ᎾᎿ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᏪᏯᎾ ᎠᏨᏍᏗ ᎬᏙᏗ. ᎰᏩᏊ ᏏᏊ ᏥᎭᏁᎸᏓ ᎣᏂᏗᏨ ᏥᎩ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart SIM">
                <langSet xml:lang="en-US"><tig><term>Smart SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="DON'T ASK AGAIN">
                <langSet xml:lang="en-US"><tig><term>DON'T ASK AGAIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏏᏊ ᏥᎭᏛᏛᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enabling Smart SIM means a SIM card will be selected automatically based on the carrier of your contact's phone number. If a SIM of the same carrier is not found, phone learns your usage pattern to choose the best SIM for an outgoing voice call.Smart SIM will use your data connection periodically to determine carrier information for your contact numbers. The data usage may incur additional charges for you from your carrier. Also, we may choose a SIM which is not on the same carrier as your contact since the contact may have ported their number to another carrier before Smart SIM performs its periodic update.Smart SIM doesn't add or change the carrier code (CSP) and doesn't add the DDD when making long distance voice calls. Long distance voice calls are charged based on CSP and charges can vary.Smart SIM uses information about carriers provided by Anatel (National Telecom Agency) and by ABR Telecom, Motorola is not responsible for the accuracy of this information.">
                <langSet xml:lang="en-US"><tig><term>Enabling Smart SIM means a SIM card will be selected automatically based on the carrier of your contact's phone number. If a SIM of the same carrier is not found, phone learns your usage pattern to choose the best SIM for an outgoing voice call.Smart SIM will use your data connection periodically to determine carrier information for your contact numbers. The data usage may incur additional charges for you from your carrier. Also, we may choose a SIM which is not on the same carrier as your contact since the contact may have ported their number to another carrier before Smart SIM performs its periodic update.Smart SIM doesn't add or change the carrier code (CSP) and doesn't add the DDD when making long distance voice calls. Long distance voice calls are charged based on CSP and charges can vary.Smart SIM uses information about carriers provided by Anatel (National Telecom Agency) and by ABR Telecom, Motorola is not responsible for the accuracy of this information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᎠᏌᎹᏗ SIM ᎤᏅᏔᏂᏓᏍᏗ Ꭰ SIM ᏆᎾᏲᏍᏗ ᎠᏎ ᎨᎡᎢ ᎠᏑᏰᏛ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏓᎳᏏᏔᏅᎩ ᎤᎿᎢ ᏥᎩ ᎠᏫᏗᏍᎩ ᎾᎿ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ. ᎾᎿ Ꭰ SIM ᎾᎿ ᏥᎩ ᎤᏠᏱ ᎠᏫᏗᏍᎩ ᎨᎡᎢ ᎥᏝ ᎠᏩᏛᏓ, ᏗᏟᏃᎮᏗ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᎬᏗᏍᎬ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᏣᏑᏰᏍᏗ ᏥᎩ ᏫᏓᏤᏢ SIM ᎤᎬᏩᏟ Ꭰ ᎤᎵᎶᎲᏍᎩ ᎤᏁᎬ ᏪᏯᎾ.ᎠᏌᏑᏗ SIM ᎠᏎ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎢᏳᏓᎵᏊ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᎠᏫᏗᏍᎩ ᎧᏃᎮᏢᏗ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᏗᏎᏍᏗ. ᏥᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ ᏰᎵᏯ ᏂᏓᏳᏓᎴᏅᏛ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏓᎬᏩᎶᏗᏍᎬ ᎤᎬᏩᏟ ᏂᎯ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᎠᏫᏗᏍᎩ. ᎾᏍᏊ, ᎢᏧᎳ ᏰᎵᏯ ᏣᏑᏰᏍᏗ Ꭰ SIM ᎦᏙᎤᏍᏗ ᎨᎡᎢ ᎥᏝ ᎤᎿᎢ ᏥᎩ ᎤᏠᏱ ᎠᏫᏗᏍᎩ ᎤᎿ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᏥᎨᏒ ᏥᎩ ᏗᏟᏃᎮᏙᏗ ᏰᎵᏯ ᎤᎭ ᎫᏓᎸᏗ ᏫᎦᏅᎥᏍᎬᎢ ᎤᎾᏤᎵ ᎠᏎᏍᏗ ᎾᎿᎢ ᏄᏓᎴ ᎠᏫᏗᏍᎩ ᎤᏓᎷᎸ ᎠᏌᎹᏗ SIM ᎠᎵᏂᎬᏁᏗ ᎨᎡᎢ ᏱᎪᎯᏓ ᏗᎪᏒᎯᏌᏅᎯ.ᎠᏌᏑᏗ SIM ᏝᏍ ᏗᎧᏁᏉᏍᏗ ᏃᎴ ᎦᏁᏟᏴᏍᏗ ᏥᎩ ᎠᏫᏗᏍᎩ ᎠᏍᏓᏩᏛᏍᏙᏗ (CSP) ᏃᎴ ᏝᏍ ᏗᎧᏁᏉᏍᏗ ᏥᎩ DDD ᎢᏳᏃ ᎪᏢᏍᎦ ᎤᏓᏅᎯᏓ ᎤᏁᎬ ᏓᏯᏂ. ᎤᏓᏅᎯᏓ ᎤᏁᎬ ᏓᏯᏂ ᎨᎡᎩ ᏗᎬᏩᎶᏔᏅ ᏓᎳᏏᏔᏅᎩ ᎤᎿᎢ CSP ᏃᎴ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏯ ᏧᏓᎴᎾᎢ.ᎠᏌᏑᏗ SIM ᎬᏔᏂᏓᏍᏗ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᎠᏂᎯᏙᎯ ᎠᏛᏅᎢᏍᏛ ᎬᏗ Anatel (ᎠᏰᎵ ᏗᎾᎦᎳᏔᏅ ᏗᏜᏃᎮᏗᏍᎩ ᏗᎦᏘᏲᎢ) ᏃᎴ ᎬᏗ ABR ᏗᎾᎦᎳᏔᏅ ᏗᏜᏃᎮᏗᏍᎩ, Motorola ᎨᎡᎩ ᎥᏝ ᎤᎾᏚᏓᎸ ᎤᎬᏩᏟ ᏥᎩ ᎧᎵᏗᏙᎳᎩ ᎾᎿᎢ ᎯᎠ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Extends battery life and improves device performance by automatically managing your network connections">
                <langSet xml:lang="en-US"><tig><term>Extends battery life and improves device performance by automatically managing your network connections</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎬᏅᎢ ᏥᏅᎯᏗᏍᏗ ᎠᎴ ᏦᎦᏤᎳᏍᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎾᏛᏁᎲ ᎬᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᎯᎸᏍᏗ ᏣᏤᎵ ᏧᎾᏚᏓᎵ ᏓᎵᎪᏗᏍᎬ</term></tig></langSet>
            </termEntry>
