                <langSet xml:lang="chr"><tig><term>ᎦᏣᏄᎳ ᎠᏨᏍᏙᏗ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏏᏉ ᏂᎯ ᎨᎡᎩ ᎬᏗᎭ ᎯᎠ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe right for recent apps">
