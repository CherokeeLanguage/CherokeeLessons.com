                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᎠᎦᏔᎲᎠ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="This is especially helpful when you’re taking photos of children.">
