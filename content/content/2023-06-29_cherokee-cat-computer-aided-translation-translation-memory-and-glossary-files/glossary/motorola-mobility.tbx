                <langSet xml:lang="en-US"><tig><term>Secure data:\u0020</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎾᏰᎯᏍᏛᎾᏉ ᎦᏘᏍᎩᏌᏅᎯ:\u0020</term></tig></langSet>
            </termEntry>
