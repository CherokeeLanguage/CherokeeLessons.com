            </termEntry>
            <termEntry id="Application is currently unavailable.">
                <langSet xml:lang="en-US"><tig><term>Application is currently unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏲᏍᏙᏗ ᏄᏍᏛ ᏃᏊᎨᏒᎢ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ.</term></tig></langSet>
