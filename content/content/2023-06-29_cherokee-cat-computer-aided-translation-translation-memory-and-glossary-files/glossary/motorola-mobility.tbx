                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎯᏍᎪᎸᏓ ᎠᏍᏆᏂᎪᏙᏗ ᎤᎬᏩᏟ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You won\’t have access to data or the internet through . Internet will only be available via Wi\u2011Fi.">
                <langSet xml:lang="en-US"><tig><term>You won\’t have access to data or the internet through . Internet will only be available via Wi\u2011Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎤᎭ ᎠᏴᏍᏗ ᎾᎿᎢ ᎦᏘᏍᎩᏌᏅᎯ ᏃᎴ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎠᎦᏛᎴᏍᎩ . ᎠᏏᎳᏕᏫᏒᎢ ᎠᏎ ᎤᏅᏒ ᎨᏒᎩ ᎠᏛᏅᎢᏍᏔᏅ ᎾᎿ ᎢᏗᏨ Wi\u2011Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device administrator may be able to access data associated with this device, manage apps, and change this device\’s settings.">
                <langSet xml:lang="en-US"><tig><term>Your device administrator may be able to access data associated with this device, manage apps, and change this device\’s settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩᎡᎵᏊ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᏴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏚᎵᎪᏒᎢ ᎬᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᏓᏅᏖᎵᏓᏍᏗ ᏗᎬᏙᏗ, ᏃᎴ ᎦᏁᏟᏴᏍᏗ ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Provider is in use.">
                <langSet xml:lang="en-US"><tig><term>Provider is in use.</term></tig></langSet>
