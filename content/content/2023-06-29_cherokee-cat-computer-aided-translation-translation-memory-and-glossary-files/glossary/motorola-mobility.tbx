                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎢ ᎠᎾᎦᎵᏍᎩ ᎭᏗᏍᎬ Ꮎ Wi\u2011Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to mobile data if Wi\u2011Fi loses internet access.">
                <langSet xml:lang="en-US"><tig><term>Switch to mobile data if Wi\u2011Fi loses internet access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎠᏂᎩᏍᎩ ᎦᏟᏌᎾ Ꮎ Wi\u2011Fi ᎢᏣᏲᎱᏎᎵ ᎠᏏᎳᏕᏫᏒᎢ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" switched to Voice call">
                <langSet xml:lang="en-US"><tig><term> switched to Voice call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏓᏁᏟᏴᎢ ᎾᎿᎢ ᎤᏁᎬ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to mobile data automatically">
                <langSet xml:lang="en-US"><tig><term>Switch to mobile data automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏯᏍᏗ ᎠᏂᎩᏍᎩ ᎦᏟᏌᎾ ᎤᏩᏌᏇ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use mobile data when Wi\u2011Fi has no internet access.">
                <langSet xml:lang="en-US"><tig><term>Use mobile data when Wi\u2011Fi has no internet access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏓ ᎠᏂᎩᏍᎩ ᎦᏟᏌᎾ ᎢᏳᏃ Wi\u2011Fi ᎢᎫᏓᎸᎾ ᏱᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage charges may apply.">
                <langSet xml:lang="en-US"><tig><term>Data usage charges may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᎾ ᎲᏗᏍᎨᏍᏗ ᏗᎬᏩᎶᏗᏍᎩ</term></tig></langSet>
