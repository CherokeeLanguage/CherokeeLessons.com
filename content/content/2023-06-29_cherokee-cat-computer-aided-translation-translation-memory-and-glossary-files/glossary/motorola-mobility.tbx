                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎢᏣᏙᏢᏒᎢ\u2019s ᎤᎦᏎᏍᏗᏕᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not compatible with noise cancelling headphones.">
                <langSet xml:lang="en-US"><tig><term>Not compatible with noise cancelling headphones.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏗᎪᎵᎩ ᎬᏗ ᎤᏃᏴᎬ  ᎠᏎᏍᎬ headphones.</term></tig></langSet>
            </termEntry>
            <termEntry id="Current screen lock">
                <langSet xml:lang="en-US"><tig><term>Current screen lock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᏓᎩᏍᏏ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face enrollment time limit reached.">
                <langSet xml:lang="en-US"><tig><term>Face enrollment time limit reached.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᏕᎪᏪᎸ ᏚᎾᏙᎥ ᎠᏟᎢᎵᏒ ᎠᏎᎸᎯ ᏭᎷᏨᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can add up to  faces">
