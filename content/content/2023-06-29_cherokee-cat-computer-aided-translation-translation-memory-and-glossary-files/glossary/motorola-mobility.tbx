                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎩ ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Always keep mobile data active, even when Wi\u2011Fi is active (for fast network switching).">
