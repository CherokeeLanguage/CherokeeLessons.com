            </termEntry>
            <termEntry id="Please enter the verification code">
                <langSet xml:lang="en-US"><tig><term>Please enter the verification code</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏗ ᎾᏍᎩ ᎪᎯᏳᏗᏍᎩ ᎠᏍᏓᏩᏛᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Lenovo ID login">
                <langSet xml:lang="en-US"><tig><term>Lenovo ID login</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎴᏃᏉ ID ᏙᏙᎥ ᎪᏪᎶᏗ</term></tig></langSet>
            </termEntry>
