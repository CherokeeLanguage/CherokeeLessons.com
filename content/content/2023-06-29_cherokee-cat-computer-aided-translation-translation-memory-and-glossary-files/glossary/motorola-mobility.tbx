                <langSet xml:lang="en-US"><tig><term>Specific Friends</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏙᎳᎩ ᏗᎦᎵᎢ</term></tig></langSet>
            </termEntry>
