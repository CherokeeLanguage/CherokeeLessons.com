            </termEntry>
            <termEntry id="Use your face to unlock your phone or for authentication in apps, like when you sign in or approve a purchase.">
                <langSet xml:lang="en-US"><tig><term>Use your face to unlock your phone or for authentication in apps, like when you sign in or approve a purchase.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᎴ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ, ᎯᎸᏉᏗ ᎢᏳᏃ ᏂᎯ ᏚᏙᎥ ᎪᏪᎶᏗ ᎠᎴ ᎪᎯᏳᏙᏗ Ꭰ ᎠᏩᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep in mind:You can only have one face set up at a time.">
                <langSet xml:lang="en-US"><tig><term>Keep in mind:You can only have one face set up at a time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᎾᎿ ᎤᏓᏅᏛ:ᏂᎯ ᏰᎵᏯ ᎤᏅᏒ ᎤᎭ ᏌᏇ ᎧᏁᏉᏍᏗᏍᎬ ᎦᎧᎲᏍᎬᎢ ᎤᎿᎢ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Charge more efficiently to keep your battery healthy">
                <langSet xml:lang="en-US"><tig><term>Charge more efficiently to keep your battery healthy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᏗᏍᏔᏅᎢ ᎤᏥ ᎢᎦᎢ ᏓᏤᏢ ᎢᏳᎵᏍᏙᏗᎢ ᎾᎿᎢ ᎠᏍᏆᏂᎪᏙᏗᎢ ᎠᎾᎦᎵᏍᎩ ᏅᏩᏙᎯᏯᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Forget device">
                <langSet xml:lang="en-US"><tig><term>Forget device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎨᏫᏒ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disconnect App?">
                <langSet xml:lang="en-US"><tig><term>Disconnect App?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎱᏓᎳᎩ ᎬᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone can be unlocked by someone else if it\u2019s held up to your face.">
                <langSet xml:lang="en-US"><tig><term>Your phone can be unlocked by someone else if it\u2019s held up to your face.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᎨᏒᎩ ᎠᏂᏐᎭᎾᎳᎩ ᎬᏗ ᎪᎱᏍᏗ ᏄᏓᎴᎢ ᎢᏳᏃ ᎢᎩ ᎤᏂᏴᏒᎢ ᎦᎸᎳᏗ ᎾᎿᎢ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="See how it works">
                <langSet xml:lang="en-US"><tig><term>See how it works</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎪᏩᏔ ᏰᎵ ᏂᎦᎵᏍᏗᏍᎬ ᏚᎸᏫᏍᏓᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can install other apps">
                <langSet xml:lang="en-US"><tig><term>Can install other apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏊ ᎯᏘᏅᏛᎦ ᏐᎢ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="CAPTURE SETTINGS">
                <langSet xml:lang="en-US"><tig><term>CAPTURE SETTINGS</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏗ ᏕᎦᎧᎲᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id=" will be disconnected from media audio.">
                <langSet xml:lang="en-US"><tig><term> will be disconnected from media audio.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᏎᏍᏗ ᎱᏓᎳᎩ ᏅᏓᏳᏓᎴᏅᎯ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᎤᏃᏴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Optimize">
                <langSet xml:lang="en-US"><tig><term>Optimize</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏍᏓ ᏳᎵᏍᏙᏗᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone can be unlocked by someone who looks a lot like you, like an identical sibling.">
                <langSet xml:lang="en-US"><tig><term>Your phone can be unlocked by someone who looks a lot like you, like an identical sibling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᎨᏒᎩ ᎠᏂᏐᎭᎾᎳᎩ ᎬᏗ ᎪᎱᏍᏗ ᎦᎪ ᎠᎦᏘᎭ ᎤᎪᏓ ᎯᎸᏉᏗ ᏂᎯ, ᎯᎸᏉᏗ Ꭰ ᎪᎵᏨᎢ ᎣᏣᏝᏅᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Looking at the phone can unlock it when you don\u2019t intend to.">
                <langSet xml:lang="en-US"><tig><term>Looking at the phone can unlock it when you don\u2019t intend to.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏖᏃᎲ ᎤᎿᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᎠᏂᏐᎭᎾᎳᎩ ᎢᏳᏃ ᏂᎯ ᏞᏍᏗ ᏃᎵᏍᎬ ᎾᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow  to ignore battery optimizations?">
                <langSet xml:lang="en-US"><tig><term>Allow  to ignore battery optimizations?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏁᏗ  ᎾᎢ ᎠᎦᏎᏍᏙᏗ ᏂᎨᏒᎾ ᎠᎾᎦᎵᏍᎩ ᏧᏃᏢᎯᏐᏗ ᏩᏂᎨ ᏗᎦᎾᏗᏅᏗ?</term></tig></langSet>
