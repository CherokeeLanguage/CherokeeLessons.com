            <termEntry id="To use the apps, photos, or data this ^1 contains, reinsert it.">
                <langSet xml:lang="en-US"><tig><term>To use the apps, photos, or data this ^1 contains, reinsert it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᏗᎬᏙᏗ, ᏗᏟᎶᏍᏔᏅᎯ, ᎠᎴ ᎦᏟᏌᏅᎯ ᎯᎠ ^1 ᏕᎦᎸᏛᎢ, ᎠᏍᏓᏩᏛᏍᏙᏗ ᎨᎡᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try user-favorites like Three finger screenshot, Quick capture, Fast flashlight, and more.">
                <langSet xml:lang="en-US"><tig><term>Try user-favorites like Three finger screenshot, Quick capture, Fast flashlight, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᎬᏗᏍᎩ-ᏫᏗᏣᎸᏉᏛ ᎾᏍᎩᏯᏉ ᏦᎢ ᏗᎦᏰᏌᏛ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ, ᎤᏟᏍᏓ ᎦᏂᏴᏗ, ᎦᏣᏄᎳ  ᎠᏨᏍᏗ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Discover unique features from Motorola">
                <langSet xml:lang="en-US"><tig><term>Discover unique features from Motorola</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏛᏗ ᎤᏩᏒᎯᏯ ᏗᎦᏎᏍᏙᏗ ᏂᏓᏳᏓᎴᏅ Motorola</term></tig></langSet>
            </termEntry>
            <termEntry id="Personalize helps you set up your device in a way that reflects your needs and preferences.">
                <langSet xml:lang="en-US"><tig><term>Personalize helps you set up your device in a way that reflects your needs and preferences.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎤᏤᎵ ᏱᎬᏁᏗ ᏍᏕᎵᏍᎩ ᏂᎯ ᏕᎦᎦᎧᎲᏍᎬ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏄᎵᏍᏙᏗ ᎾᏍᎩᎾᎢ ᎬᎾᎨᏒ ᏱᎦᎵᏍᏗᏍᎩ ᏣᏚᎸᏛᎢ ᎠᎴ ᎤᏟ ᏕᎯᏰᎸᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Alternatively, you can choose to forget this storage if the device isn\u2019t available.">
                <langSet xml:lang="en-US"><tig><term>Alternatively, you can choose to forget this storage if the device isn\u2019t available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᎵᏴᏍᏗᏍᎩ, ᏂᎯ ᏰᎵᏯ ᎭᏑᏯᎩ ᎾᎿᎢ ᏧᏩᎨᏩ ᎯᎠ ᎠᏍᏆᏂᎪᏙᏗ ᎨᎡᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose font styles, wallpapers, icon shapes, and more to make your device unique.">
                <langSet xml:lang="en-US"><tig><term>Choose font styles, wallpapers, icon shapes, and more to make your device unique.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏄᏍᏛ ᎠᏙᏪᎵᏍᎩ ᏄᏍᏛ ᎪᏪᎶᏗ, ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ, ᎠᎢᎧᏂ ᏚᏙᏢᏒᎢ, ᎠᎴ  ᎤᏟ ᎢᎦᎢ ᎾᎢ ᎪᏢᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏩᏒᎯᏯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Home screen is where you’ll find widgets, favorite apps, and more.">
                <langSet xml:lang="en-US"><tig><term>The Home screen is where you’ll find widgets, favorite apps, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎤᎾᎢ ᏂᎯᏊᏃ ᎠᏩᏛᏗ ᏗᏫᏥᏘ, ᏫᎦᎸᏉᏛ ᏗᎬᏙᏗ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down from any screen to open the notification curtain.">
                <langSet xml:lang="en-US"><tig><term>Swipe down from any screen to open the notification curtain.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎡᎳᏗᏟ ᏂᏓᏳᏓᎴᏅ ᏂᎦᎥᏉ ᎠᏴᏙᎳᏛᎢ ᎠᏍᏚᎢᏓ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏯᏙᎳᏛᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It’s your destination for learning about your device and making it work the way you want.">
                <langSet xml:lang="en-US"><tig><term>It’s your destination for learning about your device and making it work the way you want.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᏣᏤᎵ ᏭᎦᏛᎢ ᎾᏍᎩᎾ ᎤᎾᏕᎶᏆᏍᏗ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴ ᏗᏙᎵᎩ ᏧᎸᏫᏍᏓᏁᏗ ᎾᏍᎩ ᏳᎵᏍᏙᏗ ᏣᏚᎵᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To edit quick settings, tap on the pencil in the bottom left corner.">
