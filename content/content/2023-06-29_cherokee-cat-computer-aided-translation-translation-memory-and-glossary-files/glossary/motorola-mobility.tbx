                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᎠᏓᏛᏗ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id=" is a provider of location services for this device. Location access can be modified from location settings.">
                <langSet xml:lang="en-US"><tig><term> is a provider of location services for this device. Location access can be modified from location settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᎡᎢ Ꭰ ᎠᏓᏁᎸᏍᎩ ᎾᎿ ᎤᏙᏢᏒᎢ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎤᎬᏩᏟ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᎤᏙᏢᏒᎢ ᎠᏴᏍᏗ ᏰᎵᏊ ᎦᏁᏟᏴᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎤᏙᏢᏒᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Limiting battery usage for  app">
                <langSet xml:lang="en-US"><tig><term>Limiting battery usage for  app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎯ ᎠᎾᎦᎵᏍᎩ ᎬᏙᏗᎢ ᎤᎬᏩᏟ  ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: RTT is not available while roaming">
                <langSet xml:lang="en-US"><tig><term>Note: RTT is not available while roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ: RTT ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎢᏳᏃ ᎡᏙᎵᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="The old PIN you typed isn't correct. Try again.">
                <langSet xml:lang="en-US"><tig><term>The old PIN you typed isn't correct. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᎣᏍᏓᏂᎨᏒᎾ PIN ᏗᏐᏅᏍᏔᎾᎯ Ꮭ ᏚᏳᎪᏛ ᏱᎩ ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Old PIN2 incorrect. Try again.">
                <langSet xml:lang="en-US"><tig><term>Old PIN2 incorrect. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏪᏘ PIN2 ᏂᏚᏳᎪᏛᎾ ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Update">
                <langSet xml:lang="en-US"><tig><term>Update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
