            </termEntry>
            <termEntry id="Allows the app to change the state of tethered network connectivity.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to change the state of tethered network connectivity.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᏄᏍᏛ ᎾᏍᎩ ᏄᏓᎴ ᎫᏓᎸᏙᏗ ᏧᎾᏚᏓᎵ ᏕᎫᏓᎸᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Too similar, please change your pose.">
                <langSet xml:lang="en-US"><tig><term>Too similar, please change your pose.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎤᏠᏱᎨᎢᏍᏗ, ᎰᏩᏊ ᎯᏁᏟᏴᎾ ᏣᏤᎵ ᏄᏍᏛ ᎯᏙᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When Explore by Touch is turned on, you can hear or see descriptions of what's under your finger or perform gestures to interact with the tablet.">
                <langSet xml:lang="en-US"><tig><term>When Explore by Touch is turned on, you can hear or see descriptions of what's under your finger or perform gestures to interact with the tablet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎪᎷᏅᏓ ᎬᏗ ᎠᏒᏂᏍᏗ ᎾᏍᎩ ᎠᏍᏚᎢᏍᏓ, ᏂᎯ ᏰᎵᏊ ᎠᏛᎪᏗ ᎠᎴᏃ ᎠᎪᏩᏛᏗ ᏂᏚᏍᏛ ᏗᎧᏃᏗ ᎥᎿᎢ ᎢᏳᏍᏗ ᏄᏍᏛ ᎭᏫᏂᏗᏢ ᏣᏤᎵ ᎯᏰᏌᏒᏛᎢ ᎠᎴᏃ ᎢᏯᏛᏁᏗ ᏚᏂᏬᏯᏂᏍᎩ ᎾᎢ ᏓᏟᏃᎮᏍᎬ ᎬᏗ ᎾᏍᎩ ᎪᏪᎶᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone has enough charge.">
                <langSet xml:lang="en-US"><tig><term>Phone has enough charge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎤᎭ ᎡᎮᏊ ᎦᏁᏟ ᏓᎬᏩᎶᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Friend">
                <langSet xml:lang="en-US"><tig><term>Friend</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎵᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This may allow the app to interfere with the operation of the GPS or other location sources.">
                <langSet xml:lang="en-US"><tig><term>This may allow the app to interfere with the operation of the GPS or other location sources.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏉ ᏯᎵᏍᎪᎸᏓ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᏲᏍᏙᏓ ᎬᏗ ᎾᏍᎩ ᏱᎬᏁᏗᎢ ᎥᎿᎢ GPS ᎠᎴᏃ ᏐᎢ ᎤᏙᏢᏒᎢ ᏙᏧᏓᎴᏅᎢ.</term></tig></langSet>
