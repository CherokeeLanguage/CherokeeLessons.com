            <termEntry id="Dolby Atmos provides a premium listening experience through your phone's loudspeaker and connected devices.">
                <langSet xml:lang="en-US"><tig><term>Dolby Atmos provides a premium listening experience through your phone's loudspeaker and connected devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Atmos ᏙᏓᎨᏥᏁᎵ ᎾᏍᎩ ᏫᏓᏤᏢᎢ ᏗᏛᏓᏍᏙᏗ ᎠᎦᏙᎲᏒᎢ ᎤᎶᏒᎯ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎠᏍᏓᏯ ᏗᎦᏬᏂᎯᏍᏙᏗ ᎠᎴ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can blur the background in the Google Photos editor after capturing the photo.">
                <langSet xml:lang="en-US"><tig><term>You can blur the background in the Google Photos editor after capturing the photo.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎤᏍᎪᎸ ᎾᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎾᎿᎢ ᎾᏍᎩ Google ᏗᏓᏟᎶᏍᏔᏅ ᏗᎦᎧᎲᏍᎩ ᎤᎶᏐᏅ ᎦᏂᏱᏍᎬᎢ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
