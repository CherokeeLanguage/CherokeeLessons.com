                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎬᏙᏗᎭ ᎪᏪᎳᎾᎥᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="About caption preferences">
                <langSet xml:lang="en-US"><tig><term>About caption preferences</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ ᎠᏂᏬᏂᏍᎬ ᏕᎪᏪᎸᎢ ᎤᏟ ᎠᏰᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is not supported on the device.">
                <langSet xml:lang="en-US"><tig><term>This app is not supported on the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎨᏒᎩ Ꮭ ᎤᎵᏍᏕᎸᎲ ᎤᎾᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" is removed">
                <langSet xml:lang="en-US"><tig><term> is removed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᏒᎩ ᎠᎲᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="New conversation created.">
                <langSet xml:lang="en-US"><tig><term>New conversation created.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏤ ᎠᎾᏟᏃᎮᏍᎬᎢ ᎤᏬᏢᏅᏁ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No Recipients">
                <langSet xml:lang="en-US"><tig><term>No Recipients</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏗᏂᏁᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Rotate">
                <langSet xml:lang="en-US"><tig><term>Rotate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏗᏆᎸᏕᏯᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Group management:">
                <langSet xml:lang="en-US"><tig><term>Group management:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏡᎬᎢ ᏄᏂᎬᏫᏳᏌᏕᎩ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Create group">
                <langSet xml:lang="en-US"><tig><term>Create group</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᏗ ᎤᎾᏓᏡᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Group name">
                <langSet xml:lang="en-US"><tig><term>Group name</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏡᎬᎢ ᏚᏅᏙᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="You will need to be invited again to rejoin this group. Are you sure you want to leave?">
                <langSet xml:lang="en-US"><tig><term>You will need to be invited again to rejoin this group. Are you sure you want to leave?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᏎᎢ ᎤᏚᎸᏓ ᎾᎿᎢ ᎨᏒᎩ ᎨᏥᏯᏅᏓ ᏏᏊ ᎾᎿᎢ ᎢᎠᏖᎳᏗᏍᏗ ᎯᎠ ᎤᎾᏓᏡᎬᎢ. ᎨᏒᎢ ᏂᎯ ᎤᏙᎯᏳ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎠᏂᎩᏍᎬ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow the app to access data that may survive a factory reset">
                <langSet xml:lang="en-US"><tig><term>Allow the app to access data that may survive a factory reset</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᏴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᎩᎾ ᏰᎵᏉ ᎤᎦᏛᎴᏒ ᎪᎱᏍᏗ ᎤᏃᏢᏗ ᎢᎦᎧᎯᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can easily turn off this feature by tapping on the Optimized charging notification.">
                <langSet xml:lang="en-US"><tig><term>You can easily turn off this feature by tapping on the Optimized charging notification.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎯᏓ ᎠᏍᏚᏗ ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᎬᏗ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎠᏓᏃᏣᎳᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="People also say the motion is like a quick, firm handshake or small, fast karate chops">
                <langSet xml:lang="en-US"><tig><term>People also say the motion is like a quick, firm handshake or small, fast karate chops</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏴᏫ ᎾᏍᏊ ᎠᏛᏅ ᏥᎩ ᎠᏌᎳᏙᏗ ᎨᎡᎢ ᎤᏟᏍᏓ, ᎠᏍᏓᏯ ᏕᎫᎪᏛ ᏦᏰᎾ ᎠᏕᎸᏗᏱ ᎠᎴ ᎤᏍᏗ, ᎠᎹᏟ karate ᎦᎷᏱᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will launch your default assistant.">
                <langSet xml:lang="en-US"><tig><term>This will launch your default assistant.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎭᏂᎩᏍᏙᏗ ᏂᏨᎤᎢ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the toggles to turn gestures on &amp; off, and tap on the descriptions for tutorials and more information.">
                <langSet xml:lang="en-US"><tig><term>Use the toggles to turn gestures on &amp; off, and tap on the descriptions for tutorials and more information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎤᏗᏞᎩ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎤᏬᏯᏂᏍᎩ ᎤᎿᎢ &amp; ᎠᏍᏚᎭ, ᎠᎴ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᏂᏚᏍᏛ ᏗᎧᏃᏗ ᎤᎬᏩᏟ ᏗᏓᏕᏲᎲᏍᎩ ᎠᎴ ᎤᏟ ᎢᎦᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions.">
                <langSet xml:lang="en-US"><tig><term>Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᎨᎢ ᏧᏬᏯᏂᏍᎩ ᎠᎴ ᎠᏒᏂᏍᏗ ᏂᏓᏓᎳᏗᏍᎬ ᎠᎵᏍᏕᎸᏓ ᏂᎯ ᎠᎵᏂᎬᏁᏗ ᏂᏚᎩᏨᏂᏒ ᎢᎦ ᎢᏗᏛᏁᏗ ᎬᏗ ᎤᏟᏍᏓ ᎠᎴ ᎭᏕᎳᎰᏍᎬᎢ ᏗᏓᏅᏏᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Shrink the display size">
                <langSet xml:lang="en-US"><tig><term>Shrink the display size</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏗᎪᎯᏍᏓ ᏥᎩ ᎠᏓᏴᎳᏔᏍᎩ ᎢᎩᏓ ᎨᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show lights for">
                <langSet xml:lang="en-US"><tig><term>Show lights for</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᏗᏨᏍᏗ ᎤᎬᏩᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Because you’ve used your phone more than usual, your battery may run out sooner than it normally would.Apps using most battery:">
                <langSet xml:lang="en-US"><tig><term>Because you’ve used your phone more than usual, your battery may run out sooner than it normally would.Apps using most battery:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎳᏃᎮᏗ ᏕᏣᎲᎢ ᎬᏔᏅᎯ ᎡᏍᎦᏉ ᎤᏠᏱ, ᏣᏤᎵ ᎠᏠᏯᏍᏗ ᏰᎵᏉ ᏞᎯᎨᏍᏗ ᎡᏍᎦᏉ ᏯᏓᎯᏗᏏ ᎠᎢᏎᏍᏗ ᎦᏅᎪᏫᏛ.ᏗᎬᏙᏗ ᎬᏗᎭ ᎠᎾᎦᎵᏍᎩ ᎤᎪᏗ :</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch and hold the sensor until you feel a long buzz.">
                <langSet xml:lang="en-US"><tig><term>Touch and hold the sensor until you feel a long buzz.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᏥᎩ ᎠᏩᏘᏍᎩ ᎩᎳ ᏂᎯ ᎠᏒᎾᏍᏗ Ꭰ ᎢᎪᎯᏓ ᎤᏍᏆᏃᏴᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="People also say the motion is like revving a motorcycle or turning a screwdriver">
                <langSet xml:lang="en-US"><tig><term>People also say the motion is like revving a motorcycle or turning a screwdriver</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏴᏫ ᎾᏍᏊ ᎠᏛᏅ ᏥᎩ ᎠᏌᎳᏛ ᎨᎡᎢ ᎠᏂᎩᏍᏗᏍᎬᎢ Ꭰ ᎠᏂᎩᏍᏗᏍᎩ ᎤᏕᏲᏅ ᎠᎴ ᏩᎾᎦᏔᎲᏍᏗᎭ Ꭰ ᎦᎭᏗ ᎤᏗᏆᎸᏕᏯᏛ ᎠᏠᏓᎪᎵᏰᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Pan the bottom image left or right">
                <langSet xml:lang="en-US"><tig><term>Pan the bottom image left or right</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏕᏫ ᏅᎦ ᎾᏍᎩ ᎡᎳᏗᏢ ᎤᏓᏴᎳᏛ ᎠᏍᎦᏂ ᎠᎴᏃ ᎠᎦᏘᏏ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please keep them on the screen until the screenshot is captured.">
                <langSet xml:lang="en-US"><tig><term>Please keep them on the screen until the screenshot is captured.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏍᏆᏂᎪᏙᏗᎢ ᎢᏯᏂᎢ ᎾᎿ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎩᎳ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎨᎡᎢ ᏕᎨᏥᏴᎩᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Look directly at camera">
                <langSet xml:lang="en-US"><tig><term>Look directly at camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᎦᏔ ᏥᏳᎪᏗ ᎤᎿᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This gesture will launch your default assistant.">
                <langSet xml:lang="en-US"><tig><term>This gesture will launch your default assistant.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏧᏬᏯᏂᏍᎩ ᎠᏎ ᎭᏂᎩᏍᏙᏗ ᏂᏨᎤᎢ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ.t.</term></tig></langSet>
            </termEntry>
            <termEntry id="App usage for ">
                <langSet xml:lang="en-US"><tig><term>App usage for </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎾᏍᎩᎾ ᎬᏙᏗᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Tap in blurred area to exit">
                <langSet xml:lang="en-US"><tig><term>Tap in blurred area to exit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿ ᎤᏍᎪᎸᎢ ᎢᎬᎾᏕᎾ ᎾᎿᎢ ᎦᏅᎪᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You removed your fingers too fast.">
                <langSet xml:lang="en-US"><tig><term>You removed your fingers too fast.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᎲᏍᏓ ᏂᏨᎤᎢ ᏕᎦᏰᏌᏛ ᎾᎿᎢ ᎦᏣᏄᎳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To view one of the apps in full screen, drag up or down the divider.">
                <langSet xml:lang="en-US"><tig><term>To view one of the apps in full screen, drag up or down the divider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏌᏇ ᎾᎿ ᏥᎩ ᏗᎬᏙᏗ ᎾᎿ ᎧᎵ ᎠᏰᏙᎳᏛᎢ, ᏱᎾᏏᏄᎦ ᎦᎸᎳᏗ ᎠᎴ ᎡᎳᏗᏢ ᏥᎩ ᎠᏯᏔᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show at full brightness when the screen is facing down">
                <langSet xml:lang="en-US"><tig><term>Show at full brightness when the screen is facing down</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᎿᎢ ᏧᎧᎵᏨᎯ ᎤᏍᎪᏍᏗᏴ ᎢᏳᏃ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎨᎡᎢ ᎡᎳᏗ ᏭᎧᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep in mind, some apps don't work in split screen mode, so this gesture may not work in all of your apps.">
                <langSet xml:lang="en-US"><tig><term>Keep in mind, some apps don't work in split screen mode, so this gesture may not work in all of your apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗᎢ in ᎣᏓᏅᏛ, ᎢᎦᏓ ᏗᎬᏙᏗ ᏝᏍᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎿ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ, ᏓᏛ ᎯᎠ ᏧᏬᏯᏂᏍᎩ ᏰᎵᏯ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎿ ᏂᎦᏓ ᎾᎿ ᏂᏨᎤᎢ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you\’re ready to see 2 apps in split screen.">
                <langSet xml:lang="en-US"><tig><term>Now you\’re ready to see 2 apps in split screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎠᎪᏩᏛᏗ 2 ᏗᎬᏙᏗ ᎾᎿ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Let there be light!">
                <langSet xml:lang="en-US"><tig><term>Let there be light!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏂᎩ ᎤᎿᎢ ᎨᎡᎩ ᎢᎦᎯ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Show battery percentage in status bar">
                <langSet xml:lang="en-US"><tig><term>Show battery percentage in status bar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎢᎦᏘᎭ ᎠᎪᏩᏛᏙᏗ ᎾᎿᎢ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to turn off Google TalkBack before using One Button Navigation.">
                <langSet xml:lang="en-US"><tig><term>You need to turn off Google TalkBack before using One Button Navigation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ to ᎠᏍᏚᏗ Google TalkBack ᎠᏏᏅ ᎬᏗᎭ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone vibrates when DND turns on &amp; off.">
                <langSet xml:lang="en-US"><tig><term>Your phone vibrates when DND turns on &amp; off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᎵᏖᎸᏗ ᎢᏳᏃ DND ᎠᎦᏔᎲᎠ ᎤᎿᎢ &amp; ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="One button navigation works with most apps.">
                <langSet xml:lang="en-US"><tig><term>One button navigation works with most apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᎤᎪᏗᏗ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Charging is limited to  until you unplug your device">
                <langSet xml:lang="en-US"><tig><term>Charging is limited to  until you unplug your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎬᏩᎶᏗᏍᎬᎢ ᎨᎡᎩ ᏩᏎᏢᏊ ᎾᎿᎢ  ᎩᎳ ᏂᎯ ᎫᏓᎴᏍᎪ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn off vibrations in settings.">
                <langSet xml:lang="en-US"><tig><term>You can turn off vibrations in settings.</term></tig></langSet>
