                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏥᎰᎯᏳᏔᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Atmos has a refreshed design.">
                <langSet xml:lang="en-US"><tig><term>Dolby Atmos has a refreshed design.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎵᏈ Atmos ᏂᏚᏩᎿ ᎠᏤᎲᏍᏔᏅ ᎪᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your stylus lets you take quick notes anytime. Just pull it out to open Moto Note or another notes app.">
                <langSet xml:lang="en-US"><tig><term>Your stylus lets you take quick notes anytime. Just pull it out to open Moto Note or another notes app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎪᏪᎳᏅ ᏣᎵᏍᎪᎸᏓᏁᎯ ᎯᎦ ᎤᏟᏍᏓ ᏧᏍᏗ ᏕᎪᏪᎸ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ. ᏫᏣᏌᏁᏍᏗᏊ ᎾᎢ ᎯᏍᏚᎢ Moto ᎤᏍᏗ ᎪᏪᎸ ᎠᎴᏃ ᏅᏩᏓᎴᎢ ᏧᏍᏗ ᏕᎪᏪᎸ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Hidden network">
                <langSet xml:lang="en-US"><tig><term>Hidden network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏍᎦᏝᏅ ᎤᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="The assistant will be able to read information about apps in use on your system, including information visible on your screen or accessible within the apps.">
                <langSet xml:lang="en-US"><tig><term>The assistant will be able to read information about apps in use on your system, including information visible on your screen or accessible within the apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᎵᏍᏕᎵᏍᎩ ᎨᏎᏍᏗ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᎪᎵᏰᎥᏍᎩ ᏄᏰᎵᏛ ᏗᎬᏙᏗ ᎾᎿ ᎬᏙᏓ ᎾᎿ ᏣᏤᎵ ᏄᏍᏗᏓᏅᎢ, ᎤᏠᏯᏍᏗ ᎧᏃᎮᏢᎥᏍᎩ ᎬᎪᏩᏛᏗ ᎾᎿ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᎠᎴᏃ ᏅᏛᏴᏍᏙᏗᎢ ᎠᏫᏂᏗᏢ ᎾᏍᎩ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Note saved to Moto Note">
                <langSet xml:lang="en-US"><tig><term>Note saved to Moto Note</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏗ ᎪᏪᎸ ᎠᎵᏏᏅᏙᏗ ᎾᎢ Moto ᎤᏍᏗ ᎪᏪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth disconnected">
                <langSet xml:lang="en-US"><tig><term>Bluetooth disconnected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎫᏓᎴᏓᏃ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Audio has a refreshed design.">
                <langSet xml:lang="en-US"><tig><term>Dolby Audio has a refreshed design.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎵᏈ Atmos ᏂᏚᏩᎿ ᎠᏤᎲᏍᏔᏅ ᎪᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To simulate drag, double click and hold the stylus button then move your hand">
                <langSet xml:lang="en-US"><tig><term>To simulate drag, double click and hold the stylus button then move your hand</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎤᏠᏱ ᏯᏛᏁᎯ ᎦᎾᏏᏅᏍᏗ, ᎭᏐᎥᏍᏓ ᎠᎴ ᎯᏂᏯ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏐᎥᏍᏙᏗ ᎿᏉᏃ ᎯᎲᎾ ᏦᏰᎾ </term></tig></langSet>
            </termEntry>
            <termEntry id="Connecting to: ">
                <langSet xml:lang="en-US"><tig><term>Connecting to: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏍᎬᎢ ᎾᎾᎢ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Download and install?">
                <langSet xml:lang="en-US"><tig><term>Download and install?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᎴ ᎯᏘᏅᏛᎦ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery Saver will turn on automatically once battery goes below .">
                <langSet xml:lang="en-US"><tig><term>Battery Saver will turn on automatically once battery goes below .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎠᏎ ᎯᏍᏚᎢ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏌᏊᏊ ᎠᎾᎦᎵᏍᎩ ᎤᏪᏓᏍᏗᏱ ᎡᎳᏗᏨ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Show a date watermark on notes">
                <langSet xml:lang="en-US"><tig><term>Show a date watermark on notes</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᏍᎩ ᎢᏴ ᎢᎪᎯ ᎠᎹ ᎤᏙᏪᎸ ᎤᎾᎢ  ᏧᏍᏗ ᏕᎪᏪᎸ</term></tig></langSet>
            </termEntry>
