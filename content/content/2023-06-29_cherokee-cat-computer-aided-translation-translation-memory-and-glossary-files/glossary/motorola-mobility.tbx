            <termEntry id="To go back, tap the back button.">
                <langSet xml:lang="en-US"><tig><term>To go back, tap the back button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏥᏫᎭᎦᏔᎲᎾ, ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᏏᎾᎦᏘ ᎦᏛᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To go Home, swipe up from the bottom of the screen.">
                <langSet xml:lang="en-US"><tig><term>To go Home, swipe up from the bottom of the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎮᎾ ᎣᏪᏅᏒ, ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎾᎿᎢ ᎡᎳᏗᏢ ᎾᎿ ᏥᎩ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To switch apps, swipe up from the bottom, hold, then release.">
                <langSet xml:lang="en-US"><tig><term>To switch apps, swipe up from the bottom, hold, then release.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᎶᎯᏍᏗᏍᎩ ᏗᎬᏙᏗ, ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎭᏫᏂ, ᎯᏂᏯ, ᎿᏉᏃ ᏓᏥᏲᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, the Android camera encountered a problem.">
                <langSet xml:lang="en-US"><tig><term>Sorry, the Android camera encountered a problem.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎠᏰᎸᏗ, Android ᏗᏓᏟᎶᏍᏗᏍᎩ ᏗᏠᎯᏍᏗ ᏓᏓᎴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" apps">
                <langSet xml:lang="en-US"><tig><term> apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If  is unavailable or roaming, use your mobile data SIM for  calls.">
                <langSet xml:lang="en-US"><tig><term>If  is unavailable or roaming, use your mobile data SIM for  calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ  ᏄᏛᏅᎢᏍᏛᎾ ᏃᎴ ᎡᏙᎵᏙᎲ, ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ SIM ᎤᎬᏩᏟ  ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to allow MMS messaging on  when mobile data is off">
                <langSet xml:lang="en-US"><tig><term>Tap to allow MMS messaging on  when mobile data is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᏓᎵᏍᎪᎸᏓᏁᎲ MMS ᏛᎦᏃᏣᎵᏍᎬ ᎤᎿᎢ  ᎢᏳᏃ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎨᎡᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="This service is provided by your Operator.">
                <langSet xml:lang="en-US"><tig><term>This service is provided by your Operator.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏯᏓᏛᏁᏗ ᎠᏛᏅᎢᏍᏔᏅ ᎬᏗ ᏣᏤᎵ ᎠᏂᎩᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The first time you activate it on your phone, it may take several hours for it to be available.">
                <langSet xml:lang="en-US"><tig><term>The first time you activate it on your phone, it may take several hours for it to be available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᏱᏍᎩᏂ ᎠᏟᎢᎵᏒ ᏂᎯ ᎤᏂᎩᏍᏗᏍᎩ ᎤᎾᎢ ᏗᏟᏃᎮᏗ, ᏰᎵᏉ ᎠᎩᏍᏗ ᎢᎸᏍᎩ ᎢᏧᏟᎶᏛ ᎾᎿᎢ ᎨᎡᎩ ᎠᏛᎤᎢᏙᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="WiFi Calling is the service providing the ability to make and receive voice calls over the Internet connection in any available WiFi network, even if you are out of mobile coverage.">
                <langSet xml:lang="en-US"><tig><term>WiFi Calling is the service providing the ability to make and receive voice calls over the Internet connection in any available WiFi network, even if you are out of mobile coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>WiFi ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᏥᎩ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎬ ᏥᎩ ᎾᏏᎾᏒ ᎾᎿᎢ ᎪᏢᏗ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ ᎢᏴᏛ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎾᎿ ᎾᏂᎥᏉ ᎠᏛᏅᎢᏍᏔᏅ WiFi ᏧᎾᏚᏓᎵ, ᎥᏍᏊ ᎾᎿ ᏂᎯ ᎨᎡᎩ ᎤᎾᏙᏣᎴᏍᏗ ᎠᏂᎩᏍᎩ ᎫᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In case there is no mobile coverage the Emergency Calls could be routed via WiFi Calling service.">
                <langSet xml:lang="en-US"><tig><term>In case there is no mobile coverage the Emergency Calls could be routed via WiFi Calling service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏗᎪᏪᎵ ᎤᎿᎢ ᎨᎡᎢ Ꮭ ᎠᏂᎩᏍᎩ ᎫᏢᏗ ᏥᎩ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᏓᏯᏂ ᏰᎵᏊ ᎨᎡᎢ ᎦᎶᎯᏍᏗ ᎾᎿ ᎢᏗᏢ WiFi ᏓᏯᏂᏍᎬ ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In such cases your mobile operator may not be able to determine your exact location information and therefore would route your call to the Emergency Centre which is not the closest one for your actual location.">
                <langSet xml:lang="en-US"><tig><term>In such cases your mobile operator may not be able to determine your exact location information and therefore would route your call to the Emergency Centre which is not the closest one for your actual location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎾᏍᎩᏯ ᏂᏓᎵᏱᎵᏙᎲ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎠᎯᎵᏙᎯ ᏰᎵᏯ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᏂᏨᎤᎢ ᏗᏙᎳᎩ ᎤᏙᏢᏒᎢ ᎧᏃᎮᏢᏗ ᎠᎴ ᎤᏩᎫᏗᏗᏒ ᏯᏓᎯᏗᏏ ᎦᏅᎿᏩᏗᏒᎢ ᏂᏨᎤᎢ ᏪᏯᎾ ᎾᎿᎢ ᏥᎩ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎠᏰᏟ ᏥᎩ ᎥᏝ ᏥᎩ ᎾᎥᏂᎨᏍᏗ ᏌᏇ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᎤᏙᎯᏳ ᎤᏙᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Disclaimer">
                <langSet xml:lang="en-US"><tig><term>Disclaimer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏱᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once the service is active for your mobile number, every time you connect to a WiFi network, your voice calls will be performed using WiFi Calling.">
                <langSet xml:lang="en-US"><tig><term>Once the service is active for your mobile number, every time you connect to a WiFi network, your voice calls will be performed using WiFi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎢᏯᏓᏛᏁᏗ ᎤᏂᎩᏍᏗᏍᎩ ᏂᎯ ᎠᏂᎩᏍᎩ ᏗᏎᏍᏗ, ᏂᎪᎯᎸ ᏱᎫᏓᎳ WiFi ᏗᏗᎠᎸ, ᎧᏁᎬ ᏫᏯᏅᏗ ᏚᎸᏫᏍᏁᎲ WiFi ᎥᏗᏍᎬ. </term></tig></langSet>
            </termEntry>
            <termEntry id="This will be presented to you by a dedicated icon on the notification bar.">
                <langSet xml:lang="en-US"><tig><term>This will be presented to you by a dedicated icon on the notification bar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎨᏎᏍᏗ ᎡᏣᏓᏁᎸᎩ ᎾᎢ ᎠᏑᏰᏓ ᎠᎧᏂ ᎥᎾᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="In the case your WiFi connection is of poor quality or your device is outside a WiFi network’s coverage, your phone will make calls using an available mobile network.">
                <langSet xml:lang="en-US"><tig><term>In the case your WiFi connection is of poor quality or your device is outside a WiFi network’s coverage, your phone will make calls using an available mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯᏣᏤᎵ WiFi ᏗᎫᏓᎸᏅᎯ ᏃᏌᏅᏱ ᎠᎴ ᏂᎯᏣᏤᎵ ᏣᏂᎬᏅᏗᏓᎾ ᏙᏯᏗᏜ WiFi ᏚᏏᎳᏛ ᎫᏝᎢ, ᏂᎯᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏛᏛᏯᎾᎯ ᎥᏗᏍᎬ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your calls made with WiFi Calling in Poland are charged in the same way as your regular mobile calls in your mobile tariff plan.">
                <langSet xml:lang="en-US"><tig><term>Your calls made with WiFi Calling in Poland are charged in the same way as your regular mobile calls in your mobile tariff plan.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎯ ᏕᎯᏯᏂᏍᎬ ᏛᎪᏢᏗᏍᎬ WiFi ᏛᏯᏂᏍᎬ ᏉᎳᏂ ᎤᏠᏱ ᎣᎾᏟᏍᎬ ᏂᏨᏅᎯ ᎤᏠᏱᎭ ᎠᏂᎩᏍᎩ ᏕᎯᏯᏂᏍᎬ ᎾᎿᎢ ᏂᏨᏅᎯ ᎠᏰᎵ ᎠᎫᏴᏗ ᎠᏍᏓᏫᏛᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="HDMI settings">
                <langSet xml:lang="en-US"><tig><term>HDMI settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>HDMI ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you make WiFi Calling calls outside Poland your calls may be charged with a dedicated price specified in your mobile tariff plan’s price list.">
                <langSet xml:lang="en-US"><tig><term>If you make WiFi Calling calls outside Poland your calls may be charged with a dedicated price specified in your mobile tariff plan’s price list.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᏨᏁᎳ WiFi ᏛᏯᏂᏍᎬ ᏙᏯᏗᏜ ᏉᎳᏂ ᏂᏨᏅᎯ ᏕᎯᏯᏂᏍᎬ ᎡᎵᏊ ᏗᎬᏩᎶᏔᏅ ᎬᏗ ᏧᏚᎪᏔᏅᎯ ᏓᎬᏩᎶᏔᏅ ᏕᎪᎥᎢ ᎾᎿᎢ ᏂᏨᏅᎯ ᎠᏂᎩᏍᎩ ᎠᎫᏴᏗ ᎠᏍᏓᎶᏛᏓ ᏗᎪᏩᎶᏔᏅ ᏓᏎᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notwithstanding, your WiFi connections may be charged independently by the provider of your WiFi connection.">
                <langSet xml:lang="en-US"><tig><term>Notwithstanding, your WiFi connections may be charged independently by the provider of your WiFi connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏍᎦᏗᏢᏃ, ᏂᏨᏅᎯ WiFi ᏓᎾᎵᎪᏗᏍᎬ ᎡᎵᏊ ᏗᎬᏩᎶᏔᏅ ᎤᏩᏒᎯᎢ ᎠᏁᏢᏍᎩ ᏂᏨᏅᎢ WiFi ᏓᎾᎵᎪᏗᏍᎬ..</term></tig></langSet>
            </termEntry>
            <termEntry id="Once you press the  button and your phone connects to a WiFi network, your WiFi Calling service will be activated.">
                <langSet xml:lang="en-US"><tig><term>Once you press the  button and your phone connects to a WiFi network, your WiFi Calling service will be activated.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊ ᎢᏳᏩᎫᏗ ᏱᏣᏐᏍᏔᎾ Ꮎ  ᎠᏐᎥᏍᏙᏗ ᎠᎴ ᏂᏨᏅᎯ ᏗᏟᏃᎮ ᏕᎱᏓᎸᏍᎬ ᎾᎢ WiFi ᏧᏅᏚᏓᎵ, ᏂᏨᏅᎯ WiFi ᏛᏯᏂᏍᎬ ᎢᏯᏛᏁᏗ ᎨᏎᏍᏗ ᎤᎵᎩᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can disable the WiFi Calling at any time using the phone menu.">
                <langSet xml:lang="en-US"><tig><term>You can disable the WiFi Calling at any time using the phone menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏣᎴᏫᏍᏙᏗ Ꮎ WiFi ᏓᏯᏂᏍᎬ ᎢᏳᏊ ᎲᏗᏍᎬ Ꮎ ᏗᏟᏃᎮᏗ ᎪᏪᎳᎾᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Color Temperature">
