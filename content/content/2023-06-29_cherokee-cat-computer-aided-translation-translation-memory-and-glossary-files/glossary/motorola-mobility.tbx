            </termEntry>
            <termEntry id="^1 total • background less than a minutefrom last full charge">
                <langSet xml:lang="en-US"><tig><term>^1 total • background less than a minutefrom last full charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᏂᎦᏛ ᎦᏟᏌᏅ • ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᏩᎦᏲᏢ ᎢᏯᏛᏬᏍᏔᏅᎯᎾᎯᏳ ᎣᏂ ᎧᎵ ᎬᏂᏗᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="of RAM used over ">
                <langSet xml:lang="en-US"><tig><term>of RAM used over </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎾᎿ RAM ᎬᏔᏅᎢ ᎢᏴᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="Share your tablet by adding new users. Each user has a personal space on your tablet for custom Home screens, accounts, apps, settings, and more.">
                <langSet xml:lang="en-US"><tig><term>Share your tablet by adding new users. Each user has a personal space on your tablet for custom Home screens, accounts, apps, settings, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᎠᏯᏙᏍᏗᎢ ᎬᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎢᏤ ᏗᏅᏗᏍᎩ. ᎤᏩᏌ ᎣᏤᎵ ᎤᏜᏅᏛ ᏌᏊᎭ ᎬᏗᏍᎩ ᏂᏚᏩᎿ ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᎤᎾᎢ ᎾᏍᎩᎾ ᏄᏍᏛ ᎢᏯᏛᏁᏗᎢ Home ᏗᏴᏙᎳᏛᎢ, ᏗᏚᏓᎸᏙᏗ, ᏗᎬᏙᏗ, ᏕᎦᎧᎲᎢ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restricted apps">
                <langSet xml:lang="en-US"><tig><term>Restricted apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎨᏗᏍᎩ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="App usage for past 24 hr">
                <langSet xml:lang="en-US"><tig><term>App usage for past 24 hr</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎾᏍᎩᎾ ᎬᏙᏗᎢ ᎨᏎᎢ 24 hr</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to activate ">
                <langSet xml:lang="en-US"><tig><term>Tap to activate </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎢ ᎠᏂᎩᏍᏙᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Any changes you make to your accounts on the web will be automatically copied to your tablet.Some accounts may also automatically copy any changes you make on the tablet to the web. A Google Account works this way.">
                <langSet xml:lang="en-US"><tig><term>Any changes you make to your accounts on the web will be automatically copied to your tablet.Some accounts may also automatically copy any changes you make on the tablet to the web. A Google Account works this way.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏂᎥᏉ ᏗᎦᏁᏟᏴᏓ ᏂᎯ ᎪᏢᏗ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏥᎩ ᎤᏂᎳᏛᎢ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏓᏟᎶᏍᏔᏅᎯ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ.ᎢᎦᏓ ᏗᏚᏓᎸᏙᏗ ᏰᎵᏉ ᎾᏍᏊ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏗᏟᎶᏍᏔᏅᎯ ᎾᏂᎥᏉ ᏗᎦᏁᏟᏴᏓ ᏂᎯ ᎪᏢᏗ ᎤᎾᎢ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎾᎿᎢ ᏥᎩ ᎤᏂᎳᏛᎢ. Ꭰ Google ᎠᏚᏓᎸᏗ ᏚᎸᏫᏍᏓᏁᎲ ᎯᎠ ᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device can't manage battery normally because  keeps waking up your device.To try to fix this issue, you can stop .If this keeps happening, you may need to uninstall the app to improve battery performance.">
                <langSet xml:lang="en-US"><tig><term>Your device can't manage battery normally because  keeps waking up your device.To try to fix this issue, you can stop .If this keeps happening, you may need to uninstall the app to improve battery performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr pᎰᏁ cᎠn't ᎹᎾᎨ bᎠtᏖry ᏃrᎹlly bᎡcᎠᎤᏎ  iᎢᏍ kᎡᎡpᎢng ᏲᎤr pᎰᏁ ᎠᏩkᎡTᎣ try tᎣ fᎢx tᎯᏍ ᎢᏍᏑᎡ, ᏲᎤ cᎠn ᏍtᎣp ᏍᏓ ᏓᏍᏆᏂᎪᏗ ᏂᎦᎵᏍᏗᏍᎬ, ᏅᏅᏓᎩ ᎬᏙᏗ ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏚᎸᏫᏍᏓᏁᎲᎢ ᎪᏢᎯᏐᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Except when kept unlocked by ">
                <langSet xml:lang="en-US"><tig><term>Except when kept unlocked by </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᎩᏂᏃᏅ ᎢᏳᏃ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏂᏐᎭᎾᎳᎩ ᎬᏗ </term></tig></langSet>
            </termEntry>
