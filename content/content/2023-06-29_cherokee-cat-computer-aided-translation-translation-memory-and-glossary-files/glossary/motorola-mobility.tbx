            </termEntry>
            <termEntry id="Allow the app to access data that may survive a factory reset">
                <langSet xml:lang="en-US"><tig><term>Allow the app to access data that may survive a factory reset</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᏴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᎩᎾ ᏰᎵᏉ ᎤᎦᏛᎴᏒ ᎪᎱᏍᏗ ᎤᏃᏢᏗ ᎢᎦᎧᎯᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="USB Webcam Mode">
                <langSet xml:lang="en-US"><tig><term>USB Webcam Mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏏᎳᏕᏫᏒ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Access Stored OMA Provisioning Data">
                <langSet xml:lang="en-US"><tig><term>Access Stored OMA Provisioning Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ OMA ᏓᏓᏁᎲᎢ ᎦᎷᎯᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile Hotspot uses your mobile data connection. Your Wi-Fi connection will be turned off.">
                <langSet xml:lang="en-US"><tig><term>Mobile Hotspot uses your mobile data connection. Your Wi-Fi connection will be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Mobile Hotspot ᏗᏅᏗᏍᎩ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎱᏓᎸᎦ. ᏂᏨᎤᎢ Wi-Fi ᎱᏓᎸᎦ ᎨᏎᏍᏗ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows app to read/write OMA provisioning data files under persist partition">
                <langSet xml:lang="en-US"><tig><term>Allows app to read/write OMA provisioning data files under persist partition</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᎵᏰᏗ/ᎪᏪᎶᏗ OMA ᏓᏓᏁᎲᎢ ᎦᎷᎯᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏗᏍᏆᏂᎪᏙᏗ ᎤᏓᏄᏴᏛᎢ ᎾᏢᏲᎵᎲᎾ ᏓᏓᏓᎴᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot start video capture">
                <langSet xml:lang="en-US"><tig><term>Cannot start video capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᎦᏴᏂᎩᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Access Persistent User Data">
                <langSet xml:lang="en-US"><tig><term>Access Persistent User Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᏂᏓᏓᏲᏍᎬᎾ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="App can't open on this display">
                <langSet xml:lang="en-US"><tig><term>App can't open on this display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎨᏍᏗ ᏰᎵ ᎯᏍᏚᎢ ᎤᎿᎢ ᎯᎠ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile Hotspot uses your mobile data connection. Your Wi-Fi connection will be turned off.">
                <langSet xml:lang="en-US"><tig><term>Mobile Hotspot uses your mobile data connection. Your Wi-Fi connection will be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Mobile Hotspot ᏗᏅᏗᏍᎩ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎱᏓᎸᎦ. ᏂᏨᎤᎢ Wi-Fi ᎱᏓᎸᎦ ᎨᏎᏍᏗ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can only have one active Motorola ID at a time.">
                <langSet xml:lang="en-US"><tig><term>You can only have one active Motorola ID at a time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎤᏅᏒ ᎤᎭ ᏌᏇ ᎬᏂᎦᎵᏍᏗ Motorola ID ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="PHOTO">
                <langSet xml:lang="en-US"><tig><term>PHOTO</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your password cannot contain spaces">
                <langSet xml:lang="en-US"><tig><term>Your password cannot contain spaces</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎨᏍᏗ ᏰᎵ ᎦᎸᏛᎢ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="We could not use your Google email address, stored in Contacts, to create a Motorola ID. You may grant permission at any time from Settings.">
                <langSet xml:lang="en-US"><tig><term>We could not use your Google email address, stored in Contacts, to create a Motorola ID. You may grant permission at any time from Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ Google ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ, ᎠᏍᏆᏂᎪᏔᏅ ᎾᎿ ᏗᏟᏃᎮᏙᏗ, ᎾᎿᎢ ᎪᏒᏗ Ꭰ Motorola ID. ᏂᎯ ᏰᎵᏯ ᎠᎵᏍᎪᎸᏙᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ ᏅᏓᏳᏓᎴᏅᎯ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We need to verify that you own the email address . Click the &quot;&quot; button below to send a verification email to this address.">
                <langSet xml:lang="en-US"><tig><term>We need to verify that you own the email address . Click the "" button below to send a verification email to this address.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᎸᏓ ᎾᎿᎢ ᎰᎯᏳᏓ ᎥᏍᎩᎾ ᏂᎯ ᎤᏤᎵᎦ ᏥᎩ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏗᎦᏁᏍᏗᏱ . ᎭᏐᎥᏍᏓ ᏥᎩ "" ᎠᏐᏅᏍᏙᏗ ᎡᎳᏗᏨ ᎾᎿᎢ ᏫᏅᎥᎦ Ꭰ ᎪᎯᏳᏗᏍᎩ ᎠᎾᎦᎵᏍᎩ ᎾᎿᎢ ᎯᎠ ᏗᎦᏁᏍᏗᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We use your Google email address, stored in Contacts, to create a Motorola ID. Please tap &quot;Allow&quot; in the next screen.">
                <langSet xml:lang="en-US"><tig><term>We use your Google email address, stored in Contacts, to create a Motorola ID. Please tap "Allow" in the next screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ Google ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ, ᎠᏍᏆᏂᎪᏔᏅ ᎾᎿ ᏗᏟᏃᎮᏙᏗ, ᎾᎿᎢ ᎪᏒᏗ Ꭰ Motorola ID. ᎰᏩᏊ ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ "ᎠᎵᏍᎪᎸᏗᏍᎬ" ᎾᎿ ᏥᎩ ᏐᎢ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read Android Beam data from another app">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read Android Beam data from another app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᎵᏰᏗ Android Beam ᎦᏘᏍᎩᏌᏅᎯ ᏅᏓᏳᏓᎴᏅᎯ ᏄᏓᎴ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows application to access the Image Tuner data">
                <langSet xml:lang="en-US"><tig><term>Allows application to access the Image Tuner data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᎬᏙᏗ ᎾᎿᎢ ᏩᏴᏍᏗᎢ ᎠᏅᏓᏗᏍᏙ ᎭᏃᏴᎬ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Write access to edge/power touch app content provider">
                <langSet xml:lang="en-US"><tig><term>Write access to edge/power touch app content provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᎠᏍᏛᎢ/ᎤᏬᏯᏂᏍᎩ ᎬᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎬᏙᏗ ᏄᏍᏗᏓᏅ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Create new theme">
                <langSet xml:lang="en-US"><tig><term>Create new theme</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᏗᏤ ᎤᏓᏤᏟᏓ ᏗᎧᏃᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission to access the Checkin Provider">
                <langSet xml:lang="en-US"><tig><term>Permission to access the Checkin Provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᏩᏴᏍᏗᎢ ᏥᎩ ᏥᏅᏂᎦ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows write access to edge/power touch app content provider">
                <langSet xml:lang="en-US"><tig><term>Allows write access to edge/power touch app content provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᎪᏪᎶᏗ ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᎠᏍᏛᎢ/ᎤᏬᏯᏂᏍᎩ ᎬᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎬᏙᏗ ᏄᏍᏗᏓᏅ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Access to Do Not Disturb.">
                <langSet xml:lang="en-US"><tig><term>Access to Do Not Disturb.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᎾᎿᎢ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ.</term></tig></langSet>
