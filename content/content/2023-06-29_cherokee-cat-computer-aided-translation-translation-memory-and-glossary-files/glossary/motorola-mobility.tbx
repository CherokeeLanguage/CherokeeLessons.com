                <langSet xml:lang="chr"><tig><term>ᏥᎩ SIM ᏆᎾᏲᏍᏗ ᏄᏍᏛ ᎤᎪᎳ ᏃᎴ ᎥᏝ ᎢᏲᏍᏓ ᎤᎪᎵᏰᏗ. ᎪᏣᎸᏗ Ꭰ SIM ᏆᎾᏲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You'll be notified if Motorola needs more information about the feedback you've provided.">
                <langSet xml:lang="en-US"><tig><term>You'll be notified if Motorola needs more information about the feedback you've provided.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏊᏃ ᏓᏰᏣᏃᎯᏎᎵ ᎢᏳᏃ Motorola ᎤᏟ ᎢᎦᎢ ᎤᏚᎸᏓ ᎧᏃᎮᏢᎥᏍᎩ ᏄᏰᎵᏛᎢ ᎾᏍᎩ ᎦᏬᎯᎵᏴᏓ ᏂᎯᏃ ᏣᏓᏁᎳᏅᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="All tasks will finish once the log is uploaded.">
                <langSet xml:lang="en-US"><tig><term>All tasks will finish once the log is uploaded.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᎥ ᎢᏗᏛᏁᏗ ᎠᏎ ᏛᎵᏍᏆᏓ ᎠᎴᏉ ᎾᏍᎩ ᏄᏛᏁᎸ ᎧᏃᎮᏍᎩ ᏫᎦᎵᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Finish &amp; upload">
                <langSet xml:lang="en-US"><tig><term>Finish &amp; upload</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏗᏍᏗ &amp; ᎦᏢᏙᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="If you're willing to take another step, you can help Motorola provide a better experience in the future.">
                <langSet xml:lang="en-US"><tig><term>If you're willing to take another step, you can help Motorola provide a better experience in the future.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᏱᏣᏛᏅᎢᏍᏗ ᏏᏊ ᏐᎢ ᏣᎳᏍᎬᏍᏗᎢ, ᏂᎯ ᏰᎵᏊ ᎨᎯᏍᏕᎸᏓ Motorola ᎠᏓᏁᎳᏁᏗ ᏓᏤᏢᎩ ᎤᎦᏙᎲᏍᏗ ᎾᎿᎢ ᎤᏩᎫᏗᏗᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also lock by pressing the power key.">
                <langSet xml:lang="en-US"><tig><term>You can also lock by pressing the power key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏋ ᏍᏓᏯ ᎯᏍᏚᎲᎦ ᎬᏗ ᎠᏐᎥᏍᏗᏍᎬ ᎾᏍᎩ ᎤᏟᏂᎩᏓ ᎠᏐᏅᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Bug reports include personal information about your device or data logged by apps, such as user names, location data, device identifiers, and network information.">
                <langSet xml:lang="en-US"><tig><term>Bug reports include personal information about your device or data logged by apps, such as user names, location data, device identifiers, and network information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎪᏯ ᎬᏂᎨᏒ ᏱᏗᎬᏁᎯ ᎠᏠᏯᏍᏓ ᎤᏩᏌ ᎤᏤᎵ ᎧᏃᎮᏢᎥᏍᎩ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴᏃ ᎦᏟᏌᏅᎯ ᏄᏛᏁᎸ ᎤᏃᎮᏢᎩ ᎬᏗ ᏗᎬᏙᏗ,  ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᎬᏗᏍᎩ ᏚᎾᏙᎥᎢ, ᎢᎬᎾᏕᎾ ᎦᏟᏌᏅᎯ, ᏥᏂᎬᏅᏗᏓᎾ ᏗᏓᏙᎵᎩ, ᎠᎴ ᎤᏚᏓᎵ ᎧᏃᎮᏢᎥᏍᎩ. </term></tig></langSet>
            </termEntry>
