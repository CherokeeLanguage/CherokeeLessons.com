            <termEntry id="{count, plural, offset:2 =0 {No apps can interrupt} =1 {{app_1} can interrupt} =2 {{app_1} and {app_2} can interrupt} =3 {{app_1}, {app_2}, and {app_3} can interrupt} other {{app_1}, {app_2}, and # more can interrupt} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, offset:2 =0 {No apps can interrupt} =1 {{app_1} can interrupt} =2 {{app_1} and {app_2} can interrupt} =3 {{app_1}, {app_2}, and {app_3} can interrupt} other {{app_1}, {app_2}, and # more can interrupt} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, offset:2 =0 {ᎭᏗ ᏗᎬᏙᏗ ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} =1 {{app_1} ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} =2 {{app_1} ᏃᎴ {app_2} ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} =3 {{app_1}, {app_2}, ᏃᎴ {app_3} ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} other {{app_1}, {app_2}, ᏃᎴ # ᎤᏥ ᎢᎦᎢ ᏰᎵᏊ ᎤᏓᏲᏍᏓᏁᎸᎩ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your fingerprint to unlock your phone or verify it\u2019s you, like when you sign in to appsLearn more">
                <langSet xml:lang="en-US"><tig><term>Use your fingerprint to unlock your phone or verify it\u2019s you, like when you sign in to appsLearn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᎰᎯᏳᏓ ᎾᏍᎩ ᏂᎯ, ᎯᎸᏉᏗ ᎢᏳᏃ ᏂᎯ ᏚᏙᎥ ᎪᏪᎶᏗ ᎾᎿᎢ ᏗᎬᏙᏗᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
