                <langSet xml:lang="chr"><tig><term>TᎯᏍ prᎢnᏖr prᎣᎥᎢᏕd Ꭰ Ꮑw ᏎcᎤrᎢty cᎡrᏘfᎢcᎠᏖ, Ꭳr ᎠᏃtᎮr ᏕᎥᎢcᎡ ᎢᏍ ᎢmpᎡrᏐᎾᏘng Ꭲt.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow ART to verify bytecode for debuggable apps">
                <langSet xml:lang="en-US"><tig><term>Allow ART to verify bytecode for debuggable apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ART ᎾᎿᎢ ᎰᎯᏳᏓ ᏆᏱᏘ ᎠᏍᏓᏩᏛᏍᏙᏗ ᎤᎪᏩᏟ ᎯᏩᏔ ᎤᏍᏗᎦᎵᏓᏍᏛ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
