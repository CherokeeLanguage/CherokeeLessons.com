                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᏩᏗᏅᏗ SMS</term></tig></langSet>
            </termEntry>
            <termEntry id="For added security, enter your work password">
                <langSet xml:lang="en-US"><tig><term>For added security, enter your work password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎧᏁᏉᏓ ᎤᎦᏎᏍᏗ, ᎠᏴᏍᏗ ᏂᏨᎤᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Operation is not allowed since the phone is in emergency call mode.">
                <langSet xml:lang="en-US"><tig><term>Operation is not allowed since the phone is in emergency call mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎢᏒᎢ ᏝᏯᎵᏍᎪᎸᏗ ᏏᏅ Ꮎ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎤᏟᏍᏓ ᎦᎵᏍᏗᏍᎩ ᎠᏯᏅᏓ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sign in with">
