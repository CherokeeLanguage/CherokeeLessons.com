            </termEntry>
            <termEntry id="When you turn them on, all future security updates will automatically download when they're available.">
                <langSet xml:lang="en-US"><tig><term>When you turn them on, all future security updates will automatically download when they're available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏓ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Download will start in Wi-Fi/Cellular Network.">
                <langSet xml:lang="en-US"><tig><term>Download will start in Wi-Fi/Cellular Network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏎ ᎭᎴᎾ ᎾᎿ Wi-Fi/ᏫᏚᏍᏗᎬᎢ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The update version does not match your phone.">
                <langSet xml:lang="en-US"><tig><term>The update version does not match your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᏄᏓᎴᏒᎢ ᏝᏍᏗ ᏗᏙᎵᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please re-insert the SD Card and go to Settings &gt; System updates to try again.">
                <langSet xml:lang="en-US"><tig><term>Please re-insert the SD Card and go to Settings &gt; System updates to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎰᏣᎸᎥᎦ ᏥᎩ SD ᏆᎾᏲᏍᏗ ᎠᎴ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device could be prone to security risks.">
                <langSet xml:lang="en-US"><tig><term>Your device could be prone to security risks.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏯ ᎨᎡᎢ ᎠᏞᏴᏍᏙᏗ ᎾᎿᎢ ᏧᎾᎦᏎᏍᏗ ᏗᎦᎾᏰᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Execute the below command for continued updatesadb enable-verity">
                <langSet xml:lang="en-US"><tig><term>Execute the below command for continued updatesadb enable-verity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏅᏗᏱ ᏥᎩ ᎡᎳᏗᏢ ᎤᏁᏤᎸᎩ ᎤᎬᏩᏟ ᎤᎵᏱᎸᏛ ᏗᎪᏢᎯᏐᏗadb ᎡᎵᏊ ᏱᎬᏛᏁᏗ-ᎤᏙᎯᏳᎯᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Available devices: ">
                <langSet xml:lang="en-US"><tig><term>Available devices: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅ ᏥᏂᏕᎬᏅᏗᏓᎾ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can enjoy better power and volume interactions. To launch the Google Assistant, press and hold the power key. To open the power menu, press and hold the power and volume up keys.">
                <langSet xml:lang="en-US"><tig><term>Now you can enjoy better power and volume interactions. To launch the Google Assistant, press and hold the power key. To open the power menu, press and hold the power and volume up keys.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏂᎯ ᏰᎵᏊ ᎠᎵᎮᎵᏍᏗ ᏓᏤᏢ ᎤᏟᏂᎩᏓ ᎠᎴ ᎢᎦᎢ ᎤᏃᏴᎬ ᏓᏔᎳᏗᏍᎬᎩ. ᎾᎢ ᎠᏂᎩᏍᏙᏗ ᎾᏍᎩ Google ᎠᎵᏍᏕᎵᏍᎩ, ᎠᏐᎥᏍᏙᏗ ᎠᎴ ᎯᏂᏯ ᎾᏍᎩ ᎤᏟᏂᎩᏓ ᎠᏐᎥᏍᏙᏗ. ᎾᎢ ᎯᏍᏚᎢ ᎾᏍᎩ ᎤᏟᏂᎩᏓ ᎪᏪᎳᎾᎥᎢ, ᎠᏐᎥᏍᏙᏗ ᎠᎴ ᏣᏂᏴᏎᏍᏗ ᎾᏍᎩ ᎤᏟᏂᎩᏓ ᎠᎴ ᎢᎦᎢ ᎤᏃᏴᎬ ᎦᎸᎳᏗᏨ ᏗᏐᎥᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᎠᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Take a shortcut">
                <langSet xml:lang="en-US"><tig><term>Take a shortcut</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏆᎳ ᎢᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Beach">
                <langSet xml:lang="en-US"><tig><term>Beach</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎹᏳᎳᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="After an update is downloaded, your device will restart at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>After an update is downloaded, your device will restart at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ Ꭰ ᏗᎪᏢᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ ᏥᎩ ᎠᏟᎵᏒᎢ ᏂᎯ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please charge your device to at least  before installing this update">
                <langSet xml:lang="en-US"><tig><term>Please charge your device to at least  before installing this update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎬᏂᏗᏍᏔᏅᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎤᎿᎢ ᎤᏍᏗᎧᏂ  ᎠᏏᏅ ᎦᏘᏅᏛᏍᎬ ᎯᎠ ᏗᎪᏢᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call is in progress">
                <langSet xml:lang="en-US"><tig><term>Call is in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏅᏛᏍᎬ ᎨᎡᎢ ᎾᎿᎢ ᎠᏂᏱᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once done, you can go to Settings &gt; System updates to start the update any time.">
                <langSet xml:lang="en-US"><tig><term>Once done, you can go to Settings &gt; System updates to start the update any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊᏊ ᎠᏍᏆᏛᎯ, ᏂᎯ ᏰᎵᏯ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᎭᎴᎾ ᏥᎩ ᏗᎪᏢᎯᏌᏅᎯ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure to delete?">
