            </termEntry>
            <termEntry id="Certificate name">
                <langSet xml:lang="en-US"><tig><term>Certificate name</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏚᏅᏙᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose a certificate">
                <langSet xml:lang="en-US"><tig><term>Choose a certificate</term></tig></langSet>
