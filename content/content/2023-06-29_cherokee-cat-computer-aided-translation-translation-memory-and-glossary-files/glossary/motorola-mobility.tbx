                <langSet xml:lang="chr"><tig><term>Ꮟ, ᎤᏥ ᎢᎦᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Based on current settings, device usage information will be shared to help improve our products but not to provide personalized support.">
