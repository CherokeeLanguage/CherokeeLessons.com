                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎢᏲᏍᏓ ᎠᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Voice Service:">
                <langSet xml:lang="en-US"><tig><term>Voice Service:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎬ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Current subId:">
                <langSet xml:lang="en-US"><tig><term>Current subId:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ subId:</term></tig></langSet>
            </termEntry>
            <termEntry id="Add Number">
                <langSet xml:lang="en-US"><tig><term>Add Number</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎠᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot place a call as there are already two calls in progress. Disconnect one of the calls or merge them into a conference prior to placing a new call.">
                <langSet xml:lang="en-US"><tig><term>Cannot place a call as there are already two calls in progress. Disconnect one of the calls or merge them into a conference prior to placing a new call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎤᏙᏢᏒ Ꭰ ᏪᏯᎾ ᎯᎢᎾᎢ ᎤᎿᎢ ᎨᏒᎢ ᎦᏳᎳ ᏔᎵ ᏓᏯᏂ ᎾᎿ ᎠᎵᏱᎵᏒ. ᎱᏓᎳᎩ ᏌᏊ ᎾᎿ ᏥᎩ ᏓᏯᏂ ᎠᎴ ᏓᏠᎯᏍᏛ ᎢᏯᏂᎢ ᎾᎿᎢ Ꭰ ᏧᎾᏓᏛᎪᏙᏗ ᏧᏩᎫᏔᏅᏒ ᎾᎿᎢ ᏩᎲᏍᎬ Ꭰ ᏗᏤ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cbrs Data">
                <langSet xml:lang="en-US"><tig><term>Cbrs Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Cbrs ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="IMS Status">
                <langSet xml:lang="en-US"><tig><term>IMS Status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>IMS ᏄᏛᎿᏕᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use , make sure mobile data and data roaming are turned on. You can change these in mobile network settings.">
                <langSet xml:lang="en-US"><tig><term>To use , make sure mobile data and data roaming are turned on. You can change these in mobile network settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ , ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎠᏂᎩᏍᎩ ᎠᎴ ᎦᏟᏌᏅᎯ ᎡᏙᎵᏙᎲ ᎨᏒᎢ ᎠᏍᏚᎢᏓ. ᏂᎯ ᏰᎵᏊ ᎯᏁᏟᏴᎾ ᎯᎠᏃ ᎾᎿ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎠᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Received:">
                <langSet xml:lang="en-US"><tig><term>Data Received:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᏓᏥᏁᎸᎩ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Celsius">
                <langSet xml:lang="en-US"><tig><term>Celsius</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏤ ᎠᏥᎶᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot place a call as there is an unanswered incoming call. Answer or reject the incoming call prior to placing a new call.">
                <langSet xml:lang="en-US"><tig><term>Cannot place a call as there is an unanswered incoming call. Answer or reject the incoming call prior to placing a new call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎤᏙᏢᏒ Ꭰ ᏪᏯᎾ ᎯᎢᎾᎢ ᎤᎿᎢ ᎨᏒᎢ Ꮭ ᎦᏬᎯᎵᏴᏓ ᎦᎷᎦ ᏪᏯᎾ. ᎦᏬᎯᎵᏴᏍᎬᎢ ᎠᎴ ᎠᏓᏯᏍᏗ ᏥᎩ ᎦᎷᎦ ᏪᏯᎾ ᏧᏩᎫᏔᏅᏒ ᎾᎿᎢ ᏩᎲᏍᎬ Ꭰ ᏗᏤ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block outgoing international calls?">
                <langSet xml:lang="en-US"><tig><term>Block outgoing international calls?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳ ᎦᏅᎪᏫᏛ ᏓᏰᏏ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᏓᏯᏂ?</term></tig></langSet>
            </termEntry>
            <termEntry id="To practice, your phone must be lying face up on a flat surface">
                <langSet xml:lang="en-US"><tig><term>To practice, your phone must be lying face up on a flat surface</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎢᏯᏛᏁᏗᎢ, ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎨᎡᎢ ᎠᏝᎥ ᎧᏁᏉᏍᏗᏍᎬ ᎦᎸᎳᏗ ᎤᎿᎢ Ꭰ ᎠᏯᏖᏂ ᎦᏚᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Spoken Language">
                <langSet xml:lang="en-US"><tig><term>Spoken Language</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏨᎯ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Number of PPP Reset Since Boot:">
                <langSet xml:lang="en-US"><tig><term>Number of PPP Reset Since Boot:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏍᏗ ᎤᎿ PPP ᏥᎯᎧᎲᎦ ᏂᏓᏳᏓᎴᏅᏓ ᎠᏍᏚᎢᏓ:</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn off this feature anytime by tapping &quot;Settings&quot; on the Overcharge protection notification.">
                <langSet xml:lang="en-US"><tig><term>You can turn off this feature anytime by tapping "Settings" on the Overcharge protection notification.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏍᏚᏗ ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᎢᎸᎯᏳ ᎬᏗ ᎤᏟᏍᏓ ᎠᏒᏂᎸ "ᏕᎦᎧᎲᎢ" ᎤᎿᎢ ᏥᎩ ᎦᎸᎳᏗᏢ ᏗᎬᏩᎶᏙᏗ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᎠᏓᏃᏣᎳᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also go to Settings &gt; Battery.">
                <langSet xml:lang="en-US"><tig><term>You can also go to Settings &gt; Battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎾᏍᏊ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᎠᎾᎦᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Additional call forwarded.">
                <langSet xml:lang="en-US"><tig><term>Additional call forwarded.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏙᏔᏅ ᏪᏯᎾ ᎠᎬᏱᏗᏜ ᏙᏛᏂᎩᏍᏔᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select an app">
                <langSet xml:lang="en-US"><tig><term>Select an app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ Ꭰ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="See lights on the edges when you receive calls, notifications, and alerts">
                <langSet xml:lang="en-US"><tig><term>See lights on the edges when you receive calls, notifications, and alerts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ ᏓᏨᏍᏛ ᎤᎿᎢ ᏥᎩ ᎠᏍᏛᎢ ᎢᏳᏃ ᏂᎯ ᎦᏁᏍᏗ ᏓᏯᏂ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᏗᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure your phone is lying flat.">
                <langSet xml:lang="en-US"><tig><term>Make sure your phone is lying flat.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎠᏝᎥ ᎠᏯᏖᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Once it starts ringing, lift it completely off of the surface.">
                <langSet xml:lang="en-US"><tig><term>Once it starts ringing, lift it completely off of the surface.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊᏊ ᎨᎡᎢ ᎠᏂᎩᏍᏗ ᎤᏁᏍᏔᎫ, ᏗᏌᎳᏙᏗ ᎨᎡᎢ ᎠᎧᎵᏬᎯ ᎠᏍᏚᏗ ᎤᎿ ᏥᎩ ᎦᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learning your pattern">
                <langSet xml:lang="en-US"><tig><term>Learning your pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᎬ ᏂᏨᎤᎢ ᎤᎾᎶᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device doesn't support Moto Actions">
                <langSet xml:lang="en-US"><tig><term>Your device doesn't support Moto Actions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏝᏍᏗ ᎠᏂᎫᏍᏛᎥᏍᎦ Moto ᎾᎾᏛᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can customize edge lights in settings.">
                <langSet xml:lang="en-US"><tig><term>You can customize edge lights in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏤᎲᏍᏙᏗ ᎤᏟ ᎢᎦᎢ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 30.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 30.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 30</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM Service Provider unlock successful.">
                <langSet xml:lang="en-US"><tig><term>SIM Service Provider unlock successful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎠᏂᏐᎭᎾᎳᎩ ᏄᏓᏄᎸᏅᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Prevent the screen from dimming or going to sleep while you\’re looking at it">
                <langSet xml:lang="en-US"><tig><term>Prevent the screen from dimming or going to sleep while you\’re looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏗᎪᎯᏍᏓ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎯᏍᎪᎸᏓ ᎠᎴ ᏓᏰᏏ ᎾᎿᎢ ᎦᏟᏔᏗᏍᎩ ᎾᎯᏳᎢ ᏂᎯ ᎨᎡᎩᎠᎦᏖᏃᎲᎩ ᎤᎿᎢ ᎨᎡᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To adjust volume, tap and release the volume up and down keys">
                <langSet xml:lang="en-US"><tig><term>To adjust volume, tap and release the volume up and down keys</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᏓᏁᏟᏴᏍᎩ ᎤᏃᏴᎬᎢ, ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎴ ᏓᏲᏍᏒ ᏥᎩ ᎤᏃᏴᎬᎢ ᎦᎸᎳᏗ ᎠᎴ ᎡᎳᏗ ᏗᏍᏚᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a password">
                <langSet xml:lang="en-US"><tig><term>Set a password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎯᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Access for Swipe to shrink">
                <langSet xml:lang="en-US"><tig><term>Access for Swipe to shrink</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏴᏍᏗᎢ ᎤᎬᏩᏟ ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎯᏍᏗᎪᎯᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can exit this mode in 3 ways:">
                <langSet xml:lang="en-US"><tig><term>You can exit this mode in 3 ways:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎪᏢᏗ ᎾᎿ 3 ᏱᏗᎬᏁᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off the display">
                <langSet xml:lang="en-US"><tig><term>Turn off the display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᏥᎩ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Instead of on screen buttons, use the One Button Nav to navigate.">
                <langSet xml:lang="en-US"><tig><term>Instead of on screen buttons, use the One Button Nav to navigate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏫᏳᏎᏍᏗ ᎾᎿ ᎤᎿᎢ ᎠᏰᏙᎳᏛᎢ ᏗᏐᎥᏍᏙᏗ, ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎾᎿᎢ ᎠᏂᎩᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable Moto Actions on the following screen to grant access.">
                <langSet xml:lang="en-US"><tig><term>Enable Moto Actions on the following screen to grant access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ Moto ᎾᎾᏛᏁᎲᎢ ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᏩᏴᏍᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Vibrate on all navigation gestures">
                <langSet xml:lang="en-US"><tig><term>Vibrate on all navigation gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᏗ ᎤᎿᎢ ᏂᎦᏓ ᎠᏱᎴᎩ ᏧᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can exit this mode in 5 ways:">
                <langSet xml:lang="en-US"><tig><term>You can exit this mode in 5 ways:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎪᏢᏗ ᎾᎿ 5 ᏱᏗᎬᏁᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 98.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 98.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 98</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't save screenshot">
                <langSet xml:lang="en-US"><tig><term>Can't save screenshot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎯᏍᏆᏂᎪᏓ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shutter sound">
                <langSet xml:lang="en-US"><tig><term>Shutter sound</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᎲᏍᎩ ᎤᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge lights appear for alerts, notifications, and more.">
                <langSet xml:lang="en-US"><tig><term>Edge lights appear for alerts, notifications, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᏗᏨᏍᏗ ᎬᏂᎨᏒᎢ ᎤᎬᏩᏟ ᏗᏓᏕᏯᏔᎲᏍᎩ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Reach for your device to trigger Moto Display">
                <langSet xml:lang="en-US"><tig><term>Reach for your device to trigger Moto Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏙᏯᏅᎯᏗᏍᏗ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎪᏣᏁᏍᏗᎢ Moto ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t ask again">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t ask again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᎠᏓᏛᏗ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Too many incorrect attempts. This work profile and its data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>Too many incorrect attempts. This work profile and its data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏍᏈᏯ ᏂᏚᏳᎪᏛᎾ ᎠᏁᏗᏍᎪᎢ. ᎯᎠ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎾᎿ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Pick up the phone to silence the ringer during an incoming call">
                <langSet xml:lang="en-US"><tig><term>Pick up the phone to silence the ringer during an incoming call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏖᏍᏗ ᏥᎩ ᏗᏟᏃᎮᏗ ᎾᎿᎢ ᎾᏍᎩ ᎡᎷᏪ ᏅᎦ ᎦᏃᏟᏍᏗᏍᎩ ᎾᎯᏳ ᎦᎷᎬ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edit and customize your screenshot with helpful tools">
                <langSet xml:lang="en-US"><tig><term>Edit and customize your screenshot with helpful tools</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᎠᎴ ᎠᏤᎲᏍᏙᏗ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎬᏗ ᎠᎵᏍᏕᎵᏍᎩ ᏗᎬᏔᏂᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device learns your charging patterns and predicts how long it\’s usually plugged in.">
                <langSet xml:lang="en-US"><tig><term>Your device learns your charging patterns and predicts how long it\’s usually plugged in.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᏧᎾᎶᎢᏓ ᎠᎴ ᎨᏴ ᏩᎪᏩᏛᏗ ᏙᎡᎵ ᎢᎪᎯᏓ ᎨᎡᎢ ᎤᏠᏱᎭ ᎠᏍᏚᏙᏗ ᎾᎿ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After establishing a pattern, it charges the battery to  and then waits to charge the final  until shortly before you unplug.">
                <langSet xml:lang="en-US"><tig><term>After establishing a pattern, it charges the battery to  and then waits to charge the final  until shortly before you unplug.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᎠᏃᏢᏍᎬ Ꭰ ᎤᎾᎶᎢᏓ, ᎨᎡᎢ ᏓᎬᏩᎶᏗᏍᎬ ᏥᎩ ᎠᎾᎦᎵᏍᎩ ᎾᎿᎢ  ᎠᎴ ᎾᏉᏃ ᎯᎦᏘᏓ ᎾᎿᎢ ᎬᏂᏗᏍᏔᏅᎢ ᏥᎩ ᎤᎵᏍᏆᏛᎯ  ᎩᎳ ᏂᎪᎯᎸᎾᏉ ᎠᏏᏅ ᏂᎯ ᎫᏓᎴᏍᎪ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Checking for Firmware update.">
                <langSet xml:lang="en-US"><tig><term>Checking for Firmware update.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᎠ ᎤᎬᏩᏟ Firmware ᏗᎪᏢᎯᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can use simple gestures to get around your device.">
                <langSet xml:lang="en-US"><tig><term>Now you can use simple gestures to get around your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯᏰᎵᏯ ᏄᏦᏍᏛᎾ ᎤᏬᏯᏂᏍᎩ ᎾᎿᎢ ᎠᎩᏍᏗ ᎠᏕᏯᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe for the previous app">
                <langSet xml:lang="en-US"><tig><term>Swipe for the previous app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎤᎬᏩᏟ ᏥᎩ ᏧᏩᎫᏔᏅ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When Optimized charging is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.">
                <langSet xml:lang="en-US"><tig><term>When Optimized charging is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ, ᏂᎯ ᎠᏎ ᎠᎪᏩᏛᏗ  ᎾᎿ ᏥᎩ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᎠᎴ Ꭰ ᎠᏓᏃᏣᎳᏁᎯ ᎠᏎ ᎦᎭᏛᏗ ᎾᎿᎢ ᏥᎩ ᏩᎦᎸᎳᏗᏴ ᎾᎿ ᏂᏨᎤᎢ ᎠᏓᏃᏣᎳᏁᎯ ᏓᏎᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RUIM Service Provider unlock successful.">
                <langSet xml:lang="en-US"><tig><term>RUIM Service Provider unlock successful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RUIM ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎠᏂᏐᎭᎾᎳᎩ ᏄᏓᏄᎸᏅᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Reducing the time spent charging over  puts less strain on your battery.">
                <langSet xml:lang="en-US"><tig><term>Reducing the time spent charging over  puts less strain on your battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎳᎨ ᏥᎩ ᎠᏟᎢᎵᏒ ᎤᏂᏩᏒᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎢᏴᏛ  ᏫᏓᎲᏍᎬ ᎦᏲᎵᎨ ᎢᏥᎿᏐᎸᏗᏍᎩ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Pressing the power key opens the home screen or last used app once a face is matched">
                <langSet xml:lang="en-US"><tig><term>Pressing the power key opens the home screen or last used app once a face is matched</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏐᎥᏍᏗᏍᎬ ᏥᎩ ᎤᎵᏂᎩᏗᏳ ᎤᎵᏍᎨᏗ ᏓᏍᏚᎢ ᏥᎩ ᎣᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᎣᏂ ᎬᏔᏅᎢ ᎬᏙᏗ ᏌᏊᏊ Ꭰ ᎧᏁᏉᏍᏗᏍᎬ ᎨᎡᎢ ᎠᎵᎪᏔᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show me how">
                <langSet xml:lang="en-US"><tig><term>Show me how</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎠᏯ ᏙᎡᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 102.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 102.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 102</term></tig></langSet>
            </termEntry>
            <termEntry id="Access Do Not Disturb configuration API.">
                <langSet xml:lang="en-US"><tig><term>Access Do Not Disturb configuration API.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᏄᏍᏛ ᎪᏢᏒᎢ API</term></tig></langSet>
            </termEntry>
            <termEntry id="Notifications to discover new features.">
                <langSet xml:lang="en-US"><tig><term>Notifications to discover new features.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏓᏃᏣᎳᏁᎯ ᎾᎿᎢ ᎤᎦᏚᏂᏙᎯ ᏗᏤ ᏗᎦᏎᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To capture a screenshot, touch and hold anywhere on the screen with 3 of your fingertips spread slightly apart.">
                <langSet xml:lang="en-US"><tig><term>To capture a screenshot, touch and hold anywhere on the screen with 3 of your fingertips spread slightly apart.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᏂᏴᏗ Ꭰ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ, ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᏂᎬᏉ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ 3 ᎾᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᎦᏅᎯᏗᏍᎩ ᎠᏰᎦᎸᏛ ᏍᏗᎩᏓ ᏂᏚᏓᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Having trouble?">
                <langSet xml:lang="en-US"><tig><term>Having trouble?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎲᎢ ᎤᏪᎵᎯᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="You can revisit the tutorial in Moto Actions.">
                <langSet xml:lang="en-US"><tig><term>You can revisit the tutorial in Moto Actions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎦᏁᏟᏴᏍᏗ ᏥᎩ ᎠᏓᏕᏲᎲᏍᎩ ᎾᎿ Moto ᎾᎾᏛᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wait for the phone to ring and then lift it up.">
                <langSet xml:lang="en-US"><tig><term>Wait for the phone to ring and then lift it up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎦᏘᏓ ᎤᎬᏩᏟ ᏥᎩ ᏗᏟᏃᎮᏗ ᎤᎿᎢ ᎤᏁᏍᏔᎫ ᎠᎴ ᎾᏉᏃ ᎠᏌᎳᏙᏗ ᎨᎡᎢ ᎦᎸᎳᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The ringer will switch to vibrate.">
                <langSet xml:lang="en-US"><tig><term>The ringer will switch to vibrate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏧᏃᏴᎦ ᎠᏎ ᎦᏁᏟᏴᏍᏗ ᎾᎿᎢ ᎠᎵᏖᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature may not work with some third party calling apps.">
                <langSet xml:lang="en-US"><tig><term>This feature may not work with some third party calling apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏰᎵᏯ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎬᏗ ᎢᎦᏓ ᏦᎢᏁ ᎤᎾᏓᏟᏌᎲ ᏓᏯᏂᏍᎬ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎠᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to shrink activation notification">
                <langSet xml:lang="en-US"><tig><term>Swipe to shrink activation notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎯᏍᏗᎪᎯᏍᏓ ᎠᎴᏅᏙᏗ ᎠᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You must enable face unlock before using this feature.">
                <langSet xml:lang="en-US"><tig><term>You must enable face unlock before using this feature.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᏎ ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏏᏅ ᎬᏗᎭ ᎯᎠ ᎤᏩᎬᏗᏗᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For Attentive Display to work, Moto Actions needs permission to use your camera so it knows when you’re looking at the screen.">
                <langSet xml:lang="en-US"><tig><term>For Attentive Display to work, Moto Actions needs permission to use your camera so it knows when you’re looking at the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ, Moto ᎾᎾᏛᏁᎲᎢ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏗᏓᏟᎶᏍᏗᏍᎩ ᏓᏛ ᎨᎡᎢ ᎠᏂᎦᏔᎭ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎠᎦᏙᏍᏛ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can easily block disruptions when you need a little peace and quiet">
                <langSet xml:lang="en-US"><tig><term>Now you can easily block disruptions when you need a little peace and quiet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᏰᎵᏯ ᎠᎯᏓ ᎦᏐᎭᎾᎳ ᎠᏲᏍᏔᏅᎯ ᎢᏳᏃ ᏂᎯ ᎤᏚᎸᏓ Ꭰ ᎤᏍᏗ ᏅᏩᏙᎯᏯᏓ ᎠᎴ ᎡᏝᏪᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use an HDMI or USB-C cable to connect to a PC">
                <langSet xml:lang="en-US"><tig><term>Use an HDMI or USB-C cable to connect to a PC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ Ꭰ HDMI ᎠᎴ USB-C ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᎾᎿᎢ ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ PC</term></tig></langSet>
            </termEntry>
            <termEntry id="Navigate through your phone using just one button">
                <langSet xml:lang="en-US"><tig><term>Navigate through your phone using just one button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏗ ᎠᎦᏛᎴᏍᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎬᏗᎭ ᏚᏳᎪᏛᏉ ᏌᏇ ᎦᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please go to the permissions settings in App Info to grant it.">
                <langSet xml:lang="en-US"><tig><term>Please go to the permissions settings in App Info to grant it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ Ꭷ ᏥᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏕᎦᎧᎲᎢ ᎾᎿ ᎬᏙᏗ ᎧᏃᎮᏢᏗ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎨᎡᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera permission must be enabled to use Moto Actions.">
                <langSet xml:lang="en-US"><tig><term>Camera permission must be enabled to use Moto Actions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏟᎶᏍᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎠᏎ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ Moto ᎾᎾᏛᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notifications outside of categories.">
                <langSet xml:lang="en-US"><tig><term>Notifications outside of categories.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏓᏃᏣᎳᏁᎯ ᏙᎢᏗᏢ ᎾᎿᎢ ᏗᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe from left to right on the One Button Navigation.">
                <langSet xml:lang="en-US"><tig><term>Swipe from left to right on the One Button Navigation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎦᏍᎦᏂ ᎾᎿᎢ ᎠᎦᏘᏏ ᎤᎿᎢ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please, manually grant access to Swipe to shrink.">
                <langSet xml:lang="en-US"><tig><term>Please, manually grant access to Swipe to shrink.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ, ᎣᏩᏌ ᏱᎬᏁᏗ ᎭᎵᏍᎪᎸᏓ ᎠᏴᏍᏗ ᎾᎿᎢ ᎯᏅᎦᎵᏓ ᎾᎿᎢ ᎯᏍᏗᎪᎯᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to shrink must have permission to display over other apps to work.">
                <langSet xml:lang="en-US"><tig><term>Swipe to shrink must have permission to display over other apps to work.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎾᎿᎢ ᎯᏍᏗᎪᎯᏍᏓ ᎠᏎ ᎤᎭ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿᎢ ᎠᏓᏴᎳᏛᏍᎩ ᎢᏴᏛ ᏐᎢ ᏗᎬᏙᏗ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down to the left or right to make the screen smaller for one-handed use">
                <langSet xml:lang="en-US"><tig><term>Swipe down to the left or right to make the screen smaller for one-handed use</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎡᎳᏗ ᎾᎿᎢ ᏥᎩ ᎠᎦᏍᎦᏂ ᎠᎴ ᎠᎦᏘᏏ ᎾᎿᎢ ᎪᏢᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎠᏲᎵᎨ ᎤᎬᏩᏟ ᏌᏇ-ᏭᏓᏁᎸᎩ ᎬᏔᏂᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The light pattern here is shown when you receive a notification">
                <langSet xml:lang="en-US"><tig><term>The light pattern here is shown when you receive a notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎢᎦᎯ ᎤᎾᎶᎢᏓ ᎠᎭᏂ ᎨᎡᎢ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎢᏳᏃ ᏂᎯ ᎦᏁᏍᏗ Ꭰ ᎠᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Share or delete">
                <langSet xml:lang="en-US"><tig><term>Share or delete</term></tig></langSet>
