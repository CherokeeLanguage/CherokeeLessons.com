                <langSet xml:lang="chr"><tig><term>ᎤᏚᎸᏓ ᎾᎿᎢ ᏍᏓᏟᏃᎮᏗ ᏂᎯ ᎢᎸᏨ ᏑᎾᎴ ᏓᎾᏠᏍᎬᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="NOT NOW">
                <langSet xml:lang="en-US"><tig><term>NOT NOW</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏃᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Built-in connection service">
                <langSet xml:lang="en-US"><tig><term>Built-in connection service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏫᏂ-ᏂᎬᏅᏛ ᎫᏓᎸᎢ ᎢᏯᏓᏛᏁᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="This feature needs permission to access your app usage so it can improve device performance with AI.">
                <langSet xml:lang="en-US"><tig><term>This feature needs permission to access your app usage so it can improve device performance with AI.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᏗᏴᏍᏗ ᏣᏤᎵ ᎬᏙᏗ ᎬᏗᏍᎩ ᎾᏍᎩ ᏰᎵᏊ ᎪᏢᎯᏐᏗ ᏥᏂᎬᏅᏗᏓᎾ ᏧᎸᏫᏍᏓᏁᎯ ᎬᏗ   ᎬᏴᏍᏗ ᏕᎦᏅᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn off Do Not Disturb, find missed notifications by swiping down from the top of your screen.">
                <langSet xml:lang="en-US"><tig><term>When you turn off Do Not Disturb, find missed notifications by swiping down from the top of your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎯᏍᏚᏅ ᎮᏍᏗ ᎠᏓᏕᏯᏙᏗ, ᎯᏩᏔ ᎦᏅᏛᎢ ᏗᏓᏃᏟᎳᏁᎯ ᎬᏗ ᎦᏅᎦᏗᏍᎬ ᎡᎳᏗᏟ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎦᏚᎢ ᎥᎿᎢ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't erase SIM">
