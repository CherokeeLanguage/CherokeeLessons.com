                <langSet xml:lang="chr"><tig><term>ᏍᏓ ᎠᏍᏚᎭ ᏯᎵᏍᏚᎢ ᎤᏩᏌ Ꮎ ᏥᏂᎬᏅᏗᏓᎾ ᏚᎬᏮᏢᎾ ᏂᎦᏓ ᏯᏩᏛᎢ ᎠᎴ Ꮎ ᏚᏅᏓᏁᏤᎸ ᏳᎵᏍᏆᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Phone Protect app works if the equipment is is subject to monthly payments of any amount or under a financial contract.">
                <langSet xml:lang="en-US"><tig><term>The Phone Protect app works if the equipment is is subject to monthly payments of any amount or under a financial contract.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏝᏃᎮᏗ ᎠᏓᏍᏕᎸᏗ ᎬᏙᏗ ᏳᏚᎸᏫᏍᏓᏏ Ꮎ ᎠᏔᏂᏓᏍᏗ  ᏏᏅᏗ ᏴᏈᏱᎭ ᏍᏊ ᏂᎦᏓ ᏂᎨᏒᎾ ᏱᎩ ᏦᏪᎳᏅᎢ ᏦᎯᏛᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="In case of default payment, the equipment may be locked.">
                <langSet xml:lang="en-US"><tig><term>In case of default payment, the equipment may be locked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏒᏈᏴᏓ ᏂᎨᏒᎾ ᎨᏎᏍᏗ,  ᏍᏓᏯ ᏯᏂᏍᏚᎲᎦ Ꮎ ᏍᏔᏂᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once the due payment is made, the device will be unlcoked for use.">
                <langSet xml:lang="en-US"><tig><term>Once the due payment is made, the device will be unlcoked for use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎲᏈᏴᎭᏃ Ꮎ ᎡᏍᏚᎬᎢ,  ᏥᏂᎬᏅᏗᏓᏂ ᏯᏂᏍᏚᎠ ᏴᎲᏓ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For more information, please contact your mobile operator.">
                <langSet xml:lang="en-US"><tig><term>For more information, please contact your mobile operator.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏳᎪᏓ ᎠᏓᏃᎯᏎᎯ, ᏫᎵᏃᎮᏓ Ꮎ ᎠᏂᎩᏍᎩ ᎠᎯᎵᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change your privacy preferences anytime by going to Settings &gt; Privacy &gt; Motorola privacy.">
                <langSet xml:lang="en-US"><tig><term>You can change your privacy preferences anytime by going to Settings &gt; Privacy &gt; Motorola privacy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏕᎯᏁᏟᏴᎾ Ꮎ ᎤᏕᎵᏓ ᎤᏥᎠᏰᎸᏍᎬᎢ ᏣᏚᎵᏍᎬᏊ ᏕᎦᎧᎲᎢ ᏳᏫᏣᎷᏣ&gt;ᎤᏕᎵᏓ&gt;Motorola ᎤᏕᎵᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some carrier features may not be avaliable without location access.">
                <langSet xml:lang="en-US"><tig><term>Some carrier features may not be avaliable without location access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᏓᏂᏙ ᏄᎾᏍᏗᏓᏅ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎨᏐ ᏄᏍᏛᎾ ᏱᎩ ᎮᏙᎲ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your carrier occasionally requires location data to improve its services and analytics.">
                <langSet xml:lang="en-US"><tig><term>Your carrier occasionally requires location data to improve its services and analytics.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᏣᏂᏙ ᎤᏚᎵᎰ ᏯᏓᎲ ᎮᏙᎲ ᎦᏟᏌᏅ ᏓᏤᏢ ᎢᏳᎾᏓᏛᏁᏗᎢ ᎠᎴ ᏓᏤᏢ ᏗᎪᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app may want to access your location all the time, even when you're not using the app. Tap Allow all the time in settings.">
                <langSet xml:lang="en-US"><tig><term>This app may want to access your location all the time, even when you're not using the app. Tap Allow all the time in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏉ ᏳᏚᎳ ᎤᏴᏍᏗ ᏣᏤᎵ ᎤᏙᏢᏒᎢ ᎾᏍᎩ ᏂᎪᎯᎸᎢ, ᎥᏍᏊ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ\u2019 ᎥᏝᏃ ᏅᏗᏍᎬᎾ ᎾᏍᎩ ᎬᏙᏗ. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᏂᎪᎯᎸᎢ ᎾᎿᎢ ᎦᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Settings &gt; Location &gt; Carrier Location Access.">
                <langSet xml:lang="en-US"><tig><term>Settings &gt; Location &gt; Carrier Location Access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ &gt; ᎤᏙᏢᏒᎢ &gt; ᎠᎯᏙᎯ ᎤᏙᏢᏒᎢ ᎬᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app may want to access your location all the time, please tap &quot;While using the app&quot; and then &quot;Allow all the time&quot; in settings.">
                <langSet xml:lang="en-US"><tig><term>This app may want to access your location all the time, please tap "While using the app" and then "Allow all the time" in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏉ ᏳᏚᎳ ᎤᏴᏍᏗ ᏣᏤᎵ ᎤᏙᏢᏒᎢ ᎾᏍᎩ ᏂᎪᎯᎸᎢ, ᎰᏩᏊ ᎤᏟᏍᏓ ᎠᏒᏂᎸ "ᎾᎯᏳᎢ ᏅᏗᏍᎬᎾ ᎾᏍᎩ ᎬᏙᏗ" ᎠᎴ ᎾᏉᏃ "ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᏂᎪᎯᎸᎢ" ᎾᎿᎢ ᎦᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
