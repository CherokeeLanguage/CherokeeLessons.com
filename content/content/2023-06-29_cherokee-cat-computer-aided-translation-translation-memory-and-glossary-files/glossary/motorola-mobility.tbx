            </termEntry>
            <termEntry id="Allows the app to access extra location provider commands. This may allow the app to interfere with the operation of the GPS or other location sources.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to access extra location provider commands. This may allow the app to interfere with the operation of the GPS or other location sources.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᏴᏍᏗ ᎧᏁᏉᏓ ᎤᏙᏢᏒᎢ ᎠᏓᏁᎸᏍᎩ ᏕᏁᏤᎸᎩ. ᎯᎠ ᏰᎵᏉ ᏯᎵᏍᎪᎸᏓ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᏲᏍᏙᏓ ᎬᏗ ᎾᏍᎩ ᏱᎬᏁᏗᎢ ᎥᎿᎢ GPS ᎠᎴᏃ ᏐᎢ ᎤᏙᏢᏒᎢ ᏙᏧᏓᎴᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't sync">
                <langSet xml:lang="en-US"><tig><term>Can't sync</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎢᏧᎳᎭ ᏥᏄᎵᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="take pictures and videos in the background">
                <langSet xml:lang="en-US"><tig><term>take pictures and videos in the background</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵᎶᏍᏓ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎾᎿᎢ ᎣᎾᏗᏢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery Saver turns on Dark theme and limits or turns off background activity, some visual effects, certain features, and some network connections.">
                <langSet xml:lang="en-US"><tig><term>Battery Saver turns on Dark theme and limits or turns off background activity, some visual effects, certain features, and some network connections.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎯᏍᏚᎢ Dark ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᏃᎴ ᏗᏎᎸᎯ ᏃᎴ ᎠᏍᏚᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎾᏛᏁᎲ, ᎢᎦᏓ ᏓᏟᎶᏍᏛ ᏄᎵᏍᏔᏅ, ᏑᏓᎴᎩ ᏗᎦᏎᏍᏙᏗ, ᏃᎴ ᎢᎦᏓ ᏧᎾᏚᏓᎵ ᏓᎵᎪᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Never">
                <langSet xml:lang="en-US"><tig><term>Never</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Includes personal data such as credit card numbers and passwords.">
                <langSet xml:lang="en-US"><tig><term>Includes personal data such as credit card numbers and passwords.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏚᏠᏯᏍᏗ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᏕᎧᏁᎢᏍᏔᏅᎯ ᎤᎾᏓᏚᎬ ᏆᎾᏲᏍᏗ ᏗᏎᏍᏗ ᏃᎴ ᏗᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" does not support the current Display size setting and may behave unexpectedly.">
                <langSet xml:lang="en-US"><tig><term> does not support the current Display size setting and may behave unexpectedly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏝᏍ ᏕᎦᎫᏍᏛᏁᎭ ᏥᎩ ᏃᏊ ᏥᎩ ᎠᏓᏴᎳᏛᏍᎩ ᎢᎩᏓ ᎨᏒ ᏕᎦᎧᎲᎢ ᏃᎴ ᏰᎵᏉ ᎠᎳᏏᎾᎯᏍᏙᏗ ᏅᎦᏖᏃᎲᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Contact your IT admin to learn more">
                <langSet xml:lang="en-US"><tig><term>Contact your IT admin to learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ IT ᎤᎦᏎᏍᏗᏕᎩ ᎾᎿᎢ ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will collect information about your current device state, to send as an e-mail message. It will take a little time from starting the bug report until it is ready to be sent; please be patient.">
                <langSet xml:lang="en-US"><tig><term>This will collect information about your current device state, to send as an e-mail message. It will take a little time from starting the bug report until it is ready to be sent; please be patient.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎦᏟᏌᏅᎩ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᏂᏨᏅᎢ ᏃᏊ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏗᏓᏅ, ᎾᎿᎢ ᏫᎦᏅᏗ ᎯᎢᎾᎢ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏗᎦᏃᏣᎳᏅᎯ. ᎾᏍᎩ ᎠᏎ ᎠᎩᏍᏗ ᎤᏍᏗ ᎠᏥᎢᎵᏒ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏂᎩᏍᏗᏍᎬᎢ ᏥᎩ ᏗᎦᎾᏩᎵ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎩᎳ ᎠᏎᏃ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎨᏒᎩ ᏭᏅᏅᎢ; ᎰᏩᏊ ᎨᏒᎩ ᎤᏢᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="access sensor data about your vital signs">
                <langSet xml:lang="en-US"><tig><term>access sensor data about your vital signs</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᎠᏩᏘᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎢᎸᏨ your ᏭᎵᏍᎨᏗᏴᎢ ᏗᎪᏪᎳᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera in use">
                <langSet xml:lang="en-US"><tig><term>Camera in use</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎡᎤᎿᎢ ᎬᏔᏂᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to retrieve information about currently and recently running tasks. This may allow the app to discover information about which applications are used on the device.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to retrieve information about currently and recently running tasks. This may allow the app to discover information about which applications are used on the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᏢᏔᏍᏗ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᏃᏊ ᏥᎩ ᏃᎴ ᎾᏞᎬ ᎠᏂᎩᏍᏓ ᎢᏗᏛᏁᏗ. ᎯᎠ ᏰᎵᏉ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎤᎦᏚᏂᏙᎯ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᎾᏍᎩᏃ ᏗᎬᏙᏗ ᎨᏒᎢ ᎬᏔᏅᎯ ᎤᎾᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can record audio using the microphone at any time.">
                <langSet xml:lang="en-US"><tig><term>This app can record audio using the microphone at any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏯ ᏕᎦᏅᏅᏛᎢ ᎤᏃᏴᎬ ᎬᏗᎭ ᏥᎩ ᎦᏬᏂᎯᏍᏙᏗ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to disable the keylock and any associated password security. For example, the phone disables the keylock when receiving an incoming phone call, then re-enables the keylock when the call is finished.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to disable the keylock and any associated password security. For example, the phone disables the keylock when receiving an incoming phone call, then re-enables the keylock when the call is finished.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎿᎢ ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᏥᎩ ᎠᏍᏚᎢᏍᏗ ᏓᎦᏏ ᏃᎴ ᎾᏂᎥᏉ ᏚᎵᎪᏒᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎤᎦᏎᏍᏗ. ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᏥᎩ ᏗᏟᏃᎮᏗ ᏗᎬᏙᏗ ᏂᎨᏒᎾ ᏥᎩ ᎠᏍᏚᎢᏍᏗ ᏓᎦᏏ ᎢᏳᏃ ᎠᎩᏍᎬᎢ Ꭰ ᎦᎷᎦ ᏗᏟᏃᎮᏗ ᏪᏯᎾ, ᎿᏉᏃ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ ᏥᎩ ᎠᏍᏚᎢᏍᏗ ᏓᎦᏏ ᏂᎨᏒᎾ ᏥᎩ ᏪᏯᎾ ᏄᏍᏛ ᎤᏂᏍᏆᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You have incorrectly attempted to unlock your Android TV device  times. After  more unsuccessful attempts, your Android TV device will be reset to factory default and all user data will be lost.">
                <langSet xml:lang="en-US"><tig><term>You have incorrectly attempted to unlock your Android TV device  times. After  more unsuccessful attempts, your Android TV device will be reset to factory default and all user data will be lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏂᏚᏳᎪᏛᎾ ᎤᎾᏁᎶᏔᏅᎯ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᏅᎢ Android TV ᏥᏂᎬᏅᏗᏓᎾ  ᎢᏳᏩᏗ. ᎣᏂᏗᏢ  ᎤᎪᏗᏊ ᎥᏝ ᎤᏁᎸᏙᏗ, ᏂᏨᏅᎢ Android TV ᏥᏂᎬᏅᏗᏓᎾ ᎨᏎᏍᏗ ᏥᎯᎧᎲᎦ ᎾᎿᎢ ᎪᎱᏍᏗ ᎤᏃᏢᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏃᎴ ᏂᎦᏓ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎤᏂᏲᎱᏎᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify the data about your contacts stored on your Android TV device. This permission allows apps to delete contact data.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify the data about your contacts stored on your Android TV device. This permission allows apps to delete contact data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎤᏃᏒᎯᏐᏗ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᎠᏍᏆᏂᎪᏗ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏓᎵᏍᎪᎸᏓᏁᎲ ᏗᎬᏙᏗ ᎾᎿᎢ ᎠᏍᎪᎸᏗᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read data about your contacts stored on your tablet. Apps will also have access to the accounts on your tablet that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read data about your contacts stored on your tablet. Apps will also have access to the accounts on your tablet that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎠᎪᎵᏰᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎪᏪᎶᏙᏗ. ᏗᎬᏙᏗ ᎠᏎᎢ ᎾᏍᏊ ᎤᎮᏍᏗ ᎤᏴᏍᏗᎢ ᎾᎾᎢ ᎾᏍᎩ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏣᏤᎵ ᎪᏪᎶᏙᏗ ᎾᏍᎩᎾᎢ ᎾᏍᎩ ᏧᏬᏢᏅᎢ ᏗᏟᏃᎮᏙᏗ. ᎯᎠ ᏰᎵᏉ ᎠᏠᏯᏍᏗ ᏗᏚᏓᎸᏙᏗ ᎪᏢᏅᎯ ᎬᏗ ᏗᎬᏙᏗ ᏂᎯ EᏘᏅᏔᏅᎢ. ᎯᎠ ᏗᎵᏍᎪᎸᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎠᎳᏏᏅᏗᏍᎪ ᏣᏤᎵ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ, ᏃᎴ ᎤᏁᎫᏥᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎠᏯᏙᎯᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᏂᏣᏅᏛᎾᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone not allowed for voice">
                <langSet xml:lang="en-US"><tig><term>Phone not allowed for voice</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎭᏗ ᎠᎵᏍᎪᎸᏔᏅ ᏱᎩ ᎾᏍᎩᎾ ᎤᏁᎢᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to call phone numbers without your intervention. This may result in unexpected charges or calls. Note that this doesn't allow the app to call emergency numbers. Malicious apps may cost you money by making calls without your confirmation.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to call phone numbers without your intervention. This may result in unexpected charges or calls. Note that this doesn't allow the app to call emergency numbers. Malicious apps may cost you money by making calls without your confirmation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏪᏯᎾ ᏗᏟᏃᎮᏗ ᏗᏎᏍᏗ ᎾᏠᏯᏍᏗᏍᎬᎾ ᏂᏨᎤᎢ ᎤᎾᎵᏍᏕᎸᎯᏢ. ᎯᎠ ᏰᎵᏉ ᏄᎵᏍᏔᏅ ᎾᎿ ᏅᎦᏖᏃᎲᎾ ᏓᎬᏩᎶᏛ ᏃᎴ ᏗᏪᏯᎾ. ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ ᎥᏍᎩᎾ ᎯᎠ ᎥᏝ ᏯᎵᏍᎪᎸᏗ ᏥᎫ ᎬᏙᏗ ᎾᎿᎢ ᏪᏯᎾ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏗᏎᏍᏗ. ᎤᏁᎫᏣᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᏧᎵᎬᏩᎳᏅᎯ ᏂᎯ ᎠᏓᎴᏍᎩᏱᏍᎩ ᎬᏗ ᎪᏢᏍᎦ ᏗᏪᏯᎾ ᎾᏠᏯᏍᏗᏍᎬᎾ ᏂᏨᎤᎢ ᎦᎫᏍᏛᏗᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can\u2019t verify face. Try again.">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t verify face. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎰᎯᏳᏓ ᎧᏁᏉᏍᏗᏍᎬ. ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" attachments saved to &quot;&quot; album">
                <langSet xml:lang="en-US"><tig><term> attachments saved to "" album</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏓᏠᏯᏍᏛᎢ ᎠᎵᏏᏅᏔᏅᎢ ᎾᎿᎢ "" ᎠᏜᏩᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="You haven't started any projects yet.">
                <langSet xml:lang="en-US"><tig><term>You haven't started any projects yet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎥᏝᏃ ᎤᏓᎴᏅᎲᎢ ᏱᎩ ᏂᎦᎥ ᎢᏗᏛᏁᏗ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Projects">
                <langSet xml:lang="en-US"><tig><term>Projects</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can read all calendar events stored on your Android TV device and share or save your calendar data.">
                <langSet xml:lang="en-US"><tig><term>This app can read all calendar events stored on your Android TV device and share or save your calendar data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎠᎪᎵᏰᏗ ᏂᎦᏓ ᏅᏓ ᏗᏎᏍᏗ ᏂᏕᎦᎵᏍᏔᏂᏙᎲ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᎠᏯᏙᎯᏍᏗ ᎠᎴᏃ ᎠᎳᏏᏅᏙᏗ ᏣᏤᎵ ᏅᏓ ᏗᏎᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission to access the Checkin Provider">
                <langSet xml:lang="en-US"><tig><term>Permission to access the Checkin Provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᏩᏴᏍᏗᎢ ᏥᎩ ᏥᏅᏂᎦ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can read all calendar events stored on your phone and share or save your calendar data.">
                <langSet xml:lang="en-US"><tig><term>This app can read all calendar events stored on your phone and share or save your calendar data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎠᎪᎵᏰᏗ ᏂᎦᏓ ᏅᏓ ᏗᏎᏍᏗ ᏂᏕᎦᎵᏍᏔᏂᏙᎲ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏃᎴ ᎠᏯᏙᎯᏍᏗ ᎠᎴᏃ ᎠᎳᏏᏅᏙᏗ ᏣᏤᎵ ᏅᏓ ᏗᏎᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data status">
                <langSet xml:lang="en-US"><tig><term>Mobile data status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="GNSS Time Update Service">
                <langSet xml:lang="en-US"><tig><term>GNSS Time Update Service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>GNSS ᎠᏥᎢᎵᏒ ᎪᏢᎯᏐᏗ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Visit a repair provider.">
                <langSet xml:lang="en-US"><tig><term>Visit a repair provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏩᏛᎯᏓᏍᏗ ᎣᏍᏓ ᏱᎬᏗᎢ ᎠᏓᏁᎸᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows write access to edge/power touch app content provider">
                <langSet xml:lang="en-US"><tig><term>Allows write access to edge/power touch app content provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᎪᏪᎶᏗ ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᎠᏍᏛᎢ/ᎤᏬᏯᏂᏍᎩ ᎬᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎬᏙᏗ ᏄᏍᏗᏓᏅ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Just bump it">
                <langSet xml:lang="en-US"><tig><term>Just bump it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᏋ ᎤᏩᏍᏔᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="RUIM Service Provider unlock request un successful.">
                <langSet xml:lang="en-US"><tig><term>RUIM Service Provider unlock request un successful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RUIM ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎦᏐᎭᎾᎳᎩᏍᏗ ᎠᏔᏲᎯᎭ ᎤᏓᏄᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase the tablet's data without warning by performing a factory data reset.">
                <langSet xml:lang="en-US"><tig><term>Erase the tablet's data without warning by performing a factory data reset.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᏗᎪᏪᎶᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏓᏕᏯᏔᎲᏍᎬᎢ ᏂᎨᏒᎾ ᎾᎢ ᏚᎸᏫᏍᏓᏁᎲ ᏄᎬᏫᏳᏒ ᎢᎦᎧᎯᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can read all calendar events stored on your tablet and share or save your calendar data.">
                <langSet xml:lang="en-US"><tig><term>This app can read all calendar events stored on your tablet and share or save your calendar data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎠᎪᎵᏰᏗ ᏂᎦᏓ ᏅᏓ ᏗᏎᏍᏗ ᏂᏕᎦᎵᏍᏔᏂᏙᎲ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎾᎢ ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᏃᎴ ᎠᏯᏙᎯᏍᏗ ᎠᎴᏃ ᎠᎳᏏᏅᏙᏗ ᏣᏤᎵ ᏅᏓ ᏗᏎᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not enough storage for the system. Make sure you have 250MB of free space and restart.">
                <langSet xml:lang="en-US"><tig><term>Not enough storage for the system. Make sure you have 250MB of free space and restart.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᏂᎦᎭ ᎠᏍᏆᏂᎪᏙᏗ ᎾᏍᎩ ᏂᏕᎬᏅᎩ. ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯ ᏣᎮᏍᏗ 250MB ᎥᎿᎢ ᎠᏎᏊᎢ ᎤᏜᏅᏛᎯ ᏃᎴ ᏥᎭᏂᎩᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The following one or more apps request permission to access your account, now and in the future.">
                <langSet xml:lang="en-US"><tig><term>The following one or more apps request permission to access your account, now and in the future.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏍᏓᏩᏛᏍᏗ ᏌᏊ ᎠᎴᏃ ᎤᏥ ᎢᎦᎢ ᏗᎬᏙᏗ ᎠᏔᏲᏍᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᏣᏤᎵ ᎠᏚᏓᎸᏗ, ᏃᏊ ᏃᎴ ᎾᎿᎢ ᎾᏍᎩ ᎤᏩᎫᏗᏗᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read the history of all URLs that the Browser has visited, and all of the Browser's bookmarks. Note: this permission may not be enforced by third-party browsers or other applications with web browsing capabilities.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read the history of all URLs that the Browser has visited, and all of the Browser's bookmarks. Note: this permission may not be enforced by third-party browsers or other applications with web browsing capabilities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᎪᎵᏰᏗ ᎾᏍᎩ ᏂᏧᎵᏍᏔᏅᏒ ᎥᎿᎢ ᏂᎦᏓ URLs ᎾᏍᎩᎾᎢ ᎠᏍᏚᎢᏍᎩ ᏄᏩᏅᎢ ᎤᏓᏩᏛᎯᏙᎸᎩ, ᏃᎴ ᏂᎦᏓ ᎾᏍᎩ ᎠᏍᏚᎢᏍᎩ ᏄᏩᏅᎢ ᏗᎪᏪᎵ ᏗᏩᏛᏙᏗ. ᎤᏍᏗ ᎪᏪᎸ: ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏰᎵᏉ ᎨᏍᏗ ᏰᎵ ᎦᏌᏙᏴᎢ ᎨᏒ ᏦᎢᏁ-ᎤᎾᏓᏟᏌᎲ ᏗᏍᏚᎢᏍᎩ ᎠᎴᏃ ᏐᎢ ᎠᏔᏲᏍᏙᏗ ᎬᏗ ᎤᏂᎳᏛᎢ ᏓᏍᏚᎢᏍᎬᎢ ᏰᎵ ᎢᏯᏛᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to make use of foreground services.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to make use of foreground services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏱᎬᏗᎭ ᏱᎪᏢᏍᎦ ᎬᏔᏂᏓᏍᏗ ᎾᎿ ᎠᎬᏱᏗᏨ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network subset service provider unlock PIN">
                <langSet xml:lang="en-US"><tig><term>Network subset service provider unlock PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ subset ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎠᏂᏐᎭᎾᎳᎩ PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Monitor the number of incorrect passwords typed when unlocking the screen, and lock your Android TV device or erase all this user's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed when unlocking the screen, and lock your Android TV device or erase all this user's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎵᏛᏍᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎾᏍᎩ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᏗᏐᏅᏍᏔᏅᎯ ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏰᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ your Android TV ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᎯᎠ ᎬᏗᏍᎩ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏳᏃ ᎤᎪᏗᏗ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᎾᏍᎩ ᏗᏐᏅᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't play this video.">
                <langSet xml:lang="en-US"><tig><term>Can't play this video.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎬᏩᏁᎸᏙᏗ ᏱᎩ ᎯᎠ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow an application or service access to system cameras to take pictures and videos">
                <langSet xml:lang="en-US"><tig><term>Allow an application or service access to system cameras to take pictures and videos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ Ꭰ ᎬᏙᏗ ᏃᎴ ᎢᏯᏓᏛᏁᏗ ᎠᏴᏍᏗ ᏥᎩ ᏄᏍᏗᏓᏅᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏥᎩ ᎠᎩᏍᏗ ᏗᏟᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't send message with unknown carrier, error ">
                <langSet xml:lang="en-US"><tig><term>Can't send message with unknown carrier, error </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᏫᏅᎥᎦ ᏗᎦᏃᏣᎳᏅᎯ ᎬᏗ ᏅᎪᎵᎬᎾ ᎠᏫᏗᏍᎩ, ᏓᏓᎴᎬᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Drag the icon to the fingerprint to open the notification curtain">
                <langSet xml:lang="en-US"><tig><term>Drag the icon to the fingerprint to open the notification curtain</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏏᏅᏍᏗ ᎾᏍᎩ ᎠᎢᎧᏂ ᎾᏍᎩ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎾᎢ ᎠᏍᏚᎢᏍᏓ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto-delete messages older than ">
                <langSet xml:lang="en-US"><tig><term>Auto-delete messages older than </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ-ᎠᏍᎪᎸᏗᏍᏗ ᏗᎪᎵᏰᏗ ᎤᏓᏂᎳᎨ ᎡᏍᎦᏉ </term></tig></langSet>
            </termEntry>
            <termEntry id="Can\u2019t use fingerprint sensor">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t use fingerprint sensor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏰᎵu2019t ᎬᏔᏂᏓᏍᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not disturb">
                <langSet xml:lang="en-US"><tig><term>Do not disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify the Browser's history or bookmarks stored on your Android TV device. This may allow the app to erase or modify Browser data. Note: this permission may note be enforced by third-party browsers or other applications with web browsing capabilities.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify the Browser's history or bookmarks stored on your Android TV device. This may allow the app to erase or modify Browser data. Note: this permission may note be enforced by third-party browsers or other applications with web browsing capabilities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏍᏆᎳ ᎢᎬᏁᏗ ᏥᎩ ᏗᏍᏚᎢᏍᎩ ᏂᏧᎵᏍᏔᏅᏒ ᎤᎿ ᎪᏪᎵ ᎠᏩᏛᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎾᎿ ᏂᏨᎤᎢ Android TV ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᏰᎵᏉ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏛᏍᏍᎪᎸᏥ ᎤᎿ ᏍᏆᎳ ᎢᎬᏁᏗ ᏗᏍᏚᎢᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ. ᎤᏍᏗ ᎪᏪᎸ: ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏰᎵᏉ ᎤᏍᏗ ᎪᏪᎸ ᎨᏒᎩ ᎦᏌᏙᏯᏍᎩ ᎬᏗ ᏦᎢᏁ-ᎤᎾᏓᏟᏌᎲ ᏗᏍᏚᎢᏍᎩ ᎤᎿ ᏐᎢ ᏗᎬᏙᏗ ᎬᏗ ᎤᏂᎳᏛᎢ ᏓᏍᏚᎢᏍᎬ ᏰᎵ ᎢᏯᏛᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t capture accurate face data. Try again.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t capture accurate face data. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ\u2019t ᎦᏂᏴᏗ ᎧᎵ ᏗᏙᎳᎩ ᎧᏁᏉᏍᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ. ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not disturb">
                <langSet xml:lang="en-US"><tig><term>Do not disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to text input mode for the time input.">
                <langSet xml:lang="en-US"><tig><term>Switch to text input mode for the time input.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎢ ᎪᏪᎳᏅᎢ ᎦᏬᎯᎵᏴᏍᏗ ᎬᏙᏗᎭ ᎾᏍᎩᎾ ᎠᏥᎢᎵᏒ ᎦᏬᎯᎵᏴᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data paused for the rest of your cycle">
                <langSet xml:lang="en-US"><tig><term>Data paused for the rest of your cycle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᏲᎯᏍᏔᏅ ᎾᏍᎩ ᎠᏟᏱᎵᏒᎢ ᏣᏤᎵ ᎿᏛᏁᎵᏙᎲᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data">
                <langSet xml:lang="en-US"><tig><term>Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Easy unlock">
                <langSet xml:lang="en-US"><tig><term>Easy unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏓ ᎦᏐᎭᎾᎳᎩᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="New: Do Not Disturb is hiding notifications">
                <langSet xml:lang="en-US"><tig><term>New: Do Not Disturb is hiding notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏤ: ᎭᏗ ᎠᏓᏕᏯᏙᏗ ᎾᏍᎩ ᎥᏍᎦᏢᏍᎬ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to sample sensor data at a rate greater than 200 Hz">
                <langSet xml:lang="en-US"><tig><term>Allows the app to sample sensor data at a rate greater than 200 Hz</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏱᏓᏟᎶᏍᏔᏂ ᎠᏩᏘᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ Ꭰ ᎠᎦᏈᏴᎡᎲᎢ ᏭᏔᏅ 200 Hz</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to wake up Peek Display">
                <langSet xml:lang="en-US"><tig><term>Tap to wake up Peek Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏗ ᎾᎢ ᏱᏰᏍᏗ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="in  m">
                <langSet xml:lang="en-US"><tig><term>in  m</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ  m</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi data limit reached">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi data limit reached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎢ-ᏈᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ ᏭᎷᏨᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use this under most circumstances. It allows you to track progress of the report, enter more details about the problem, and take screenshots. It might omit some less-used sections that take a long time to report.">
                <langSet xml:lang="en-US"><tig><term>Use this under most circumstances. It allows you to track progress of the report, enter more details about the problem, and take screenshots. It might omit some less-used sections that take a long time to report.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎯᎠ ᎭᏫᏂᏗᏢ ᎤᎪᏗᏗ ᏂᏚᏍᏗᏓᏅᎢ. ᎾᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᎪᎷᏅᏍᏗ ᎠᎵᏱᎵᏒ ᎾᏍᎩ ᎬᏂᎨᏒ ᎢᎬᏁᏗ, ᎠᏴᏍᏓ ᎤᏥ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ ᏄᏰᎵᏛ ᎾᏍᎩ ᏓᏓᎴᎬ, ᏃᎴ ᎯᏂᏴᏓ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ. ᎾᏍᎩ ᎡᎵᏊ ᎪᏣᎴᏍᏗ ᎢᎦᏓ ᎦᏲᎵᎨ-ᎬᏔᏂᏓᏍᏗ ᏚᏓᏡᎬ ᎾᏍᎩᎾᎢ ᎠᎩᏍᏗ ᎪᎯᎩ ᎬᏂᎨᏒ ᎢᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Monitor the number of incorrect passwords typed when unlocking the screen, and lock your Android TV device or erase all your Android TV device's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed when unlocking the screen, and lock your Android TV device or erase all your Android TV device's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎦᏎᏍᏗᏕᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎥᎿᎢ ᏂᏚᏳᎪᏛᎾ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᏗᏐᏅᏍᏔᏅᎩ ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏰᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎥᎿᏃ ᎾᏍᎩ ᎤᏣᏖ ᏂᏚᏳᎪᏛᎾ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎨᏒᎢ ᏗᏐᏅᏍᏔᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify the data about your contacts stored on your phone. This permission allows apps to delete contact data.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify the data about your contacts stored on your phone. This permission allows apps to delete contact data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏍᏆᎳ ᎢᎬᏁᏗ ᏥᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎢᎸᏨ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎾᎿ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ. ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏓᎵᏍᎪᎸᏓᏁᎲ ᏗᎬᏙᏗ ᎾᎿᎢ ᎠᏍᎪᎸᏗᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify the system's settings data. Malicious apps may corrupt your system's configuration.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify the system's settings data. Malicious apps may corrupt your system's configuration.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎤᏃᏢᎯᏐᏗᏱ ᏥᎩ ᏄᏍᏗᏓᏅᎢ ᏕᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ. ᎤᏁᎫᏣᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎤᏐᏅᎢ ᏂᏨᏅᎢ ᏄᏍᏗᏓᏅᎢ ᏄᏍᏛ ᎪᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read data about your contacts stored on your phone. Apps will also have access to the accounts on your phone that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read data about your contacts stored on your phone. Apps will also have access to the accounts on your phone that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎠᎪᎵᏰᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᏗᏟᏃᎮᏗ. ᏗᎬᏙᏗ ᎠᏎᎢ ᎾᏍᏊ ᎤᎮᏍᏗ ᎤᏴᏍᏗᎢ ᎾᎾᎢ ᎾᏍᎩ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎾᏍᎩᎾᎢ ᎾᏍᎩ ᏧᏬᏢᏅᎢ ᏗᏟᏃᎮᏙᏗ. ᎯᎠ ᏰᎵᏉ ᎠᏠᏯᏍᏗ ᏗᏚᏓᎸᏙᏗ ᎪᏢᏅᎯ ᎬᏗ ᏗᎬᏙᏗ ᏂᎯ EᏘᏅᏔᏅᎢ. ᎯᎠ ᏗᎵᏍᎪᎸᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎠᎳᏏᏅᏗᏍᎪ ᏣᏤᎵ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ, ᏃᎴ ᎤᏁᎫᏥᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎠᏯᏙᎯᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᏂᏣᏅᏛᎾᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase all data">
                <langSet xml:lang="en-US"><tig><term>Erase all data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id=" has used more data than usual">
                <langSet xml:lang="en-US"><tig><term> has used more data than usual</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ ᎤᏥ ᎢᎦᎢ ᎦᏘᏍᎩᏌᏅᎯ ᏏᏃ ᎤᏠᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to create network sockets and use custom network protocols. The browser and other applications provide means to send data to the internet, so this permission is not required to send data to the internet.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to create network sockets and use custom network protocols. The browser and other applications provide means to send data to the internet, so this permission is not required to send data to the internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎪᏒᏗ ᏧᎾᏚᏓᎵ ᏗᎫᏓᎸᏗᎢ ᏃᎴ ᎬᏙᏓ ᏄᏍᏛᎢᏯᏛᏁᏗᎢ ᏧᎾᏚᏓᎵ ᏗᎧᏃᏩᏛᏍᏗ. ᎾᏍᎩᏃ ᎠᏍᏚᎢᏍᎩ ᏃᎴ ᏐᎢ ᏗᏔᏲᏍᏙᏗ ᎠᏓᏁᎳᏁᏗ ᏕᎦᏛᎢ ᎾᎢ ᏫᎦᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᎠᏏᎳᏕᏫᏒᎢ, ᎯᎠᏃ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎭᏗ ᎠᏎᏯᏛᏁᏗ ᏱᎩ ᎾᎢ ᏫᎦᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sending message to : . Time: .">
                <langSet xml:lang="en-US"><tig><term>Sending message to : . Time: .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎦᏅᎥᏍᎬᎢ ᏗᎦᏃᏣᎳᏅᎯ ᎾᎿᎢ : . ᎠᏥᎢᎵᏒ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to change your Android TV device's time zone.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to change your Android TV device's time zone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᎤᎬᏩᏟ Android TV ᏥᏂᎬᏅᏗᏓᎾ ᎠᏥᎢᎵᏒ ᎠᏎᏢᎢ</term></tig></langSet>
            </termEntry>
