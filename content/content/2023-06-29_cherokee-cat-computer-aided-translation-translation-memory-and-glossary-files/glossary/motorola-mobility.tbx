            </termEntry>
            <termEntry id="You’ll still hear alarms in Do Not Disturb mode.">
                <langSet xml:lang="en-US"><tig><term>You’ll still hear alarms in Do Not Disturb mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᏎ ᏙᎢ ᎢᏣᏛᎬᎦ ᏗᏓᏕᏯᏙᏗᏍᎩ ᎾᎿ ᏞᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make the screen smaller with a simple swipe">
                <langSet xml:lang="en-US"><tig><term>Make the screen smaller with a simple swipe</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎠᏂᎦᏲᎵᎨᏃ ᎬᏗ Ꭰ ᏄᏦᏍᏛᎾ ᎦᎶᎯᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shrink the screen by swiping down from the center to the bottom right or left corner">
                <langSet xml:lang="en-US"><tig><term>Shrink the screen by swiping down from the center to the bottom right or left corner</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏗᎪᎯᏍᏓ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎬᏗ ᎦᎶᎯᏍᏗᏍᎩ ᎡᎳᏗᏢ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎠᏰᏟ ᎾᎿᎢ ᏥᎩ ᎡᎳᏗᏢ ᎠᎦᏘᏏ ᎠᎴ ᎠᎦᏍᎦᏂ ᎤᏅᏏᏴ</term></tig></langSet>
            </termEntry>
            <termEntry id="USB Webcam Mode">
                <langSet xml:lang="en-US"><tig><term>USB Webcam Mode</term></tig></langSet>
