                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᎪᏩᏛᏗ ᏃᎴ ᎠᎯᎸᏍᏗ ᏂᎬᏯᎢᏒ ᏫᏗᎬᏔᏅᎢ ᎤᎾᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᏧᏓᏠᏯᏍᏗ ᎧᏃᎸᎥᏍᎩ ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᏫᎬᏙᏗ ᏗᏎᏍᏗ ᎾᏍᎩᎾ ᏫᏗᎬᏙᏗ ᏃᎴ ᎾᏍᎩ ᏗᎪᏏᏐᏗ ᎥᎿᎢ ᎾᏍᎩ ᏫᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM service provider unlock PIN">
                <langSet xml:lang="en-US"><tig><term>SIM service provider unlock PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎠᏂᏐᎭᎾᎳᎩ PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Create a PIN for modifying restrictions">
                <langSet xml:lang="en-US"><tig><term>Create a PIN for modifying restrictions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᎾᏍᎩ PIN ᎾᏍᎩᎾ ᎠᏃᏢᎯᏏᏍᎬ ᏗᏓᏲᏍᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Access Persistent User Data">
                <langSet xml:lang="en-US"><tig><term>Access Persistent User Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᏂᏓᏓᏲᏍᎬᎾ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="What’s new in Android 11">
                <langSet xml:lang="en-US"><tig><term>What’s new in Android 11</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎤᏍᏗ ᎢᏤ ᎾᎿᎢ Android 11</term></tig></langSet>
            </termEntry>
            <termEntry id="What’s new in Android 12">
                <langSet xml:lang="en-US"><tig><term>What’s new in Android 12</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎤᏍᏗ ᎢᏤ ᎾᎿᎢ Android 12</term></tig></langSet>
            </termEntry>
            <termEntry id="Make text larger or smaller">
                <langSet xml:lang="en-US"><tig><term>Make text larger or smaller</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᎪᏪᎳᏅᎢ ᎡᏉᎯᎨᏍᏙᏗ ᎠᎴ ᎠᏂᎦᏲᎵᎨᏃ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data limit reached">
                <langSet xml:lang="en-US"><tig><term>Mobile data limit reached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ ᏭᎷᏨᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read data about your contacts stored on your Android TV device. Apps will also have access to the accounts on your Android TV device that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read data about your contacts stored on your Android TV device. Apps will also have access to the accounts on your Android TV device that have created contacts. This may include accounts created by apps you have installed. This permission allows apps to save your contact data, and malicious apps may share contact data without your knowledge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏍᎾᎩ ᎬᏙᏗ ᎠᎪᎵᏰᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏰᎵᏛ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᏓᏍᏆᏂᎪᏛ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᏗᎬᏙᏗ ᎠᏎ ᎾᏍᏊ ᎤᎭ ᎤᏴᏍᏗ ᎾᏍᎩ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏣᏤᎵ Android ᎠᏓᏴᎳᏛᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩᎢ ᎤᏂᎭ ᎤᏬᏢᏗᎢ ᏗᏟᏃᎮᏙᏗ. ᎯᎠ ᏰᎵᏉ ᎠᏠᏯᏍᏓ ᏗᏚᏓᎸᏙᏗ ᎪᏢᏅᎢ ᏄᏩᏅ ᏗᎬᏙᏗ ᎯᎠ ᎯᏘᏅᏛᎦ. ᎯᎠ ᏗᎵᏍᎪᎸᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎠᎳᏏᏅᏗᏍᎪ ᏣᏤᎵ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ, ᏃᎴ ᎤᏁᎫᏥᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎠᏯᏙᎯᏍᏗ ᎠᏟᏃᎮᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᏂᏣᏅᏛᎾᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Type in time">
                <langSet xml:lang="en-US"><tig><term>Type in time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᎾᎿ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can\u2019t use fingerprint sensor. Visit a repair provider">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t use fingerprint sensor. Visit a repair provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ. ᎠᏩᏛᎯᏓᏍᏗ ᎣᏍᏓ ᏱᎬᏗᎢ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to learn the screen lock complexity level (high, medium, low or none), which indicates the possible range of length and type of the screen lock. The app can also suggest to users that they update the screen lock to a certain level but users can freely ignore and navigate away. Note that the screen lock is not stored in plaintext so the app does not know the exact password.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to learn the screen lock complexity level (high, medium, low or none), which indicates the possible range of length and type of the screen lock. The app can also suggest to users that they update the screen lock to a certain level but users can freely ignore and navigate away. Note that the screen lock is not stored in plaintext so the app does not know the exact password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᏕᎶᏆᏍᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᏓ ᎤᏦᎠᏎᏗ ᎠᏥᎶᏍᎩ (ᎦᎸᎳᏗ, ᎠᏰᎵᏊ ᎢᏴ, ᎡᎳᏗ ᎠᎴᏃ ᎧᏂᎩᏓ), ᎦᏙᎤᏍᏗ ᏗᏓᏎᎮᏗ ᎾᏍᎩ ᏱᎬᏩᎵᏍᏙᏗ ᎢᎬᎾᏕᎾ ᎥᎿᎢ ᎢᎦᏅᎯᏓ ᏃᎴ ᎢᏳᏍᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᏓ. ᎾᏍᎩᏃ ᎬᏙᏗ ᏰᎵᏊ ᎾᏍᏊ ᎧᏁᎢᏍᏙᏗ ᎾᎢ ᏗᏅᏗᏍᎩ ᎾᏍᎩᎾᎢ ᎪᏢᎯᏐᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᎢ ᏑᏓᎴᎩ ᎠᏥᎶᏍᎩ ᎠᏎᏃ ᎬᏗᏍᎩ ᏰᎵᏊ ᏄᏚᏓᎸᎾ ᎾᎦᏎᏍᏔᏅᎾ ᏃᎴ ᎤᏤᎵᏛ ᎠᏂᎩᏍᏗ. ᎤᏍᏗ ᎪᏪᎸ ᎾᏍᎩᎾᎢ ᎠᏴᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᏍᎩ ᏤᏍᏗ ᏯᏍᏆᏂᎪᏓ ᎾᎿᎢ ᏄᏦᏍᏛᎾ ᎪᏪᎳᏅᎢ ᎾᏍᎩᎾᏃ ᎬᏙᏗ ᏤᏍᏗ ᏳᎾᏛ ᎾᏍᎩ ᏗᏙᎳᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to determine whether WiMAX is enabled and information about any WiMAX networks that are connected.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to determine whether WiMAX is enabled and information about any WiMAX networks that are connected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᎢᏳᏃ WiMAX ᏄᏍᏛ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᏃᎴ ᎧᏃᎮᏢᏗ ᎢᎸᏨ ᎾᏂᎥᏉ WiMAX ᏚᎾᏚᏓᎵ ᎥᏍᎩᎾ ᎨᏒᎢ ᎫᏓᎸᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions.">
                <langSet xml:lang="en-US"><tig><term>Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏓ ᏧᏬᏯᏂᏍᎩ ᎠᎴ ᎠᏒᏂᏍᏗ ᏓᏔᎳᏗᏍᎬᎩ ᎠᏓᏍᏕᎵᏍᎩ  ᏂᎯ ᎢᏯᏛᏁᏗ ᏧᎩᏨᏅᏓ ᎢᏗᏛᏁᏗ ᎤᏠᏯᏍᏗ ᎤᏟᏍᏓ ᎠᎴ ᎠᎴ ᎠᏕᎳᎰᏍᎩ ᏗᏓᏅᏏᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You have incorrectly attempted to unlock the tablet  times. After  more unsuccessful attempts, the tablet will be reset to factory default and all user data will be lost.">
                <langSet xml:lang="en-US"><tig><term>You have incorrectly attempted to unlock the tablet  times. After  more unsuccessful attempts, the tablet will be reset to factory default and all user data will be lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏂᏚᏳᎪᏛᎾ ᎤᎾᏁᎶᏔᏅᎯ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏗᏟᏃᎮᏗ  ᎢᏳᏩᏗ. ᎣᏂᏗᏢ  ᎤᎪᏗᏊ ᎥᏝ ᎤᏁᎸᏙᏗ, ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎨᏎᏍᏗ ᏥᎯᎧᎲᎦ ᎾᎿᎢ ᎪᎱᏍᏗ ᎤᏃᏢᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏃᎴ ᏂᎦᏓ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎤᏂᏲᎱᏎᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Requesting Network subset service provider unlock\u2026">
                <langSet xml:lang="en-US"><tig><term>Requesting Network subset service provider unlock\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏔᏲᎯᎲᎢ ᎠᏏᏕᎳᏫᏒᎢ ᏗᎪᏪᎵ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎠᏓᏁᎸᏍᎩ ᎠᏂᏐᎭᎾᎳᎩ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Monitor the number of incorrect passwords typed. when unlocking the screen, and lock the phone or erase all the phone's data if too many incorrect passwords are typed.">
                <langSet xml:lang="en-US"><tig><term>Monitor the number of incorrect passwords typed. when unlocking the screen, and lock the phone or erase all the phone's data if too many incorrect passwords are typed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎦᏎᏍᏗᏕᎩ ᎾᏍᎩ ᎠᏎᏍᏗ ᎾᏍᎩ ᏂᏚᏳᎪᏛᎾ ᎥᎧᏁᎬᎢ ᏗᏍᏚᎢᏍᏙᏗ ᏗᏐᏅᏍᏔᏅᎩ. ᎾᎯᏳ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ, ᏃᎴ ᏍᏓᏯ ᎠᏍᏚᏓ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᎠᎴᏃ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᏄᏩᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎢᏳᏃ ᎾᏍᎩ ᎤᏣᏘ ᏂᏚᏳᎪᏛᎾ ᎠᏴᏍᏙᏗ ᏱᏗᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᏗᏐᏅᏍᏔᏅᎩ ᎨᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="What’s new in Android 10">
                <langSet xml:lang="en-US"><tig><term>What’s new in Android 10</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎤᏍᏗ ᎢᏤ ᎾᎿᎢ Android 10</term></tig></langSet>
            </termEntry>
            <termEntry id="Set time">
                <langSet xml:lang="en-US"><tig><term>Set time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to clock mode for the time input.">
                <langSet xml:lang="en-US"><tig><term>Switch to clock mode for the time input.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎢ ᏩᏥ ᎬᏙᏗᎭ ᎾᏍᎩᎾ ᎠᏥᎢᎵᏒ ᎦᏬᎯᎵᏴᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase user data">
                <langSet xml:lang="en-US"><tig><term>Erase user data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the holder to bind to the top-level interface of a notification listener service. Should never be needed for normal apps.">
                <langSet xml:lang="en-US"><tig><term>Allows the holder to bind to the top-level interface of a notification listener service. Should never be needed for normal apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᏧᏂᏴᎯ ᎾᎢ ᏔᎸᏍᏓ ᎾᏍᎩ ᎦᏚ-ᎠᏥᎶᏍᎩ ᏧᎾᏓᎦᏙᏍᏗ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏛᏓᏍᏗᏍᎩ ᎢᏯᏓᏛᏁᏗ. ᎢᏳᏗᎾ ᎢᎸᎯᏳᎢ ᎨᏒᎢ ᎤᏚᎸᏛ ᎾᏍᎩᎾ ᏱᎬᏩᏍᏗᎭᏭ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can't change the caller ID setting.">
                <langSet xml:lang="en-US"><tig><term>You can't change the caller ID setting.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎦᏁᏟᏴᏍᏗ ᏥᎩ ᎠᏰᎵᏍᎩ ID ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use this option for minimal system interference when your device is unresponsive or too slow, or when you need all report sections. Does not allow you to enter more details or take additional screenshots.">
                <langSet xml:lang="en-US"><tig><term>Use this option for minimal system interference when your device is unresponsive or too slow, or when you need all report sections. Does not allow you to enter more details or take additional screenshots.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎯᎠ ᎠᏑᏰᏍᏗ ᎾᏍᎩᎾ ᏭᏍᏗᎬᏊ ᏄᏍᏗᏓᏅᎢ ᎠᏲᏍᏗᏍᎩ ᎾᎯᏳ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩ ᎬᏩᏁᏍᏗ ᏂᎨᏒᎾ ᎬᏩᏁᏍᏗ ᏂᎨᏒᎾ ᎠᎴᏃ ᎾᏍᎩ ᎤᏍᎦᏃᎳ, ᎠᎴᏃ ᎾᎯᏳ ᏂᎯ ᎤᏚᎸᏓ ᏂᎦᏓ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏚᏓᏡᎬᎢ. ᎥᏝ ᏯᎵᏍᎪᎸᏗ ᏂᎯ ᎠᏴᏍᏗ ᎤᏥ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ ᎠᎴᏃ ᎠᎩᏍᏗ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="add or modify calendar events and send email to guests without owners' knowledge">
                <langSet xml:lang="en-US"><tig><term>add or modify calendar events and send email to guests without owners' knowledge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎠᎴᏃ ᎤᏃᏒᎯᏐᏗ ᏅᏓ ᏗᏎᏍᏗ ᏂᏕᎦᎵᏍᏔᏂᏙᎲ ᏃᎴ ᏫᎦᏅᏓ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᎾᎢ ᏗᎾᏓᏩᏛᎯᏙᎯ ᎾᏍᎩ ᎤᎾᏤᎵᎢ ᏄᎾᏅᏛᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="You have incorrectly attempted to unlock the tablet  times. After  more unsuccessful attempts, the tablet will be reset to factory default and all user data will be lost.">
                <langSet xml:lang="en-US"><tig><term>You have incorrectly attempted to unlock the tablet  times. After  more unsuccessful attempts, the tablet will be reset to factory default and all user data will be lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏂᏚᏳᎪᏛᎾ ᎤᎾᏁᎶᏔᏅᎯ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏗᏟᏃᎮᏗ  ᎢᏳᏩᏗ. ᎣᏂᏗᏢ  ᎤᎪᏗᏊ ᎥᏝ ᎤᏁᎸᏙᏗ, ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎨᏎᏍᏗ ᏥᎯᎧᎲᎦ ᎾᎿᎢ ᎪᎱᏍᏗ ᎤᏃᏢᏗ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏃᎴ ᏂᎦᏓ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎤᏂᏲᎱᏎᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For better performance, only one of these games can be open at a time.">
                <langSet xml:lang="en-US"><tig><term>For better performance, only one of these games can be open at a time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏓᏤᎳ ᎾᎾᏛᏁᎲ , ᎤᏅᏒ ᏌᏇ ᎤᎿ ᎯᎠᏃ ᏧᎾᏁᎶᏗᎢ ᏰᎵᏊ ᎨᏒᎩ ᎯᏍᏚᎢ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the holder to bind to the top-level interface of a condition provider service. Should never be needed for normal apps.">
                <langSet xml:lang="en-US"><tig><term>Allows the holder to bind to the top-level interface of a condition provider service. Should never be needed for normal apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᏧᏂᏴᎯ ᎾᎢ ᏔᎸᏍᏓ ᎾᏍᎩ ᎦᏚ-ᎠᏥᎶᏍᎩ ᏧᎾᏓᎦᏙᏍᏗ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏛᏓᏍᏗᏍᎩ ᎢᏯᏓᏛᏁᏗ. ᎢᏳᏗᎾ ᎢᎸᎯᏳᎢ ᎨᏒᎢ ᎤᏚᎸᏛ ᎾᏍᎩᎾ ᏱᎬᏩᏍᏗᎭᏭ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen reader primarily for people with blindness and low vision">
                <langSet xml:lang="en-US"><tig><term>Screen reader primarily for people with blindness and low vision</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᎠᎪᎵᏰᏍᎩ ᎠᏂᎨᏫ ᏃᎴ ᏧᏂᏎᎦᏨ ᎠᎪᏩᏛᏗᎢ ᎠᏂᏴᏫ</term></tig></langSet>
            </termEntry>
            <termEntry id="Over your mobile data limit">
                <langSet xml:lang="en-US"><tig><term>Over your mobile data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏬᎯᎳᏗᏍᎬ ᏣᏤᎵ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="App can't open on this display">
                <langSet xml:lang="en-US"><tig><term>App can't open on this display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎨᏍᏗ ᏰᎵ ᎯᏍᏚᎢ ᎤᎿᎢ ᎯᎠ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase this user's data on this tablet without warning.">
                <langSet xml:lang="en-US"><tig><term>Erase this user's data on this tablet without warning.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᎯᎠ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎾᎢ ᎯᎠ ᏗᎪᏪᎶᏗᎢ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏕᏯᏔᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A full restore of all data from a connected desktop computer has been requested. Do you want to allow this to happen\?If you did not request the restore yourself, do not allow the operation to proceed. This will replace any data currently on the device!">
                <langSet xml:lang="en-US"><tig><term>A full restore of all data from a connected desktop computer has been requested. Do you want to allow this to happen\?If you did not request the restore yourself, do not allow the operation to proceed. This will replace any data currently on the device!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎧᎵ ᎪᏢᎯᏐᏗ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎫᏓᎸᏅᎯ ᎦᏍᎩᎶᎩ ᎦᏚ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏗᏔᏲᏢᎩ ᏂᎦᎵᏍᏓ. ᏂᎯᏍᎪ ᏥᏚᎵᎢ ᎾᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎢᏳᎵᏍᏙᏗᎢ\?ᎢᏳᏃ ᏂᎯ ᏝᏃ ᎠᏔᏲᎯᎭ ᎾᏍᎩ ᎪᏢᎯᏐᏗ ᏨᏌᏊ, ᏝᏃ ᎠᏓᎵᏍᎪᎸᏓᏁᎸ ᏱᎩ ᎾᏍᎩ ᎠᎯᎸᏍᏗ ᎾᎢ ᏚᎸᏫᏍᏓᏁᎲᎢ. ᎯᎠ ᎠᏎ ᎦᏁᏟᏴᏍᏓ ᏂᎯᎥ ᎦᏘᏍᎩᏌᏅᎯ ᏃᏊᎨᏒᎢ ᎤᎾᎢ ᏥᏂᎬᏅᏗᏓᎾ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not restore">
                <langSet xml:lang="en-US"><tig><term>Do not restore</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᏥᎰᏢᎯᏌᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Restore my data">
                <langSet xml:lang="en-US"><tig><term>Restore my data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᎯᏐᏗ ᎠᏆᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you wish to encrypt the full backup data, enter a password below:">
                <langSet xml:lang="en-US"><tig><term>If you wish to encrypt the full backup data, enter a password below:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎤᏚᎩ ᏱᏨᎭ ᎾᎢ ᎠᏕᎵᏍᏔᏅᎯ ᎾᏍᎩ ᎧᎵ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ, ᎠᏴᏍᏓ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter your device encryption password below. This will also be used to encrypt the backup archive.">
                <langSet xml:lang="en-US"><tig><term>Please enter your device encryption password below. This will also be used to encrypt the backup archive.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏕᎵᏍᏙᏗ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ. ᎯᎠ ᎠᏎ ᎾᏍᏊ ᎨᏒᎩ ᎬᏔᏅᎯ ᎾᎢ ᎠᏕᎵᏍᏔᏅᎯ ᎾᏍᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏗᎪᏪᎳ ᏓᏍᏆᏂᎪᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A full backup of all data to a connected desktop computer has been requested. Do you want to allow this to happen\?If you did not request the backup yourself, do not allow the operation to proceed.">
                <langSet xml:lang="en-US"><tig><term>A full backup of all data to a connected desktop computer has been requested. Do you want to allow this to happen\?If you did not request the backup yourself, do not allow the operation to proceed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎧᎵ ᎠᏍᏃᏂᎪᏗᏍᎩ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎢ ᎫᏓᎸᏅᎢ ᎦᏍᎩᎶᎩ ᎦᏚ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏗᏔᏲᏢᎩ ᏂᎦᎵᏍᏓ. ᏂᎯᏍᎪ ᏥᏚᎵᎢ ᎾᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎢᏳᎵᏍᏙᏗᎢ\?ᎢᏳᏃ ᏂᎯ ᏝᏃ ᎠᏔᏲᎯᎭ ᎾᏍᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏨᏌᏊ, ᏝᏃ ᎠᏓᎵᏍᎪᎸᏓᏁᎸ ᏱᎩ ᎾᏍᎩ ᎠᎯᎸᏍᏗ ᎾᎢ ᏚᎸᏫᏍᏓᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Upload test total time">
                <langSet xml:lang="en-US"><tig><term>Upload test total time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎵᏙᏓ ᎠᎦᏛᏗ ᏂᎦᏛ ᎦᏟᏌᏅ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Since your device is encrypted, you are required to encrypt your backup. Please enter a password below:">
                <langSet xml:lang="en-US"><tig><term>Since your device is encrypted, you are required to encrypt your backup. Please enter a password below:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏳᏓᎴᏅᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩ ᎠᏕᎵᏍᏔᏅ, ᏂᎯ ᎨᏒᎢ ᎠᏎᏯᏛᏁᏗ ᎾᎢ ᎠᏕᎵᏍᏔᏅᎯ ᏣᏤᎵ ᎠᏍᏆᏂᎪᏗᏍᎩ. ᎰᏩᏊ ᎠᏴᏍᏓ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter your current backup password below:">
                <langSet xml:lang="en-US"><tig><term>Please enter your current backup password below:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏓ ᏣᏤᎵ ᏃᏊ ᏥᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter a password to use for encrypting the full backup data. If this is left blank, your current backup password will be used:">
                <langSet xml:lang="en-US"><tig><term>Please enter a password to use for encrypting the full backup data. If this is left blank, your current backup password will be used:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏓ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎾᎢ ᎬᏙᏓ ᎾᏍᎩᎾ ᎠᏕᎵᏍᏗᏍᎬᎢ ᎾᏍᎩ ᎧᎵ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ. ᎢᏳᏃ ᎯᎠ ᎾᏍᎩ ᎠᎧᎵᏏᏐᏗ ᎧᏃᎯᏴᎢ, ᏣᏤᎵ ᏃᏊ ᏥᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎠᏎ ᎬᏔᏂᏓᏍᏗ ᎨᏎᏍᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="If the restore data is encrypted, please enter the password below:">
                <langSet xml:lang="en-US"><tig><term>If the restore data is encrypted, please enter the password below:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎾᏍᎩ ᎪᏢᎯᏐᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᎠᏕᎵᏍᏔᏅ, ᎰᏩᏊ ᎠᏴᏍᏗ ᎾᏍᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ:</term></tig></langSet>
            </termEntry>
