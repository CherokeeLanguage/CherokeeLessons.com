            </termEntry>
            <termEntry id="To show the RTT keyboard automatically for every call, go to Settings &gt; Accessibility.">
                <langSet xml:lang="en-US"><tig><term>To show the RTT keyboard automatically for every call, go to Settings &gt; Accessibility.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᏍᎩ RTT ᏗᏐᏅᏍᏙᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎾᏍᎩᎾ ᏂᎦᎥᎢ ᏫᎬᏔᏅ, ᏪᎾ ᏕᎦᎧᎲᎢ &gt; ᎬᏴᏍᏗ ᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The recipient can immediately read your message while it is being written without waiting.">
                <langSet xml:lang="en-US"><tig><term>The recipient can immediately read your message while it is being written without waiting.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏗᎦᏁᏍᎩ ᏰᎵᏊ ᎠᎴᏉ ᎠᎪᎵᏰᏗ ᏣᏤᎵ ᎧᏃᎮᏍᎩ ᎾᎯᏳᎢ ᎾᏍᎩ ᎠᏃᏪᎵᏍᎬ ᏄᏂᎦᏘᏛᎾᏬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT keyboard and Video calling cannot be on at the same time.">
                <langSet xml:lang="en-US"><tig><term>RTT keyboard and Video calling cannot be on at the same time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏗᏐᏅᏍᏙᏗ ᎠᎴ ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏗᏍᎩ Ꮭ ᏰᎵ ᎠᏍᏚᎢᏓ ᎾᎿᎢ ᎾᏍᎩ ᎾᎯᏳᏉ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Also, you will not be able to merge calls.">
                <langSet xml:lang="en-US"><tig><term>Also, you will not be able to merge calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᏉ, ᏂᎯ ᏰᎵᏉ Ꮭ ᏰᎵ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᏓᏠᎯᏍᏛ ᏫᏗᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling setting will be turned off and you will not be able to make or receive video calls.">
                <langSet xml:lang="en-US"><tig><term>Video calling setting will be turned off and you will not be able to make or receive video calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏗᏍᎩ ᏕᎦᎧᎲᎢ ᏰᎵᏉ ᎠᏍᏚᏓ ᎨᏎᏍᏗ ᎠᎴ ᏂᎯ ᏰᎵᏊ Ꮭ ᏰᎵ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᎪᏢᏗ ᎠᎴᏃ ᎠᎩᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show RTT keyboard during calls">
                <langSet xml:lang="en-US"><tig><term>Show RTT keyboard during calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ RTTᏗᏐᏅᏍᏙᏗ ᎾᎯᏳ ᏫᏗᎬᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call ended">
                <langSet xml:lang="en-US"><tig><term>Call ended</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎤᎵᏍᏆᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT sends what you are typing instantly during a phone call, giving you the ability to communicate using texts in real time.">
                <langSet xml:lang="en-US"><tig><term>RTT sends what you are typing instantly during a phone call, giving you the ability to communicate using texts in real time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏫᏗᎦᏅᏍᎩ ᎢᏳᏍᏗ ᏂᎯ ᎨᏒᎢ ᏗᏐᎥᏍᏙᏗ ᎤᎵᏍᏗᏓᏬ ᎾᎯᏳ ᏗᏟᏃᎮᏗ ᏫᎬᏔᏅ, ᎡᏣᏁᎲᎢ ᎾᏍᎩ ᎢᎬᏩᏛᏗ ᎨᏒ ᎾᎢ ᎠᏓᏛᎪᏔᏅ ᎬᏗᏍᎬ ᏗᎪᏪᎳᏅᎢ ᎾᎿᎢ ᎤᏙᎯᏳ ᎠᏟᎢᎵᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You will be able to see partial responses before the entire message is complete.">
                <langSet xml:lang="en-US"><tig><term>You will be able to see partial responses before the entire message is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎡᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎢ ᎠᎪᏩᏛᏗ ᎢᎦᏓᏊ ᏗᎦᏬᎯᎵᏴᏓ ᎤᏓᎷᎸ ᎾᏍᎩ ᎧᎵᏬ ᎧᏃᎮᏍᎩ ᎾᏍᎩ ᎠᏍᏆᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove it from saved list or restart it and try again.">
                <langSet xml:lang="en-US"><tig><term>Remove it from saved list or restart it and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᎾᏕᏍᏗ ᎾᎿ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎵᏏᏅᏔᏅᎢ ᏓᏎᏍᏛᎢ ᎠᎴ ᏥᎭᏂᎩᏍᏓ ᎾᎿ ᎠᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi connection lost.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi connection lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎢ-ᏈᎢ ᎫᏓᎸᎢ ᎤᏲᎱᏎᎸᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enabling RTT">
                <langSet xml:lang="en-US"><tig><term>Enabling RTT</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏯᏛᏁᎲᏍᏗ RTT</term></tig></langSet>
            </termEntry>
            <termEntry id="The person you're talking to must also be using a phone that supports RTT or is connected to a TTY (text telephone) device.">
                <langSet xml:lang="en-US"><tig><term>The person you're talking to must also be using a phone that supports RTT or is connected to a TTY (text telephone) device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎩᎶᎢ ᏂᎯ ᎾᏍᎩ ᏍᏓᏟᏃᏢᎩ ᎾᎢ ᎠᏎ ᎾᏍᏉ ᎨᏒ ᎬᏗᏍᎬ ᏗᏟᏃᎮᏗ ᎾᏍᎩᎾᎢ ᏗᎦᎫᏍᏛᏓ RTT ᎠᎴᏃ ᎫᏓᎸᏅᎢ ᎾᎢ TTY (ᎪᏪᎳᏅᎢ ᏗᎳᏃᎮᏗᎢ) ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Once you enable RTT, the RTT icon will appear on all incoming calls.">
                <langSet xml:lang="en-US"><tig><term>Once you enable RTT, the RTT icon will appear on all incoming calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊ ᏂᎯ ᎡᎵᏊ ᏱᎬᏛᏁᏗ RTT, ᎾᏍᎩ RTT ᎠᎢᎧᏂ ᏰᎵᏉ ᎤᎾᏄᎪᎢᏍᏗ ᎤᎾᎢ ᏂᎦᏓ ᎦᎷᎬ ᏫᏗᎬᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To make AT&amp;T video calls, turn off Airplane mode.">
                <langSet xml:lang="en-US"><tig><term>To make AT&amp;T video calls, turn off Airplane mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏂᏕᎬᎦ AT&amp;T ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ, ᎠᏍᏚᏓ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="What you need to know when using RTT:">
                <langSet xml:lang="en-US"><tig><term>What you need to know when using RTT:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎨᏃ ᏂᎯ ᎤᏚᎸᏓ ᎾᎢ ᎠᎦᏙᎥᏒ ᎾᎯᏳ ᎬᏗᏍᎬ RTT:</term></tig></langSet>
            </termEntry>
            <termEntry id="You will need to be connected to a 4G LTE or Wi-Fi network.">
                <langSet xml:lang="en-US"><tig><term>You will need to be connected to a 4G LTE or Wi-Fi network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏛ ᎾᎢ ᎬᏗ ᎫᏓᎸᏅᎢ ᎾᎢ ᎾᏍᎩ 4G LTE ᎠᎴᏃ ᏫᎢ-ᏈᎢ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT allows you to use text to communicate during a call.">
                <langSet xml:lang="en-US"><tig><term>RTT allows you to use text to communicate during a call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏂᏕᎬᎦ AT&amp;T ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏔᏅᎢ, ᎠᏍᏚᏓ ᏥᏳ ᎦᏃᎯᎵᏙᎯ ᎬᏙᏗᎭ, ᎿᏉᏃ ᎯᏍᏚᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The RTT call button will appear on the dialer.">
                <langSet xml:lang="en-US"><tig><term>The RTT call button will appear on the dialer.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ RTT ᏫᎬᏔᏅ ᎠᏐᏅᏍᏙᏗ ᏰᎵᏉ ᎤᎾᏄᎪᎢᏍᏗ ᎤᎾᎢ ᎾᏍᎩ ᏗᏎᏍᏗ ᏗᏐᎥᏍᏙᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set the RTT call option to &quot;Always Visible&quot; in Settings if you use RTT often.">
                <langSet xml:lang="en-US"><tig><term>Set the RTT call option to "Always Visible" in Settings if you use RTT often.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎾᏍᎩ RTT ᏫᎬᏔᏅ ᎠᏑᏰᏍᏗ ᎾᎢ "ᏂᎪᎯᎸᎢ ᎬᎪᏩᏛᏗ" ᎾᎿᎢ ᏕᎦᎧᎲᎢ ᎢᏳᏃ ᏂᎯ ᎲᏔᏅᎩ RTT ᎢᏳᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Check your rate plan for details.">
                <langSet xml:lang="en-US"><tig><term>Check your rate plan for details.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎦᏛᎲᎦ ᏣᏤᎵ ᎠᏟᎶᏍᏗ ᎠᏍᏓᏩᏛᏍᏗ ᎾᏍᎩᎾ ᏗᎧᏃᎮᏍᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip open to answer">
                <langSet xml:lang="en-US"><tig><term>Flip open to answer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎾᎢ ᎦᏬᎯᎵᏴᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Google Assistant helps you find answers and get things done with just your voice.">
                <langSet xml:lang="en-US"><tig><term>The Google Assistant helps you find answers and get things done with just your voice.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮ ᎪᎣgᎴ ᎠᏍᏏᏍᏔnt ᎮlpᏍ ᏲᎤ fᎢnd ᎠnᏍᏪrᏍ Ꭰnd Ꭸt tᎯngᏍ ᏙᏁ Ꮻth jᎤᏍt ᏲᎤr ᎥᎣᎢcᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect your phone to an external display for immersive entertainment, video chat capability and a powerful desktop experience.">
                <langSet xml:lang="en-US"><tig><term>Connect your phone to an external display for immersive entertainment, video chat capability and a powerful desktop experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᏙᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎾᎿᎢ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ ᏄᏰᎸᏛ ᎦᏃᏴᏘᏍᏦᏗ ᎤᎾᏛᏁᎸᏗ ᎠᏓᏴᎳᏛᏍᎩ, ᏗᏂᏬᏂᏍᎩ ᎦᏬᏂᎯᏍᏗ, ᎾᏍᎩᏯᏊᏃ ᎦᏬᏂᎯᏍᏗ ᎢᎬᏩᏛᏁᏗ ᎠᎴ ᎤᎳᏂᎩᏛ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎠᏓᏴᎳᏛᏍᎩ ᏄᎵᏍᏔᏂᏙᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone must be connected to a 4G LTE or 5G network or a Wi-Fi network while using Wi-Fi Calling.">
                <langSet xml:lang="en-US"><tig><term>Your phone must be connected to a 4G LTE or 5G network or a Wi-Fi network while using Wi-Fi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᏎ ᎨᏎᏍᏗ ᎫᏓᎸᏅᎢ ᎾᎢ 4G LTE ᎠᎴᏃ 5G ᎤᏚᏓᎵ ᎠᎴᏃ Wi-Fi ᎤᏚᏓᎵ ᎾᎯᏳᎢ ᎬᏗᏍᎬ ᏫᎢ-ᏈᎢ ᏫᏗᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Answer incoming calls on flip open">
                <langSet xml:lang="en-US"><tig><term>Answer incoming calls on flip open</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏬᎯᎵᏴᏛ ᎦᎷᎬ ᏫᏗᎬᏔᏅ ᎤᎾᎢ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disconnect call">
                <langSet xml:lang="en-US"><tig><term>Disconnect call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎱᏓᎳᎩ ᏫᎬᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Continue calls even after the flip is closed">
                <langSet xml:lang="en-US"><tig><term>Continue calls even after the flip is closed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒᎢ ᏫᏗᎬᏔᏅ ᎥᏍᏊ ᎤᎶᏐᏅ ᎾᏍᎩ ᏓᏁᏍᏆᏕᎦ ᎾᏍᎩ ᎤᏍᏚᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier Message">
                <langSet xml:lang="en-US"><tig><term>Carrier Message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏙᎯ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The other person will see each letter typed in real time.">
                <langSet xml:lang="en-US"><tig><term>The other person will see each letter typed in real time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᎾᎢ ᎬᏙᏓ ᎪᏪᎳᏅᎢ ᎾᏍᎩ ᎠᏓᏛᎪᏔᏅ ᎾᎯᏳ ᏫᎬᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT includes audio; so mute the call if you don't want to share audio and turn down your volume if you don't want others near you to hear audio.">
                <langSet xml:lang="en-US"><tig><term>RTT includes audio; so mute the call if you don't want to share audio and turn down your volume if you don't want others near you to hear audio.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏗᏠᏯᏍᏓ ᎤᏃᏴᎬ; ᎾᏍᎩ ᎡᎳᏪ ᏫᎬᏔᏅ ᎢᏳᏃ ᏂᎯ ᏝᏍᏗ ᏱᏣᏚᎵ ᎠᏯᏙᎯᏍᏗ ᎤᏃᏴᎬ ᎠᎴ ᎡᎳᏗ ᏱᎬᏁᏗ ᏣᏤᎵ ᎢᎦᎢ ᎤᏃᏴᎬ ᎢᏳᏃ  ᏂᎯ ᏝᏍᏗ ᏱᏣᏚᎵ ᎠᏂᏐᎢ ᎾᎥᎢ ᎤᏁᏓᏍᏗ ᎮᏙᎲᎢ ᎾᎢ ᎤᎾᏔᎪᏗ ᎤᏃᏴᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip close action">
                <langSet xml:lang="en-US"><tig><term>Flip close action</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎲᎦ ᎠᎵᏖᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="End calls unless you're using the speakerphone, a Bluetooth device, or a headset">
                <langSet xml:lang="en-US"><tig><term>End calls unless you're using the speakerphone, a Bluetooth device, or a headset</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏗᏍᏗ ᏫᏗᎬᏔᏅ ᎢᏳᏍᎩᏂ ᏂᎯ ᎾᏍᎩ ᎲᏗᏍᎬ ᎾᏍᎩ ᎧᏁᎩ ᏗᏟᏃᎵᏗ, ᎾᏍᎩ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᎴᏃ ᎾᏍᎩ ᏗᏟᏳᏦᎾᏗᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Continue call">
                <langSet xml:lang="en-US"><tig><term>Continue call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒᎢ ᏫᎬᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip open and close actions">
                <langSet xml:lang="en-US"><tig><term>Flip open and close actions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎠᎴ ᎯᏍᏚᎲᎦ ᏗᎵᏖᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Actions on flip open and close">
                <langSet xml:lang="en-US"><tig><term>Actions on flip open and close</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᏖᎸᏗ ᎤᎾᎢ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎠᎴ ᎯᏍᎤᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="An RTT call can be placed like a voice call once the RTT setting is set to &quot;Always Visible&quot;.">
                <langSet xml:lang="en-US"><tig><term>An RTT call can be placed like a voice call once the RTT setting is set to "Always Visible".</term></tig></langSet>
