            <termEntry id="SIM card, slot: ">
                <langSet xml:lang="en-US"><tig><term>SIM card, slot: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM cᎠrd, ᏍᎶt: </term></tig></langSet>
            </termEntry>
            <termEntry id="To turn on video calling, you need to enable Enhanced 4G LTE Mode in network settings.">
                <langSet xml:lang="en-US"><tig><term>To turn on video calling, you need to enable Enhanced 4G LTE Mode in network settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎣ tᎤrn Ꭳn ᎥᎢᏕᎣ cᎠlᎵng, ᏲᎤ ᏁᎡd tᎣ ᎡᎾbᎴ ᎡnᎭncᎡd 4 G LᏖ ᎼᏕ Ꭲn ᏁtᏬrk ᏎtᏘngᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There was an error while decoding the message.">
                <langSet xml:lang="en-US"><tig><term>There was an error while decoding the message.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮrᎡ ᏩᏍ Ꭰn ᎡrrᎣr wᎯᎴ ᏕcᎣᏗng tᎮ ᎺᏍᏌᎨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your selfie camera is hidden behind the display and pops up when you’re ready to take a photo.">
                <langSet xml:lang="en-US"><tig><term>Your selfie camera is hidden behind the display and pops up when you’re ready to take a photo.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr ᏎlfᎢᎡ cᎠᎺrᎠ ᎢᏍ ᎯdᏕn bᎡᎯnd tᎮ ᎠᏓᏴᎳᏔᏍᎩ Ꭰnd pᎣpᏍ Ꭴp wᎮn ᏲᎤ’rᎡ rᎡᎠdy tᎣ ᏔkᎡ Ꭰ pᎰtᎣ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The selfie camera makes a sound when it opens and closes, but you can turn this off anytime.">
                <langSet xml:lang="en-US"><tig><term>The selfie camera makes a sound when it opens and closes, but you can turn this off anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮ ᏎlfᎢᎡ cᎠᎺrᎠ ᎹkᎡᏍ Ꭰ ᏐᎤnd wᎮn Ꭲt ᎣpᎡnᏍ Ꭰnd cᎶᏎᏍ, bᎤt ᏲᎤ cᎠn tᎤrn tᎯᏍ Ꭳff ᎠnyᏘᎺ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now it's easier than ever to take selfies with one hand.">
                <langSet xml:lang="en-US"><tig><term>Now it's easier than ever to take selfies with one hand.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮓw Ꭲt'Ꮝ ᎡᎠᏏᎡr tᎭn ᎡᎥᎡr tᎣ ᏔkᎡ ᏎlfᎢᎡᏍ Ꮻth ᎣᏁ Ꭽnd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can get high quality document scans from your phone.">
                <langSet xml:lang="en-US"><tig><term>Now you can get high quality document scans from your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎡᎵᏊ ᏱᎩ ᎤᏟ ᎢᏲᏍᏓ ᏃᏌᏅᏱ ᎪᏪᎳᏅᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏓᎶᏍᏗᏍᎩ ᎾᏍᎩᎾ ᏂᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A SIM card has activated your service and updated your phone's roaming capabilities.">
                <langSet xml:lang="en-US"><tig><term>A SIM card has activated your service and updated your phone's roaming capabilities.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ SIM ccᎠrd ᎭᏍ ᎠcᏘᎥᎠᏖd ᏲᎤr ᏎrᎥᎢcᎡ Ꭰnd ᎤpᏓᏖd ᏲᎤr ᏕᎥᎢcᎡ'Ꮝ rᎣᎠᎻng cᎠpᎠbᎢᎵᏘᎡᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="There are too many active calls.">
                <langSet xml:lang="en-US"><tig><term>There are too many active calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮrᎡ ᎠrᎡ tᎣᎣ Ꮉny ᎠcᏘᎥᎡ cᎠllᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please end or merge existing calls before placing a new one.">
                <langSet xml:lang="en-US"><tig><term>Please end or merge existing calls before placing a new one.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PᎴᎠᏎ Ꭱnd Ꭳr ᎺrᎨ ᎡxᎢᏍᏘng cᎠllᏍ bᎡfᎣrᎡ pᎳcᎢng Ꭰ Ꮑw ᎣᏁ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to connect, please insert a valid SIM card.">
                <langSet xml:lang="en-US"><tig><term>Unable to connect, please insert a valid SIM card.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾbᎴ tᎣ cᎣnᏁct, pᎴᎠᏎ ᎢnᏎrt Ꭰ ᎥᎠᎵd SIM cᎠrd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call ended.">
                <langSet xml:lang="en-US"><tig><term>Call ended.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Call ended. ᏪᏴᎾ ᎠᎵᏍᏆᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your video call cannot be placed due to low battery.">
                <langSet xml:lang="en-US"><tig><term>Your video call cannot be placed due to low battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr ᎥᎢᏕᎣ cᎠll cᎠnᏃt bᎡ pᎳcᎡd ᏚᎡ tᎣ Ꮆw bᎠtᏖry.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video call ended due to low battery.">
                <langSet xml:lang="en-US"><tig><term>Video call ended due to low battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎢᏕᎣ cᎠll ᎡnᏕd ᏚᎡ tᎣ Ꮆw bᎠtᏖry.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi connection lost.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi connection lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮻ-FᎢ cᎣnᏁcᏘᎣn ᎶᏍt.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data roaming is turned off">
                <langSet xml:lang="en-US"><tig><term>Data roaming is turned off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌ ᏅᎯ ᎡᎪᎵᎪᎲ ᎠᏍᏚᏅᎢ Ꭳff</term></tig></langSet>
            </termEntry>
            <termEntry id="Data roaming is turned on">
                <langSet xml:lang="en-US"><tig><term>Data roaming is turned on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌ ᏅᎯ ᎡᎪᎵᎪᎲ ᎠᏍᏚᏅᎢ Ꭳn</term></tig></langSet>
            </termEntry>
            <termEntry id="Currently roaming, data plan is active">
                <langSet xml:lang="en-US"><tig><term>Currently roaming, data plan is active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎤrrᎡntly rᎣᎠᎻng, ᏁᎡd ᏓᏔ pᎳn</term></tig></langSet>
            </termEntry>
            <termEntry id="No roaming plan">
                <langSet xml:lang="en-US"><tig><term>No roaming plan</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮓ ᎡᎪᎵᎪᎲ pᎳn</term></tig></langSet>
