                <langSet xml:lang="chr"><tig><term>ᏭᎪᏛᎢ ᎤᎧᏛ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏓᏁᎸᏗᏍᎬᎢ ᎤᎶᏒᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To unlock, press Menu then 0.">
