            </termEntry>
            <termEntry id="Camera and Microphone are used in video call">
                <langSet xml:lang="en-US"><tig><term>Camera and Microphone are used in video call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏃᎴ ᎦᏬᏂᎯᏍᏙᏗ ᎾᏍᎩ ᎬᏔᏅᎯ ᎾᎿᎢᎠᏓᏴᎳᏛᏍᎩ ᏫᎬᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t allow \u0026 don\u2019t ask again">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t allow \u0026 don\u2019t ask again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏤᏍᏗ ᏏᏊ ᏥᎭᏛᏛᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow  to access sensor data about your vital signs?">
                <langSet xml:lang="en-US"><tig><term>Allow  to access sensor data about your vital signs?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ  ᎾᎢ ᎠᏴᏍᏗ ᎠᏩᏘᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏭᎵᏍᎨᏗᏴ ᎠᏕᎳᎰᎯᏍᏙᏗ?</term></tig></langSet>
