            </termEntry>
            <termEntry id="You won\u2019t be able to prevent others from using this tablet if it\u2019s lost or stolen.">
                <langSet xml:lang="en-US"><tig><term>You won\u2019t be able to prevent others from using this tablet if it\u2019s lost or stolen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏂᎨᏒᎾ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᏲᏍᏙᏗᏍᎩ ᏐᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎯᎠ ᏗᎪᏪᎶᏗᎢ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᎠᎴ ᎦᏃᏍᎩᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Always show time and info">
                <langSet xml:lang="en-US"><tig><term>Always show time and info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᎠᎪᏩᏛᏙᏗ ᎠᏥᎢᎵᏒ ᏃᎴ ᎧᏃᎮᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera Laser Sensor">
                <langSet xml:lang="en-US"><tig><term>Camera Laser Sensor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎩᎦᎨ ᎤᏗᏞᎩ ᎠᏨᏍᏗ ᎠᏩᏘᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unpin firstly.">
