            <termEntry id="System sound audio source">
                <langSet xml:lang="en-US"><tig><term>System sound audio source</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎤᏃᏴᎬᎢ ᎠᏛᎪᏗ ᎤᏃᏴᎬ ᏧᏓᎴᏅᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime can display content around the camera cutout for a full screen experience.">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime can display content around the camera cutout for a full screen experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎼᏙ ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏰᎵᏊ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎦᎸᏛᎢ ᎬᏩᏕᏱᏛ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎦᏖᏅᏕᏓ ᎾᏍᎩ ᎧᎵᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎦᏙᎲᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To connect these apps, install  in your work profile">
