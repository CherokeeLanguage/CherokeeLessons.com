            </termEntry>
            <termEntry id="Tap and hold on the fingerprint button to unlock your phone">
                <langSet xml:lang="en-US"><tig><term>Tap and hold on the fingerprint button to unlock your phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᎴ ᏣᏂᏴᏎᏍᏗ ᎾᏍᎩ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎠᏐᏅᏍᏙᏗ ᎾᎢ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show fingerprint sensor?">
                <langSet xml:lang="en-US"><tig><term>Show fingerprint sensor?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Text (RTT) allows you to have a text conversation during a call.">
                <langSet xml:lang="en-US"><tig><term>Real Time Text (RTT) allows you to have a text conversation during a call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒ ᎪᏪᎳᏅᎢ (RTT) ᏓᎵᏍᎪᎸᏓᏁᎲ ᏂᎯ ᎾᎿᎢ ᎤᎭ Ꭰ ᎪᏪᎳᏅᎢ ᎠᎾᏟᏃᎮᏍᎬᎢ ᎾᎯᏳ Ꭰ ᏪᏴᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone is getting too hot, so its taking steps to cool itself down.">
                <langSet xml:lang="en-US"><tig><term>Your phone is getting too hot, so its taking steps to cool itself down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏝᏃᎮᏗ ᎤᏗᏟᎩ ᏂᎦᎵᏍᏗᎭ, ᎤᏩᏌ ᎤᏁᏒᏴᏟ ᎾᏓᏛᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again.">
                <langSet xml:lang="en-US"><tig><term>Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Autofill developer options have been reset">
                <langSet xml:lang="en-US"><tig><term>Autofill developer options have been reset</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎤᏩᏌ ᎠᎧᎵᏍᎩ ᎪᏢᏍᎩ ᏗᏑᏰᏍᏗ ᎤᎭ ᏄᎵᏍᏔᏅ ᎢᎦᎧᎯᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" You can still use your phone,but you may notice: The screen might dim.">
                <langSet xml:lang="en-US"><tig><term> You can still use your phone,but you may notice: The screen might dim.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> Ꮟ ᏴᏓ ᏗᏝᏃᎮᏗ, ᎠᏎᏃ ᏔᏕᎶᎰᏍᏌ   Ꮎ ᎠᏓᏰᎸᏛᏍᎦ ᏯᏍᎪᎸᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id=" The Phone might slow down.">
                <langSet xml:lang="en-US"><tig><term> The Phone might slow down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏗᏞᏃᎮᏗ ᎭᎵᏭ ᏯᏍᎧᏃᎸᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="This shortcut may slow down your device">
                <langSet xml:lang="en-US"><tig><term>This shortcut may slow down your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎯᏍ ᏍᎰrtcᎤt Ꮉy ᏍᎶw Ꮩwn ᏲᎤr ᏕᎥᎢcᎡ</term></tig></langSet>
            </termEntry>
            <termEntry id="Drag the icon to the fingerprint to open the app">
                <langSet xml:lang="en-US"><tig><term>Drag the icon to the fingerprint to open the app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏏᏅᏍᏗ ᎾᏍᎩ ᎠᎢᎧᏂ ᎾᏍᎩ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎾᎢ ᎠᏍᏚᎢᏍᏓ ᎾᏍᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="•">
                <langSet xml:lang="en-US"><tig><term>•</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>•</term></tig></langSet>
            </termEntry>
            <termEntry id="Status bar location indicator">
                <langSet xml:lang="en-US"><tig><term>Status bar location indicator</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᎤᏙᏢᏒᎢ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Trace debuggable applications">
                <langSet xml:lang="en-US"><tig><term>Trace debuggable applications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏓᏩᏛᏍᏗ ᎯᏩᏔ ᎤᏍᏗᎦᎵᏓᏍᏛ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" Charging might pause.">
                <langSet xml:lang="en-US"><tig><term> Charging might pause.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎬᏂᏗᏍᏗᏍᎬᎢ ᎭᎵᏭ ᏯᏲᎯᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show RTT keyboard">
                <langSet xml:lang="en-US"><tig><term>Show RTT keyboard</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ RTT ᏗᏐᏅᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Peek Display settings">
                <langSet xml:lang="en-US"><tig><term>Peek Display settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set up a security method for authentication">
                <langSet xml:lang="en-US"><tig><term>Set up a security method for authentication</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎪᏗ ᎤᎦᏎᏍᏗᏕᎩ ᎢᎬᏁᏗ ᎾᏍᎩᎾ ᎠᏓᏙᏟᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Then select magnification.">
                <langSet xml:lang="en-US"><tig><term>Then select magnification.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮn ᏎᎴct ᎹgᏂfᎢcᎠᏘᎣn.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can wake up Peek Display by tapping on the screen">
                <langSet xml:lang="en-US"><tig><term>You can wake up Peek Display by tapping on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏰᏍᏗ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎬᏗ ᎭᏐᎥᏍᏗᏍᎬᎢ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id=" Your phone will return to normal once it cools down">
                <langSet xml:lang="en-US"><tig><term> Your phone will return to normal once it cools down</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏗᏝᏃᎮᏗ ᎣᏍᏓ ᏱᏅᎦᎵᏍᏓ ᎤᏁᏒᏴᏞᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shortcut settings">
                <langSet xml:lang="en-US"><tig><term>Shortcut settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ ᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're connected to a display.">
                <langSet xml:lang="en-US"><tig><term>You're connected to a display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>You're ᎱᏓᎸᎥᎦ to a ᎠᏓᏴᎳᏔᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" apps blocked">
                <langSet xml:lang="en-US"><tig><term> apps blocked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏗᎬᏙᏗ ᎠᏍᏚᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Using the accessibility button.">
                <langSet xml:lang="en-US"><tig><term>Using the accessibility button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒᎢ ᎠᏐᏅᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can not select certificate automatically. Please select a certificate from the list, and then try to connect.">
                <langSet xml:lang="en-US"><tig><term>Can not select certificate automatically. Please select a certificate from the list, and then try to connect.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏰᎵᎢ ᎬᏑᏰᏍᏗ ᏱᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ. ᎰᏩᏊ ᎠᏰᏍᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᏕᎦᏅᏛᎢ, ᏃᎴ ᎿᏉᏃ ᎭᏁᎵᏓ ᏧᏓᎸᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn off Peek Display, the fingerprint sensor can still appear when the screen is off">
                <langSet xml:lang="en-US"><tig><term>When you turn off Peek Display, the fingerprint sensor can still appear when the screen is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎯᏍᏚᏅᎢ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᎾᏍᎩ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᏰᎵᏊ ᏏᏊ ᎤᎾᏄᎪᎢᏍᏗ ᎾᎯᏳ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎠᏍᏚᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap &quot;Customize&quot; for more options.">
                <langSet xml:lang="en-US"><tig><term>Tap "Customize" for more options.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ "ᎠᏤᎲᏍᏙᏗ" ᎾᏍᎩᎾ ᎤᏟ ᎢᎦᎢ ᏗᏑᏰᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap &quot;Done&quot; to finish.">
                <langSet xml:lang="en-US"><tig><term>Tap "Done" to finish.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ "ᎠᎵᏍᏆᏓ" ᎾᎢ ᎠᏍᏆᏗᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Take your gaming to the next level with easy access to tools &amp; settings!">
                <langSet xml:lang="en-US"><tig><term>Take your gaming to the next level with easy access to tools &amp; settings!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎩ ᏂᎯ ᏣᏤᎵ ᏕᎭᏁᎸᏗᏍᎬᎢ ᎥᎿᎾ ᏐᎢ ᎢᏗᎦᏛ ᎬᏗ ᎠᎯᏗᎨ ᏅᏛᏴᏍᏙᏗ ᎥᎿ ᏗᎬᏔᏂᏓᏍᏗ ᎠᎴ ᏕᎦᎧᎲᎢ!</term></tig></langSet>
