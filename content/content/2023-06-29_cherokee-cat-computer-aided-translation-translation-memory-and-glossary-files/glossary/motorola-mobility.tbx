            </termEntry>
            <termEntry id="This will reset all network settings, including:Wi\u2011FiMobile dataBluetooth">
                <langSet xml:lang="en-US"><tig><term>This will reset all network settings, including:Wi\u2011FiMobile dataBluetooth</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏱᏙᎯᎧᎲᎦ ᏂᎦᏓ ᏧᎾᏚᏓᎵ ᎾᏕᎦᎧᎲᎢ, ᎾᏍᏊ Wi\u2011FiᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯBluetooth</term></tig></langSet>
            </termEntry>
            <termEntry id="Multi-volume lets you control the individual volumes of multiple apps.">
                <langSet xml:lang="en-US"><tig><term>Multi-volume lets you control the individual volumes of multiple apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏍᎩ-ᎢᎦᎢ ᎤᏃᏴᎬᎢ ᏗᏣᎵᏍᎪᎸᏓᏁᎯ ᎠᎯᎸᏍᏗ ᎾᏍᎩ ᎤᏩᏌᏊ ᎢᎦᎢ ᏚᏃᏴᎬᎢ ᎥᎿᎢ ᎢᎸᏍᎩ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Recorder to capture crisp &amp; clear audio notes anytime.">
                <langSet xml:lang="en-US"><tig><term>Use Recorder to capture crisp &amp; clear audio notes anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏙᏗ ᎬᏙᏓ ᎾᎢ ᎦᏂᏴᏗᎤᎸᏌᏗ ᎢᏳᏍᏗ &amp; ᎠᏍᎪᎸᏛᎢ ᏧᏍᏗ ᏕᎪᏪᎸ ᏱᏂᎦᎵᏍᏗᏊ ᎢᏴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Register for benefits and services">
                <langSet xml:lang="en-US"><tig><term>Register for benefits and services</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏪᎶᏗ ᎤᎬᏩᎵ ᎤᎭᎵᏍᏕᎸᏙᏗ ᎠᎴ ᎢᏯᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It can also automatically mute apps that you always manually mute.">
                <langSet xml:lang="en-US"><tig><term>It can also automatically mute apps that you always manually mute.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎾᏍᏉ ᎤᏩᏌᏊ ᎡᎳᏪ ᏱᎬᏁᎯ ᏗᎬᏙᏗ ᎾᏍᎩᎾᎢ ᏂᎯ ᏂᎪᎯᎸᎢ ᎣᏩᏌ ᎠᏍᏕᎸᏗ ᎠᏂᎩᏍᏙᏗ ᎡᎳᏬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Control the individual volume for multiple apps at once">
                <langSet xml:lang="en-US"><tig><term>Control the individual volume for multiple apps at once</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᎸᏍᏗ ᎾᏍᎩ ᎤᏩᏌᏉ ᎢᎦᎢ ᎤᏃᏴᎬ ᎾᏍᎩᎾ ᎢᎸᏍᎩ ᏗᎬᏙᏗ ᎾᎿᎢ ᏌᏊ ᎢᏳᏩᎫᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It will not be shared with others who are not authorized.">
                <langSet xml:lang="en-US"><tig><term>It will not be shared with others who are not authorized.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎩᎶ ᏐᎢ ᎠᏯᏙᏢ ᎠᏓᏁᏤᎲᎢ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Adaptive volume">
                <langSet xml:lang="en-US"><tig><term>Adaptive volume</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᎢᎦᎢ ᎤᏃᏴᎬ ᎤᎶᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Existing profiles for the application 1 will be replaced.">
                <langSet xml:lang="en-US"><tig><term>Existing profiles for the application 1 will be replaced.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏄᏍᏛᎢ ᏗᏓᏟᎶᏍᏛᎾ ᎬᏙᏗ 1 ᎦᏁᏟᏴᏒᎢ ᎨᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="(summary)">
