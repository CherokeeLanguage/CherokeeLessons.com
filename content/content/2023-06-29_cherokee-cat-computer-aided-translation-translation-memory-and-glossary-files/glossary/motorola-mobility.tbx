            </termEntry>
            <termEntry id="Center the QR code below to connect to \u201c\u201d">
                <langSet xml:lang="en-US"><tig><term>Center the QR code below to connect to \u201c\u201d</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵ ᏅᎦ Ꮎ QR ᎠᏍᏓᏩᏛᏍᏙᏗ ᎡᎳᏗᏨ ᎫᏓᎸᏗ \u201c\u201d</term></tig></langSet>
