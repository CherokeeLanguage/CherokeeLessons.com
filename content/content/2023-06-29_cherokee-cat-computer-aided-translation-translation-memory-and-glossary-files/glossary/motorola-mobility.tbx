            <termEntry id="This unprocessed file type is used to professionally edit photos.">
                <langSet xml:lang="en-US"><tig><term>This unprocessed file type is used to professionally edit photos.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏱᎸᏒ ᏂᎦᏒᎾ ᎠᏍᏆᏂᎪᏙᏗ ᎢᏳᏍᏗ ᎾᏍᎩ ᎬᏔᏅᎯ ᎾᎢ ᏫᏓᎾᏤᏢ ᎨᏒᎢ ᎦᏂᏟᏴᏓ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to read and write Do Not Disturb configuration.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to read and write Do Not Disturb configuration.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᎪᎵᏰᏗ ᏃᎴ ᎪᏪᎶᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᏄᏍᏛ ᎪᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can’t use camera">
                <langSet xml:lang="en-US"><tig><term>Can’t use camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone won\u2019t show, vibrate or make sound for new or existing notifications. Keep in mind, critical notifications for phone activity and status will still appear.When you turn off Do Not Disturb, find missed notifications by swiping down from the top of your screen.">
                <langSet xml:lang="en-US"><tig><term>Your phone won\u2019t show, vibrate or make sound for new or existing notifications. Keep in mind, critical notifications for phone activity and status will still appear.When you turn off Do Not Disturb, find missed notifications by swiping down from the top of your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏝᏃ ᎬᏂᎨᏒ ᏱᎬᏁᎯ ᎯᏍᏆᏂᎪᏓ ᎾᏍᎩ ᏣᏓᏅᏛᎢ, ᎤᏓᏚᎯᏌᏘ ᏗᏓᏃᏣᎳᏁᎯ ᎾᏍᎩᎾ ᏗᏟᏃᎮᏗ ᎠᎵᏖᎸᎲᏍᎬᎢ ᏃᎴ ᏄᏍᏗᏓᏅᎢ ᎠᏎ ᏏᏊ ᎤᎾᏄᎪᎢᏍᏗ.ᎾᎯᏳ ᏂᎯ ᎯᏍᏚᏅ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ, ᎯᏩᏔ ᎦᏅᏛᎢ ᏗᏓᏃᏟᎳᏁᎯ ᎬᏗ ᎦᏅᎦᏗᏍᎬ ᎡᎳᏗᏟ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎦᏚᎢ ᎥᎿᎢ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For added security, set a pattern to unlock the phone">
                <langSet xml:lang="en-US"><tig><term>For added security, set a pattern to unlock the phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎧᏁᏉᏓ ᎤᎦᏎᏍᏗ, ᎦᎧᎲᎢ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏗᏟᏃᎮᏗ</term></tig></langSet>
