                <langSet xml:lang="chr"><tig><term>FHD </term></tig></langSet>
            </termEntry>
            <termEntry id="Please pair with this device or go to settings in the Ready For phone app and allow file sharing with unpaired devices.">
                <langSet xml:lang="en-US"><tig><term>Please pair with this device or go to settings in the Ready For phone app and allow file sharing with unpaired devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏔᎵᎪᏓ ᎬᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴᏃ ᎮᎾ ᎾᎢ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᎾᏍᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᏗᏟᏃᎮᏗ ᎬᏙᏗ ᎠᎴ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏯᏙᎯᏍᏗ ᎤᏠᏯᏍᏗ ᎠᎵᎪᏔᏅᎢ ᏂᎨᏒᎾ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Ready For Assistant needs bluetooth in order to scan for nearby devices">
                <langSet xml:lang="en-US"><tig><term>The Ready For Assistant needs bluetooth in order to scan for nearby devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ ᏱᏚᏚᎸᏗ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎾᏍᎩ ᎤᎬᏩᎵ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᎾᏍᎩᎾ ᎾᎥᏂᎨᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Here\’s where you can find a variety of modes for both photos and videos.">
                <langSet xml:lang="en-US"><tig><term>Here\’s where you can find a variety of modes for both photos and videos.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏉ\ ᎤᎾᎢ ᏂᎯ ᏰᎵᏊ ᎯᏩᏔ ᎾᏍᎩ ᏧᏓᎴᏅᏓ ᎥᎿᎢ ᏗᎬᏙᏗᎭ ᎾᏍᎩᎾ ᎢᏧᎳ ᏗᏓᏟᎶᏍᏔᏅ ᎠᎴ ᏗᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try capturing 360° photo or video by tapping on this shutter button">
                <langSet xml:lang="en-US"><tig><term>Try capturing 360° photo or video by tapping on this shutter button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᏣᏂᏴᏗᎢ 360° ᏗᏓᏟᎶᏍᏔᏅ ᎠᎴᏃ ᎠᏓᏴᎳᏛᏍᎩ ᎾᎢ ᎭᏐᎥᏍᏗᏍᎬᎢ ᎤᎾᎢ ᎯᎠ ᎠᎵᏍᏚᎲᏍᎩ ᎠᏐᎥᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cutout mode lets you insert new backgrounds into your photos">
                <langSet xml:lang="en-US"><tig><term>Cutout mode lets you insert new backgrounds into your photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏅᏕᏓ ᎬᏙᏗᎭ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᎪᏣᎸᏗ ᎢᏤ ᎣᎾᏗᏢ ᏂᏚᏍᏗᏓᏅ ᎭᏫᏂ ᏣᏤᎵ ᏗᏓᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="The pairing status is wrong.">
