            </termEntry>
            <termEntry id="{count, plural, =0 {Off} =1 {Off / 1 schedule can turn on automatically} other {Off / # schedules can turn on automatically} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, =0 {Off} =1 {Off / 1 schedule can turn on automatically} other {Off / # schedules can turn on automatically} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, =0 {ᎠᏍᏚᎭ} =1 {ᎠᏍᏚᎭ / 1 ᏓᏒᏍᏛ ᏰᎵᏊ ᎠᏍᏚᎢᏓ ᎤᏩᏌᏊ ᏱᎬᏁᎯ} other {ᎠᏍᏚᎭ / # ᏓᏒᏍᏛᎢ ᏰᎵᏊ ᎠᏍᏚᎢᏓ ᎤᏩᏌᏊ ᏱᎪᏁᎯ} }</term></tig></langSet>
