            </termEntry>
            <termEntry id="Put your finger on the fingerprint sensor.">
                <langSet xml:lang="en-US"><tig><term>Put your finger on the fingerprint sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎲᎦ ᏂᏨᏅᎢ ᎦᏰᏌᏛ ᎤᎾᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio effects doesn’t work with devices connected by an auxiliary cable.">
                <langSet xml:lang="en-US"><tig><term>Audio effects doesn’t work with devices connected by an auxiliary cable.</term></tig></langSet>
