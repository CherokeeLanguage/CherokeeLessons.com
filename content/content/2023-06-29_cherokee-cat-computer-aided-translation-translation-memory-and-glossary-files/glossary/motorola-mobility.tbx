            </termEntry>
            <termEntry id="Add to home">
                <langSet xml:lang="en-US"><tig><term>Add to home</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎾᎾᎢ ᏧᏪᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter schedule name">
                <langSet xml:lang="en-US"><tig><term>Enter schedule name</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏭᏴᏍᏗ ᏓᏒᏍᏛ ᏚᏙᎥᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Where reply is">
                <langSet xml:lang="en-US"><tig><term>Where reply is</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏢᏃ ᎦᏬᎯᎵᏴᏓ ᎾᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Trust or remove certificate">
                <langSet xml:lang="en-US"><tig><term>Trust or remove certificate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎪᎯᏳᎯ ᎠᎴ ᎢᎬᎾᏕᏍᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Rotate your phone and try it.">
                <langSet xml:lang="en-US"><tig><term>Rotate your phone and try it.</term></tig></langSet>
