                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏯ ᎤᎭ 2 SIMs ᎬᏂᎦᎵᏍᏗ ᎤᎿᎢ ᏌᏊᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Install Ready for Assistant on your Windows PC www.motorola.com/ready-for">
                <langSet xml:lang="en-US"><tig><term>Install Ready for Assistant on your Windows PC www.motorola.com/ready-for</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏘᏅᎦ Ready ᎤᎬᏩᏟ Assistant ᎤᎾᎿ ᏂᏨᎤᎢ Windows PC www.motorola.com/ready-for</term></tig></langSet>
            </termEntry>
