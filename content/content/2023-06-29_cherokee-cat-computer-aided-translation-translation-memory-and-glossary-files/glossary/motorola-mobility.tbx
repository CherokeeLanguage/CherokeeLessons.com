            </termEntry>
            <termEntry id="To use Moto Gametime, it needs permission to be displayed over other apps.">
                <langSet xml:lang="en-US"><tig><term>To use Moto Gametime, it needs permission to be displayed over other apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ ᎼᏙ ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ, ᎾᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎨᏒᎢ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᎦᏬᎯᎸᏓ ᏐᎢ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This permission allows an app to modify system settings.">
                <langSet xml:lang="en-US"><tig><term>This permission allows an app to modify system settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎤᏃᏒᎯᏐᏗ ᏄᏍᏗᏓᏅᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Stereo widening">
                <langSet xml:lang="en-US"><tig><term>Stereo widening</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏃᎩᏍᏙᏗ ᎠᏛᏃᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="An app wants to make your tablet visible to other Bluetooth devices for  seconds.">
                <langSet xml:lang="en-US"><tig><term>An app wants to make your tablet visible to other Bluetooth devices for  seconds.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎬᏙᏗ ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎪᏢᏗ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᎬᎪᏩᏛᏗ ᎾᎿᎢ ᏐᎢ Bluetooth ᏥᏂᎬᏅᏗᏓᎾ ᎤᎬᏩᏟ  ᏓᏓᎾᏩᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No data transfer">
                <langSet xml:lang="en-US"><tig><term>No data transfer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint setup only takes a minute or two.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint setup only takes a minute or two.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏘᎧᎲᎦ ᎤᏅᏒ ᎠᎩᏍᎪᎢ Ꭰ ᎢᏯᏔᏬᏍᏔᏅ ᎠᎴ ᏔᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set your display preferences">
                <langSet xml:lang="en-US"><tig><term>Set your display preferences</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎯᎧᎲᎦ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎤᏟ ᏕᎯᏰᎸᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="After deletion, you will need your PIN, pattern, or password to unlock your phone or for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>After deletion, you will need your PIN, pattern, or password to unlock your phone or for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎫᏗᏗᏒ ᏱᎬᏅᏕᏍᏗ, ᎤᏚᎸᏓ ᎨᏎᏍᏗ ᏣᏩᎵ PIN, ᎤᎾᎶᎢᏓ, ᎠᎴ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎤᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After deletion, you will need your fingerprint, PIN, pattern, or password to unlock your phone or for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>After deletion, you will need your fingerprint, PIN, pattern, or password to unlock your phone or for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎫᏗᏗᏒ ᏱᎬᏅᏕᏍᏗ, ᎤᏚᎸᏓ ᎨᏎᏍᏗ ᏣᏩᎵ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ, PIN, ᎤᎾᎶᎢᏓ, ᎠᎴ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎤᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Managed by ">
                <langSet xml:lang="en-US"><tig><term>Managed by </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏅᏏᏙᎯ ᎬᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="You can further protect this device by requiring your PIN before it starts up.">
                <langSet xml:lang="en-US"><tig><term>You can further protect this device by requiring your PIN before it starts up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎸᏙᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᏎᎾᏛᏁᎮᏍᏗ ᏣᏤᎵ PIN ᎤᏓᎷᎸ ᎾᏍᎩ ᏓᏂᎩᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows app to show or hide the fingerprint indicator">
                <langSet xml:lang="en-US"><tig><term>Allows app to show or hide the fingerprint indicator</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᏩᏛᏙᏗ ᎠᎴ ᎲᏍᎦᏢᎦ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Until the device starts up, it can\u2019t receive calls, messages, or notifications, including alarms.">
                <langSet xml:lang="en-US"><tig><term>Until the device starts up, it can\u2019t receive calls, messages, or notifications, including alarms.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎩᎳ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏂᎩᏍᏒᎢ, ᎾᏍᎩ ᏝᏰᎵ\u2019 ᎬᎩᏍᏗ ᏙᏓᏳᏅᏔᏅᎢ, ᏗᎧᏃᎮᏍᎩ, ᎠᎴᏃ ᏗᏓᏃᏣᎳᏁᎯ, ᎤᏠᏯᏍᏗ ᏗᏓᏕᏯᏙᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Require PIN to start your device?">
                <langSet xml:lang="en-US"><tig><term>Require PIN to start your device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ PIN ᎾᎢ ᏓᏂᎩᏍᏙᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe left or right from the center edge of the screen">
                <langSet xml:lang="en-US"><tig><term>Swipe left or right from the center edge of the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏗ ᎠᎦᏍᎦᏂ ᎠᎴᏃ ᎠᎦᏘᏏ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎠᏰᏟ ᎠᏍᏛᎢ ᎥᎿᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier data accounting may differ from device accounting">
                <langSet xml:lang="en-US"><tig><term>Carrier data accounting may differ from device accounting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏫᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ ᏰᎵᏉ ᏚᏓᎴᎿᎥ ᏅᏓᏳᏓᎴᏅᎯ ᏥᏂᎬᏅᏗᏓᎾ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Haptic feedback for tap, keyboard, and more">
                <langSet xml:lang="en-US"><tig><term>Haptic feedback for tap, keyboard, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏍᏙᏗ ᎦᏬᎯᎵᏴᏓ ᎾᏍᎩᎾ ᎭᏐᎥᏍᏓ, ᏗᏐᏅᏍᏙᏗ, ᏃᎴ ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows for Microscreen entering and exiting">
                <langSet xml:lang="en-US"><tig><term>Allows for Microscreen entering and exiting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᏍᎪᎸᏓᏁᎲ ᎤᎬᏩᏟ Microscreen ᎠᏴᎵᎯᎮᏍᏗ ᎠᎴ ᎦᏅᎪᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Speech clarity is enhanced for a better understanding of talks contents">
                <langSet xml:lang="en-US"><tig><term>Speech clarity is enhanced for a better understanding of talks contents</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎦᏬᏂᏍᎬ ᎬᏂᎨᏒ ᎤᏍᏗᏓᏅ  ᎤᎬᏩᏟ ᏓᏤᎸ ᎪᎵᏍᏗᏱ ᎥᎿᎢ ᎦᏬᏂᎯᏍᎬ  ᎢᏳᏍᏗ ᏗᎧᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No installed apps have requested notification access.">
                <langSet xml:lang="en-US"><tig><term>No installed apps have requested notification access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏅᏔᏅ ᏗᎬᏙᏗ ᎤᏍᏛ ᏗᏔᏲᏢᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
