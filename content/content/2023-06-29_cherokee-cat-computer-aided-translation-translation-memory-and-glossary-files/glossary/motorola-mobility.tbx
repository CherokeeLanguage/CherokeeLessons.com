            </termEntry>
            <termEntry id="Re-enter your password for privacy space">
                <langSet xml:lang="en-US"><tig><term>Re-enter your password for privacy space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎯ-ᏴᎯᎮᏍᏗ ᏣᏤᎵ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎾᏍᎩᎾ ᎤᏕᎵᏓ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Re-enter your password for main space">
                <langSet xml:lang="en-US"><tig><term>Re-enter your password for main space</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎯ-ᏴᎯᎮᏍᏗ ᏣᏤᎵ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎾᏍᎩᎾ ᏄᎬᏫᏳᏒ ᎤᏜᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your phone as a mobile desktop, file transfer and more.">
                <langSet xml:lang="en-US"><tig><term>Use your phone as a mobile desktop, file transfer and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎤᎿᎢ ᎾᏍᎩ ᎠᏓᏅᏏᏙᎯ ᎦᏍᎩᎶᎩ ᎦᏚ, ᎠᏍᏆᏂᎪᏙᏗ ᎠᎲᏍᏗ ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Only available for Windows OS.">
                <langSet xml:lang="en-US"><tig><term>Only available for Windows OS.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎠᏛᏅᎢᏍᏔᏅ ᎾᏍᎩᎾ Windows OS.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make your screen darker so it\u2019s more comfortable to read.This can be helpful when:\u00a0Your tablet\u2019s default minimum brightness is still too bright\u00a0You\u2019re using your tablet in dark situations, like at night or in a dark room before bed ">
                <langSet xml:lang="en-US"><tig><term>Make your screen darker so it\u2019s more comfortable to read.This can be helpful when:\u00a0Your tablet\u2019s default minimum brightness is still too bright\u00a0You\u2019re using your tablet in dark situations, like at night or in a dark room before bed </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏩᎬᏂᎨᏍᏛ ᎠᏰᏙᎳᏛᎢ ᎾᏍᎩ ᎤᏟ ᎢᎦᎢ ᏄᏦᏎᏛᎾ ᎾᎿᎢ ᎠᎪᎵᏰᏗ .TᎯᏍ cᎠn bᎡ ᎮlpfᎤl wᎮn\u00a0ᏰᎵᏊ ᎨᏒᎩ ᎠᎵᏍᏕᎵᏍᎩ:\u00a0ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ\u2019s ᎡᏍᎦᏊ ᎤᏍᎪᏍᏗᏴ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎾᏍᏊ ᎤᏍᎪᏍᏗ ᏙᎢ\u00a0ᏂᏨᏅᎢ ᎬᏗᏍᎬ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ ᎾᎿ ᎤᎵᏏᎩ ᏂᏚᏍᏗᏓᏅ, ᎤᏠᏱᏉ ᎤᎿᎢ ᎤᏒᏗᎵ ᎠᎴ ᎾᎿ Ꭰ ᎤᎵᏏᎩ ᎧᏅᏑᎸ ᎢᎬᏱ ᎠᏥᏍᏔ </term></tig></langSet>
            </termEntry>
            <termEntry id="After the main space screen lock method is modified, the privacy space screen lock method will be modified simultaneously.">
                <langSet xml:lang="en-US"><tig><term>After the main space screen lock method is modified, the privacy space screen lock method will be modified simultaneously.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᎾᏍᎩ ᎤᏜᏅᏛ ᎠᏴᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᎭ ᎢᎬᏁᏗ ᏄᏍᏛ ᎦᏁᏟᏴᏗ, ᎾᏍᎩ ᎤᏕᎵᏓ ᎤᏜᏅᏛ ᎠᏴᏙᎳᏛᎢ ᏍᏓᏯ ᎠᏍᏚᎭ ᎢᎬᏁᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎦᏁᏟᏴᏗ ᎡᏧᎳᎭᏊ ᏂᏚᎵᏍᏔᏅ ᎪᎱᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="At least 4 digits.">
