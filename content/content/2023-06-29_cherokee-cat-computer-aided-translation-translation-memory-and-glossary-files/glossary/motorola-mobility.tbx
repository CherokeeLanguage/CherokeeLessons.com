                <langSet xml:lang="chr"><tig><term>Ꮎ PIN ᎨᏍᏗ ᏰᎵ ᏱᏓᏙᏟᎩ ᏫᏛᏢᏃᎮᏓ Ꮎ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Attachments cannot exceed 20MB.">
                <langSet xml:lang="en-US"><tig><term>Attachments cannot exceed 20MB.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏠᏯᏍᏛᎢ ᎨᏍᏗ ᏰᎵ ᎤᎶᏒᏍᏛᎢ 20MB.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not set">
                <langSet xml:lang="en-US"><tig><term>Not set</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏱᎦᎧᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will occasionally use your recent fingerprint images to create improved fingerprint models.">
                <langSet xml:lang="en-US"><tig><term>Your phone will occasionally use your recent fingerprint images to create improved fingerprint models.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎢᏳᏓᎵᎭᏊ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎾᏞᎬ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏚᏓᏴᎳᏛ ᎾᎿᎢ ᎪᏒᏗ ᎪᏢᎯᏌᏅ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You'll continue to receive messages from this number but won't be notified anymore. This conversation will be archived.">
                <langSet xml:lang="en-US"><tig><term>You'll continue to receive messages from this number but won't be notified anymore. This conversation will be archived.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏊᏃ ᎠᎯᎸᏍᏗ ᎾᎿᎢ ᎦᏁᏍᏗ ᏗᎪᎵᏰᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᎠᏎᏍᏗ ᎠᏎᏃ ᏝᏰᎵ ᎨᏒᎩ ᎤᏓᏃᎯᏎᎸ ᎢᎸᎯᏳᎢ. ᎯᎠ ᏗᎦᏃᏣᎳᏅᎯ ᎵᏉ ᎨᏎᏍᏗ ᎠᏍᏆᏂᎪᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Always allow  to create widgets and access their data">
                <langSet xml:lang="en-US"><tig><term>Always allow  to create widgets and access their data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᎠᎵᏍᎪᎸᏗᏍᎬ  ᎾᎿᎢ ᎪᏒᏗ ᏫᏥᏘ ᏃᎴ ᎠᏴᏍᏗ ᎤᎾᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You will lose your space and data on this phone. You can\u2019t undo this action.">
                <langSet xml:lang="en-US"><tig><term>You will lose your space and data on this phone. You can\u2019t undo this action.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᏓᏣᏲᎱᏎᎵ ᏣᏤᎵ ᎤᏜᏅᏛ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎾᎢ ᎯᎠ ᏗᏟᏃᎮᏗ. ᏂᎯ ᏱᏂᎨᎲᏕᎩᎯᎠ ᎠᎵᏖᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There are profile updates for your phone. To proceed, please enter the PIN provided by your service provider">
                <langSet xml:lang="en-US"><tig><term>There are profile updates for your phone. To proceed, please enter the PIN provided by your service provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏓᏟᎶᏍᏔᏅᎢ ᏙᏢᎯᏌ ᏗᏝᏃᎮᏗᏂᎯ ᏣᏤᎵ ᎠᎯᎸᏍᏗ ᏱᏣᏚᎵ, ᏘᏐᏍᏗ SIM ᏗᎨᏨᏁᎸ Ꮎ ᏴᏛᏁ ᎠᏓᏁᎸᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Warning: Your device has received a configuration update request. Such requests can come from unknown sources, unless you are working with your network provider to make configuration changes you should reject this request. If you have questions, please call your network provider.">
                <langSet xml:lang="en-US"><tig><term>Warning: Your device has received a configuration update request. Such requests can come from unknown sources, unless you are working with your network provider to make configuration changes you should reject this request. If you have questions, please call your network provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ. ᏥᏂᏕᎬᏅᏗᏓᏂ ᎤᎩᏒ ᎤᎾᏙᏢᏒᎢ ᎪᏢᎯᏐᏗ ᎠᏔᏲᎯ. ᎠᏔᏲᏢ ᎯᏲᎵᎦ ᏂᎨᏒᎾ ᏱᏛᏛᎴᎲᎦ, ᎢᏳᏍᎩᏂ ᎢᏧᎳᎭ ᏧᏚᏓᎵ ᎠᏓᏁᎸᏍᎩ ᎤᎾᏙᏢᏒᎢ ᏱᎦᏁᏟᏯ ᎢᏳᏗᎾ ᎠᏓᏯᏍᏗ ᎯᎠ ᏂᏣᏪᏎᎲᎢ. ᎪᎱᏍᏗ ᎯᏯᏛᏛᎲᏍᏗ ᏱᏣᏚᎵ, ᏫᏴᏓᏏ ᎤᎾᏙᏢᏒᎢ ᎠᏓᏁᎸᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To proceed, please enter the PIN provided by your service provider">
                <langSet xml:lang="en-US"><tig><term>To proceed, please enter the PIN provided by your service provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᎸᏍᏗ ᏱᏣᏚᎵ, ᏘᏐᏍᏗ SIM ᏗᎨᏨᏁᎸ Ꮎ ᏴᏛᏁ ᎠᏓᏁᎸᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It was not possible to copy logs to SD card. Check the logs for more information.">
                <langSet xml:lang="en-US"><tig><term>It was not possible to copy logs to SD card. Check the logs for more information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎢᏳᎵᏍᏙᏗ ᏱᎨᏎᎢ ᎾᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏂᏚᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ ᎾᎾᎢ to SD ᎠᏆᏂᏲᏍᏗ. ᏣᎦᏛᎲᎩ ᎾᏍᎩ ᏂᏚᎵᏍᏔᏂᏙᎸ ᎧᏃᎮᏍᎩ ᎾᏍᎩᎾ ᎤᏥ ᎢᎦᎢ ᎧᏃᎸᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for Wi-Fi to resume background download and installation…">
                <langSet xml:lang="en-US"><tig><term>Waiting for Wi-Fi to resume background download and installation…</term></tig></langSet>
