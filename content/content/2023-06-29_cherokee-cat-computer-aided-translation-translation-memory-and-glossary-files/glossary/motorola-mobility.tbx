            <termEntry id="During a call, you'll be notified about incoming calls">
                <langSet xml:lang="en-US"><tig><term>During a call, you'll be notified about incoming calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏚᏳ ᎠᏯᏅᏗ, ᏱᎨᏣᏃᎯᏏ ᏄᏰᎸᏛ ᏕᎦᎷᎬ ᏗᏯᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the Google Assistant button or say &quot;Hey Google&quot; to start a conversation.">
                <langSet xml:lang="en-US"><tig><term>Tap on the Google Assistant button or say "Hey Google" to start a conversation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮤp Ꭳn tᎮ ᎪᎣgᎴ ᎠᏍᏏᏍᏔnt bᎤttᎣn Ꭳr Ꮜy "Ꭾy ᎪᎣgᎴ" tᎣ ᏍᏔrt Ꭰ cᎣᏅᎡrᏌᏘᎣn.</term></tig></langSet>
            </termEntry>
            <termEntry id="Features, functions, and supported languages may vary by country.">
                <langSet xml:lang="en-US"><tig><term>Features, functions, and supported languages may vary by country.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>FᎡᎠtᎤrᎡᏍ, fᎤncᏘᎣnᏍ, Ꭰnd ᏑppᎣrᏖd ᎳnᎫᎠᎨᏍ Ꮉy ᎥᎠry by cᎣᎤntry.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe for favorites">
                <langSet xml:lang="en-US"><tig><term>Swipe for favorites</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏫpᎡ fᎣr fᎠᎥᎣrᎢᏖᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you open an app on the internal display, you can either flip closed to end the app or keep it open on the external display.">
                <langSet xml:lang="en-US"><tig><term>When you open an app on the internal display, you can either flip closed to end the app or keep it open on the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>WᎮn ᏲᎤ ᎣpᎡn Ꭰn Ꭰpp Ꭳn tᎮ ᎢnᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ, ᏲᎤ cᎠn ᎡᎢtᎮr fᎵp cᎶᏎd tᎣ Ꭱnd tᎮ Ꭰpp Ꭳr kᎡᎡp Ꭲt ᎣpᎡn Ꭳn tᎮ ᎡxᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto Smile Capture automatically takes a picture when everyone in the frame is smiling.">
                <langSet xml:lang="en-US"><tig><term>Auto Smile Capture automatically takes a picture when everyone in the frame is smiling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎤtᎣ ᏍᎻᎴ CᎠptᎤrᎡ ᎠᎤtᎣᎹᏘcᎠlly ᏔkᎡᏍ Ꭰ pᎢctᎤrᎡ wᎮn ᎡᎥᎡrᏲᏁ Ꭲn tᎮ frᎠᎺ ᎢᏍ ᏍᎻᎵng.</term></tig></langSet>
            </termEntry>
            <termEntry id="CDMA Call Waiting under IMS Off">
                <langSet xml:lang="en-US"><tig><term>CDMA Call Waiting under IMS Off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CDMA ᎠᏯᏅᏗ ᎠᎩᏘᏗᏍᏗ ᎥᎿᎢ IMS ᎠᏍᏚᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call settings can only be changed by the admin user.">
                <langSet xml:lang="en-US"><tig><term>Call settings can only be changed by the admin user.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏅᏗ ᏕᎦᎧᎲᎢ ᎥᏍᎩ ᎾᏍᎩ ᎤᏩᏌ ᏗᎮᏂᏁᏟᏴᏍᏗ ᎾᎢᎾ ᎤᎦᏎᏍᏗᏕᎩ ᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Settings ()">
