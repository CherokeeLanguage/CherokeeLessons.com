            <termEntry id="Your camera hardware isn't working right now. Please contact customer support.Error code: 8X">
                <langSet xml:lang="en-US"><tig><term>Your camera hardware isn't working right now. Please contact customer support.Error code: 8X</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᏝᏰᏃ ᏚᏳᎪᏛ ᏱᏚᎸᏫᏍᏓᏁᎢ ᏃᏊ ᎨᏒᎢ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᎤᏩᏍᎩ ᏕᎦᎫᏍᏛᏁᎭ.ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 8 X</term></tig></langSet>
            </termEntry>
            <termEntry id="Photo and video locations will be saved">
                <langSet xml:lang="en-US"><tig><term>Photo and video locations will be saved</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᎠᏓᏴᎳᏛᏍᎩ ᏚᏙᏢᏒᎢ ᏰᎵᏉ ᎠᎵᏏᏅᏔᏅᎢ ᎨᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face Beauty can’t be used when Stabilization is on">
