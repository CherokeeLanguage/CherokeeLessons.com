            <termEntry id="Tap on Security to check security status and set your device PIN, fingerprints, Face unlock, and more.">
                <langSet xml:lang="en-US"><tig><term>Tap on Security to check security status and set your device PIN, fingerprints, Face unlock, and more.</term></tig></langSet>
