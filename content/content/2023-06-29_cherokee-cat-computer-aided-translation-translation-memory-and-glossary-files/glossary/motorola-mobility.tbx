            </termEntry>
            <termEntry id="About Ready For Wireless 4K Adapter">
                <langSet xml:lang="en-US"><tig><term>About Ready For Wireless 4K Adapter</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥᏂᎨᏍᏗ ᎠᏛᏅᎢᏍᏔᏅᎢ ᏳᏰᎸᎩ  ᏂᏓᏏᎳᏛ  4K ᏗᏙᎵᎩ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can connect your device to a display or compatible TV for big screen gaming, entertainment, video chats, or an engaging desktop experience.">
                <langSet xml:lang="en-US"><tig><term>Now you can connect your device to a display or compatible TV for big screen gaming, entertainment, video chats, or an engaging desktop experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏳᏓᎸᎠ ᏂᎯᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᏅ ᎥᎾᎢ ᎠᏓᏭᎳᏔᏍᎩ ᎠᎴ ᏗᏙᎵᎩ TV  ᎤᎬᏩᏟ ᎤᏔᎾ ᎠᏓᏴᎳᏛᏍᎩ ᏛᏁᎸᏗᏍᎬᎢ,  ᎤᎾᏛᏁᎸᏗ,  ᎠᏓᏴᎳᏛᏍᎩ ᏗᏂᏬᏂᏍᎩ, ᎠᎴ ᎠᏠᏯᏍᏗᏍᎬ ᏄᎬᏫᏳᏒ ᎠᎦᏙᎲᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Volume button">
                <langSet xml:lang="en-US"><tig><term>Volume button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬᎢ ᎦᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make the text on your screen smaller or larger">
                <langSet xml:lang="en-US"><tig><term>Make the text on your screen smaller or larger</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏃᏢᏍᎪ ᎪᏪᎳᏅᎢ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ ᎠᏲᎵᎨ ᎠᎴ ᎡᏉᎯᎨᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you swipe left right main Home screen">
                <langSet xml:lang="en-US"><tig><term>When you swipe left right main Home screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏱᎶᎯᏍᏗᏍᎩ ᎠᎦᏘᏌ ᎥᎿᎢ ᏄᎬᏫᏳᏒ ᏧᏪᏅᏒ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you swipe left from main Home screen">
                <langSet xml:lang="en-US"><tig><term>When you swipe left from main Home screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏱᎶᎯᏍᏗᏍᎩ ᎠᎦᏘᏌ ᎥᎿᎢ ᏄᎬᏫᏳᏒ ᏧᏪᏅᏒ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="If the overheating continues, the communication module will be shut down.">
                <langSet xml:lang="en-US"><tig><term>If the overheating continues, the communication module will be shut down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎾᏍᎩ ᎤᎶᏒᏍᏔᏅ ᎠᏖᏴᏍᎬ ᏓᎵᏱᎵᏎᏍᏗ, ᎾᏍᎩ  ᎠᏓᏛᎪᏙᏗ ᎠᏰᏟ ᎢᏳᏓᏛ ᏰᎵᏉ ᎨᏒ ᏚᎵᏍᏚᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" has high background battery usage">
                <langSet xml:lang="en-US"><tig><term> has high background battery usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᏚᏩᎿ ᎦᎸᎳᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
