                <langSet xml:lang="chr"><tig><term>ᎦᏁᏍᏗ ᎠᎪᎵᏰᏗ ᏗᎪᎵᏰᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏄᏍᏗᏓᏅ ᎠᎴ ᎡᏍᎦᏂ ᎠᏓᎪᎵᏰᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="If the problem continues, restart your device.">
