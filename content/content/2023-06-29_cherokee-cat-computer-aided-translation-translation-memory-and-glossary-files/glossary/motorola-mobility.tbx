                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎢᏯᏓᏛᏁᏗ Ꮭ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏳᏃ VoTLE ᎠᏍᏚᎢᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" VoLTE service unavailable.">
                <langSet xml:lang="en-US"><tig><term> VoLTE service unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> VoLTE ᎢᏯᏓᏛᏁᏗ ᏄᏛᏅᎢᏍᏛᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="VoLTE service needs to be applied from your operator before you turn on this menu, otherwise normal call functions may be affected">
                <langSet xml:lang="en-US"><tig><term>VoLTE service needs to be applied from your operator before you turn on this menu, otherwise normal call functions may be affected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>VoLTE ᎢᏯᏓᏛᏁᏗ ᎤᏚᎸᏗ ᏄᎾᏛᏅ ᎾᎿᎢ ᎨᏒᎩ ᎬᎾᏔᏅᎯ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎯᎵᏙᎯ ᎤᏓᎷᎸ ᏂᎯ ᎯᏍᏚᎢ ᎯᎠ ᎪᏪᎳᎾᎥᎢ, ᎢᏳᏃ ᏰᎵ ᏱᎬᏩᏍᏗᎭᏭ ᏪᏯᎾ ᏧᏂᎸᏫᏍᏓᏁᏗᏱ ᏰᎵᏉ ᎨᏎᏍᏗ ᎦᎸᏉᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="4G can provide better and faster Internet access">
                <langSet xml:lang="en-US"><tig><term>4G can provide better and faster Internet access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>4G ᏰᎵᏊ ᎠᏓᏁᎳᏁᏗ ᏓᏤᎳ ᎠᎴ ᎦᏣᏄᎳᎯᎨ ᎠᏏᎳᏕᏫᏒᎢ ᎬᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="LTE only">
                <langSet xml:lang="en-US"><tig><term>LTE only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>LTE ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="LTE Only">
                <langSet xml:lang="en-US"><tig><term>LTE Only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>LTE ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will lead to extra data usage of the SIM.">
                <langSet xml:lang="en-US"><tig><term>This will lead to extra data usage of the SIM.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎᎢ ᏩᎵᎶᎯᎭ ᎾᎿᎢ ᎧᏁᏉᏓ ᎦᏟᏌᏅᎯ ᎬᏙᏗᎢ ᎾᎿ SIM.]</term></tig></langSet>
            </termEntry>
            <termEntry id="When non-data SIM is in call, it will be used for data service.">
                <langSet xml:lang="en-US"><tig><term>When non-data SIM is in call, it will be used for data service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎥᏝ-ᎦᏟᏌᏅᎯ SIM ᎾᎿ ᏪᏯᎾ, ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᎾᏍᎩᎾ ᎦᏟᏌᏅᎯ ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To turn on video calling, you need to enable VoLTE calls in network settings.">
                <langSet xml:lang="en-US"><tig><term>To turn on video calling, you need to enable VoLTE calls in network settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎯᏍᏚᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ, ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎡᎵᏊ ᏱᎬᏛᏁᏗ VoLTE ᏓᏯᏂ ᎾᎿ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
