            </termEntry>
            <termEntry id="Turn off these network services?">
                <langSet xml:lang="en-US"><tig><term>Turn off these network services?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎯᎠᏃ ᏧᎾᏚᏓᎵ ᎢᏗᏛᏁᎵᏓᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen record can’t be started because of low storage.">
                <langSet xml:lang="en-US"><tig><term>Screen record can’t be started because of low storage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᏕᎦᏅᏅᏛᎢ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎠᏂᎩᏍᏙᏔᏅᎩ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎤᎿ ᎡᎳᏗ ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Once your face has been recognized, swipe up on the lock screen to start using your device">
                <langSet xml:lang="en-US"><tig><term>Once your face has been recognized, swipe up on the lock screen to start using your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊᏊ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᏂᎦᎵᏍᏓ ᎨᏦᏟᏍᏗ, ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎤᎿᎢ ᏥᎩ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎴᎾ ᎬᏗᎭ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off for a scheduled period">
                <langSet xml:lang="en-US"><tig><term>Turn off for a scheduled period</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎤᎬᏩᏟ Ꭰ ᏓᏒᏍᏓ ᏓᏓᎴᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 88.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 88.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 88</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 6.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 6.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 6</term></tig></langSet>
            </termEntry>
            <termEntry id="Instead of on screen buttons, use the fingerprint sensor to navigate.">
                <langSet xml:lang="en-US"><tig><term>Instead of on screen buttons, use the fingerprint sensor to navigate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏫᏳᏎᏍᏗ ᎾᎿ ᎤᎿᎢ ᎠᏰᏙᎳᏛᎢ ᏗᏐᎥᏍᏙᏗ, ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎾᎿᎢ ᎠᏂᎩᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Preventing overcharge">
                <langSet xml:lang="en-US"><tig><term>Preventing overcharge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏗ ᎦᎸᎳᏗᏢ ᏗᎬᏩᎶᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can exit this mode in 4 ways:">
                <langSet xml:lang="en-US"><tig><term>You can exit this mode in 4 ways:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎪᏢᏗ ᎾᎿ 4 ᏱᏗᎬᏁᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 70.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 70.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 70</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow  to have full control of your device?">
                <langSet xml:lang="en-US"><tig><term>Allow  to have full control of your device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ  ᎾᎿᎢ ᎤᎭ ᏧᎧᎵᏨᎯ ᏗᎫᎪᏔᏂᏓᏍᏗ ᎾᎿ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 127.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 127.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 127</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Moto Gametime, it needs permission to be displayed over other apps. Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>To use Moto Gametime, it needs permission to be displayed over other apps. Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ, ᎾᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎨᏒᎢ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᎦᏬᎯᎸᏓ ᏐᎢ ᏗᎬᏙᏗ. ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime is on">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᎾᏍᎩ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Take your gaming to the next level with Moto's tools &amp; settings">
                <langSet xml:lang="en-US"><tig><term>Take your gaming to the next level with Moto's tools &amp; settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏫᏓ ᏣᏤᎵ ᏕᎭᏁᎶᎲᏍᎬᎢ ᎾᎢ ᎾᏍᎩ ᏗᏐᎢ ᎬᏗ Moto ᏧᏤᎵ ᏗᎬᏔᏅᏓᏍᏗ &amp; ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Head to Moto Gametime settings to start enjoying a better way to game.">
                <langSet xml:lang="en-US"><tig><term>Head to Moto Gametime settings to start enjoying a better way to game.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏙᏓ ᎾᎾᎢ Moto ᏗᏁᎸᏙᏗ ᎠᏣᏱᎶᎦ ᏕᎦᎧᎲᎢ ᎾᎢ ᎠᎴᏅᏗᎢ ᎠᎵᎮᎵᏍᏓ ᎾᏍᎩ ᏓᏤᏢᎩ ᏯᏛᏁᏗ ᎾᎢ ᏗᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" High resolution">
                <langSet xml:lang="en-US"><tig><term> High resolution</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎦᎸᎳᏗ ᎠᏓᏴᎳᏛᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can use simple gestures to get around your device">
                <langSet xml:lang="en-US"><tig><term>Now you can use simple gestures to get around your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯᏰᎵᏯ ᏄᏦᏍᏛᎾ ᎤᏬᏯᏂᏍᎩ ᎾᎿᎢ ᎠᎩᏍᏗ ᎠᏕᏯᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 16.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 16.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 16</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to go home">
                <langSet xml:lang="en-US"><tig><term>Tap to go home</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏗᏤᏅᏒ ᏤᏅᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 41.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 41.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 41</term></tig></langSet>
            </termEntry>
            <termEntry id="0:00">
                <langSet xml:lang="en-US"><tig><term>0:00</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>0:00</term></tig></langSet>
            </termEntry>
            <termEntry id="Attentive Display disabled">
                <langSet xml:lang="en-US"><tig><term>Attentive Display disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏏᎾᎯᏍᏗ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Then, lift your finger.">
                <langSet xml:lang="en-US"><tig><term>Then, lift your finger.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏉᏃ, ᎠᏌᎳᏙᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To go to the next or previous track when the screen is off, press and hold the volume up or down key">
                <langSet xml:lang="en-US"><tig><term>To go to the next or previous track when the screen is off, press and hold the volume up or down key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎠᎴ ᏧᏩᎫᏔᏅ ᎪᎷᏅᏍᏗ ᎢᏳᏃ ᏥᎩ ᎠᏓᏎᎮᎸᎢ ᎨᎡᎢ ᎠᏍᏚᏗ, ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᎾᎯᏍᏓ ᏥᎩ ᏂᎦᎥ ᎤᏜᏅᏛᎢ ᎦᎸᎳᏗ ᎠᎴ ᎡᎳᏗᏜ ᎤᎵᏍᎨᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Launch the assistant">
                <langSet xml:lang="en-US"><tig><term>Launch the assistant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏂᎩᏍᏙᏗ ᏥᎩ ᎠᎾᏓᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use optimized charging">
                <langSet xml:lang="en-US"><tig><term>Use optimized charging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎣᏍᏓ ᎢᏳᎵᏍᏙᏗ ᏓᎬᏩᎶᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎠᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When Overcharge protection is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.">
                <langSet xml:lang="en-US"><tig><term>When Overcharge protection is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.</term></tig></langSet>
