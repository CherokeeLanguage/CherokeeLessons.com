                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎯᎸᏉᏗ ᎦᏯᎸᏗ ᏗᎦᏁᏟᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Authentication username">
                <langSet xml:lang="en-US"><tig><term>Authentication username</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏙᏟᏍᏙᏗ ᎬᏗᏍᎩ ᏚᏙᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="Optional settings">
                <langSet xml:lang="en-US"><tig><term>Optional settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏩᏌ ᎠᏑᏰᏍᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your admin can monitor and manage settings, corporate access, apps, data associated with your device, and your device's location information.">
                <langSet xml:lang="en-US"><tig><term>Your admin can monitor and manage settings, corporate access, apps, data associated with your device, and your device's location information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎤᎦᏎᏍᏗᏕᎩ ᏰᎵᏯ ᎠᏓᏴᎵᏛᏍᎩ ᏃᎴ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏕᎦᎧᎲᎢ, ᎤᎾᏙᏢᏒ ᎠᏴᏍᏗ, ᏗᎬᏙᏗ, ᎦᏘᏍᎩᏌᏅᎯ ᏚᎵᎪᏒᎢ ᎬᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ, ᏃᎴ ᏂᏨᎤᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᏙᏢᏒᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="More time.">
                <langSet xml:lang="en-US"><tig><term>More time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎪᏗᏊ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For all calls when data network is available">
                <langSet xml:lang="en-US"><tig><term>For all calls when data network is available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏂᎦᏓ ᏓᏯᏂ ᎢᏳᏃ ᎦᏟᏌᏅᎯ ᏧᎾᏚᏓᎵ ᎨᏒᎢ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Account registration stopped because there is no Wi-Fi connection.">
                <langSet xml:lang="en-US"><tig><term>Account registration stopped because there is no Wi-Fi connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᏓᎸᏗ ᎨᎪᏪᎳᏅᎯ ᎤᎴᏫᏍᏔᏅ ᏂᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎥᏝᏰᏃ Wi-Fi ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep the screen on while you’re looking at it">
                <langSet xml:lang="en-US"><tig><term>Keep the screen on while you’re looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏆᏂᎪᏓ ᎠᏴᏙᎳᏛᎢ ᎤᎾᎢ ᎢᏳᏃ ᎠᎦᏖᏃᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="camera off">
                <langSet xml:lang="en-US"><tig><term>camera off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Include battery, airplane mode, mobile data, hotspot, Wi-Fi, etc. Suggested to turn on.">
                <langSet xml:lang="en-US"><tig><term>Include battery, airplane mode, mobile data, hotspot, Wi-Fi, etc. Suggested to turn on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏙᏗ ᎠᎾᎦᎵᏍᎩ, ᏥᏳ ᏄᏍᏛᎢ, ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ, ᎤᏗᏞᎩ ᎤᏓᏓᏢ, Wi-Fi, ᏓᏓᏁᏟᏴᏍᎬ. ᎧᏁᎢᏍᏙᏔᏅ ᎾᎿᎢ ᎯᏍᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Contact photo">
                <langSet xml:lang="en-US"><tig><term>Contact photo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᏃᎮᏙᏗ ᏗᏓᏥᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some advanced settings are not available on external display.">
                <langSet xml:lang="en-US"><tig><term>Some advanced settings are not available on external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᎢᏴᏛ ᎠᏱᎸᏛ ᏕᎦᎧᎲᎢ ᎨᏒᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎾᎢ ᏙᏯᏗᏨ ᎠᏓᏴᎳᏔᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" is set up to stay connected all the time, but it can't connect right now. You won't have a connection until the VPN can reconnect.">
                <langSet xml:lang="en-US"><tig><term> is set up to stay connected all the time, but it can't connect right now. You won't have a connection until the VPN can reconnect.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏄᏍᏛ ᎦᎧᎲᏍᎬᎢ ᎾᎿᎢ ᎡᏙᎮᏍᏗ ᎫᏓᎸᏅᎯ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ, ᎠᏎᏃ ᎾᏍᎩ ᎨᏍᏗ ᏰᎵ ᎫᏓᎸᎢ ᎠᎦᏘᏏ Ꭷ. ᏂᎯ ᏂᎨᏒᎾ ᎤᎭ a ᎫᏓᎸᎢ ᎩᎳ ᏥᎩ VPN ᏰᎵᏊ ᏙᎫᏓᎸᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" is set up to stay connected all the time, but it can't connect right now. Your phone will use a public network until it can reconnect to .">
                <langSet xml:lang="en-US"><tig><term> is set up to stay connected all the time, but it can't connect right now. Your phone will use a public network until it can reconnect to .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏄᏍᏛ ᎦᎧᎲᏍᎬᎢ to ᎡᏙᎮᏍᏗ ᎫᏓᎸᏅᎯ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ, ᎠᏎᏃ ᎾᏍᎩ ᎨᏍᏗ ᏰᎵ ᎫᏓᎸᎢ ᎠᎦᏘᏏ Ꭷ. ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏓᎬᏓᏂ Ꭰ ᎠᏰᎵ ᎤᏤᎵ ᏧᎾᏚᏓᎵ ᎩᎳ ᎾᏍᎩ ᏰᎵ ᎫᏓᎸᎢ ᎾᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Render apps below cutout area">
                <langSet xml:lang="en-US"><tig><term>Render apps below cutout area</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎶᏍᏓ ᏗᎬᏙᏗ ᎡᎳᏗᏨ ᎯᎦᎳ ᎦᏅᎪᏫᏛ ᎢᎬᎾᏕᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock app is not installed">
                <langSet xml:lang="en-US"><tig><term>Unlock app is not installed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩ ᎬᏙᏗ ᎭᏗ ᏕᎦᏘᏅᏛᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="When roaming internationally, you won\’t be able to use apps or services that require an internet connection unless you use Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>When roaming internationally, you won\’t be able to use apps or services that require an internet connection unless you use Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏙᎵᏙᎲ ᎠᏰᎵ ᏚᎾᏙᏢᏒ, ᏂᎯ ᎨᏍᏗ ᏰᎵ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏗᎬᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎥᏍᎩᎾ ᎠᏎᏯᏛᏁᏗ Ꭰ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎢᏳᏍᎩᏂ ᏂᎯ ᎬᏔᏂᏓᏍᏗ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off international data roaming?">
                <langSet xml:lang="en-US"><tig><term>Turn off international data roaming?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="I agree to continue providing mobile network diagnostics data to my wireless service provider.">
                <langSet xml:lang="en-US"><tig><term>I agree to continue providing mobile network diagnostics data to my wireless service provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯ ᎣᏏ ᎠᏰᎸᏍᏗ ᎾᎿᎢ ᏂᎦᏯᎢᏒ ᎠᏓᏁᏢᏍᎬ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎪᎱᏍᏚᏍᏛ ᎠᏩᏘᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿᎢ ᎠᏯ ᏂᏓᏏᎳᏛ ᎠᏯᏙᎯᎯ ᎠᏓᏁᎸᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your wireless service provider would like your help in improving the quality and performance of its network and your wireless service experience. Your phone includes software that automatically collects diagnostic and usage data from your phone. If you agree, this software will continue providing mobile network diagnostics data to your wireless service provider. &lt;a href=&gt;Privacy Policy">
                <langSet xml:lang="en-US"><tig><term>Your wireless service provider would like your help in improving the quality and performance of its network and your wireless service experience. Your phone includes software that automatically collects diagnostic and usage data from your phone. If you agree, this software will continue providing mobile network diagnostics data to your wireless service provider. &lt;a href=&gt;Privacy Policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Your ᏂᏓᏏᎳᏛ ᎠᏯᏙᎯᎯ ᎠᏓᏁᏢᏍᎩwould like your help in improving the quality and performance of its network and your wireless service experience. ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏚᏠᏯᏍᏗ ᎦᎾᏗᏅᏗ ᎥᏍᎩᎾ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏗᎦᏟᏌᏅᎩ ᎪᎱᏍᏚᏍᏛ ᎠᏩᏘᏍᎩ ᏃᎴ ᎬᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ. ᎨᎡᎢ ᏂᎯ ᎣᏏ ᎠᏰᎸᏍᏗ, ᎯᎠ ᎦᎾᏗᏅᏗ ᎠᏎ ᎠᏰᎸᏍᏗ ᎠᏓᏁᏢᏍᎬ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎪᎱᏍᏚᏍᏛ ᎠᏩᏘᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿᎢ ᏂᏨᎤᎢ ᏂᏓᏏᎳᏛ ᎠᏯᏙᎯᎯ ᎠᏓᏁᎸᏍᎩ &lt;a href=&gt;ᎤᏕᎵᏓ ᏧᎾᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No data connection. To enable data, use options below">
                <langSet xml:lang="en-US"><tig><term>No data connection. To enable data, use options below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ. ᎾᎿᎢ ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎦᏘᏍᎩᏌᏅᎯ, ᎬᏔᏂᏓᏍᏗ ᎠᏑᏰᏍᏗᎢ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="No data connection">
                <langSet xml:lang="en-US"><tig><term>No data connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please retry after enabling data or call Customer care for further assistance.">
                <langSet xml:lang="en-US"><tig><term>Please retry after enabling data or call Customer care for further assistance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏁᎸᏓ ᎤᎶᏐᏅ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᎦᏘᏍᎩᏌᏅᎯ ᏃᎴ ᏪᏯᎾ ᎤᏩᏍᎩ ᎠᏓᎦᏎᏍᏙᏗ ᎤᎬᏩᏟ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically connect to Spectrum networks and optmize Wi-Fi network selections.">
                <langSet xml:lang="en-US"><tig><term>Automatically connect to Spectrum networks and optmize Wi-Fi network selections.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎫᏓᎸᎢ ᎾᎿᎢ Spectrum ᏚᎾᏚᏓᎵ ᏃᎴ ᏩᎧᎵᎢᏴ Wi-Fi ᏧᎾᏚᏓᎵ ᏗᏑᏰᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Reset Data Settings">
                <langSet xml:lang="en-US"><tig><term>Reset Data Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏙᎯᎧᎲᎦ ᎦᏘᏍᎩᏌᏅᎯ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you skip activation, be sure to activate later in Settings. Until you activate, your phone won't have a cellular data connection.">
                <langSet xml:lang="en-US"><tig><term>If you skip activation, be sure to activate later in Settings. Until you activate, your phone won't have a cellular data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏂᎯ ᎠᏓᎾᏫᏓ ᎠᎴᏅᏙᏗ, ᎨᎡᎢ ᎤᏙᎯᏳ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ ᎪᎯᏴᎢ ᎾᎿ ᏕᎦᎧᎲᎢ. ᎩᎳ ᏂᎯ ᎤᏂᎩᏍᏗᏍᎩ, ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᏍᏗ ᏰᎵ ᎤᎭ Ꭰ ᏫᏚᏍᏗᎬᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device has encountered an error when trying to connect to the network that requires a reset. Would you like to reset this device? This will remove your account from this device but will not remove your personal data.">
                <langSet xml:lang="en-US"><tig><term>Your device has encountered an error when trying to connect to the network that requires a reset. Would you like to reset this device? This will remove your account from this device but will not remove your personal data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ Ꭰ ᏓᏓᎴᎬᎢ ᎢᏳᏃ ᎠᏁᏟᏗᎭ ᎾᎿᎢ ᎫᏓᎸᎢ ᎾᎿᎢ ᏥᎩ ᏧᎾᏚᏓᎵ ᎥᏍᎩᎾ ᎠᏎᏳᎾᏛᏁᏗ Ꭰ ᏥᎯᎧᎲᎦ. ᏯᏓᎯᏗᏏ ᏂᎯ ᎯᎸᏉᏗ ᎾᎿᎢ ᏥᎯᎧᎲᎦ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ? ᎯᎠ ᎠᏎ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᎠᏚᏓᎸᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᏃ ᎠᏎ ᎥᏝ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device has encountered an error when trying to connect to the network that requires a reset. Would you like to reset the device? This will remove your account from this device but will not remove your personal data.">
                <langSet xml:lang="en-US"><tig><term>Your device has encountered an error when trying to connect to the network that requires a reset. Would you like to reset the device? This will remove your account from this device but will not remove your personal data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ Ꭰ ᏓᏓᎴᎬᎢ ᎢᏳᏃ ᎠᏁᏟᏗᎭ ᎾᎿᎢ ᎫᏓᎸᎢ ᎾᎿᎢ ᏥᎩ ᏧᎾᏚᏓᎵ ᎥᏍᎩᎾ ᎠᏎᏳᎾᏛᏁᏗ Ꭰ ᏥᎯᎧᎲᎦ. ᏯᏓᎯᏗᏏ ᏂᎯ ᎯᎸᏉᏗ ᎾᎿᎢ ᏥᎯᎧᎲᎦ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ? ᎯᎠ ᎠᏎ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᎠᏚᏓᎸᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᏃ ᎠᏎ ᎥᏝ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please contact your service provider to configure your device for service.">
                <langSet xml:lang="en-US"><tig><term>Please contact your service provider to configure your device for service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎾᎿᎢ ᎢᏳᎵᏍᏙᏗ ᎢᎬᏁᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎬᏩᏟ ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Calling services cannot be initiated from this country">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi Calling services cannot be initiated from this country</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎠᏓᏕᎳᏗᏍᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᎠᏰᎵ ᎤᏙᏢᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="VoLTE is not available at this time. Try again later.">
                <langSet xml:lang="en-US"><tig><term>VoLTE is not available at this time. Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>VoLTE ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎿᎢ ᎯᎠ ᎠᏥᎢᎵᏒ. ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi calling has detected that your device is connected to a Wi-Fi access point located outside of the USA. Calls to emergency services (to 9-1-1, 999, 112, etc., depending on the country) are not made over Wi-Fi network to which you are connected. As such, depending on your device's capabilities and current roaming settings, you may be unable to make emergency services calls using Wi-Fi calling. Contact emergency services by some other means.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi calling has detected that your device is connected to a Wi-Fi access point located outside of the USA. Calls to emergency services (to 9-1-1, 999, 112, etc., depending on the country) are not made over Wi-Fi network to which you are connected. As such, depending on your device's capabilities and current roaming settings, you may be unable to make emergency services calls using Wi-Fi calling. Contact emergency services by some other means.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᏂᏚᏩᎿ ᎪᎷᏩᏛᏓ ᎥᏍᎩᎾ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Ꭰ Wi-Fi ᎠᏴᏍᏗ ᏩᏎᎯᎯ ᎢᎬᎾᏕᏅ ᏙᏯᏗᏨ ᎾᎿ ᏥᎩ USA. ᏓᏯᏂ ᎾᎿᎢ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ (ᎾᎿᎢ 9-1-1, 999, 112, etc., ᎥᎵᏍᎦᏍᏙᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏰᎵ ᎤᏙᏢᏒ) ᎨᎡᎩ ᎥᏝ ᏄᎵᏍᏔᏅ ᎢᏴᏛ Wi-Fi ᏧᎾᏚᏓᎵ ᎾᎿᎢ ᎦᏙᎤᏍᏗ ᏂᎯ ᎨᎡᎩ ᎫᏓᎸᏅᎯ. ᎤᎿᎢ ᎾᏍᎩᏯ, ᎥᎵᏍᎦᏍᏙᏗᏍᎬ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵ ᎢᏯᏛᏁᎯ ᏃᎴ ᏃᏊ ᏥᎩ ᎡᏙᎵᏙᎲ ᏕᎦᎧᎲᎢ, ᏂᎯ ᏰᎵᏯ ᎨᎡᎢ ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎪᏒᏗ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏓᏯᏂ ᎬᏗᎭ Wi-Fi ᏓᏯᏂᏍᎬ. ᎠᏟᏃᎮᏙᏗ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎬᏗ ᎢᎦᏓ ᏐᎢ ᎤᏅᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="About">
                <langSet xml:lang="en-US"><tig><term>About</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="VoLTE provides superior quality when making and receiving voice calls. It also lets you use apps and the internet while on a call.The VoLTE icon is displayed in the notification bar when you are in a VoLTE coverage area.Data used by VoLTE does not count against your data plan limits.">
                <langSet xml:lang="en-US"><tig><term>VoLTE provides superior quality when making and receiving voice calls. It also lets you use apps and the internet while on a call.The VoLTE icon is displayed in the notification bar when you are in a VoLTE coverage area.Data used by VoLTE does not count against your data plan limits.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>VoLTE ᏓᎾᏓᏁᏢᏍᎬ ᏄᎬᏫᏳᏌᏕᎩ ᎢᏲᏍᏓ ᎢᏳᏃ ᎪᏢᏍᎦ ᏃᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ. ᎾᎿ ᏃᎴ ᎾᏍᏊ ᏩᏂᎩ ᏂᎯ ᎬᏔᏂᏓᏍᏗ ᏗᎬᏙᏗ ᏃᎴ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎾᎯᏳᎢ ᎤᎿᎢ Ꭰ ᏪᏯᎾ.ᏥᎩ VoLTE ᎠᎢᎧᏂ ᎨᎡᎢ ᎬᏂᎨᏒ ᏁᎬᏅᎢ ᎾᎿ ᏥᎩ ᎠᏓᏃᏣᎳᏁᎯ ᎦᎾᎸ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎾᎿ Ꭰ VoLTE ᏓᏁᏃᏣᏢᏍᎦ ᎢᎬᎾᏕᎾ.ᎦᏟᏌᏅᎯ ᎬᏔᏅᎢ ᎬᏗ VoLTE ᎥᏝ ᎠᏎᏍᏗ ᏗᎦᏘᎸᏛ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᏗᎫᎪᏔᏂᏙᎸᎯ ᏓᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We're having trouble with Wi-Fi Calling, and can't open it right now.Tap here to retry later.">
                <langSet xml:lang="en-US"><tig><term>We're having trouble with Wi-Fi Calling, and can't open it right now.Tap here to retry later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗ ᎤᎲᎢ ᎤᏪᎵᎯᏍᏗ ᎬᏗ Wi-Fi ᏓᏯᏂᏍᎬ, ᏃᎴ ᎨᏍᏗ ᏰᎵ ᎯᏍᏚᎢ it ᎠᎭᏂᏊ.ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎭᏂ ᎾᎿᎢ ᏥᎭᏁᎸᏓ ᎣᏂᏯᎨᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Must use first time">
                <langSet xml:lang="en-US"><tig><term>Must use first time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎬᏔᏂᏓᏍᏗ ᎢᎬᏱ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Collect diagnostics data for troubleshooting">
                <langSet xml:lang="en-US"><tig><term>Collect diagnostics data for troubleshooting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎩ ᎪᎱᏍᏓ ᏗᏩᏘᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎬᏩᏟ ᏓᏓᎴᏍᏗᏍᎬᎢ ᎤᎾᏓᏃᎯᏎᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Time">
                <langSet xml:lang="en-US"><tig><term>Time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mountain Time">
                <langSet xml:lang="en-US"><tig><term>Mountain Time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᎴᏛ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Time &amp; weather">
                <langSet xml:lang="en-US"><tig><term>Time &amp; weather</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ &amp; ᏙᏱᏗᏣ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
