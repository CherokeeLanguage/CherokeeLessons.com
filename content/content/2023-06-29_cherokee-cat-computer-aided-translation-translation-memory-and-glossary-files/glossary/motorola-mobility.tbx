                <langSet xml:lang="en-US"><tig><term>\u0020/ Default for </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>\u0020/ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart Forwarding Disabled">
                <langSet xml:lang="en-US"><tig><term>Smart Forwarding Disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᎠᎬᏱᏗᏜ ᎠᏂᎩᏍᏗᏍᎩ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ</term></tig></langSet>
