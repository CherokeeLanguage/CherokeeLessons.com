                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᎠᏎᎯᎯ ᎾᎢ ᎠᏍᎦᏂ ᎠᏍᏛᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="While you’re watching an app, you can find audio controls, notification settings, and more in the left sidebar.">
                <langSet xml:lang="en-US"><tig><term>While you’re watching an app, you can find audio controls, notification settings, and more in the left sidebar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏣᎦᏙᏍᏛ ᎾᏍᎩ ᎬᏙᏗ, ᏂᎯ ᏰᎵᏊ ᏱᏩᏔ ᎤᏃᏴᎬ ᏗᎯᎸᏍᏗ, ᏗᏓᏃᏣᎳᏁᎯ ᏕᎦᎧᎲᎢ, ᎠᎴ ᎤᏟ ᎢᎦᎢ ᎾᎢ ᎠᏍᎦᏂ ᎤᏟᏗᏢ ᎪᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Look directly at camera">
                <langSet xml:lang="en-US"><tig><term>Look directly at camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᎦᏔ ᏥᏳᎪᏗ ᎤᎿᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect PIN on the next attempt, your work profile and its data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect PIN on the next attempt, your work profile and its data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ PIN ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᏂᏨᎤᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Remaining data">
