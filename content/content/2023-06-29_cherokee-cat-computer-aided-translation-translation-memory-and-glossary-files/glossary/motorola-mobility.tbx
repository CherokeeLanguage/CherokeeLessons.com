            <termEntry id="Object and landmark recognition is now enabled through Google Lens">
                <langSet xml:lang="en-US"><tig><term>Object and landmark recognition is now enabled through Google Lens</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏐᏍᏔᏅᎯ ᎠᎴ ᎤᎵᏍᎨᏓ ᎠᏓᏁᏟᏴᏎᎬ ᏓᏓᏂᎸᏨᎢ ᏄᏍᏛ ᎾᏊ ᎡᎵᏊ ᏄᏛᏁᎸᎢ ᎤᎶᏒᎯ Google ᏗᏓᎨᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="a year">
                <langSet xml:lang="en-US"><tig><term>a year</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎾᏕᏘᏴᏌᏗᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you add games to this list, Moto Gametime will open automatically when you start playing">
                <langSet xml:lang="en-US"><tig><term>When you add games to this list, Moto Gametime will open automatically when you start playing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎯᏁᏉᏍᏔᏅ ᏧᎾᏁᎸᏙᏗ ᎯᎠ ᏕᎦᏅᏛᎢ, Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᎠᏎᎢ ᏛᎵᏍᏚᎢᏏ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎾᎯᏳ ᏂᎯ ᎭᎴᏅᎲᎢ ᏕᎭᏁᎸᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This is not a night scene.">
                <langSet xml:lang="en-US"><tig><term>This is not a night scene.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏄᏍᏛ ᎥᏝ ᎾᏍᎩ ᏒᏃᏱ ᎤᎾᏛᏁᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" has installed a certificate authority for your work profile, which may allow them to monitor work network activity, including emails, apps, and secure websites.For more information about this certificate, contact your admin.">
                <langSet xml:lang="en-US"><tig><term> has installed a certificate authority for your work profile, which may allow them to monitor work network activity, including emails, apps, and secure websites.For more information about this certificate, contact your admin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᏚᏩᎿ ᎯᏘᏅᏛ Ꭰ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏄᎬᏫᏳᏌᏕᎩ ᎾᏍᎩᎾ ᏂᏨᏅᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎠᎵᏍᎪᎸᏗᏍᎩ, ᏱᏅᎦᎵᏍᏙᏓ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᎬᏅ ᎾᎿᎢ ᎠᏓᏴᎵᏛᏍᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᎾᏚᏓᎵ ᏄᏛᏁᎸᏅ, ᎠᏠᏯᏍᏗᏍᎩ ᏗᎾᎦᎵᏍᎩ ᏗᎪᏪᎵ, ᏗᎬᏙᏗ, ᎠᎴ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎤᏂᎳᏛᎢ ᏚᏙᏢᏒᎢ.ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎤᎦᏎᏍᏗᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="A normal capture will be taken.">
                <langSet xml:lang="en-US"><tig><term>A normal capture will be taken.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏱᎬᏩᏍᏗᏭ ᎦᏂᏴᏗ ᏰᎵᏉ ᎠᎩᏟ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="HD ">
                <langSet xml:lang="en-US"><tig><term>HD </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>HD </term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to capture">
                <langSet xml:lang="en-US"><tig><term>Tap to capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏗ ᎾᎢ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Malicious apps may cost you money by sending emails without your confirmation.">
                <langSet xml:lang="en-US"><tig><term>Malicious apps may cost you money by sending emails without your confirmation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᎫᏣᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᏧᎵᎬᏩᎳᏅᎯ ᏂᎯ ᎠᏓᎴᏍᎩᏱᏍᎩ ᎬᏗ ᏫᎦᏅᎥᏍᎬᎢ ᏗᎾᎦᎵᏍᎩ ᏗᎪᏪᎵ ᎾᏠᏯᏍᏗᏍᎬᎾ ᏂᏨᎤᎢ ᎦᎫᏍᏛᏗᏱ.</term></tig></langSet>
