            </termEntry>
            <termEntry id="You’ll need to be on 5G, 4G LTE or a Wi-Fi connection">
                <langSet xml:lang="en-US"><tig><term>You’ll need to be on 5G, 4G LTE or a Wi-Fi connection</term></tig></langSet>
