                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ, ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᎠᏱᎴᎩ ᎠᏎ ᎨᎡᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Advanced Messaging to send large files.">
                <langSet xml:lang="en-US"><tig><term>Turn on Advanced Messaging to send large files.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎢᏴᏛ ᎠᏱᎸᏛ ᏓᎾᏓᏪᎳᏁᎲᎢ ᎾᎿᎢ ᏫᏅᎥᎦ ᎡᏉᎯᏳ ᏗᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Max file size is .">
                <langSet xml:lang="en-US"><tig><term>Max file size is .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨ ᎬᏔᏅᏂᎨᏒᎾ ᎢᎩᏓ ᎨᏒ ᎨᎡᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="See your wallpaper come to life as it responds to your actions">
                <langSet xml:lang="en-US"><tig><term>See your wallpaper come to life as it responds to your actions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ ᏂᏨᎤᎢ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᏕᎮᎾ ᎾᎿᎢ ᎠᎴᏂᏙᎲᎢ ᎤᎿᎢ ᎾᎿ ᎦᏬᎯᎵᏴᏍᏗ ᎾᎿᎢ ᏂᏨᎤᎢ ᎾᎾᏛᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change the resize options in Settings &gt; Advanced Messaging">
                <langSet xml:lang="en-US"><tig><term>You can change the resize options in Settings &gt; Advanced Messaging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎯᏁᏟᏴᎾ ᏥᎩ ᏂᎬ ᎯᏁᏟᏴᎾ ᎠᏑᏰᏍᏗᎢ ᎾᎿ ᏕᎦᎧᎲᎢ &gt; ᎢᏴᏛ ᎠᏱᎸᏛ ᏓᎾᏓᏪᎳᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="File is too large.">
                <langSet xml:lang="en-US"><tig><term>File is too large.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏅᏂᎨᏒᎾ ᎨᎡᎢ ᎾᏍᏉ ᎡᏉᎯᏳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sent to">
                <langSet xml:lang="en-US"><tig><term>Sent to</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏭᏅᏅᎢ ᎾᎿᎢ</term></tig></langSet>
