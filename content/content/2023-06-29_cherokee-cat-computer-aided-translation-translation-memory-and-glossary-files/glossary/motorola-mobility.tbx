            </termEntry>
            <termEntry id="The objects are too far away to capture a portrait photo. Taking normal photo.">
                <langSet xml:lang="en-US"><tig><term>The objects are too far away to capture a portrait photo. Taking normal photo.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏧᏓᎴᏅᏓ ᎾᏍᎩᎾᏃ ᎢᏅᎯᏳ ᎾᎢ ᎦᏂᏴᏗ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏔᏅ ᏓᏟᎶᏍᏔᏅᎯ. ᏱᎬᏩᏍᏗᎭᏭ ᏱᎭᏟᎶᏍᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This will reset all Camera settings">
                <langSet xml:lang="en-US"><tig><term>This will reset all Camera settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎᎢ ᏥᎯᎧᎲᎦ ᏂᎦᏓ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart capture &amp; optimization">
                <langSet xml:lang="en-US"><tig><term>Smart capture &amp; optimization</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᎦᏂᏴᏗ &amp; ᎤᏃᏒᎯᏐᏗ ᏩᏂᎨ ᎦᎾᏗᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can\u2019t tether to more than  devices.">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t tether to more than  devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎵᎪᏙᏗ to ᎤᎪᏗᏊ ᎡᏍᎦᏉ  ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Find more tips and features in Settings">
                <langSet xml:lang="en-US"><tig><term>Find more tips and features in Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎯᏩᏔ ᏗᏓᏕᏲᎲᏍᎩ ᏃᎴ ᏗᎦᏎᏍᏙᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Spot Color Video mode active">
                <langSet xml:lang="en-US"><tig><term>Spot Color Video mode active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏓᎸ ᎠᏑᏫᏓ ᎠᏓᏴᎳᏛᏍᎩ ᎬᏙᏗᎭ ᎠᎵᏖᎸᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The rear camera hardware isn't working. Switching to selfie camera. Please contact customer support.Error code: 8X">
                <langSet xml:lang="en-US"><tig><term>The rear camera hardware isn't working. Switching to selfie camera. Please contact customer support.Error code: 8X</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᏝᏰᏃ ᏱᏚᎸᏫᏍᏓᏁᎢ. ᎦᏁᏟᏴᏍᎩ ᎾᎢ ᎣᎶᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᎤᏩᏍᎩ ᏕᎦᎫᏍᏛᏁᎭ.ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 8X</term></tig></langSet>
            </termEntry>
            <termEntry id="Blur level">
                <langSet xml:lang="en-US"><tig><term>Blur level</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᎪᎸ ᎠᏥᎶᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Torch">
                <langSet xml:lang="en-US"><tig><term>Torch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Reduce file size by saving as H.265/HEVC instead of H.264/AVC. Some platforms may not support the HEVC format.">
                <langSet xml:lang="en-US"><tig><term>Reduce file size by saving as H.265/HEVC instead of H.264/AVC. Some platforms may not support the HEVC format.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎳᎨ ᎠᏍᏆᏂᎪᏙᏗ ᎢᎩᏓ ᎨᏒᎢ ᏗᎵᏏᏅᏗᏍᎩ ᎾᏍᎩ H.265/HEVC ᎤᎬᏫᏳᏎᏍᏗ ᎥᎿᎢ H.264/AVC. ᎢᎦᏓ ᏓᏲᏓᏝᎲ ᏰᎵᏉ ᎭᏗ ᎦᎫᏍᏛᏅ ᏱᎩ ᎾᏍᎩ HEVC ᏱᎬᏁᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enhance low light selfie photos">
                <langSet xml:lang="en-US"><tig><term>Enhance low light selfie photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᎴᏍᏗ ᎤᏍᎪᎸ ᎠᏨᏍᏗ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏓᏓᏟᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Macro mode helps you take detailed photos of subjects as close as 4 cm away from the lens">
                <langSet xml:lang="en-US"><tig><term>Macro mode helps you take detailed photos of subjects as close as 4 cm away from the lens</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎹᎧᎣ ᎬᏙᏗᎭ ᏥᏕᎵᏍᎪ ᎠᎩᏍᏗ ᎠᏎᎸᎩ ᎢᎬᏁᏗ ᏗᏓᏥᎶᏍᏔᏅ ᎥᎿᎢ ᎪᎱᏍᏗ ᏗᎧᏃᎮᏗ ᎯᎢᎾᎢ ᎠᏍᏚᎭ ᎯᎢᎾᎢ 4 cm ᎤᏣᏘᎾ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᏗᏓᎨᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you prefer light theme during the day and dark theme at night, you can switch back and forth automatically. You can choose specific times or let the theme change based on the sunrise &amp; sunset time in your location.">
                <langSet xml:lang="en-US"><tig><term>If you prefer light theme during the day and dark theme at night, you can switch back and forth automatically. You can choose specific times or let the theme change based on the sunrise &amp; sunset time in your location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎤᏟ ᏱᏁᎵ ᎤᏓᏌᎧᎢ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᎾᎯᏳ ᎾᏍᎩ ᎢᎦ ᏃᎴ ᎤᎵᏏᎩ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᎤᎿᎢ ᏒᏃᏱ, ᏂᎯ ᏰᎵᏊ ᏱᎯᏁᏟᏴᎾ ᏃᎴ ᏴᎯᏌᏙᏯ cᎤᏩᏌᏊ ᎢᏯᏓᏛᏁᎯ. ᏰᎵᏊ ᏣᏑᏰᏍᏗ ᏗᏙᎳᎩ ᏓᏟᎢᎵᏒ ᎠᎴᏃ ᎠᎵᏍᎪᎸᏔᏅ ᎾᏍᎩ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᎦᏁᏟᏴᏓ ᏓᎳᏏᏔᏅᎩ ᎤᎾᎢ ᏅᏙ ᎢᎦ ᎡᎯ ᏨᏗᎧᎸᎪ &amp; ᎤᏓ ᎢᎦ ᎡᎯ ᏭᏕᎵᎬ ᎠᏥᏱᎵᏒ ᎾᎿᎢ ᏣᏤᎵ ᎢᎬᎾᏕᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can’t use camera. Make sure  is off and close any apps that may be using the camera. If the problem continues, please restart your phone.">
                <langSet xml:lang="en-US"><tig><term>Can’t use camera. Make sure  is off and close any apps that may be using the camera. If the problem continues, please restart your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎬᏙᏓ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ  ᎾᏍᎩ ᎠᏍᏚᎭ ᏃᎴ ᎠᏍᏚᏅᎢ ᏂᎦᎥ ᏗᎬᏙᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏗᏍᎩ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᎥᎿᎢ ᎾᏍᎩ ᏓᏓᎴᎬ ᏫᎬᎵᏱᎴᎩ, ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Rear camera">
                <langSet xml:lang="en-US"><tig><term>Rear camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Front photo resolution">
                <langSet xml:lang="en-US"><tig><term>Front photo resolution</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎬᏱᏗᏨ ᏗᏓᏥᎶᏍᏔᏅ ᏫᏓᏤᎸ ᎤᏓᏴᎳᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shoot in B&amp;W like a pro">
                <langSet xml:lang="en-US"><tig><term>Shoot in B&amp;W like a pro</term></tig></langSet>
