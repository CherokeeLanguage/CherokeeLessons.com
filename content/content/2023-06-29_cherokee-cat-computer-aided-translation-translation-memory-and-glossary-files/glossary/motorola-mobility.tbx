            <termEntry id="When a camera is active a bubble will show on screen.">
                <langSet xml:lang="en-US"><tig><term>When a camera is active a bubble will show on screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ Ꭰ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ Ꭰ ᏓᎵᏆᎷᎲᏍᎬ ᎠᏎ ᎠᎪᏩᏛᏙᏗ ᎤᎿᎢ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge color">
                <langSet xml:lang="en-US"><tig><term>Edge color</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᎠᏑᏫᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep on after device restarts">
                <langSet xml:lang="en-US"><tig><term>Keep on after device restarts</term></tig></langSet>
