            <termEntry id="Erases all data on the SD card, such as music and photos">
                <langSet xml:lang="en-US"><tig><term>Erases all data on the SD card, such as music and photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ ᏥᎩ SD ᏆᎾᏲᏍᏗ, ᏕᎧᏁᎢᏍᏔᏅᎯ ᏗᎧᏃᎩᏙᏗ ᏃᎴ ᏗᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="A PIN protects your phone if it\u2019s lost or stolen.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A PIN protects your phone if it\u2019s lost or stolen.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D PIN ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᏃᎴ ᎦᏃᏍᎩᏓᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Time">
                <langSet xml:lang="en-US"><tig><term>Time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you eject this ^1, apps stored on it will stop working, and media files stored on it will not be available until it is reinserted.This ^1 is formatted to work on this device only. It won\u2019t work on any others.">
                <langSet xml:lang="en-US"><tig><term>When you eject this ^1, apps stored on it will stop working, and media files stored on it will not be available until it is reinserted.This ^1 is formatted to work on this device only. It won\u2019t work on any others.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏓᏄᎪᏫᏍᏗ ᎯᎠ ^1, ᏗᎬᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᎨᎡᎢ ᎠᏎ ᎭᎴᏫᏍᏓ ᏗᎦᎸᏫᏍᏓᏁᎢ, ᏃᎴ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᎨᎡᎢ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎩᎳ ᎨᎡᎢ ᎪᏣᎸᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ.ᎯᎠ ^1 ᎨᎡᎢ ᎪᏢᏅᎯ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏅᏒ. ᎨᎡᎢ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎿᎢ ᎾᏂᎥᏉ ᏐᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set data usage limit">
                <langSet xml:lang="en-US"><tig><term>Set data usage limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎠᏎᎸᎯ</term></tig></langSet>
