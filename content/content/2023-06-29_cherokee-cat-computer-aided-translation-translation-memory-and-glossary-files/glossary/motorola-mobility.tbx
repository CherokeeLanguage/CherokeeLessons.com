            <termEntry id="CALL ENDED -06-">
                <langSet xml:lang="en-US"><tig><term>CALL ENDED -06-</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎠLL ᎡNᏕD -6-</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device is already unlocked!">
                <langSet xml:lang="en-US"><tig><term>Your device is already unlocked!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎩ ᎦᏳᎳᏉ ᎠᏂᏐᎭᎾᎳᎩ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Details on www.orange.pl/wificallingChoose the SETTINGS menu below to activate your WiFi Calling service on your mobile device.">
                <langSet xml:lang="en-US"><tig><term>Details on www.orange.pl/wificallingChoose the SETTINGS menu below to activate your WiFi Calling service on your mobile device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏕᎬᎿᏅᎢ ᎾᎿᎢ www.orange.pl/wificallingᏣᏑᏰᏍᏗ ᏥᎩ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᎡᎳᏗᏢ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ; WiFi ᏓᏯᏂᏍᎬ ᎢᏯᏓᏛᏁᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="WiFi Calling is the service providing the ability to make and receive voice calls over the Internet connection in any available WiFi network, even if you are out of mobile coverage.">
                <langSet xml:lang="en-US"><tig><term>WiFi Calling is the service providing the ability to make and receive voice calls over the Internet connection in any available WiFi network, even if you are out of mobile coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>WiFi ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᏥᎩ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎬ ᏥᎩ ᎾᏏᎾᏒ ᎾᎿᎢ ᎪᏢᏗ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ ᎢᏴᏛ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎾᎿ ᎾᏂᎥᏉ ᎠᏛᏅᎢᏍᏔᏅ WiFi ᏧᎾᏚᏓᎵ, ᎥᏍᏊ ᎾᎿ ᏂᎯ ᎨᎡᎩ ᎤᎾᏙᏣᎴᏍᏗ ᎠᏂᎩᏍᎩ ᎫᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The WiFi Calling icon on the notification bar(shown below) indicates that all your calls are using WiFi Calling.">
                <langSet xml:lang="en-US"><tig><term>The WiFi Calling icon on the notification bar(shown below) indicates that all your calls are using WiFi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ WiFi ᏓᏯᏂᏍᎬ ᎠᎢᎧᏂ ᎤᎿᎢ ᏥᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎦᎾᎸ (ᎤᏓᏎᎮᎸᎩ ᎡᎳᏗᏢ) ᎠᏓᏎᎮᏗ ᎥᏍᎩᎾ ᏂᎦᏓ ᏂᏨᎤᎢ ᏓᏯᏂ ᎨᎡᎩ ᎬᏗᎭ WiFi ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restart it and try again.">
                <langSet xml:lang="en-US"><tig><term>Restart it and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎭᏂᎩᏍᏓ ᎨᎡᎢ ᎠᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change this later in Settings &gt; Apps">
