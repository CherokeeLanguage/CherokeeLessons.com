                <langSet xml:lang="chr"><tig><term>ᎯᏴᏓ ᎢᏤ SIM PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Some tiles aren’t available on the external display.">
                <langSet xml:lang="en-US"><tig><term>Some tiles aren’t available on the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏚᏦᎳᏂ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᎥᎾᎢ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Warning: Your device will be locked after  incorrect attempts.">
                <langSet xml:lang="en-US"><tig><term>Warning: Your device will be locked after  incorrect attempts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ: ᏍᏓᏯ ᏛᎵᏍᏚᏂ ᏥᏂᏕᎬᏅᏗᏓᏅ  ᏂᏚᏳᎬᏛᎾ ᎤᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If 2G service is disabled, some apps and functions may not work in locations where LTE or 3G is unavailable.">
                <langSet xml:lang="en-US"><tig><term>If 2G service is disabled, some apps and functions may not work in locations where LTE or 3G is unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏛᏁᏗ ᎬᏙᏗ ᏂᎨᏒᎾ ᏱᎩ, ᎢᎦᏓ ᏗᎬᏙᏗ ᎠᎴ ᏧᎸᏫᏍᏓᏁᏗᏱ ᏳᏄᎸᎲᎦ ᎤᏙᏢᏒᎢ Ꮎ LTE ᎠᎴ 3G Ꮭ ᎬᏙᏗ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A higher display refresh rate allows for the smoothest picture, but it requires more battery power.">
                <langSet xml:lang="en-US"><tig><term>A higher display refresh rate allows for the smoothest picture, but it requires more battery power.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᎸᎳᏗ ᏱᎪᏩᏘ ᎯᏤᎲᏍᏗᏍᎬᎢ ᎤᏩᎾᏕᏍᎩ ᏱᎪᏩᏔ, ᎠᏎᏃ ᏍᏈᎢᏍᏗ ᎠᎾᎦᎵᏍᎩ ᏱᎦᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="The SIM card cannot be found.">
                <langSet xml:lang="en-US"><tig><term>The SIM card cannot be found.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> Ꮎ SIM ᏗᏆᏂᏲᏍᏓ ᎤᎾᏞᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile + PC">
                <langSet xml:lang="en-US"><tig><term>Mobile + PC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ + PC</term></tig></langSet>
            </termEntry>
            <termEntry id="Your calls made with WiFi Calling in Poland are charged in the same way as your regular mobile calls in your mobile tariff plan.">
                <langSet xml:lang="en-US"><tig><term>Your calls made with WiFi Calling in Poland are charged in the same way as your regular mobile calls in your mobile tariff plan.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎯ ᏕᎯᏯᏂᏍᎬ ᏛᎪᏢᏗᏍᎬ WiFi ᏛᏯᏂᏍᎬ ᏉᎳᏂ ᎤᏠᏱ ᎣᎾᏟᏍᎬ ᏂᏨᏅᎯ ᎤᏠᏱᎭ ᎠᏂᎩᏍᎩ ᏕᎯᏯᏂᏍᎬ ᎾᎿᎢ ᏂᏨᏅᎯ ᎠᏰᎵ ᎠᎫᏴᏗ ᎠᏍᏓᏫᏛᏍᏗ.</term></tig></langSet>
            </termEntry>
