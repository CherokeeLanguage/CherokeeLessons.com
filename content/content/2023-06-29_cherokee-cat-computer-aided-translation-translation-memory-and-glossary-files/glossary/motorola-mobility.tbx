                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏙᏔᏅ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᎾᏍᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Notification history, bubbles, recently sent">
                <langSet xml:lang="en-US"><tig><term>Notification history, bubbles, recently sent</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏃᏣᎳᏁᎯ ᏂᏧᎵᏍᏔᏅᏒ, ᏓᎵᏆᎷᎲᏍᎬ, ᎾᏞᎬᏭ ᏫᎦᏅᏅᎢ</term></tig></langSet>
            </termEntry>
