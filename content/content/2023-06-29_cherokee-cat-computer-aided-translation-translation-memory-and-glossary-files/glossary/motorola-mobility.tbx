                <langSet xml:lang="en-US"><tig><term>DTMF tones</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>DTMFtᎣᏁᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="Network message">
                <langSet xml:lang="en-US"><tig><term>Network message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏁtᏬrk ᎺᏍᏌᎨ</term></tig></langSet>
            </termEntry>
            <termEntry id="A special call needs to be made to activate your phone service.">
                <langSet xml:lang="en-US"><tig><term>A special call needs to be made to activate your phone service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏍpᎡcᎢᎠl cᎠll ᏁᎡdᏍ tᎣ bᎡ ᎹᏕ tᎣ ᎠcᏘᎥᎠᏖ ᏲᎤr pᎰᏁ ᏎrᎥᎢcᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The phone is activating your mobile data service.">
                <langSet xml:lang="en-US"><tig><term>The phone is activating your mobile data service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮ pᎰᏁ ᎢᏍ ᎠᎴᏅᏙᏗ ᏲᎤr ᎼbᎢᎴ ᏓᏔ ᏎrᎥᎢcᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you skip activation, you can't place calls or connect to mobile data networks (though you can connect to Wi-Fi networks).">
                <langSet xml:lang="en-US"><tig><term>If you skip activation, you can't place calls or connect to mobile data networks (though you can connect to Wi-Fi networks).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭲf ᏲᎤ ᏍkᎢp ᎠcᏘᎥᎠᏘᎣn, ᏲᎤ cᎠn't pᎳcᎡ cᎠllᏍ Ꭳr cᎣnᏁct tᎣ ᎼbᎢᎴ ᏓᏔ ᏁtᏬrkᏍ (tᎰᎤgh ᏲᎤ cᎠn cᎣnᏁct tᎣ Ꮻ-FᎢ ᏁtᏬrkᏍ).</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone is activated.">
                <langSet xml:lang="en-US"><tig><term>Phone is activated.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PᎰᏁ ᎢᏍ ᎠcᏘᎥᎠᏖd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Follow the spoken instructions until you hear that activation is complete.">
                <langSet xml:lang="en-US"><tig><term>Follow the spoken instructions until you hear that activation is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>FᎣlᎶw tᎮ ᏍpᎣkᎡn ᎢnᏍtrᎤcᏘᎣnᏍ ᎤnᏘl ᏲᎤ ᎮᎠr tᎭt ᎠcᏘᎥᎠᏘᎣn ᎢᏍ cᎣmpᎴᏖ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't program your phone">
                <langSet xml:lang="en-US"><tig><term>Couldn't program your phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎣᎤldn't prᎣgrᎠm ᏲᎤr pᎰᏁ</term></tig></langSet>
            </termEntry>
            <termEntry id="It may take up to 15 minutes for service to start.">
                <langSet xml:lang="en-US"><tig><term>It may take up to 15 minutes for service to start.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭲt Ꮉy ᏔkᎡ Ꭴp tᎣ 15 ᎻᏄᏖᏍ fᎣr ᏎrᎥᎢcᎡ tᎣ ᏍᏔrt.</term></tig></langSet>
            </termEntry>
            <termEntry id="After pressing \u201CActivate\u201D, listen to the instructions provided to activate your phone.">
                <langSet xml:lang="en-US"><tig><term>After pressing \u201CActivate\u201D, listen to the instructions provided to activate your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠfᏖr prᎡᏍᏏng \Ꭴ 201 CᎠcᏘᎥᎠᏖ\Ꭴ 201 D, ᎵᏍᏖn tᎣ tᎮ ᎢnᏍtrᎤcᏘᎣnᏍ prᎣᎥᎢᏕd tᎣ ᎠcᏘᎥᎠᏖ ᏲᎤr pᎰᏁ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Activating...">
                <langSet xml:lang="en-US"><tig><term>Activating...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏅᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This can take up to 5 minutes.">
                <langSet xml:lang="en-US"><tig><term>This can take up to 5 minutes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎯᏍ cᎠn ᏔkᎡ Ꭴp tᎣ 5 ᎻᏄᏖᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Until you activate your phone, you are asked to activate it each time you turn it on.">
                <langSet xml:lang="en-US"><tig><term>Until you activate your phone, you are asked to activate it each time you turn it on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤnᏘl ᏲᎤ ᎠcᏘᎥᎠᏖ ᏲᎤr pᎰᏁ, ᏲᎤ ᎠrᎡ ᎠᏍkᎡd tᎣ ᎠcᏘᎥᎠᏖ Ꭲt ᎡᎠch ᏘᎺ ᏲᎤ tᎤrn Ꭲt Ꭳn.</term></tig></langSet>
            </termEntry>
            <termEntry id="Problem with activation">
                <langSet xml:lang="en-US"><tig><term>Problem with activation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PrᎣbᎴm Ꮻth ᎠcᏘᎥᎠᏘᎣn</term></tig></langSet>
            </termEntry>
            <termEntry id="Programming your phone\u2026">
                <langSet xml:lang="en-US"><tig><term>Programming your phone\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PrᎣgrᎠmᎻng ᏲᎤr pᎰᏁ\Ꭴ 2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone is now activated.">
                <langSet xml:lang="en-US"><tig><term>Your phone is now activated.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr pᎰᏁ ᎢᏍ Ꮓw ᎠcᏘᎥᎠᏖd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone didn't activate.">
                <langSet xml:lang="en-US"><tig><term>Your phone didn't activate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr pᎰᏁ Ꮧdn't ᎠcᏘᎥᎠᏖ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again or call customer service for more options.">
                <langSet xml:lang="en-US"><tig><term>Try again or call customer service for more options.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TrᏱng ᎠᎦᎢn Ꭳr cᎠll cᎤᏍtᎣᎺr ᏎrᎥᎢcᎡ fᎣr ᎼrᎡ ᎣpᏘᎣnᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="EXCESS SPC FAILURES">
                <langSet xml:lang="en-US"><tig><term>EXCESS SPC FAILURES</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡXCᎡᏍᏍ SPC FᎠᎢᎷRᎡᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="Entered Emergency Callback Mode">
                <langSet xml:lang="en-US"><tig><term>Entered Emergency Callback Mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏪᏯᎾ ᎠᏨᏍᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency Callback Mode">
                <langSet xml:lang="en-US"><tig><term>Emergency Callback Mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏪᏯᎾ ᎠᏨᏍᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="While in this mode no apps using a data connection can be used.">
                <langSet xml:lang="en-US"><tig><term>While in this mode no apps using a data connection can be used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>WᎯᎴ Ꭲn tᎯᏍ ᎼᏕ Ꮓ ᎠppᏍ ᎤᏏng Ꭰ ᏓᏔ cᎣnᏁcᏘᎣn cᎠn bᎡ ᎤᏎd.</term></tig></langSet>
            </termEntry>
            <termEntry id="You may need to find an area with better coverage (near a window, or outside).">
                <langSet xml:lang="en-US"><tig><term>You may need to find an area with better coverage (near a window, or outside).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤ Ꮉy ᏁᎡd tᎣ fᎢnd Ꭰn ᎠrᎡᎠ Ꮻth bᎡtᏖr cᎣᎥᎡrᎠᎨ (ᏁᎠr Ꭰ ᏫnᏙw, Ꭳr ᎣᎤᏥᏕ).</term></tig></langSet>
            </termEntry>
            <termEntry id="EcmExitDialog">
                <langSet xml:lang="en-US"><tig><term>EcmExitDialog</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>EcmᎡxᎢtᏗᎠᎶg</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your fingerprint to unlock your phone or approve purchases.Note: You can\u2019t use your fingerprint to unlock this device. For more information, contact your organization\u2019s admin.">
                <langSet xml:lang="en-US"><tig><term>Use your fingerprint to unlock your phone or approve purchases.Note: You can\u2019t use your fingerprint to unlock this device. For more information, contact your organization\u2019s admin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᎪᎯᏳᏙᏗ ᏗᏩᎯᏍᏗ.ᎤᏍᏗ ᎪᏪᎸ: ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ. ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎢᏣᏙᏢᏒᎢ\u2019s ᎤᎦᏎᏍᏗᏕᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The selected action isn't available while in the Emergency Callback mode.">
                <langSet xml:lang="en-US"><tig><term>The selected action isn't available while in the Emergency Callback mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏑᏰᏛ ᎢᏯᏛᏁᎵᏓᏍᏗ ᏄᏍᏛ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎾᎯᏳᎢ ᎾᎿ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Exiting Emergency Callback mode">
                <langSet xml:lang="en-US"><tig><term>Exiting Emergency Callback mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏪᏯᎾ ᎠᏨᏍᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The phone is in emergency callback mode">
                <langSet xml:lang="en-US"><tig><term>The phone is in emergency callback mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮ pᎰᏁ Ꮻll bᎡ Ꭲn ᎢᎦᎵᏍᏗᏍᎩ CᎠllbᎠck ᎼᏕ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Until ">
