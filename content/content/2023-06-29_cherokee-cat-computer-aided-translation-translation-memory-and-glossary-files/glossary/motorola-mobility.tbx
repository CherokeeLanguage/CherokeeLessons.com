            </termEntry>
            <termEntry id="Data Sent:">
                <langSet xml:lang="en-US"><tig><term>Data Sent:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᏫᎦᏅᏅᎯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable blocking of all incoming international roaming?">
                <langSet xml:lang="en-US"><tig><term>Disable blocking of all incoming international roaming?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎠᏍᏚᎲ ᎾᎿ ᏂᎦᏓ ᎦᎷᎦ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎡᏙᎵᏙᎲ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Block outgoing international roaming?">
                <langSet xml:lang="en-US"><tig><term>Block outgoing international roaming?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳ ᎦᏅᎪᏫᏛ ᏓᏰᏏ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎡᏙᎵᏙᎲ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe from right to left on the sensor.">
                <langSet xml:lang="en-US"><tig><term>Swipe from right to left on the sensor.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎦᏘᏏ ᎾᎿᎢ ᎠᎦᏍᎦᏂ ᎤᎿᎢ ᏥᎩ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb">
