            <termEntry id="If you want to securely share your device with someone, try using a guest user instead.">
                <langSet xml:lang="en-US"><tig><term>If you want to securely share your device with someone, try using a guest user instead.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏱᏣᏚᎵᎢ ᎾᎢ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏯᏙᎯᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏠᏯᏍᏗ ᎩᎶᎢ, ᎭᏁᎵᏓ ᏣᏙᏗᎢ ᎾᏍᎩ ᎠᏓᏩᏛᎯᏙᎯ ᎬᏗᏍᎩ ᎤᎬᏫᏳᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Access to temporarily adjust screen brightness.">
                <langSet xml:lang="en-US"><tig><term>Access to temporarily adjust screen brightness.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᏞᎦᏊ ᎠᏓᏁᏟᏴᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎤᏍᎪᏍᏗᏴ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you've turned on Wi-Fi on both your phone and PC, or connected by a USB data cable.">
                <langSet xml:lang="en-US"><tig><term>Make sure you've turned on Wi-Fi on both your phone and PC, or connected by a USB data cable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎢᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ PC, ᎠᎴᏃ ᎫᏓᎸᏅᎯ ᎬᏗ USB ᎦᏟᏌᏅᎯ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="App pinning allows you to keep the current app in view until you unpin it.">
                <langSet xml:lang="en-US"><tig><term>App pinning allows you to keep the current app in view until you unpin it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎯ ᎾᎢ ᏍᏆᏂᎪᏙᏗ ᎾᏍᎩ ᏃᏊ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᎩᎳ ᏂᎯ ᎯᎥᏍᏈᏛᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature can be used, for example, to let a trusted friend play a specific game.">
                <langSet xml:lang="en-US"><tig><term>This feature can be used, for example, to let a trusted friend play a specific game.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏰᎵᏊ ᎨᏒᎢ ᏗᏔᏅᎯ, ᎾᏍᎩᎾ ᏱᏓᏟᎶᏍᏔᎾ, ᎾᎢ ᎠᎵᏍᎪᎸᏔᏅᎢ ᎨᎦᎨᏅᏛ ᎤᎾᎵᎢ ᏗᏁᎸᏙᏗ ᏗᏙᎳᎩ ᏗᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When an app is pinned, the pinned app may open other apps and personal data may be accessible.">
                <langSet xml:lang="en-US"><tig><term>When an app is pinned, the pinned app may open other apps and personal data may be accessible.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎠᎴᎢ ᎬᏙᏗ ᎾᏍᎩ ᎦᎭᏔᏅᎢ, ᎾᏍᎩ ᎦᎭᏔᏅᎢ ᎬᏙᏗ ᏰᎵᏉ ᏱᏓᏍᏚᎭ ᏐᎢ ᏗᎬᏙᏗ ᎠᎴ ᎠᏏᏴᏫ ᎦᏟᏌᏅᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᎯᏓ ᎠᎩᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When an app is pinned, the pinned app may open other apps and personal data may be accessible.">
                <langSet xml:lang="en-US"><tig><term>When an app is pinned, the pinned app may open other apps and personal data may be accessible.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎠᎴᎢ ᎬᏙᏗ ᎾᏍᎩ  ᎦᎭᏔᏅᎢ, ᎾᏍᎩ ᎦᎭᏔᏅᎢ ᎬᏙᏗ ᏰᎵᏉ ᏱᏓᏍᏚᎭ ᏐᎢ ᏗᎬᏙᏗ ᎠᎴ ᎠᏏᏴᏫ ᎦᏟᏌᏅᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᎯᏓ ᎠᎩᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use app pinning: \t1.\tTurn on app pinning \t2.\tOpen Overview \t3.\tTap the app icon at the top of the screen, then tap Pin">
                <langSet xml:lang="en-US"><tig><term>To use app pinning: \t1.\tTurn on app pinning \t2.\tOpen Overview \t3.\tTap the app icon at the top of the screen, then tap Pin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ: \t1.\tᎠᏍᏚᎢᏓ ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ \t2.\tᎠᏍᏚᎢᏓ ᏍᏆᎳ ᎧᏃᎮᏓ \t3.\tᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎬᏙᏗ ᎠᎢᎧᏂ ᎤᎿᎢ ᎾᏍᎩ ᎦᏚᎢ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ, ᎿᏉᏃ ᎭᏐᎥᏍᏗ ᎦᎭᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="Your new ^1 is working.">
                <langSet xml:lang="en-US"><tig><term>Your new ^1 is working.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏤ ^1 ᎨᎡᎢ ᏚᏂᎸᏫᏍᏓᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Read Moto Voice app states">
                <langSet xml:lang="en-US"><tig><term>Read Moto Voice app states</term></tig></langSet>
