                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᏕᎦᏰᏌᏛ ᎦᎶᎯᏍᏗᏍᎩ ᎡᎳᏗᏟ ᎾᎿᎢ ᎠᏓᏯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Finding your location…">
                <langSet xml:lang="en-US"><tig><term>Finding your location…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏩᏘᏍᎬ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ…</term></tig></langSet>
            </termEntry>
            <termEntry id="This helps protect data on lost or stolen devices.">
                <langSet xml:lang="en-US"><tig><term>This helps protect data on lost or stolen devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏓᎵᏍᏕᎵᏍᎪ ᎠᎵᏍᏕᎸᏙᏗ ᎦᏟᏌᏅᎯ ᎤᎾᎢ ᎤᏂᏲᎱᏎᎸ ᎠᎴᏃ ᎦᏃᏍᎩᏓ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To allow your device to share location data, tap “Allow all the time” on the following screen.">
                <langSet xml:lang="en-US"><tig><term>To allow your device to share location data, tap “Allow all the time” on the following screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏴᎵᏍᎪᎵᏗ ᏥᏂᏕᎬᏅᏗᏓᏅ ᎤᏃᎮᏗ ᎮᏙᎲᎦᏟᏌᏅ, ᎠᏐᏍᏗ "ᎭᎵᏍᎪᎵᏗ ᏂᎦᏓ ᎠᏟᎠᎵᏒ" ᎠᏴᏙᎸᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="While using Mobile Hotspot, Wi-Fi is disabled.">
                <langSet xml:lang="en-US"><tig><term>While using Mobile Hotspot, Wi-Fi is disabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎤᏗᏞᎩ ᎤᏓᏓᏢ, Wi-Fi ᏄᏍᏛ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video on">
