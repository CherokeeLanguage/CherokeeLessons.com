                <langSet xml:lang="chr"><tig><term>ᏝᏍᏗ ᎠᎲᏍᏗ ᏥᎩ ^2 ᎾᎯᏳ ᏥᎩ ᎠᎲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you agree to turn off battery saver for this test?">
