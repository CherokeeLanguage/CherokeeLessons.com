            <termEntry id="Your security update is almost complete.Your device will\u0020">
                <langSet xml:lang="en-US"><tig><term>Your security update is almost complete.Your device will\u0020</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎾᎥᏂᎨᏍᏗ ᎠᏍᏆᏛᏃᏅ.ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓ ᎠᏎ\u0020</term></tig></langSet>
