                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎬᏙᏗ\u2019 ᎦᏟᏌᏅᎯ ᏰᎵᏉ ᎬᏩᎦᏔ ᎠᏍᎪᎸᏛᏃ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter a contact name or phone number to start a new message">
                <langSet xml:lang="en-US"><tig><term>Enter a contact name or phone number to start a new message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ Ꭰ ᎠᏟᏃᎮᏙᏗ ᏚᏅᏙᎥ ᎠᎴ ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ ᎾᎿᎢ ᎭᎴᎾ Ꭰ ᏗᏤ ᏗᎦᏃᏣᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn them off in settings.">
                <langSet xml:lang="en-US"><tig><term>You can turn them off in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎦᏔᎲᏍᏗ ᎯᎠ ᎠᏍᏚᎭ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
