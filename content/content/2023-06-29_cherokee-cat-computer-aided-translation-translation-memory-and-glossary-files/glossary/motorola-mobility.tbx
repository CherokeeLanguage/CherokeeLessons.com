                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗ ᎠᏆᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Add data or roaming plan through ">
                <langSet xml:lang="en-US"><tig><term>Add data or roaming plan through </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎴᏃ ᎡᏙᎵᏓᏍᏗ ᎠᏍᏓᏩᏛᏍᏗ ᏬᎶᎯᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data has run out">
                <langSet xml:lang="en-US"><tig><term>Mobile data has run out</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᎤᎵᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please contact your service provider ">
                <langSet xml:lang="en-US"><tig><term>Please contact your service provider </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏣᏤᎵ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data status">
                <langSet xml:lang="en-US"><tig><term>Mobile data status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your mobile data has been deactivated">
                <langSet xml:lang="en-US"><tig><term>Your mobile data has been deactivated</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎴᏫᏍᏙᏔᏅ ᏂᎦᎵᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t allow">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t allow</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᎵᏍᎪᎸᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera stopped recording">
                <langSet xml:lang="en-US"><tig><term>Camera stopped recording</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᎴᏫᏍᏓ ᎦᏂᏴᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep  of app data.">
                <langSet xml:lang="en-US"><tig><term>Keep  of app data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ  ᎥᎿᎢ ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your phone or loss of data that may result from its use.">
                <langSet xml:lang="en-US"><tig><term>Your phone and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your phone or loss of data that may result from its use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏒᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᎾᎦᎳᎢ ᏗᎦᏘᎴᎩ ᏄᏩᏅ ᎬᎪᏟᏍᏗ ᏂᎦᏒᎾ ᏗᎬᏙᏗ. ᎾᏍᎩ ᎦᏘᏅᏛᏍᎬ ᎯᎠ ᎬᏙᏗ, ᏂᎯ ᎣᏏ ᎯᏰᎸᏍᎦ ᎾᏍᎩᎾᎢ ᏂᎯ ᎨᏒ ᏣᏚᏓᎴᏍᏗ ᎾᏍᎩᎾ ᏂᎦᎥ ᎤᏲᏨᎯ ᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴᏃ ᏣᏲᎱᏎᎸ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾᎢ ᏰᎵᏉ ᎢᎬᏩᎵᏍᏙᏗ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your tablet and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your tablet or loss of data that may result from its use.">
                <langSet xml:lang="en-US"><tig><term>Your tablet and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your tablet or loss of data that may result from its use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏒᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᎾᎦᎳᎢ ᏗᎦᏘᎴᎩ ᏄᏩᏅ ᎬᎪᏟᏍᏗ ᏂᎦᏒᎾ ᏗᎬᏙᏗ. ᎾᏍᎩ ᎦᏘᏅᏛᏍᎬ ᎯᎠ ᎬᏙᏗ, ᏂᎯ ᎣᏏ ᎯᏰᎸᏍᎦ ᎾᏍᎩᎾᎢ ᏂᎯ ᎨᏒ ᏣᏚᏓᎴᏍᏗ ᎾᏍᎩᎾ ᏂᎦᎥ ᎤᏲᏨᎯ ᎾᎢ ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᎠᎴᏃ ᏣᏲᎱᏎᎸ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾᎢ ᏰᎵᏉ ᎢᎬᏩᎵᏍᏙᏗ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The current user is not allowed to perform this uninstallation.">
                <langSet xml:lang="en-US"><tig><term>The current user is not allowed to perform this uninstallation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏃᏊ ᏥᎩ ᎬᏗᏍᎩ ᎭᏗ ᎤᎵᏍᎪᎸᏔᏅ ᏱᎩ ᎾᎢ ᏱᎬᏛᏁᏗ ᎯᎠ ᎤᏂᏘᏅᏕᏒᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your admin doesn't allow installation of apps obtained from unknown sources">
                <langSet xml:lang="en-US"><tig><term>Your admin doesn't allow installation of apps obtained from unknown sources</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏄᏂᎬᏫᏳᏌᏕᎩ ᏤᏍᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎦᏘᏅᏛᏍᏗ ᎥᎿᎢ ᏗᎬᏙᏗ ᏱᏓᏩᏛᎲ ᏂᏓᏳᏓᎴᏅ ᏅᎪᎵᎬᎾ ᏙᏓᏳᏓᎴᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is required by your device administrator and can't be uninstalled.">
                <langSet xml:lang="en-US"><tig><term>This app is required by your device administrator and can't be uninstalled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎾᏍᎩ ᎠᏎᏯᏛᏁᏗ ᎬᏂ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᏃᎴ ᎨᏍᏗ ᏰᎵ ᎨᏒᎢ ᎤᎦᏘᏅᏕᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is needed for your profile and can't be uninstalled.">
                <langSet xml:lang="en-US"><tig><term>This app is needed for your profile and can't be uninstalled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎾᏍᎩ ᎤᏚᎸᏛ ᎾᏍᎩᎾ ᏣᏤᎵ ᎤᎧᏛ ᏃᎴ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎤᎦᏘᏅᏕᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unknown apps can't be installed by this user">
                <langSet xml:lang="en-US"><tig><term>Unknown apps can't be installed by this user</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᎪᎵᎬᎾ ᏗᎬᏙᏗ ᏤᏍᏗ ᎨᏒᎢ ᎦᏘᏅᏔᏅ ᏄᏩᎾ ᎯᎠ ᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't uninstall active device admin app">
                <langSet xml:lang="en-US"><tig><term>Can't uninstall active device admin app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏥᎯᏘᏅᏓᎩ ᎠᎵᏖᎸᎲᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏂᎬᏫᏳᏌᏕᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Venezuela">
                <langSet xml:lang="en-US"><tig><term>Venezuela</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏁᏑᏪᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your TV and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your TV or loss of data that may result from its use.">
                <langSet xml:lang="en-US"><tig><term>Your TV and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your TV or loss of data that may result from its use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏒᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᎾᎦᎳᎢ ᏗᎦᏘᎴᎩ ᏄᏩᏅ ᎬᎪᏟᏍᏗ ᏂᎦᏒᎾ ᏗᎬᏙᏗ. ᎾᏍᎩ ᎦᏘᏅᏛᏍᎬ ᎯᎠ ᎬᏙᏗ, ᏂᎯ ᎣᏏ ᎯᏰᎸᏍᎦ ᎾᏍᎩᎾᎢ ᏂᎯ ᎨᏒ ᏣᏚᏓᎴᏍᏗ ᎾᏍᎩᎾ ᏂᎦᎥ ᎤᏲᏨᎯ ᎾᎢ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴᏃ ᏣᏲᎱᏎᎸ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾᎢ ᏰᎵᏉ ᎢᎬᏩᎵᏍᏙᏗ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't uninstall active device admin app for ">
                <langSet xml:lang="en-US"><tig><term>Can't uninstall active device admin app for </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏥᎯᏘᏅᏓᎩ ᎠᎵᏖᎸᎲᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏂᎬᏫᏳᏌᏕᎩ ᎬᏙᏗ ᎾᏍᎩᎾ </term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to uninstall this app for allusers? The application and its data will be removed from all users on the device.">
                <langSet xml:lang="en-US"><tig><term>Do you want to uninstall this app for allusers? The application and its data will be removed from all users on the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍ ᏣᏚᎵ ᎾᎢ ᎢᏣᏘᏅᏕᏍᏗ ᎯᎠ ᎬᏙᏗ ᎾᏍᎩᎾ ᏂᎦᏓᏗᏅᏗᏍᎩ? ᎾᏍᎩᏃ ᎠᏔᏲᏍᏙᏗ ᏃᎴ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏒ ᎠᎲᏍᏓ ᎾᏍᎩᎾ ᏂᎦᏓ ᏗᏅᏗᏍᎩ ᎤᎾᎢ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Replace this app with the factory version? All data will be removed.">
                <langSet xml:lang="en-US"><tig><term>Replace this app with the factory version? All data will be removed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏓ ᎯᎠ ᎬᏙᏗ ᎬᏗ ᎾᏍᎩ ᎤᏃᏢᏅᏗ ᏄᏓᎴᏒᎢ? ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏒ ᎠᎲᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera must be unlocked for Face Detection">
                <langSet xml:lang="en-US"><tig><term>Camera must be unlocked for Face Detection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏎᎢ ᎠᏂᏐᎭᎾᎳᎩ ᎤᎬᏩᏟ ᎧᏁᏉᏍᏗᏍᎬ ᏚᎾᏄᎪᏫᏍᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't display preview">
