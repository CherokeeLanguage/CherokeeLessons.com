                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please move to a cool place with good signal, or turn off 4G in settings.">
                <langSet xml:lang="en-US"><tig><term>Please move to a cool place with good signal, or turn off 4G in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎲᎾ ᎾᎾᎢ ᎤᏁᏌᏴᏟ ᎤᏙᏢᏒ ᎤᏠᏯᏍᏗ ᎣᏍᏓ ᎠᏓᏃᎯᏎᎯ, ᎠᎴᏃ ᎠᏍᏚᏓ 4G ᎾᎿᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Note:\u00a0Color inversion also turns dark screens light.">
                <langSet xml:lang="en-US"><tig><term>Note:\u00a0Color inversion also turns dark screens light.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏖ\u00a0ᎠᏑᏫᏓ ᎠᏨᏍᏔᏅᎩ ᎠlᏐ tᎤrnᏍ Ꮣrk ᏍcrᎡᎡnᏍ Ꮅght.</term></tig></langSet>
            </termEntry>
            <termEntry id="Caribbean">
                <langSet xml:lang="en-US"><tig><term>Caribbean</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏯᏆᏗᏂᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dim screen beyond your tablet\u2019s minimum brightness">
                <langSet xml:lang="en-US"><tig><term>Dim screen beyond your tablet\u2019s minimum brightness</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᎪᎸᏓ ᎠᏰᏙᎳᏛᎢ ᏫᏗᏗᏢ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ\u2019s ᏭᏍᏗᎬᎢ ᎤᏍᎪᏍᏗᏴ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make your screen dimmer so it\u2019s more comfortable to read.">
                <langSet xml:lang="en-US"><tig><term>Make your screen dimmer so it\u2019s more comfortable to read.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎹkᎡ ᏲᎤr ᏍcrᎡᎡn ᏓrkᎡr Ꮠ Ꭲt'Ꮝ ᎼrᎡ cᎣmfᎣrᏔbᎴ tᎣ rᎡᎠd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show Google App">
                <langSet xml:lang="en-US"><tig><term>Show Google App</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎫᎦᎵ ᎬᎰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This can be helpful when:\u00a0Your tablet\u2019s default minimum brightness is still too bright">
                <langSet xml:lang="en-US"><tig><term>This can be helpful when:\u00a0Your tablet\u2019s default minimum brightness is still too bright</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎯᏍ cᎠn bᎡ ᎮlpfᎤl wᎮn\u00a0ᏲᎤr ᏔbᎴt'Ꮝ ᏕfᎠᎤlt ᎻᏂᎽm brᎢghtᏁᏍᏍ ᎢᏍ ᏍᏘll tᎣᎣ brᎢght</term></tig></langSet>
            </termEntry>
            <termEntry id="Caption window color">
                <langSet xml:lang="en-US"><tig><term>Caption window color</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏬᏂᏍᎬ ᏦᎳᏂ ᎠᏑᏫᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Never">
                <langSet xml:lang="en-US"><tig><term>Never</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Since this app is not set to optimize battery, you can\u2019t restrict it.">
                <langSet xml:lang="en-US"><tig><term>Since this app is not set to optimize battery, you can\u2019t restrict it.</term></tig></langSet>
