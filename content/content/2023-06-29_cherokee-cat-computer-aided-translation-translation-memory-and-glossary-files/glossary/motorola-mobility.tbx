            </termEntry>
            <termEntry id="Turn off Bluetooth when you aren\u2019t using it">
                <langSet xml:lang="en-US"><tig><term>Turn off Bluetooth when you aren\u2019t using it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎤrn Ꭳff BᎷᎡtᎣᎣth wᎮn ᏲᎤ ᎠrᎡn't ᎤᏏng Ꭲt</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery use is an approximation of power use and does not include every source of battery drain.">
                <langSet xml:lang="en-US"><tig><term>Battery use is an approximation of power use and does not include every source of battery drain.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>BᎠtᏖry ᎤᏎ ᎢᏍ Ꭰn ᎠpprᎣxᎢᎹᏘᎣn Ꭳf pᎣᏪr ᎤᏎ Ꭰnd ᏙᎡᏍ Ꮓt ᎢncᎷᏕ ᎡᎥᎡry ᏐᎤrcᎡ Ꭳf bᎠtᏖry drᎠᎢn.</term></tig></langSet>
            </termEntry>
            <termEntry id="Miscellaneous is the difference between the computed approximate power use and the actual drain observed on the battery.">
                <langSet xml:lang="en-US"><tig><term>Miscellaneous is the difference between the computed approximate power use and the actual drain observed on the battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎻᏍcᎡlᎳᏁᎣᎤᏍ ᎢᏍ tᎮ ᏗffᎡrᎡncᎡ bᎡtᏪᎡn tᎮ cᎣmpᎤᏖd ᎠpprᎣxᎢᎹᏖ pᎣᏪr ᎤᏎ Ꭰnd tᎮ ᎠctᎤᎠl drᎠᎢn ᎣbᏎrᎥᎡd Ꭳn tᎮ bᎠtᏖry.</term></tig></langSet>
            </termEntry>
            <termEntry id="Used for ^1">
