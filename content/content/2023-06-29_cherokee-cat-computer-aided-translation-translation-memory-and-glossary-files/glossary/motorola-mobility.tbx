            <termEntry id="Limit battery for apps that you don\u2019t use often">
                <langSet xml:lang="en-US"><tig><term>Limit battery for apps that you don\u2019t use often</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎯ ᎠᎾᎦᎵᏍᎩ ᏗᎬᏙᏗ ᏂᎯ ᏞᏍᏗᎬᏔᏂᏓᏍᏗ ᎢᏳᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Any changes you make to your accounts on the web will be automatically copied to your tablet.Some accounts may also automatically copy any changes you make on the tablet to the web. A Google Account works this way.">
                <langSet xml:lang="en-US"><tig><term>Any changes you make to your accounts on the web will be automatically copied to your tablet.Some accounts may also automatically copy any changes you make on the tablet to the web. A Google Account works this way.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏂᎥᏉ ᏗᎦᏁᏟᏴᏓ ᏂᎯ ᎪᏢᏗ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏥᎩ ᎤᏂᎳᏛᎢ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏓᏟᎶᏍᏔᏅᎯ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ.ᎢᎦᏓ ᏗᏚᏓᎸᏙᏗ ᏰᎵᏉ ᎾᏍᏊ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏗᏟᎶᏍᏔᏅᎯ ᎾᏂᎥᏉ ᏗᎦᏁᏟᏴᏓ ᏂᎯ ᎪᏢᏗ ᎤᎾᎢ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎾᎿᎢ ᏥᎩ ᎤᏂᎳᏛᎢ. Ꭰ Google ᎠᏚᏓᎸᏗ ᏚᎸᏫᏍᏓᏁᎲ ᎯᎠ ᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To save battery, stop  from using battery in the background. This app may not work properly and notifications may be delayed.">
                <langSet xml:lang="en-US"><tig><term>To save battery, stop  from using battery in the background. This app may not work properly and notifications may be delayed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎭᎵᏏᏅᏓ ᎠᎾᎦᎵᏍᎩ, ᎭᎴᏫᏍᏓ  ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏜ ᏄᏍᏗᏓᏅ. ᎯᎠ ᏗᎬᏙᏗ ᏰᎵᏊ Ꮭ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᏙᎳᏤᎩ ᎠᎴ ᏗᎾᏓᏃᏣᎳᏁᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏬᎯᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set backup password">
                <langSet xml:lang="en-US"><tig><term>Set backup password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏡᎬ ᎤᏠᏱ ᎪᏢᏅᏗ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edit VPN profile">
