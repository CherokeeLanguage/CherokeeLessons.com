            </termEntry>
            <termEntry id="Lenovo">
                <langSet xml:lang="en-US"><tig><term>Lenovo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎴᏃᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure your phone and PC are connected to the same network.">
                <langSet xml:lang="en-US"><tig><term>Make sure your phone and PC are connected to the same network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ PC ᎨᏒᎢ ᎫᏓᎸᏅᎯ ᎾᏍᎩ ᎤᏠᏯ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RSA is a Windows application that diagnoses and resolves issues on your phone.">
                <langSet xml:lang="en-US"><tig><term>RSA is a Windows application that diagnoses and resolves issues on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RSA ᏄᏍᏛ ᎾᏍᎩ Windows ᎠᏔᏲᏍᏙᏗ ᎾᏍᎩᎾᎢ ᏚᏂᏩᏛᎥᎩ ᎠᎴ ᏗᎪᎷᏩᏛᏗ ᏓᏓᎵᎬ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
