                <langSet xml:lang="en-US"><tig><term>When the screen is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿ ᎤᎾᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Put your finger on the sensor and lift after you feel a vibration.">
                <langSet xml:lang="en-US"><tig><term>Put your finger on the sensor and lift after you feel a vibration.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎲᎦ ᏂᏨᏅᎢ ᎦᏰᏌᏛ ᎤᎾᎢ ᎠᏩᏘᏍᎩ ᎠᏌᎳᏙᏗ ᎪᎯᏴᎢ ᏂᎯ ᎠᏒᎾᏍᏗ ᎠᎵᏖᎸᏗ.</term></tig></langSet>
