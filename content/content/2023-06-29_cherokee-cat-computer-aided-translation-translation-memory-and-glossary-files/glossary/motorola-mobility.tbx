                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎳᎨ ᎠᏴᏙᎳᏛᎢ ᎤᏍᎪᏍᏗᏴ ᎠᎴ/ᎠᎴᏃ ᎠᏴᏙᎳᏛᎢ ᎠᏲᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile packets received">
                <langSet xml:lang="en-US"><tig><term>Mobile packets received</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏇᏅᎯ ᏓᏥᏁᎸᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your apps are using a normal amount of battery. If apps use too much battery, your device will suggest actions you can take.You can always turn on Battery Saver if you\u2019re running low on battery.">
                <langSet xml:lang="en-US"><tig><term>Your apps are using a normal amount of battery. If apps use too much battery, your device will suggest actions you can take.You can always turn on Battery Saver if you\u2019re running low on battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎢ ᏗᎬᏙᏗ ᎨᏒᎢ ᎬᏗᎭᎠ ᏱᎬᏩᏍᏗᏭ ᎢᎦᎢ ᎾᎿ ᎠᎾᎦᎵᏍᎩ. ᎢᏳᏃ ᏗᎬᏙᏗ ᎬᏙᏗ ᏧᏍᏈᏯ ᎠᎾᎦᎵᏍᎩ, ᏂᏨᏅᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᎢ ᎧᏁᎢᏍᏙᏗ ᎾᎾᏛᏁᎲᎢ ᏂᎯ ᏰᎵᏊ ᎯᏫᏓ.ᏂᎯ ᏰᎵᏊ ᏂᎪᎯᎸᎢ ᎯᏍᏚᎢ ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎢᏳᏃ ᏂᎯ ᎠᏂᎩᏍᏓ ᎡᎳᏗ ᎤᎾᎢ ᎠᎾᎦᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow apps and services to scan for nearby devices at any time, even when Bluetooth is off. This can be used, for example, to improve location-based features and services.">
                <langSet xml:lang="en-US"><tig><term>Allow apps and services to scan for nearby devices at any time, even when Bluetooth is off. This can be used, for example, to improve location-based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏗᎬᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏰᎵᏯ ᏙᎢ ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᎤᎬᏩᏟ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ, ᎥᏍᏊ ᎢᏳᏃ Bluetooth ᏄᏍᏛ ᎠᏍᏚᎭ. ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏟᎶᏍᏔᎾ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone idle">
                <langSet xml:lang="en-US"><tig><term>Phone idle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎳᏃᎮᏗ ᎪᎱᏍᏗ ᎾᏛᏁᎲᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 background for past 24 hr">
                <langSet xml:lang="en-US"><tig><term>^1 background for past 24 hr</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎾᏍᎩᎾ ᎨᏎᎢ 24 hr</term></tig></langSet>
            </termEntry>
            <termEntry id="Sync for this item is currently disabled. To change this setting, temporarily turn on background data and automatic sync.">
                <langSet xml:lang="en-US"><tig><term>Sync for this item is currently disabled. To change this setting, temporarily turn on background data and automatic sync.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏗᎢ ᎢᏧᎳᎭ ᏱᏗᎬᏁᎸᎢ ᏗᎬᏩᎸᏫᏍᏓᏁᏗ ᏂᎨᏒ ᏃᏊᎨᏒᎢ. ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᏕᎦᎧᎲᎢ, ᏞᎩᏊ ᎯᏍᏚᎢ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎠᎴ ᎤᏩᏌ ᏱᎬᏁᎯ ᎢᏧᎳᎭ ᏱᏗᎬᏁᎸᎢ.</term></tig></langSet>
            </termEntry>
