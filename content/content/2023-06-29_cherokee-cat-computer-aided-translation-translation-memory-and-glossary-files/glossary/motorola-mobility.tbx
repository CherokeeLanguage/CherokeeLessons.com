            </termEntry>
            <termEntry id="Audio effects has been updated with a refreshed visual design.">
                <langSet xml:lang="en-US"><tig><term>Audio effects has been updated with a refreshed visual design.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎾᏍᎩ ᎪᏢᎯᏌᏅᎯ ᎠᏠᏯᏍᏗ ᎠᏤᎲᏍᏔᏅᎩ ᎪᏢᏔᏅᎯ ᎠᎪᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Locate the sensor on the power key on the side of your device.">
                <langSet xml:lang="en-US"><tig><term>Locate the sensor on the power key on the side of your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏩᏛᏗ ᎠᏩᏘᏍᎩ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ ᎤᎾᎢ ᎠᏍᏆᎨᏂ ᎥᎿᎢ ᏂᏨᏅᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Home Fax">
                <langSet xml:lang="en-US"><tig><term>Home Fax</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏪᏅᏒ ᎪᏪᎵ ᏗᏟᎶᏍᏔᏅ ᏫᎦᏅᏅᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="NFC Notifications">
                <langSet xml:lang="en-US"><tig><term>NFC Notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>NFC ᏗᎾᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disabling Network Name Broadcast will prevent automatic connection to hidden networks.">
                <langSet xml:lang="en-US"><tig><term>Disabling Network Name Broadcast will prevent automatic connection to hidden networks.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ ᎤᏚᏓᎵ ᏚᏙᎥᎢ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᎠᏎ ᎠᏲᏍᏙᏗᏍᎩ ᎤᏩᏌ ᏱᎬᏁᎯ ᎫᏓᎸᎢ ᎾᎢ ᎬᏍᎦᎸ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You\’ll need to touch several times to record your fingerprint.">
                <langSet xml:lang="en-US"><tig><term>You\’ll need to touch several times to record your fingerprint.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏊᏃ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏒᏂᏍᏗ ᎢᎸᏍᎩ ᎢᏳᏩᏗ ᎾᎿᎢ ᏕᎦᏅᏅᏛᎢ ᏂᏨᏅᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch gently to avoid pressing the power key.">
