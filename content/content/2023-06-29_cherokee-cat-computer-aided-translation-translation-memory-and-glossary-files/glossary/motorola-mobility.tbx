            <termEntry id="Insert the SIM card into the tray. Then, insert the tray with the metal contacts facing the screen.">
                <langSet xml:lang="en-US"><tig><term>Insert the SIM card into the tray. Then, insert the tray with the metal contacts facing the screen.</term></tig></langSet>
