            <termEntry id="What is a Billing Password?">
                <langSet xml:lang="en-US"><tig><term>What is a Billing Password?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎤᏍᏗ ᎨᎡᎢ Ꭰ ᎤᏓᏚᏍᎬᎢ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="We need to deactivate your old phone before we can activate your new phone.">
                <langSet xml:lang="en-US"><tig><term>We need to deactivate your old phone before we can activate your new phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎴᏫᏍᏙᏔᏅᏱ ᏂᏨᎤᎢ ᎠᎦᏴᎵ ᏗᏟᏃᎮᏗ ᎠᏏᏅ ᎠᏴ ᏰᎵᏯ ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ ᏗᏤ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Remember to turn off your old phone.">
                <langSet xml:lang="en-US"><tig><term>Remember to turn off your old phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏅᏓᏛ ᎾᎿᎢ ᎠᏍᏚᏗ ᏂᏨᎤᎢ ᎠᎦᏴᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Activating your phone...">
                <langSet xml:lang="en-US"><tig><term>Activating your phone...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᎳᏗᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ...</term></tig></langSet>
            </termEntry>
            <termEntry id=" Don't turn it off">
                <langSet xml:lang="en-US"><tig><term> Don't turn it off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏞᏍᏗ ᎭᎦᏔᎲᎾ ᎨᎡᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Preparing to Activate Your Phone">
                <langSet xml:lang="en-US"><tig><term>Preparing to Activate Your Phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏗᏍᎬ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Before you activate this phone:\t1.\tBack up your contacts from your old phone.\t2.\tTurn off your old phone.">
                <langSet xml:lang="en-US"><tig><term>Before you activate this phone:\t1.\tBack up your contacts from your old phone.\t2.\tTurn off your old phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏏᏅ ᏂᎯ ᎤᏂᎩᏍᏗᏍᎩ ᎯᎠ ᏗᏟᏃᎮᏗ:\t1.\tᎠᏍᏆᏂᎪᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᎠᎦᏴᎵ ᏗᏟᏃᎮᏗ.\t2.\tᎠᏍᏚᏗ ᏂᏨᎤᎢ ᎠᎦᏴᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This entry does not match our records.">
                <langSet xml:lang="en-US"><tig><term>This entry does not match our records.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎥᎧᏁᏉᎢᏍᏙᏗ ᎥᏝ ᏗᏙᎵᎩ ᎣᎦᏤᎵ ᏗᎪᏪᎳᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you tap Activate Now, we will:\t1.\tDeactivate your old phone.\t2.\tTransfer your old phone number to this phone.\t3.\tActivate this phone.">
                <langSet xml:lang="en-US"><tig><term>When you tap Activate Now, we will:\t1.\tDeactivate your old phone.\t2.\tTransfer your old phone number to this phone.\t3.\tActivate this phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᏂᎩᏍᏗᏍᎩ Ꭷ, ᎠᏴ ᎠᏎ:\t1.\tᎠᎴᏫᏍᏙᏔᏅᏱ ᏂᏨᎤᎢ ᎠᎦᏴᎵ ᏗᏟᏃᎮᏗ.\t2.\tᏗᎲᏍᏗᏱ ᏂᏨᎤᎢ ᎠᎦᏴᎵ ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ ᎾᎿᎢ ᎯᎠ ᏗᏟᏃᎮᏗ.\t3.\tᎤᏂᎩᏍᏗᏍᎩ ᎯᎠ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="AOL">
                <langSet xml:lang="en-US"><tig><term>AOL</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>AOL</term></tig></langSet>
            </termEntry>
            <termEntry id="\@outlook.com">
                <langSet xml:lang="en-US"><tig><term>\@outlook.com</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>\@outlook.com</term></tig></langSet>
            </termEntry>
            <termEntry id="Outlook.com">
                <langSet xml:lang="en-US"><tig><term>Outlook.com</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Outlook.com</term></tig></langSet>
            </termEntry>
            <termEntry id="Done with Email">
                <langSet xml:lang="en-US"><tig><term>Done with Email</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏗᏍᏗ ᎬᏗ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Will never turn on automatically">
                <langSet xml:lang="en-US"><tig><term>Will never turn on automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᎠᏎ ᎢᎸᎯᏳᎢ ᎯᏛᏍᏚᎢᏍᏏ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="A network connection is required to continue with setup.">
                <langSet xml:lang="en-US"><tig><term>A network connection is required to continue with setup.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎤᏚᏓᎵ ᎫᏓᎸᎢ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᏂᎦᏯᎢᏎᏍᏗ ᎬᏗ ᎦᎧᎲᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please connect to a Wi-Fi network.">
                <langSet xml:lang="en-US"><tig><term>Please connect to a Wi-Fi network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap an email to set it up">
                <langSet xml:lang="en-US"><tig><term>Tap an email to set it up</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᎾᎢ ᎦᎧᎲᎢ ᎾᏍᎩ ᏗᎦᎪᏗᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait, this may take a few minutes.">
                <langSet xml:lang="en-US"><tig><term>Please wait, this may take a few minutes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ, ᎯᎠ ᏰᎵᏯ ᎯᏫᏓ Ꭰ ᎢᎸᏍᎩᏉ ᎢᏯᏔᏬᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen expired">
                <langSet xml:lang="en-US"><tig><term>Screen expired</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᏙᎳᏛᎢ ᎪᏪᎵ ᎤᎶᏒᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Exit Activation">
                <langSet xml:lang="en-US"><tig><term>Exit Activation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎪᎢᏍᏗ ᎠᎴᏅᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait while we skip setup.">
                <langSet xml:lang="en-US"><tig><term>Please wait while we skip setup.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ ᎾᎯᏳᎢ ᎠᏴ ᎭᏓᎾᏫᏓ ᎦᎧᎲᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restart phone">
                <langSet xml:lang="en-US"><tig><term>Restart phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎭᏂᎩᏍᏓ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Back to Activation">
                <langSet xml:lang="en-US"><tig><term>Back to Activation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ ᎾᎿᎢ ᎠᎴᏅᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can always finish the wizard later by going to Apps &gt; Setup Wizard.">
                <langSet xml:lang="en-US"><tig><term>You can always finish the wizard later by going to Apps &gt; Setup Wizard.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏂᎪᎯᎸᎢ ᎯᏍᏆᏓ ᏥᎩ ᎠᏓᏍᏕᎵᏍᎩ ᎣᏂᏯᎨᏍᏗ ᎬᏗ ᏓᏰᏏ ᎾᎿᎢ ᏗᎬᏙᏗ &gt; Setup Wizard.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone number is:">
                <langSet xml:lang="en-US"><tig><term>Your phone number is:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ ᎨᎡᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Other Providers">
                <langSet xml:lang="en-US"><tig><term>Other Providers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏐᎢ ᏓᎾᏓᏁᏢᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="How to Activate Your Phone">
                <langSet xml:lang="en-US"><tig><term>How to Activate Your Phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎳᎪ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="No Network Connection">
                <langSet xml:lang="en-US"><tig><term>No Network Connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏧᎾᏚᏓᎵ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone is now active.">
                <langSet xml:lang="en-US"><tig><term>Your phone is now active.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ Ꭷ ᎬᏂᎦᎵᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="1-888-944-9400">
                <langSet xml:lang="en-US"><tig><term>1-888-944-9400</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>1-888-944-9400</term></tig></langSet>
            </termEntry>
            <termEntry id="Back to Wi-Fi">
                <langSet xml:lang="en-US"><tig><term>Back to Wi-Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏗ ᎾᎿᎢ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Please note, the activation will take a few minutes.">
                <langSet xml:lang="en-US"><tig><term>Please note, the activation will take a few minutes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏍᏆᎳ ᎧᏃᎮᏗ, ᏥᎩ ᎠᎴᏅᏙᏗ ᎠᏎ ᎯᏫᏓ Ꭰ ᎦᏲᎵ ᎢᏯᏔᏬᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone Activation">
                <langSet xml:lang="en-US"><tig><term>Phone Activation</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᎴᏅᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Billing Password">
                <langSet xml:lang="en-US"><tig><term>Billing Password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏚᏍᎬᎢ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the Gmail app to add your account.">
                <langSet xml:lang="en-US"><tig><term>Use the Gmail app to add your account.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᏥᎩ Gmail ᎬᏙᏗ ᎾᎿᎢ ᏗᎧᏁᏉᏍᏗ ᏂᏨᎤᎢ ᎠᏚᏓᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Transferring Phone Number">
                <langSet xml:lang="en-US"><tig><term>Transferring Phone Number</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎲᏍᏗᏱ ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" clock preview">
                <langSet xml:lang="en-US"><tig><term> clock preview</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎦᎾᏁᏍᎩ ᎠᏓᎪᏩᏛᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You will be able to setup your Gmail account in a later step.">
                <langSet xml:lang="en-US"><tig><term>You will be able to setup your Gmail account in a later step.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᏎ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ ᏂᏨᎤᎢ Gmail ᎠᏚᏓᎸᏗ ᎾᎿ Ꭰ ᎪᎯᏴᎢ ᎠᎳᏏᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The network you're connecting to requires you to sign in first.">
                <langSet xml:lang="en-US"><tig><term>The network you're connecting to requires you to sign in first.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏧᎾᏚᏓᎵ ᏂᎯ ᎨᎡᎩ ᏓᎾᎵᎪᏗᏍᎬ ᎾᎿᎢ ᎠᏎᏳᎾᏛᏁᏗ ᏂᎯ ᎾᎿᎢ ᏕᏣᏙᎥ ᎰᏪᎸᎦ ᎠᎬᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This will just take a minute… ">
                <langSet xml:lang="en-US"><tig><term>This will just take a minute… </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏯᏔᏬᏍᏔᏅ ᎯᎠ ᎠᏎᎢ ᎠᎦᏍᎩ… </term></tig></langSet>
            </termEntry>
            <termEntry id="Moto couldn't improve device performance because usage access is revoked.">
                <langSet xml:lang="en-US"><tig><term>Moto couldn't improve device performance because usage access is revoked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎤᏄᎸᏅᎢ ᎪᏢᎯᏐᏗ ᏥᏂᎬᏅᏗᏓᎾ ᏧᎸᏫᏍᏓᏁᎯ ᎦᎵᏍᏙᏗᎬ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ. ᎬᏗᏍᎩ ᎠᏴᏍᏗ ᏄᏍᏛ ᎤᏩᏎᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="View Verizon Account">
                <langSet xml:lang="en-US"><tig><term>View Verizon Account</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ Verizon ᎠᏚᏓᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait while we get your phone ready to set up.">
                <langSet xml:lang="en-US"><tig><term>Please wait while we get your phone ready to set up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ ᎾᎯᏳᎢ ᎠᏴ ᎠᎩᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Its a password created by the Account Owner to use for account access instead of the last 4 digits of the Social Security Number.">
                <langSet xml:lang="en-US"><tig><term>Its a password created by the Account Owner to use for account access instead of the last 4 digits of the Social Security Number.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ Ꭰ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎪᏢᏅᎢ ᎬᏗ ᏥᎩ ᎠᏚᏓᎸᏗ ᎤᏤᎵᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎤᎬᏩᏟ ᎠᏚᏓᎸᏗ ᏩᏴᏍᏗᎢ ᎤᎬᏫᏳᏎᏍᏗ ᎾᎿ ᏥᎩ ᎣᏂ 4 ᎠᏎᏍᏗ ᎾᎿ ᏥᎩ ᎠᏰᎵ ᎤᏙᏢᎯ ᏗᏎᏍᏗ ᏗᎦᏁᏍᏗ ᎠᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: It is not the same as your My Verizon password.">
                <langSet xml:lang="en-US"><tig><term>Note: It is not the same as your My Verizon password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏆᎳ ᎧᏃᎮᏗ: ᎨᎡᎢ ᎥᏝ ᏥᎩ ᎤᏠᏱ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏯ Verizon ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Skip Anyway">
                <langSet xml:lang="en-US"><tig><term>Skip Anyway</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎾᏫᏓ ᎾᏂᎥᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps info">
                <langSet xml:lang="en-US"><tig><term>Apps info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎠᏓᏃᎯᏎᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, that Wi-Fi network is not connected to the Internet right now.">
                <langSet xml:lang="en-US"><tig><term>Sorry, that Wi-Fi network is not connected to the Internet right now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎤᏰᎸᏅ, ᎥᏍᎩᎾ Wi-Fi ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎥᏝ ᎫᏓᎸᏅᎯ ᎾᎿᎢ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎠᎦᏘᏏ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try a different network or leave setup.">
                <langSet xml:lang="en-US"><tig><term>Please try a different network or leave setup.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏣᏁᎸᏙᏗ Ꭰ ᏧᏓᎴᎿᎢ ᏧᎾᏚᏓᎵ ᎠᎴ ᎠᏓᏅᏍᏗ ᎦᎧᎲᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Network Sign-in">
