            </termEntry>
            <termEntry id="Custom tools">
                <langSet xml:lang="en-US"><tig><term>Custom tools</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛ ᎢᏯᏛᏁᏗ ᏗᎬᏔᏂᏓᏍᏗ</term></tig></langSet>
            </termEntry>
