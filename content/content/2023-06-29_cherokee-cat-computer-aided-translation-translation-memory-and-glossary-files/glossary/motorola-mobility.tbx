            <termEntry id="Optimize brightness level for available light.">
                <langSet xml:lang="en-US"><tig><term>Optimize brightness level for available light.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᎧᎵᎢᏴ ᎤᏍᎪᏍᏗᏴ ᎤᏩᎾᏕᏍᎩ ᎤᎬᏩᏟ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏨᏍᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn off edge display anytime you don't want apps to show on the edges.">
                <langSet xml:lang="en-US"><tig><term>You can turn off edge display anytime you don't want apps to show on the edges.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏉ  ᏱᏍᏚᎲᎦ ᎠᏍᏛᏔ ᎠᏓᏴᎳᏛᏍᎩ ᏂᎦᎵᏍᏗᏊᏴ ᏂᏣᏚᎵᏍᏴᎾ ᏱᎩ ᏗᎬᏙᏗ ᎠᎪᏩᏛᏙᏗ ᎥᎿᎢ ᏓᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera access is required for screen attention.">
                <langSet xml:lang="en-US"><tig><term>Camera access is required for screen attention.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏟᎶᏍᏗᏍᎩ ᎠᏴᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎤᎬᏩᏟ ᎠᏴᏙᎳᏛᎢ ᎭᎧᏎᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="It works on device, and images are never stored or sent to Google.">
                <langSet xml:lang="en-US"><tig><term>It works on device, and images are never stored or sent to Google.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏚᎸᏫᏍᏓᏁᎲ ᎤᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᎴ ᏚᏓᏴᎳᏛ ᎨᎡᎩ ᏞᏍᏗ ᎢᎸᎯᏳᎢ ᎠᏍᏆᏂᎪᏔᏅ ᎠᎴ ᏭᏅᏅᎢ ᎾᎿᎢ Google.</term></tig></langSet>
            </termEntry>
            <termEntry id="MTP or PTP function is active">
                <langSet xml:lang="en-US"><tig><term>MTP or PTP function is active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>MTP ᎠᎴ PTP ᏧᎸᏫᏍᏓᏁᏗᏱ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="clean, storage">
                <langSet xml:lang="en-US"><tig><term>clean, storage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏓᏅᎦᎸᏛ, ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen attention uses the front camera to see if someone is looking at the screen.">
                <langSet xml:lang="en-US"><tig><term>Screen attention uses the front camera to see if someone is looking at the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏙᎳᏛᎢ ᎭᎧᏎᏍᏓ ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎢᎬᏱᏗᏢ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᎨᎡᎢ ᎩᎶᎢ ᎨᎡᎢ ᎠᎦᏘᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Ditch the small screen and enjoy your favorite video apps on your TV or display.">
                <langSet xml:lang="en-US"><tig><term>Ditch the small screen and enjoy your favorite video apps on your TV or display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏲᎯᏍᏗ Ꮎ ᎤᏍᏗᎢ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴ ᎤᎵᎮᏍᏗ ᏂᏣᏤᎵ ᏩᎩᎸᏉᏛᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏗᎬᏙᏗ  ᎥᎾ ᏂᏣᏤᎵ TV ᎠᎴ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep screen on when looking at it">
                <langSet xml:lang="en-US"><tig><term>Keep screen on when looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᎠᏴᏙᎳᏛᎢ ᎤᎿᎢ ᎢᏳᏃ ᎠᎦᏖᏃᎲ ᎤᎿᎢ ᎨᎡᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tritanomaly">
                <langSet xml:lang="en-US"><tig><term>Tritanomaly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ ᎠᎪᏩᏘᏍᎩ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to manage permissions for Device Personalization Services">
                <langSet xml:lang="en-US"><tig><term>Tap to manage permissions for Device Personalization Services</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᎬᏩᏟ ᏥᏂᎬᏅᏗᏓᎾ ᎮᎵᏒᏊ ᏅᎦ ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera access is required for Face Detection.">
                <langSet xml:lang="en-US"><tig><term>Camera access is required for Face Detection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏟᎶᏍᏗᏍᎩ ᎠᏴᏍᏗ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎤᎬᏩᏟ ᎧᏁᏉᏍᏗᏍᎬ ᏚᎾᏄᎪᏫᏍᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Night Light not currently on">
                <langSet xml:lang="en-US"><tig><term>Night Light not currently on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏒᏃᏱ ᎠᏨᏍᏛ ᎥᏝ ᏃᏊ ᏥᎩ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dark theme schedules begin when your screen is off.">
                <langSet xml:lang="en-US"><tig><term>Dark theme schedules begin when your screen is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏏᎩ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᏓᏒᏍᏛᎢ ᎠᏓᎴᏂᏍᎬ ᎢᏳᏃ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᎨᎡᎢ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto HDR on">
                <langSet xml:lang="en-US"><tig><term>Auto HDR on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ ᎠᎾᎩᏍᎩ HDR ᎠᏍᏚᎢᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="You can switch to a different experience by tapping on the floating bubble on your phone.">
                <langSet xml:lang="en-US"><tig><term>You can switch to a different experience by tapping on the floating bubble on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎦᏁᏟᏴᏍᏗ ᎾᎿᎢ Ꭰ ᏧᏓᎴᎿᎢ ᎠᎦᏙᎲᏒᎢ ᎬᏗ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿ ᏥᎩ ᎠᏟᏲᎷᎲᏍᎦ ᏓᎵᏆᎷᎲᏍᎬ ᎾᎿ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="While you’re watching, you can continue using your phone without stopping the video.">
                <langSet xml:lang="en-US"><tig><term>While you’re watching, you can continue using your phone without stopping the video.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏣᎦᏙᏍᏛᎢ, ᏂᎯ ᏰᎵᏉ ᏂᎦᏯᎢᏒ ᎲᏍᏗᏍᎬ ᏗᏟᏃᎮᏗ ᏄᏠᏯᏍᏛᎾ ᎠᎴᏫᏍᏗ Ꮎ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To control what happens when the phone is docked and/or sleeping, turn screen saver on.">
                <langSet xml:lang="en-US"><tig><term>To control what happens when the phone is docked and/or sleeping, turn screen saver on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᎫᎪᏔᏂᏓᏍᏗ ᎦᏙ ᏂᏚᎵᏍᏔᏅ ᎢᏳᏃ ᏥᎩ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎠᏝᏅᏗᏱ ᎠᎴ/ᎠᎴ ᎦᏟᏔᏗᏍᎩ, ᎯᏍᏚᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎵᏏᏅᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You\u0027re using  for mobile data.">
                <langSet xml:lang="en-US"><tig><term>You\u0027re using  for mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎬᏗᎭ  ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap and hold the volume up key to go to the next track, and tap and hold the volume down key to go to the previous track.">
                <langSet xml:lang="en-US"><tig><term>Tap and hold the volume up key to go to the next track, and tap and hold the volume down key to go to the previous track.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᎴ ᏣᏂᏴᏎᏍᏗ ᎢᎦᎢ ᎤᏃᏴᎬ ᎦᎸᎳᏗ ᎠᏐᎥᏍᏙᏗ ᎾᎢ ᎡᏅᏍᏗ ᎾᎢ ᏐᎢ ᎪᎷᏅᏍᏗ, ᎠᎴ ᎭᏐᎥᏍᏓ ᎠᎴ ᏣᏂᏴᏎᏍᏗ ᎾᏍᎩ ᎢᎦᎢ ᎤᏃᏴᎬ ᎡᎳᏗ ᎠᏐᏅᏍᏙᏗ ᎾᎢ ᎡᎾᏍᏗ ᎾᎢ ᏧᏩᎫᏔᏅ ᎪᎷᏅᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you switch to ,  will no longer be used for mobile data.">
                <langSet xml:lang="en-US"><tig><term>If you switch to ,  will no longer be used for mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ ,  ᎠᏎ Ꮭ ᎦᏅᎯᏓᎨ ᎨᎡᎢ ᎬᏔᏅᎯ ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Status of the battery, network, and other information">
                <langSet xml:lang="en-US"><tig><term>Status of the battery, network, and other information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎨᎡᎢ ᏥᎩ ᎠᎾᎦᎵᏍᎩ, ᏧᎾᏚᏓᎵ, ᎠᎴ ᏐᎢ ᎧᏃᎮᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="MDN on SIM">
                <langSet xml:lang="en-US"><tig><term>MDN on SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>MDN ᎤᎿᎢ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone number on SIM">
                <langSet xml:lang="en-US"><tig><term>Phone number on SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ ᎤᎿᎢ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Both Wi\u2011Fi and Bluetooth scanning are on">
                <langSet xml:lang="en-US"><tig><term>Both Wi\u2011Fi and Bluetooth scanning are on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᏃ Wi\u2011Fi ᎠᎴ Bluetooth ᎠᎾᎦᎵᏍᎩ ᎬᏗ ᏗᏟᎶᏍᏗᏍᎩ ᎨᎡᎩ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi scanning is on, Bluetooth scanning is off">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi scanning is on, Bluetooth scanning is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᎠᎾᎦᎵᏍᎩ ᎬᏗ ᏗᏟᎶᏍᏗᏍᎩ ᎨᎡᎢ ᎤᎿᎢ, Bluetooth ᎠᎾᎦᎵᏍᎩ ᎬᏗ ᏗᏟᎶᏍᏗᏍᎩ ᎨᎡᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your tablet and personal data are more vulnerable to attack by unknown apps. By installing apps from this source, you agree that you are responsible for any damage to your tablet or loss of data that may result from their use.">
                <langSet xml:lang="en-US"><tig><term>Your tablet and personal data are more vulnerable to attack by unknown apps. By installing apps from this source, you agree that you are responsible for any damage to your tablet or loss of data that may result from their use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎪᏪᎶᏗᎢ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏒᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᎾᎦᎳᎢ ᏗᎦᏘᎴᎩ ᏄᏩᏅ ᎬᎪᏟᏍᏗ ᏂᎦᏒᎾ ᏗᎬᏙᏗ. ᎬᏗ ᎦᏘᏅᏛᏍᎦ ᏗᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᏧᏓᎴᏅᎲᎢ, ᏕᎭᏓᏁᎸᎩ ᎥᏍᎩᎾ ᏂᎯ ᎨᎡᎩ ᎤᎾᏚᏓᎸ ᎤᎬᏩᏟ ᎾᏂᎥᏉ ᎤᏲᏨᎯ ᎾᎿᎢ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᏃᎴ ᎤᏲᎲᏎᎸ ᎾᎿ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᎩᎾ ᏰᎵᏯ ᏄᎵᏍᏔᏅ ᏅᏓᏳᏓᎴᏅᎯ ᎤᎾᏤᎵ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Cinemagraph mode lets you create artistic photos in motion.">
                <langSet xml:lang="en-US"><tig><term>Cinemagraph mode lets you create artistic photos in motion.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏆᎳ ᎠᏓᏴᎳᏛᏍᎩ ᏣᎦᏟᎶᏍᏔᏅ  ᎬᏙᏗ ᎠᎵᏍᎪᎸᏗᏍᎪ ᏂᎯ ᎪᏢᏗ ᏗᏟᎶᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏓᏅᏏᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Take a short video, highlight the area you want to keep in motion, and share an animated GIF with friends.">
                <langSet xml:lang="en-US"><tig><term>Take a short video, highlight the area you want to keep in motion, and share an animated GIF with friends.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎩ ᏍᏆᎳ ᎠᏓᏴᎳᏛᏍᎩ,  ᎬᏂᎨᏒ ᏱᎬᏁᏗ Ꮎ ᎤᎿᎢ ᏣᏚᎵᏍᎬ Ꭲ ᏣᎬᎵᏗᎩ ᎠᏓᏅᏏᏙᎯ, ᎠᎴ  ᎠᏯᏙᏢ ᎬᏃᏓᏳᏍᏗ GIF ᎬᏗ ᏦᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about autoclick (dwell timing)">
                <langSet xml:lang="en-US"><tig><term>Learn more about autoclick (dwell timing)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏗᎢ ᎢᎸᏨ ᎤᏩᏌ ᎭᏐᎥᏍᏓ (ᎭᏐᎥᏍᏓ ᎾᏳᎢᏳᎵᏍᏙᏗ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Unmount the internal USB storage">
                <langSet xml:lang="en-US"><tig><term>Unmount the internal USB storage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎤᏌᎯᎸ ᏥᎩ ᎭᏫᏂ USB ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Never miss a moment you want to capture.">
                <langSet xml:lang="en-US"><tig><term>Never miss a moment you want to capture.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎢᎸᎯᏳᎢ ᎦᏅᏗᏍᏗ ᎾᏍᎩ ᎢᎦᎵᏍᏔᏅᏍᎬᎢ ᏂᎯ ᏣᏚᎵᏍᎬ ᎦᏂᏴᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Just say “Ok Google” to make calls, get the weather, and more.">
                <langSet xml:lang="en-US"><tig><term>Just say “Ok Google” to make calls, get the weather, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᏋ ᏂᏫ “ᎭᏩ Google” ᎾᎢ ᏫᎨᎯᏴᏓᏏ, ᎠᎩᏍᏗ ᎾᏍᏗ ᏙᏱᏗᏜ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Insert an SD card for mounting">
                <langSet xml:lang="en-US"><tig><term>Insert an SD card for mounting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏣᎸᏗ Ꭰ SD ᏆᎾᏲᏍᏗ ᎤᎬᏩᏟ ᎤᏌᎯᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="When the flip is closed, the Google Assistant only supports voice interactions.">
                <langSet xml:lang="en-US"><tig><term>When the flip is closed, the Google Assistant only supports voice interactions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>}ᎾᎯᏳ ᎾᏍᎩ ᏗᏁᏍᏆᏕᎦ ᎾᏍᎩ ᎠᏍᏚᎭ, ᎾᏍᎩ Google ᎠᎵᏍᏕᎵᏍᎩ ᎤᏩᏌ ᎤᏩᏚᏍᏓᎢ ᎧᏁᎬᎢ ᏓᏔᎳᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again later.">
                <langSet xml:lang="en-US"><tig><term>Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="USB storage will be unmounted.">
                <langSet xml:lang="en-US"><tig><term>USB storage will be unmounted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USB ᎠᏍᏆᏂᎪᏙᏗ ᎠᏎ ᎨᎡᎢ ᎥᏝ ᎤᏌᎯᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open the flip for the full Google Assistant experience.">
                <langSet xml:lang="en-US"><tig><term>Open the flip for the full Google Assistant experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎾᏍᎩ ᏗᏁᏍᏆᏕᎦ ᎾᏍᎩᎾ ᎾᏍᎩ ᎧᎵ Google ᎠᎵᏍᏕᎵᏍᎩ ᎤᎦᏙᎲᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When the screen is unlocked, open the camera by swiping right on the external display home screen.">
                <langSet xml:lang="en-US"><tig><term>When the screen is unlocked, open the camera by swiping right on the external display home screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᏍᎩ ᎦᏐᎭᎾᎳᏕᏗ, ᎯᏍᏚᎢ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎾᏍᎩᏃ ᎦᏅᎦᎵᏗᏍᎬ ᎤᎾᎢ ᎦᏚᎢ ᎾᏍᎩ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏧᏪᏅᏒᎢ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Then, either tap on the screen or press the volume up or down key to capture.">
                <langSet xml:lang="en-US"><tig><term>Then, either tap on the screen or press the volume up or down key to capture.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏉᏃ, ᎢᏳᏃ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎴᏃ ᎠᏐᎥᏍᏙᏗ ᎾᏍᎩ ᎢᎦᎢ ᎤᏃᏴᎬ ᎦᎸᎳᏗ ᎠᎴᏃ ᎡᎳᏗ ᎠᏐᎥᏍᏙᏗ ᎾᎢ ᎦᏂᏴᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you receive a call, you can send a quick text reply on the external display.">
                <langSet xml:lang="en-US"><tig><term>When you receive a call, you can send a quick text reply on the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᏘᎩᏏ ᏗᎬᎩᏍᎩ ᎾᏍᎩ ᎠᏅᏗᏍᎩ, ᏂᎯ ᏰᎵᏊ ᎤᏟᏍᏓ ᏫᏅᎥᎦ ᎪᏪᎳᏅᎢ ᎦᏬᎯᎵᏴᏓ ᎤᎾᎢ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unmount SD card?">
                <langSet xml:lang="en-US"><tig><term>Unmount SD card?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎤᏌᎯᎸ SD ᏆᎾᏲᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also tap on the external display during calls to see additional options.">
                <langSet xml:lang="en-US"><tig><term>You can also tap on the external display during calls to see additional options.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏃ ᎾᏍᏊ ᏯᏐᎥᏍᏗ ᎤᎾᎢ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎾᎯᏳᎢ ᏫᏛᎬᏗᏍᎬᎢ ᎾᎢ ᎠᎪᏩᏛᏗ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏗᏑᏰᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t unmount USB storage.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t unmount USB storage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎥᏝ ᎤᏌᎯᎸ USB ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Storage space is running out">
                <langSet xml:lang="en-US"><tig><term>Storage space is running out</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗ ᎤᏜᏅᏛ ᏕᏣᎵᏒᏁᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Super Slow Motion captures video at 960fps to show the details of explosive moments like balloons popping, objects breaking, or water splashing.">
                <langSet xml:lang="en-US"><tig><term>Super Slow Motion captures video at 960fps to show the details of explosive moments like balloons popping, objects breaking, or water splashing.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎬᏫᎶᏒᎩ ᎤᏍᎦᏃᎳ ᎠᏓᏅᏏᏙᎯ ᏗᎦᏂᏴᏗ ᎠᏓᏴᎳᏛᏍᎩ ᎤᎿᎢ 960fps ᎾᎢ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᏍᎩ ᏂᏕᎬᎿᏅᎢ ᎠᏔᏍᎩᏍᏗ ᏂᏕᎦᎵᏍᏗᏍᎬᎢ ᎾᏍᎩᏯᎢ ᎤᏃᎴ ᏗᏲᏚᏗ ᏗᎵᏌᎳᏗᏍᎩ  ᏓᏔᏍᎩᏍᎬᎢ, ᏧᏓᎴᏅᏓ ᏓᏲᏍᏗᏍᎬᎢ, ᎠᎴᏃ ᎠᎹ ᎠᏍᏓᏁᏅᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Some system functions, such as syncing, may not work correctly.">
                <langSet xml:lang="en-US"><tig><term>Some system functions, such as syncing, may not work correctly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏄᏍᏗᏓᏅᎢ ᏧᎸᏫᏍᏓᏁᏗᏱ, ᏕᎧᏁᎢᏍᏔᏅᎯ ᎢᏧᎳᎭ ᏥᏂᎦᎵᏍᏗᏍᎬᎢ, ᏰᎵᏯ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏚᏳᎪᏛᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose wallpaper">
                <langSet xml:lang="en-US"><tig><term>Choose wallpaper</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎧᏑᎧᏡ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Google Assistant helps you find answers and get things done with just your voice.">
                <langSet xml:lang="en-US"><tig><term>The Google Assistant helps you find answers and get things done with just your voice.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ Google ᎠᎵᏍᏕᎵᏍᎩ ᏂᎯ ᎠᏩᏛᏗ ᏗᎦᏬᎯᎵᏴᏍᏓ ᎠᎴ ᏧᏓᎴᏅᏓ ᎠᏍᎪᏗᏍᏗ ᎤᏠᏯᏍᏗ ᏍᎩᏋ ᎯᏁᎬ ᎤᏃᏴᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Format as internal">
                <langSet xml:lang="en-US"><tig><term>Format as internal</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎬᏁᏗ ᎾᎿ ᎭᏫᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="USB computer connection">
                <langSet xml:lang="en-US"><tig><term>USB computer connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>USB ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Media device (MTP)">
                <langSet xml:lang="en-US"><tig><term>Media device (MTP)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ (MTP)</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect as">
                <langSet xml:lang="en-US"><tig><term>Connect as</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎾᎿ</term></tig></langSet>
            </termEntry>
            <termEntry id="Search radio stations">
                <langSet xml:lang="en-US"><tig><term>Search radio stations</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᏍᏗ ᎦᏬᏂᏍᎩ ᏧᎴᏫᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Something's not right. Reconnecting to server…">
                <langSet xml:lang="en-US"><tig><term>Something's not right. Reconnecting to server…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎱᏍᏗᏍᎩᏂ ᎭᏗ ᏚᏳᎪᏛ ᏱᎩ. ᏙᎫᏓᎸᎲᏍᎩ ᎾᎢ ᎠᏯᏙᎯᎯ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for data connection to resume downloading">
                <langSet xml:lang="en-US"><tig><term>Waiting for data connection to resume downloading</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏗᏍᏗ ᎾᏍᎩᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᏂᎦᏯᎯᏒᏊ ᏥᎭᎴᎾ ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To change the order of the tiles, open quick settings on the internal display and tap on the pencil icon.">
                <langSet xml:lang="en-US"><tig><term>To change the order of the tiles, open quick settings on the internal display and tap on the pencil icon.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᎠᏓᏅᏒᎯ ᎾᏍᎩ ᏓᏲᏓᎾ, ᎯᏍᏚᎢ ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ ᎤᎾᎢ ᎾᏍᎩ ᎭᏫᏂ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎠᎴ ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᏗᎪᏪᎶᏗ ᎠᎢᎧᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Lets you transfer media files on Windows, or using Android File Transfer on Mac (see www.android.com/filetransfer)">
                <langSet xml:lang="en-US"><tig><term>Lets you transfer media files on Windows, or using Android File Transfer on Mac (see www.android.com/filetransfer)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏂᎩ ᏂᎯ ᏙᏓᏰᏣᏲᎯᏎᎵ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎤᎿᎢ Windows, ᎠᎴ ᎬᏗᎭ Android DᏍᏆᏂᎪᏙᏗ ᏙᏓᏰᏣᏲᎯᏎᎵ ᎤᎿᎢ Mac (ᎠᎪᏩᏛᏗ www.android.com/filetransfer)</term></tig></langSet>
            </termEntry>
            <termEntry id="Some apps may not work well in desktop mode, and some may not let you play content on a secondary display.">
                <langSet xml:lang="en-US"><tig><term>Some apps may not work well in desktop mode, and some may not let you play content on a secondary display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᎬᏙᏗ ᏰᎵᏊ Ꮭ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎠᎹᏢᏗᎢ ᎾᎿ ᎦᏍᎩᎶᎩ ᎦᏚ ᎪᏢᏗ, ᎠᎴ ᎢᎦᏓ ᏰᎵᏉ ᎥᏝ ᎤᏁᎳᎩ ᏂᎯ ᏔᏁᎶᎲᎦ ᏄᏍᏗᏓᏅ ᎾᎿ Ꭰ ᎢᎬᏱᏗᏢ ᎠᏓᏴᎳᏛᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Get quick shortcuts by tapping &amp; swiping on the power key.">
                <langSet xml:lang="en-US"><tig><term>Get quick shortcuts by tapping &amp; swiping on the power key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᎤᏟᏍᏓ ᏍᏆᎳ ᎢᏗᎬᏁᎯ ᎬᏗ ᎭᏐᎥᏍᏗᏍᎬᎢ &amp; ᎦᏅᎦᎵᏗᏍᎬ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏐᏅᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from the bottom of the screen with 2 fingers.To switch between features, swipe up with 2 fingers and hold.">
                <langSet xml:lang="en-US"><tig><term>Swipe up from the bottom of the screen with 2 fingers.To switch between features, swipe up with 2 fingers and hold.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎡᎳᏗᏢ ᎠᏂ ᎠᏴᏙᎳᏛᎢ Ꮻth 2 ᏕᎦᏰᏌᏛ.ᎾᎿᎢ ᎦᏁᏟᏴᏍᏗ ᎠᏰᏟ ᏗᎦᏎᏍᏙᏗ, ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎬᏗ 2 ᏕᎦᏰᏌᏛ ᎠᎴ ᏣᏂᏴᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Explore Accessibility settings">
                <langSet xml:lang="en-US"><tig><term>Explore Accessibility settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏅᏓ ᎬᏴᏍᏗ ᎨᏒ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="It's easy to find the people you contact most.">
                <langSet xml:lang="en-US"><tig><term>It's easy to find the people you contact most.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᎠᎯᏓ ᎠᏩᏛᏗ ᎾᏍᎩ ᎠᏂᏴᏫ ᏕᎭᏟᏃᎮᏙᏗᏍᎬ ᎤᎪᏗᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Just open the Phone app, tap on Favorites, and see the people you talk to frequently.">
                <langSet xml:lang="en-US"><tig><term>Just open the Phone app, tap on Favorites, and see the people you talk to frequently.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᏋ ᎯᏍᏚᎢ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᎬᏙᏗ, ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᏗᏑᏰᏛ, ᎠᎴ ᎯᎪᏩᏔ ᎾᏍᎩ ᎠᏂᏴᏫ ᏂᎯ ᏕᎭᎵᏃᎮᏗᏍᎬ ᏂᎪᎯᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also manually add contacts to this list.">
                <langSet xml:lang="en-US"><tig><term>You can also manually add contacts to this list.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏉ ᎣᏩᏌ ᎠᏍᏕᎸᏗ ᎠᏂᎩᏍᏙᏗ ᎧᏁᏉᏍᏗ ᏗᏟᏃᎮᏙᏗ ᎯᎠ ᏕᎦᏅᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Navigation settings">
                <langSet xml:lang="en-US"><tig><term>Navigation settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏘᏂᏙᎯ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Lets MIDI enabled applications work over USB with MIDI software on your computer.">
                <langSet xml:lang="en-US"><tig><term>Lets MIDI enabled applications work over USB with MIDI software on your computer.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏂᎩ MIDI ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᏗᎬᏙᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏴᏛ USB ᎬᏗ MIDI ᎦᎾᏗᏅᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᎦᏙᎥᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" is mounted">
                <langSet xml:lang="en-US"><tig><term> is mounted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᎡᎢ ᎤᏌᎯᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Features, functions, and supported languages may vary by country.">
                <langSet xml:lang="en-US"><tig><term>Features, functions, and supported languages may vary by country.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏎᏍᏙᏗ, ᏚᎸᏫᏍᏓᏁᎰᎢ, ᎠᎴ ᎦᎫᏍᏛᏅᎢ ᎦᏬᏂᎯᏍᏗ ᏰᎵᏉ ᏧᏓᎴᎾᎢ ᎤᎬᏩᎵ ᎠᏰᎵ ᎤᏙᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can unlock your Razr by pressing on the fingerprint sensor or swiping up on the external display to enter a pin or pattern.">
                <langSet xml:lang="en-US"><tig><term>You can unlock your Razr by pressing on the fingerprint sensor or swiping up on the external display to enter a pin or pattern.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏐᎭᎾᎳᎩ ᏣᏤᎵ Razr ᎬᏗ ᎠᏐᎥᏍᏗᏍᎩ ᎾᎿᎢ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎠᎴᏃ ᎦᏅᎦᎵᏗᏍᎬ ᎦᎸᎳᏗ ᎤᎾᎢ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁd ᎾᎢ ᎠᏴᏍᏗ ᎾᏍᎩ ᎦᎭᏓ ᎠᎴᏃ ᏗᏟᎶᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Razr locks if it’s not used for a period of time.">
                <langSet xml:lang="en-US"><tig><term>Your Razr locks if it’s not used for a period of time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ Razr ᏍᏓᏯ ᏓᏍᏚᎭ ᎢᏳᏃ ᎾᏍᎩ ᎥᏝ ᎬᏔᏅᎯ ᎾᏍᎩᎾ ᎢᎪᎯᏛ ᎠᏟᎢᎵᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" wants to connect to this phone.You haven\u2019t connected to  before.">
                <langSet xml:lang="en-US"><tig><term> wants to connect to this phone.You haven\u2019t connected to  before.</term></tig></langSet>
