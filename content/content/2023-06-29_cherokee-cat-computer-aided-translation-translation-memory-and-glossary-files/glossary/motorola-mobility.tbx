            </termEntry>
            <termEntry id="Choose an equalizer preset to enhance the overall sound">
                <langSet xml:lang="en-US"><tig><term>Choose an equalizer preset to enhance the overall sound</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᎢᏗᎦᏘᎭ ᎢᎬᏁᏗ ᎦᎧᎲᏍᏗ ᎾᎿᎢ ᏓᏤᎴᏍᏗ ᏥᎩ ᏂᎦᎥᏉᏃ ᎦᏃᏴᎵᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="CES Init Foreground Service">
                <langSet xml:lang="en-US"><tig><term>CES Init Foreground Service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CES Init ᎠᎬᏱᏗᏨ ᎾᏛᏁᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please connect to a Wi-Fi network or check your data connection.">
                <langSet xml:lang="en-US"><tig><term>Please connect to a Wi-Fi network or check your data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᎤᏚᏓᎵ ᏃᎴ ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎱᏓᎸᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Talk to Me, you must give Moto permission to access your location. Select &quot;Permissions&quot; in App info to grant permission.Select &quot;allow all the time&quot; for the best.">
                <langSet xml:lang="en-US"><tig><term>To use Talk to Me, you must give Moto permission to access your location. Select "Permissions" in App info to grant permission.Select "allow all the time" for the best.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ Talk to Me, ᏂᎯ ᎠᏎ Moto ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᏩᏴᏍᏗᎢ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ. ᎯᏑᏰᎦ "ᎠᎵᏍᎪᎵᏗᏍᎩ" ᏗᎬᏙᏗ ᎣᏃᎮᏎᏱ ᎭᎵᏍᎪᎸᏓ ᎯᏑᏰᎦ "ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ" ᎤᎬᏩᏟ ᏥᎩ ᏫᏓᏤᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To collect usage data, Moto needs permission to access your:">
                <langSet xml:lang="en-US"><tig><term>To collect usage data, Moto needs permission to access your:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᏟᏌᏅᎩ ᎬᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ, Moto ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᏩᏴᏍᏗᎢ ᏂᏨᎤᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Help improve Moto's Ai experiences by allowing the collection of your usage data.">
                <langSet xml:lang="en-US"><tig><term>Help improve Moto's Ai experiences by allowing the collection of your usage data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏕᎸᏓ ᏦᎦᏤᎳᏍᏙᏗ Moto's Ai ᎤᏂᎦᏙᎲᏒ ᎬᏗ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏥᎩ ᎤᏂᏟᏌᏅ ᎾᎿ ᏂᏨᎤᎢ ᎬᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Usage data collection">
                <langSet xml:lang="en-US"><tig><term>Usage data collection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎦᏟᏌᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap \“Allow\” or \“Allow all the time\” on the following screens to grant permissions.">
                <langSet xml:lang="en-US"><tig><term>Tap \“Allow\” or \“Allow all the time\” on the following screens to grant permissions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ \“ᎠᎵᏍᎪᎸᏗᏍᎬ\” ᏃᎴ \“ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ\” ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Normal data rates may apply during automatic system check.">
                <langSet xml:lang="en-US"><tig><term>Normal data rates may apply during automatic system check.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎬᏩᏍᏗᏭ ᎦᏘᏍᎩᏌᏅᎯ ᏗᎪᏣᎴᏒᏛ ᏰᎵᏯ ᏱᏂᎦᎵᏍᏓ ᎾᎯᏳ ᎤᏩᏌ ᏱᎬᏁᎯ ᏄᏍᏗᏓᏅᎢ ᎪᏪᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone will no longer automatically check for updates. Regular checking is strongly recommended for optimal performance.">
                <langSet xml:lang="en-US"><tig><term>Phone will no longer automatically check for updates. Regular checking is strongly recommended for optimal performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎠᏎ ᎭᏗ ᎦᏅᎯᏓᎨ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎪᏪᎶᏗ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏐᏗ. ᎤᏐᏱᎭᏊ ᎠᎪᎵᏰᎠ ᎨᎡᎢ ᎤᎳᏂᎩᏗᏳ ᎦᎸᏉᏔᏅ ᎤᎬᏩᏟ ᏫᏓᏤᏢᎢ ᎾᎾᏛᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for data connection to resume downloading">
                <langSet xml:lang="en-US"><tig><term>Waiting for data connection to resume downloading</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏗᏍᏗ ᎾᏍᎩᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᏂᎦᏯᎯᏒᏊ ᏥᎭᎴᎾ ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for a data connection to resume background download and installation…">
                <langSet xml:lang="en-US"><tig><term>Waiting for a data connection to resume background download and installation…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏯ ᎤᎬᏩᏟ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎾᎿᎢ ᎠᎴᏂᏐᏗᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏃᎴ ᎦᏘᏅᏛᏍᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you don't restart by , your device will automatically restart at a time when it's least used.">
                <langSet xml:lang="en-US"><tig><term>If you don't restart by , your device will automatically restart at a time when it's least used.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᏝᏍᏗ ᏥᎭᏂᎩᏍᏓ ᎬᏗ , ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ ᎢᏳᏃ ᎨᎡᎢ ᎤᏍᏗᎧᏂ ᎬᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to clear  of space before updating. Try deleting unused apps or moving photos &amp; videos to another storage device.">
                <langSet xml:lang="en-US"><tig><term>You need to clear  of space before updating. Try deleting unused apps or moving photos &amp; videos to another storage device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎯᎵᎦᎵᏯ  ᎾᎿ ᎤᏜᏅᏛ ᎠᏏᏅ ᎠᏤᎲᏍᏗᏍᎬ. ᏣᏁᎸᏙᏗ ᎠᏍᎪᎸᏗᏍᏗ ᎬᏔᏅᏂᎨᏒᎾ ᏗᎬᏙᏗ ᏃᎴ ᏩᎲᏍᎩ ᏗᏥᎶᏍᏔᏅᎯ &amp; ᏗᏓᏴᎳᏛᏍᎩ ᎾᎿᎢ ᏄᏓᎴ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't install now as the call is in progress">
                <langSet xml:lang="en-US"><tig><term>The device can't install now as the call is in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏘᏅᎦ Ꭷ ᎤᎿᎢ ᏥᎩ ᏪᏯᎾ ᎨᎡᎢ ᎾᎿ ᎠᎵᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Using Wi-Fi is recommended. Downloading with mobile data or using mobile data while roaming may result in additional charges.Downloading this software won't impact the operation of your device.">
                <langSet xml:lang="en-US"><tig><term>Using Wi-Fi is recommended. Downloading with mobile data or using mobile data while roaming may result in additional charges.Downloading this software won't impact the operation of your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᎭ Wi-Fi ᎨᎡᎢ ᎦᎸᏉᏔᏅ. ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ ᎬᏗ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏃᎴ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎯᏳᎢ ᎡᏙᎵᏙᎲ ᏰᎵᏯ ᏄᎵᏍᏔᏅ ᎾᎿ ᏗᎧᏁᏉᏍᏙᏔᏅ ᏓᎬᏩᎶᏗᏍᎬ.ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ ᎯᎠ ᎦᎾᏗᏅᏗ ᏝᏍᏗ ᏓᏓᏛᏅᏍᏗᏍᎬ ᏥᎩ ᎠᎢᏒᎢ ᎾᎿ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Something's not right. Reconnecting to server…">
                <langSet xml:lang="en-US"><tig><term>Something's not right. Reconnecting to server…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎱᏍᏗᏍᎩᏂ ᎭᏗ ᏚᏳᎪᏛ ᏱᎩ. ᏙᎫᏓᎸᎲᏍᎩ ᎾᎢ ᎠᏯᏙᎯᎯ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Just one more step">
                <langSet xml:lang="en-US"><tig><term>Just one more step</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏚᏳᎪᏛᏉ ᏌᏇ ᎤᏥ ᎢᎦᎢ ᎠᎳᏏᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Get bug fixes &amp; more">
                <langSet xml:lang="en-US"><tig><term>Get bug fixes &amp; more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ &amp; ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose a restart time">
                <langSet xml:lang="en-US"><tig><term>Choose a restart time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ Ꭰ ᏥᎭᏂᎩᏍᏓ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device could be prone to security risks. Execute the below command for continued updatesadb enable-verity">
                <langSet xml:lang="en-US"><tig><term>Your device could be prone to security risks. Execute the below command for continued updatesadb enable-verity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏯ ᎨᎡᎢ ᎠᏞᏴᏍᏙᏗ ᎾᎿᎢ ᏧᎾᎦᏎᏍᏗ ᏗᎦᎾᏰᎩ. ᎠᎴᏅᏗᏱ ᏥᎩ ᎡᎳᏗᏨ ᎤᏁᏤᎸᎩ ᎤᎬᏩᏟ ᎤᎵᏱᎸᏛ ᏗᎪᏢᎯᏐᏗadb ᎡᎵᏊ ᏱᎬᏛᏁᏗ-ᎤᏙᎯᏳᎯᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="The device can't install now as the navigation is on">
                <langSet xml:lang="en-US"><tig><term>The device can't install now as the navigation is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏘᏅᎦ Ꭷ ᎤᎿᎢ ᏥᎩ ᎠᏱᎴᎩ ᎨᎡᎢ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose an install time">
                <langSet xml:lang="en-US"><tig><term>Choose an install time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ Ꭰ ᎯᏘᏅᎦ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi and mobile data">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi and mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏃᎴ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: For your safety, all critical updates will download and install automatically whether this feature is on or off.">
                <langSet xml:lang="en-US"><tig><term>Note: For your safety, all critical updates will download and install automatically whether this feature is on or off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ: ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᎤᎾᏓᎵᏏᏅᏙᏗ, ᏂᎦᏓ ᎤᏢᏲᎵᏍᏗ ᏗᎪᏢᎯᏐᏗ ᎠᏎ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏃᎴ ᎯᏘᏅᎦ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎢᏳᏃ ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᎨᎡᎢ ᎤᎿᎢ ᏃᎴ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Updates are downloaded and installed automatically">
                <langSet xml:lang="en-US"><tig><term>Updates are downloaded and installed automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏢᎯᏐᏗ ᎨᎡᎩ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏃᎴ ᎦᏘᏅᏔᏅ ᎤᏩᏌᏊ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Download will continue on mobile data. Data charges may be applicable.">
                <langSet xml:lang="en-US"><tig><term>Download will continue on mobile data. Data charges may be applicable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏎ ᎠᎯᎸᏍᏗ ᎾᎿᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ. ᎦᏘᏍᎩᏌᏅᎯ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎨᎡᎢ ᏗᏓᏂᎸᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep your device safe and secure with automatic updates">
                <langSet xml:lang="en-US"><tig><term>Keep your device safe and secure with automatic updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏙᏗᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᎦᎾᏰᎬᎾ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎬᏗ ᎤᏩᏌ ᏱᎬᏁᎯ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for Wi-Fi to resume background download and installation…">
                <langSet xml:lang="en-US"><tig><term>Waiting for Wi-Fi to resume background download and installation…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏯ ᎤᎬᏩᏟ Ꭰ Wi-Fi ᎾᎿᎢ ᎠᎴᏂᏐᏗᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏃᎴ ᎦᏘᏅᏛᏍᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Installation should take about  minutes. You won't be able to use your device until it completes.">
                <langSet xml:lang="en-US"><tig><term>Installation should take about  minutes. You won't be able to use your device until it completes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏅᏛᏍᏗ ᎾᎢᏳᏃ ᎯᏫᏓ ᎢᎸᏨ  ᎢᏯᏔᏬᏍᏔᏅᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎩᎳ ᎨᎡᎢ ᎠᏍᏆᏛᏃᏅ.</term></tig></langSet>
            </termEntry>
