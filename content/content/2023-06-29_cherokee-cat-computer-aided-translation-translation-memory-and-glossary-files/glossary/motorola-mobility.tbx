                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿᎢ ᎠᏍᏚᏗ ᏥᎩ ᎠᏨᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Attentive display shows a notification when it detects that you're looking at the screen">
                <langSet xml:lang="en-US"><tig><term>Attentive display shows a notification when it detects that you're looking at the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎠᎩᏍᏗ ᎦᏣᏄᎳ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎬᏗ ᏥᎩ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿ ᏂᏨᎤᎢ ᏕᎦᏰᏌᏛ</term></tig></langSet>
