                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎴᏃᏉ ID ᎬᏔᏅᎯ ᎾᎢ ᏱᏧᎳᎭ ᏂᎦᎵᏍᏗᏍᎬ ᏣᏤᎵ ᎧᏃᎸᎥᏍᎩ ᏗᎦᎾᏗᏫᏍᏒᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You cannot log in two Lenovo accounts at the same time.">
