                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎬᏙᏗᎢ ᎤᎬᏩᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery used by the flashlight">
                <langSet xml:lang="en-US"><tig><term>Battery used by the flashlight</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏗ ᎬᏔᏅᎯ ᎬᏗ ᎠᏨᏍᏗ</term></tig></langSet>
            </termEntry>
