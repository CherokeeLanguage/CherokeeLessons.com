                <langSet xml:lang="chr"><tig><term>MicroCell ᎠᏱᏍᏗ ᎨᎡᎢ ᎥᏝ ᎠᎵᏍᎪᎸᏔᏅ ᎠᏏᏉ ᎡᏙᎵᏙᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose your theme">
                <langSet xml:lang="en-US"><tig><term>Choose your theme</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᎢᏳᏍᏗ ᎧᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Late Autumn">
                <langSet xml:lang="en-US"><tig><term>Late Autumn</term></tig></langSet>
