            </termEntry>
            <termEntry id="Activate your phone on another network">
                <langSet xml:lang="en-US"><tig><term>Activate your phone on another network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ ᏗᎳᏃᎮᏗ ᎤᏂ ᏄᏓᎴ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="To check your notifications, swipe down on the fingerprint sensor on the side of your phone.">
                <langSet xml:lang="en-US"><tig><term>To check your notifications, swipe down on the fingerprint sensor on the side of your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎪᏪᎶᏗ ᏂᏨᏅᎢ ᏗᎾᏓᏃᏣᎳᏁᎯ, ᎦᎶᎯᏍᏗᏍᎩ ᎡᎳᏗᏟ ᎤᎾᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎤᎾᎢ ᎠᏍᏆᎨᏂ ᎥᎿᎢ ᏂᏨᏅᎢ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't send. Recipient not valid.">
