                <langSet xml:lang="chr"><tig><term>ᏫᎢ-ᏈᎢ ᏥᏳᎪᏗ ᏗᎦᎴᏴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tell emergency services where you are">
                <langSet xml:lang="en-US"><tig><term>Tell emergency services where you are</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᎮᏗ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎭᏢᏃ ᏂᎯ ᎨᎡᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change this setting at any time by going to Settings &gt; Location &gt; Carrier Location Access.">
                <langSet xml:lang="en-US"><tig><term>You can change this setting at any time by going to Settings &gt; Location &gt; Carrier Location Access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏁᏟᏴᎾ ᏂᏕᎬᎾ ᏣᏚᎵᏍᎬᎢ ᏗᎪᏙᏗᎢ&gt;ᎮᏙᎲᎢ&gt;ᏣᏂᏙ ᎮᏙᎲ ᏩᏴᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your carrier may require location data to improve its services and analytics.">
                <langSet xml:lang="en-US"><tig><term>Your carrier may require location data to improve its services and analytics.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᏣᏂᏙ ᎤᏚᎵᎰ ᏯᏓᎲ ᎮᏙᎲ ᎦᏟᏌᏅ ᏓᏤᏢ ᎢᏳᎾᏓᏛᏁᏗᎢ ᎠᎴ ᏓᏤᏢ ᏗᎪᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once Mobile Hotspot is turned off, Wi-Fi will be enabled again.">
                <langSet xml:lang="en-US"><tig><term>Once Mobile Hotspot is turned off, Wi-Fi will be enabled again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊᏊ ᎠᏂᎩᏍᎩ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᏄᏍᏛ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏍᏚᎭ, Wi-Fi ᎠᏎ ᎨᎡᎩ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you turn off location sharing, your carrier won’t be able to access this data.">
                <langSet xml:lang="en-US"><tig><term>If you turn off location sharing, your carrier won’t be able to access this data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎲᏍᎨᏍᏗ ᎮᏙᎲ ᎧᏃᎮᏍᎩ, ᏣᏂᏙ Ꮭ ᎮᎵ ᎠᏴᏍᏗ Ꮎ ᎦᏟᏌᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="PollingLaunchManager">
                <langSet xml:lang="en-US"><tig><term>PollingLaunchManager</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎭᏂᎩᏍᏙᏗᏗᎫᎪᏔᏂᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="When location sharing is turned off, some carrier features may be unavailable.">
                <langSet xml:lang="en-US"><tig><term>When location sharing is turned off, some carrier features may be unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᏙᎲ ᎧᏃᎮᏍᎩ ᏍᏚᎢᏓ ᏂᎨᏒᎾ ᏱᎩ, ᎢᎦᏓ ᏣᏂᏙᎯ ᏄᏍᏗᏓᏅ Ꮭ ᎠᏛᏅᎢᏍᏔᎾ ᏱᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your carrier may still use location information for emergency services.">
                <langSet xml:lang="en-US"><tig><term>Your carrier may still use location information for emergency services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏂᏙ ᎲᎵᏊ ᏱᎦᏛ ᎮᏙᎲ ᎠᏓᏃᎯᏎ ᎤᏟᏍᏗ ᏴᏛᏅᏗ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow location sharing">
                <langSet xml:lang="en-US"><tig><term>Allow location sharing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎵᏍᎪᎸᏓ ᎮᏙᎲ ᎠᏓᏃᎯᏎᎢ</term></tig></langSet>
