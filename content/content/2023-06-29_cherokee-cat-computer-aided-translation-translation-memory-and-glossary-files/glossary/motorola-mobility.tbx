            </termEntry>
            <termEntry id="Automatic rule set to turn on Do Not Disturb during specified events">
                <langSet xml:lang="en-US"><tig><term>Automatic rule set to turn on Do Not Disturb during specified events</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᏗᎧᎾᏩᏛᏍᏙᏗ ᎦᎧᎲᎢ ᎾᎢ ᎠᏍᏚᎢᏓ ᎦᎧᎲᎢ ᎠᏍᏚᎢᏓ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᎯᏳ ᎠᏎᎸᏃ ᏓᏟᎢᎵᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data roaming">
                <langSet xml:lang="en-US"><tig><term>Data roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data warning and data limit are measured by your device. This may be different from carrier data.">
                <langSet xml:lang="en-US"><tig><term>Data warning and data limit are measured by your device. This may be different from carrier data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᏓᏕᏯᏔᎲᏍᎩ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ ᎨᎡᎩ ᎬᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᏰᎵᏯ ᎨᏒᎩ ᏧᏓᎴᎿᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏫᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This link is verified and automatically opens in this app.">
                <langSet xml:lang="en-US"><tig><term>This link is verified and automatically opens in this app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎫᏓᎸᎢ ᎾᏍᎩ ᎪᎯᏳᏔᏅᎢ ᏃᎴ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᏍᏚᎢᏍᎩ ᎾᎿᎢ ᎾᏍᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
