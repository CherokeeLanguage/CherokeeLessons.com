            </termEntry>
            <termEntry id="are typing…">
                <langSet xml:lang="en-US"><tig><term>are typing…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏒᎢ ᎢᏳᏍᏗᏃ…</term></tig></langSet>
            </termEntry>
            <termEntry id="As Advanced Messaging setting is turned off, you will not be able to send or receive messages in the conversations marked as disabled.">
                <langSet xml:lang="en-US"><tig><term>As Advanced Messaging setting is turned off, you will not be able to send or receive messages in the conversations marked as disabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏒᎢ Advanced Messaging ᏕᎦᎧᎲᎢ ᎨᏒᎢ ᎠᏍᏚᏅᎢ, ᏂᎯ ᎠᏎᎢ Ꮭ ᎨᏒᎩ ᏰᎵᏉ ᎾᎿᎢ ᏫᏅᎥᎦ ᎠᎴ ᎦᏁᏍᏗ ᎤᎾᏓᏡᎬᎢ ᏗᎪᎵᏰᏗ ᎾᎿ ᏥᎩ ᏓᎾᏟᏃᎮᏍᎬᎢ ᎪᏪᎳᏅᎯ ᎯᎢᎾᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sender canceled.">
                <langSet xml:lang="en-US"><tig><term>Sender canceled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎦᏅᏍᎩ ᎠᏎᏒᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Would you like to share device data with ?">
