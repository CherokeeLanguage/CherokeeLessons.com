                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎠᏑᏰᏓ ᎤᎾᏓᏧᎬᎢ MAC (ᎠᏓᏁᎵᏴᏍᏗᏍᎩ)</term></tig></langSet>
            </termEntry>
