            </termEntry>
            <termEntry id="Do you want to automatically turn data off when you’re connected to any known Wi-Fi network?">
                <langSet xml:lang="en-US"><tig><term>Do you want to automatically turn data off when you’re connected to any known Wi-Fi network?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᏍ ᎤᏩᏌᏊ ᎢᎬᏁᎯ ᎠᏍᏚᏗ ᎦᏟᏌᏅᎢ ᎾᎯᏳ ᎫᏓᎸᏅᎯ ᏂᎦᎵᏍᏗᎢ ᎠᎪᎵᏍᏙᏗ WiFi ᎫᎾᏚᏓᎵ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch on data when disconnected from any Wi-Fi Network">
                <langSet xml:lang="en-US"><tig><term>Switch on data when disconnected from any Wi-Fi Network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎠᏍᏚᎢᏍᏗ ᎦᏟᏌᏅᎢ ᎾᎯᏳ ᏱᎫᏓᎴᏌ ᏂᎦᎵᏍᏗᎢ Wi-Fi ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="By providing your CPF, you give Motorola permission to give you fast and specific help on your devices, as well as information about service centers and more.">
                <langSet xml:lang="en-US"><tig><term>By providing your CPF, you give Motorola permission to give you fast and specific help on your devices, as well as information about service centers and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏘᏁᎳ ᏂᎯ ᏣᏤᎵ CPF, ᎭᎵᏍᎪᏗ ᎼᏙᏙᎳ ᎤᏟᏍᏗ ᎠᎴ ᏚᏳᎬᏛ ᎠᏍᏕᎵᏗ ᏥᏂᎬᏅᏗᏓᏂ, ᎠᎴ ᏍᏊ ᎠᏓᏃᎯᏎᎯ ᎾᏅᏛᏁᎭ ᏚᏃᏢᏒ ᎠᎴ ᎤᏟ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remember, Motorola will always keep your data safe.">
                <langSet xml:lang="en-US"><tig><term>Remember, Motorola will always keep your data safe.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏅᏖᏍᏗ, ᎼᏙᏙᎳ ᏂᎪᎯᎸ ᎤᏂᏍᏆᏂᎪᏕᏍᏗ ᏣᏟᏌᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Require pattern?">
                <langSet xml:lang="en-US"><tig><term>Require pattern?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᏗᏟᎶᏍᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch to enable">
                <langSet xml:lang="en-US"><tig><term>Touch to enable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏒᎦ ᎡᎵᏇ ᎢᏳᎵᏍᏙᏗ</term></tig></langSet>
