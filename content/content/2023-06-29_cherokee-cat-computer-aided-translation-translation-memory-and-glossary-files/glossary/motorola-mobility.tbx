                <langSet xml:lang="chr"><tig><term>SIM  ᏏᎠᏅᏗᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To turn on Adaptive performance, Moto needs permission to access your app usage so it can learn your usage patterns.">
                <langSet xml:lang="en-US"><tig><term>To turn on Adaptive performance, Moto needs permission to access your app usage so it can learn your usage patterns.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏍᏚᎢᏓ ᎤᎾᎢ ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᏧᎸᏫᏍᏓᏁᎯ, ᎼᏙ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᏣᏤᎵ ᎬᏙᏗ ᎬᏗᏍᎩ ᎾᏍᎩ   ᏰᎵᏊ ᎠᏕᎶᏆᏍᏗ ᏣᏤᎵ ᎬᏗᏍᎩ ᏗᏟᎶᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Migrate data">
                <langSet xml:lang="en-US"><tig><term>Migrate data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏍᎪ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Restore changes">
                <langSet xml:lang="en-US"><tig><term>Restore changes</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᎯᏐᏗ ᏗᎦᏁᏟᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Current app version">
                <langSet xml:lang="en-US"><tig><term>Current app version</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏇᏥᎩ ᎬᏙᏗ ᏄᏓᎴᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Erases all data on the internal USB storage, such as music and photos">
                <langSet xml:lang="en-US"><tig><term>Erases all data on the internal USB storage, such as music and photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ ᏥᎩ ᎭᏫᏂ USB ᎠᏍᏆᏂᎪᏙᏗ, ᏕᎧᏁᎢᏍᏔᏅᎯ ᏗᎧᏃᎩᏙᏗ ᏃᎴ ᏗᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
