                <langSet xml:lang="chr"><tig><term>Ꭰ ᎤᏃᏢᏅᏗ ᎦᏟᏌᏅᎯ ᏥᎯᎧᎲᎦ ᎨᎡᎢ ᎢᏯᏛᏁᏗ to ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No hearing aids connected">
                <langSet xml:lang="en-US"><tig><term>No hearing aids connected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᎠᏛᎩᏍᏗ ᎠᏓᏍᏕᎵᏍᎩ ᏱᎫᏓᎸᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Password:">
                <langSet xml:lang="en-US"><tig><term>Password:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure you want to run Verizon store demo mode?">
                <langSet xml:lang="en-US"><tig><term>Are you sure you want to run Verizon store demo mode?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎩ ᏂᎯ ᎤᏙᎯᏳ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎠᏓᎾᏫᏍᏗ Verizon ᎠᏓᎾᏅ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎬᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Cloud Setup">
                <langSet xml:lang="en-US"><tig><term>Cloud Setup</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎩᎸ ᎦᎧᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To exit this mode, a factory data reset is required and all user information and files will be erased">
                <langSet xml:lang="en-US"><tig><term>To exit this mode, a factory data reset is required and all user information and files will be erased</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎬᏙᏗ, Ꭰ ᎤᏃᏢᏅᏗ ᎦᏟᏌᏅᎯ ᏥᎯᎧᎲᎦ ᎨᎡᎢ ᎢᏯᏛᏁᏗ ᎠᎴ ᏂᎦᏓ ᎬᏗᏍᎩ ᎧᏃᎮᏢᏗ ᎠᎴ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏎ ᎨᎡᎢ ᎤᏍᎪᎸᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Type the password">
                <langSet xml:lang="en-US"><tig><term>Type the password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᏥᎩ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The password you entered is not correct.">
                <langSet xml:lang="en-US"><tig><term>The password you entered is not correct.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᏂᎯ ᎠᏴᏍᏙᏗ ᎨᎡᎢ ᎥᏝ ᏚᏳᎪᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Only share internet via USB and Ethernet">
                <langSet xml:lang="en-US"><tig><term>Only share internet via USB and Ethernet</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᎠᏯᏙᏍᏗᎢ ᎠᏏᎳᏕᏫᏒᎢ ᎾᎿ ᎢᏗᏨ USB ᎠᎴ Ethernet</term></tig></langSet>
            </termEntry>
            <termEntry id="EAB Application">
                <langSet xml:lang="en-US"><tig><term>EAB Application</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>EAB ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Setup Wizard Warning">
                <langSet xml:lang="en-US"><tig><term>Setup Wizard Warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᏍᎬᎢ Wizard ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="with a message or a voice call.">
                <langSet xml:lang="en-US"><tig><term>with a message or a voice call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗ Ꭰ ᏗᎦᏃᏣᎳᏅᎯ ᎠᎴ Ꭰ ᎧᏁᎬ ᏫᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" can't receive video calls right now.">
                <langSet xml:lang="en-US"><tig><term> can't receive video calls right now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏝᏰᎵ ᎦᏁᏍᏗ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎠᎦᏘᏏ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Switching to voice call...">
                <langSet xml:lang="en-US"><tig><term>Switching to voice call...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᎢ ᎾᎿᎢ ᎤᏁᎬ ᏪᏯᎾ...</term></tig></langSet>
            </termEntry>
            <termEntry id="A Video call cannot be added at this time.">
                <langSet xml:lang="en-US"><tig><term>A Video call cannot be added at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ Ꮭ ᏰᎵ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᏊᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling and RTT keyboard cannot be on at the same time.">
                <langSet xml:lang="en-US"><tig><term>Video calling and RTT keyboard cannot be on at the same time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᎠᎴ RTT ᏗᏐᏅᏍᏙᏗ Ꮭ ᏰᎵ ᎠᏍᏚᎢᏓ ᎾᎿᎢ ᎾᏍᎩ ᎾᎯᏳᏉ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="RTT keyboard will be turned off.">
                <langSet xml:lang="en-US"><tig><term>RTT keyboard will be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>RTT ᏗᏐᏅᏍᏙᏗ ᎠᏎ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Video calling service on your account was turned off.">
                <langSet xml:lang="en-US"><tig><term>Your Video calling service on your account was turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᎤᎾᏓᏍᏕᎸᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏚᏓᎸᏗ ᎨᏎᎢ ᎤᎦᏔᎲᏒᏃ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please contact customer care to have the service turned on.">
                <langSet xml:lang="en-US"><tig><term>Please contact customer care to have the service turned on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᎤᏩᏍᎩ ᎠᏓᎦᏎᏍᏙᏗ ᎾᎿᎢ ᎤᎭ ᏥᎩ ᎤᎾᏓᏍᏕᎸᏗ ᎤᎦᏔᎲᏒᏃ ᎠᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off TTY">
                <langSet xml:lang="en-US"><tig><term>Turn off TTY</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ TTY</term></tig></langSet>
            </termEntry>
            <termEntry id="Connecting to your video call">
                <langSet xml:lang="en-US"><tig><term>Connecting to your video call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎾᎵᎪᏗᏍᎬ ᎾᎿᎢ ᏂᏨᎤᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="For a better Low Light AI experience, please update Moto Camera Content">
                <langSet xml:lang="en-US"><tig><term>For a better Low Light AI experience, please update Moto Camera Content</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾ ᏓᏤᏢ ᎡᎳᏗ ᎠᏨᏍᏗ ᎬᏴᏍᏗ ᏕᎦᏅᏛᎢ ᎠᎦᏙᎲᏒᎢ, ᎰᏩᏊ ᎪᏢᎯᏐᏗ Moto ᏗᏓᏥᎶᏍᏗᏍᎩ ᎦᎸᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can try to reach">
                <langSet xml:lang="en-US"><tig><term>You can try to reach</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏣᏁᎸᏙᏗ ᎾᎿᎢ ᎠᏙᏯᏅᎯᏗᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Advanced Calling is turned off.">
                <langSet xml:lang="en-US"><tig><term>Advanced Calling is turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛ ᎠᏱᎸᏛ ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Would you like to turn it back on?">
                <langSet xml:lang="en-US"><tig><term>Would you like to turn it back on?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏯᏓᎯᏗᏏ ᏂᎯ ᎤᎸᏉᏔᏅ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎨᎡᎢ ᎠᏨᏍᏗ ᎠᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Video calling">
                <langSet xml:lang="en-US"><tig><term>Turn on Video calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="TTY must be off to make video calls.">
                <langSet xml:lang="en-US"><tig><term>TTY must be off to make video calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TTY ᎠᏎ ᎠᏍᏚᎭ ᎾᎿᎢ ᎪᏢᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please contact your wireless service provider.">
                <langSet xml:lang="en-US"><tig><term>Please contact your wireless service provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏣᏤᎵ ᏂᏓᏏᎳᏛ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to turn off TTY?">
                <langSet xml:lang="en-US"><tig><term>Do you want to turn off TTY?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎠᏍᏚᏗ TTY?</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Data Usage that you set on your device has reached its limit.">
                <langSet xml:lang="en-US"><tig><term>Your Data Usage that you set on your device has reached its limit.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎦᏟᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎥᏍᎩᎾ ᏂᎯ ᎦᎧᎲᎢ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ ᏭᎷᏨᎩ ᎨᎡᎢ ᎠᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Video call requires data.">
                <langSet xml:lang="en-US"><tig><term>Your Video call requires data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎠᏎᏳᎾᏛᏁᏗ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.">
                <langSet xml:lang="en-US"><tig><term>To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎦᏎᏍᏔᏅ ᏂᏨᎤᎢ ᎦᏟᏌᏅᎯ ᎬᏗᏍᎬ, ᎡᏅᏍᏙᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ &gt;  ᏧᎾᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ &gt; ᎦᏟᏌᏅᎯ ᎬᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can try to add a voice call.">
                <langSet xml:lang="en-US"><tig><term>You can try to add a voice call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>You can ᏣᏁᎸᏙᏗ to ᏗᎧᏁᏉᏍᏗ a ᎧᏁᎬ ᏫᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling setting can not currently be modified.">
                <langSet xml:lang="en-US"><tig><term>Video calling setting can not currently be modified.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᏕᎦᎧᎲᎢ ᏰᎵᏯ ᎥᏝ ᏃᏊ ᏥᎩ ᎨᎡᎢ ᎦᏁᏟᏴᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When using the Verizon Wireless network, the voice portion of a video call will appear on your bill as mobile-to-mobile voice usage, and the video portion will be billed as data.">
                <langSet xml:lang="en-US"><tig><term>When using the Verizon Wireless network, the voice portion of a video call will appear on your bill as mobile-to-mobile voice usage, and the video portion will be billed as data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏗᎭ ᏥᎩ Verizon Wireless ᏧᎾᏚᏓᎵ, ᏥᎩ ᎧᏁᎬ ᎢᎦᏛ ᎾᎿ Ꭰ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎠᏎ ᎬᏂᎨᏒᎢ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏓᏚᎬᎢ ᎾᎿ ᎠᏂᎩᏍᎩ-ᎾᎿᎢ-ᎠᏂᎩᏍᎩ ᎧᏁᎬ ᎬᏗᏍᎬ, ᎠᎴ ᏥᎩ ᏗᏓᏴᎳᏛᏍᎩ ᎢᎦᏛ ᎠᏎ ᎨᎡᎢ ᎠᏎᎯᎯ ᎢᎦ ᎠᏓᏚᏅᎢ ᎤᎿᎢ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When Video calling is turned on, others can see that your phone has Video calling.">
                <langSet xml:lang="en-US"><tig><term>When Video calling is turned on, others can see that your phone has Video calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᎢ, ᏐᎢ ᏰᎵᏯ ᎯᎪᏩᏔ ᎥᏍᎩᎾ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏂᏚᏩᎿ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="can't receive video calls at this time.">
                <langSet xml:lang="en-US"><tig><term>can't receive video calls at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎦᏁᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎤᎿᎢ ᎯᎠ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling is turned off.">
                <langSet xml:lang="en-US"><tig><term>Video calling is turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please update Moto Camera Content to use Portrait mode">
                <langSet xml:lang="en-US"><tig><term>Please update Moto Camera Content to use Portrait mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎪᏢᎯᏐᏗ Moto ᏗᏓᏥᎶᏍᏗᏍᎩ ᎦᎸᏛᎢᎾᎢ ᎬᏙᏓ ᏗᏓᏥᎶᏍᏔᏅ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Would you like to turn it back on?">
                <langSet xml:lang="en-US"><tig><term>Would you like to turn it back on?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏯᏓᎯᏗᏏ you ᎤᎸᏉᏔᏅ to ᎠᎦᏔᎲᏍᏗ it ᎠᏨᏍᏗ ᎠᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling is currently not available.">
                <langSet xml:lang="en-US"><tig><term>Video calling is currently not available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᎨᎡᎢ ᏃᏊ ᏥᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select from Cloud">
                <langSet xml:lang="en-US"><tig><term>Select from Cloud</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎤᏩᎩᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please don't leave this screen.">
                <langSet xml:lang="en-US"><tig><term>Please don't leave this screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏝᏍᏗ ᎠᏂᎩᏍᎬ ᎯᎠ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure your stylus is in the folio and bluetooth is on.">
                <langSet xml:lang="en-US"><tig><term>Make sure your stylus is in the folio and bluetooth is on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Webcam">
                <langSet xml:lang="en-US"><tig><term>Moto Webcam</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎠᏏᎳᏕᏫᏒ ᏗᏓᏟᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To make video calls, Mobile data roaming needs to be turned on.">
                <langSet xml:lang="en-US"><tig><term>To make video calls, Mobile data roaming needs to be turned on.</term></tig></langSet>
