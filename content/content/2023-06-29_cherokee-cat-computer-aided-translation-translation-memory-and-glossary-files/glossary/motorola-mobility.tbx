            </termEntry>
            <termEntry id="Show update information in SIM status">
                <langSet xml:lang="en-US"><tig><term>Show update information in SIM status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎧᏃᎮᏢᏗ ᎤᎿ SIM ᏄᏍᏗᏓᏅᎢ</term></tig></langSet>
            </termEntry>
