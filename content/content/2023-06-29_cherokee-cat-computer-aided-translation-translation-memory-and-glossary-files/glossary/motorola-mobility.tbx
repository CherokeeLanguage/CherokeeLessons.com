                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏚᏂᎸᏫᏍᏓᏁᎲ. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎾᎢ ᎤᎬᏩᏟ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Give your eyes and your battery a rest with Android\’s new dark theme. When you turn on dark theme, your favorite Android and Moto apps automatically show a darker design.">
                <langSet xml:lang="en-US"><tig><term>Give your eyes and your battery a rest with Android\’s new dark theme. When you turn on dark theme, your favorite Android and Moto apps automatically show a darker design.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᎯᎧᏅ ᏃᎴ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏔᏣᏪᏐᎸᏍᏓ ᎬᏗ Android\’s ᎢᏤ ᎤᎵᏏᎩ ᎧᏃᎮᏗ ᎧᏃᎮᏗ. ᎾᎯᏳ ᏂᎯ ᏥᏍᏚᎢᏒ ᎤᎵᏏᎩ ᎧᏃᎮᏗ ᎧᏃᎵᏗ, ᏣᏤᎵ ᏫᏣᎸᏉᏛᎢ Android ᏃᎴ Moto ᏗᎬᏙᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᎪᏩᏛᏙᏗ ᏭᎵᏏᎬᎢ ᎪᏢᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you start a task on the external display, you can flip open for a more detailed experience on the internal display. When you’re using the internal display, you can close the flip to end a task and start something else.">
                <langSet xml:lang="en-US"><tig><term>When you start a task on the external display, you can flip open for a more detailed experience on the internal display. When you’re using the internal display, you can close the flip to end a task and start something else.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎠᏂᎩᏍᏗᏍᎬ ᎤᎾᎢ ᏙᏯᏗᏨ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᏂᎯ ᏰᎵᏊ ᏗᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎾᏍᎩᎾ ᎤᏥ ᎢᎦᎢ ᎠᏎᎸᎩ ᎠᎦᏙᎲᏒᎢ ᎤᎾᎢ ᎾᏍᎩ ᎭᏫᏂ ᎬᏂᎨᏒ ᏱᎬᏁᏗ. ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᎬᏗᏍᎬ ᎾᏍᎩ ᎭᏫᏂ ᎬᏂᎨᎢ ᏱᎬᏁᏗ, ᏂᎯ ᏰᎵᏊ ᎯᏍᏚᎲᎦ ᎾᏍᎩ ᏗᏁᏍᏆᏕᎦ ᎾᎢ ᎠᏍᏆᏗᏍᏗ ᏃᎴ ᎭᏂᎩᏍᏙᏗ ᎪᎱᏍᏗ ᏄᏓᎴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dimmer">
                <langSet xml:lang="en-US"><tig><term>Dimmer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᎪᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fades after a few seconds so it\u2019s easier to see your screen">
                <langSet xml:lang="en-US"><tig><term>Fades after a few seconds so it\u2019s easier to see your screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᎩ ᎤᎶᏐᏅ Ꭰ ᎢᎸᏍᎩ ᏓᏓᎾᏩᏍᎬ ᏓᏛ ᎾᏍᎩ ᎠᎯᏗᏳ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏂᏨᏅᎢ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Account registration unsuccessful.">
                <langSet xml:lang="en-US"><tig><term>Account registration unsuccessful.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᏓᎸᏗ ᎨᎪᏪᎳᏅᎯ ᎤᏓᏄᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To capture photos with the flip closed, twist your wrist twice to open the camera. Then, either tap on the screen or press the volume up or down key.">
                <langSet xml:lang="en-US"><tig><term>To capture photos with the flip closed, twist your wrist twice to open the camera. Then, either tap on the screen or press the volume up or down key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᎦᏂᏴᏍᎬ ᏗᏥᎶᏍᏔᏅᎯ ᎬᏗ ᎠᏗᏅᏗ ᎠᎵᏍᏚᎲᏍᎩ, ᏍᏕᏯᏍᏗ ᏔᎵ ᎢᏳᏩᏗ ᏂᏣᏤᎵ ᎠᎵᏰᏑᏜᏗᏍᏗ ᎯᏍᏚᎢᏍᎬ Ꮎ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᎾᏉᏃ, ᎢᏳᏍᏗᏊ ᎤᏟᏍᏓ ᎠᏒᏂᎸᎢ ᎥᎾᎢ ᎠᏓᏴᎵᏛᏍᎩ ᏃᎴ ᎭᏐᎥᏍᏓ Ꮎ ᎤᏃᏴᎬᎢ ᎦᎸᎳᏗ ᏃᎴ ᎡᎳᏗ ᎠᏍᏚᎢᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Accessibility button">
                <langSet xml:lang="en-US"><tig><term>Accessibility button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒ ᎠᏐᏅᏍᏙᏗ ᏄᏍᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Caption window opacity">
                <langSet xml:lang="en-US"><tig><term>Caption window opacity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏬᏂᏍᎬ ᏦᎳᏂ ᎤᏕᎵᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Authentication username">
                <langSet xml:lang="en-US"><tig><term>Authentication username</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏙᏟᏍᏙᏗ ᎬᏗᏍᎩ ᏚᏙᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="▽ Touch to hide all">
                <langSet xml:lang="en-US"><tig><term>▽ Touch to hide all</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>▽ ᎠᏒᏂᏍᏗ ᎾᎿᎢ ᎲᏍᎦᏢᎦ ᏂᎦᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Optional settings">
                <langSet xml:lang="en-US"><tig><term>Optional settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏩᏌ ᎠᏑᏰᏍᏗ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="For all calls when data network is available">
                <langSet xml:lang="en-US"><tig><term>For all calls when data network is available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏂᎦᏓ ᏓᏯᏂ ᎢᏳᏃ ᎦᏟᏌᏅᎯ ᏧᎾᏚᏓᎵ ᎨᏒᎢ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Account registration stopped because there is no Wi-Fi connection.">
                <langSet xml:lang="en-US"><tig><term>Account registration stopped because there is no Wi-Fi connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᏓᎸᏗ ᎨᎪᏪᎳᏅᎯ ᎤᎴᏫᏍᏔᏅ ᏂᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎥᏝᏰᏃ Wi-Fi ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Ring &amp; notification set to medium">
                <langSet xml:lang="en-US"><tig><term>Ring &amp; notification set to medium</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏍᏔᎫ &amp; ᎠᏓᏃᏣᎳᏁᎯ ᎤᎾᏓᏡᎬ ᎾᎿᎢ ᎠᏰᎵᏊ ᎢᏴ</term></tig></langSet>
            </termEntry>
            <termEntry id="Outbound proxy address">
                <langSet xml:lang="en-US"><tig><term>Outbound proxy address</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎪᏫᏛ ᏩᎦᏔ ᏗᏯᏙᎮᎯ ᎪᏪᎵ ᏧᏁᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto voicemail">
                <langSet xml:lang="en-US"><tig><term>Moto voicemail</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎥᎧᏁᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To place a SIP call, check your Internet connection first.">
                <langSet xml:lang="en-US"><tig><term>To place a SIP call, check your Internet connection first.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᏙᏢᏒ Ꭰ SIP ᏪᏯᎾ, ᎪᏪᎶᏗ ᏂᏨᏅᎢ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎠᎬᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to be connected to a Wi-Fi network for SIP calls (use the Wireless &amp; Network settings).">
                <langSet xml:lang="en-US"><tig><term>You need to be connected to a Wi-Fi network for SIP calls (use the Wireless &amp; Network settings).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎨᏒᎢ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Ꭰ Wi-Fi ᏧᎾᏚᏓᎵ ᎤᎬᏩᏟ SIP ᏓᏯᏂ (ᎬᏔᏂᏓᏍᏗ ᏥᎩ Wireless &amp; Network ᏕᎦᎧᎲᎢ).</term></tig></langSet>
            </termEntry>
            <termEntry id="For all calls">
                <langSet xml:lang="en-US"><tig><term>For all calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏂᎦᏓ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tired of your photos turning out too dark? With Night Vision, you can capture detailed photos in any low light condition.">
                <langSet xml:lang="en-US"><tig><term>Tired of your photos turning out too dark? With Night Vision, you can capture detailed photos in any low light condition.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏣᏯᏫᎦ ᏗᏣᏤᎵ ᏗᏓᏥᎶᏍᏔᏅ ᎤᎶᏒᏔᏅ ᎫᎳᏏᎩ ᏂᏕᎦᎵᏍᏗᏍᎬᎢ. ᏒᏃᏱ ᎠᎪᏩᏛᏗᎢ ᎬᏗ, ᏰᎵᏊ ᏂᎯ ᏱᏂᏯ ᎤᏎᎸᎩ ᎢᎬᏁᏗ ᏗᏓᏥᎶᏍᏔᏅᎢ ᎾᎿᎢ ᏂᎦᎵᏍᏗᏍᎬ ᎡᎳᏗ ᎠᏨᏍᏛ ᏄᏍᏗᏓᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" shortcut">
                <langSet xml:lang="en-US"><tig><term> shortcut</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏥᏳᎪᏗ ᎢᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Removing the account\u2026">
                <langSet xml:lang="en-US"><tig><term>Removing the account\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎬᏅᏕᏍᎬᎢ ᏥᎩ ᎠᏚᏓᎸᏗ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on  may cause you cannot receive voicemails for calling accounts .">
                <langSet xml:lang="en-US"><tig><term>Turning on  may cause you cannot receive voicemails for calling accounts .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᎢᏍᎬ  ᏰᎵᏯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏂᎯ Ꮭ ᏰᎵ ᎦᏁᏍᏗ ᎥᎧᏁᎬᎢ ᎤᎬᏩᏟ ᏓᏯᏂᏍᎬ ᏗᏚᏓᎸᏙᏗ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Send keep-alive">
                <langSet xml:lang="en-US"><tig><term>Send keep-alive</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᎠᏍᏆᏂᎪᏙᏗᎢ -ᎬᎿ</term></tig></langSet>
            </termEntry>
            <termEntry id="Notification vibration">
                <langSet xml:lang="en-US"><tig><term>Notification vibration</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᎲᏍᎬ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Autoclick works with a connected mouse. You can set the mouse cursor to click automatically when the cursor stops moving for a certain amount of time.">
                <langSet xml:lang="en-US"><tig><term>Autoclick works with a connected mouse. You can set the mouse cursor to click automatically when the cursor stops moving for a certain amount of time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ ᎭᏐᎥᏍᏓ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ Ꭰ ᎫᏓᎸᏅᎯ ᏥᏍᏕᏥ. ᏂᎯ ᏰᎵᏊ ᎤᎾᏓᏡᎬ ᏥᎩ ᏥᏍᏕᏥ ᎥᎪᏪᎵᏍᎬ ᎠᎴᏅᏙᏗ ᎾᎿᎢ ᎭᏐᎥᏍᏓ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎢᏳᏃ ᏥᎩ ᎥᎪᏪᎵᏍᎬ ᏓᎴᏫᏍᏗᏍᎬ ᏩᎲᏍᎩ ᎤᎬᏩᏟ Ꭰ ᏑᏓᎴᎩ ᎢᎦᎢ ᎾᎿᎢ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To avoid this conflict, please turn off Moto voicemail first and then tap continue.">
                <langSet xml:lang="en-US"><tig><term>To avoid this conflict, please turn off Moto voicemail first and then tap continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎯᎠ ᏂᏓᏙᎵᎬᎾ, ᎰᏩᏊ ᎠᏍᏚᏗ Moto ᎥᎧᏁᎬᎢ ᎠᎬᏱ ᎠᎴ ᎢᏳᏃ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎯᎸᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="High contrast text">
                <langSet xml:lang="en-US"><tig><term>High contrast text</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗ ᎠᏘᏍᏗᏍᎩ ᎠᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Account registration unsuccessful: Incorrect username or password.">
                <langSet xml:lang="en-US"><tig><term>Account registration unsuccessful: Incorrect username or password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᏓᎸᏗ ᎨᎪᏪᎳᏅᎯ ᎤᏓᏄᎸᏅᎢ: ᏂᏚᏳᎪᏛᎾ ᎬᏗᏍᎩ ᏚᏙᎥᎢ ᎠᎴ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Whenever an Xfinity Wi-Fi hotspot is available, your phone is set to auto-connect, so no log-ins are ever needed.">
                <langSet xml:lang="en-US"><tig><term>Whenever an Xfinity Wi-Fi hotspot is available, your phone is set to auto-connect, so no log-ins are ever needed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ Ꭰ Xfinity Wi-Fi ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ, ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎤᎾᏓᏡᎬ ᎾᎿᎢ ᎤᏩᏒ-ᎫᏓᎸᎢ, ᏓᏛ Ꮭ ᎠᏴᏍᏙᏗ ᎨᎡᎩ ᎢᎸᎯᏳᎢ ᎤᏚᎸᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Account registration stopped because there is no Internet connection.">
                <langSet xml:lang="en-US"><tig><term>Account registration stopped because there is no Internet connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏚᏓᎸᏗ ᎨᎪᏪᎳᏅᎯ ᎤᎴᏫᏍᏔᏅ ᏂᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎥᏝᏰᏃ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Gray">
                <langSet xml:lang="en-US"><tig><term>Gray</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᎪᎸ ᏌᎪᏂᎨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Uses more battery life">
                <langSet xml:lang="en-US"><tig><term>Uses more battery life</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᎤᏟ ᎢᎦᎢ ᎠᎾᎦᎵᏍᎩ ᎬᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Right now you're on our 4G LTE network.">
                <langSet xml:lang="en-US"><tig><term>Right now you're on our 4G LTE network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏘᏏ Ꭷ ᏂᎯ ᎨᎡᎩ ᎤᎿᎢ 4G LTE ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Receive incoming calls">
                <langSet xml:lang="en-US"><tig><term>Receive incoming calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎯᏁᎢ ᎦᎷᎦ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="The rear camera hardware isn't working. Switching to selfie camera. Tap GET HELP for further assistance.Error code: 8X">
                <langSet xml:lang="en-US"><tig><term>The rear camera hardware isn't working. Switching to selfie camera. Tap GET HELP for further assistance.Error code: 8X</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᏝᏰᏃ ᏱᏚᎸᏫᏍᏓᏁᎢ. ᎦᏁᏟᏴᏍᎩ ᎾᎢ ᎣᎶᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ. ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎠᎩᏍᏗ ᎠᎵᏍᏕᎸᏓ ᎤᎬᏩᏟ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎵᏍᎩ.ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 8X</term></tig></langSet>
            </termEntry>
            <termEntry id="Dual Capture">
                <langSet xml:lang="en-US"><tig><term>Dual Capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏐᏯ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Saving the account\u2026">
                <langSet xml:lang="en-US"><tig><term>Saving the account\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏏᏅᏗᎭ ᏥᎩ ᎠᏚᏓᎸᏗ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="To change this feature, visit your Wi-Fi Preferences Settings.">
