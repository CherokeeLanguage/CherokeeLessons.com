                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="There are no leases acquired for this shared data. Would you like to delete it?">
                <langSet xml:lang="en-US"><tig><term>There are no leases acquired for this shared data. Would you like to delete it?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᎭᏗ ᏗᏓᏙᎳᏍᏙᏗ ᎠᎩᏓ ᎾᏍᎩᎾ ᎯᎠ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ. ᏱᏣᏚᎵᏍ ᎾᎢ ᎠᏍᎪᎸᏗᏍᏗᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to pair the device. Either the QR code was incorrect, or the device is not connected to the same network.">
                <langSet xml:lang="en-US"><tig><term>Failed to pair the device. Either the QR code was incorrect, or the device is not connected to the same network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎢ ᏗᎵᎪᏙᏗ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᎢᏧᎳ ᎾᏍᎩ QR ᎠᏍᏓᏩᏛᏍᏙᏗ ᏂᏚᏳᎪᏛᎾ ᎨᏎᎢ, ᎠᎴᏃ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎭᏗ ᎫᏓᎸᏅᎯ ᎾᏍᎩ ᎤᏠᏱ ᎤᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" Adjust how colors display on your device. This can be helpful when you want to: See colors more accurately Remove colors to help you focus ">
                <langSet xml:lang="en-US"><tig><term> Adjust how colors display on your device. This can be helpful when you want to: See colors more accurately Remove colors to help you focus </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᏰᎵ ᏗᏑᏫᏓ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎯᎠ ᏰᎵᏊ ᎨᏒᎢ ᎠᎵᏍᏕᎵᏍᎩ ᎾᎯᏳ ᏂᎯ ᏱᏣᏚᎵ ᎾᎾᎢ: ᎠᎪᏩᏛᏗ ᏗᏑᏫᏓ ᎤᏥ ᎢᎦᎢ ᎧᎵᏗᏙᎳᎩ ᎠᎲᏍᏗ ᏗᏑᏫᏓ ᎾᎢ ᏂᎯ ᏱᏍᏕᎵ ᎤᎿᏊ ᎢᎦ ᏫᏔᎧᏅᎦ </term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data off">
                <langSet xml:lang="en-US"><tig><term>Mobile data off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected, not charging">
                <langSet xml:lang="en-US"><tig><term>Connected, not charging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ, ᎭᏗ ᎬᏂᏗᏍᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure you want to delete this shared data?">
                <langSet xml:lang="en-US"><tig><term>Are you sure you want to delete this shared data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍᎪᏃ ᎤᏙᎯᏳ ᏣᏚᎵᎢ ᎾᎢ ᎠᏍᎪᎸᏗᏍᏗ ᎯᎠ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter hostname of DNS provider">
                <langSet xml:lang="en-US"><tig><term>Enter hostname of DNS provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏓ ᎠᏓᏩᏛᎯᏙᎯ ᏚᏙᎥᎢ ᎥᎿᎢ DNS ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="WARNING: Device protection features will not work on this device while this setting is turned on.">
                <langSet xml:lang="en-US"><tig><term>WARNING: Device protection features will not work on this device while this setting is turned on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ: ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎵᏍᎦᏍᏙᏗ ᏗᎦᏎᏍᏙᏗ ᎠᏎ ᎭᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏱᎩ ᎤᎾᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎯᏳ ᎯᎠ ᏕᎦᎧᎲ ᎾᏍᎩ ᎠᏍᏚᎢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Drawing">
                <langSet xml:lang="en-US"><tig><term>Drawing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᎶᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="When this mode is enabled, this device\u2019s MAC address may change each time it connects to a network that has MAC randomization enabled.">
                <langSet xml:lang="en-US"><tig><term>When this mode is enabled, this device\u2019s MAC address may change each time it connects to a network that has MAC randomization enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎯᎠ ᎬᏙᏗᎭ ᎾᏍᎩ ᎡᎵᏊ ᎢᏳᎵᏍᏔᏅᎢ, ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ MAC ᎪᏪᎵ ᏗᎦᏁᏍᏗ ᏰᎵᏉ ᎦᏁᏟᏴᏍᏗ ᏧᏤᎵᏛ ᎠᏥᎢᎵᏒ ᏕᎫᏓᎸᎢ ᎾᎢ ᎤᏚᏓᎵ ᎾᏍᎩᎾᎢ ᎤᎲᎢ MAC ᏅᎦᏖᏃᎲᎾᏉᏃ ᎡᎵᏊ ᎢᏳᎵᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
