                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬ ᎦᏟᏌᏅᎯ ᏝᏰᎵ ᎨᏒᎩ ᎦᏅᏍᏙᏒᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Last synced ">
                <langSet xml:lang="en-US"><tig><term>Last synced </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂ ᎢᏧᎳᎭ ᏄᏅᏁᎸᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="Restrict background data">
