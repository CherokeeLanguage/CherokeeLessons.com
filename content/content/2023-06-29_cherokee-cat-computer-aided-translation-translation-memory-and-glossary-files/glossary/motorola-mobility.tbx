            <termEntry id="See when a contact is replying to your messages">
                <langSet xml:lang="en-US"><tig><term>See when a contact is replying to your messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ ᎢᏳᏃ Ꭰ ᎠᏟᏃᎮᏙᏗ ᎨᎡᎢ ᎦᏬᎯᎵᏴᏍᏗ ᎾᎿᎢ ᏂᏨᎤᎢ ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Check-in is running in background">
                <langSet xml:lang="en-US"><tig><term>Check-in is running in background</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏅᏂᎦ ᎨᎡᎢ ᎠᏂᎩᏍᏓ ᎾᎿ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Max file size is .">
                <langSet xml:lang="en-US"><tig><term>Max file size is .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨ ᎬᏔᏅᏂᎨᏒᎾ ᎢᎩᏓ ᎨᏒ ᎨᎡᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Each text and file attachment is counted and charged as a separate message">
                <langSet xml:lang="en-US"><tig><term>Each text and file attachment is counted and charged as a separate message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ ᎠᎴ ᎬᏔᏅᏂᎨᏒᎾ ᎠᏠᏯᏍᏛᎢ ᎨᎡᎢ ᏗᏎᎸᎯ ᎠᎴ ᎠᎫᏍᏗ ᎤᎿᎢ Ꭰ ᎤᎾᏓᏤᎵᏛ ᎠᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you prefer other people not know when you've read their messages, turn read receipts off in message settings.">
                <langSet xml:lang="en-US"><tig><term>If you prefer other people not know when you've read their messages, turn read receipts off in message settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᎤᏟ ᎠᏰᎸᏗ ᏐᎢ ᎠᏂᏴᏫ ᎥᏝ ᎠᎦᏙᎥᏒ ᎢᏳᏃ ᏂᎯ ᎤᎭ ᎠᎪᎵᏰᏗ ᎤᎾᏤᎵ ᏗᎪᎵᏰᏗ, ᎠᎦᏔᎲᏍᏗ ᎠᎪᎵᏰᏗ ᎠᎩᏒᏅ ᎧᏃᎮᏍᎩ ᎪᏪᎵ ᎠᏍᏚᏗ ᎾᎿ ᎠᎪᎵᏰᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Send and receive confirmation when messages are read">
                <langSet xml:lang="en-US"><tig><term>Send and receive confirmation when messages are read</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᎠᎴ ᎦᏁᏍᏗ ᎦᎫᏍᏛᏗᏱ ᎢᏳᏃ ᏗᎪᎵᏰᏗ ᎨᎡᎩ ᎠᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" added group icon">
                <langSet xml:lang="en-US"><tig><term> added group icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎧᏁᏉᏓ ᎤᎾᏓᏡᎬᎢ ᎠᎢᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="To view, edit, back up, and restore data on your device, Rescue and Smart Assistant needs permission to access apps, photos, videos, contacts, and other files.">
                <langSet xml:lang="en-US"><tig><term>To view, edit, back up, and restore data on your device, Rescue and Smart Assistant needs permission to access apps, photos, videos, contacts, and other files.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᏗᎧᏃᏗ, ᎦᏁᏟᏴᏓ ᎪᏪᎸ, ᎭᏏᏄᎦ, ᏃᎴ ᎪᏢᎯᏐᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᏓᏍᏕᎸᏗ ᏃᎴ ᎠᏌᎹᏗ ᎠᎵᏍᏕᎵᏍᎩ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏴᏍᏗ ᏗᎬᏙᏗ, ᏗᏥᎶᏍᏔᏅᎯ, ᏗᏓᏴᎳᏛᏍᎩ, ᏗᏟᏃᎮᏙᏗ, ᏃᎴ ᏐᎢ ᏗᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The wallpaper zooms in and out when you go to the Home screen">
                <langSet xml:lang="en-US"><tig><term>The wallpaper zooms in and out when you go to the Home screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᎾᎥ ᏅᎦ ᎠᎴ ᎦᏅᎪᏫᏛ ᎢᏳᏃ ᏂᎯ Ꭷ ᏥᎩ ᎣᏪᏅᏒ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Alert Category:">
                <langSet xml:lang="en-US"><tig><term>Alert Category:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Share files up to \(Each file counts as one message.\)">
                <langSet xml:lang="en-US"><tig><term>Share files up to \(Each file counts as one message.\)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᏍᏗᎢ ᏗᏍᏆᏂᎪᏙᏗᎢ ᏯᏍᏘ \(ᏌᏊᎭ ᎠᏍᏆᏂᎪᏙᏗ ᏗᏎᏍᏗ ᎯᎢᎾᎢ ᏌᏊ ᏗᎦᏃᏣᎳᏅᎯ.\)</term></tig></langSet>
            </termEntry>
            <termEntry id="The wallpaper image transforms throughout the day">
                <langSet xml:lang="en-US"><tig><term>The wallpaper image transforms throughout the day</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᎠᏅᏓᏗᏍᏙ ᎤᎾᏓᏁᏟᏴᏓ ᏂᎦᏅᎯᏒ ᏥᎩ ᎢᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="My Wallpapers">
                <langSet xml:lang="en-US"><tig><term>My Wallpapers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="This gallery gives you access to all of Motorola's interactive wallpapers.">
                <langSet xml:lang="en-US"><tig><term>This gallery gives you access to all of Motorola's interactive wallpapers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᏑᏰᏍᏗᏱ ᎠᏓᏁᎭ ᏂᎯ ᏩᏴᏍᏗᎢ ᎾᎿᎢ ᏂᎦᏓ ᎾᎿ Motorola's ᏗᎵᎪᎲᏍᎩ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The gallery is hosted on the cloud, so wallpapers don't take up space on your device until you download them.">
                <langSet xml:lang="en-US"><tig><term>The gallery is hosted on the cloud, so wallpapers don't take up space on your device until you download them.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏗᏑᏰᏍᏗᏱ ᎨᎡᎢ ᎤᏓᏁᏢᏅ ᎤᎿᎢ ᏥᎩ ᎤᏩᎩᎸ, ᏓᏛ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ ᏝᏍᏗ ᎠᎩᏍᏗ ᎦᎸᎳᏗ ᎤᏜᏅᏛ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎩᎳ ᏂᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏯᏂᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="New wallpapers will appear here when they’re available.">
                <langSet xml:lang="en-US"><tig><term>New wallpapers will appear here when they’re available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏤ ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ ᎠᏎ ᎬᏂᎨᏒᎢ ᎠᎭᏂ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Interactive Wallpaper will continue to run until downloads are complete.">
                <langSet xml:lang="en-US"><tig><term>Interactive Wallpaper will continue to run until downloads are complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᎲᏍᎩ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ ᎠᏎ ᎠᎯᎸᏍᏗ ᎾᎿᎢ ᎠᏓᎾᏫᏍᏗ ᎩᎳ ᎡᎳᏗᏟ ᏕᎦᏢᏍᎬᎢ ᎨᎡᎩ ᎧᎵᎢ.</term></tig></langSet>
            </termEntry>
