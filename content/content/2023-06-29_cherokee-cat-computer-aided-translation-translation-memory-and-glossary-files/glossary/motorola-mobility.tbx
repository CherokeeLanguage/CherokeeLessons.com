                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᏗᎦᏟᏌᏅᎩ ᎠᎴ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ ᎬᏗᏍᎬ ᎦᏃᎮᏢᎥᏍᎩ ᎠᏍᏆᏂᎪᏙᏗ ᏂᏣᏤᎵ ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᎠᏤᎲᏍᏔᏅᎢ-ᎾᎢ-ᎢᎦ ᎠᏓᏁᎳᏁᏗ, ᎣᏤᎵ ᎢᎬᏁᎵᏓᏍᏗ ᎠᎴ ᎪᏢᎯᏐᏗ ᏗᎪᏢᏅᎯ ᎠᎴ ᎢᏗᏓᏛᏁᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data collected will be transferred to manufacture servers in the USA.">
                <langSet xml:lang="en-US"><tig><term>Data collected will be transferred to manufacture servers in the USA.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎤᏂᏟᏌᏅᎯ ᎨᏎᏍᏗ ᏭᏚᏓᏲᎯᏎᎸ Motorola ᏗᏯᏙᎯᎯ ᎥᎾᎢ USA</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change your privacy preferences anytime by going to Settings &gt; Privacy &gt; Privacy.">
                <langSet xml:lang="en-US"><tig><term>You can change your privacy preferences anytime by going to Settings &gt; Privacy &gt; Privacy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏕᎯᏁᏟᏴᎾ Ꮎ ᎤᏕᎵᏓ ᎤᏥᎠᏰᎸᏍᎬᎢ ᏣᏚᎵᏍᎬᏊ ᏕᎦᎧᎲᎢ ᏳᏫᏣᎷᏣ&gt;ᎤᏕᎵᏓ&gt; ᎤᏕᎵᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="For your safety, security updates may download &amp; install automatically over mobile data if Wi-Fi isn't available within a timeframe that corresponds to the importance of the update.">
                <langSet xml:lang="en-US"><tig><term>For your safety, security updates may download &amp; install automatically over mobile data if Wi-Fi isn't available within a timeframe that corresponds to the importance of the update.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏣᏓᎵᏏᏅᏙᏗ, ᎤᎦᏎᏍᏗ ᏙᏢᎯᏌ ᎡᎳᏗᏟᎦᎸᏍᎬᎢ ᎠᎴ ᏕᎦᏘᏅᏛᎢ ᎤᏩᏒᏊ ᏱᎬᏁᎯ ᎬᏬᎯᎸᏙᏗ ᎠᏂᎩᏍᎩ ᏌᏟᏌᏅ Ꮎ Wi-Fi ᏄᏛᏅᏍᏛᎾ ᏱᎩ ᎤᏓᎷᎸᏭ ᎤᎵᏍᎨᏓ ᎨᏒ Ꮎ ᎦᏟᏌᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="New users are eligible for a free trial.">
                <langSet xml:lang="en-US"><tig><term>New users are eligible for a free trial.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏤ ᏗᏅᏗᏍᎩ ᏣᎦᏓᏂᎸᏨᎢ ᎾᏍᎩᎾ ᎠᏎᏊᎢ ᎠᎾᏓᎪᎵᏰᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restrictions apply.">
                <langSet xml:lang="en-US"><tig><term>Restrictions apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏲᏍᏓᏁᎲᎢ ᎲᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can always change your mind later in Setting &gt; Display">
                <langSet xml:lang="en-US"><tig><term>You can always change your mind later in Setting &gt; Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏂᎪᎯᎸᎢ ᎦᏁᏟᏴᏍᏗ ᏂᏨᎤᎢ ᎤᏓᏅᏛ ᎣᏂᏯᎨᏍᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ &gt; ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can always change your mind later in Setting &gt; System &gt; Gestures">
                <langSet xml:lang="en-US"><tig><term>You can always change your mind later in Setting &gt; System &gt; Gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏂᎪᎯᎸᎢ ᎦᏁᏟᏴᏍᏗ ᏂᏨᎤᎢ ᎤᏓᏅᏛ ᎣᏂᏯᎨᏍᏗ ᎾᎿ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ &gt; ᏧᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're ready to start using your phone.">
                <langSet xml:lang="en-US"><tig><term>You're ready to start using your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᏗᏟᏃᎮᏗ ᏣᏤᎵ ᏂᏨᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your carrier occasionally requires location data to improve its services and analytics.">
                <langSet xml:lang="en-US"><tig><term>Your carrier occasionally requires location data to improve its services and analytics.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᏣᏂᏙ ᎤᏚᎵᎰ ᏯᏓᎲ ᎮᏙᎲ ᎦᏟᏌᏅ ᏓᏤᏢ ᎢᏳᎾᏓᏛᏁᏗᎢ ᎠᎴ ᏓᏤᏢ ᏗᎪᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some carrier features may not be avaliable without location access.">
                <langSet xml:lang="en-US"><tig><term>Some carrier features may not be avaliable without location access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᏓᏂᏙ ᏄᎾᏍᏗᏓᏅ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎨᏐ ᏄᏍᏛᎾ ᏱᎩ ᎮᏙᎲ ᎠᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change this settings at any time by going to">
                <langSet xml:lang="en-US"><tig><term>You can change this settings at any time by going to</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᎵᏍᏗᏊ ᏕᎦᎧᎲᎢ ᏣᏂᏟᏴᏍᏗ ᎾᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Grant location access">
                <langSet xml:lang="en-US"><tig><term>Grant location access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎵᏍᎪᎸᏓ ᎤᏙᏢᏒᎢ ᎬᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you're in a video call you can enhance your experience with effects like background blur, subject tracking, and more.">
                <langSet xml:lang="en-US"><tig><term>When you're in a video call you can enhance your experience with effects like background blur, subject tracking, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᎾᎿ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᏂᎯ ᏰᎵᏇ ᏓᏤᏞᏍᏗ ᏣᏤᎵ ᏄᎵᏍᏔᏂᏙᎸᎢ ᎬᏗ ᏄᎵᏍᏔᏅ ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎤᏍᎪᎸ, ᎧᏃᎮᏗ ᎪᎷᏁᎩ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You have opted in for communications from Motorola about the following services and benefits:">
                <langSet xml:lang="en-US"><tig><term>You have opted in for communications from Motorola about the following services and benefits:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᎠᏑᏰᏍᏗ ᏗᎫᎪᏙᏗ ᎤᎬᏩᏟ ᏧᎾᏓᏛᎪᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ Motorola ᎢᎸᏢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎠᎴ ᏧᎾᎵᏍᏕᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Click here  to unsubscribe.">
                <langSet xml:lang="en-US"><tig><term>Click here  to unsubscribe.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᎭᏂ  ᎾᎿᎢ ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Search results">
                <langSet xml:lang="en-US"><tig><term>Search results</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᏍᏗ ᏂᏚᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait for 5 minutes before entering the unlock code again.">
                <langSet xml:lang="en-US"><tig><term>Please wait for 5 minutes before entering the unlock code again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ ᎾᏍᎩᎾ 5 ᎢᏗᏔᏬᏍᏔᏅᎯ ᎤᏓᎷᎸ ᎠᏂᏴᎯᎲ ᎾᏍᎩ ᎦᏐᎭᎾᎳᎩᏍᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait for 5 minutes before entering the unlock code again.">
                <langSet xml:lang="en-US"><tig><term>Please wait for 5 minutes before entering the unlock code again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ ᎾᏍᎩᎾ 5 ᎢᏗᏔᏬᏍᏔᏅᎯ ᎤᏓᎷᎸ ᎠᏂᏴᎯᎲ ᎾᏍᎩ ᎦᏐᎭᎾᎳᎩᏍᏗ ᎠᏍᏓᏩᏛᏍᏙᏗ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Place a QR code inside the viewfinder rectangle to scan it.">
                <langSet xml:lang="en-US"><tig><term>Place a QR code inside the viewfinder rectangle to scan it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᏢᏒ QR ᎤᏕᎵᏓ ᎦᏬᏂᎯᏍᏓ ᎭᏫᎾᏗᏢ ᎠᎪᎵᏰᏗ ᎠᏩᏘᏍᎩ ᏅᎩᏧᏅᏏᏗ ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᎤᏩᏌ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You may need to restart the device.">
                <langSet xml:lang="en-US"><tig><term>You may need to restart the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᏥᎭᏂᎩᏍᏓ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device is fully charged">
                <langSet xml:lang="en-US"><tig><term>Your device is fully charged</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏂᎧᎵ ᎠᎫᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio Recorder + other apps">
                <langSet xml:lang="en-US"><tig><term>Audio Recorder + other apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᎦᏂᏴᏙᏗ + ᏐᎢ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Help protect your device from viruses, malware and risky websites and identify which mobile apps are accessing your private info.">
                <langSet xml:lang="en-US"><tig><term>Help protect your device from viruses, malware and risky websites and identify which mobile apps are accessing your private info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏕᎸᏓ ᎠᏓᎦᏎᏍᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩᎾ ᏨᏳᎩ, ᎤᏲ ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᎠᎴ ᎠᏁᎸᏙᏗ ᎤᏂᎳᏛᎢ ᎠᎴ ᎠᏓᏙᎯᏙᏗᎠᏓᏅᏏᏙ ᏗᎬᏙᏗ ᏅᏛᏴᏍᏙᏗ ᏣᏤᎵ ᎬᏍᎦᏟ ᎧᏃᎮᏢᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio Recorder only">
                <langSet xml:lang="en-US"><tig><term>Audio Recorder only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᎦᏂᏴᏙᏗ ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow Digital Secure to scan your messages, media and other files for viruses and other malware for free.">
                <langSet xml:lang="en-US"><tig><term>Allow Digital Secure to scan your messages, media and other files for viruses and other malware for free.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎠᎾᎦᎵᏍᎩ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᏣᏤᎵ ᏗᎪᎵᏰᏗ, ᎦᎶᏙᏗ ᎠᎴ ᏐᎢ ᏗᏍᏆᏂᎪᏙᏗ ᎾᏍᎩᎾ ᏨᏳᎩ ᎠᎴ ᏐᎢ ᎤᏲ ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᎾᏍᎩᎾ ᎠᏎᏊᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You will need to set permissions in the Digital Secure app to begin using the service.">
                <langSet xml:lang="en-US"><tig><term>You will need to set permissions in the Digital Secure app to begin using the service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎢ ᎤᏚᎸᏓ ᎤᏚᎸᏓ ᎾᎿᎢ ᏗᎧᎲᎦᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿ ᎠᎾᎦᎵᏍᎩ ᏄᎾᏰᎯᏍᏛᎾᏉ ᎬᏙᏗ ᎾᎿᎢ ᎠᎴᏅᏗ ᎬᏗᏍᎬ ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="By tapping Accept, you agree to the Digital Secure Terms and Conditions and Verizon Privacy Policy.">
                <langSet xml:lang="en-US"><tig><term>By tapping Accept, you agree to the Digital Secure Terms and Conditions and Verizon Privacy Policy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏗᏓᏂᎸᎢᏍᏗ, ᎣᏏ ᏕᎭᏓᏁᎸᎩ ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏄᎾᏰᎯᏍᏛᎾᏉᏗᏓᏁᏤᎸ ᎠᎴ ᏂᏚᏍᏗᏓᏅᎢ ᎠᎴ Verizon ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app may use mobile data.">
                <langSet xml:lang="en-US"><tig><term>This app may use mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏰᎵᏉ ᎲᏗᏍᎬ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can start your live stream with Twitch. Please download and install Twitch app from Google Play Store first.">
                <langSet xml:lang="en-US"><tig><term>You can start your live stream with Twitch. Please download and install Twitch app from Google Play Store first.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏯᎴᎾ ᏣᏤᎵ ᏃᏊᏥᎩ ᎤᏪᏴᎢ ᎬᏗ ᎠᏔᎾᏫᏍᎬᎢ . ᎰᏩᏊ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᎴ ᎯᏘᏅᏛᎦ ᎠᏔᎾᏫᏍᎬᎢ ᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ Google Play Store ᎠᎬᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Bottom third">
                <langSet xml:lang="en-US"><tig><term>Bottom third</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏢ ᏦᎢᏁᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some Gestures may conflict with game controls, so blocking them will prevent potential disruptions. They will only be blocked while you're gaming.">
                <langSet xml:lang="en-US"><tig><term>Some Gestures may conflict with game controls, so blocking them will prevent potential disruptions. They will only be blocked while you're gaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᎤᏬᏯᏂᏍᎩ ᏰᎵᏉ ᏗᎦᏘᎴᎩ ᎬᏗ ᏗᏁᎸᏙᏗ ᏗᎯᎸᏍᏗ, ᎾᏍᎩᎾᏃ ᏓᏂᏐᎭᎾᎳᏗᏍᎬᎢ ᎠᏎᎢ ᎠᏲᏍᏙᏗᏍᎩ ᎢᏳᎵᏍᏙᏗ ᏗᏲᏍᏔᏅᎯ ᏱᏂᎦᎵᏍᏓ. ᎾᏍᎩᏛ ᎠᏎ ᎤᏩᏌ ᎦᏐᎭᎾᎳ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ ᏕᎭᏁᎸᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twitch app not installed">
                <langSet xml:lang="en-US"><tig><term>Twitch app not installed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᎾᏫᏍᎬᎢ ᎬᏙᏗ ᎥᏝ ᎦᏘᏅᏔᏅ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose up to 2 apps to show in the sidebar. Apps will appear in freeform mode when you open them during a game.">
                <langSet xml:lang="en-US"><tig><term>Choose up to 2 apps to show in the sidebar. Apps will appear in freeform mode when you open them during a game.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎦᎸᎳᏗ ᎾᎢ 2 ᏗᎬᏙᏗ ᎾᎢ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎾᏍᎩ ᎤᏟᏗᏢ ᎦᎾᎸᎢ. ᏗᎬᏙᏗ ᎠᏎ ᎦᎾᏄᎪᎦ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ ᎾᎯᏳ ᏕᎯᏍᏚᎢᏒ ᎾᎯᏳᎢ ᏗᏁᎶᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Block incoming calls is off">
                <langSet xml:lang="en-US"><tig><term>Block incoming calls is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ ᎦᎷᎬ ᏫᏗᎬᏔᏅᎢ ᏄᏍᏛ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime enhances your gaming experience">
                <langSet xml:lang="en-US"><tig><term>Gametime enhances your gaming experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏓᏤᏢᎩ ᏣᏤᎵ ᏕᎭᏕᎶᎲᏍᎬᎢ ᎠᎦᏙᎲᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Undo">
                <langSet xml:lang="en-US"><tig><term>Undo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᎾᏕᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moments">
                <langSet xml:lang="en-US"><tig><term>Moments</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᎵᏍᏔᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission required">
                <langSet xml:lang="en-US"><tig><term>Permission required</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏎᏯᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch sensitivity is on">
                <langSet xml:lang="en-US"><tig><term>Touch sensitivity is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎩᎶᏈᏴ ᎤᏓᏁᏟᏴᏌᏓ ᏄᏍᏛ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Using the sidebar">
                <langSet xml:lang="en-US"><tig><term>Using the sidebar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎬ ᎾᏍᎩ ᎤᏟᏗᏢ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn Locked mode on &amp; off in the sidebar. It turns off automatically when you receive a phone call or turn off the display.">
                <langSet xml:lang="en-US"><tig><term>You can turn Locked mode on &amp; off in the sidebar. It turns off automatically when you receive a phone call or turn off the display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎾᏍᎩ ᎦᏐᎭᎾᎳᎸ ᎬᏙᏗᎭ ᏱᏍᏚᎢ &amp; ᏱᏍᏚᎲᎦ ᎾᎿ ᎾᏍᎩ ᎤᏟᏗᏢ ᎦᎾᎸᎢ. ᎾᏍᎩ ᎤᏩᏌ ᎠᎵᏍᏚᎲᏍᎪᎢ ᎾᏌᏳ ᏂᎯ ᎯᎩᏍᎪ ᏗᏟᏃᎮᏗ ᏤᏍᏓᏁᎲ ᎠᎴᏃ ᎠᏍᏚᎲᏍᎪᎢ ᎾᏍᎩ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not installed">
                <langSet xml:lang="en-US"><tig><term>Not installed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎦᏘᏅᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Always in freeform">
                <langSet xml:lang="en-US"><tig><term>Always in freeform</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎪᎯᎸᎢ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="High performance is off">
                <langSet xml:lang="en-US"><tig><term>High performance is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏍᎪᎵᏴ ᏧᎸᏫᏍᏓᏁᎯ ᏄᏍᏛ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can drag the sidebar icon anywhere along the edge">
                <langSet xml:lang="en-US"><tig><term>You can drag the sidebar icon anywhere along the edge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᏱᎾᏏᏄᎦ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎠᎢᎧᏂ ᎤᎾᏉᎨᏒ ᎠᏍᏓᏩᏕᎨᏍᏗ ᎾᏍᎩ ᎠᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Visual hint">
                <langSet xml:lang="en-US"><tig><term>Visual hint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ ᎠᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs some permissions to provide the best experience. To grant permissions, tap on &quot;Permissions&quot; in App info.">
                <langSet xml:lang="en-US"><tig><term>Gametime needs some permissions to provide the best experience. To grant permissions, tap on "Permissions" in App info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏚᏚᎸᏛᎢ ᎢᎦᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏓᏁᎳᏁᏗ ᎾᏍᎩ ᏫᏓᏤᏢ ᎤᎦᏙᎲᏒᎢ. ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ, ᎤᎾᎢ ᎭᏐᎥᏍᏓ "ᏗᏓᎵᏍᎪᎸᏓᏁᎯ" ᎾᎿᎢ ᎬᏙᏗ ᎧᏃᎮᎸᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="High performance is on">
                <langSet xml:lang="en-US"><tig><term>High performance is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏍᎪᎵᏴ ᏧᎸᏫᏍᏓᏁᎯ ᏄᏍᏛ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app gives you easy access to tools &amp; settings for better gaming">
                <langSet xml:lang="en-US"><tig><term>This app gives you easy access to tools &amp; settings for better gaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏣᏁᎭ ᎠᎯᏗᎨᎢ ᎠᏴᏍᏗ ᎾᎾᎢ ᏗᎬᏔᏂᏓᏍᏗ &amp; ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾᎢ ᏓᏤᏢᎩ ᏓᏁᎸᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs permission to access background data to identify apps as games. Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>Gametime needs permission to access background data to identify apps as games. Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏚᏚᎸᏛᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎾᎢ ᎪᏟᏍᏙᏗ ᏗᎬᏙᏗ ᎾᏍᎩ ᏧᎾᏁᎸᏙᏗ. ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open the sidebar by tapping on the icon">
                <langSet xml:lang="en-US"><tig><term>Open the sidebar by tapping on the icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎾᏍᎩ ᎤᏟᏗᏢ ᎦᎾᎸᎢ ᏄᏩᎾ ᎭᏐᎥᏍᏗᏍᎬᎢ ᎤᎾᎢ ᎾᏍᎩ ᎠᎢᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission required">
                <langSet xml:lang="en-US"><tig><term>Permission required</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎢᏯᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Continue">
                <langSet xml:lang="en-US"><tig><term>Continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏯᎢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime is on">
                <langSet xml:lang="en-US"><tig><term>Gametime is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏄᏍᏛ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can find helpful tools &amp; shortcuts in the sidebar. To open the sidebar, you can tap on the icon or swipe right from edge.">
                <langSet xml:lang="en-US"><tig><term>You can find helpful tools &amp; shortcuts in the sidebar. To open the sidebar, you can tap on the icon or swipe right from edge.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏩᏔ ᎠᎵᏍᏕᎵᏍᎩ ᏗᎬᏔᏂᏓᏍᏗ &amp; ᏍᏆᎳ ᎢᏗᎬᏁᎯ ᎾᎿᎢ ᎤᏟᏗᏢ ᎪᏪᎸᎢ. ᎾᎢ ᎯᏍᏚᎢ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ, ᏂᎯ ᏰᎵᏊ ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎠᎢᎧᏂ ᎠᎴᏃ ᎯᏅᎦᎵᏓ ᎠᎦᏘᏏ ᏂᏓᏳᏓᎴᏅ ᎠᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Welcome to Gametime">
                <langSet xml:lang="en-US"><tig><term>Welcome to Gametime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏨᏓᏂᎸᎩ ᎾᎢ ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Start your stream">
                <langSet xml:lang="en-US"><tig><term>Start your stream</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏗ ᏣᏤᎵ ᎤᏪᏴᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block incoming calls is on">
                <langSet xml:lang="en-US"><tig><term>Block incoming calls is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ ᎦᎷᎬ ᏫᏗᎬᏔᏅᎢ ᏄᏍᏛ ᎠᏂᎩᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dark aware is on">
                <langSet xml:lang="en-US"><tig><term>Dark aware is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏏᎩ ᎯᎦᏔᎲ ᏄᏍᏛ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Top third">
                <langSet xml:lang="en-US"><tig><term>Top third</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏚᎢ ᏦᎢᏁᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block notifications is on">
                <langSet xml:lang="en-US"><tig><term>Block notifications is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏗᏍᎬᎢ ᏗᏓᏃᏣᎳᏁᎯ ᏄᏍᏛ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only 2 apps can be added">
                <langSet xml:lang="en-US"><tig><term>Only 2 apps can be added</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>2 ᏗᎬᏙᏗ ᎤᏩᏌ ᏰᎵᏊ ᎨᏒᎢ ᎧᏁᏉᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Locked mode is off">
                <langSet xml:lang="en-US"><tig><term>Locked mode is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳᏛᎢ ᎬᏙᏗᎭ ᏄᏍᏛ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick capture">
                <langSet xml:lang="en-US"><tig><term>Quick capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime settings">
                <langSet xml:lang="en-US"><tig><term>Gametime settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Middle third">
                <langSet xml:lang="en-US"><tig><term>Middle third</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᏟ ᏦᎢᏁᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime is running">
                <langSet xml:lang="en-US"><tig><term>Gametime is running</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏣᎢᎵᏒ ᏄᏍᏛ ᎠᏂᎩᏍᏛ</term></tig></langSet>
            </termEntry>
        </body>
    </text>
</martif>
