            </termEntry>
            <termEntry id="Press &amp; hold both volume keys">
                <langSet xml:lang="en-US"><tig><term>Press &amp; hold both volume keys</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᏂᏯ ᎢᏧᎳᏃ ᏂᎦᎥ ᎤᏜᏅᏛᎢ ᏗᏍᏚᎢᏍᏗ</term></tig></langSet>
