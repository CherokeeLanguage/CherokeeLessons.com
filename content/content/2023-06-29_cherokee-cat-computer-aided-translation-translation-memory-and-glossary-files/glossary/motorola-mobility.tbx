            <termEntry id="Display network name in status bar">
                <langSet xml:lang="en-US"><tig><term>Display network name in status bar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏧᎾᏚᏓᎵ ᏚᏙᎥ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Use Wi-Fi only">
                <langSet xml:lang="en-US"><tig><term>Use Wi-Fi only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ Wi-Fi ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="Antenna disconnected">
                <langSet xml:lang="en-US"><tig><term>Antenna disconnected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎫᏓᎴᏓᏃ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hide sensitive work notification content">
                <langSet xml:lang="en-US"><tig><term>Hide sensitive work notification content</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏍᎦᏢᎦ ᎤᏁᏟᏴᏌᏘ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᏓᏃᏣᎳᏁᎯ ᎦᎸᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can't pin more than 10 apps">
                <langSet xml:lang="en-US"><tig><term>You can't pin more than 10 apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏝᏰᎵ ᏱᎨᎯᎭᏛᎦ ᎤᏟ ᎢᎦᎢ ᏏᏃ 10 ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Rotate your finger to record the edges of your fingerprint">
                <langSet xml:lang="en-US"><tig><term>Rotate your finger to record the edges of your fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏰᏒᏛ ᎯᏗᏆᎸᏕᏯᏍᏗ ᎬᏂᏴᏓ ᎠᏍᏛᎢ Ꮎ ᎯᏰᏒᏛᎦᎴᏴᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep changing your finger placement to capture your entire fingerprint">
                <langSet xml:lang="en-US"><tig><term>Keep changing your finger placement to capture your entire fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏂᏟᏴᏍᎨᏍᏗ ᎯᏰᏒᏛ ᏂᎦᏓ ᎤᏂᏗ ᎯᏰᏒᏛᎦᎴᏴᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="in  y">
                <langSet xml:lang="en-US"><tig><term>in  y</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ  y</term></tig></langSet>
            </termEntry>
            <termEntry id="You cannot make a call while the device is in airplane mode.">
                <langSet xml:lang="en-US"><tig><term>You cannot make a call while the device is in airplane mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ Ꮭ ᏰᎵ ᎪᏢᏗ Ꭰ ᏪᏯᎾ ᎾᎯᏳᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎩ ᎾᎿ ᏥᏳ ᏄᏍᏛᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Using a screen protector">
                <langSet xml:lang="en-US"><tig><term>Using a screen protector</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗᎮᏍᏗ ᎠᏛᏰᎸᏔᏍᎩ ᎠᏓᎦᏎᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="A screen protector can affect how the sensor reads your fingerprint.">
                <langSet xml:lang="en-US"><tig><term>A screen protector can affect how the sensor reads your fingerprint.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏰᎸᏔᏍᎩ ᎠᏓᎦᏎᏍᏙᏗ ᎠᏓᏕᏯᏙᏗ Ꮎ ᎯᏰᏒᏛᎦᎴᏴᏙᏗ ᎠᎪᎵᏱᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Each time you add a new screen protector, re-enroll your fingerprint for the best accuracy.">
                <langSet xml:lang="en-US"><tig><term>Each time you add a new screen protector, re-enroll your fingerprint for the best accuracy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏏᏴᏫᎭ ᎯᏁᏉᎨᏍᏗ Ꮎ ᎢᏤ ᎠᏛᏰᎸᏔᏍᎩ ᎠᏓᎦᏎᏍᏙᏗ, ᎢᎯᎴᏗᏍᎨᏍᏗ ᎯᏰᏒᏛᎦᎴᏴᏙᏗ ᏫᏛᏤᏢ ᎧᎵᏗᏙᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edit folder">
                <langSet xml:lang="en-US"><tig><term>Edit folder</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᏗᏴᏈᏛᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait.">
                <langSet xml:lang="en-US"><tig><term>Please wait.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose time zone">
                <langSet xml:lang="en-US"><tig><term>Choose time zone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᎠᏥᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Force stop already in progress">
                <langSet xml:lang="en-US"><tig><term>Force stop already in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏌᏙᏯᏍᏗ ᎠᎴᏫᏍᏙᏗ ᎦᏳᎳ ᎠᏛᎴᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please wait.">
                <langSet xml:lang="en-US"><tig><term>Please wait.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᎦᏘᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Application is being disabled">
                <langSet xml:lang="en-US"><tig><term>Application is being disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Animation styles">
                <langSet xml:lang="en-US"><tig><term>Animation styles</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏏᏙᎯ ᏄᏍᏓ ᎪᏪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor with your finger and remove it after you feel a vibration">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor with your finger and remove it after you feel a vibration</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏒᎾᎦ ᎠᏩᏘᏍᎩ ᎯᏰᏒᏛ ᎬᏗ ᎠᎴ ᏅᏅᏕᏒ ᎠᎵᏖᎸᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow NFC use only when screen is unlocked">
                <langSet xml:lang="en-US"><tig><term>Allow NFC use only when screen is unlocked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᎵᏍᎪᎸᏓ NFC ᎤᏙᏗ ᎾᏍᎩ ᎤᏩᏒ ᎠᏛᏰᎸᏔᏍᎦ ᎠᏍᏚᎢᏗ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready to transmit app content via NFC">
                <langSet xml:lang="en-US"><tig><term>Ready to transmit app content via NFC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏛᏅᎢᏍᏛᎾ ᏧᏛᏁᏟᏴᏍᏗ ᎬᏙᏗ ᏄᏍᏗᏓᏅ Ꮎ NFC</term></tig></langSet>
            </termEntry>
            <termEntry id="Unavailable because NFC is turned off">
                <langSet xml:lang="en-US"><tig><term>Unavailable because NFC is turned off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎤᏛᏅᎢᏍᏔᏅ ᏱᎩ ᏂᎬᏂᏏᏍᎬ ᎤᎵᏍᏚᎭ Ꮎ NFC</term></tig></langSet>
            </termEntry>
            <termEntry id="When this feature is turned on, you can beam app content to another NFC-capable device by holding the devices close together.">
                <langSet xml:lang="en-US"><tig><term>When this feature is turned on, you can beam app content to another NFC-capable device by holding the devices close together.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏎᏍᏙᏗ ᎠᏍᏚᎢᏗ ᏱᎩ, ᏱᏣᏍᏛᎦ ᎬᏙᏗ ᏄᏍᏗᏓᏅ ᏄᏛᎴᎢ NFC-ᎪᏢᎾ ᏥᏂᎬᏅᏗᏓᎾ ᏱᏣᏂᏴ ᏥᏂᎬᏗᏓᏂ ᎾᎥ ᏱᏂᏗᎬᏁᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Drag to take action">
                <langSet xml:lang="en-US"><tig><term>Drag to take action</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏏᏅᏍᏗ ᎾᎢ ᎠᎵᏖᎸᏅᎯ ᎨᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Just bring the devices together (typically back to back) and then tap your screen.">
                <langSet xml:lang="en-US"><tig><term>Just bring the devices together (typically back to back) and then tap your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᎭ ᏂᏛᎦ ᏥᏂᎬᏅᏗᏓᎾ (ᎣᏂᏗᎸ ᎢᏧᎳ ᏱᏂᏗᎬᏁᎳ) ᎯᏐᏍᏓᏃ ᎠᏛᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The app determines what gets beamed.">
                <langSet xml:lang="en-US"><tig><term>The app determines what gets beamed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎬᏙᏗ ᏛᏑᏰᏍᏏ ᎢᏳᏍᏗ ᎠᏨᏍᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Wi\u2011Fi">
                <langSet xml:lang="en-US"><tig><term>Use Wi\u2011Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏓ Wi\u2011Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Double tap to open a notification">
                <langSet xml:lang="en-US"><tig><term>Double tap to open a notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏗ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set up &amp; manage wireless access points">
                <langSet xml:lang="en-US"><tig><term>Set up &amp; manage wireless access points</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏘᎧᎲᎦ ᎠᎴ ᎦᏅᏏᏙᎯ ᏂᏓᏏᎳᏛ ᎠᏴᏍᏗ ᏙᏓᏓᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select Wi\u2011Fi">
                <langSet xml:lang="en-US"><tig><term>Select Wi\u2011Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏑᏰᎦ Wi\u2011Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning Wi\u2011Fi on\u2026">
                <langSet xml:lang="en-US"><tig><term>Turning Wi\u2011Fi on\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ Wi\u2011Fi gadu\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning off Wi\u2011Fi\u2026">
                <langSet xml:lang="en-US"><tig><term>Turning off Wi\u2011Fi\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎲᎦ Wi\u2011Fi\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="To use, select a network rating provider">
                <langSet xml:lang="en-US"><tig><term>To use, select a network rating provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ, ᎠᏑᏰᏍᏗ Ꭰ ᏧᎾᏚᏓᎵ ᎢᎦᎢ ᎤᏂᏅᏅᎢ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="In Airplane mode">
                <langSet xml:lang="en-US"><tig><term>In Airplane mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏳᎢ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Notify for public networks">
                <langSet xml:lang="en-US"><tig><term>Notify for public networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏘᏃᎯᏏ ᎾᏍᎩᎾᎢ ᎠᏰᎵ ᎤᏤᎵ ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Notify when a high\u2011quality public network is available">
                <langSet xml:lang="en-US"><tig><term>Notify when a high\u2011quality public network is available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏘᏃᎯᏏ ᎦᎸᎳᏗ\u2011 ᎢᏲᏍᏓ ᎠᏰᎵ ᎤᏤᎵ ᏓᏏᎸᏓ ᎤᏛᏅᎢᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Wi\u2011Fi automatically">
                <langSet xml:lang="en-US"><tig><term>Turn on Wi\u2011Fi automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ Wi\u2011Fi ᎤᏩᏌ ᏱᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unavailable because location is turned off.">
                <langSet xml:lang="en-US"><tig><term>Unavailable because location is turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎤᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎢᎬᏂᏏ ᎮᏙᎲᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="App claims to handle following links:">
                <langSet xml:lang="en-US"><tig><term>App claims to handle following links:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎤᏬᎯᏳᏒ ᎾᎢ ᏱᎬᏁᏗᎢ ᎠᏍᏓᏩᏛᏍᏗ ᏕᎫᏓᎸᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on location.">
                <langSet xml:lang="en-US"><tig><term>Turn on location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎮᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unavailable because Wi\u2011Fi scanning is turned off">
                <langSet xml:lang="en-US"><tig><term>Unavailable because Wi\u2011Fi scanning is turned off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎤᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎢᎬᏂᏏ Wi\u2011Fi ᏗᏟᎶᏍᏗᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Avoid poor connections">
                <langSet xml:lang="en-US"><tig><term>Avoid poor connections</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏅᏗᏍᏙᏗ ᎤᏲ ᏕᎫᏓᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatic time zone is off">
                <langSet xml:lang="en-US"><tig><term>Automatic time zone is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᎠᏥᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ ᎨᎡᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only use networks that have a good internet connection">
                <langSet xml:lang="en-US"><tig><term>Only use networks that have a good internet connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎲᏗᎮᏍᏗ ᏓᏏᎸᏓ ᎣᏍᏓ ᎠᏏᎳᏕᏫᏒᎢ ᏱᏗᎫᏓᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id=" has resumed the call">
                <langSet xml:lang="en-US"><tig><term> has resumed the call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎤᎭ ᎠᎴᏂᏐᏗᏍᎩ ᏥᎩ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically connect to high\u2011quality public networks">
                <langSet xml:lang="en-US"><tig><term>Automatically connect to high\u2011quality public networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᏅᏛᎦ ᏗᎫᏓᎳ ᎦᎸᎳᏗ\u2011 ᎢᏲᏍᏓ ᎠᏰᎵ ᎤᏤᎵ ᏓᏏᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use, select a compatible network rating provider">
                <langSet xml:lang="en-US"><tig><term>To use, select a compatible network rating provider</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏍᏛᎾ, ᎯᏑᏰᎦ ᏗᏙᎵᎩ ᏓᏏᎸᏓ ᏫᏛᏤᎸ ᎠᏁᏢᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Install certificates">
                <langSet xml:lang="en-US"><tig><term>Install certificates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏘᏅᏛᎦ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="To improve location accuracy, apps and services can still scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off.">
                <langSet xml:lang="en-US"><tig><term>To improve location accuracy, apps and services can still scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏛᏤᎳ ᎮᏙᎲᎢ ᏳᎾᏂᏘ, ᏗᎬᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎲᎵᏊ ᏱᏓᏟᎶᏍᏓ Wi\u2011Fi ᎠᏏᎸᏓᎢ ᎢᏳᏫ ᎨᏒᎢ, ᏍᏊ ᏯᏍᏚᎭ Wi\u2011Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="This can be used, for example, to improve location-based features and services.">
                <langSet xml:lang="en-US"><tig><term>This can be used, for example, to improve location-based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏟᎶᏍᏔᎾ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change this in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.">
                <langSet xml:lang="en-US"><tig><term>You can change this in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏁᏟᏴᎾ LINK_BEGINWi/u2011FiᏓᏟᎶᏍᏗ ᏕᎦᎧᎲLINK_END</term></tig></langSet>
            </termEntry>
            <termEntry id="To improve location accuracy, turn on Wi-Fi scanning in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.">
                <langSet xml:lang="en-US"><tig><term>To improve location accuracy, turn on Wi-Fi scanning in LINK_BEGINWi\u2011Fi scanning settingsLINK_END.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏛᏤᎳ ᎮᏙᎲᎢ ᏳᎾᏂᏗ, ᎯᏍᏚᎢ Wi-Fi ᏓᏟᎶᏍᏗ ᎭᏫᏂᏗᏢ LINK_BEGINWi/u2011Fi ᎠᏟᎶᏍᏗLINK_END</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t show again">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t show again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᏍᏗ \u2019 ᏥᏍᎩᎪᏩᏛᏛᎾ</term></tig></langSet>
