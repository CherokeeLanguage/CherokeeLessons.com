                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ, ᎢᏳᏓᎵᎭ ᏚᏙᏍᏛ ᏗᎾᏂᎩᏍᏗᏍᎩ, ᎾᏍᎩᎾᎢ ᎦᏁᏟᏴᏍᏓ ᎾᏍᎩ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎤᎾᎢ ᏣᏤᎵ Android ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴ ᎠᏓᏁᏗ ᏂᎯ ᎠᏴᏍᏗ ᎾᎾᎢ ᎾᏍᎩ ᏕᎦᎸᏛᎢ ᎠᏢ ᏗᎦᏎᏍᏙᏗ ᎥᎿᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ </term></tig></langSet>
            </termEntry>
            <termEntry id="Allow ^1 to move this audio file out of trash?">
                <langSet xml:lang="en-US"><tig><term>Allow ^1 to move this audio file out of trash?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ^1 ᎾᎢ ᎠᎲᏍᏗ ᎯᎠ ᎤᏃᏴᎬ ᎠᏍᏆᏂᎪᏙᏗ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow ^1 to move ^2 audio files out of trash?">
                <langSet xml:lang="en-US"><tig><term>Allow ^1 to move ^2 audio files out of trash?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ^1 ᎾᎢ ᎠᎲᏍᏗ ^2 ᎤᏃᏴᎬ ᏗᏍᏆᏂᎪᏙᏗ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Moving audio file out of trash…">
                <langSet xml:lang="en-US"><tig><term>Moving audio file out of trash…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᎦ ᎤᏃᏴᎬ ᎠᏍᏆᏂᎪᏙᏗ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Speakerphone enabled.">
                <langSet xml:lang="en-US"><tig><term>Speakerphone enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍpᎡᎠkᎡrpᎰᏁ ᎡᎾbᎴd.</term></tig></langSet>
            </termEntry>
            <termEntry id="Go to Personalize in the Moto app to create your custom themes.">
                <langSet xml:lang="en-US"><tig><term>Go to Personalize in the Moto app to create your custom themes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏅᏍᏗ ᎾᎢ ᎤᏩᏌ ᎤᏤᎵ ᏱᎬᏁᏗ ᎾᎿᎢ ᎾᏍᎩ ᎼᏙ ᎬᏙᏗ ᎾᎢ ᎪᏢᏗ ᏣᏤᎵ ᏄᏍᏛ ᎢᏳᎾᏛᏁᏗ ᏧᏓᏤᏟᏓ ᏗᎧᏃᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" will be allowed to interact with your notifications and access your Phone, SMS, Contacts and Calendar permissions.">
                <langSet xml:lang="en-US"><tig><term> will be allowed to interact with your notifications and access your Phone, SMS, Contacts and Calendar permissions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᎵᏍᎪᎸᏔᏅ ᎤᏪᎳᏗᏓᏍᏗ ᎬᏗ ᏣᏤᎵ ᏗᏓᏃᏣᎳᏁᎯ ᎠᎴ ᎠᏴᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ, SMS, ᏗᏟᏃᎮᏙᏗ ᎠᎴ ᏅᏓ ᏗᏎᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Flipping closed will end the call unless you’re using the speaker, a Bluetooth device, or a headset.">
                <langSet xml:lang="en-US"><tig><term>Flipping closed will end the call unless you’re using the speaker, a Bluetooth device, or a headset.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᏍᏆᏛᏍᏗ ᎠᏍᏚᎲᎦ ᎠᏎᎢ ᎠᏍᏆᏗᏍᏗ ᏫᎬᏔᏅᎢ ᎢᏳᏍᎩᏂ ᏂᎯ ᎾᏍᎩ ᎬᏗᏍᎬ ᎾᏍᎩ ᎦᏬᏂᏍᎩ, ᎾᏍᎩ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᎴᏃ ᏗᏟᏳᏦᎾᏗᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set as default">
                <langSet xml:lang="en-US"><tig><term>Set as default</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎧᎲᎦ ᎾᏍᎩ ᎤᏓᏄᎸᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This pattern applies to both video and voice calls, and you can change it in Settings.">
                <langSet xml:lang="en-US"><tig><term>This pattern applies to both video and voice calls, and you can change it in Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᏟᎶᏍᏙᏗ ᏂᏕᎦᎵᏍᏓ ᎾᎢ ᎢᏧᎳ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴ ᎧᏁᎬᎢ ᏫᏗᎬᏔᏅᎢ, ᎠᎴ ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch to unlock">
                <langSet xml:lang="en-US"><tig><term>Touch to unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎾᎢ ᎦᏐᎭᎾᎳᎩᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Change the font &amp; display size, adjust color or motion, or hear audio that lets you use your device without looking at the screen.">
                <langSet xml:lang="en-US"><tig><term>Change the font &amp; display size, adjust color or motion, or hear audio that lets you use your device without looking at the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᎠᏙᏪᎵᏍᎩ &amp; ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎢᎩᏓ, ᎦᏁᏟᏴᏍᏗ ᎠᏑᏫᏓ ᎠᎴᏃ ᎠᏓᏅᏏᏙᎲᎢ, ᎠᎴᏃ ᎠᏛᎪᏗ ᎤᏃᏴᎬᎢ ᎾᏍᎩᎾᎢ ᏣᎵᏍᎪᎸᏓᏁᎯ ᎬᏙᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏅᏠᏯᏍᏗᏍᎬᎾ ᎠᎦᏖᏃᎲᎩ ᎾᎿᎢ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to take the best care of your Razr’s folding display.">
                <langSet xml:lang="en-US"><tig><term>Learn how to take the best care of your Razr’s folding display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏰᎵ ᎾᏍᎩ ᏫᏓᏤᏢ ᏗᏘᏗᏍᏗ ᏣᏤᎵ ᎠᎵᏍᏣᎢ ᎠᏴᏈᏛᎥᏍᎩ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Audio effects lets you choose specific audio profiles for your headphones and Bluetooth speakers so you can always enjoy the best sound, no matter how you listen.">
                <langSet xml:lang="en-US"><tig><term>Audio effects lets you choose specific audio profiles for your headphones and Bluetooth speakers so you can always enjoy the best sound, no matter how you listen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏙᏓᎴᏤᎲᎩ ᏣᎵᏍᎪᎸᏓᏁᎯ ᎠᏑᏰᏍᏗ ᏗᏙᎳᎩ ᎤᏃᏴᎬ ᏧᏓᏟᎶᏍᏔᏅ ᎾᏍᎩᎾ ᏣᏤᎵ ᏗᏟᏳᏙᎾᏗᏍᏗ ᎠᎴ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏗᏂᏬᏂᏍᎩ ᎾᏍᎩ ᏂᎯ ᏰᎵᏊ ᏂᎪᎯᎸᎢ ᎠᎵᎮᎵᏍᏗ ᎾᏍᎩ ᏫᏓᏤᏢ ᎾᏍᎩ ᎤᏃᏴᎬ, Ꮭ ᎤᎵᏍᎨᏓ ᏙᎡᎵ ᏂᎯ ᎠᏛᏓᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When your device is unlocked, you can find shortcuts to your favorite contacts and apps by swiping left on the external display home screen.">
                <langSet xml:lang="en-US"><tig><term>When your device is unlocked, you can find shortcuts to your favorite contacts and apps by swiping left on the external display home screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩ ᎤᏂᏐᎭᎾᎳᏕᏗ, ᏂᎯ ᏰᎵᏊ ᏱᏩᏔ ᏍᏆᎳ ᎢᏗᎬᏁᎯ ᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᎠᎴ ᏗᎬᏙᏗ ᎦᏅᎦᎵᏗᏍᎬ ᎠᏍᎦᏂ ᎤᎾᎢ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Download complete">
                <langSet xml:lang="en-US"><tig><term>Download complete</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎠᏍᏆᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can adjust the order of the apps and contacts screens by going to Settings &gt; External display.">
                <langSet xml:lang="en-US"><tig><term>You can adjust the order of the apps and contacts screens by going to Settings &gt; External display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎣᏍᏛ ᎢᎬᏁᏗ ᎾᏍᎩ ᏗᏓᏁᎳᏅᎯ ᎥᎿᎢ ᎾᏍᎩ ᏗᎬᏙᏗ ᎠᎴ ᏗᏟᏃᎮᏙᏗ ᏓᏴᏙᎳᏛᎢ ᏄᏩᏅ ᏓᏰᏏ ᎾᎾᎢ ᏕᎦᎧᎲᎢ &gt; ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To adjust the keyboard height for more comfortable typing, go to Gboard settings &gt; Preferences &gt; Keyboard height.">
                <langSet xml:lang="en-US"><tig><term>To adjust the keyboard height for more comfortable typing, go to Gboard settings &gt; Preferences &gt; Keyboard height.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏄᏍᏛ ᎢᎬᏁᏗ ᎾᏍᎩ ᏗᏐᏅᏍᏙᏗ ᏂᎦᏛᎢ ᎾᏍᎩᎾ ᎤᏟ ᎢᎦᎢ ᎤᏦᎠᏎᏗ ᏂᎨᏒᎾ ᏗᏐᎥᏍᏙᏗ, ᎡᏅᏍᏗ ᎾᎾᎢ GᏯᏖᎾ ᏕᎦᎧᎲᎢ &gt; ᎤᏟ ᏕᎯᏰᎸᏍᎬᎢ &gt; ᏗᏐᏅᏍᏙᏗ ᏂᎦᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Then, drag the bar to your preferred height.">
                <langSet xml:lang="en-US"><tig><term>Then, drag the bar to your preferred height.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎿᏉᏃ, ᎦᎾᏏᏅᏍᏗ ᎾᏍᎩ ᎦᎾᎸ ᎾᎢ ᏂᏨᏅ ᎤᏟ ᎠᏰᎸᏅ ᏂᎦᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Files successfully transferred to []">
                <langSet xml:lang="en-US"><tig><term>Files successfully transferred to []</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏍᏆᏂᎪᏙᏗ ᏄᏓᏄᎸᏅᎾᏊ ᏫᏚᏓᏲᎯᏍᏎᎸ ᎾᎿᎢ []</term></tig></langSet>
            </termEntry>
            <termEntry id="When you start a task on the external display, you can flip open for a more detailed experience on the internal display.">
                <langSet xml:lang="en-US"><tig><term>When you start a task on the external display, you can flip open for a more detailed experience on the internal display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎠᏂᎩᏍᏗᏍᎬ ᎤᎾᎢ ᏙᏯᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᏂᎯ ᏰᎵᏊ ᏗᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᎾᏍᎩᎾ ᎤᏟ ᎢᎦᎢ ᎠᏎᎸᎩ ᎠᎦᏙᎲᏒᎢ ᎤᎾᎢ ᎾᏍᎩ ᎭᏫᏂ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you’re using the internal display, you can close the flip to end a task and start something else.">
                <langSet xml:lang="en-US"><tig><term>When you’re using the internal display, you can close the flip to end a task and start something else.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᎬᏗᏍᎬ ᎾᏍᎩ ᎭᏫᏂ ᎬᏂᎨᎢ ᏱᎬᏁᏗ, ᏂᎯ ᏰᎵᏊ ᎯᏍᏚᎲᎦ ᎾᏍᎩ ᏗᏁᏍᏆᏕᎦ ᎾᎢ ᎠᏍᏆᏗᏍᏗ ᎠᎴ ᎭᏂᎩᏍᏙᏗ ᎪᎱᏍᏗ ᏄᏓᎴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="With wireless power sharing, you can charge a friend's phone or another compatible device anytime without plugging in.">
                <langSet xml:lang="en-US"><tig><term>With wireless power sharing, you can charge a friend's phone or another compatible device anytime without plugging in.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏠᏯᏍᏗ ᎾᏏᎳᏛᎾ ᎤᏟᏂᎩᏓ ᎠᏯᏙᎯᏍᏗ, ᏂᎯ ᏰᎵᏊ ᎦᏕᏟᏴᏍᏗ ᎣᎩᎾᎵᎢ ᎤᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴᏃ ᏅᏩᏓᎴᎢ ᏗᏙᎵᎩ ᏥᏂᎬᏅᏗᏓᎾ ᏱᏂᎦᎵᏍᏗᏊ ᎢᏴ ᏄᏠᏯᏍᏛᎾ ᎫᏓᎸᎲᏍᎬᎢ ᎾᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow  to find, connect to, and determine the relative position of nearby devices?">
                <langSet xml:lang="en-US"><tig><term>Allow  to find, connect to, and determine the relative position of nearby devices?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ  ᎾᎢ ᎯᏩᏔ, ᎫᏓᎸᎢ ᎾᎾᎢ, ᎠᎴ ᏗᎫᎪᏙᏗ ᎾᏍᎩ ᎤᏠᏯᎨᏍᏗ ᎾᎿ ᎦᏙᎬ ᎥᎿᎢ ᎾᎥᏂᎨᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Please unlock your phone after pressing allow">
                <langSet xml:lang="en-US"><tig><term>Please unlock your phone after pressing allow</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎤᎶᏐᏅ ᎠᏐᎥᏍᏗᏍᎬ ᎠᎵᏍᎪᎸᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moving ^1 photos out of trash…">
                <langSet xml:lang="en-US"><tig><term>Moving ^1 photos out of trash…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᎦ ^1 ᏓᏓᏟᎶᏍᏔᏅᎯ ᏙᏯᏗᏨ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Moving ^1 audio files out of trash…">
                <langSet xml:lang="en-US"><tig><term>Moving ^1 audio files out of trash…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᎦ ^1 ᎤᏃᏴᎬ ᏗᏍᏆᏂᎪᏙᏗ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Moving video out of trash…">
                <langSet xml:lang="en-US"><tig><term>Moving video out of trash…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᎦ ᎠᏓᏴᎳᏛᏍᎩ ᏙᏯᏗᏢ ᎥᎿᎢ ᎤᏲ ᏩᏗᏅᏗ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't talk now.">
                <langSet xml:lang="en-US"><tig><term>Can't talk now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎠn't Ꮤlk Ꮓw.</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to map your PC drive before sharing files between your phone and PC">
                <langSet xml:lang="en-US"><tig><term>You need to map your PC drive before sharing files between your phone and PC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᏂᎬᎾᏅ ᏓᏟᎶᏍᏛ ᏂᏨᎤᎢ PC ᎠᏱᎸᏍᏗ ᎠᏏᏅ ᎠᏯᏙᎯᏍᏗᏍᎬ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏰᏟ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᎴ PC</term></tig></langSet>
            </termEntry>
            <termEntry id="Power touch">
                <langSet xml:lang="en-US"><tig><term>Power touch</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏂᎩᏓ ᎠᏒᏂᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Many apps provide shortcuts you can access by pressing and holding on the app icon.">
                <langSet xml:lang="en-US"><tig><term>Many apps provide shortcuts you can access by pressing and holding on the app icon.</term></tig></langSet>
