            </termEntry>
            <termEntry id="Want to see search results from your favorite apps?">
                <langSet xml:lang="en-US"><tig><term>Want to see search results from your favorite apps?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᎵᏗ ᎠᎪᏛ ᎠᏱᏍᏗ ᏂᏚᎵᏍᏔᏅ ᎾᏍᎩᎾ ᏂᎯᏣᏤᎵ ᏫᏗᏣᎸᏉᏛ ᏗᎬᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the banner to enable in-App Search.">
                <langSet xml:lang="en-US"><tig><term>Tap the banner to enable in-App Search.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ Ꮎ ᏕᎦᏃᎶᎯ ᏯᎵᏍᎪᎸᏗ ᎾᎿᎢ-ᎬᏙᏗ ᎠᏱᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After you unlock your device by another method, you can use Face unlock again.">
                <langSet xml:lang="en-US"><tig><term>After you unlock your device by another method, you can use Face unlock again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏕᏐᏅ ᏂᎯ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏛ ᏅᏩᏓᎴᎢ ᎢᎬᏁᏗ, ᏂᎯ ᏰᎵᏊ ᎬᏙᏓ ᎤᎧᏛ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device restart needed">
                <langSet xml:lang="en-US"><tig><term>Device restart needed</term></tig></langSet>
