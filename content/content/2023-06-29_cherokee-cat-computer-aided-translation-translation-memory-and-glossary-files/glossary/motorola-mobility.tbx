                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ VoLTE</term></tig></langSet>
            </termEntry>
            <termEntry id="GSM OnlySaves battery">
                <langSet xml:lang="en-US"><tig><term>GSM OnlySaves battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ OnlyᎠᎵᏏᏅᏓ ᎠᎾᎦᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Forwarding routes (e.g. 10.0.0.0/8)">
                <langSet xml:lang="en-US"><tig><term>Forwarding routes (e.g. 10.0.0.0/8)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎬᏱᏗᏜ ᎠᏂᎩᏍᏗᏍᎩ ᎦᎶᎯᏍᏗ (e.g. 10.0.0.0/8)</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from the bottom of the screen with 3 fingers.">
                <langSet xml:lang="en-US"><tig><term>Swipe up from the bottom of the screen with 3 fingers.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ the ᎡᎳᏗᏢ of the ᎠᏴᏙᎳᏛᎢ Ꮻth 3 ᏕᎦᏰᏌᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb is on">
