                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎠᎵᏍᎪᎸᏔᏅ ᏗᎧᏃᎮᏍᎩ ᏚᏃᏴᎬᎢ, ᏣᎦᏛᎲᎦ ᎾᏍᎩᎾᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩ ᎦᎧᎲᎢ ᎾᎢᎦᏃᏟᏍᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="You can adjust settings to allow your friends, family, or other contacts to reach you.">
                <langSet xml:lang="en-US"><tig><term>You can adjust settings to allow your friends, family, or other contacts to reach you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᏕᎦᎧᎲᎢ ᎾᎢ ᏔᎵᏍᎪᎸᏓᏁᏗ ᏗᏣᏤᎵ ᏗᏣᎵᎢ, ᏏᏓᏁᎸᎢ, ᎠᎴᏃ ᏐᎢ ᏗᏟᏃᎮᏙᏗ ᎾᎢ ᏱᎨᏣᎷᏥᏍᏏ.</term></tig></langSet>
            </termEntry>
