            <termEntry id="National warning messages. Can't be turned off.">
                <langSet xml:lang="en-US"><tig><term>National warning messages. Can't be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎬᎾᏛᎢ ᎠᏓᏕᏯᏔᎲᏍᎩ ᏗᎪᎵᏰᏗ. ᎨᏍᏗ ᏰᎵ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data coding scheme:">
