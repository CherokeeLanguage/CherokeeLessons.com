            <termEntry id="There aren't any older files to remove. To make space, remove recent photos, videos, and apps.">
                <langSet xml:lang="en-US"><tig><term>There aren't any older files to remove. To make space, remove recent photos, videos, and apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿᎢ ᎨᎡᎩ ᎥᏝ ᎾᏂᎥᏉ ᎤᏓᏂᎳᎨ ᏗᏍᏆᏂᎪᏙᏗ ᎾᎿᎢ ᎠᎲᏍᏗ. ᎾᎿᎢ ᎪᏒᏗ ᎤᏜᏅᏛ, ᎠᎲᏍᏗ ᎾᏞᎬ ᏗᏥᎶᏍᏔᏅᎯ, ᏗᏓᏴᎳᏛᏍᎩ, ᏃᎴ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Real Time Streaming Protocol">
                <langSet xml:lang="en-US"><tig><term>Real Time Streaming Protocol</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳ ᎠᏥᎢᎵᏒ ᏃᏊᏥᎩ ᎠᏥᎢᎵᏒᎢ ᎢᏯᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Postcard service address:\u0020">
                <langSet xml:lang="en-US"><tig><term>Postcard service address:\u0020</term></tig></langSet>
