            <termEntry id="Because of its importance, this update will install automatically using mobile data on ">
                <langSet xml:lang="en-US"><tig><term>Because of its importance, this update will install automatically using mobile data on </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎾᎿ ᎨᎡᎢ ᏭᎵᏍᎨᏗᏴ, ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎯᏘᏅᎦ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space. Once done, you can go to Settings &gt; System updates to start the update any time.">
                <langSet xml:lang="en-US"><tig><term>This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space. Once done, you can go to Settings &gt; System updates to start the update any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎᏳᎾᏛᏁᏗ  ᎾᎿ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏍᏆᏂᎪᏙᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎰᏩᏊ ᎠᏍᎪᎸᏗᏍᏗ ᎬᏔᏅᏂᎨᏒᎾ ᏗᎬᏙᏗ ᏃᎴ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎤᎿᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎤᏚᏓᎴᏗ  ᎾᎿ ᎤᏜᏅᏛᎯ. ᏌᏊᏊ ᎠᏍᏆᏛᎯ, ᏂᎯ ᏰᎵᏯ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᎭᎴᎾ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Verifying update…">
                <langSet xml:lang="en-US"><tig><term>Verifying update…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᎯᏳᏓ ᏗᎪᏒᎯᏌᏅᎯ ...</term></tig></langSet>
            </termEntry>
            <termEntry id="This update must install before ">
                <langSet xml:lang="en-US"><tig><term>This update must install before </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎯᏘᏅᎦ ᎠᏏᏅ </term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to update. The update version does not match your phone. Please download the correct version for your phone and try again.">
                <langSet xml:lang="en-US"><tig><term>Failed to update. The update version does not match your phone. Please download the correct version for your phone and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎾᎿᎢ ᏗᎪᏒᎯᏌᏅᎯ. ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᏄᏓᎴᏒᎢ ᏝᏍᏗ ᏗᏙᎵᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ. ᎰᏩᏊ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᏥᎩ ᏚᏳᎪᏛᎢ ᏄᏓᎴᏒᎢ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The update package being downloaded is not compatible with the current software version on the device.">
                <langSet xml:lang="en-US"><tig><term>The update package being downloaded is not compatible with the current software version on the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎦᏇᏅᏛ ᎠᎴᏂᏙᎲ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᎨᎡᎢ ᎥᏝ ᏗᏙᎸᎩ ᎬᏗ ᏥᎩ ᏃᏊ ᏥᎩ ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᏄᏓᎴᏒᎢ ᎤᎿᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A version mismatch has occurred. An update will occur again. If one is available, you will be prompted.">
                <langSet xml:lang="en-US"><tig><term>A version mismatch has occurred. An update will occur again. If one is available, you will be prompted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏄᏓᎴᏒᎢ ᏂᏓᏙᎵᎬᎾ ᏂᏚᏩᎿ ᏄᎵᏍᏔᏅᎩ. Ꭰ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᏄᎵᏍᏔᏅ ᏏᏊ. ᎨᎡᎢ ᏌᏇ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ, ᏂᎯ ᎠᏎ ᎨᎡᎢ ᏄᎵᏍᏛᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Update to the latest software">
                <langSet xml:lang="en-US"><tig><term>Update to the latest software</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎾᎿᎢ ᏥᎩ ᎢᏤᎯᎨᎢᏍᏗ ᏩᏂᎨ ᎦᎾᏗᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please restart now">
                <langSet xml:lang="en-US"><tig><term>Please restart now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᏃᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Initializing software update process">
                <langSet xml:lang="en-US"><tig><term>Initializing software update process</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎴᏂᏍᎬᎩ ᎦᎾᏗᏅᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device will restart in  second to complete the update.">
                <langSet xml:lang="en-US"><tig><term>Your device will restart in  second to complete the update.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎾᎿ  ᏔᎵᏁᏃ ᎾᎿᎢ ᎧᎵᎢ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Applying update… (Step  of ) \u0020">
                <langSet xml:lang="en-US"><tig><term>Applying update… (Step  of ) \u0020</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏔᏲᎯᎮᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ… (ᎠᎳᏏᏗ  ᎾᎿ ) \u0020</term></tig></langSet>
            </termEntry>
            <termEntry id="Update in progress">
                <langSet xml:lang="en-US"><tig><term>Update in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎾᎿ ᎠᎵᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Updates keep your device safe and improve its performance.">
                <langSet xml:lang="en-US"><tig><term>Updates keep your device safe and improve its performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎠᏍᏆᏂᎪᏙᏗᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᎦᎾᏰᎬᎾ ᎠᎴ ᏦᎦᏤᎳᏍᏙᏗ ᎨᎡᎢ ᎾᎾᏛᏁᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System update will be installed on">
                <langSet xml:lang="en-US"><tig><term>System update will be installed on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᎦᏘᏅᏔᏅ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Required memory is available for the update">
                <langSet xml:lang="en-US"><tig><term>Required memory is available for the update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏯᏛᏁᏗ ᎠᏅᏓᏗᏍᏙ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎬᏩᏟ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="An update is currently being downloaded.You will be notified when the download is complete.">
                <langSet xml:lang="en-US"><tig><term>An update is currently being downloaded.You will be notified when the download is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᏃᏊ ᏥᎩ ᎠᎴᏂᏙᎲ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ.ᏂᎯ ᎠᏎ ᎨᎡᎢ ᎤᏓᏃᎯᏎᎸ ᎢᏳᏃ ᏥᎩ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎨᎡᎢ ᎧᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Copying update">
                <langSet xml:lang="en-US"><tig><term>Copying update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᎶᏍᏔᏅᎯ ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you'd like to install this update later, go to Settings &gt; System updates">
                <langSet xml:lang="en-US"><tig><term>If you'd like to install this update later, go to Settings &gt; System updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎯᏘᏅᎦ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎪᎯᏴᎢ, Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart updates help your device run safely and efficiently. When you turn them on, all future security updates and bug fixes will automatically download when they're available. After an update is downloaded, your device will restart at the time you choose below.">
                <langSet xml:lang="en-US"><tig><term>Smart updates help your device run safely and efficiently. When you turn them on, all future security updates and bug fixes will automatically download when they're available. After an update is downloaded, your device will restart at the time you choose below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ ᎠᎵᏍᏕᎸᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᎾᏫᏍᏗ ᎤᏓᎵᏏᏅᏓ ᏃᎴ ᎢᏳᎵᏍᏙᏗ ᏂᎦᎵᏍᏗᏍᎬᎩ. ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎢᏯᏂᎢ ᎤᎿᎢ, ᏂᎦᏚ ᎤᏩᎫᏗᏗᏒ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ ᏃᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᏳᏃ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ. ᎤᎶᏐᏅ Ꭰ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎤᎿᎢ ᏥᎩ ᎠᏟᎵᏒᎢ ᏂᎯ ᏣᏑᏰᏍᏗ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device couldn't install this update. Use the Software Upgrade Assistant tool to install. Tap for more info.">
                <langSet xml:lang="en-US"><tig><term>Your device couldn't install this update. Use the Software Upgrade Assistant tool to install. Tap for more info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎯᏘᏅᎦ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ. ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎦᎾᏗᏅᏗ ᏦᏢᎯᏐᏗ ᎠᎵᏍᏕᎵᏍᎩ ᎬᏔᏂᏓᏍᏗ ᎾᎿᎢ ᎯᏘᏅᎦ. ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎤᎬᏩᏟ ᎤᎪᏗᏊ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space.">
                <langSet xml:lang="en-US"><tig><term>This update requires  of available storage on your device. Please delete unused apps or move your photos and videos to another storage device to free up  of space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎᏳᎾᏛᏁᏗ  ᎾᎿ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏍᏆᏂᎪᏙᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᎰᏩᏊ ᎠᏍᎪᎸᏗᏍᏗ ᎬᏔᏅᏂᎨᏒᎾ ᏗᎬᏙᏗ ᏃᎴ ᎠᎲᏍᏗ ᏂᏨᎤᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎤᎿᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎾᎿ ᎤᏜᏅᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Update canceled by server">
                <langSet xml:lang="en-US"><tig><term>Update canceled by server</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎᏒᏓ ᎬᏗ ᎠᏯᏙᎯᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off smart updates?">
                <langSet xml:lang="en-US"><tig><term>Turn off smart updates?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="This update will be automatically installed on .">
                <langSet xml:lang="en-US"><tig><term>This update will be automatically installed on .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎦᏘᏅᏔᏅ ᎾᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Software update is downloading to SD Card. Please don't remove the SD Card Until installation is complete.">
                <langSet xml:lang="en-US"><tig><term>Software update is downloading to SD Card. Please don't remove the SD Card Until installation is complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏗᏅᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬᎢ ᎾᎿᎢ SD ᏆᎾᏲᏍᏗ. ᎰᏩᏊ ᏝᏍᏗ ᏱᎬᎾᏕᏍᏗ ᏥᎩ SD ᏆᎾᏲᏍᏗ ᎩᎳ ᎦᏘᏅᏔᏅ ᎨᎡᎢ ᎧᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can continue using your device while the update installs">
                <langSet xml:lang="en-US"><tig><term>You can continue using your device while the update installs</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎯᎸᏍᏗ ᎬᏗᎭ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎯᏳᎢ ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎯᏘᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connectivity has been lost. Please try again by manually checking for updates via Phone settings.">
                <langSet xml:lang="en-US"><tig><term>Connectivity has been lost. Please try again by manually checking for updates via Phone settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎫᏓᎸᏗᎢ ᏂᎦᎵᏍᏓ ᎤᏂᏲᎱᏎᎸ. ᎰᏩᏊ ᏏᏊ ᏥᎭᏁᎸᏓ ᎬᏗ ᎣᏩᏌ ᏱᎬᏁᏗ ᎠᎪᎵᏰᎠ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏐᏗ ᎤᎶᏒ ᏗᏟᏃᎮᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System update is blocked. Please contact your device admin for more info.">
                <langSet xml:lang="en-US"><tig><term>System update is blocked. Please contact your device admin for more info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎦᏐᎭᎾᎳᏓ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᎤᎬᏩᏟ ᎤᏥ ᎢᎦᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The update could not be properly validated. Please try again.">
                <langSet xml:lang="en-US"><tig><term>The update could not be properly validated. Please try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏗᎪᏒᎯᏌᏅᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᏗᏙᎳᏤᎩ ᎪᎯᏳᏙᏗ. ᎰᏩᏊ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Because this is an important update, your device will restart automatically on  if you haven't restarted by then.">
                <langSet xml:lang="en-US"><tig><term>Because this is an important update, your device will restart automatically on  if you haven't restarted by then.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎯᎠ ᎨᎡᎢ Ꭰ ᎤᎵᏍᎨᏓ ᏗᎪᏒᎯᏌᏅᎯ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎤᎿᎢ  ᎨᎡᎢ ᏂᎯ ᎤᎭ ᎥᏝ ᏥᎭᏂᎩᏍᏓ by ᎾᏉᏃ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restart now to update">
                <langSet xml:lang="en-US"><tig><term>Restart now to update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎭᏂᎩᏍᏓ Ꭷ ᎾᎿᎢ ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Update failed">
                <langSet xml:lang="en-US"><tig><term>Update failed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎤᏓᏄᎸᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="There was an update error. No changes have been made.">
                <langSet xml:lang="en-US"><tig><term>There was an update error. No changes have been made.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ Ꭰ ᏗᎪᏒᎯᏌᏅᎯ ᏓᏓᎴᎬᎢ. Ꮭ ᏗᎦᏁᏟᏴᏓ ᎤᏒᎦᎵ ᏱᎨᏎ ᎪᏢᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you'd like to get this update later, go to Settings &gt; System updates.">
                <langSet xml:lang="en-US"><tig><term>If you'd like to get this update later, go to Settings &gt; System updates.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎠᎩᏍᏗ ᎯᎠ ᏗᎪᏒᎯᏌᏅᎯ ᎪᎯᏴᎢ, Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Update Successful">
                <langSet xml:lang="en-US"><tig><term>Update Successful</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᏄᏓᏄᎸᏅᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="A system update is ready to install">
                <langSet xml:lang="en-US"><tig><term>A system update is ready to install</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎯᏘᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure you want to turn off smart updates?">
                <langSet xml:lang="en-US"><tig><term>Are you sure you want to turn off smart updates?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎡᎩ ᏂᎯ ᎤᏙᎯᏳ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎠᏍᏚᏗ ᎠᏌᎹᏗ ᏗᎪᏢᎯᏐᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Check your Wi-Fi or mobile data connection and try again.">
                <langSet xml:lang="en-US"><tig><term>Check your Wi-Fi or mobile data connection and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᏂᏨᎤᎢ Wi-Fi ᏃᎴ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᏃᎴ ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you dont install this system update soon, you will miss out on important security updates, as well as new features and bug fixes.">
                <langSet xml:lang="en-US"><tig><term>If you dont install this system update soon, you will miss out on important security updates, as well as new features and bug fixes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᏝᏍᏗ ᎯᏘᏅᎦ ᎯᎠ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏒᎯᏌᏅᎯ ᎾᏞᎬᏉ, ᏂᎯ ᎠᏎ ᎦᏅᏗᏍᏗ ᎦᏅᎪᏫᏛ ᎤᎿᎢ ᎤᎵᏍᎨᏓ ᏧᎾᎦᏎᏍᏗ ᏗᎪᏢᎯᏐᏗ, ᎤᎿᎢ ᎣᏍᏓ ᎤᎿᎢ ᏗᏤ ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᏨᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Security update will be installed on">
                <langSet xml:lang="en-US"><tig><term>Security update will be installed on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᎦᏎᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᎦᏘᏅᏔᏅ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Critical update">
                <langSet xml:lang="en-US"><tig><term>Critical update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏢᏲᎵᏍᏗ ᏗᎪᏒᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor with your finger and remove it after you feel a vibration. Touch gently to avoid pressing the power key.">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor with your finger and remove it after you feel a vibration. Touch gently to avoid pressing the power key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᏩᏘᏍᎩ ᏣᏰᏌᏛ ᎬᏗ ᎠᎴ ᎯᎲᎦ ᎪᎯᏴᎢ ᎠᎵᏖᎸᏗ ᎭᏕᎶᎰᏍᎬ. ᎭᏒᏂᎦ ᏧᏓᎴᏅᏓ ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎠᏐᎥᏍᏗᏍᎬ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock with your fingerprint">
                <langSet xml:lang="en-US"><tig><term>Unlock with your fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩ ᏄᏐᏯᏍᏛᎾ ᎬᏗᎭ ᏣᏰᏌᏛᎢ ᏅᏙᏪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to modify the Motorola system settings">
                <langSet xml:lang="en-US"><tig><term>Allows the app to modify the Motorola system settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎵᏗ Ꮎ ᎬᏙᏗ ᎤᏃᎸᎯᏐᏗ Motorola ᏄᏍᏗᏛᏅᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Modify Motorola system settings">
                <langSet xml:lang="en-US"><tig><term>Modify Motorola system settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏒᎯᏐᏗ Motorola ᏄᏍᏗᏛᏅᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Privacy Policy">
                <langSet xml:lang="en-US"><tig><term>Privacy Policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Charge more efficiently to keep your battery healthy">
                <langSet xml:lang="en-US"><tig><term>Charge more efficiently to keep your battery healthy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᏗᏍᏔᏅᎢ ᎤᏥ ᎢᎦᎢ ᏓᏤᏢ ᎢᏳᎵᏍᏙᏗᎢ ᎾᎿᎢ ᎠᏍᏆᏂᎪᏙᏗᎢ ᎠᎾᎦᎵᏍᎩ ᏙᎯ ᎠᏓᏅᏖᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="That didn't work. Try again.">
                <langSet xml:lang="en-US"><tig><term>That didn't work. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᎢ Ꮭ ᏱᏚᏂᎸᏫᏍᏓᏏ. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn off this feature anytime by tapping &quot;Settings&quot; on the Overcharge protection notification. You can also go to Settings &gt; Battery.">
                <langSet xml:lang="en-US"><tig><term>You can turn off this feature anytime by tapping "Settings" on the Overcharge protection notification. You can also go to Settings &gt; Battery.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏍᏚᏗ ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᎢᎸᎯᏳ ᎬᏗ ᎤᏟᏍᏓ ᎠᏒᏂᎸ "ᏕᎦᎧᎲᎢ" ᎤᎿᎢ ᏥᎩ ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᎠᏓᏃᏣᎳᏁᎯ. ᏂᎯ ᏰᎵᏯ ᎾᏍᏊ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᎠᎾᎦᎵᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Play">
                <langSet xml:lang="en-US"><tig><term>Play</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip the phone over to enable Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>Flip the phone over to enable Do Not Disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏁᏍᏆᏕᎦ ᏥᎩ ᏗᏟᏃᎮᏗ ᎢᏴᏛ ᎾᎿᎢ ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᏤᏍᏗ ᏯᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock your phone lifting it and looking at the screen">
                <langSet xml:lang="en-US"><tig><term>Unlock your phone lifting it and looking at the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎳᏃᎮᏗ ᎤᏂᏐᎭᎾᎸᏗ ᏂᎦᏗᏳ ᎠᎴ ᎠᏰᏙᎳᏛᎢ ᎠᎦᏘᏍᎬ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press and hold the volume up or down button to change tracks when the screen is off">
                <langSet xml:lang="en-US"><tig><term>Press and hold the volume up or down button to change tracks when the screen is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᎾᎯᏍᏓ ᎤᏃᏴᎬᎢ ᎦᎸᎳᏗ ᎠᎴ ᎡᎳᏗ ᎦᏛᏗ ᎾᎿᎢ ᎯᏁᏟᏴᎾ ᎤᏔᏏᏄᏱ ᎢᏳᏃ ᎠᏍᏚᏗ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharge protection">
                <langSet xml:lang="en-US"><tig><term>Overcharge protection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᏓᎵᏍᎦᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick capture lets you open the camera with just two twists of your wrist">
                <langSet xml:lang="en-US"><tig><term>Quick capture lets you open the camera with just two twists of your wrist</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏣᏄᎳ ᏔᏥᎶᏍᏓ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏂᎯ ᎯᏍᏚᎢ ᎬᏗ ᏚᏳᎪᏛᏉ ᏔᎵ ᎠᏓᏄᏖᏲᎭ ᏣᏤᎵ ᎧᏯᏌᏝ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Three finger screenshot">
                <langSet xml:lang="en-US"><tig><term>Three finger screenshot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎢ ᏕᎦᏰᏌᏛ ᎠᏴᏙᎳᏛᎢ ᏗᏥᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Never miss a moment">
                <langSet xml:lang="en-US"><tig><term>Never miss a moment</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏥᎯᏅᏓ ᎾᏍᎩ ᏄᎵᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device learns your charging patterns and predicts how long it\’s usually plugged in. After establishing a pattern, it charges the battery to  and then waits to charge the final  until shortly before you unplug. Reducing the time spent charging over  puts less strain on your battery.When Optimized charging is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.">
                <langSet xml:lang="en-US"><tig><term>Your device learns your charging patterns and predicts how long it\’s usually plugged in. After establishing a pattern, it charges the battery to  and then waits to charge the final  until shortly before you unplug. Reducing the time spent charging over  puts less strain on your battery.When Optimized charging is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᏣᏤᎵ ᎠᏕᎶᏆᏍᏗ ᏓᎬᏩᎶᏗᏍᎬᎢ ᏧᎾᎶᎢᏓ ᏃᎴ ᎨᏴ ᏩᎪᏩᏛᏗ ᏙᎡᎵ ᎢᎪᎯᏓ ᎨᎡᎢ ᎤᏐᏱᎭ ᎠᏍᏚᏙᏗ ᎾᎿ. ᎤᎶᏐᏅ ᎠᏃᏒᏍᎬ Ꭰ ᎤᎾᎶᎢᏓ, ᎨᎡᎢ ᏓᎬᏩᎶᏗᏍᎬ ᏥᎩ ᎠᎾᎦᎵᏍᎩ ᎾᎿᎢ  ᏃᎴ ᎾᏉᏃ ᎯᎦᏘᏓ ᎾᎿᎢ ᎬᏂᏗᏍᏔᏅᎢ ᏥᎩ ᎤᎵᏍᏆᏛᎯ  ᎩᎳ ᏂᎪᎯᎸᎾᏉ ᎠᏏᏅ ᏂᎯ ᎫᏓᎴᏍᎪ. ᎠᎦᏲᎳᎨ ᏥᎩ ᎠᏥᎢᎵᏒ ᎤᏂᏩᏒᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎢᏴᏛ  ᏫᏓᎲᏍᎬ ᎦᏲᎵᎨ ᎢᏥᎿᏐᎸᏗᏍᎩ ᎤᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏣᏤᎵ.ᎢᏳᏃ ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ, ᏂᎯ ᎠᏎ ᎠᎪᏩᏛᏗ  ᎾᎿ ᏥᎩ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᏃᎴ ᎠᏓᏃᏣᎳᏁᎯ ᎠᏎ ᎦᎭᏛᏗ ᎾᎿᎢ ᏥᎩ ᏩᎦᎸᎳᏗᏴ ᎾᎿ ᎠᏓᏃᏣᎳᏁᎯ ᏣᏤᎵ ᏓᏎᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="After editing, you can share your screenshot or delete it and try again">
                <langSet xml:lang="en-US"><tig><term>After editing, you can share your screenshot or delete it and try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᎦᏁᏟᏴᎢ, ᏂᎯ ᏰᎵᏯ ᎠᏯᏙᏍᏗᎢ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎠᎴ ᎠᏍᎪᎸᏗᏍᏗ ᎨᎡᎢ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="With Play, Moto provides the tools you need for more engaging and immersive entertainment.">
                <langSet xml:lang="en-US"><tig><term>With Play, Moto provides the tools you need for more engaging and immersive entertainment.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗ Play, Moto ᎠᏓᏁᎳᏅ ᏗᎬᏔᏂᏓᏍᏗ ᏂᎯ ᎤᏚᎸᏓ ᎤᎪᏕᏍᏗᏃ ᎤᎵᎶᎯ ᎠᎴ ᎦᏃᏴᏘᏍᏙᏗ ᎤᎾᏛᏁᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart &amp; adaptive">
                <langSet xml:lang="en-US"><tig><term>Smart &amp; adaptive</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ &amp; ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block Moto Actions">
                <langSet xml:lang="en-US"><tig><term>Block Moto Actions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏚᏓ Moto ᎢᏗᏛᏁᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch and hold on the screen with three of your fingertips to capture a screenshot">
                <langSet xml:lang="en-US"><tig><term>Touch and hold on the screen with three of your fingertips to capture a screenshot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᏂᎬᏉ ᎤᎾᎢ ᎠᏰᏙᎳᏛᎢ ᏦᎢ ᏣᏤᎵ ᎦᏰᏌᏛ ᎦᏅᎯᏗᏍᎩ ᎾᎿᎢ ᎦᏂᏴᏗ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Play">
                <langSet xml:lang="en-US"><tig><term>Play</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting opens the rear camera">
                <langSet xml:lang="en-US"><tig><term>Twisting opens the rear camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏓᏍᏚᎢ ᏥᎩ ᎣᏂᏗᏨ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick capture">
                <langSet xml:lang="en-US"><tig><term>Quick capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎦᏂᏱᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Front">
                <langSet xml:lang="en-US"><tig><term>Front</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᏱᏗᏢ</term></tig></langSet>
            </termEntry>
            <termEntry id="That same gesture also lets you switch between the rear and selfie cameras">
                <langSet xml:lang="en-US"><tig><term>That same gesture also lets you switch between the rear and selfie cameras</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏍᎩᎾ ᎤᏠᏱ ᏧᏬᏯᏂᏍᎩ ᎾᏍᏊ ᏗᎵᏍᎪᎸᏔᏅ ᏂᎯ ᎦᏁᏟᏴᏍᏗ ᎤᏜᏅᏛ ᏥᎩ ᎣᏂᏗᏨ ᏃᎴ ᎣᏩᏌ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏟᎶᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Limit charge after 3 days of continuous charging">
                <langSet xml:lang="en-US"><tig><term>Limit charge after 3 days of continuous charging</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎯ ᎬᏂᏗᏍᏔᏅᎢ ᎤᎶᏐᏅ 3 ᏧᏒᎯᏓ ᏫᎬᎵᏱᎵᏒ ᏓᎬᏩᎶᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Almost. Try again.">
                <langSet xml:lang="en-US"><tig><term>Almost. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥᏂᎨᏍᏗ. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Do Not Disturb by turning the phone face down. This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>Turn on Do Not Disturb by turning the phone face down. This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏞᏍᏗ ᏣᏓᏕᏯᏙᏔᏅᎢ ᎬᏗ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᎡᎳᏗᏟ ᎯᎦᏔᎲᏍᏓ ᏭᎧᏛᎢ. ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᏃᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To keep your battery healthy and prevent long-term overcharging (the amount of time spent charging between  and ) charging is limited to  until your device is unplugged.When Overcharge protection is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.">
                <langSet xml:lang="en-US"><tig><term>To keep your battery healthy and prevent long-term overcharging (the amount of time spent charging between  and ) charging is limited to  until your device is unplugged.When Overcharge protection is active, you\’ll see  in the status bar and a notification will pin to the top of your notification list.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᏍᏆᏂᎪᏙᏗᎢ ᎠᎾᎦᎵᏍᎩ ᏙᎯ ᏃᎴ ᎠᎴᏫᏍᏙᏗ ᎪᎯᏓ-ᎦᎬᎢ ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ (ᏥᎩ ᎢᎦᎢ ᎾᎿ ᎠᏥᎢᎵᏒ ᎤᏂᏩᏒᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎠᏰᏟ  ᏃᎴ ) ᏓᎬᏩᎶᏗᏍᎬᎢ ᎨᎡᎢ ᏩᏎᏢᏊ ᎾᎿᎢ  ᎩᎳ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎫᏓᎴᏍᎪ.ᎢᏳᏃ ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ, ᏂᎯ ᎠᏎ ᎠᎪᏩᏛᏗ  ᎾᎿ ᏥᎩ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᏃᎴ ᎠᏓᏃᏣᎳᏁᎯ ᎠᏎ ᎦᎭᏛᏗ ᎾᎿᎢ ᏥᎩ ᏩᎦᎸᎳᏗᏴ ᎾᎿ ᎠᏓᏃᏣᎳᏁᎯ ᏓᏎᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharging your device can shorten the lifespan of your battery. Overcharge protection keeps your battery healthy by limiting charging to  when your device has been plugged in continuously for 3 days.">
                <langSet xml:lang="en-US"><tig><term>Overcharging your device can shorten the lifespan of your battery. Overcharge protection keeps your battery healthy by limiting charging to  when your device has been plugged in continuously for 3 days.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᏥᏂᎬᏅᏗᏓᎾ ᏣᏤᎵ ᏰᎵᏯ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎥᏍᎩᎾ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎨᎡᎢ ᎠᎴᏂᏙᎲᎢ ᏫᎬᏍᏗ ᎠᎾᎦᎵᏍᎩ. ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᏓᏍᏆᏂᎪᏗ ᎠᎾᎦᎵᏍᎩ ᏙᎯ ᎬᏗ ᏳᏰᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎾᎿᎢ  ᎢᏳᏃ ᏥᏂᎬᏅᏗᏓᎾ ᏂᎦᎵᏍᏓ ᎤᏊᏄᎾᏘ ᎾᎿ ᏫᎬᎵᏱᎵᏒᏊ ᎤᎬᏩᏟ 3 ᏧᏒᎯᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharging your battery causes strain that can shorten its lifespan. Optimized charging helps your battery stay healthy over time.">
                <langSet xml:lang="en-US"><tig><term>Overcharging your battery causes strain that can shorten its lifespan. Optimized charging helps your battery stay healthy over time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᎾᎦᎵᏍᎩ ᏂᏗᎬᏂᏏᏍᎩ ᎦᏅᏐᎸᏍᏙᏗ ᎥᏍᎩᎾ ᏰᎵᏊ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎨᎡᎢ ᎠᎴᏂᏙᎲᎢ ᏫᎬᏍᏗ. ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᏓᎵᏍᏕᎵᏍᎪ ᎠᎾᎦᎵᏍᎩ ᏣᏤᎵ ᎡᏙᎮᏍᏗ ᏙᎯ ᎢᏴᏛ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Flip for DND">
                <langSet xml:lang="en-US"><tig><term>Flip for DND</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᏍᏆᏗᏅᏓ ᎤᎬᏩᏟ DND</term></tig></langSet>
            </termEntry>
            <termEntry id="Gestures">
                <langSet xml:lang="en-US"><tig><term>Gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gestures">
                <langSet xml:lang="en-US"><tig><term>Gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
