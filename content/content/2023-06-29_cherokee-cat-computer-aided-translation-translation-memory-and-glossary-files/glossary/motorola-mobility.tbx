                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏥᏂᎬᏅᏗᏓᎾ ᏍᏓᏯ ᎠᏍᏚᏅᎢ ᎨᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Just twist your wrist twice quickly, and you'll never miss a moment you want to capture.">
                <langSet xml:lang="en-US"><tig><term>Just twist your wrist twice quickly, and you'll never miss a moment you want to capture.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏍᏕᏯᏍᏗ ᏂᏣᏤᎵ ᎠᎵᏰᏑᏜᏗᏍᏗ  ᏔᎵ ᎢᏳᏩᏗ ᎤᎵᏍᏛ, ᎠᎴ Ꮭ ᎯᎷᎯᏴ ᏱᎨᎯᏅᏓ ᎢᏳᏊ ᏱᏣᏚᎵ ᏣᏂᏴᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Single click:Play/pauseDouble click:Play next">
                <langSet xml:lang="en-US"><tig><term>Single click:Play/pauseDouble click:Play next</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᏊᎢᏳᎪᏗ ᎭᏐᏅᏍᏓ:ᏔᏁᎶᎲᎦ/ᎠᎴᏫᏍᏙᏗᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎤᏍᏓ:ᏔᏁᎶᎲᎦ ᏔᎵᏁᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock system gesture">
                <langSet xml:lang="en-US"><tig><term>Unlock system gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳᎩᏍᏗ ᏂᏕᎬᏅᎩ ᎤᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also move between pages by swiping up and down with two fingers">
                <langSet xml:lang="en-US"><tig><term>You can also move between pages by swiping up and down with two fingers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᎠᎲᏍᏗ ᎠᏰᏟ ᏚᎦᏅᏓᏛᎢ ᎬᏗ ᎦᏅᎦᎵᏗᏍᎬ ᎦᎸᎳᏗᏢ ᎤᏠᏯᏍᏗ ᏔᎵ ᏕᎦᏰᏌᏛ  </term></tig></langSet>
            </termEntry>
            <termEntry id="Fitness Data">
                <langSet xml:lang="en-US"><tig><term>Fitness Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᎵᏂᎪᎯᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unknown Error">
                <langSet xml:lang="en-US"><tig><term>Unknown Error</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᎪᎵᎬᎾ ᎦᎵᏓᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not open.">
                <langSet xml:lang="en-US"><tig><term>Not open.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎠᏍᏚᎢᏓ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try other register means">
                <langSet xml:lang="en-US"><tig><term>Please try other register means</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏥᎭᏁᎸᏓ ᏐᎢ ᏕᏣᏙᎥ ᏦᏪᎶᏗ ᎦᏛᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="The number of recordings has reached the upper limit of 5">
                <langSet xml:lang="en-US"><tig><term>The number of recordings has reached the upper limit of 5</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎠᏎᏍᏗ ᏗᎦᏂᏴᎲᎢ ᏄᏩᏅ ᏫᎦᎷᏨᎩ ᎾᏍᎩ ᎦᎸᎳᏗᏢ ᎠᏎᎸᎯ ᎥᎿᎢ 5</term></tig></langSet>
            </termEntry>
            <termEntry id="version">
                <langSet xml:lang="en-US"><tig><term>version</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎸᏓᎴᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can encrypt your accounts, settings, downloaded apps and their data, media, and other files. After you encrypt your tablet, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the tablet every time you power it on. The only other way to decrypt is to perform a factory data reset, erasing all your data.Encryption takes an hour or more. You must start with a charged battery and keep your tablet plugged in throughout the process. If you interrupt it, you\u2019ll lose some or all of your data">
                <langSet xml:lang="en-US"><tig><term>You can encrypt your accounts, settings, downloaded apps and their data, media, and other files. After you encrypt your tablet, assuming you\u2019ve set up a screen lock (that is, a pattern or numeric PIN or password), you\u2019ll need to unlock the screen to decrypt the tablet every time you power it on. The only other way to decrypt is to perform a factory data reset, erasing all your data.Encryption takes an hour or more. You must start with a charged battery and keep your tablet plugged in throughout the process. If you interrupt it, you\u2019ll lose some or all of your data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᏚᏓᎸᏙᏗ, ᏕᎦᎧᎲᎢ, ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ ᏗᎬᏙᏗ ᏃᎴ ᎤᎾᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ, ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ, ᏃᎴ ᏐᎢ ᏗᏍᏆᏂᎪᏙᏗ. ᎤᎶᏐᏅ ᏂᎯ ᎠᏕᎵᏍᏔᏅᎯ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ, ᏃᎵᏍᎬᎢ ᏂᎯ\u2019ve ᏘᎧᎲᎦ Ꭰ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ (ᎥᏍᎩᎾ, Ꭰ ᎤᎾᎶᎢᏓ ᏃᎴ ᏗᏎᏍᏙᏗ PIN ᏃᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ), ᏂᎯ\u2019ll ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᏂᎪᎯᎸ ᏂᎯ ᎤᏟᏂᎩᏓ ᎾᎿ ᎤᎿᎢ. ᏥᎩ ᎤᏅᏒ ᏐᎢ ᏳᎵᏍᏙᏗ ᎾᎿᎢ ᎠᎭᏓᏗᎭ ᏄᏍᏛ ᎾᎿᎢ ᏱᏣᏛᏁᏗ Ꭰ ᎤᏃᏢᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎢᎦᎧᎯᎲᏍᏗ, ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ.ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᏃᎴ ᎤᎪᏗᏊ. ᏂᎯ ᎠᏎ ᎭᎴᎾ ᎬᏗ ᏗᎬᏩᎶᏔᏅ ᎠᎾᎦᎵᏍᎩ ᏃᎴ ᏣᎮᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎤᏊᏄᎾᏘ ᎾᎿ ᏂᎦᏅᎯᏒ ᏥᎩ ᎠᏂᎯᎵᏒ. ᎢᏳᏃ ᏂᎯ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎢᎦᏓ ᏃᎴ ᏂᎦᏓ ᎾᎿ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="We will send a verification code to the email address: ">
                <langSet xml:lang="en-US"><tig><term>We will send a verification code to the email address: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏛᏉ ᎠᏎ ᏫᏓᏲᏥᏅᎾ ᎾᏍᎩ ᎪᎯᏳᏗᏍᎩ ᎠᏍᏓᏩᏛᏍᏙᏗ ᎾᎢ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏗᎦᏁᏍᏗ: </term></tig></langSet>
            </termEntry>
            <termEntry id="When you’re using the Google Assistant on the external display, specific commands work best (e.g. “Play my cooking playlist on Spotify” or “Set a timer for 3 minutes”).">
                <langSet xml:lang="en-US"><tig><term>When you’re using the Google Assistant on the external display, specific commands work best (e.g. “Play my cooking playlist on Spotify” or “Set a timer for 3 minutes”).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎲᏗᏍᎬ Ꮎ ᎫᎦᎵ ᎠᎵᏍᏕᎵᏍᎩ ᎾᎢ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ, ᏗᎪᏍᎩ  ᏗᏓᏁᏤᏗ ᏫᏓᏤᎸ ᏂᎦᎵᏍᏗᏍᎬ (e.g. ᏔᏁᎶᏓ ᎠᏆᏤᎵ ᎥᏓᏍᏓᏴᎲᏍᎬ  ᏗᏁᎸᏙᏗ ᏕᎪᏪᎸ ᎥᎾᎢ Spotify" ᎠᎴ ᎯᎧᎲᎦ ᎠᏟᎵᏒ ᎦᏃᎮᏍᎦ ᏦᎢ ᎢᏯᏔᏬᏍᏔᏅ").</term></tig></langSet>
            </termEntry>
            <termEntry id="CHECK">
                <langSet xml:lang="en-US"><tig><term>CHECK</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏎᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Handwriting makes text entry feel more natural.">
                <langSet xml:lang="en-US"><tig><term>Handwriting makes text entry feel more natural.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏬᏰᏂ ᎬᏔᏅ ᎪᏪᎶᏔᏅ ᏗᎪᏢᏅ ᎪᏪᎳᏅᎢ ᎠᏴᏍᏗ ᎤᏟ ᎢᎦᎢ ᎤᏓᏢᎢ ᏂᎬᏩᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't remind me again">
                <langSet xml:lang="en-US"><tig><term>Don't remind me again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏅᏓᏗᏍᏙᏗ ᎠᏯ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="When your device is locked, choose how long to wait before sending the notification">
                <langSet xml:lang="en-US"><tig><term>When your device is locked, choose how long to wait before sending the notification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏍᏓᏯ ᎠᏍᏚᏅᎢ ᎤᏍᏗ, ᎠᏑᏰᏍᏗ ᎯᎳᎪ ᏂᎪᎯᏓ ᎠᎦᏘᏗᏍᏗ ᎤᏓᎷᎸ ᏫᎦᏅᎥᏍᎬᎢ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ </term></tig></langSet>
            </termEntry>
            <termEntry id="Add text">
                <langSet xml:lang="en-US"><tig><term>Add text</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎪᏪᎳᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stylus actions">
                <langSet xml:lang="en-US"><tig><term>Stylus actions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏪᎳᏅ ᏗᎵᏖᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to add shortcut">
                <langSet xml:lang="en-US"><tig><term>Tap to add shortcut</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᎢ ᎧᏁᏉᏍᏗ ᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="To edit, press and hold an icon">
                <langSet xml:lang="en-US"><tig><term>To edit, press and hold an icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎦᏁᏟᏴᏓ ᎪᏪᎸ, ᎭᏐᎥᏍᏓ ᎠᎴ ᎯᏂᏯ ᎠᎴᏃ ᎠᎢᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Open default app">
                <langSet xml:lang="en-US"><tig><term>Open default app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎤᏓᏄᎸᏅᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="For a better writing experience, try to avoid resting your palm on the screen">
                <langSet xml:lang="en-US"><tig><term>For a better writing experience, try to avoid resting your palm on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾ ᏓᏤᏢ ᎪᏪᎵᏍᎬᎢ ᎠᎦᏙᎲᏒᎢ, ᎭᏁᎵᏓ ᎾᏍᎩ ᏗᏓᏅᏗᏍᏙᏗ ᏣᏣᏪᏐᎸᏍᏙᏗ ᏣᏤᎵ ᎤᏬᎭᏛ ᎤᎾᎢ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To be able to make and receive phone calls and messages, please install an Xfinity Mobile SIM card before continuing. For information about requesting or installing a SIM card please visit . Need help? We're standing by at .">
                <langSet xml:lang="en-US"><tig><term>To be able to make and receive phone calls and messages, please install an Xfinity Mobile SIM card before continuing. For information about requesting or installing a SIM card please visit . Need help? We're standing by at .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎨᏒᎩ ᏰᎵᏉ ᎾᎿᎢ ᎪᏢᏗ ᎠᎴ ᎦᏁᏍᏗ ᏗᏟᏃᎮᏗ ᏓᏯᏂ ᎠᎴ ᏗᎪᎵᏰᏗ, ᎰᏩᏊ ᎯᏘᏅᎦ Ꭰ Xfinity Mobile SIM ᏆᎾᏲᏍᏗ ᎠᏏᏅ ᏫᎬᎵᏱᎴᎬ. ᎤᎬᏩᏟ ᎧᏃᎮᏢᏗ ᎢᎸᏢ ᎠᏔᏲᎯᏍᏗ ᎠᎴ ᎦᏘᏅᏛᏍᎬ Ꭰ SIM ᏆᎾᏲᏍᏗ ᎰᏩᏊ ᎠᏩᏛᎯᏓᏍᏗ.  ᎤᏚᎸᏓ ᎠᎵᏍᏕᎸᏓ? ᎢᏗ ᎦᏙᎦ ᎬᏗ ᎤᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="When the screen is locked, open the camera by twisting your wrist twice.">
                <langSet xml:lang="en-US"><tig><term>When the screen is locked, open the camera by twisting your wrist twice.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᏍᎩ ᎠᏍᏚᎭ, ᎯᏍᏚᎢ ᎾᏍᎩ ᏗᏓᏟᎶᏍᏗᏍᎩ by ᏣᏄᏖᏲᏍᏓ ᏂᏨᏅᎩ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎦᏔ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the current audio settings when this device is connected">
                <langSet xml:lang="en-US"><tig><term>Use the current audio settings when this device is connected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎬᏙᏓ ᏃᏊᏥᎩ ᎤᏃᏴᎬ ᏕᎦᎧᎲᎢ ᎾᎯᏳ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏍᏛ ᎫᏓᎸᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Graphic equalizer">
                <langSet xml:lang="en-US"><tig><term>Graphic equalizer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏟᎶᏍᏗᏓᏅ ᎢᎦᏘᎭ ᏱᏗᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Boost dialog for better speech clarity">
                <langSet xml:lang="en-US"><tig><term>Boost dialog for better speech clarity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏓ ᏗᏟᏃᎮᏗ ᎾᏍᎩᎾ ᏓᏤᏢ ᎧᏁᏍᏗᏳᏍᎪᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Surround virtualizer">
                <langSet xml:lang="en-US"><tig><term>Surround virtualizer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏩᏕᏱᏓ ᎡᏧᎳᎭ ᏱᎦᎵᏍᏗᏍᎬ ᏱᏗᎬᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="When media controls are enabled in the Moto Actions menu, you can use the volume keys to change tracks while the screen is locked.">
                <langSet xml:lang="en-US"><tig><term>When media controls are enabled in the Moto Actions menu, you can use the volume keys to change tracks while the screen is locked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ ᏗᎯᎸᏍᏗ ᎨᏒᎢ ᎡᎵᏊ ᎢᏳᎵᏍᏔᏅᎢ ᎾᎿᎢ ᎼᏙ ᏗᎵᏖᎸᏗ ᎪᏫᎳᎾᎥᎢ, ᏂᎯ ᏰᎵᏊ ᎬᏙᏓ ᎾᏍᎩ ᎢᎦᎢ ᎤᏃᏴᎬ ᏗᏐᎥᏍᏙᏗ ᎾᎢ ᏗᎦᏁᏟᏴᏍᏗ ᏗᎪᎷᏅᏍᏗ ᎾᎯᏳᎢ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᏍᎩ ᏍᏓᏯ ᎠᏍᏚᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart adjustments">
                <langSet xml:lang="en-US"><tig><term>Smart adjustments</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᎣᏍᏛ ᏂᏗᎬᏁᎸᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Free shape screenshot">
                <langSet xml:lang="en-US"><tig><term>Free shape screenshot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏚᏓᎸᎾ ᎤᏙᏢᏒᎢ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Search note">
                <langSet xml:lang="en-US"><tig><term>Search note</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᏍᏗ ᎤᏍᏗ ᎪᏪᎸ</term></tig></langSet>
