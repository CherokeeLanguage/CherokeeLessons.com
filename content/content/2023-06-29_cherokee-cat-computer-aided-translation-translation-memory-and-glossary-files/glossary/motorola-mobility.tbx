            </termEntry>
            <termEntry id="Since it charges fast, your phone may feel warmer while it's plugged in.">
                <langSet xml:lang="en-US"><tig><term>Since it charges fast, your phone may feel warmer while it's plugged in.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎨᏒ ᎾᏍᎩ ᏓᎬᏩᎶᏗᏍᎬ ᎦᏣᏄᎵ, ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏰᎵᏉ ᎠᏒᎾᏍᏗ ᏥᏓᎦᎾᏬᏍᎪ ᎠᏏᏉ ᎾᏍᎩ ᎤᏊᏄᎾᏘ ᎾᎿ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your carrier occasionally requires location data to improve its services and analytics.">
                <langSet xml:lang="en-US"><tig><term>Your carrier occasionally requires location data to improve its services and analytics.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᏣᏂᏙ ᎤᏚᎵᎰ ᏯᏓᎲ ᎮᏙᎲ ᎦᏟᏌᏅ ᏓᏤᏢ ᎢᏳᎾᏓᏛᏁᏗᎢ ᎠᎴ ᏓᏤᏢ ᏗᎪᎵᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow the application to poll presence information.">
                <langSet xml:lang="en-US"><tig><term>Allow the application to poll presence information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᏎᎸ ᎠᎦᏔᎲᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe from icon to answer and end ongoing call">
                <langSet xml:lang="en-US"><tig><term>Swipe from icon to answer and end ongoing call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎢᎧᏂ ᎾᎿᎢ ᎤᏬᎯᎵᏴᏍᏙᏗᎢ ᎠᎴ ᎠᎵᏍᏆᏓ ᏓᏰᏏ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some carrier features may not be available without location access.">
                <langSet xml:lang="en-US"><tig><term>Some carrier features may not be available without location access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᏓᏂᏙ ᏄᎾᏍᏗᏓᏅ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎨᏐ ᏄᏍᏛᎾ ᏱᎩ ᎮᏙᎲ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Two finger swipe down to decline.">
