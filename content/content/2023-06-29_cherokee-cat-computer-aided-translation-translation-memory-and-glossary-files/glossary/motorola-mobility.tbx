                <langSet xml:lang="chr"><tig><term>ᎠᎯᏙᎯ ᏄᏍᏛ ᎠᏎᏯᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your version of Device Help was unable to connect to the RSA client using Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>Your version of Device Help was unable to connect to the RSA client using Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏄᏓᎴᏒᎢ ᎥᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏕᎵᏍᎩ ᎨᏒᎩ ᎤᏓᏄᎸᏅ ᎾᎢ ᎫᏓᎸᎢ ᎾᏍᎩ RSA ᎠᏥᏍᏕᎵᏍᎩ ᎬᏗᏍᎬ ᏫᎢ-ᏈᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM ">
                <langSet xml:lang="en-US"><tig><term>SIM </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM </term></tig></langSet>
            </termEntry>
            <termEntry id=" points">
