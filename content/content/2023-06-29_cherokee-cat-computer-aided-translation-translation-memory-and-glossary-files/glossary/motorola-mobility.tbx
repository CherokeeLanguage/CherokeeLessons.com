            </termEntry>
            <termEntry id="MotoCare Extended Service Plan">
                <langSet xml:lang="en-US"><tig><term>MotoCare Extended Service Plan</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>MotoCare ᎦᏅᎯᏛᎯ ᎢᏯᏓᏛᏁᏗ ᎠᏍᏓᏩᏛᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Formatting will erase existing content on the ^2.">
                <langSet xml:lang="en-US"><tig><term>Formatting will erase existing content on the ^2.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᏗᏍᎬᎢ ᎠᏎ ᏛᏍᏍᎪᎸᏥ ᎬᏂᎨᏒ ᏄᏍᏛᎢ ᏄᏍᏗᏓᏅ ᎤᎿᎢ ᏥᎩ ^2.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can move files, media, and certain apps to this ^1.">
                <langSet xml:lang="en-US"><tig><term>You can move files, media, and certain apps to this ^1.</term></tig></langSet>
