            </termEntry>
            <termEntry id="To see where your photos and videos were taken, turn on location in settings">
                <langSet xml:lang="en-US"><tig><term>To see where your photos and videos were taken, turn on location in settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᎪᏩᏛᏗ ᎤᎾᎢ ᏣᏤᎵ ᏓᏓᏟᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᎨᏒᎩ ᎤᏂᎩᏒᎩ, ᎯᏍᏚᎢ ᎤᎾᎢ ᎤᏙᏢᏒᎢ ᎾᎿᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Selfie camera unavailable">
                <langSet xml:lang="en-US"><tig><term>Selfie camera unavailable</term></tig></langSet>
