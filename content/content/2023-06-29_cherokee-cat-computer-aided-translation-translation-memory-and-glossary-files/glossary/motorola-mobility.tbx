            <termEntry id="This will reset all network settings, including:Wi\u2011FiMobile dataBluetoothNFC">
                <langSet xml:lang="en-US"><tig><term>This will reset all network settings, including:Wi\u2011FiMobile dataBluetoothNFC</term></tig></langSet>
