                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎤᎾᎢ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎾᎢ ᎠᏍᏚᎢᏓ ᎾᏍᎩ ᎬᏙᏗ ᎠᏝᏅᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This ^1 is formatted to work on this device only.">
                <langSet xml:lang="en-US"><tig><term>This ^1 is formatted to work on this device only.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ^1 ᎨᎡᎢ ᎪᏢᏅᎯ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏅᏒ.</term></tig></langSet>
            </termEntry>
