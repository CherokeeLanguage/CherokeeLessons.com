            <termEntry id="Info">
                <langSet xml:lang="en-US"><tig><term>Info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="We were not able to connect your phone to Xfinity Mobile. If you have not yet activated your phone please power it off and visit . Need help? We're standing by at .">
                <langSet xml:lang="en-US"><tig><term>We were not able to connect your phone to Xfinity Mobile. If you have not yet activated your phone please power it off and visit . Need help? We're standing by at .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎨᏒᎩ ᎥᏝ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎫᏓᎸᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎾᎿᎢ Xfinity ᎠᏂᎩᏍᎩ. ᎾᎿ ᏂᎯ ᎤᎭ ᎥᏝ ᎩᎳ ᎤᏂᎩᏍᏗᏍᎩ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎰᏩᏊ ᎤᏟᏂᎩᏓ ᎾᎿ ᎠᏍᏚᏗ ᏃᎴ ᎠᏩᏛᎯᏓᏍᏗ . ᎤᏚᎸᏓ ᎠᎵᏍᏕᎸᏓ? ᎢᏗ ᎦᏙᎦ ᎬᏗ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will now auto-connect to your home Wi-Fi and millions of other Xfinity Wi-Fi hotspots. No log-ins are ever needed. If you want to change this feature, visit your Wi-Fi Preferences Settings.">
                <langSet xml:lang="en-US"><tig><term>Your phone will now auto-connect to your home Wi-Fi and millions of other Xfinity Wi-Fi hotspots. No log-ins are ever needed. If you want to change this feature, visit your Wi-Fi Preferences Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ Ꭷ ᎤᏩᏌ-ᎫᏓᎸᎢ ᎾᎿᎢ ᏂᏨᎤᎢ ᎣᏪᏅᏒ Wi-Fi ᏃᎴ ᎢᏧᏆᏗᏅᏛ ᎾᎿ ᏐᎢ Xfinity Wi-Fi ᎤᏗᏞᎩ ᎤᏓᏓᏢ. ᎭᏗ ᎯᏴᏍᏗ ᎨᎡᎩ ᎢᎸᎯᏳᎢ ᎤᏚᎸᏛ. ᎾᎿ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎯᏁᏟᏴᎾ ᎯᎠ ᎤᏩᎬᏗᏗᏒ, ᎠᏩᏛᎯᏓᏍᏗ ᏂᏨᎤᎢ Wi-Fi ᎤᏟ ᎠᏂᏰᎸᏍᎬᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can set up your phone using Wi-Fi, but you won't be able to make or receive calls until your phone has been activated on the Xfinity Mobile network.">
                <langSet xml:lang="en-US"><tig><term>You can set up your phone using Wi-Fi, but you won't be able to make or receive calls until your phone has been activated on the Xfinity Mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎴᏯ ᎦᎧᎲᏍᎬᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎬᏗᎭ Wi-Fi, ᎠᏎᏃ ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎪᏒᏗ ᏃᎴ ᎦᏁᏍᏗ ᏓᏯᏂ ᎩᎳ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏂᎦᎵᏍᏓ ᎤᏂᎩᏍᏗᏍᎩ ᎤᎿᎢ ᏥᎩ Xfinity Mobile ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Atmos doesn’t work with devices connected by an auxiliary cable.">
                <langSet xml:lang="en-US"><tig><term>Dolby Atmos doesn’t work with devices connected by an auxiliary cable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Atmos ᏤᏍᏗ ᏱᏚᎸᏫᏍᏓᏁᎢ ᎬᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎫᏓᎸᏅᎯ ᏄᏩᏅ ᎾᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Volume leveler">
                <langSet xml:lang="en-US"><tig><term>Volume leveler</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬᎢ ᎠᏥᎶᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="The volume leveler provides a consistent volume across all content and applications based on the master volume level of the device. Set the switch on or off to control automatic volume leveling.">
                <langSet xml:lang="en-US"><tig><term>The volume leveler provides a consistent volume across all content and applications based on the master volume level of the device. Set the switch on or off to control automatic volume leveling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᎢᎦᎢ ᎤᏃᏴᎬ ᎠᏥᎶᏍᎩ ᏗᎾᏓᏁᏢᏍᎩ ᎾᏍᎩ ᎤᏠᏱᎭ ᏱᎦᎵᏍᏗᏍᎩ ᎤᏃᏴᎬ ᏗᎦᎾᏗᏫᏍᏒ ᏂᎦᏓ ᎦᎸᏛᎢ ᏃᎴ ᏗᏔᏲᏍᏙᏗ ᏓᎳᏏᏔᏅᎩ ᎤᎾᎢ ᎾᏍᎩ ᏗᏕᏲᎲᏍᎩ ᎤᏃᏴᎬ ᎠᏟᎶᎲᎢ ᎥᎿᎢ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ. ᎾᏍᎩ ᎦᎧᎲᎢ ᎦᏁᏟᏴᏍᏗ ᎯᏍᏚᎢ ᎠᎴᏃ ᎠᏍᏚᏓ ᎾᎢ ᎠᎲᎸᏍᏗ ᎤᏩᏌ ᏱᎬᏁᎯ ᎤᏃᏴᎬ ᎬᎾᏕᏍᏗᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Create a surround sound experience through your connected device">
                <langSet xml:lang="en-US"><tig><term>Create a surround sound experience through your connected device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᎬᏩᏕᏱᏓ ᎤᏃᏴᎬ ᏣᎦᏙᎲᏒ ᏣᎦᏛᎴᏍᏒ ᏂᏨᏅᎢ ᏣᏚᏓᎸᏅᎯ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
