                <langSet xml:lang="chr"><tig><term> ᎢᏗᏔᏬᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not supported by your default home app, ">
                <langSet xml:lang="en-US"><tig><term>Not supported by your default home app, </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎤᏩᎫᏍᏓᎠ ᎬᏗ ᏂᏨᎤᎢ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎣᏪᏅᏒ ᎬᏙᏗ, </term></tig></langSet>
            </termEntry>
            <termEntry id="PUK requested.">
                <langSet xml:lang="en-US"><tig><term>PUK requested.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PUK ᎠᏓᏲᏢᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch &amp; hold the fingerprint sensor">
                <langSet xml:lang="en-US"><tig><term>Touch &amp; hold the fingerprint sensor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ &amp; ᎯᏂᏯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint + PIN">
                <langSet xml:lang="en-US"><tig><term>Fingerprint + PIN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ + PIN</term></tig></langSet>
            </termEntry>
            <termEntry id="Encryption takes an hour or more.">
                <langSet xml:lang="en-US"><tig><term>Encryption takes an hour or more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ Ꭰ ᏑᏟᎶᏛ ᎠᎴ ᎤᎪᏗᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set screen lock to protect device">
                <langSet xml:lang="en-US"><tig><term>Set screen lock to protect device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ </term></tig></langSet>
            </termEntry>
            <termEntry id="Switch default home app">
                <langSet xml:lang="en-US"><tig><term>Switch default home app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎦᏁᏟᏴᏍᎬᎢ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎣᏪᏅᏒ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Digital assistant">
                <langSet xml:lang="en-US"><tig><term>Digital assistant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="This also deletes the fingerprint model stored on your device.">
                <langSet xml:lang="en-US"><tig><term>This also deletes the fingerprint model stored on your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep going">
                <langSet xml:lang="en-US"><tig><term>Keep going</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᏓᏰᏏ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to invoke assistant">
                <langSet xml:lang="en-US"><tig><term>Swipe to invoke assistant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏓᏠᏯᏍᏙᏗ ᎠᎵᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Paired device">
                <langSet xml:lang="en-US"><tig><term>Paired device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎵᎪᏔᏅᎢ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="WAPI certificate">
                <langSet xml:lang="en-US"><tig><term>WAPI certificate</term></tig></langSet>
