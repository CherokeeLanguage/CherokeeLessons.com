                <langSet xml:lang="chr"><tig><term>ᎪᏚᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you turn off notification access for , Do Not Disturb access may also be turned off.">
                <langSet xml:lang="en-US"><tig><term>If you turn off notification access for , Do Not Disturb access may also be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏱᏍᏚᎾ ᎠᏓᏃᏣᎳᏁᎯ ᎠᏴᏍᏗ ᎾᏍᎩᎾ, ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎠᏴᏍᏗ ᏰᎵᏉ ᎾᏍᎩᏊ ᎨᏒ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show confirmation when a paired PC tries to connect this phone">
                <langSet xml:lang="en-US"><tig><term>Show confirmation when a paired PC tries to connect this phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎦᎫᏍᏛᏗᏱ ᎢᏳᏃ Ꭰ ᏓᎵᎪᏔᏅᎢ PC ᎠᏁᎶᏔᏅ ᎾᎿᎢ ᎱᏓᎸᎩ ᎯᎠ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 38.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 38.</term></tig></langSet>
