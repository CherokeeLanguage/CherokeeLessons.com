                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏘᎧᎲᎦᏃ...</term></tig></langSet>
            </termEntry>
            <termEntry id="{seconds_left, plural, =1 {1 second} other {# seconds} }">
                <langSet xml:lang="en-US"><tig><term>{seconds_left, plural, =1 {1 second} other {# seconds} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{ᏓᏓᎾᏩᏍᎬ_left, ᎯᎸᏍᎩ ᎢᏯᏂᎢ, =1 {1 ᏔᎵᏁ} ᏐᎢ {# ᏓᏓᎾᏩᏍᎬ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="To get started, restart your device.">
                <langSet xml:lang="en-US"><tig><term>To get started, restart your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᎩᏍᏗ ᎠᏂᎩᏍᏙᏔᏅᎩ, ᏥᎭᏂᎩᏍᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't take picture">
                <langSet xml:lang="en-US"><tig><term>Can't take picture</term></tig></langSet>
