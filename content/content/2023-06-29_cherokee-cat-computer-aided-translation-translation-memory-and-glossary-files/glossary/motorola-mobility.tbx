            </termEntry>
            <termEntry id="Add app">
                <langSet xml:lang="en-US"><tig><term>Add app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗ ᎬᏙᏗ</term></tig></langSet>
