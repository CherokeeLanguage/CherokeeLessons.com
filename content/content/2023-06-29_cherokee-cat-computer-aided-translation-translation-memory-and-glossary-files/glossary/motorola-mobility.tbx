                <langSet xml:lang="chr"><tig><term>Ꭰ trᎤᏍᏖd crᎡᏕnᏘᎠl ᎢnᏍᏔlᎴd Ꭳn ᏲᎤr ᏕᎥᎢcᎡ ᎢᏍ ᎹkᎢng tᎯᏍ pᎣᏍᏏbᎴ.</term></tig></langSet>
            </termEntry>
