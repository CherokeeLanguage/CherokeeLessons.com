                <langSet xml:lang="chr"><tig><term>ᎫᏖᏍᏗ ᏥᎩ ᏗᏟᏃᎮᏗ ᎾᎿᎢ ᎡᎷᏪᎢ ᏥᎩ ᎤᏁᏍᏔᎫ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn on One Button Nav, your current navigation will be disabled">
