            <termEntry id="Go to the Sound section to manage volume &amp; vibrations and choose ringtones, alarm sounds, notification sounds, and more.">
                <langSet xml:lang="en-US"><tig><term>Go to the Sound section to manage volume &amp; vibrations and choose ringtones, alarm sounds, notification sounds, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᎾ ᎾᏍᎩ ᎤᏃᏴᎬ ᎤᏓᏧᎬ ᎾᎢ ᏣᏱᎸᏍᏗ ᎢᎦᎢ ᎤᏃᏴᎬ &amp; ᏓᎵᏖᎸᎲᏍᎬ ᏃᎴ ᏣᏑᏰᏍᏗ ᏧᏃᏴᎵᏍᏙᏓ, ᎠᏓᏕᏯᏙᏗᏍᎩ ᏚᏃᏴᎬ, ᏧᏓᏃᏣᎳᏁᏗ ᏚᏃᏴᎬ, ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also find tips that help you make the most of your Camera’s tools.">
                <langSet xml:lang="en-US"><tig><term>You can also find tips that help you make the most of your Camera’s tools.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᎠᏩᏛᏗ ᏗᏓᏕᏲᎲᏍᎩ ᎾᏍᎩᎾᎢ ᏍᏕᎵᏍᎩ ᎪᏒᏗ ᎾᏍᎩ ᎤᎪᏗᏗ ᏣᏤᎵ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏗᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to use your camera">
                <langSet xml:lang="en-US"><tig><term>Learn how to use your camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏰᎵ ᎬᏙᏓ ᏣᏤᎵ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up on the Home screen to open the app tray. This is where you can find all of the apps on your device. Use the search bar to find apps quickly.">
                <langSet xml:lang="en-US"><tig><term>Swipe up on the Home screen to open the app tray. This is where you can find all of the apps on your device. Use the search bar to find apps quickly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏨ ᎤᎾᎢ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎾᎢ ᎠᏍᏚᎢᏓ ᎾᏍᎩ ᎬᏙᏗ ᎠᏝᏅᏙᏗ. ᎯᎠ ᎾᏍᎩ ᎤᎾᎢ ᏂᎯ ᏰᎵᏊ ᏱᏩᏔ ᏂᎦᏓ ᎾᏍᎩ ᏗᎬᏙᏗ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎬᏙᏓ ᎾᏍᎩ ᎠᏱᏍᏗ ᎦᎾᎸᎢ ᎾᎢ ᎠᏩᏛᏗ ᏗᎬᏙᏗ ᏄᏟᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on Security to check security status and set your device PIN, fingerprints, Face unlock, and more.">
                <langSet xml:lang="en-US"><tig><term>Tap on Security to check security status and set your device PIN, fingerprints, Face unlock, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎤᎦᏎᏍᏗ ᎾᎢ ᏣᎦᏛᎲᎦ ᎤᎦᏎᏍᏗ ᏄᏍᏗᏓᏅᎢ ᏃᎴ ᎦᎧᎲᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ PIN, ᏕᎦᏰᏌᏛ ᏚᏙᏪᎸᎢ, ᎤᎧᏛ ᎦᏐᎭᎾᎳᎩᏍᏗ , ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Play helps you enjoy more engaging entertainment. If you’re a gamer, explore the settings in Gametime that give you an edge over the competition.">
                <langSet xml:lang="en-US"><tig><term>Play helps you enjoy more engaging entertainment. If you’re a gamer, explore the settings in Gametime that give you an edge over the competition.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏍᏕᎵᏍᎪ ᎠᎵᎮᎵᏍᏗ ᎤᏥ ᎢᎦᎢ ᎤᎵᎶᎯ ᎤᎾᏛᏁᎸᏗ. ᎢᏳᏃ ᏂᎯ ᏔᏁᎶᎲᏍᎩ, ᏫᏣᎦᏛᏂᏗ ᎾᏍᎩ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᎾᏍᎩᎾᎢ ᏣᏁᎲᎩ ᎾᏍᎩ ᎠᏍᏛᎢ ᏕᎭᏓᏬᎭᏗᏍᎬ ᎾᏍᎩ ᎠᎾᏓᎪᎾᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Gestures make everyday tasks easier than ever. Try user-favorites like Three finger screenshot, Quick capture, Fast flashlight, and more.">
                <langSet xml:lang="en-US"><tig><term>Gestures make everyday tasks easier than ever. Try user-favorites like Three finger screenshot, Quick capture, Fast flashlight, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏬᏯᏂᏍᎩ ᏧᏙᏓᏆᏓ ᎠᎯᏓ ᏱᎬᏁᎯ ᎢᏯᏛᏁᏗ ᎾᏍᎩ ᏏᏃ ᎢᎸᎯᏳᎢ. ᎭᏁᎵᏓ ᎬᏗᏍᎩ-ᏫᏗᏣᎸᏉᏛ ᎾᏍᎩᏯᏉ ᏦᎢ ᏗᎦᏰᏌᏛ ᎠᏴᏙᎳᏛᎢ ᏗᏥᎶᏍᏔᏅᎢ, ᎤᏟᏍᏓ ᎦᏂᏴᏗ, ᎦᏣᏄᎳ ᎠᏨᏍᏗ, ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Accessibility settings help you make audio, visual, and haptic adjustments to meet your unique needs.">
                <langSet xml:lang="en-US"><tig><term>Accessibility settings help you make audio, visual, and haptic adjustments to meet your unique needs.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒ ᏕᎦᎧᎲᎢ ᎠᏍᏕᎵᏍᎩ ᎤᏃᏴᎬ ᏱᎬᏁᎯ, ᎠᎪᏩᏛᏗ, ᎠᎴ ᎠᏒᏍᏙᏗ ᎣᏍᏛ ᏂᏓᏅᏁᎲ ᎾᎢ ᏗᏦᎯᏍᏗ ᏣᏤᎵ ᎤᏩᏒᎯᏯ ᏚᏚᎸᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not set">
                <langSet xml:lang="en-US"><tig><term>Not set</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏱᎦᎧᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Personalize helps you set up your device in a way that reflects your needs and preferences. Choose font styles, wallpapers, icon shapes, and more to make your device unique.">
                <langSet xml:lang="en-US"><tig><term>Personalize helps you set up your device in a way that reflects your needs and preferences. Choose font styles, wallpapers, icon shapes, and more to make your device unique.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎤᏤᎵ ᏱᎬᏁᏗ ᏍᏕᎵᏍᎩ ᏂᎯ ᏕᎦᎦᎧᎲᏍᎬ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏄᎵᏍᏙᏗ ᎾᏍᎩᎾᎢ ᎬᎾᎨᏒ ᏱᎦᎵᏍᏗᏍᎩ ᏣᏚᎸᏛᎢ ᏃᎴ ᎤᏟ ᏕᎯᏰᎸᏍᎬᎢ. ᎠᏑᏰᏍᏗ ᏄᏍᏛ ᎠᏙᏪᎵᏍᎩ ᏄᏍᏛ ᎪᏪᎶᏗ, ᏕᎧᏑᎧᏡ ᏗᎪᏪᎵ, ᎠᎢᎧᏂ ᏚᏙᏢᏒᎢ, ᏃᎴ ᎤᏥ ᎢᎦᎢ ᎾᎢ ᎪᏒᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᏩᏒᎯᏯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Settings app is where you can find vital information about your device and make customizations to suit your needs and preferences.">
                <langSet xml:lang="en-US"><tig><term>The Settings app is where you can find vital information about your device and make customizations to suit your needs and preferences.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏕᎦᎧᎲ ᎬᏙᏗ ᎾᏍᎩ ᎤᎾᎢ ᏂᎯ ᏰᎵᏊ ᎠᏩᏛᏗ ᏭᎵᏍᎨᏗᏴ ᎧᏃᎸᎥᏍᎩ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᎪᏒᏗ ᏗᏤᎲᏍᏙᏔᏅᎢ ᎾᎢ ᎣᏍᏛ ᎠᏰᎸᏗ ᏣᏤᎵ ᏚᏚᎸᏛᎢ ᏃᎴ ᎤᏟ ᏓᏂᏰᎸᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Go to Storage to see what’s stored on your device. You can also easily free up space and view SD card storage details if you have one inserted.">
                <langSet xml:lang="en-US"><tig><term>Go to Storage to see what’s stored on your device. You can also easily free up space and view SD card storage details if you have one inserted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎮᎾ ᎾᎾᎢ ᎠᏍᏆᏂᎪᏙᏗ ᎠᎪᏩᏛᏗ ᎢᏳᏍᏗ ᏓᏍᏆᏂᎪᏛ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᎯ ᏰᎵᏊ ᎾᏍᏉ ᎠᎯᏗᎨᎢ ᎤᏚᏓᎴᏗ ᎤᏣᏅᏛᎯ ᎠᎴ ᏗᎧᏃᏗ SD ᏆᎾᏲᏍᏗ ᎠᏍᏆᏂᎪᏙᏗ ᏂᏕᎬᎿᏅᎢ ᎢᏳᏃ ᏂᎯ ᏣᎲᎢ ᏌᏊ ᏫᎪᏣᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down twice to open quick settings. This gives you easy access to some frequently used settings. To edit quick settings, tap on the pencil in the bottom left corner.">
                <langSet xml:lang="en-US"><tig><term>Swipe down twice to open quick settings. This gives you easy access to some frequently used settings. To edit quick settings, tap on the pencil in the bottom left corner.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎡᎳᏗᏨ ᏔᎵ ᎢᏳᏩᎦᏘ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ. ᎯᎠ ᏕᏣᏁᎰᎢ ᎠᎯᏓ ᎠᏴᏍᏗ ᎾᎢ ᎢᎦᏓ ᏂᎪᎯᎸ ᎬᏔᏅᎯ ᏕᎦᎧᎲᎢ. ᎾᎢ ᎤᏟᏍᏓ ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᏕᎦᎧᎲᎢ, ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᏗᎪᏪᎶᏗ ᎾᎿᎢ ᎾᏍᎩ ᎭᏫᏂᏗᏨ ᎠᏍᎦᏂ ᎤᏅᏏᏴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Camera is a powerful tool that lets you capture great looking photos and videos anytime.">
                <langSet xml:lang="en-US"><tig><term>Your Camera is a powerful tool that lets you capture great looking photos and videos anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎾᏍᎩ ᎤᏟᏂᎩᏛ ᎬᏔᏂᏓᏍᏗ ᎾᏍᎩᎾᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏂᎯ ᎦᏂᏴᏗ ᎡᏉᎯᏳ ᎠᎦᏘᏍᎬ ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Easily switch between capturing photos and videos from the viewfinder.">
                <langSet xml:lang="en-US"><tig><term>Easily switch between capturing photos and videos from the viewfinder.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᏳ ᎦᏁᏟᏴᏍᏗ ᎠᏰᏟ ᎦᏂᏴᏗᏍᎬᎢ ᏓᏓᏥᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎠᎪᎵᏰᏗ ᎠᏩᏘᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on Network &amp; internet to manage things like Wi-Fi &amp; data connections, mobile hotspot, wireless emergency alerts, and advanced calling features.">
                <langSet xml:lang="en-US"><tig><term>Tap on Network &amp; internet to manage things like Wi-Fi &amp; data connections, mobile hotspot, wireless emergency alerts, and advanced calling features.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎤᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ ᎾᎢ ᎠᏱᎸᏍᏗ ᏧᏓᎴᏅᏛ ᎾᏍᎩᏯᏉ Wi-Fi &amp; ᎦᏘᏍᎩᏌᏅᎯ ᏕᎫᏓᎸᎢ, ᎠᏓᏅᏏᏙᎯ ᎤᏗᎴᎩ ᎤᏓᏓᏢ, ᎾᏏᎳᏛᎾ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏗᏓᏕᏯᏔᎲᏍᎩ, ᏃᎴ ᎤᎵᏱᎸᏛ ᏫᏗᎬᏗᏍᎩ ᏗᎦᏎᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Home screen is where you’ll find widgets, favorite apps, and more. Long press on the Home screen to customize.">
                <langSet xml:lang="en-US"><tig><term>The Home screen is where you’ll find widgets, favorite apps, and more. Long press on the Home screen to customize.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎤᎾᎢ ᏂᎯᏊᏃ ᎠᏩᏛᏗ ᏗᏫᏥᏘ, ᏫᎦᎸᏉᏛ ᏗᎬᏙᏗ, ᏃᎴ ᎤᏥ ᎢᎦᎢ. ᎦᏅᎯᏓ ᎠᏐᎥᏍᏙᏗ ᎤᎾᎢ ᎾᏍᎩ ᏧᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ ᎾᎢ ᎠᏤᎲᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down from any screen to open the notification curtain. To clear all of your notifications, scroll to the bottom of the list and tap “Clear all”.">
                <langSet xml:lang="en-US"><tig><term>Swipe down from any screen to open the notification curtain. To clear all of your notifications, scroll to the bottom of the list and tap “Clear all”.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎡᎳᏗᏨ ᏂᏓᏳᏓᎴᏅ ᏂᎦᎥᏉ ᎠᏴᏙᎳᏛᎢ ᎠᏍᏚᎢᏓ ᎾᏍᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏯᏙᎳᏛᏗ. ᎾᎢ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᎥᎿᎢ ᏣᏤᎵ ᏗᏓᏃᏣᎳᏁᎯ, ᎦᏆᎴᏯᏍᏗ ᎥᎿᎢ ᎡᎳᏗᏨ ᎾᏍᎩ ᏕᎦᏅᏛᎢ ᎠᎴ ᎭᏐᎥᏍᏓ “ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ”.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Camera has several modes that help you take creative photos and videos. Inside the modes menu, you’ll also find pro settings that give you more control.">
                <langSet xml:lang="en-US"><tig><term>Your Camera has several modes that help you take creative photos and videos. Inside the modes menu, you’ll also find pro settings that give you more control.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᎲᎢ ᎢᎸᏍᎩ ᏗᎬᏙᏗᎭ ᎾᏍᎩᎾᎢ ᎠᏍᏕᎵᏍᎩ ᎠᎩᏍᏗ ᎪᏒᏔᏅ ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ. ᎭᏫᎾᏗᏨ ᎾᏍᎩ ᏗᎬᏙᏗᎭ ᎪᏪᎳᎾᎥᎢ, ᏂᎯᏊᏃ ᎾᏍᏉ ᎯᏩᏔ ᏫᏓᏤᏢᎢ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾᎢ ᏣᏁᎲᎢ ᎤᏥ ᎢᎦᎢ ᎠᎯᎸᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about your phone">
                <langSet xml:lang="en-US"><tig><term>Learn more about your phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ ᎢᎸᏨ ᏂᏨᏅᎢ ᏗᏟᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You’re all set! Now you can learn even more about your device in Tips.">
                <langSet xml:lang="en-US"><tig><term>You’re all set! Now you can learn even more about your device in Tips.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎾᏍᎩ ᏂᎦᏓ ᏣᏛᏅᎢᏍᏔᏅᎢ! ᏃᏊ ᏂᎯ ᏰᎵᏊ ᏫᏣᏕᎶᏆᏍᏗ ᎥᏍᏊ ᎤᏥ ᎢᎦᎢ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏥᎵᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏗᏓᏕᏲᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Build your own tour">
                <langSet xml:lang="en-US"><tig><term>Build your own tour</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏒᎾ ᏨᏌ ᏣᏤᎵ ᎠᎦᏖᏃᎵᏓᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Build your tour">
                <langSet xml:lang="en-US"><tig><term>Build your tour</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏒᎾ ᏣᏤᎵ ᎠᎦᏖᏃᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your carrier occasionally requires location data to improve its services and analytics. Some carrier features may not be available without location access. To allow your device to share location data, tap “Allow all the time” on the following screen.You can change this setting at any time by going to Settings &gt; Location &gt; Carrier Location Access.">
                <langSet xml:lang="en-US"><tig><term>Your carrier occasionally requires location data to improve its services and analytics. Some carrier features may not be available without location access. To allow your device to share location data, tap “Allow all the time” on the following screen.You can change this setting at any time by going to Settings &gt; Location &gt; Carrier Location Access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᏣᏂᏙ ᎤᏚᎵᎰ ᏯᏓᎲ ᎮᏙᎲ ᎦᏟᏌᏅ ᏓᏤᏢ ᎢᏳᎾᏓᏛᏁᏗᎢ ᏃᎴ ᏓᏤᏢ ᏗᎪᎵᏍᏙᏗ ᎢᎦᏓ ᏗᏓᏂᏙ ᏄᎾᏍᏗᏓᏅ ᎭᏗ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎨᏐ ᏄᏍᏛᎾ ᏱᎩ ᎮᏙᎲ ᎠᏴᏍᏗ ᏴᎵᏍᎪᎵᏗ ᏥᏂᏕᎬᏅᏗᏓᏅ ᎤᏃᎮᏗ ᎮᏙᎲᎦᏟᏌᏅ, ᎠᏐᏍᏗ "ᎭᎵᏍᎪᎵᏗ ᏂᎦᏓ ᎠᏟᎠᎵᏒ" ᎠᏴᏙᎸᏛᎢ.ᏱᏁᏟᏴᎾ ᏂᏕᎬᎾ ᏣᏚᎵᏍᎬᎢ ᏗᎪᏙᏗᎢ&gt;ᎮᏙᎲᎢ&gt;ᏣᏂᏙ ᎮᏙᎲ ᏩᏴᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Update screen magnification on app transitions">
                <langSet xml:lang="en-US"><tig><term>Update screen magnification on app transitions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎠᏰᏙᎳᏛᎢ ᎠᏔᏃᎯᏍᏙᏗ ᎤᎾᎢ ᎬᏙᏗ ᏓᏓᏁᏟᏴᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto update screen magnification">
                <langSet xml:lang="en-US"><tig><term>Auto update screen magnification</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ ᏗᎪᏒᎯᏌᏅᎯ ᎠᏰᏙᎳᏛᎢ ᎠᏔᏃᎯᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" of overall battery">
                <langSet xml:lang="en-US"><tig><term> of overall battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎾᎿ ᏂᎦᎥᏉᏃ ᎠᎾᎦᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="SEE MORE">
                <langSet xml:lang="en-US"><tig><term>SEE MORE</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎠᎪᏩᏛᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to know more about your phone?">
                <langSet xml:lang="en-US"><tig><term>Do you want to know more about your phone?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏍ ᏣᏚᎵ ᏣᏕᎳᎰᎯᏍᏗ ᎤᏥ ᎢᎦᎢ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="I understand that my consent is not required and is not a condition of any purchase. Standard data rates may apply. I may unsubscribe to push notifications by selecting &quot;Unsubscribe&quot; in the notifications I receive. ">
                <langSet xml:lang="en-US"><tig><term>I understand that my consent is not required and is not a condition of any purchase. Standard data rates may apply. I may unsubscribe to push notifications by selecting "Unsubscribe" in the notifications I receive. </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯ ᎪᎵᎦ ᎾᏍᎩᎾᎢ ᎠᏆᏤᎵ ᎣᏏ ᏥᏰᎸᏍᎬᎢ ᎾᏍᎩ ᎥᏝ ᎠᏎᏯᏛᏁᏗ ᏱᎩ ᏃᎴ ᎥᏝ ᎾᏍᎩ ᏄᏍᏗᏓᏅ ᎥᎿᎢ ᏂᎦᎥ ᎠᏩᎯᏍᏗ. ᎢᎬᏩᏍᏗᎭ ᎦᏘᏍᎩᏌᏅᎯ ᏓᏟᎶᎲᎢ ᏰᎵᏉ ᏱᏂᎦᎵᏍᏓ. ᎠᏯ ᏰᎵᏉ ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ ᎾᎢ ᎦᏌᏙᏯᏍᏗ ᏗᏓᏃᏣᎳᏁᎯ ᏄᏅᏅ ᎠᏑᏰᏍᏗ "ᏗᏲᎯᏍᏗ ᎠᏓᏅᏒᎢ" ᎾᎿᎢ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏯ ᎠᎩᏁᏒᎩ. </term></tig></langSet>
            </termEntry>
            <termEntry id="More Info">
                <langSet xml:lang="en-US"><tig><term>More Info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Info">
                <langSet xml:lang="en-US"><tig><term>Info</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tailored experiencesMotorola uses info about you to show you more of the things you like.">
                <langSet xml:lang="en-US"><tig><term>Tailored experiencesMotorola uses info about you to show you more of the things you like.</term></tig></langSet>
