                <langSet xml:lang="chr"><tig><term>ᎾᏊᏃ ᏱᏣᎴᏅᎭ ᎠᏓᏅᏏᏙᎯ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᏣᏤᎵ ᏃᏊᎨᏒᎢ ᎠᎵᏖᎸᎲᏍᎩ &amp;lt ᎠᏓᏅᏏᏙᎯ ᏍᎩ ᎦᏍᎩᎶᎩ ᎦᏚ&amp;gt {and_or} &amp;lt ᎠᏓᏴᎳᏛᏍᎩ ᏗᏓᏟᎶᏍᏙᏗ&amp;gt ᏧᏂᎳᏫᎢᏍᏗ ᎠᏍᏚᎮᏍᏓᏃ. ᏂᎯ ᏰᎵᏃ ᎤᏚᎸᏓ ᎾᎢ ᎬᏗ ᎠᏂᎩᏍᏙᏗᎢ &amp;lt ᎠᏓᏅᏏᏙᎯ ᏍᎩ ᎦᏍᎩᎶᎩ ᎦᏚ&amp;gt {and_or} &amp;lt ᎠᏓᏴᎳᏛᏍᎩ ᏗᏓᏟᎶᏍᏙᏗ&amp;gt ᏧᏂᎳᏫᎢᏍᏗ ᏧᏂᎳᏫᎢᏍᏗ ᎠᏃᏢᏍᎬ ᎠᏓᏅᏏᏙᎯ ᎤᏗᏞᎩ ᎤᏓᏓᏢ . ᏂᎦᏯᎢᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Torch Auto">
                <langSet xml:lang="en-US"><tig><term>Torch Auto</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏨᏍᏙᏗ ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="For best results, stay within 1.5 meters (5 feet) of your subject.">
                <langSet xml:lang="en-US"><tig><term>For best results, stay within 1.5 meters (5 feet) of your subject.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾ ᏫᏓᏤᏢ ᏂᏧᎵᏍᏙᏗᎢ, ᎭᏫᏂᏗᏢ ᎡᏙᎮᏍᏗ 1.5 ᏗᏎᎯᎯ (5 ᎢᏯᎳᏏᏗ) ᎥᎿᎢ ᏣᏤᎵ ᎧᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It's best if there are no objects between you and your subject.">
                <langSet xml:lang="en-US"><tig><term>It's best if there are no objects between you and your subject.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏅᏍᏛ ᏫᏓᏤᏢ ᎥᎿᎢᎾᎿᏃ ᎨᏒᎢ Ꮭ ᏧᏓᎴᏅᏓ ᎠᏰᏟ ᏂᏚᏓᎸᎯ ᏂᎯ ᎠᎴ ᏣᏤᎵ ᎧᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Optimized charging learns your charging behavior so it can charge the battery to  quickly and then wait to charge the final  until shortly before you unplug.">
                <langSet xml:lang="en-US"><tig><term>Optimized charging learns your charging behavior so it can charge the battery to  quickly and then wait to charge the final  until shortly before you unplug.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᎯᏌᏅ ᎬᏂᏗᏍᏗᏍᎬᎢ ᏓᏕᎶᏆᏍᎪᎢ ᏣᏤᎵ ᎤᏂᏗᏍᏗᏍᎬᎢ   ᎿᏛᏁᎲᎩ ᎾᏃ ᏰᎵᏊ ᏱᏕᎬᏂᏗᏍᏓ ᎾᏍᎩ ᎠᎾᎦᎵᏍᎩ ᎾᎢ  ᏄᏟᏍᏛ ᎠᎴ ᎿᏉᏃ ᎠᎦᏘᏗᏍᏗ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ  ᎤᎵᏍᏆᏛᎯ  ᎩᎳ ᏂᎪᎯᎸᎾᏉᎤᏓᎷᎸ ᏂᎯ ᏧᏓᎴᏍᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now, in Android 12, a helpful status bar indicator will show you anytime your camera or microphone are in use.">
                <langSet xml:lang="en-US"><tig><term>Now, in Android 12, a helpful status bar indicator will show you anytime your camera or microphone are in use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ, ᎾᎿᎢ Android 12, ᎧᏃᎮᏍᎩ ᎠᎵᏍᏕᎵᏍᎩ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ ᏣᏤᎵ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎠᎴᏃ ᎦᏬᏂᎯᏍᏙᏗ ᎨᏒᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏍᎩᎪᏩᏛᏓ ᎨᏒᎢ ᎾᎿᎢ ᎬᏙᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Stylus Writing">
                <langSet xml:lang="en-US"><tig><term>Stylus Writing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᎪᏪᎶᏗ ᎪᏪᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more about your device provacy in the new Privacy dashboard in device settings.">
