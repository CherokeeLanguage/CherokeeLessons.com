                <langSet xml:lang="en-US"><tig><term>Tap to sync now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎾᎿᎢ ᏥᏄᎵᏍᏔᏅᎢ ᏃᏊ</term></tig></langSet>
