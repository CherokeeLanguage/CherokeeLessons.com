                <langSet xml:lang="chr"><tig><term>ᏓᏆᎴᏅ ᏓᏟᎶᏍᏗᏓᏅ-ᎢᏧᎳᎭ ᏥᏄᎵᏍᏔᏅᎢ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data active">
                <langSet xml:lang="en-US"><tig><term>Mobile data active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎵᏖᎸᎲᏍᎩ</term></tig></langSet>
            </termEntry>
