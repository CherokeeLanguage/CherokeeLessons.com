                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You may need to manually add international codes to phone numbers while roaming.">
                <langSet xml:lang="en-US"><tig><term>You may need to manually add international codes to phone numbers while roaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᎸᏓ ᎾᎿᎢ ᎣᏩᏌ ᏱᎬᏁᏗ ᏗᎧᏁᏉᏍᏗ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᏗᏍᏓᏩᏛᏍᏙᏗ ᎾᎿᎢ ᏗᏟᏃᎮᏗ ᏗᏎᏍᏗ ᎠᏏᏉ ᎡᏙᎵᏙᎲ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System icons that turned off will not be shown on the status bar.">
                <langSet xml:lang="en-US"><tig><term>System icons that turned off will not be shown on the status bar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏕᎬᏅᎩ ᏗᎢᎧᏂ ᎥᏍᎩᎾ ᎠᏍᏚᏅᎢ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎤᎿᎢ ᏄᏛᎿᏕᎬ ᎦᎾᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Poor()">
