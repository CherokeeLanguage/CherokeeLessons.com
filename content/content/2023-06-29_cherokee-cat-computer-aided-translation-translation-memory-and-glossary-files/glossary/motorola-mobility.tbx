                <langSet xml:lang="en-US"><tig><term>Please check your network settings and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ ᎠᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t remove the ^1 during the move. The ^2 app on this device won\u2019t be available until the move is complete.">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t remove the ^1 during the move. The ^2 app on this device won\u2019t be available until the move is complete.</term></tig></langSet>
