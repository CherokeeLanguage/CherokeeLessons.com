                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎠᏍᏆᏛᏃᏅ ᏥᎩ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Free up some space and go to Settings &gt; System updates to try again.">
                <langSet xml:lang="en-US"><tig><term>Free up some space and go to Settings &gt; System updates to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏚᏓᎴᎩ ᎢᎦᏓ ᎤᏜᏅᏛ ᎠᎴ Ꭷ ᏕᎦᎧᎲᎢ &gt; ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎾᎿᎢ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Press BACK again to exit">
                <langSet xml:lang="en-US"><tig><term>Press BACK again to exit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᏅᏍᏓ ᎠᏨᏍᏗ ᏏᏊ ᎾᎿᎢ ᎦᏅᎪᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Waiting for Wi-Fi to resume downloading…">
