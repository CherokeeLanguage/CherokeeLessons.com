                <langSet xml:lang="chr"><tig><term>ᏂᏓᏳᏓᎴᏅᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᏍᎩ ᎠᏕᎵᏍᏔᏅ, ᏂᎯ ᎨᏒᎢ ᎠᏎᏯᏛᏁᏗ ᎾᎢ ᎠᏕᎵᏍᏔᏅᎯ ᏣᏤᎵ ᎠᏍᏆᏂᎪᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the bubble to open video effect settings">
                <langSet xml:lang="en-US"><tig><term>Tap the bubble to open video effect settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏥᎩ ᏓᎵᏆᎷᎲᏍᎬ ᎾᎿᎢ ᎯᏍᏚᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏂᏗᎦᎵᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will also be used to encrypt the backup archive.">
                <langSet xml:lang="en-US"><tig><term>This will also be used to encrypt the backup archive.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎾᏍᏊ ᎨᏒᎩ ᎬᏔᏅᎯ ᎾᎢ ᎠᏕᎵᏍᏔᏅᎯ ᎾᏍᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏗᎪᏪᎳ ᏓᏍᏆᏂᎪᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If this is left blank, your current backup password will be used:">
                <langSet xml:lang="en-US"><tig><term>If this is left blank, your current backup password will be used:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎯᎠ ᎾᏍᎩ ᎠᎧᎵᏏᏐᏗ ᎧᏃᎯᏴᎢ, ᏣᏤᎵ ᏃᏊ ᏥᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎠᏎ ᎬᏔᏂᏓᏍᏗ ᎨᏎᏍᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter a password below:">
