            <termEntry id="To turn on Adaptive performance, Moto needs permission to access your app usage so it can learn your usage patterns. Adaptive performance collects this data at appropriate times and only stores the information on your device.">
                <langSet xml:lang="en-US"><tig><term>To turn on Adaptive performance, Moto needs permission to access your app usage so it can learn your usage patterns. Adaptive performance collects this data at appropriate times and only stores the information on your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎠᏍᏚᎢᏓ ᎤᎾᎢ ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᏧᎸᏫᏍᏓᏁᎯ, Moto ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᏣᏤᎵ ᎬᏙᏗ ᎬᏗᏍᎩ ᎾᏍᎩ ᏰᎵᏊ ᎠᏕᎶᏆᏍᏗ ᏣᏤᎵ ᎬᏗᏍᎩ ᏗᏟᎶᏍᏔᏅᎢ. ᏗᏙᎳᎩ ᏂᎦᎵᏍᏗᏍᎬ ᏧᎸᏫᏍᏓᏁᎯ ᏗᎦᏟᏌᏅᎩ ᎯᎠ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎾᎢ ᏗᏙᎳᎩ ᏓᏟᎢᎵᏒ ᏃᎴ ᎤᏩᏌ ᎠᏍᏆᏂᎪᏛ ᏓᏍᏆᏂᎪᏗᏍᎬ ᎾᏍᎩ ᎧᏃᎸᎥᏍᎩ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature needs permission to access your app usage so it can improve device performance with AI. To grant permission, choose &quot;Moto&quot; in Usage access.">
                <langSet xml:lang="en-US"><tig><term>This feature needs permission to access your app usage so it can improve device performance with AI. To grant permission, choose "Moto" in Usage access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᏗᏴᏍᏗ ᏣᏤᎵ ᎬᏙᏗ ᎬᏗᏍᎩ ᎾᏍᎩ ᏰᎵᏊ ᎪᏢᎯᏐᏗ ᏥᏂᎬᏅᏗᏓᎾ ᏧᎸᏫᏍᏓᏁᎯ ᎬᏗ ᎬᏴᏍᏗ ᏕᎦᏅᏛᎢ. ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ, ᎠᏑᏰᏍᏗ "Moto" ᎾᎿᎢ ᎬᏗᏍᎩ ᎠᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Powered by Moto AI">
                <langSet xml:lang="en-US"><tig><term>Powered by Moto AI</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎳᏂᎩᏛ ᏄᏩᏅ Moto ᎬᏴᏍᏗ ᏕᎦᏅᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device isn`t available. Refresh the list or restart it and try again.">
                <langSet xml:lang="en-US"><tig><term>Device isn`t available. Refresh the list or restart it and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎯᏤᎲᏍᏓ ᏥᎩ ᏓᏎᏍᏛᎢ ᎠᎴ ᏥᎭᏂᎩᏍᏓ ᎤᎿ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Portrait">
                <langSet xml:lang="en-US"><tig><term>Portrait</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're connected to a display. To connect to your PC, disconnect from the display.">
                <langSet xml:lang="en-US"><tig><term>You're connected to a display. To connect to your PC, disconnect from the display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯZ ᎾᏍᎩ ᏣᏚᏓᎵ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ. ᎾᎿᎢ ᎱᏓᎸᎥᎦ ᎾᎿᎢ ᏂᏨᎤᎢ PC, ᎱᏓᎳᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎠᏓᏴᎳᏔᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you've turned on Wi-Fi on both your phone and PC, or connected by a USB data cable.">
                <langSet xml:lang="en-US"><tig><term>Make sure you've turned on Wi-Fi on both your phone and PC, or connected by a USB data cable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᎯᏃ ᎯᏍᏚᎢ ᏫᎢ-ᏈᎢ ᎤᎾᎢ ᎢᏧᎳ ᏗᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ PC, ᎠᎴᏃ ᎫᏓᎸᏅᎯ ᎬᏗ USB ᎦᏟᏌᏅᎯ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to save. Files have been deleted from clipboard.">
                <langSet xml:lang="en-US"><tig><term>Unable to save. Files have been deleted from clipboard.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎢ ᎠᎵᏏᏅᏙᏗ. ᏗᏍᏆᏂᎪᏙᏗ ᎤᏒᎦᏜᏅᎩ ᎠᏍᎪᎸᏛᎯ ᏅᏓᏳᏓᎴᏅᎯ ᏗᎦᏯᎸᏙᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device isn`t available. Restart it and try again.">
                <langSet xml:lang="en-US"><tig><term>Device isn`t available. Restart it and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᏥᎭᏂᎩᏍᏓ ᎨᎡᎢ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No WIFI or USB connected. Connect to a network or plug in your cable and try again.">
                <langSet xml:lang="en-US"><tig><term>No WIFI or USB connected. Connect to a network or plug in your cable and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ WIFI ᎠᎴ USB ᎫᏓᎸᏅᎯ. ᎫᏓᎸᎢ ᎾᎢ ᎤᏚᏓᎵ ᎠᎴ ᎫᏓᎸᏙᏗ ᏂᏨᎤᎢ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Wi-Fi network is blocking the connection. Please close your VPN, connect to another Wi-Fi network, or plug in a USB cable and try again.">
                <langSet xml:lang="en-US"><tig><term>Your Wi-Fi network is blocking the connection. Please close your VPN, connect to another Wi-Fi network, or plug in a USB cable and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ Wi-Fi ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎠᏍᏚᎲ ᏥᎩ ᎫᏓᎸᎢ. ᎰᏩᏊ ᎠᏍᏚᏗ ᏂᏨᎤᎢ VPN, ᎫᏓᎸᎢ ᎾᎿᎢ ᏄᏓᎴ Wi-Fi ᏧᎾᏚᏓᎵ, ᎠᎴ ᎫᏓᎸᏙᏗ Ꭰ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to save. Files have been deleted or changed.">
                <langSet xml:lang="en-US"><tig><term>Unable to save. Files have been deleted or changed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎢ ᎠᎵᏏᏅᏙᏗ. ᏗᏍᏆᏂᎪᏙᏗ ᎤᏒᎦᏜᏅᎩ ᎠᏍᎪᎸᏛᎯ ᎠᎴ ᎤᏓᏁᏟᏴᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to desktop mode">
                <langSet xml:lang="en-US"><tig><term>Switch to desktop mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎾᎢ ᎦᏍᎩᎶᎩ ᎦᏚ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="No USB is detected. To reconnect to your PC, plug in your cable and keep your USB preferences the same.">
                <langSet xml:lang="en-US"><tig><term>No USB is detected. To reconnect to your PC, plug in your cable and keep your USB preferences the same.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ USB ᎨᎡᎢ ᎪᎷᏩᏛᏓ. ᎾᎢ ᏥᎱᏓᎸᎲᎩ ᎾᎢ ᏣᏤᎵ PC, ᎠᏍᏚᏙᏗ ᏣᏤᎵ ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᎠᎴ ᏍᏆᏂᎪᏕᏍᏗ ᏣᏤᎵ USB ᎤᏟ ᎠᏂᏰᎸᏍᎬᎢ ᎾᏍᎩ ᎤᏠᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connection failed. Try again or use a USB cable to connect instead.">
                <langSet xml:lang="en-US"><tig><term>Connection failed. Try again or use a USB cable to connect instead.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎤᏓᏄᎸᏅᎢ. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ ᎠᎴᏃ ᎬᏙᏓ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ ᎾᎢ ᏗᎵᎪᏙᏗ ᎤᎬᏫᏳᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No application available to open the file">
                <langSet xml:lang="en-US"><tig><term>No application available to open the file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏔᏲᏍᏙᏗ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to Desktop mode">
                <langSet xml:lang="en-US"><tig><term>Switch to Desktop mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎾᎢ ᎦᏍᎩᎶᎩ ᎦᏚ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device isn`t available. Remove it from saved list or restart it and try again.">
                <langSet xml:lang="en-US"><tig><term>Device isn`t available. Remove it from saved list or restart it and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎢᎬᎾᏕᏍᏗ ᎾᎿ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎵᏏᏅᏔᏅᎢ ᏓᏎᏍᏛᎢ ᎠᎴ ᏥᎭᏂᎩᏍᏓ ᎾᎿ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For">
                <langSet xml:lang="en-US"><tig><term>Ready For</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="In case still can't find your phone, Use your Moto camera scan the QR code">
                <langSet xml:lang="en-US"><tig><term>In case still can't find your phone, Use your Moto camera scan the QR code</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎢᎸᎯᏳ ᏏᏃ ᏝᏰᎵ ᏂᏩᏘᏍᎬᎾ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ, ᎬᏙᏓ ᏣᏤᎵ Moto ᏗᏓᏟᎶᏍᏙᏗ ᎠᎾᎦᎵᏍᎩ ᎠᎪᎵᏰᏍᎩ ᎾᏍᎩ QR ᎠᏍᏓᏩᏛᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Error code:{code}">
                <langSet xml:lang="en-US"><tig><term>Error code:{code}</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ:{code}</term></tig></langSet>
            </termEntry>
            <termEntry id="Portrait">
                <langSet xml:lang="en-US"><tig><term>Portrait</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ready For Assistant">
                <langSet xml:lang="en-US"><tig><term>Ready For Assistant</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᏍᎩᎾ ᎠᎵᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Once you start Mobile hotspot your currently active &amp;ltMobile Desktop&amp;gt {and_or} &amp;ltWebcam&amp;gt session would be closed. You would need to be restart &amp;ltMobile Desktop&amp;gt {and_or} &amp;ltWebcam&amp;gt session post establishing Mobile hotspot. Continue?">
                <langSet xml:lang="en-US"><tig><term>Once you start Mobile hotspot your currently active &amp;ltMobile Desktop&amp;gt {and_or} &amp;ltWebcam&amp;gt session would be closed. You would need to be restart &amp;ltMobile Desktop&amp;gt {and_or} &amp;ltWebcam&amp;gt session post establishing Mobile hotspot. Continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏊᏃ ᏱᏣᎴᏅᎭ ᎠᏓᏅᏏᏙᎯ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᏣᏤᎵ ᏃᏊᎨᏒᎢ ᎠᎵᏖᎸᎲᏍᎩ &amp;lt ᎠᏓᏅᏏᏙᎯ ᏍᎩ ᎦᏍᎩᎶᎩ ᎦᏚ&amp;gt {and_or} &amp;lt ᎠᏓᏴᎳᏛᏍᎩ ᏗᏓᏟᎶᏍᏙᏗ&amp;gt ᏧᏂᎳᏫᎢᏍᏗ ᎠᏍᏚᎮᏍᏓᏃ. ᏂᎯ ᏰᎵᏃ ᎤᏚᎸᏓ ᎾᎢ ᎬᏗ ᎠᏂᎩᏍᏙᏗᎢ &amp;lt ᎠᏓᏅᏏᏙᎯ ᏍᎩ ᎦᏍᎩᎶᎩ ᎦᏚ&amp;gt {and_or} &amp;lt ᎠᏓᏴᎳᏛᏍᎩ ᏗᏓᏟᎶᏍᏙᏗ&amp;gt ᏧᏂᎳᏫᎢᏍᏗ ᏧᏂᎳᏫᎢᏍᏗ ᎠᏃᏢᏍᎬ ᎠᏓᏅᏏᏙᎯ ᎤᏗᏞᎩ ᎤᏓᏓᏢ . ᏂᎦᏯᎢᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data sharing">
                <langSet xml:lang="en-US"><tig><term>Mobile data sharing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎠᏯᏙᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="{deviceName} is already in use">
                <langSet xml:lang="en-US"><tig><term>{deviceName} is already in use</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{deviceName} ᏄᏍᏛ ᎦᏳᎳ ᎾᎿᎢ ᎬᏙᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not recognized. Try again.">
                <langSet xml:lang="en-US"><tig><term>Not recognized. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎤᏬᎳᏨᎩ. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Analog clock">
                <langSet xml:lang="en-US"><tig><term>Analog clock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏍᏆᏥᏂ ᎦᎾᏁᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The features in Display give you more control over your screen. Attentive Display keeps the screen on while you’re looking at it, and Peek Display lets you see notifications while the screen is off.">
                <langSet xml:lang="en-US"><tig><term>The features in Display give you more control over your screen. Attentive Display keeps the screen on while you’re looking at it, and Peek Display lets you see notifications while the screen is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏎᏍᏙᏗ ᎾᎿ ᎬᏂᎨᏒ ᏅᎦ ᏧᏁᏗᏱ ᎤᎪᏗᏊ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᎠᎯᎸᏍᏗ. ᎠᎵᏏᎾᎯᏍᏗ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᏓᏍᏆᏂᎪᏗ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ ᎾᎯᏳᎢ ᎠᎦᏘᏍᎬ, ᎠᎴ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏅᎦ ᏩᏂᎩ ᏗᎾᏓᏃᏣᎳᏁᎯ ᏂᎯ ᎠᎪᏩᏛᏗ ᎾᎯᏳᎢ ᎠᏴᏙᎳᏛᎢ ᏄᏍᏛ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap and hold on the widget to find more features and clock styles.">
                <langSet xml:lang="en-US"><tig><term>Tap and hold on the widget to find more features and clock styles.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᏃᎴ ᏣᏂᏴᏎᏍᏗ ᎤᎾᎢ ᏫᏥᏘ ᎾᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᏛᏗ ᏗᎦᏎᏍᏙᏗ ᏃᎴ ᎦᎾᏁᏍᎩ ᏂᏚᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Peek Display">
                <langSet xml:lang="en-US"><tig><term>Peek Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Clock options">
                <langSet xml:lang="en-US"><tig><term>Clock options</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏁᏍᎩ ᏗᏑᏰᏍᏗ</term></tig></langSet>
