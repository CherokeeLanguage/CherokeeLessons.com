            </termEntry>
            <termEntry id="This important update will automatically install on .">
                <langSet xml:lang="en-US"><tig><term>This important update will automatically install on .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᎵᏍᎨᏓ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎯᏘᏅᎦ ᎾᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you have enough battery for installation.">
                <langSet xml:lang="en-US"><tig><term>Make sure you have enough battery for installation.</term></tig></langSet>
