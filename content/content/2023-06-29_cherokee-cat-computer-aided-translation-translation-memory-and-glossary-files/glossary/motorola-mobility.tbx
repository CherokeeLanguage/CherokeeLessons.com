                <langSet xml:lang="chr"><tig><term>ᎯᏁᏟᏴᎾ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ SMS ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app\u2019s data will be permanently deleted.">
