            </termEntry>
            <termEntry id="Tap &amp; swipe on the edge for quick shortcuts">
                <langSet xml:lang="en-US"><tig><term>Tap &amp; swipe on the edge for quick shortcuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ &amp; ᎯᏅᎦᎵᏓ ᎤᎾᎢ ᎠᏍᏛᎢ ᎾᏍᎩᎾ ᎤᏟᏍᏓ ᏗᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs some permissions to provide the best experience.">
                <langSet xml:lang="en-US"><tig><term>Gametime needs some permissions to provide the best experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏚᏚᎸᏛᎢ ᎢᎦᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏓᏁᎳᏁᏗ ᎾᏍᎩ ᏫᏓᏤᏢ ᎤᎦᏙᎲᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime needs permission to access background data to identify apps as games.">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime needs permission to access background data to identify apps as games.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎼᏙ ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏚᏚᎸᏛᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎾᎢ ᎪᏟᏍᏙᏗ ᏗᎬᏙᏗ ᎾᏍᎩ ᏧᎾᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="WhatsApp">
                <langSet xml:lang="en-US"><tig><term>WhatsApp</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᏍᏗᏊ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="connect">
                <langSet xml:lang="en-US"><tig><term>connect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect pattern on the next attempt, this device\u2019s data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect pattern on the next attempt, this device\u2019s data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎤᎾᎶᎢᏓ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe right from the edge">
                <langSet xml:lang="en-US"><tig><term>Swipe right from the edge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎠᎦᏘᏏᏗᏢ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎠᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge touch updates">
                <langSet xml:lang="en-US"><tig><term>Edge touch updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᎠᏒᏂᏍᏗ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Double tap">
                <langSet xml:lang="en-US"><tig><term>Double tap</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Shortcuts missing">
                <langSet xml:lang="en-US"><tig><term>Shortcuts missing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏥᏳᎪᏗᏊ ᎤᎪᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try performing the following gestures on the action bar:">
                <langSet xml:lang="en-US"><tig><term>Try performing the following gestures on the action bar:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᏣᎵᏂᎬᏁᏗᎢ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᏧᏬᏯᏁᏍᎩ ᎤᎾᎢ ᎠᎵᏖᎸᎲᏍᎩ ᎦᎾᏛᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Personal data may be accessible (such as contacts and email content).">
                <langSet xml:lang="en-US"><tig><term>Personal data may be accessible (such as contacts and email content).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎡᎵᏊ ᏅᏛᏴᏍᏙᏗᎢ (ᏕᎧᏁᎢᏍᏔᏅᎯ ᏗᏟᏃᎮᏙᏗ ᏃᎴ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᏄᏍᏗᏓᏅ).</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change the position of the action bar in settings.">
                <langSet xml:lang="en-US"><tig><term>You can change the position of the action bar in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏣᏁᏟᏴᏍᏓ ᎾᏍᎩ ᎠᎴᏙᏗ ᎾᏍᎩ ᎠᎵᏖᎸᎲᏍᎩ ᎦᎾᏛᎢ ᎾᎿᎢ ᏕᎦᎧᎲᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Prohibit Battery Saver mode">
                <langSet xml:lang="en-US"><tig><term>Prohibit Battery Saver mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᏍᏙᏍᎬ ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge touch turns on when shortcuts selected or actions turned on">
                <langSet xml:lang="en-US"><tig><term>Edge touch turns on when shortcuts selected or actions turned on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᎠᏒᏂᏍᏗ ᏓᏍᏚᎢᏍᎬᎢ ᎾᎯᏳ ᏗᏥᎶᎪᏗᏊ ᎠᏑᏰᏒᎢ ᏗᎵᏖᎸᏗ ᎠᏍᏚᎢᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="You can also find new tools in Edge touch settings.">
                <langSet xml:lang="en-US"><tig><term>You can also find new tools in Edge touch settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᏱᏩᏔ ᎢᏤ ᏗᎬᏔᏂᏓᏍᏗ ᎾᎿᎢ ᎠᏍᏛᎢ ᎠᏒᏂᏍᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Then, set the Motorola UVC camera as the video input source for the app you’re using on the PC.">
                <langSet xml:lang="en-US"><tig><term>Then, set the Motorola UVC camera as the video input source for the app you’re using on the PC.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏉᏃ, ᎤᎾᏓᏡᎬ ᏥᎩ Motorola UVC ᏗᏓᏟᎶᏍᏗᏍᎩ ᎤᎿᎢ ᏥᎩ ᏗᏓᏴᎳᏛᏍᎩ ᎦᏬᎯᎵᏴᏓ ᏧᏓᎴᏅᎲᎢ ᎤᎬᏩᏟ ᏥᎩ ᎬᏗ ᎬᏙᏗ ᎬᏗᎭ ᎤᎿᎢ ᏥᎩ PC.</term></tig></langSet>
            </termEntry>
            <termEntry id="This feature increases battery usage and your device may feel warmer while it’s on.">
                <langSet xml:lang="en-US"><tig><term>This feature increases battery usage and your device may feel warmer while it’s on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏕᎧᏁᏉᎦ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎩ ᎠᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎤᎦᎾᏩ ᏱᎩ ᎾᎯᏳᎢ ᎠᏍᏚᎢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Files were deleted from your PC.">
                <langSet xml:lang="en-US"><tig><term>Files were deleted from your PC.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏍᏆᏂᎪᏙᏗ ᎨᏒᎩ ᎠᏍᎪᎸᏛᎯ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ PC.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device protection features will not work without your screen lock.This deletes the fingerprint model stored on your device. Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face or fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>Device protection features will not work without your screen lock.This deletes the fingerprint model stored on your device. Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face or fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᏗᎦᏎᏍᏙᏗ ᎬᏗ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏄᏠᏯᏍᏛᎾ ᏂᏨᎤᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ.ᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᏃᎴ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Last opened">
                <langSet xml:lang="en-US"><tig><term>Last opened</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂ ᎠᏍᏚᎢᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Double tap for shortcuts">
                <langSet xml:lang="en-US"><tig><term>Double tap for shortcuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᎥᏍᏓ ᎾᏍᎩᎾ ᏗᏥᏳᎪᏗᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try performing the following gestures on the power key:">
                <langSet xml:lang="en-US"><tig><term>Try performing the following gestures on the power key:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏁᎵᏓ ᏣᎵᏂᎬᏁᏗᎢ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᏧᏬᏯᏁᏍᎩ ᎤᎾᎢ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ: </term></tig></langSet>
            </termEntry>
            <termEntry id="This app is using the microphone and camera.">
                <langSet xml:lang="en-US"><tig><term>This app is using the microphone and camera.</term></tig></langSet>
