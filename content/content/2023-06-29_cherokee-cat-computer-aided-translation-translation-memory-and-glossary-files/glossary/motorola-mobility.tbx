            </termEntry>
            <termEntry id="Choosing a certificate will let the app use this identity with servers now and in the future.">
                <langSet xml:lang="en-US"><tig><term>Choosing a certificate will let the app use this identity with servers now and in the future.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏑᏰᎭ Ꭰ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏎ ᏩᏂᎩ ᏥᎩ ᎬᏙᏗ ᎬᏔᏂᏓᏍᏗ ᎯᎠ ᎪᎵᏨᎢ ᎬᏗ ᏗᏯᏙᎯᎯ Ꭷ ᎠᎴ ᎾᎿ ᏥᎩ ᎤᏩᏗᏗᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Limit battery for apps that you don\u2019t use often">
                <langSet xml:lang="en-US"><tig><term>Limit battery for apps that you don\u2019t use often</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎯ ᎠᎾᎦᎵᏍᎩ ᏗᎬᏙᏗ ᏂᎯ ᏞᏍᏗᎬᏔᏂᏓᏍᏗ ᎢᏳᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="The app has identified the requesting server as , but you should only give the app access to the certificate if you trust the app.">
                <langSet xml:lang="en-US"><tig><term>The app has identified the requesting server as , but you should only give the app access to the certificate if you trust the app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎬᏙᏗ ᎤᎭ ᎪᏟᏍᏙᏔᏅ ᏥᎩ ᏥᏔᏲᎯᎲᎢ ᎠᏯᏙᎯᎯ ᎤᎿᎢ , ᎠᏎᏃ ᏂᎯ ᎾᎢᏳᏃ ᎤᏅᏒ ᏧᏁᏗᏱ ᏥᎩ ᎬᏙᏗ ᎠᏴᏍᏗ ᎤᎿᎢ ᏥᎩ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿ ᏂᎯ ᎨᎪᎯᏳᎯ ᏥᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When your phone associates with a Wi-Fi network, it will automatically try to register with the  network for Wi-Fi Calling.">
                <langSet xml:lang="en-US"><tig><term>When your phone associates with a Wi-Fi network, it will automatically try to register with the  network for Wi-Fi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎤᎾᎵᎪᎯ ᎬᏗ Ꭰ Wi-Fi ᎫᏓᎸᎢ, ᎨᎡᎢ ᎠᏎ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎾᎿᎢ ᎠᎪᏪᎶᏗ ᎬᏗ ᏥᎩ  ᎫᏓᎸᎢ ᎤᎬᏩᏟ Wi-Fi ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi preferred uses an active Wi-Fi network to place your call regardless of the cellular network you are on.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi preferred uses an active Wi-Fi network to place your call regardless of the cellular network you are on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᎤᏟ ᎠᏰᎸᏅ ᎬᏔᏂᏓᏍᏗ Ꭰ ᎬᏂᎦᎵᏍᏗ Wi-Fi ᎫᏓᎸᎢ ᎾᎿᎢ ᎤᏙᏢᏒ ᏂᏨᎤᎢ ᏪᏯᎾ ᎤᏍᎩ ᎠᏂᏰᎸᏍᎬ ᎾᎿ ᏥᎩ ᏫᏚᏍᏗᎬᎢ ᎫᏓᎸᎢ ᏂᎯ ᎨᎡᎩ ᎾᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Listen">
                <langSet xml:lang="en-US"><tig><term>Listen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏛᏓᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Lens">
                <langSet xml:lang="en-US"><tig><term>Lens</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎨᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove this suggestion?">
                <langSet xml:lang="en-US"><tig><term>Remove this suggestion?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᎯᎠ ᎧᏁᎢᏍᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="About">
                <langSet xml:lang="en-US"><tig><term>About</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏰᎵᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Searching for network extenders...">
                <langSet xml:lang="en-US"><tig><term>Searching for network extenders...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏲᎲᎢ ᎤᎬᏩᏟ ᎫᏓᎸᎢ ᏥᏅᎯᏗᏍᏗ...</term></tig></langSet>
