                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This also deletes the fingerprint model stored on your device.">
