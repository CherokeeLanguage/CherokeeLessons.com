                <langSet xml:lang="chr"><tig><term>ᎠᏑᏫᏓ ᏄᏪᏌᏴᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When Night light is on, the color tempertature you set will be overridden">
                <langSet xml:lang="en-US"><tig><term>When Night light is on, the color tempertature you set will be overridden</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏒᏃᏱ ᏯᏤᏍᏔ, Ꮎ ᎠᏑᏫᏓ ᏄᏪᏌᏴᎸᎢ ᏣᎧᏅᎢ ᎨᏎᏍᏗ ᎤᏙᎯᎵᏴᏓ</term></tig></langSet>
