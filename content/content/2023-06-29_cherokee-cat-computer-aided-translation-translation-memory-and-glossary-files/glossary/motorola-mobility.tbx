                <langSet xml:lang="chr"><tig><term>ᎤᎾᏄᎪᏫᏍᏗ ᎤᎬᏩᏟ Moto ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch &amp; hold to lock">
                <langSet xml:lang="en-US"><tig><term>Touch &amp; hold to lock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᎾᎿᎢ ᏍᏓᏯ ᎠᏍᏚᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the long screenshot button to capture content beyond the limits of your screen">
                <langSet xml:lang="en-US"><tig><term>Tap the long screenshot button to capture content beyond the limits of your screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏥᎩ ᎢᎪᎯᏓ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎦᏛᏗ ᎾᎿᎢ ᎦᏂᏴᏗ ᎠᏘᏍᏗᏍᎩ ᏫᏗᏗᏢ ᏥᎩ ᏓᏎᎸᎯ ᎾᎿ ᏂᏨᎤᎢ ᎠᏓᏎᎮᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to shrink is disabled when the fingerprint sensor is needed">
                <langSet xml:lang="en-US"><tig><term>Swipe to shrink is disabled when the fingerprint sensor is needed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎯᏍᏗᎪᎯᏍᏓ ᎨᎡᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎢᏳᏃ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎨᎡᎢ ᎤᏚᎸᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Send videos in">
                <langSet xml:lang="en-US"><tig><term>Send videos in</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᏗᏓᏴᎳᏛᏍᎩ ᎾᎿ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't get data from the server (). Please try again later.">
                <langSet xml:lang="en-US"><tig><term>Couldn't get data from the server (). Please try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎠᎩᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎠᏯᏙᎯᎯ (). ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Next, you'll need to choose an app to show on the bottom half of the screen.">
                <langSet xml:lang="en-US"><tig><term>Next, you'll need to choose an app to show on the bottom half of the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏐᎢ, ᏂᎯ ᎠᏎ ᎤᏚᎸᏓ ᎾᎿᎢ ᏣᏑᏰᏍᏗ Ꭰ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᏩᏛᏙᏗ ᎤᎿᎢ ᎾᎿᎢ ᎭᏫᏂ ᎡᏙᎯ ᎠᏰᏟ ᎾᎿ ᏥᎩ ᎠᏓᏎᎮᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can manage screen lock behavior in Settings.">
                <langSet xml:lang="en-US"><tig><term>You can manage screen lock behavior in Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᏓᏅᏖᎵᏓᏍᏗ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏴᏙᎳᏛᎢ ᎾᏛᏁᎲᎢ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Vibrate when DND turns on/off">
                <langSet xml:lang="en-US"><tig><term>Vibrate when DND turns on/off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᏗ ᎢᏳᏃ DND ᎠᎦᏔᎲᎠ ᎤᎿᎢ/ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Lift to unlock is disabled to comply with your account’s security policy">
                <langSet xml:lang="en-US"><tig><term>Lift to unlock is disabled to comply with your account’s security policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏌᎳᏙᏗ ᎠᏂᏐᎭᎾᎳᎩ ᎨᎡᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎾᎿᎢ ᎠᏍᏓᏩᏛᏍᏗ ᎬᏗ ᏂᏨᎤᎢ ᏗᏚᏓᎸᏙᏗ ᏧᎾᎦᏎᏍᏗ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove a participant to send message.">
                <langSet xml:lang="en-US"><tig><term>Remove a participant to send message.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᎾᏕᏍᏗ Ꭰ ᎠᏖᎳᏗᏙᎯ ᎾᎿᎢ ᏫᏅᎥᎦ ᏗᎦᏃᏣᎳᏅᎯ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Make a chopping motion to turn the flashlight on/off">
                <langSet xml:lang="en-US"><tig><term>Make a chopping motion to turn the flashlight on/off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᏗ a ᎦᎷᏱᏓᏍᏗ ᎠᏌᎳᏙᏗ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᏥᎩ ᎠᏨᏍᏗ ᎤᎿᎢ/ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="SD card is not accessible.">
                <langSet xml:lang="en-US"><tig><term>SD card is not accessible.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SD ᏆᎾᏲᏍᏗ ᎣᏍᏛ ᎥᏝ ᏅᏛᏴᏍᏙᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When the screen is off, press and hold the volume up key to go to the next track">
                <langSet xml:lang="en-US"><tig><term>When the screen is off, press and hold the volume up key to go to the next track</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏥᎩ ᎠᏓᏎᎮᎸᎢ ᎨᎡᎢ ᎠᏍᏚᏗ, ᎭᏐᏅᏍᏓ ᎠᎴ ᎯᎾᎯᏍᏓ ᏥᎩ ᏂᎦᎥ ᎤᏜᏅᏛᎢ ᎦᎸᎳᏗ ᎤᎵᏍᎨᏗ ᎾᎿᎢ Ꭷ ᎾᎿᎢ ᏥᎩ ᏐᎢᎪᎷᏅᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold your device in the portrait position so it can recognize your face">
                <langSet xml:lang="en-US"><tig><term>Hold your device in the portrait position so it can recognize your face</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏂᏴᏎᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿ ᏥᎩ ᎠᏰᎵ ᎠᎪᏩᏛᏙᏗ ᎦᎪᏗ ᏙᎢ ᎾᎿ ᏰᎵᏯ ᎨᏦᏟᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Computing\u2026">
                <langSet xml:lang="en-US"><tig><term>Computing\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏎᎯᏍᏗᏍᎩ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Switching to internal phone storage">
                <langSet xml:lang="en-US"><tig><term>Switching to internal phone storage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᎩ ᎾᎢ ᎭᏫᏂ ᏗᏟᏃᎮᏗ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose now">
                <langSet xml:lang="en-US"><tig><term>Choose now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ Ꭷ</term></tig></langSet>
            </termEntry>
            <termEntry id="Attentive Display is active">
                <langSet xml:lang="en-US"><tig><term>Attentive Display is active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏏᎾᎯᏍᏗ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap and swipe on the navigation bar to get around your device">
                <langSet xml:lang="en-US"><tig><term>Tap and swipe on the navigation bar to get around your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎴ ᎦᎶᎯᏍᏗᏍᎩ ᎤᎿᎢ ᏥᎩ ᎠᏓᏘᏂᏙᎯ ᏚᏓᏅᏅᎢ ᎾᎿᎢ ᎠᎩᏍᏗ ᎠᏕᏯᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Attentive Display doesn\’t work in battery saving mode">
                <langSet xml:lang="en-US"><tig><term>Attentive Display doesn\’t work in battery saving mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᏝᏍᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎿ ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᎭ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can use Edge lights to check your battery level and receive alerts, notifications, and calls">
                <langSet xml:lang="en-US"><tig><term>Now you can use Edge lights to check your battery level and receive alerts, notifications, and calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᏰᎵᏯ ᎬᏔᏂᏓᏍᏗ ᏏᎠᏍᏚᏂᏱ ᏗᏨᏍᏗ ᎾᎿᎢ ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᏄᏟᏂᎬᎬ ᎧᏃᎮᏍᎩ ᎠᎴ ᎦᏁᏍᏗ ᎠᏓᏕᏯᏔᎲᏍᎩ, ᎠᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Lights can show on the display edges when you're charging or you receive a call, notification, or alert">
                <langSet xml:lang="en-US"><tig><term>Lights can show on the display edges when you're charging or you receive a call, notification, or alert</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏨᏍᏛ ᏰᎵᏯ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᎿᎣ ᏥᎩ ᎠᏓᏴᎳᏔᏍᎩ ᏏᎠᏍᏚᏂᏱ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎠᎴ ᏂᎯ ᎦᏁᏍᏗ Ꭰ ᏪᏯᎾ, ᎠᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on One Button Nav?">
                <langSet xml:lang="en-US"><tig><term>Turn on One Button Nav?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏌᏇ ᎦᏛᏗ ᎠᏂᎩᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="1. Open the RSA client">
                <langSet xml:lang="en-US"><tig><term>1. Open the RSA client</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>1. ᎯᏍᏚᎢ ᎾᏍᎩ RSA ᎠᏥᏍᏕᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Suggestions in chat">
                <langSet xml:lang="en-US"><tig><term>Suggestions in chat</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᎢᏔᏅᎢ ᎾᎿ</term></tig></langSet>
            </termEntry>
            <termEntry id="When this service is turned off, Swipe to split will also turn off.">
                <langSet xml:lang="en-US"><tig><term>When this service is turned off, Swipe to split will also turn off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎯᎠ ᎤᎾᏓᏍᏕᎸᏗ ᎨᎡᎢ ᎠᏍᏚᏅᎢ, ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏍᏡᏍᏗ ᎠᏎ ᎾᏍᏊ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to split helps you quickly enter split screen mode.">
                <langSet xml:lang="en-US"><tig><term>Swipe to split helps you quickly enter split screen mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏍᏡᏍᏗ ᎠᎵᏍᏕᎵᏍᎪᎢ ᏂᎯ ᎤᏟᏍᏓᏬ ᎠᏴᏍᏗ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please update Moto Camera Content to access advanced Portrait features">
                <langSet xml:lang="en-US"><tig><term>Please update Moto Camera Content to access advanced Portrait features</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎪᏢᎯᏐᏗ Moto ᏗᏓᏥᎶᏍᏗᏍᎩ ᎦᎸᏛᎢ ᎾᎢ ᎠᏴᏍᏗ ᎤᎵᏱᎸᏛ ᏗᏓᏥᎶᏍᏔᏅ ᏗᎦᏎᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Actions is active">
                <langSet xml:lang="en-US"><tig><term>Moto Actions is active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎾᎾᏛᏁᎲᎢ ᎨᎡᎢ ᎬᏂᎦᎵᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="2G-3G data is paused">
                <langSet xml:lang="en-US"><tig><term>2G-3G data is paused</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>2G-3G ᎦᏘᏍᎩᏌᏅᎯ ᎠᏲᎯᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="This permission commands the system to enter split screen mode when you slide your finger back and forth on the screen.">
                <langSet xml:lang="en-US"><tig><term>This permission commands the system to enter split screen mode when you slide your finger back and forth on the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏚᏁᏤᎸᎩ ᏥᎩ ᏄᏍᏗᏓᏅᎢ ᎾᎿᎢ ᎠᏴᏍᏗ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ ᎢᏳᏃ ᏂᎯ ᎠᏲᏢᏗᎭ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᎠᏨᏍᏗ ᎠᎴ ᎦᏌᏙᏯᏍᏗ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep the screen on longer">
                <langSet xml:lang="en-US"><tig><term>Keep the screen on longer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏁᏟᏗᎭ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎤᎿᎢ ᎦᏅᎯᏓᎨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to shrink isn’t available when this Moto Mod is attached">
                <langSet xml:lang="en-US"><tig><term>Swipe to shrink isn’t available when this Moto Mod is attached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎯᏍᏗᎪᎯᏍᏓ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅ ᎢᏳᏃ ᎯᎠ Moto Mod ᎨᎡᎢ ᎦᏯᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="The objects are too close to capture a portrait photo. Normal photo will be captured.">
                <langSet xml:lang="en-US"><tig><term>The objects are too close to capture a portrait photo. Normal photo will be captured.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏧᏓᎴᏅᏓ ᎾᏍᎩᎾᏃ ᎾᎥᏂᎢ ᎾᎢ ᎦᏂᏴᏗ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏔᏅ ᏓᏟᎶᏍᏔᏅᎯ. ᏱᎬᏩᏍᏗᎭᏭ ᏗᏓᏥᎶᏍᏔᏅ ᏰᎵᏉ ᎨᏎᏍᏗ ᏕᏂᏴᎲᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn on One Button Nav, these apps that use your fingerprint sensor will be disabled:">
                <langSet xml:lang="en-US"><tig><term>When you turn on One Button Nav, these apps that use your fingerprint sensor will be disabled:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ ᏌᏇ ᎦᏛᏗ ᎠᏂᎩᏍᏗ, ᎯᎠᏃ ᏗᎬᏙᏗ ᎥᏍᎩᎾ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎠᏎ ᎨᎡᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Remember, this only works when your phone is lying on a flat surface">
                <langSet xml:lang="en-US"><tig><term>Remember, this only works when your phone is lying on a flat surface</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏅᏓᏛ, ᎯᎠ ᎤᏅᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎢᏳᏃ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎠᏝᎥ ᎤᎿᎢ Ꭰ ᎠᏯᏖᏂ ᎦᏚᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're finished!">
                <langSet xml:lang="en-US"><tig><term>You're finished!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᎡᎩ ᎤᏂᏍᏆᏛ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can customize and share your screenshots right after you capture them">
                <langSet xml:lang="en-US"><tig><term>Now you can customize and share your screenshots right after you capture them</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᏰᎵᏯ ᎠᏤᎲᏍᏙᏗ ᎠᎴ ᎠᏯᏙᏍᏗᎢ ᏂᏨᎤᎢ ᏓᏴᏙᎳᏛᎢ ᎠᎦᏘᏏ ᎤᎶᏐᏅ ᏂᎯ ᎦᏂᏴᏗ ᎢᏯᏂᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use Cutout, go to the gallery and choose a photo, tap \“Edit\”, and then choose \“Add background\” to modify the photo.">
                <langSet xml:lang="en-US"><tig><term>To use Cutout, go to the gallery and choose a photo, tap \“Edit\”, and then choose \“Add background\” to modify the photo.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ ᎦᏖᏅᏕᏓ, ᎤᎾᎢ ᎮᎾ ᎾᏍᎩ ᎧᏅᏑᎸ ᎤᏂᎿᎥ ᎠᎴ ᎠᏑᏰᏍᏗ ᏗᏓᏟᎶᏍᏔᏅ, ᎭᏐᏅᏍᏓ \“ᎦᏁᏟᏴᏓ ᎪᏪᎸ\”, ᎠᎴ ᎿᏉᏃ ᎠᏑᏰᏍᏗ \“ᎧᏁᏉᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ\” ᎾᎢ ᎤᏃᏢᎯᏐᏗ ᎾᏍᎩᏗᏓᏟᎶᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Optimized charging learns your charging behavior so it can charge the battery to  and then wait to charge the final  until shortly before you unplug.">
                <langSet xml:lang="en-US"><tig><term>Optimized charging learns your charging behavior so it can charge the battery to  and then wait to charge the final  until shortly before you unplug.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎾᏛᏁᎲᎢ ᎨᎡᎢ ᏰᎵᏯ ᎬᏂᏗᏍᏔᏅᎢ ᏥᎩ ᎠᎾᎦᎵᏍᎩ ᎾᎿᎢ  ᎠᎴ ᎾᏉᏃ ᎯᎦᏘᏓ ᎾᎿᎢ ᎬᏂᏗᏍᏔᏅᎢ ᏥᎩ ᎤᎵᏍᏆᏛᎯ  ᎩᎳ ᏂᎪᎯᎸᎾᏉ ᎠᏏᏅ ᏂᎯ ᎫᏓᎴᏍᎪ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Navigate faster, and get more screen space.">
                <langSet xml:lang="en-US"><tig><term>Navigate faster, and get more screen space.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏗ ᎦᏣᏄᎳᎯᎨ, ᎠᎴ ᎠᎩᏍᏗ ᎤᏟ ᎢᎦᎢ ᎠᏴᏙᎳᏛᎢ ᎤᏜᏅᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Get shortcuts to edit and share your screenshots immediately after you capture them">
                <langSet xml:lang="en-US"><tig><term>Get shortcuts to edit and share your screenshots immediately after you capture them</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᏍᏆᎳ ᎢᏗᎬᏁᎯ ᎾᎿᎢ ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᎠᎴ ᎠᏯᏙᏍᏗᎢ ᏂᏨᎤᎢ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎢᎬᏪᏅᏓᏉ ᎤᎶᏐᏅ ᏂᎯ ᎦᏂᏴᏗ ᎢᏯᏂᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Confirm your phone number">
                <langSet xml:lang="en-US"><tig><term>Confirm your phone number</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎯᏳᏙᏗ ᏂᏨᏅᎢ ᏗᎳᏃᎮᏗ ᎠᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove subject.">
                <langSet xml:lang="en-US"><tig><term>Remove subject.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᎾᏕᏍᏗ ᎧᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please, try to access it through the Settings app.">
                <langSet xml:lang="en-US"><tig><term>Please, try to access it through the Settings app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ, ᏣᏁᎸᏙᏗ ᎾᎿᎢ ᎠᏴᏍᏗ ᎨᎡᎢ ᏭᎵᏍᏗ ᏥᎩ ᏕᎦᎧᎲᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Face unlock isn’t working now.">
                <langSet xml:lang="en-US"><tig><term>Face unlock isn’t working now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ ᎨᎡᎢ ᎥᏝ ᏚᏂᎸᏫᏍᏓᏁᎲ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Changes the format, but you can edit the text">
                <langSet xml:lang="en-US"><tig><term>Changes the format, but you can edit the text</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏁᏟᏴᏍᏗ ᎾᏍᎩ ᏱᎬᏁᏗ, ᎠᏎᏃ ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏓ ᎪᏪᎸ ᎾᏍᎩ ᎪᏪᎳᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="It may take several days for your device to provide optimized charging.">
                <langSet xml:lang="en-US"><tig><term>It may take several days for your device to provide optimized charging.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏰᎵᏯ ᎠᎩᏍᏗ ᎢᎸᏍᎩ ᏧᏒᎯᏓ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Blocks sounds and vibrations, except from alarms">
                <langSet xml:lang="en-US"><tig><term>Blocks sounds and vibrations, except from alarms</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏆᎳ ᏗᏍᏆᎵᏛ ᏗᎬᏩᏬᏁᏙᏗ ᎠᎴ ᎠᎵᏖᎸᎲᏍᎬ, ᎢᏳᏍᎩᏂᏃᏅ ᏅᏓᏳᏓᎴᏅᎯ ᏗᏓᏕᏯᏙᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Over time, your device will learn your typical charging pattern.">
                <langSet xml:lang="en-US"><tig><term>Over time, your device will learn your typical charging pattern.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛ ᎠᏟᎢᎵᏒ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᎤᏠᏱᏊ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎤᎾᎶᎢᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Place phone on table">
                <langSet xml:lang="en-US"><tig><term>Place phone on table</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᏢᏒ ᏗᏟᏃᎮᏗ ᎤᎿᎢ ᏧᎾᎶᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edit &amp; share screenshots right after you capture them">
                <langSet xml:lang="en-US"><tig><term>Edit &amp; share screenshots right after you capture them</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎸ &amp; ᎠᏯᏙᏍᏗᎢ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎠᎦᏘᏏ ᎤᎶᏐᏅ ᏂᎯ ᎦᏂᏴᏗ ᎢᏯᏂᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To use these features, you and the contacts you exchange messages with need to have phones and services that are compatible with Advanced Messaging.">
                <langSet xml:lang="en-US"><tig><term>To use these features, you and the contacts you exchange messages with need to have phones and services that are compatible with Advanced Messaging.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎯᎠᏃ ᏗᎦᏎᏍᏙᏗ, ᏂᎯ ᎠᎴ ᏥᎩ ᏗᏟᏃᎮᏙᏗ ᏂᎯ ᎦᏁᏟᏴᏍᏗ ᏗᎪᎵᏰᏗ ᎬᏗ ᎤᏚᎸᏓ ᎾᎿᎢ ᎤᎭ ᏗᏟᏃᎮᏗ ᎠᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎥᏍᎩᎾ ᎨᎡᎩ ᏗᏙᎸᎩ ᎬᏗ ᎢᏴᏛ ᎠᏱᎸᏛ ᏓᎾᏓᏪᎳᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Actions and Gestures needs the following permission:">
                <langSet xml:lang="en-US"><tig><term>Actions and Gestures needs the following permission:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎾᏛᏁᎲᎢ ᎠᎴ ᏧᏬᏯᏂᏍᎩ ᏧᏚᎸᏓ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Block notifications for calls and messages by turning your phone face down.">
                <langSet xml:lang="en-US"><tig><term>Block notifications for calls and messages by turning your phone face down.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳ ᏗᎾᏓᏃᏣᎳᏁᎯ ᎤᎬᏩᏟ ᏓᏯᏂ ᎠᎴ ᏗᎪᎵᏰᏗ ᎠᎦᏔᎲᏍᎬ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎡᎳᏗ ᏭᎧᏔ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Easily add or remove group members.">
