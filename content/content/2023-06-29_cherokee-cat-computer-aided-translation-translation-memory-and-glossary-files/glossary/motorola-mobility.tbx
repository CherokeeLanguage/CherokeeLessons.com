            </termEntry>
            <termEntry id="Carrier data accounting may differ from your device.">
                <langSet xml:lang="en-US"><tig><term>Carrier data accounting may differ from your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏫᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ ᏰᎵᏉ ᏚᏓᎴᎿᎥ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When Do Not Disturb is on, sound and vibration will be muted, except for the items you allow above.">
                <langSet xml:lang="en-US"><tig><term>When Do Not Disturb is on, sound and vibration will be muted, except for the items you allow above.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᏍᎩ ᎤᎾᎢ, ᎤᏃᏴᎬ ᏃᎴ ᎠᎵᏖᎸᎲᏍᎬ ᏰᎵᏉ ᎨᏎᏍᏗ ᎡᎳᏪᏉ ᎨᏎᏍᏗ, ᎢᏳᏍᎩᏂᏃᏅ ᎾᏍᎩᎾ ᏑᏓᎮᎩ ᏗᎬᏙᏗ ᏂᎯ ᎠᏓᎵᏍᎪᎸᏓᏁᎸᎢ ᎦᎸᎳᏗᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Default for mobile data">
                <langSet xml:lang="en-US"><tig><term>Default for mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data Saver">
                <langSet xml:lang="en-US"><tig><term>Data Saver</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎠᎵᏏᏅᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="All Do Not Disturb rules created by this app will be removed.">
                <langSet xml:lang="en-US"><tig><term>All Do Not Disturb rules created by this app will be removed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᏧᏂᎧᎾᏩᏛᏍᏗ ᎪᏢᏅᎢ ᏄᏩᏅ ᎯᎠ ᎬᏙᏗ ᏰᎵᏉ ᎠᎲᏍᏓ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="write modify system settings">
                <langSet xml:lang="en-US"><tig><term>write modify system settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᎤᏃᏒᎯᏐᏗ ᏄᏍᏗᏓᏅᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically set lower priority notifications to Gentle">
                <langSet xml:lang="en-US"><tig><term>Automatically set lower priority notifications to Gentle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎦᎧᎲᎢ ᎡᎳᏗᏨ ᎤᎵᏍᎨᏓ ᏗᏓᏃᏣᎳᏁᎯ ᎾᎢ ᎤᏓᏅᏘ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi will turn back on near high\u2011quality saved networks, like your home network">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi will turn back on near high\u2011quality saved networks, like your home network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᏯᎵᏍᏚᎢ Ꮎ ᎦᎸᎳᏗ \u2011 ᎢᏲᏍᏓ ᎠᎯᏯᏍᏗ ᏓᏏᎸᏓ, ᎤᏐᏱ ᏗᏤᏅᏒ ᏥᏓᏏᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="When this feature is turned on, you can beam app content to another NFC-capable device by holding the devices close together. For example, you can beam web pages, YouTube videos, contacts, and more.Just bring the devices together (typically back to back) and then tap your screen. The app determines what gets beamed.">
                <langSet xml:lang="en-US"><tig><term>When this feature is turned on, you can beam app content to another NFC-capable device by holding the devices close together. For example, you can beam web pages, YouTube videos, contacts, and more.Just bring the devices together (typically back to back) and then tap your screen. The app determines what gets beamed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏎᏍᏙᏗ ᎠᏍᏚᎢᏗ ᏱᎩ, ᏱᏣᏍᏛᎦ ᎬᏙᏗ ᏄᏍᏗᏓᏅ ᏄᏛᎴᎢ NFC-ᎪᏢᎾ ᏥᏂᎬᏅᏗᏓᎾ ᏱᏣᏂᏴ ᏥᏂᎬᏗᏓᏂ ᎾᎥ ᏱᏂᏗᎬᏁᎳ ᏱᏓᏥᎶᏍᏔᏅ, ᏱᏣᏍᏛᎦ ᎠᏏᎳᏕᏫᏒ ᏚᎦᏅᏓᏛᎢ, YouTube ᏗᏓᏴᎳᏛᏍᎦ, ᏗᏢᏃᎮᏙᏗ, ᏃᎴ ᎤᏍᏈᏍᏗ ᏐᎢᎢᏧᎳᎭ ᏂᏛᎦ ᏥᏂᎬᏅᏗᏓᎾ (ᎣᏂᏗᎸ ᎢᏧᎳ ᏱᏂᏗᎬᏁᎳ) ᎯᏐᏍᏓᏃ ᎠᏛᏴᎳᏛᏍᎩ ᎾᎬᏙᏗ ᏛᏑᏰᏍᏏ ᎢᏳᏍᏗ ᎠᏨᏍᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="Volte2">
                <langSet xml:lang="en-US"><tig><term>Volte2</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Volte2</term></tig></langSet>
            </termEntry>
            <termEntry id="Max visible datasets">
