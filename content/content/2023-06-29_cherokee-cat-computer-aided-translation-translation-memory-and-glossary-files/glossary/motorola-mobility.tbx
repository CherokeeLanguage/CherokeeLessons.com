            </termEntry>
            <termEntry id="Your contacts\u2019 phone numbers will be periodically sent to your carrier.">
                <langSet xml:lang="en-US"><tig><term>Your contacts\u2019 phone numbers will be periodically sent to your carrier.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ\u2019 ᏗᏟᏃᎮᏗ ᏗᏎᏍᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎢᏳᏓᎵᏊ ᎾᎾᎢ ᏫᎦᏅᏅᎢ ᏣᏤᎵ ᎠᎯᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow modification of Wi\u2011Fi and Mobile settings">
                <langSet xml:lang="en-US"><tig><term>Allow modification of Wi\u2011Fi and Mobile settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎬᏩᏂᏁᏉᏍᏙᏗ ᎥᎿᎢ Wi\u2011Fi ᎠᎴ ᎠᏓᏅᏏᏙᎯ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="JPG+RAW">
