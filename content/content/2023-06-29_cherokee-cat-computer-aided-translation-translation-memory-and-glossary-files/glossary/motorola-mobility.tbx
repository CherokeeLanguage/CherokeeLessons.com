            <termEntry id="We collect and report usage information to keep your software up-to-date and help us improve our products and services. ">
                <langSet xml:lang="en-US"><tig><term>We collect and report usage information to keep your software up-to-date and help us improve our products and services. </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎩᏟᏌᏅᎢ ᏃᎴ ᎬᏂᎨᏒ ᏃᏨᏁᎰ ᎬᏙᏗ ᎧᏃᎸᎥᏍᎩ ᏣᏂᏴᏒᎢ ᏩᏂᎨ ᎦᎾᏗᏅᏗ ᎠᏤᎲᏍᏔᏅᎢ-ᎾᎢ-ᎢᎦ ᏃᎴ ᎢᎩᏍᏕᎸᏗ ᏗᎪᏢᎯᏐᏗ ᏦᎦᏣᎵ ᏗᎪᏢᏅᎯ ᏃᎴ ᎢᏗᏓᏛᏁᏗᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="You have elected to not share information with us required to provide device support.">
                <langSet xml:lang="en-US"><tig><term>You have elected to not share information with us required to provide device support.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏛ ᎭᏗ ᏣᏲᏔᏛᏗ ᏱᎩ ᎧᏃᎮᏢᏗ ᎢᎩᏠᏯᏍᏗᎢᏯᏛᏁᏗ ᎠᏓᏁᎳᏁᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎦᎫᏍᏛᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select each app for more information. Only applicable in case your device has been financed.">
