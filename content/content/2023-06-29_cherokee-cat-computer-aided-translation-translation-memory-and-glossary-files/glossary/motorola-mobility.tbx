            </termEntry>
            <termEntry id="Battery used when tablet is idle">
                <langSet xml:lang="en-US"><tig><term>Battery used when tablet is idle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏗ ᎬᏔᏅᎯ ᎢᏳᏃ ᎬᏗᏍᎩ ᎪᎱᏍᏗ ᎾᏛᏁᎲᎾ ᏗᎪᏪᎶᏗᎢ</term></tig></langSet>
