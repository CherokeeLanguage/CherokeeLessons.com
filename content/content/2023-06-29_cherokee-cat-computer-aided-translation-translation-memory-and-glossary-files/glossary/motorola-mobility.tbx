            </termEntry>
            <termEntry id="Dolby Audio is unable to be turned on for the current output device.">
                <langSet xml:lang="en-US"><tig><term>Dolby Audio is unable to be turned on for the current output device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Dolby Audio ᏄᏍᏛ ᎤᏓᏄᎸᏅ ᎾᎢ ᎠᏍᏚᎢᏍᏗᎢ ᎾᏍᎩᎾ ᏃᏊᏥᎩ ᎤᏅᎪᎯᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth disconnected, Stylus action disabled">
                <langSet xml:lang="en-US"><tig><term>Bluetooth disconnected, Stylus action disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎫᏓᎴᏓᏃ, ᏗᎪᏪᎳᏅ ᎠᎵᏖᎸᏗ ᎠᎴᏫᏍᏙᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM Slot">
                <langSet xml:lang="en-US"><tig><term>SIM Slot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᎤᏜᏅᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the settings icon to customize your shortcuts and find more stylus options">
                <langSet xml:lang="en-US"><tig><term>Tap on the settings icon to customize your shortcuts and find more stylus options</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎤᎾᎢ ᎾᏍᎩ ᏕᎦᎧᎲᎢ ᎠᎢᎧᏂ ᎾᎢ ᎠᏤᎲᏍᏙᏗ ᏣᏤᎵ ᏥᏳᎪᏓᏃ ᎠᎴ ᎯᏩᏔ ᎤᏟ ᎢᎦᎢ ᏗᎪᏪᎳᏅ ᏗᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn them back in the overflow menu.">
                <langSet xml:lang="en-US"><tig><term>You can turn them back in the overflow menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏕᎯᎦᏔᎲᏍᏗ ᎾᎿᎢ ᎬᎧᎵᏬᎯᏍᎩ ᎪᏪᎳᎾᎥᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Mirror mode is on">
                <langSet xml:lang="en-US"><tig><term>Mirror mode is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎨᏗ ᎬᏙᏗᎭ ᏄᏍᏛ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="P2P mode">
                <langSet xml:lang="en-US"><tig><term>P2P mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>P2P ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="MotoStylusService">
                <langSet xml:lang="en-US"><tig><term>MotoStylusService</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᎪᏪᎳᏅ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please make sure the stylus is connected with the phone by bluetooth and keep connecting during updating.">
                <langSet xml:lang="en-US"><tig><term>Please make sure the stylus is connected with the phone by bluetooth and keep connecting during updating.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᏄᏍᏛ ᎫᏓᎸᏅᎯ ᎤᏠᎯᏯᏍᏗ ᎾᏍᎩ ᏗᏟᏃᎮᏗ ᎬᏗ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎠᎴ ᏂᎦᏯᎢᏒ ᎫᏓᎸᏅᎯ ᎾᎯᏳᎢ ᎠᏤᎲᏍᏗᏍᎬ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Take notes anytime without unlocking your device. When you're ready to take a note, just remove the stylus to open Moto Note.">
                <langSet xml:lang="en-US"><tig><term>Take notes anytime without unlocking your device. When you're ready to take a note, just remove the stylus to open Moto Note.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏪᎸᎦ ᏧᏍᏗ ᏕᎪᏪᎸ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ ᏄᏠᏯᏍᏛᎾ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎢ ᏙᏪᎸᎦ ᎤᏍᏗ ᎪᏪᎸ, ᏍᎩᏋ ᎠᎲᏍᏗ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎾᎢ ᎯᏍᏚᎢ Moto ᎤᏍᏗ ᎪᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Privacy Policy">
                <langSet xml:lang="en-US"><tig><term>Privacy Policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Active Stylus permission">
                <langSet xml:lang="en-US"><tig><term>Moto Active Stylus permission</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎠᎵᏖᎸᎲᏍᎩ ᏗᎪᏪᎳᏅ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This mode can't be opened. Make sure the Moto Experience Hub app is installed and enabled.">
                <langSet xml:lang="en-US"><tig><term>This mode can't be opened. Make sure the Moto Experience Hub app is installed and enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗᎭ ᏝᏰᎵ ᎨᏒ ᏱᎦᏴᏍᏚᎢ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᎾᏍᎩ Moto ᎠᎦᏙᎲᏒᎢ ᎠᏰᏟ ᎬᏙᏗ ᎦᏘᏅᏔᏅ ᏄᏍᏗ ᎠᎴ ᎡᎵᏊ ᏱᎬᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto experiences">
                <langSet xml:lang="en-US"><tig><term>Moto experiences</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎤᏂᎦᏙᎲᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press this button to open the app tray in Mobile desktop or the sidebar in Game, TV, and Video chat modes.">
                <langSet xml:lang="en-US"><tig><term>Press this button to open the app tray in Mobile desktop or the sidebar in Game, TV, and Video chat modes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎯᎠ ᎠᏐᎥᏍᏙᏗ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎬᏙᏗ ᎠᏝᏅᏙᏗ ᏅᎿᎢ ᎠᏓᏅᏏᏙᎯ ᎦᏍᎩᎶᎩ ᎦᏚ ᎠᎴᏃ ᎾᏍᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎾᎿᎢ ᏗᏁᎸᏙᏗ, ᎠᏓᏴᎳᏛᏍᎩ, ᎠᎴ ᎠᏓᏴᎳᏛᏍᎩ ᏗᏟᏃᎮᏓ ᏗᎬᏙᏗᎭ. </term></tig></langSet>
            </termEntry>
            <termEntry id="The application you have just installed/enabled cannot handle NFC contactless transaction.">
                <langSet xml:lang="en-US"><tig><term>The application you have just installed/enabled cannot handle NFC contactless transaction.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ ᎬᏙᏗ ᏂᎯ ᏚᏳᎪᏛᎢ ᏣᏘᏅᏔᏅ/ᎠᎵᏍᎪᎸᏓᏁᎯ ᎡᎵᏊ ᏂᎨᏒ ᎾᏛᏁᎲ NFC ᎤᎪᏗᏗ ᎢᏳᏍᏗ ᏯᏛᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows an app to ask for permission to ignore battery optimizations for that app.">
                <langSet xml:lang="en-US"><tig><term>Allows an app to ask for permission to ignore battery optimizations for that app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᏓᏛᏗ ᎾᏍᎩᎾ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎾᎦᏎᏍᏔᏅᎾ ᎠᎾᎦᎵᏍᎩ ᏧᏃᏢᎯᏐᏗ ᏩᏂᎨ ᏗᎦᎾᏗᏅᏗ ᎾᏍᎩᎾ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
