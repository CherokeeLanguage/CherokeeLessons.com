            <termEntry id="This privileged or system app can take pictures and record videos using a system camera at any time.">
                <langSet xml:lang="en-US"><tig><term>This privileged or system app can take pictures and record videos using a system camera at any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎤᏪᎿᎢ ᎠᎴᏃ ᏄᏍᏗᏓᏅᎢ ᏄᏍᏗᏓᏅᎢ ᎬᏙᏗ ᏰᎵᏊ ᏔᎵᎶᏍᏓ ᎠᎴ ᎦᏂᏴᏙᏗ ᏗᏓᏴᎳᏛᏍᎩ ᎬᏗᏍᎬ ᏄᏍᏗᏓᏅᎢ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎢᏴᏊ ᎨᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Requires the android.permission.CAMERA permission to be held by the app as well">
