            </termEntry>
            <termEntry id="Because turning on  affects data encryption, you need to confirm your PIN.">
                <langSet xml:lang="en-US"><tig><term>Because turning on  affects data encryption, you need to confirm your PIN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᎠᏍᏚᎢᏓ  ᏱᏗᎬᏂᏏᏍᎩ ᎦᏟᏌᏅᎯ ᎠᏕᎵᏍᏔᏅ, ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᏦᎯᏳᏙᏗ ᏂᏨᏅᎢ PIN.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi networks">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᏓᏏᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remember network">
                <langSet xml:lang="en-US"><tig><term>Remember network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏅᏛᏓ ᏓᏏᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="In addition to using your fingerprint to unlock your device, you can further protect this device by requiring your PIN before it starts up.">
                <langSet xml:lang="en-US"><tig><term>In addition to using your fingerprint to unlock your device, you can further protect this device by requiring your PIN before it starts up.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎧᏁᏉᏍᏓ ᎾᎢ ᎬᏗᏍᎬ ᏣᏤᎵ ᎦᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎾᎢ ᎦᏐᎭᎾᎳᎩᏍᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᏂᎯ ᏰᎵᏊ ᎤᏗᏗᏢ ᎠᎵᏍᏕᎸᏙᏗ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏩᏅ ᎠᏎᎾᏛᏁᎮᏍᏗ ᏣᏤᎵ PIN ᎤᏓᎷᎸ ᎾᏍᎩ ᏓᏂᎩᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Forget network">
                <langSet xml:lang="en-US"><tig><term>Forget network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎨᏫᏒ ᏓᏏᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove photos &amp; videos">
                <langSet xml:lang="en-US"><tig><term>Remove photos &amp; videos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎲᏍᏗ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To see available networks, turn Wi\u2011Fi on.">
                <langSet xml:lang="en-US"><tig><term>To see available networks, turn Wi\u2011Fi on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏒᎪᏩᏛᏗ ᎠᏛᏅᎢᏍᏔᏅ ᏓᏏᎸᏓ, ᎯᏍᏚᎢ Wi\u2011Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Searching for networks\u2026">
                <langSet xml:lang="en-US"><tig><term>Searching for networks\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲᎯ ᏓᏏᎸᏓ \u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Items are copied to clipboard, you can paste it to your PC directly.">
                <langSet xml:lang="en-US"><tig><term>Items are copied to clipboard, you can paste it to your PC directly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏑᏓᎴᎩ ᏗᎪᏪᎵ ᎨᎡᎢ ᏓᏟᎶᏍᏔᏅᎯ ᎾᎿᎢ ᏗᎦᏯᎸᏙᏗᎢ, ᏂᎯ ᏰᎵᏯ ᏣᏯᎸᏗ ᎨᎡᎢ ᎾᎿᎢ ᏂᏨᎤᎢ PC ᎠᏓᏎᎮᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatic setup (WPS)">
                <langSet xml:lang="en-US"><tig><term>Automatic setup (WPS)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎾᏛᎦ ᏘᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Accessibility button">
                <langSet xml:lang="en-US"><tig><term>Accessibility button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒ ᎠᏐᏅᏍᏙᏗ ᏄᏍᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Wi-Fi or Mobile data">
                <langSet xml:lang="en-US"><tig><term>Use Wi-Fi or Mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ Wi-Fi ᎠᎴ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi scanning allows apps and services to scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off.">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi scanning allows apps and services to scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᏗᏓᏟᎶᏍᏗᏍᎩ ᎠᎵᏍᎪᎵᏗ ᏗᎬᏙᏗ ᎠᎴ ᏴᏛᏁᏗ ᏧᏓᏟᎶᏍᏙᏗ Wi\u2011Fi ᏓᏏᎸᏓ ᎢᏳᏫ ᎨᏎᏍᏗ, ᏍᏊ Wi\u2011Fi ᏯᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="This can be used, for example, to improve location\u2011based features and services.">
                <langSet xml:lang="en-US"><tig><term>This can be used, for example, to improve location\u2011based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏴᏓ, ᏓᏟᎶᏍᏓ, ᎪᏝᎯᏐᏗ ᎮᏙᎲᎢ \u2011 ᏗᎦᏎᏍᏙᏗ ᎠᎴ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi\u2011Fi scanning turned on">
                <langSet xml:lang="en-US"><tig><term>Wi\u2011Fi scanning turned on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi\u2011Fi ᏗᏓᏟᎶᏍᏙᏗ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Advanced options">
                <langSet xml:lang="en-US"><tig><term>Advanced options</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛᎠᏱᎸᏛ ᏧᎾᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Drop down list Advanced Options">
                <langSet xml:lang="en-US"><tig><term>Drop down list Advanced Options</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏱᎬᏁᏗᏕᎦᏅᏅᏛ ᎢᏴᏛ ᎠᏱᎸᏗ ᏧᎾᏑᏰᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="expand">
                <langSet xml:lang="en-US"><tig><term>expand</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏁᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter the SSID">
                <langSet xml:lang="en-US"><tig><term>Enter the SSID</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏴᏓ Ꮎ SSID</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase all data?">
                <langSet xml:lang="en-US"><tig><term>Erase all data?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="If your router is not broadcasting a network ID but you would like to connect to it in the future, you can set the network as hidden.">
                <langSet xml:lang="en-US"><tig><term>If your router is not broadcasting a network ID but you would like to connect to it in the future, you can set the network as hidden.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏫᎦᎶᎯᏍᏗ ᏂᏗᎦᎴᏯᏍᏗᎲᎾ ᏕᎫᏓᎸ ᎠᏎᏃ ᏱᏣᏚᎵ ᏗᎫᏓᎸᏗ ᎤᏩᎫᏗᏗᏒ, ᏕᎦᎧᎲ ᏱᏕᎲᏍᎦᎸᎦ ᏕᎫᏛᎸᎥ</term></tig></langSet>
            </termEntry>
            <termEntry id="This may create a security risk because your phone will regularly broadcast its signal to find the network.">
                <langSet xml:lang="en-US"><tig><term>This may create a security risk because your phone will regularly broadcast its signal to find the network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎵᏊ ᎠᎦᏎᏍᏙᏗ ᏱᏂᎬᎵᏍᏗ ᎢᎬᏂᏏᏍᎩ ᏗᏝᏃᎮᏗ ᏂᎪᎯᎸ ᏕᎦᎴᏯᏍᏗᎲ ᎤᏲᎲ ᎠᏓᏃᏎ ᎠᎾ ᏕᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you turn on , your device won’t use your screen lock to enhance data encryption.">
                <langSet xml:lang="en-US"><tig><term>If you turn on , your device won’t use your screen lock to enhance data encryption.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ , ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᏍᏗ ᏰᎵ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᏓᏤᎴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏕᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Setting the network as hidden will not change your router settings.">
                <langSet xml:lang="en-US"><tig><term>Setting the network as hidden will not change your router settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲ ᏕᎫᏓᎸᎢ ᏱᏗᏕᎲᏍᎦᎸᎾ Ꮭ ᏱᏛᎬᏁᏟᏴᏍᎢ Ꮎ ᏫᎦᎶᎯᏍᏗ ᏕᎦᎧᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Transmit link speed">
                <langSet xml:lang="en-US"><tig><term>Transmit link speed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏗᏱ ᎫᏓᎸᎢ ᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Receive link speed">
                <langSet xml:lang="en-US"><tig><term>Receive link speed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᎫᏓᎸᎢ ᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Link speed">
                <langSet xml:lang="en-US"><tig><term>Link speed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Saved via">
                <langSet xml:lang="en-US"><tig><term>Saved via</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏆᏂᎪᏛᏅᎢ Ꮎ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can wake up Peek Display by tapping twice on the screen">
                <langSet xml:lang="en-US"><tig><term>You can wake up Peek Display by tapping twice on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏰᏍᏗ ᎤᏟᏍᏓ ᏗᎧᎿᏅ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏄᏍᏛ ᎭᏐᎥᏍᏗᏍᎬᎢ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
