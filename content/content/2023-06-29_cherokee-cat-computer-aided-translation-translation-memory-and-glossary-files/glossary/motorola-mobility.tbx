            </termEntry>
            <termEntry id="To protect your data, if the app is unused for a few months, the following permissions will be removed: ">
                <langSet xml:lang="en-US"><tig><term>To protect your data, if the app is unused for a few months, the following permissions will be removed: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ, ᎾᎿ ᏥᎩ ᎬᏙᏗ ᎨᎡᎢ ᎬᏔᏅᏂᎨᏒᎾ ᎤᎬᏩᏟ Ꭰ ᎦᏲᎵ ᎢᏯᏅᏓ, ᏥᎩ ᎠᏍᏓᏩᏛᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏎ ᎨᎡᎢ ᎠᎲᏍᏓ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Allow all the time">
                <langSet xml:lang="en-US"><tig><term>Allow all the time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app wants to take pictures and record video all the time, even when you\u2019re not using the app. Allow in settings.">
