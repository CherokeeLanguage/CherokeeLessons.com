            <termEntry id="Choose the connection you prefer when outside the Visible Mobile Network (Wi-Fi or Cellular)">
                <langSet xml:lang="en-US"><tig><term>Choose the connection you prefer when outside the Visible Mobile Network (Wi-Fi or Cellular)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏥᎩ ᎫᏓᎸᎢ ᏂᎯ ᎤᏟ ᎠᏰᎸᏗ ᎢᏳᏃ ᏙᏱ ᏥᎩ ᎬᎪᏩᏛᏗ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ (Wi-Fi ᎠᎴ ᏫᏚᏍᏗᎬᎢ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Check for new system update">
                <langSet xml:lang="en-US"><tig><term>Check for new system update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᎤᎬᏩᏟ ᏗᏤ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi disconnected">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi disconnected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᎫᏓᎴᏓᏃ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set notification tone informing the status of cellular service">
                <langSet xml:lang="en-US"><tig><term>Set notification tone informing the status of cellular service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏓᏡᎬ ᎠᏓᏃᏣᎳᏁᎯ ᎭᏃᏴᎬ ᎠᏥᏃᎯᏎᎲ ᏥᎩ ᏄᏛᎿᏕᎬᎢ ᎾᎿ ᏫᏚᏍᏗᎬᎢ ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Network lost tone">
                <langSet xml:lang="en-US"><tig><term>Network lost tone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ ᎤᏂᏲᎱᏎᎸ ᎭᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Configuration not updated to">
                <langSet xml:lang="en-US"><tig><term>Configuration not updated to</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛ ᎪᏢᏒᎢ ᎥᏝ ᎪᏢᎯᏌᏅ ᎾᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select to continue with update">
                <langSet xml:lang="en-US"><tig><term>Select to continue with update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎾᎿᎢ ᎠᎯᎸᏍᏗ ᎬᏗ ᏗᎪᏢᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Roaming banner">
                <langSet xml:lang="en-US"><tig><term>Roaming banner</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏙᎵᏙᎲ ᎦᎸᎳᏗ ᎦᏓᏛᏗ ᏗᎦᏃᏣᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Play tone when network connection is lost">
                <langSet xml:lang="en-US"><tig><term>Play tone when network connection is lost</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏛᏁᎸᏗ ᎭᏃᏴᎬ ᎢᏳᏃ ᏧᎾᏚᏓᎵ ᎫᏓᎸᎢ is ᎤᏂᏲᎱᏎᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="LAST SYSTEM UPDATE INFORMATION">
                <langSet xml:lang="en-US"><tig><term>LAST SYSTEM UPDATE INFORMATION</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏌᏅᎯ ᎧᏃᎮᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect password on the next attempt, this device\u2019s data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect password on the next attempt, this device\u2019s data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System update available">
                <langSet xml:lang="en-US"><tig><term>System update available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏌᏅᎯ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Roaming tone">
                <langSet xml:lang="en-US"><tig><term>Roaming tone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏙᎵᏙᎲᎭᏃᏴᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Audio effects?">
                <langSet xml:lang="en-US"><tig><term>Turn on Audio effects?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎤᏃᏴᎬ ᏄᎵᏍᏔᏅ?</term></tig></langSet>
            </termEntry>
            <termEntry id="This may take a few moments...">
                <langSet xml:lang="en-US"><tig><term>This may take a few moments...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏰᎵᏯ ᎠᎩᏍᏗ Ꭰ ᎦᏲᎵ ᏂᏚᎵᏍᏔᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Try updating your emergency address later.">
                <langSet xml:lang="en-US"><tig><term>Try updating your emergency address later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏁᎸᏙᏗ ᎠᏤᎲᏍᏗᏍᎬ ᏂᏨᎤᎢ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎣᏂᏯᎨᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In the meantime, your previous address will be used for 911 calls made over Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>In the meantime, your previous address will be used for 911 calls made over Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏥᎩ ᎾᎯᏳᏃ, ᏂᏨᎤᎢ ᏧᏩᎫᏔᏅ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎠᏎ ᎨᎡᎢ ᎬᏔᏅᎯ ᎤᎬᏩᏟ 911 ᏓᏯᏂ ᏄᎵᏍᏔᏅ ᎢᏴᏛ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Prefer other cellular networks">
                <langSet xml:lang="en-US"><tig><term>Prefer other cellular networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏟ ᎬᏰᎸᏗ ᏐᎢ ᏫᏚᏍᏗᎬᎢ ᏚᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please try again later.">
                <langSet xml:lang="en-US"><tig><term>Please try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Configuration updated">
                <langSet xml:lang="en-US"><tig><term>Configuration updated</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛ ᎪᏢᏒᎢ ᎪᏢᎯᏌᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Port number should be within 1000 and 65534.">
                <langSet xml:lang="en-US"><tig><term>Port number should be within 1000 and 65534.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏗ ᎠᏎᏍᏗ ᎠᏎᏗᏃ ᎨᏒ ᎠᏫᏂᏗᏢ 1000 ᎠᎴ 65534.</term></tig></langSet>
            </termEntry>
            <termEntry id="System updates continued">
                <langSet xml:lang="en-US"><tig><term>System updates continued</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎤᎵᏱᎸᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show notification text informing which system the wireless device is using">
                <langSet xml:lang="en-US"><tig><term>Show notification text informing which system the wireless device is using</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎠᏓᏃᏣᎳᏁᎯ ᎠᎪᎵᏰᏗ ᎠᏥᏃᎯᏎᎲ ᎦᏙᎤᏍᏗ ᏄᏍᏗᏓᏅᎢ ᏥᎩ ᏂᏓᏏᎳᏛ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎬᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="System update history">
                <langSet xml:lang="en-US"><tig><term>System update history</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᏂᏧᎵᏍᏔᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show system update history">
                <langSet xml:lang="en-US"><tig><term>Show system update history</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᏂᏧᎵᏍᏔᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id=" is on.">
                <langSet xml:lang="en-US"><tig><term> is on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎨᎡᎢ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn on Audio effects,  turns off">
                <langSet xml:lang="en-US"><tig><term>When you turn on Audio effects,  turns off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ ᎤᏃᏴᎬ ᏄᎵᏍᏔᏅ,  ᎠᎦᏔᎲᎠ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="System Update Status">
                <langSet xml:lang="en-US"><tig><term>System Update Status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᏄᏛᎿᏕᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Apt, Suite, etc.">
                <langSet xml:lang="en-US"><tig><term>Apt, Suite, etc.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎧᏄᏑᎸ, ᎤᎵᎶᏒᎢ, etc.</term></tig></langSet>
            </termEntry>
            <termEntry id="Checking status...">
                <langSet xml:lang="en-US"><tig><term>Checking status...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᎠ ᏄᏛᎿᏕᎬᎢ…</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Calling turned on.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi Calling turned on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᎠᏍᏚᎢᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Invalid code.">
                <langSet xml:lang="en-US"><tig><term>Invalid code.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏓᏓᏂᎸᎬᎾ ᎦᎵᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When roaming">
                <langSet xml:lang="en-US"><tig><term>When roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎡᏙᎵᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Still trying\u2026">
                <langSet xml:lang="en-US"><tig><term>Still trying\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏉ ᎠᏁᏟᏗᎭ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi Calling lets you make calls using Wi-Fi when the mobile network is unavailable.">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi Calling lets you make calls using Wi-Fi when the mobile network is unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᏗᎵᏍᎪᎸᏔᏅ ᏂᎯ ᎪᏢᏗ ᏓᏯᏂ ᎬᏗᎭ Wi-Fi ᎢᏳᏃ ᏥᎩ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎨᎡᎢ Ꮭ ᎬᏙᏗ ᏱᎩ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To turn it on, confirm or change the U.S. address where you want emergency responders sent if you call 911, and accept the Terms and Conditions below.">
                <langSet xml:lang="en-US"><tig><term>To turn it on, confirm or change the U.S. address where you want emergency responders sent if you call 911, and accept the Terms and Conditions below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎨᎡᎢ ᎤᎿᎢ, ᏦᎯᏳᏙᏗ ᎠᎴ ᎯᏁᏟᏴᎾ ᏥᎩ U.S. ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎭᏢᏃ ᏂᎯ ᎤᏚᎵᎭ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎦᏬᎯᎵᏴᏍᏗ ᏭᏅᏅᎢ ᎾᎿ ᏂᎯ ᏪᏯᎾ 911, ᎠᎴ ᏗᏓᏂᎸᎢᏍᏗ ᏥᎩ ᏗᏓᏁᏤᎸ ᎠᎴ ᏂᏚᏍᏗᏓᏅᎢ ᎡᎳᏗᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It is very important that you update your 911 address (which can be done at any time through your device settings) whenever you change your location, since this is the location that will be given to emergency services when you dial 911.">
                <langSet xml:lang="en-US"><tig><term>It is very important that you update your 911 address (which can be done at any time through your device settings) whenever you change your location, since this is the location that will be given to emergency services when you dial 911.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎰᎡᎢ ᎤᏣᏘ ᎤᎵᏍᎨᏓ ᎥᏍᎩᎾ ᏂᎯ ᏗᎪᏢᎯᏐᏗ ᏂᏨᎤᎢ 911 ᎪᏪᎵ ᏧᏁᏍᏗᎢ (ᎢᏳᏍᏗ ᏰᎵᏯ ᎨᎡᎢ ᎠᏍᏆᏗᏍᏗ ᎤᎿᎢ ᎢᎸᎯᏳ ᏭᎵᏍᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏕᎦᎧᎲᎢ) ᎢᏳᏃ ᏂᎯ ᎯᏁᏟᏴᎾ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ, ᏥᎨᏒ ᎯᎠ ᎨᎡᎢ ᏥᎩ ᎤᏙᏢᏒᎢ ᎥᏍᎩᎾ ᎠᏎ ᎨᎡᎢ ᎡᏥᏁᎸᎯ ᎾᎿᎢ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎢᏳᏃ ᏂᎯ ᏗᏎᏍᏗ ᏗᏐᎥᏍᏗᏍᎩ 911.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use SIP calling">
                <langSet xml:lang="en-US"><tig><term>Use SIP calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ SIP ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose the connection you prefer when outside the  network (Wi-Fi or Cellular)">
                <langSet xml:lang="en-US"><tig><term>Choose the connection you prefer when outside the  network (Wi-Fi or Cellular)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏥᎩ ᎫᏓᎸᎢ ᏂᎯ ᎤᏟ ᎠᏰᎸᏗ ᎢᏳᏃ ᏙᏱ ᏥᎩ  ᏧᎾᏚᏓᎵ (Wi-Fi ᎠᎴ ᏫᏚᏍᏗᎬᎢ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Field cannot be left blank.">
                <langSet xml:lang="en-US"><tig><term>Field cannot be left blank.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎧᎵᏏᏐᏙᏗᎢ ᏝᏃ ᎧᏃᎯᏯᏍᏗ ᏱᎩ ᎪᏪᎶᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap here to confirm or update emergency location information for Wi-Fi Calling.">
                <langSet xml:lang="en-US"><tig><term>Tap here to confirm or update emergency location information for Wi-Fi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎭᏂ ᎾᎿᎢ ᏦᎯᏳᏙᏗ ᎠᎴ ᏗᎪᏢᎯᏐᏗ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎤᏙᏢᏒᎢ ᎧᏃᎮᏢᏗ ᎤᎬᏩᏟ Wi-Fi ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This will allow you to make and receive voice calls when the cellular network isn't available.">
                <langSet xml:lang="en-US"><tig><term>This will allow you to make and receive voice calls when the cellular network isn't available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎠᎵᏍᎪᎸᏗᏍᎬ ᏂᎯ ᎾᎿᎢ ᎪᏢᏗ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ ᎢᏳᏃ ᏥᎩ ᏫᏚᏍᏗᎬᎢ ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your call will not be able to be completed.">
                <langSet xml:lang="en-US"><tig><term>Your call will not be able to be completed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏪᏯᎾ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎨᎡᎢ ᎠᏍᏆᏙᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In the future if you would like to use Wi-Fi for Voice calling you can go to Call Settings menu to turn it on.">
                <langSet xml:lang="en-US"><tig><term>In the future if you would like to use Wi-Fi for Voice calling you can go to Call Settings menu to turn it on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏥᎩ ᎤᏩᎫᏗᏗᏒ ᎾᎿ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ Wi-Fi ᎤᎬᏩᏟ ᎤᏁᎬ ᏓᏯᏂᏍᎬ ᏂᎯ ᏰᎵᏯ Ꭷ ᏪᏯᎾ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎨᎡᎢ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off Wi-Fi Calling">
                <langSet xml:lang="en-US"><tig><term>Turn off Wi-Fi Calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ Wi-Fi ᏓᏯᏂᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Did you mean:">
                <langSet xml:lang="en-US"><tig><term>Did you mean:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏛᏁᎸ ᏂᎯ ᎤᏍᎦᏎᏘ</term></tig></langSet>
            </termEntry>
            <termEntry id="To change this setting go to Call Settings.">
                <langSet xml:lang="en-US"><tig><term>To change this setting go to Call Settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎯᏁᏟᏴᎾ ᎯᎠ ᏕᎦᎧᎲᎢ Ꭷ ᏪᏯᎾ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to activate Wi-Fi calling at this time.">
                <langSet xml:lang="en-US"><tig><term>Unable to activate Wi-Fi calling at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎤᏂᎩᏍᏗᏍᎩ Wi-Fi ᏓᏯᏂᏍᎬ ᎤᎿᎢ ᎯᎠ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please check your internet settings.">
                <langSet xml:lang="en-US"><tig><term>Please check your internet settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᎠᏏᎳᏕᏫᏒᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Confirm or update current emergency address">
                <langSet xml:lang="en-US"><tig><term>Confirm or update current emergency address</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎯᏳᏙᏗ ᎠᎴ ᏗᎪᏢᎯᏌᏅᎯ ᏃᏊ ᏥᎩ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎪᏪᎵ ᏧᏁᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This address will be used by emergency services as your location if you make an emergency (E911) call over Wi-Fi from this phone within the US.">
                <langSet xml:lang="en-US"><tig><term>This address will be used by emergency services as your location if you make an emergency (E911) call over Wi-Fi from this phone within the US.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎠᏎ ᎨᎡᎢ ᎬᏔᏅᎢ ᎬᏗ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ ᎾᎿ ᏂᎯ ᎪᏢᏗ Ꭰ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ (E911) ᏪᏯᎾ ᎢᏴᏛ Wi-Fi ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᏗᏟᏃᎮᏗ ᎠᏫᏂᏗᏢ ᏥᎩ US.</term></tig></langSet>
            </termEntry>
            <termEntry id="Display name">
                <langSet xml:lang="en-US"><tig><term>Display name</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏔᏍᎩ ᏚᏙᎥᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Agree to Terms, Conditions and Limitations">
                <langSet xml:lang="en-US"><tig><term>Agree to Terms, Conditions and Limitations</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏏ ᎠᏰᎸᏍᏗ ᎾᎿᎢ ᏗᏓᏁᏤᎸ, ᏂᏚᏍᏗᏓᏅ, ᎠᎴ ᏗᎦᎶᏐᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency address updated">
                <langSet xml:lang="en-US"><tig><term>Emergency address updated</term></tig></langSet>
