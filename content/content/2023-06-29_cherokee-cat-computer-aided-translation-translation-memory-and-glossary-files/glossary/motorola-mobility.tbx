                <langSet xml:lang="chr"><tig><term>ᎡᏍᎦᏂ ᏗᎦᏃᏣᎵᏗ ᎠᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your video call is using data.">
                <langSet xml:lang="en-US"><tig><term>Your video call is using data.</term></tig></langSet>
