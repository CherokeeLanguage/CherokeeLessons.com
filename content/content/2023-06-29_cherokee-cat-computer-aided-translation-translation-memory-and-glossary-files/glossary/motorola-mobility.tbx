            </termEntry>
            <termEntry id="Must contain at least 1 non-numerical character">
                <langSet xml:lang="en-US"><tig><term>Must contain at least 1 non-numerical character</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎦᎸᏛᎢ ᎦᏲᎵᎨ 1 ᎬᏂᎬᎬ-ᏗᏎᏍᏙᏗ ᎪᏪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="However your data usage is currently limited due to time of day or a data limit.">
                <langSet xml:lang="en-US"><tig><term>However your data usage is currently limited due to time of day or a data limit.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏎᏃ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎨᎡᎢ ᏃᏊ ᏥᎩ ᏩᏎᏢᏊ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ ᎠᏥᎢᎵᏒ ᎾᎿ ᎢᎦ ᏃᎴ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone number is:">
                <langSet xml:lang="en-US"><tig><term>Your phone number is:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎᏍᏗ ᎨᎡᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Must contain at least 1 numerical digit">
                <langSet xml:lang="en-US"><tig><term>Must contain at least 1 numerical digit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎦᎸᏛᎢ ᎦᏲᎵᎨ 1 ᏗᏎᏍᏙᏗ ᎠᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Languages, gestures, time, backup">
                <langSet xml:lang="en-US"><tig><term>Languages, gestures, time, backup</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᏬᏂᎯᏍᏗ, ᏚᏂᏬᏯᏂᏍᎩ, ᎠᏥᎢᎵᏒ, ᎠᏍᏆᏂᎪᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Verizon Wireless phone is now active.">
                <langSet xml:lang="en-US"><tig><term>Your Verizon Wireless phone is now active.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ Verizon Wireless ᏗᏟᏃᎮᏗ ᎨᎡᎢ Ꭷ ᎬᏂᎦᎵᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can also create custom profiles for each audio device.">
                <langSet xml:lang="en-US"><tig><term>You can also create custom profiles for each audio device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᎪᏢᏗ ᏄᏍᏛ ᏱᏗᎬᏁᎸᎯ ᏧᎾᏓᏟᎶᏍᏔᏅᎯ ᎾᏍᎩᎾ ᏌᏊᎭ ᎤᏃᏴᎬ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Must contain at least 1 uppercase letter">
                <langSet xml:lang="en-US"><tig><term>Must contain at least 1 uppercase letter</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎦᎸᏛᎢ ᎦᏲᎵᎨ 1 ᎦᎸᎳᏗ ᎦᏇᏅᎯ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Must contain at least one symbol">
                <langSet xml:lang="en-US"><tig><term>Must contain at least one symbol</term></tig></langSet>
