                <langSet xml:lang="en-US"><tig><term>Moto Camera Content</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏓᏟᎶᏍᏙᏗ ᎦᎸᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart Reply">
                <langSet xml:lang="en-US"><tig><term>Smart Reply</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ ᎦᏬᎯᎵᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Request a read report for each MMS you send">
                <langSet xml:lang="en-US"><tig><term>Request a read report for each MMS you send</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏲᏍᏗ Ꭰ ᎠᎪᎵᏰᏗ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᎬᏩᏟ ᏧᏤᎵᏛ MMS ᏂᎯ ᏫᏅᎥᎦ</term></tig></langSet>
            </termEntry>
