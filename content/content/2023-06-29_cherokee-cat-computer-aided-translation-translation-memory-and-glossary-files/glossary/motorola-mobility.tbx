            </termEntry>
            <termEntry id="Automatic SIM selection needs permission to access some things in your device.">
                <langSet xml:lang="en-US"><tig><term>Automatic SIM selection needs permission to access some things in your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎲ SIM ᏗᏑᏰᏓ ᎤᏚᎸᏗ ᏄᏍᏛ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎬᏴᏍᏗ ᎢᎦᏓ ᏧᏓᎴᏅᏓ ᎾᎿᎢ ᏂᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For added security, set a password to unlock the device">
                <langSet xml:lang="en-US"><tig><term>For added security, set a password to unlock the device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎧᏁᏉᏓ ᎤᎦᏎᏍᏗ, ᎦᎧᎲᎢ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="To turn on Wi\u2011Fi automatically, you first need to turn on Wi\u2011Fi scanning.">
                <langSet xml:lang="en-US"><tig><term>To turn on Wi\u2011Fi automatically, you first need to turn on Wi\u2011Fi scanning.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎤᎵᏍᏚᎢᏍᏗ ᏱᏣᏚᎵ Wi\u2011Fi, ᎠᎬᏱ ᏍᏚᎢᏍᏗ Wi\u2011Fi ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device will no longer be paired with ">
                <langSet xml:lang="en-US"><tig><term>Your device will no longer be paired with </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᏎ Ꮭ ᎦᏅᎯᏓᎨ ᎨᏒᎩ ᏗᎵᎪᏙᏗ ᎬᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Your tablet will no longer be paired with ">
