                <langSet xml:lang="chr"><tig><term>Moto ᎤᏔᎾ ᏧᏂᎸᏫᏍᏓᏁᏗ WiFi ᎤᎦᏎᏍᏗ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When using Face Unlock">
