                <langSet xml:lang="chr"><tig><term>ᏗᏆᏂᏲᏍᏗ &amp; ᎠᏂᎶᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn on , the main lens will be used">
                <langSet xml:lang="en-US"><tig><term>When you turn on , the main lens will be used</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᎯᏍᏚᎢᏒᎢ , ᎾᏍᎩ ᏅᎬᏫᏳᎡ ᏗᏓᎨᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏙᏓ </term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure you swipe from the right or left edge to the middle of the screen and let go.">
                <langSet xml:lang="en-US"><tig><term>Make sure you swipe from the right or left edge to the middle of the screen and let go.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎬᏛ ᎨᏎᏍᏗ ᏂᎯ ᎦᎶᎯᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎠᎦᏘᏏ ᎠᎴ ᎠᏍᎦᏂ ᎠᏍᏛᎢ ᎾᎿᎢ ᏥᎩ ᎠᏰᎵ ᎾᎿᎢ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᏩᏂᎩ ᎡᏅᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please give your authentication">
