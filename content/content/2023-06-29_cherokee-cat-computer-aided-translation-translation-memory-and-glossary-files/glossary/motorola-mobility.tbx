                <langSet xml:lang="chr"><tig><term>ᎨᎪᎯᏳᎯ ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.">
                <langSet xml:lang="en-US"><tig><term>Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎾᏍᎩ ᎾᎢ ᏗᏟᎶᏍᏔᏅ ᎦᏟᏌᏅᎯ ᎠᏰᏟ ᏣᏤᎵ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎠᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏘᏅᏛᎦ ᏗᎬᏙᏗ ᎤᎾᎢ ᏣᏤᏨ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᎠᎪᎵᏰᏗ ᎸᏛᏁᎸ ᎧᏃᎮᏍᎩ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable view attribute inspection">
                <langSet xml:lang="en-US"><tig><term>Enable view attribute inspection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᎠᎪᎵᏰᏗ ᏄᏍᏛ ᎠᎦᏅᏛᎢ ᎠᎪᎵᏰᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="To make video calls, turn off Airplane mode, then turn on Mobile data, then turn on Video Call.">
                <langSet xml:lang="en-US"><tig><term>To make video calls, turn off Airplane mode, then turn on Mobile data, then turn on Video Call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎣ ᎹkᎡ ᎥᎢᏕᎣ cᎠllᏍ, tᎤrn Ꭳff ᎠᎢrpᎳᏁ ᎼᏕ.</term></tig></langSet>
            </termEntry>
            <termEntry id="These settings are intended for development use only.">
                <langSet xml:lang="en-US"><tig><term>These settings are intended for development use only.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠᏃ ᏕᎦᎧᎲᎢ ᎨᏒᎢ ᏄᏪᎵᏒ ᎾᏍᎩᎾ ᎤᏙᎷᏩᏛᏗ ᎬᏙᏓ ᎤᏩᏌ.</term></tig></langSet>
            </termEntry>
            <termEntry id="They can cause your device and the applications on it to break or misbehave.">
                <langSet xml:lang="en-US"><tig><term>They can cause your device and the applications on it to break or misbehave.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᏰᎵᏉ ᏂᎬᏂᏏᏍᎬ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴ ᎾᏍᎩ ᏗᏔᏲᏍᏙᏗ ᎤᎾᎢ ᎾᎢ ᎠᏲᏍᏙᏗ ᎠᎴᏃ ᎤᏲ ᎾᏛᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Verify apps over USB">
                <langSet xml:lang="en-US"><tig><term>Verify apps over USB</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎯᏳᏙᏗ ᏗᎬᏙᏗ ᎦᏬᎯᎸᏓ USB</term></tig></langSet>
            </termEntry>
            <termEntry id="Check apps installed via ADB/ADT for harmful behavior.">
                <langSet xml:lang="en-US"><tig><term>Check apps installed via ADB/ADT for harmful behavior.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎦᏛᎲᎦ ᏗᎬᏙᏗ ᎦᏘᏅᏔᏅ ᎾᎿ ᎢᏗᏢ ADB/ADT ᎾᏍᎩᎾ ᎤᏐᏅ ᏯᏓᏛᏁᎯ ᎾᏛᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Debugging application: ">
                <langSet xml:lang="en-US"><tig><term>Debugging application: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎬ ᎠᏔᏲᏍᏙᏗ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Web socket setup is busy">
                <langSet xml:lang="en-US"><tig><term>Web socket setup is busy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᎳᏛᎢ ᎠᎵᏲ ᎦᎧᎲᏍᎬᎢ ᎨᎡᎢ ᏕᏣᎸᏫᏍᏓᏁ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use tethering hardware acceleration if available">
                <langSet xml:lang="en-US"><tig><term>Use tethering hardware acceleration if available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎫᏓᎸᏓ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᎠᏯᏄᎳᏗᏍᏙᏗ ᎢᏳᏃ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless debugging is intended for development purposes only.">
                <langSet xml:lang="en-US"><tig><term>Wireless debugging is intended for development purposes only.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏏᎳᏛᎾ ᎪᎷᏩᏘᏍᎬ ᎾᏍᎩ ᏄᏪᎵᏒ ᎾᏍᎩᎾ ᎤᏙᎷᏩᏛᏗ ᏂᏚᏰᎵᏛᎢ ᎤᏩᏌ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enables the Bluetooth Gabeldorsche feature stack.">
                <langSet xml:lang="en-US"><tig><term>Enables the Bluetooth Gabeldorsche feature stack.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᏗᎬᏛᏁᏗ ᎾᏍᎩ Bluetooth Gabeldorsche ᎠᎦᏎᏍᏙᏗ ᎦᏒᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enables the Enhanced Connectivity feature.">
                <langSet xml:lang="en-US"><tig><term>Enables the Enhanced Connectivity feature.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏩᎾᏛᏁᏗ ᎾᏍᎩ ᏓᏤᏢᎢ ᏕᎫᏓᎸᏛᎢ ᎦᏒᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Enable terminal app that offers local shell access">
                <langSet xml:lang="en-US"><tig><term>Enable terminal app that offers local shell access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᏧᏂᎦᏘᏗᏍᏗᎢ ᎬᏙᏗ ᎾᏍᎩᎾᎢ ᏓᏂᏍᎪᎸᏗᏍᎬ ᎾᎥᎢ ᎤᏯᏍᎦ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set HDCP checking behavior">
                <langSet xml:lang="en-US"><tig><term>Set HDCP checking behavior</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ HDCP ᎤᎦᏛᎲᏍᎬ ᎾᏛᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow wireless debugging?">
                <langSet xml:lang="en-US"><tig><term>Allow wireless debugging?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏏᎳᏛᎾ ᎪᎷᏩᏘᏍᎬ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.">
                <langSet xml:lang="en-US"><tig><term>Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎾᏍᎩ ᎾᎢ ᏗᏟᎶᏍᏔᏅ ᎦᏟᏌᏅᎯ ᎠᏰᏟ ᏣᏤᎵ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎠᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏘᏅᏛᎦ ᏗᎬᏙᏗ ᎤᎾᎢ ᏣᏤᏨ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏃᏣᎳᏁᎯ, ᎠᎴ ᎠᎪᎵᏰᏗ ᎸᏛᏁᎸ ᎧᏃᎮᏍᎩ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Printing">
                <langSet xml:lang="en-US"><tig><term>Printing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᎴᏴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Bluetooth devices without names (MAC addresses only) will be displayed">
                <langSet xml:lang="en-US"><tig><term>Bluetooth devices without names (MAC addresses only) will be displayed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᏚᎾᏙᎥ (MAC ᏗᎪᏪᎵ ᏧᏂᏁᏍᏗᎢ ᎤᏩᏌ) ᏰᎵᏉ ᎨᏎᏍᏗ ᎬᏂᎨᏒ ᏁᎬᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hardware accelerated rendering">
                <langSet xml:lang="en-US"><tig><term>Hardware accelerated rendering</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᎦᏣᏄᎳᏗᏍᏔᏅᎢ ᎢᏳᏍᏗ ᏓᏅᎪᏗᏍᎬᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Flash screen when apps do long operations on main thread">
                <langSet xml:lang="en-US"><tig><term>Flash screen when apps do long operations on main thread</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎯᏳ ᏗᎬᏙᏗ ᎦᏅᎯᏓ ᏓᏂᏱᎵᏒᎢ ᎾᎿᎢ ᏄᎬᏫᏳᏒ ᎠᏍᏗ ᎪᏢᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connection failed.">
                <langSet xml:lang="en-US"><tig><term>Connection failed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎤᏓᏄᎸᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Disables the Bluetooth absolute volume feature in case of volume issues with remote devices such as unacceptably loud volume or lack of control.">
                <langSet xml:lang="en-US"><tig><term>Disables the Bluetooth absolute volume feature in case of volume issues with remote devices such as unacceptably loud volume or lack of control.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᏂᎨᏒᎾ ᎾᏍᎩ Bluetooth ᎤᏙᎯᏳᎯᏯ ᎢᎦᎢ ᎤᏃᏴᎬ ᎠᎦᏎᏍᏙᏗ ᎢᏳᏃ ᎢᎸᎯᏳ ᎾᏍᎩ ᎢᎦᎢ ᎤᏃᏴᎬ ᏓᏓᎴᎬᎢ ᎬᏗ ᎢᎾ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᏂᏓᏓᏂᎸᎬᎾᏊ ᎠᏍᏓᏯ ᎢᎦᎢ ᎤᏃᏴᎬ ᎠᎴᏃ ᎦᎷᎶᎩ ᎾᏍᎩ ᎠᎯᎸᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Local terminal">
                <langSet xml:lang="en-US"><tig><term>Local terminal</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥᎢ ᏧᏂᎦᏘᏗᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="HDCP checking">
                <langSet xml:lang="en-US"><tig><term>HDCP checking</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>HDCP ᎤᎦᏛᎲᏍᎬ</term></tig></langSet>
            </termEntry>
