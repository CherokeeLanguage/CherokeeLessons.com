            </termEntry>
            <termEntry id="TEXT SCANNER">
                <langSet xml:lang="en-US"><tig><term>TEXT SCANNER</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎳᏅᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏙᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Close modes menu">
