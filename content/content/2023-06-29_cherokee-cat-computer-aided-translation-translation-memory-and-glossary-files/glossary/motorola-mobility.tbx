                <langSet xml:lang="chr"><tig><term>ᎢᎬᏩᏍᏗᎭ ᎦᏟᏌᏅᎯ ᏓᏟᎶᎲᎢ ᏰᎵᏉ ᏱᏂᎦᎵᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="motor, mouse">
                <langSet xml:lang="en-US"><tig><term>motor, mouse</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏗᏍᎩ, ᏥᏍᏕᏥ</term></tig></langSet>
            </termEntry>
            <termEntry id="Higher battery usage">
                <langSet xml:lang="en-US"><tig><term>Higher battery usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="To record stylus removals, this app collects location data even when the app is closed or not in use, so it requires permission to access your location all the time.">
                <langSet xml:lang="en-US"><tig><term>To record stylus removals, this app collects location data even when the app is closed or not in use, so it requires permission to access your location all the time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎪᏪᎳᏅ ᏗᎲᏏᏓᏍᏗ ᏗᎪᏪᎳᏅ, ᎯᎠ ᎬᏙᏗ ᏗᎦᏟᏌᏅᎩ ᎤᏙᏢᏒᎢ ᎦᏟᏌᏅᎯ ᎥᏍᏊ ᎾᎯᏳᎢ ᎬᏙᏗ ᎨᏒᎢ ᎠᏍᏚᏅᎩ ᎠᎴᏃ Ꮭ ᎾᎿᎢ ᎬᏙᏓ ᏱᎩ, ᎾᏃ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏎ ᎢᏳᎵᏍᏙᏗ ᎾᎢ ᎠᏴᏍᏗ ᏣᏤᎵ ᎤᏙᏢᏒᎢ ᏂᎦᏓ ᎾᏍᎩ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sync error">
                <langSet xml:lang="en-US"><tig><term>Sync error</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏄᎵᏍᏔᏅᎢ ᏓᏓᎴᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="A certificate is missing. Try editing the profile.">
                <langSet xml:lang="en-US"><tig><term>A certificate is missing. Try editing the profile.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏄᏍᏛ ᎤᎪᎳ. ᎭᏁᎵᏓ ᎦᏁᏟᏴᎢ ᏥᎩ ᏄᏍᏗᏓᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Activate Profile Manager?">
                <langSet xml:lang="en-US"><tig><term>Activate Profile Manager?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᎲᏍᎩ ᏄᏍᏗᏓᏅᎢ ᎠᏓᏅᏖᎵᏙᎯ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Get help on your device any time.">
                <langSet xml:lang="en-US"><tig><term>Get help on your device any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᎠᏓᏍᏕᎵᏍᎩ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎢᏴᏊ  ᎨᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please change your Location setting to High Accuracy.">
                <langSet xml:lang="en-US"><tig><term>Please change your Location setting to High Accuracy.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎯᏁᏟᏴᎾ ᏣᏤᎵ ᎤᏙᏢᏒᎢ ᏕᎦᎧᎲᎢ ᎾᎢ ᎦᎸᎳᏗ ᏚᏳᎪᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Any changes you make to your accounts on the web will be automatically copied to your phone.Some accounts may also automatically copy any changes you make on the phone to the web. A Google Account works this way.">
                <langSet xml:lang="en-US"><tig><term>Any changes you make to your accounts on the web will be automatically copied to your phone.Some accounts may also automatically copy any changes you make on the phone to the web. A Google Account works this way.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏂᎥᏉ ᏗᎦᏁᏟᏴᏓ ᏂᎯ ᎪᏢᏗ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᏚᏓᎸᏙᏗ ᎤᎾᎢ ᏥᎩ ᎤᏂᎳᏛᎢ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏓᏟᎶᏍᏔᏅᎯ ᎾᎿᎢ ᏂᏨᏅᎢ ᏗᏟᏃᎮᏗ.ᎢᎦᏓ ᏗᏚᏓᎸᏙᏗ ᏰᎵᏉ ᎾᏍᏊ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏗᏟᎶᏍᏔᏅᎯ ᎾᏂᎥᏉ ᏗᎦᏁᏟᏴᏓ ᏂᎯ ᎪᏢᏗ ᎤᎾᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᎾᎿᎢ ᏥᎩ ᎤᏂᎳᏛᎢ. Ꭰ Google ᎠᏚᏓᎸᏗ ᏚᎸᏫᏍᏓᏁᎲ ᎯᎠ ᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Restrict  apps">
                <langSet xml:lang="en-US"><tig><term>Restrict  apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏍᏚᏁᏗ  ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
