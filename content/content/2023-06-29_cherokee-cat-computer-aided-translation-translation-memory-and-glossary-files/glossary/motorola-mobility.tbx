            </termEntry>
            <termEntry id="Increase battery lifespan &amp; efficiency">
                <langSet xml:lang="en-US"><tig><term>Increase battery lifespan &amp; efficiency</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᏉᏨᎢ ᎠᎾᎦᎵᏍᎩ ᎠᎴᏂᏙᎲᎢ ᏫᎬᏍᏗ &amp; ᏓᏤᏢ ᎢᏳᎵᏍᏙᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Get some peace &amp; quiet">
