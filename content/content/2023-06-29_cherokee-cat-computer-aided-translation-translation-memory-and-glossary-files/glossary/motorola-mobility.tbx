                <langSet xml:lang="chr"><tig><term>PC  ᏄᏍᏛ ᎫᏓᎸᏍᎬᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ ᎠᏓᏛᏛᎲᏍᎩ ᎾᏍᎩᎾ ᎤᏱᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open flip to interact">
                <langSet xml:lang="en-US"><tig><term>Open flip to interact</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏗᏁᏍᏆᏕᎦ ᎾᎢ ᎤᏪᎳᏗᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="See notifications and quick information when a folio case is attached">
                <langSet xml:lang="en-US"><tig><term>See notifications and quick information when a folio case is attached</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏗ ᏗᏓᏃᏣᎳᏁᎯ ᎠᎴ ᎤᏟᏍᏓ ᎧᏃᎮᏢᎥᏍᎩ ᎾᎯᏳ ᎾᏍᎩ ᏉᎵᎣ ᏂᎦᎵᏍᏗᏍᎬᎢ ᏄᏍᏛ ᎠᏠᏯᏍᏕᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="See what you can do!">
