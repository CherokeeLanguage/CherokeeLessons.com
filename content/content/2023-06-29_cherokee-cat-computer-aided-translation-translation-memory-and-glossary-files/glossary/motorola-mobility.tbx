                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your phone as a webcam">
                <langSet xml:lang="en-US"><tig><term>Use your phone as a webcam</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏓ ᏗᏝᏃᎮᏗ ᎠᏏᎳᏕᏫᏒ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cellular data counters">
                <langSet xml:lang="en-US"><tig><term>Cellular data counters</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏚᏍᏗᎬᎢ ᎦᏘᏍᎩᏌᏅᎯ ᏗᏎᎯᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="When Edge display is on, apps will display on the curved edges for a more immersive experience. Some apps may not display properly.">
                <langSet xml:lang="en-US"><tig><term>When Edge display is on, apps will display on the curved edges for a more immersive experience. Some apps may not display properly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎠᏍᏛᎢ ᎬᏂᎨᏒ ᏱᎬᏁᎯ ᏯᎢ, ᏗᎬᏙᏗ ᎠᏎ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎾᎢ ᎤᏕᏲᎸᎢ ᏓᏍᏛᏔ ᎤᎪᏕᏍᏗᏃ ᎦᏃᏴᏘᏍᏙᏗ ᎠᎦᏙᎲᏒ ᎢᎦᏓ ᏗᎬᏙᏗ ᎭᏗ ᏰᎵᏉ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏗᏙᎳᏤᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="With Open security, devices will be able to use your Mobile Hotspot without entering a password.Select WPA2 security instead if you want to require a password.">
                <langSet xml:lang="en-US"><tig><term>With Open security, devices will be able to use your Mobile Hotspot without entering a password.Select WPA2 security instead if you want to require a password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏚᎢᏓ ᏱᎩ ᎤᎦᏎᏍᏗ, ᏥᏂᏕᎬᏅᏂ ᎠᎢ ᏱᎩᏓ ᎠᏂᎩᏍᎩ ᎤᏗᏞᎩᎫᏛᎸᎢ ᏂᏦᏪᎳᏅᎾ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ.ᎯᏑᏰᎩ WPA2 ᎤᎦᏎᏍᏗ ᏱᏣᏚᎵ ᏱᏨᏁᏗ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="International Data Roaming">
                <langSet xml:lang="en-US"><tig><term>International Data Roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your HotSpot is not visible now">
                <langSet xml:lang="en-US"><tig><term>Your HotSpot is not visible now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏴᎯᎪᏩᏔ ᏃᏥᎩ ᎤᏗᏞᎩᎫᏛᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The Moto feedback assistant has been updated">
                <langSet xml:lang="en-US"><tig><term>The Moto feedback assistant has been updated</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ Moto ᎦᏬᎯᎵᏴᏓ ᎤᏂᏍᏕᎸᎯᏙᎯ ᎾᏍᎩ ᎪᏢᎯᏌᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="After unlocking, go to the Home screen or last used app">
                <langSet xml:lang="en-US"><tig><term>After unlocking, go to the Home screen or last used app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂᏗᏢ ᎤᏂᏐᎭᎾᎸᏗ, ᏤᏅᏍᏗ ᎣᏪᏅᏒ ᎠᏓᎾᏫᏓ ᏍᏓᏯ ᎠᏍᏚᎭ ᎠᏴᏙᎳᏛᎢ ᏃᎴ ᎣᏂ ᎬᏔᏅᎯ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="PIN must be at least  digits">
                <langSet xml:lang="en-US"><tig><term>PIN must be at least  digits</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PIN ᎠᏎᎢ ᎦᏲᎵᎨ  ᏗᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="on , via ">
                <langSet xml:lang="en-US"><tig><term>on , via </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿᎢ , ᎾᎿ ᎢᏗᏨ </term></tig></langSet>
            </termEntry>
            <termEntry id="You will be charged on a per MB basis for all data sent or received while using this service outside the Verizon Network. Please check our website for current international rates. To minimize charges, visit My Verizon periodically to monitor your usage, check your device settings to confirm which devices are connected, and consider using alternate data connections when available.">
                <langSet xml:lang="en-US"><tig><term>You will be charged on a per MB basis for all data sent or received while using this service outside the Verizon Network. Please check our website for current international rates. To minimize charges, visit My Verizon periodically to monitor your usage, check your device settings to confirm which devices are connected, and consider using alternate data connections when available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏎᏍᏗ ᏗᎬᏩᎶᏔᏅ ᎤᎾᎢ ᎢᏳᏓᎵ MB ᏚᎳᏏᏛᎢ ᎤᎬᏩᏟ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ ᏫᎦᏅᏅᎢ ᏃᎴ ᏕᎬᏩᎷᏤᎸᎢ ᎾᎯᏳᎢ ᎬᏗᎭ ᎦᎯᎠ ᎢᏯᏓᏛᏁᏗ ᏙᏯᏗᏨ ᏥᎩ Verizon Network. ᎰᏩᏊ ᎪᏪᎶᏗ ᎣᎦᏤᎵ ᎠᏏᎳᏕᏫᏒᎢ ᎤᎬᏩᏟ ᏃᏊ ᏥᎩ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᏗᎪᏣᎴᏒᏛ. ᎾᎿᎢ ᎠᏍᏗᎪᎲᏍᏗᏍᎩ ᏓᎬᏩᎶᏛ, ᎠᏩᏛᎯᏓᏍᏗ My Verizon ᎢᏳᏓᎵᏊ ᎾᎿᎢ ᎠᏓᏴᎵᏛᏍᎩ ᏂᏨᎤᎢ ᎬᏗᏍᎬ, ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᏦᎯᏳᏙᏗ ᎾᏍᎩᏃ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎨᏒᎢ ᎫᏓᎸᏅᎯ, ᏃᎴ ᎭᏓᏅᏛᎵ ᎬᏗᎭ ᎠᏓᏁᏟᏴᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ ᎢᏳᏃ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A PIN is required to set up Face Unlock and Fingerprint Unlock.A PIN protects the phone if it\u2019s lost or stolen.">
                <langSet xml:lang="en-US"><tig><term>A PIN is required to set up Face Unlock and Fingerprint Unlock.A PIN protects the phone if it\u2019s lost or stolen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PIN ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎠᏂᏐᎭᎾᎳᎩ ᎠᎴ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏂᏐᎭᎾᎳᎩ. PIN ᎠᏓᎦᏎᏍᏙᏗ ᏥᎩ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᎠᎴ ᎦᏃᏍᎩᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="If your device has mobile data, you can set it up to share its Internet connection with other devices through Bluetooth. 1. Pair your phone or tablet with the device that you want to have share your Internet connection.2. Set up the other device to get its network connection by Bluetooth. You may need to see the instructions that came with that device.">
                <langSet xml:lang="en-US"><tig><term>If your device has mobile data, you can set it up to share its Internet connection with other devices through Bluetooth. 1. Pair your phone or tablet with the device that you want to have share your Internet connection.2. Set up the other device to get its network connection by Bluetooth. You may need to see the instructions that came with that device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ, ᏂᎯ ᏰᎵᏊ ᎦᎧᎲᎢ ᎾᏍᎩ ᎦᎸᎳᏗ ᎾᎿᎢ ᎠᏯᏙᏍᏗᎢ ᎾᏍᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎬᏗ ᎬᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎦᏛᎴᏍᎩ Bluetooth. 1. ᏗᎵᎪᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏃᎴ ᏗᎪᏪᎶᏗᎢ ᎬᏗ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎥᏍᎩᎾ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎤᎭ ᎦᎧᎲᎢ ᏂᏨᎤᎢ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ.2. ᎦᎧᎲᎢ ᎦᎸᎳᏗ ᏥᎩ ᎬᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎠᎩᏍᏗ ᎾᏍᎩ ᏧᎾᏚᏓᎵ ᎫᏓᎸᎢ ᎬᏗ Bluetooth. ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏥᎩ ᏗᎾᏓᏕᏲᎲᏍᎦ ᎥᏍᎩᎾ ᎤᎷᏨᎩ ᎬᏗ ᎥᏍᎩᎾ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Blocking temporarily off">
                <langSet xml:lang="en-US"><tig><term>Blocking temporarily off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏍᏗ ᏪᏯᎾ ᎠᏍᏚᎭ ᏎᎦᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Never turn-off">
                <langSet xml:lang="en-US"><tig><term>Never turn-off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎢᎸᎯᏳᎢ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enhance color saturation for a vivid display">
                <langSet xml:lang="en-US"><tig><term>Enhance color saturation for a vivid display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᎴᏍᏗ ᎠᏑᏫᏓ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎧᎵᏉᎯ ᎦᏚᎳᏍᏔᏅ ᎾᏍᎩᎾ ᎤᎶᏒᏍᏗ ᎬᏂᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile Hotspot shares your mobile data with other Wi-Fi capable devices.To connect to your Mobile Hotspot:1.Turn on Wi-Fi on the other devices.2.Select  in the list of available Wi-Fi networks.3.If a password is required, enter the password.To save battery, keep your phone plugged in when using Mobile Hotspot.">
                <langSet xml:lang="en-US"><tig><term>Mobile Hotspot shares your mobile data with other Wi-Fi capable devices.To connect to your Mobile Hotspot:1.Turn on Wi-Fi on the other devices.2.Select  in the list of available Wi-Fi networks.3.If a password is required, enter the password.To save battery, keep your phone plugged in when using Mobile Hotspot.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Mobile Hotspot ᏗᏣᏯᏙᎯᏍᏗ ᏂᏨᎤᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗ ᏐᎢ Wi-Fi ᏰᎵᏉ ᎢᎬᏁᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ.ᎾᎿᎢ ᎱᏓᎸᎥᎦ ᎾᎿᎢ ᏂᏨᎤᎢ Mobile Hotspot:1.ᎯᏍᏚᎢ Wi-Fi ᎾᎿ ᏥᎩ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ.2.ᎠᏑᏰᏍᏗ  ᎤᎿ ᏕᎦᏅᏛᎢ ᎥᎿᎢ ᎠᏛᏅᎢᏍᏔᏅ Wi-Fi ᏚᎾᏚᏓᎵ.3.ᎢᏳᏃ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎢᏯᏛᏁᏗ, ᎠᏴᏍᏗ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ.ᎾᎿᎢ ᎯᏍᏆᏂᎪᏓ ᎠᎾᎦᎵᏍᎩ, ᏣᎮᏍᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎫᏓᎸᏙᏗ ᎢᏳᏃ ᎬᏗᎭ Mobile Hotspot.</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency calls are not possible via WiFi Calling.The device switches automatically to a cellular network (2G/3G) to place an emergency call.Emergency calls are only possible in areas with cellular coverage.">
                <langSet xml:lang="en-US"><tig><term>Emergency calls are not possible via WiFi Calling.The device switches automatically to a cellular network (2G/3G) to place an emergency call.Emergency calls are only possible in areas with cellular coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏗ ᏩᏴᏅᏗ ᎭᏗ ᏱᏅᎦᎵᏍᏓ Ꮎ WiFi ᏪᏯᎾ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏱᎬᏁᏟᏴᎾ ᎤᏩᏌ Ꮎ ᏕᎫᏓᎸ ᏧᎾᏚᏓᎵ (2G/3G) ᏱᏣᏚᎵ ᎤᏟᏍᏗ ᏪᏯᏁᏗ.Emergency calls are only possible in areas with cellular coverage. ᎤᏟᏍᏗ ᏪᏯᎾ ᎠᏎ ᎮᏙᎲ ᏕᎫᏓᎸ ᎫᏝᎢ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data">
                <langSet xml:lang="en-US"><tig><term>Mobile data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can tether your Android device to your computer with a USB cable, to share your device's Internet connection with your computer. 1. USB tethering works with Windows Vista, Windows 7, and Linux, the USB drivers for tethering may be needed.2. If your device has an SD card or USB storage, you can't mount it on your computer when USB tethered">
                <langSet xml:lang="en-US"><tig><term>You can tether your Android device to your computer with a USB cable, to share your device's Internet connection with your computer. 1. USB tethering works with Windows Vista, Windows 7, and Linux, the USB drivers for tethering may be needed.2. If your device has an SD card or USB storage, you can't mount it on your computer when USB tethered</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏗᎵᎪᏙᏗ ᏂᏨᎤᎢ Android ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏂᏨᎤᎢ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎬᏗ Ꭰ USB ᏔᎷᎩᏍᎩ ᏍᏕᏱᏛ, ᎾᎿᎢ ᎠᏯᏙᏍᏗᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎬᏗ ᏂᏨᎤᎢ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ. 1. USB ᏗᎵᎪᏙᏗ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ Windows Vista, Windows 7, ᏃᎴ Linux, ᏥᎩ USB ᎠᏱᎴᎦ ᎾᏍᎩᎾ ᏗᎵᎪᏙᏗ ᎡᎵᏊ ᎤᏚᎸᏛ.2. ᎢᏳᏃ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ SD ᏆᎾᏲᏍᏗ ᏃᎴ USB ᎠᏍᏆᏂᎪᏙᏗ, ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎤᏌᎯᎸ ᎾᏍᎩ ᎾᎿ ᏂᏨᎤᎢ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎢᏳᏃ USB ᏗᎵᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="With Open security, any device can connect to your Mobile HotSpot and use your mobile data connection.">
                <langSet xml:lang="en-US"><tig><term>With Open security, any device can connect to your Mobile HotSpot and use your mobile data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏚᎢᏓ ᏱᎩ ᎤᎦᏎᏍᏗ, ᏥᏂᏕᎬᏅᎾ ᏱᏕᎫᏓᎸᎦ ᏂᎯ ᏣᏤᎵ ᏳᏛᎸᎥᎦ ᎠᏂᎩᏍᎩ ᎤᏗᏞᎩᎫᏛᎸ ᏃᎴ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏍᎩ ᎫᏛᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you switch the Hide my device option on, your phone will not be visible to other devices and will not appear in the list of available Wi-Fi networks. Other devices can still connect to your HotSpot by entering its network name manually.">
                <langSet xml:lang="en-US"><tig><term>If you switch the Hide my device option on, your phone will not be visible to other devices and will not appear in the list of available Wi-Fi networks. Other devices can still connect to your HotSpot by entering its network name manually.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᏨᏁᏟᏴᏍᏌ ᎤᏗᏍᎬᏢ ᏥᏂᏕᎬᏅᎾ ᏱᏍᏚᎢᏏ, ᏕᏢᏃᎮᏗ ᎭᏗ ᏴᏂᎪᏩᏔ ᏐᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏃᎴ ᎭᏗ ᏴᎯᎪᏩᏔ ᏚᏓᏅᏅ ᏗᏛᏅᎢᏍᏔᏅ WiFi ᎤᎾᏚᏓᎸᎢ. ᏗᏐᎢ ᏥᏂᏕᎬᏅᎾ Ꮟ ᎱᏓᎸᎥᎦ ᏂᎯ ᏣᏤᎵ ᎤᏗᏟᎩᎫᏓᎸ ᏱᏦᏪᎳᎾ ᏚᏙᎥᎢ ᏕᎯᏐᏍᏗᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Front ">
                <langSet xml:lang="en-US"><tig><term>Front </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎬᏱᏗᏨ </term></tig></langSet>
            </termEntry>
            <termEntry id="This setting disables 2G service. If 2G service is disabled, some apps and functions may not work in locations where LTE or 3G is unavailable.">
                <langSet xml:lang="en-US"><tig><term>This setting disables 2G service. If 2G service is disabled, some apps and functions may not work in locations where LTE or 3G is unavailable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏗᎬᏙᏗ ᏂᎨᏒᎾ 2Ꮆ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏛᏁᏗ ᎬᏙᏗ ᏂᎨᏒᎾ ᏱᎩ, ᎢᎦᏓ ᏗᎬᏙᏗ ᏃᎴ ᏧᎸᏫᏍᏓᏁᏗᏱ ᏳᏄᎸᎲᎦ ᎤᏙᏢᏒᎢ Ꮎ LTE ᏃᎴ 3G ᎭᏗ ᎬᏙᏗ ᏱᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to remove the existing face scan and create a new one?">
                <langSet xml:lang="en-US"><tig><term>Do you want to remove the existing face scan and create a new one?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Do ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎠᎲᏍᏗ ᎬᏂᎨᏒ ᏄᏍᏛᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᏃᎴ ᎪᏒᏗ Ꭰ ᏗᏤ ᏌᏇ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Timeout setting">
                <langSet xml:lang="en-US"><tig><term>Timeout setting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᏍᏙᏗᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ongoing communication from apps in use, navigation, phone calls, and more">
                <langSet xml:lang="en-US"><tig><term>Ongoing communication from apps in use, navigation, phone calls, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎬᏯᎢᏒ ᎠᏓᏛᎪᏔᏅ ᏂᏓᏳᏓᎴᏅ ᏗᎬᏙᏗ ᎾᎿᎢ ᎬᏙᏓ, ᎠᏓᏘᏂᏙᎯ, ᏗᏟᏃᎮᏗ ᏫᏗᎬᏔᏅᎢ, ᏃᎴ ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You will lose your space and data on this tablet. You can\u2019t undo this action.">
                <langSet xml:lang="en-US"><tig><term>You will lose your space and data on this tablet. You can\u2019t undo this action.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎠᏎ ᏓᏣᏲᎱᏎᎵ ᏣᏤᎵ ᎤᏜᏅᏛ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎾᎢ ᎯᎠ ᏗᎪᏪᎶᏗᎢ. ᏂᎯ ᏱᏂᎨᎲᏕᎩᎯᎠ ᎠᎵᏖᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data. Encryption takes an hour or more, during which the phone will restart several times.">
                <langSet xml:lang="en-US"><tig><term>The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data. Encryption takes an hour or more, during which the phone will restart several times.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏕᎵᏍᏙᏗ ᎠᎢᏒᎢ ᏄᏍᏛ ᎪᎯᏓ ᏗᎨᏛᏍᎩ ᏃᎴ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎦᏘᏍᎩᏌᏅᎯ. ᎠᏕᎵᏍᏙᏗ ᎠᎩᏍᎪᎢ ᏑᏟᎶᏛ ᏃᎴ ᎤᎪᏗᏊ, ᎾᎯᏳ ᎦᏙᎤᏍᏗ ᏥᎩ ᏗᎪᏪᎶᏗᎢ ᎠᏎ ᏥᎭᏂᎩᏍᏓ ᎢᎸᏍᎩ ᎢᏳᏩᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You\u0027re using  for mobile data. If you switch to ,  will no longer be used for mobile data.">
                <langSet xml:lang="en-US"><tig><term>You\u0027re using  for mobile data. If you switch to ,  will no longer be used for mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎬᏗᎭ  ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ. ᎢᏳᏃ ᏂᎯ ᎥᎦᏁᏟᏴᏍᎬᎢ ᎾᎿᎢ ,  ᎠᏎ ᎭᏗ ᎦᏅᎯᏓᎨ ᎨᎡᎢ ᎬᏔᏅᎯ ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your child\u2019s phone can be unlocked when they don\u2019t intend to, like if someone holds it up to their finger.">
                <langSet xml:lang="en-US"><tig><term>Your child\u2019s phone can be unlocked when they don\u2019t intend to, like if someone holds it up to their finger.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᎠᏂᏐᎭᎾᎳᎩ ᎾᎿ ᏓᏂᏙᎬ ᏂᎯ ᏤᏍᏗ ᏃᎵᏍᎬ ᎾᎿᎢ, ᎯᎸᏉᏗ ᎢᏳᏃ ᎩᎶᎢ ᏚᏂᏂᏴ ᎾᏍᎩ ᎦᎸᎳᏗ ᎾᎿᎢ ᏂᏨᎤᎢ ᎦᏰᏌᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When Bluetooth is turned on, your device can communicate with other nearby Bluetooth devices.To improve device experience, apps and services can still scan for nearby devices at any time, even when Bluetooth is off. This can be used, for example, to improve location-based features and services. You can change this in Bluetooth scanning settings.">
                <langSet xml:lang="en-US"><tig><term>When Bluetooth is turned on, your device can communicate with other nearby Bluetooth devices.To improve device experience, apps and services can still scan for nearby devices at any time, even when Bluetooth is off. This can be used, for example, to improve location-based features and services. You can change this in Bluetooth scanning settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ Bluetooth ᏄᏍᏛ ᎯᏍᏚᎢ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏊ ᏗᏓᏛᎪᏙᏗ ᎬᏗ ᏐᎢ ᎡᏍᎦᏂ Bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ.ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᎦᏙᎲᏒ, ᏗᎬᏙᏗ and ᎢᏗᏛᏁᎵᏓᏍᏗ ᏰᎵᏯ ᏙᎢ ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᎤᎬᏩᏟ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ, ᎥᏍᏊ ᎢᏳᏃ Bluetooth ᏄᏍᏛ ᎠᏍᏚᎭ. ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ. ᏂᎯ ᏰᎵᏊ ᎦᏁᏟᏴᏍᏗ ᎯᎠ ᎾᎿ Bluetooth ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select time zone">
                <langSet xml:lang="en-US"><tig><term>Select time zone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎠᏥᎢᎵᏒ ᏗᏓᏓᎴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="When using 2 SIMs, this device will be limited to 4G. Learn more">
                <langSet xml:lang="en-US"><tig><term>When using 2 SIMs, this device will be limited to 4G. Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎬᏔᏂᏓᏍᏗ 2 SIMs, ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎨᎡᎩ ᏩᏎᏢᏊ ᎾᎿᎢ 4G. ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to download first wallpaper. Please check your network settings and try again.">
                <langSet xml:lang="en-US"><tig><term>Unable to download first wallpaper. Please check your network settings and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎢᎬᏱᏱ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ. ᎰᏩᏊ ᎪᏪᎶᏗ ᏂᏨᎤᎢ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage">
                <langSet xml:lang="en-US"><tig><term>Data usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎬᏙᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When an app is pinned, the pinned app may open other apps and personal data may be accessible. To use app pinning: \t1.\tTurn on app pinning \t2.\tOpen Overview \t3.\tTap the app icon at the top of the screen, then tap Pin">
                <langSet xml:lang="en-US"><tig><term>When an app is pinned, the pinned app may open other apps and personal data may be accessible. To use app pinning: \t1.\tTurn on app pinning \t2.\tOpen Overview \t3.\tTap the app icon at the top of the screen, then tap Pin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎠᎴᎢ ᎬᏙᏗ ᎾᏍᎩ ᎦᎭᏔᏅᎢ, ᎾᏍᎩ ᎦᎭᏔᏅᎢ ᎬᏙᏗ ᏰᎵᏉ ᏱᏓᏍᏚᎭ ᏐᎢ ᏗᎬᏙᏗ ᏃᎴ ᎠᏏᏴᏫ ᎦᏘᏍᎩᏌᏅᎯ ᏰᎵᏉ ᎨᏎᏍᏗ ᎠᎯᏓ ᎠᎩᏍᏗ. ᎾᎢ ᎬᏙᏓ ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ: \t1.\tᎠᏍᏚᎢᏓ ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ \t2.\tᎠᏍᏚᎢᏓ ᏍᏆᎳ ᎧᏃᎮᏓ \t3.\tᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎬᏙᏗ ᎠᎢᎧᏂ ᎤᎿᎢ ᎾᏍᎩ ᎦᏚᎢ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ, ᎿᏉᏃ ᎭᏐᎥᏍᏗ ᎦᎭᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t use a Wi\u2011Fi network unless it has a good internet connection">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t use a Wi\u2011Fi network unless it has a good internet connection</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ \u2019 ᏍᏔᏅ Wi\u2011Fi ᎠᏏᎸᏓ ᎠᏎ ᎣᏍᏓ ᎠᏏᎳᏕᏫᏒᎢ ᏱᎫᏓᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="To quickly open camera, press the power button twice. Works from any screen.">
                <langSet xml:lang="en-US"><tig><term>To quickly open camera, press the power button twice. Works from any screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᏟᏍᏓ ᎯᏍᏚᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ, ᎭᏐᎥᏍᏓ ᏥᎩ ᎤᏟᏂᎩᏓ ᎠᏐᏅᏍᏙᏗ ᏔᎵ ᎢᏳᏩᎫᏗ ᎢᏳᏍᏓ ᏱᏚᎸᏫᏍᏓᏍᏏ ᎠᏛᏰᎸᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device name is visible to apps on your phone. It may also be seen by other people when you connect to Bluetooth devices, connect to a Wi-Fi network or set up a Wi-Fi hotspot.">
                <langSet xml:lang="en-US"><tig><term>Your device name is visible to apps on your phone. It may also be seen by other people when you connect to Bluetooth devices, connect to a Wi-Fi network or set up a Wi-Fi hotspot.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏚᏅᏙᎥ ᏄᏍᏛ ᎬᏩᏂᎪᏩᏛᏗ ᎾᎿᎢ ᏗᎬᏙᏗ ᎤᎿᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ. ᎨᎡᎢ ᏰᎵᏯ ᎾᏍᏊ ᎨᎡᎩ ᎠᎪᎲᎩ ᎬᏗ ᏐᎢ ᎠᏂᏴᏫ ᎢᏳᏃ ᏂᎯ ᎫᏓᎸᎢ ᎾᎿᎢ Bluetooth ᏥᏂᎬᏅᏗᏓᎾ, ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᏧᎾᏚᏓᎵ ᏃᎴ ᎦᎧᎲᏍᎬᎢ Ꭰ Wi-Fi ᎤᏗᏞᎩ ᎤᏓᏓᏢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow this app to create a picture-in-picture window while the app is open or after you leave it (for example, to continue watching a video). This window displays on top of other apps you're using.">
                <langSet xml:lang="en-US"><tig><term>Allow this app to create a picture-in-picture window while the app is open or after you leave it (for example, to continue watching a video). This window displays on top of other apps you're using.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎬᏙᏗ ᎪᏒᏗ ᏗᏓᏥᎶᏍᏔᏅ-ᎾᎿᎢ-ᏗᏓᏥᎶᏍᏔᏅ ᏦᎳᏂ ᎾᎯᏳᎢ ᎾᏍᎩ ᎬᏙᏗ ᎠᏍᏚᎢᏛ ᎨᏒᎢ ᎠᎴᏃ ᎤᎶᏐᏅ ᏂᎯ ᎯᎯᏴᎢ (ᎾᏍᎩᎾ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎢ ᏂᎦᏯᎢᏒᎢ ᎠᎦᏙᏍᏙᏗ ᎠᏓᏴᎳᏛᏍᎩ). ᎯᎠ ᏦᎳᏂ ᎬᏂᎨᏒ ᏂᏕᎬᏅᎢ ᎤᎾᎢ ᎦᏚᎢ ᎾᏍᎩ ᏐᎢ ᏗᎬᏙᏗ ᎲᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" recommends a new PIN or password and may not work as expected without one">
                <langSet xml:lang="en-US"><tig><term> recommends a new PIN or password and may not work as expected without one</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎦᎸᏉᏙᏗ ᏗᏤ PIN ᏃᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᏃᎴ ᏰᎵᏉ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎯᎢᎾᎢ ᎤᏚᎩ ᎤᏩᏌ ᏄᏠᏯᏍᏛᎾ ᏌᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set data warning">
                <langSet xml:lang="en-US"><tig><term>Set data warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="A password protects your phone if it\u2019s lost or stolen.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A password protects your phone if it\u2019s lost or stolen.This also deletes the fingerprint model stored on your device. You won\u2019t be able to use your fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ or ᎦᏃᏍᎩᏓ.ᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When magnification is turned on, you can zoom in on your screen.To zoom, start magnification, then tap anywhere on the screen.Drag 2 or more fingers to scrollPinch 2 or more fingers to adjust zoomTo zoom temporarily, start magnification, then touch &amp; hold anywhere on the screen.Drag to move around the screenLift finger to zoom outYou can’t zoom in on the keyboard or navigation bar.">
                <langSet xml:lang="en-US"><tig><term>When magnification is turned on, you can zoom in on your screen.To zoom, start magnification, then tap anywhere on the screen.Drag 2 or more fingers to scrollPinch 2 or more fingers to adjust zoomTo zoom temporarily, start magnification, then touch &amp; hold anywhere on the screen.Drag to move around the screenLift finger to zoom outYou can’t zoom in on the keyboard or navigation bar.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎠᏔᏃᎲᏍᏗᏍᎩ ᎨᎡᎢ ᎤᎦᏔᎲᏒᎢ ᎤᎿᎢ, ᏂᎯ ᏰᎵᏯ zᎾᎥ ᏅᎦ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ.ᎾᎿᎢ ᏑᎻ,ᎭᎴᎾ ᎠᏔᏃᎲᏍᏗᏍᎩ, ᎢᏳᏃ ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᏂᎬᏉ ᎤᎿᎢ ᏥᎩ ᎠᏴᏙᎳᏛᎢ.ᎦᎾᏏᏁᎦ 2 ᏃᎴ ᎤᎪᏗᏊ ᏕᎦᏰᏌᏛ ᎾᎿᎢ ᎤᏓᎸᏪᏍᏗᎠᏇᏄᎩᏍᏗ 2 ᏃᎴ ᎤᎪᏗᏊ ᏕᎦᏰᏌᏛ ᎾᎿᎢ ᎠᏓᏁᏟᏴᏍᎩ ᏑᎻᎾᎿᎢ ᏑᎻ ᏞᎦᏊ,ᎭᎴᎾ ᎠᏔᏃᎲᏍᏗᏍᎩ, ᎢᏳᏃ ᎭᏒᏂᎦ ᏃᎴ ᎯᎾᎯᏍᏓ ᏂᎬᏉ ᎤᎿᎢ ᏥᎩ ᎠᏴᏙᎳᏛᎢ.ᎦᎾᏏᏁᎦ ᎾᎿᎢ ᎠᎲᏍᏗ ᎠᏕᏯᏍᏗ ᎠᏴᏙᎳᏛᎢᎠᏌᎳᏙᏗ ᎦᏰᏌᏛ ᎾᎿᎢ ᎢᎾ ᎢᎬᏁᏗᏂᎯ ᎨᏍᏗ ᏰᎵ ᎾᎥ ᏅᎦ ᎤᎿᎢ ᏥᎩ ᏗᏐᏅᏍᏙᏗ ᏃᎴ ᎠᏓᏘᏂᏙᎯ ᏚᏓᏅᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If your router is not broadcasting a network ID but you would like to connect to it in the future, you can set the network as hidden.This may create a security risk because your phone will regularly broadcast its signal to find the network.Setting the network as hidden will not change your router settings.">
                <langSet xml:lang="en-US"><tig><term>If your router is not broadcasting a network ID but you would like to connect to it in the future, you can set the network as hidden.This may create a security risk because your phone will regularly broadcast its signal to find the network.Setting the network as hidden will not change your router settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᏫᎦᎶᎯᏍᏗ ᏂᏗᎦᎴᏯᏍᏗᎲᎾ ᏕᎫᏓᎸ ᎠᏎᏃ ᏱᏣᏚᎵ ᏗᎫᏓᎸᏗ ᎤᏩᎫᏗᏗᏒ, ᏕᎦᎧᎲ ᏱᏕᎲᏍᎦᎸᎦ ᏕᎫᏛᎸᎥᎭᎵᏊ ᎠᎦᏎᏍᏙᏗ ᏱᏂᎬᎵᏍᏗ ᎢᎬᏂᏏᏍᎩ ᏗᏝᏃᎮᏗ ᏂᎪᎯᎸ ᏕᎦᎴᏯᏍᏗᎲ ᎤᏲᎲ ᎠᏓᏃᏎ ᎠᎾ ᏕᎫᏓᎸᎢᏕᎦᎧᎲ ᏕᎫᏓᎸᎢ ᏱᏗᏕᎲᏍᎦᎸᎾ ᎭᏗ ᏱᏛᎬᏁᏟᏴᏍᎢ Ꮎ ᏫᎦᎶᎯᏍᏗ ᏕᎦᎧᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="To check time, notifications, and other info, tap your screen.">
                <langSet xml:lang="en-US"><tig><term>To check time, notifications, and other info, tap your screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎦᏎᏍᏔᏅ ᎠᏥᎢᎵᏒ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᏐᎢ, ᎢᏳᏩᎪᏘ ᎭᏐᏅᏍᏓ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint Unlock creates a unique model of your fingerprint to verify it\u2019s you. To create this fingerprint model during setup, you will take images of your fingerprint from different positions.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint Unlock creates a unique model of your fingerprint to verify it\u2019s you. To create this fingerprint model during setup, you will take images of your fingerprint from different positions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏓᏙᏢᏍᎪᎢ ᎤᏩᏒᎯᏯ ᎪᎱᏍᏗ ᎪᏢᏅ ᎤᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎰᎯᏳᏓ ᎾᏍᎩ ᏂᎯ. ᎾᎿᎢ ᎪᏒᏗ ᎯᎠ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎾᎯᏳ ᎨᏒ ᏘᎧᎲᎦ, ᏂᎯ ᎠᏎ ᎠᎩᏍᏗ ᏚᏓᏴᎳᏛ ᎤᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏅᏓᏳᏓᎴᏅᎯ ᏧᏓᎴᎿᎢ ᎾᎿ ᏓᏂᏙᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase all data (factory reset)">
                <langSet xml:lang="en-US"><tig><term>Erase all data (factory reset)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎦᏘᏍᎩᏌᏅᎯ (ᎤᏃᏢᏅᏗ ᏥᎯᎧᎲᎦ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Never show notifications">
                <langSet xml:lang="en-US"><tig><term>Never show notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎢᎸᎯᏳᎢ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏗᏓᏃᏟᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="These links are verified and automatically open in this app.">
                <langSet xml:lang="en-US"><tig><term>These links are verified and automatically open in this app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏕᎫᏓᎸᎢ ᎨᏒᎢ ᎪᎯᏳᏔᏅᎢ ᏃᎴ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᏍᏚᎢᏍᎩ ᎾᎿᎢ ᎾᏍᎩ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow data exchange when this  touches another NFC device">
                <langSet xml:lang="en-US"><tig><term>Allow data exchange when this  touches another NFC device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎦᏁᏟᏴᏍᏓ ᎾᎯᏳ ᎯᎠ  ᏓᏒᏂᎮᏍᏗ ᏄᏓᎴ NFC ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="About device">
                <langSet xml:lang="en-US"><tig><term>About device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="All apps and data will be deleted.">
                <langSet xml:lang="en-US"><tig><term>All apps and data will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏗᎬᏙᏗ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t show any notifications">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t show any notifications</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ\u2019 ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏂᎦᎥ ᏗᏓᏃᏣᎳᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera apps">
                <langSet xml:lang="en-US"><tig><term>Camera apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Encryption was interrupted and can\u2019t complete. As a result, the data on your phone is no longer accessible. To resume using your phone, you need to perform a factory reset. When you set up your phone after the reset, you\u2019ll have an opportunity to restore any data that was backed up to your Google Account.">
                <langSet xml:lang="en-US"><tig><term>Encryption was interrupted and can\u2019t complete. As a result, the data on your phone is no longer accessible. To resume using your phone, you need to perform a factory reset. When you set up your phone after the reset, you\u2019ll have an opportunity to restore any data that was backed up to your Google Account.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎵᏍᏙᏗ ᎨᏎᎢ ᎤᏓᏲᏍᏓᏁᎸᎩ ᏃᎴ ᎨᏍᏗ ᏰᎵ ᎧᎵᎢ. ᎯᎢᎾᎢ a ᏄᎵᏍᏔᏅ, ᏥᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎤᎿᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏄᏍᏛ ᎭᏗ ᎦᏅᎯᏓᎨ ᏅᏛᏴᏍᏙᏗᎢ.  ᎾᎿᎢ ᎠᎴᏂᏐᏗᏍᎩ ᎬᏗᎭ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ, ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎵᏂᎬᏁᏗ Ꭰ ᎤᏃᏢᏅᏗ ᎢᎦᎧᎯᎲᏍᏗ. ᎢᏳᏃ ᏂᎯ ᎦᎧᎲᏍᎬᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎣᏂᏗᏢ ᏥᎩ ᎢᎦᎧᎯᎲᏍᏗ, ᏂᎯ\u2019ll ᎠᏎ ᎠᎴᏃ ᎤᎾᏜᏅᏓᏕᎲᎢ ᎾᎿᎢ ᎪᏢᎯᏐᏗ ᎾᏂᎥᏉ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᎩᎾ ᎨᏎᎢ ᎠᏨᏍᏗ ᎦᎸᎳᏗ ᎾᎿᎢ ᏂᏨᎤᎢ Google Account.</term></tig></langSet>
            </termEntry>
            <termEntry id="This permission allows an app to modify system settings.">
                <langSet xml:lang="en-US"><tig><term>This permission allows an app to modify system settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᏗᎬᏙᏗ ᎾᎢ ᎤᏃᏒᎯᏐᏗ ᏄᏍᏗᏓᏅᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier data accounting may differ from your device.">
                <langSet xml:lang="en-US"><tig><term>Carrier data accounting may differ from your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏫᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ ᏰᎵᏉ ᏚᏓᎴᎿᎥ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No data transfer">
                <langSet xml:lang="en-US"><tig><term>No data transfer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier data accounting may differ from device accounting">
                <langSet xml:lang="en-US"><tig><term>Carrier data accounting may differ from device accounting</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏫᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ ᏰᎵᏉ ᏚᏓᎴᎿᎥ ᏅᏓᏳᏓᎴᏅᎯ ᏥᏂᎬᏅᏗᏓᎾ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Haptic feedback for tap, keyboard, and more">
                <langSet xml:lang="en-US"><tig><term>Haptic feedback for tap, keyboard, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏍᏙᏗ ᎦᏬᎯᎵᏴᏓ ᎾᏍᎩᎾ ᎭᏐᎥᏍᏓ, ᏗᏐᏅᏍᏙᏗ, ᏃᎴ ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="No installed apps have requested notification access.">
                <langSet xml:lang="en-US"><tig><term>No installed apps have requested notification access.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏅᏔᏅ ᏗᎬᏙᏗ ᎤᏍᏛ ᏗᏔᏲᏢᎩ ᏗᏓᏃᏣᎳᏁᎯ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You need an Internet connection to view wallpapers. Please connect and try again.">
                <langSet xml:lang="en-US"><tig><term>You need an Internet connection to view wallpapers. Please connect and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ Ꭰ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎾᎿᎢ ᏗᎧᏃᏗ ᎠᏍᏆᏚᎸ ᎦᏯᎸᏗ. ᎰᏩᏊ ᎫᏓᎸᎢ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network usage">
                <langSet xml:lang="en-US"><tig><term>Network usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ ᎬᏗᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not sharing internet or content with other devices">
                <langSet xml:lang="en-US"><tig><term>Not sharing internet or content with other devices</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎠᏓᏲᏔᎡᏗ ᎠᏏᎳᏕᏫᏒᎢ ᏃᎴ ᏄᏍᏗᏓᏅ ᏐᎢ ᏥᏂᎬᏅᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set data limit">
                <langSet xml:lang="en-US"><tig><term>Set data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="You won\u2019t see or hear notifications. Calls from starred contacts and repeat callers are allowed.">
                <langSet xml:lang="en-US"><tig><term>You won\u2019t see or hear notifications. Calls from starred contacts and repeat callers are allowed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎭᏗ ᎡᎵᎢ ᎠᎪᏩᏛᏗ ᎠᎴᏃ ᎠᏛᎪᏗ ᏗᏓᏃᏣᎳᏁᎯ ᏫᏗᎬᏔᏅᎢ ᏂᏓᏳᏓᎴᏅ ᏄᎬᏫᏳᏒ ᎤᏛᏁᎸᏅᎩ ᏗᏟᎬᎮᏙᏗ ᏃᎴ ᎢᎸᏍᎩᏳᏩᏔ ᏗᏅᏗᏍᎩ ᎨᏒᎢ ᎠᎵᏍᎪᎸᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Helps other devices find this hotspot. Reduces hotspot connection speed.">
                <langSet xml:lang="en-US"><tig><term>Helps other devices find this hotspot. Reduces hotspot connection speed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏐᎢ ᏓᏍᏕᎵᎰ ᏥᏂᎬᏅᏗᏓᏂ ᎤᏩᏛᏗ ᎤᏗᏞᎫᏓᎸᎢ ᎠᎦᏲᏙᏍᎪᎢ ᎤᏗᎴᎩᏕᎫᏓᎸ ᏕᎫᏛᎸᏍᎦ ᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Really wipe user data and convert to file encryption?">
                <langSet xml:lang="en-US"><tig><term>Really wipe user data and convert to file encryption?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᎯᏳᎯ ᎦᏅᎦᎸᏗ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏃᎴ ᎦᏁᏟᏴᏍᏗ ᎾᎿᎢ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏕᎵᏍᏙᏗ?</term></tig></langSet>
            </termEntry>
