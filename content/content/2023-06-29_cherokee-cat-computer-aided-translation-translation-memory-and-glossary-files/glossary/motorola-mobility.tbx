            <termEntry id="Trigger Bluetooth Audio LDAC\u000ACodec Selection: Playback Quality">
                <langSet xml:lang="en-US"><tig><term>Trigger Bluetooth Audio LDAC\u000ACodec Selection: Playback Quality</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏣᏁᏍᏗᎢ Bluetooth ᎤᏃᏴᎬ LDAC\u000AᏂᎬᏅᏗᏓᏅ ᎠᏑᏰᏛ: ᎠᏏᏅᏍᏔᏅ ᏗᏁᎸᏙᏗ ᎢᏲᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show hardware layers updates">
                <langSet xml:lang="en-US"><tig><term>Show hardware layers updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᎩᎪᏩᏛᏓ ᏍᏓᏯ ᎬᏔᏂᏓᏍᏗ ᏓᏰᎦᏢᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="The PC is already in use.">
                <langSet xml:lang="en-US"><tig><term>The PC is already in use.</term></tig></langSet>
