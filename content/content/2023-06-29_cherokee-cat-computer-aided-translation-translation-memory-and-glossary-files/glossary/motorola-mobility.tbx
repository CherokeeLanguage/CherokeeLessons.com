                <langSet xml:lang="chr"><tig><term>ᏗᎦᏃᏣᏢᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn it on in .">
                <langSet xml:lang="en-US"><tig><term>You can turn it on in .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎦᏔᎲᏍᏗ ᎨᎡᎢ ᎤᎿᎢ ᎾᎿ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe down again to open quick settings">
                <langSet xml:lang="en-US"><tig><term>Swipe down again to open quick settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎡᎳᏗᏟ ᏏᏊ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎤᏟᏍᏓ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="They will only be blocked while you're gaming.">
                <langSet xml:lang="en-US"><tig><term>They will only be blocked while you're gaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏛ ᎠᏎ ᎤᏩᏌ ᎦᏐᎭᎾᎳ ᎾᎯᏳᎢ ᏂᎯ ᎾᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="Ringtones(SIM slot 2)">
                <langSet xml:lang="en-US"><tig><term>Ringtones(SIM slot 2)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎵᏍᏙᏓ(SIM ᎤᏜᏅᏛ 2)</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to know what features we have">
                <langSet xml:lang="en-US"><tig><term>Allows the app to know what features we have</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᎦᏙᎥᏒ ᎦᏙ ᏗᎦᏎᏍᏙᏗ ᎠᏴ ᎤᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some Gestures may conflict with game controls, so blocking them will prevent potential disruptions.">
                <langSet xml:lang="en-US"><tig><term>Some Gestures may conflict with game controls, so blocking them will prevent potential disruptions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᎤᏬᏯᏂᏍᎩ ᏰᎵᏉ ᏗᎦᏘᎴᎩ ᎬᏗ ᏗᏁᎸᏙᏗ ᏗᎯᎸᏍᏗ, ᎾᏍᎩᎾᏃ ᏓᏂᏐᎭᎾᎳᏗᏍᎬᎢ ᎠᏎᎢ ᎠᏲᏍᏙᏗᏍᎩ ᎢᏳᎵᏍᏙᏗ ᏗᏲᏍᏔᏅᎯ ᏱᏂᎦᎵᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't complete call. Error code 102.">
                <langSet xml:lang="en-US"><tig><term>Couldn't complete call. Error code 102.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏰᎵᎢ ᎠᏍᏆᏛᏃᏅ ᏪᏯᎾ. ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ: 102</term></tig></langSet>
            </termEntry>
            <termEntry id="To use , make sure mobile data is turned on. You can change this in mobile network settings.">
                <langSet xml:lang="en-US"><tig><term>To use , make sure mobile data is turned on. You can change this in mobile network settings.</term></tig></langSet>
