            </termEntry>
            <termEntry id="Over Charger Voltage">
                <langSet xml:lang="en-US"><tig><term>Over Charger Voltage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏒᏍᏔᏅ ᎬᏂᏗᏍᏙᏗ ᎠᎾᎦᎵᏍᎩ ᎠᏥᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="App launch preference">
                <langSet xml:lang="en-US"><tig><term>App launch preference</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎭᏂᎩᏍᏙᏗ ᎤᏟᎠᏰᎸᏗᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t optimize">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t optimize</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ\u2019 ᎣᏍᏓ ᏳᎵᏍᏙᏗᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't hear your next alarm  unless you turn this off before then">
                <langSet xml:lang="en-US"><tig><term>You won't hear your next alarm  unless you turn this off before then</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎢᏣᏛᏓᏍᏓ ᏂᏨᏅᎢ ᏐᎢ ᎠᏓᏕᏯᏙᏗᏍᎩ  ᎢᏳᏍᎩᏂ ᏂᎯ ᎭᎦᏔᎲᎾ ᎯᎠ ᎠᏍᏚᎭ ᎤᏓᎷᎸ ᎿᏉᏃ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint Unlock creates a unique model of your child\u2019s fingerprint to verify it\u2019s them. To create this fingerprint model during setup, they will take images of their fingerprint from different positions.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint Unlock creates a unique model of your child\u2019s fingerprint to verify it\u2019s them. To create this fingerprint model during setup, they will take images of their fingerprint from different positions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏓᏙᏢᏍᎪᎢ ᎤᏩᏒᎯᏯ ᎪᎱᏍᏗ ᎪᏢᏅ ᎤᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎰᎯᏳᏓ ᎾᏍᎩ ᏂᎯ. To ᎪᏒᏗ ᎯᎠ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎾᎯᏳ ᎨᏒ ᏘᎧᎲᎦ, ᏂᎯ ᎠᏎ ᎠᎩᏍᏗ ᏚᏓᏴᎳᏛ ᎤᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏅᏓᏳᏓᎴᏅᎯ ᏧᏓᎴᎿᎢ ᎾᎿ ᏓᏂᏙᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="And you won\u2019t receive notifications when updates occur.">
                <langSet xml:lang="en-US"><tig><term>And you won\u2019t receive notifications when updates occur.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰnd ᏲᎤ Ꮼn't rᎡcᎡᎢᎥᎡ ᏃᏘfᎢcᎠᏘᎣnᏍ wᎮn ᎤpᏓᏖᏍ ᎣccᎤr.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.">
                <langSet xml:lang="en-US"><tig><term>If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭲf ᏲᎤ rᎡᏍtrᎢct bᎠckgrᎣᎤnd ᎼbᎢᎴ ᏓᏔ, ᏐᎺ ᎠppᏍ Ꭰnd ᏎrᎥᎢcᎡᏍ Ꮼn't Ꮼrk ᎤnᎴᏍᏍ ᏲᎤ'rᎡ cᎣnᏁcᏖd tᎣ ᏫFᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you restrict background mobile data, some apps and services won\u2019t work unless you\u2019re connected to Wi\u2011Fi.">
