                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎦᎸᏛᎢ ᎾᏍᎩ ᎬᏩᏕᏱᏛ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎦᏖᏅᏕᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow this app to access, modify and delete files on the device, or any connected storage devices? This app may access files without asking you.">
                <langSet xml:lang="en-US"><tig><term>Allow this app to access, modify and delete files on the device, or any connected storage devices? This app may access files without asking you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎯᎠ ᎬᏙᏗ ᎾᎿᎢ ᎠᏴᏍᏗ, ᎤᏃᏢᎯᏐᏗᏱ, ᏃᎴ ᎠᏍᎪᎸᏗᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᎤᎿᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ, ᏃᎴ ᎾᏂᎥᏉ ᎫᏓᎸᏅᎯ ᎠᏍᏆᏂᎪᏙᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ? ᎯᎠ ᎬᏙᏗ ᏰᎵᏯ ᎠᏴᏍᏗ ᏗᏍᏆᏂᎪᏙᏗ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏛᏛᎲᏍᎬ ᏂᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission denied">
                <langSet xml:lang="en-US"><tig><term>Permission denied</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᏓᏱᎸᎢ</term></tig></langSet>
            </termEntry>
