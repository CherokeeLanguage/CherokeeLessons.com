                <langSet xml:lang="chr"><tig><term>ᎢᎦᎸᏫᏍᏓᏁᎸ ᏗᎩᏙᏗ ᏓᏍᏆᎾᎪᏓ ᏗᏨᎸᏫᏍᏓᏁᎸ ᏧᏓᏟᎶᏍᏛᏅ ᎣᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="No service selected">
                <langSet xml:lang="en-US"><tig><term>No service selected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎤᎾᏓᏍᏕᎸᏗ ᎠᏑᏰᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you enter an incorrect PIN on the next attempt, this device's data will be deleted">
                <langSet xml:lang="en-US"><tig><term>If you enter an incorrect PIN on the next attempt, this device's data will be deleted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᏴᏍᏗ ᏂᏚᏳᎪᏛᎾ PIN ᎾᎿᎢ ᏥᎩ ᏐᎢ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Invalid signature">
                <langSet xml:lang="en-US"><tig><term>Invalid signature</term></tig></langSet>
