                <langSet xml:lang="en-US"><tig><term>Are you sure you want to go back?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏙᏳᎢ ᎨᏒᎢ ᏣᏚᎵᏍᎬ ᎾᎢ ᎢᏣᎦᏔᎲᏍᏗᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Earthquake and tsunami warning">
                <langSet xml:lang="en-US"><tig><term>Earthquake and tsunami warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙᎯ ᎠᎵᏖᎸᎲᏍᎬ ᎠᎴ ᎡᏆ ᎠᎵᏍᏗᎳᏁᎬᎢ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tsunami warning">
                <langSet xml:lang="en-US"><tig><term>Tsunami warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏆ ᎠᎵᏍᏗᎳᏁᎬᎢ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency alerts in voice call">
                <langSet xml:lang="en-US"><tig><term>Emergency alerts in voice call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎠᏓᏃᏎᎯ ᎾᎿ ᎧᏁᎬ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatic WEA Settings changes based on SIM">
                <langSet xml:lang="en-US"><tig><term>Automatic WEA Settings changes based on SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ WEA ᏕᎦᎧᎲᎢ ᏗᎦᏁᏟᏴᏓ ᏓᎳᏏᏔᏅᎩ ᎾᎿᎢ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="A reminder sound will play at regular volume">
                <langSet xml:lang="en-US"><tig><term>A reminder sound will play at regular volume</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎠᏓᏅᏓᏗᏍᏗᏍᎩ ᎦᏃᏴᎵᏍᏗᏍᎩ ᎠᏎ ᎤᎾᏛᏁᎸᏗ ᎤᎿᎢ ᎤᏠᏱᎭ ᎤᏃᏴᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use text-to-speech to speak wireless emergency alert messages">
                <langSet xml:lang="en-US"><tig><term>Use text-to-speech to speak wireless emergency alert messages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎪᏪᎳᏅᎢ-ᎾᎿᎢ-ᏩᏂᎱ ᎾᎿᎢ ᎧᏁᎬ ᏂᏓᏏᎳᏛ ᎢᎦᎵᏍᏗᏍᎩ ᏗᏓᏃᏎᎯ ᏗᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Test broadcasts for Earthquake Tsunami Warning System">
                <langSet xml:lang="en-US"><tig><term>Test broadcasts for Earthquake Tsunami Warning System</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ ᎠᏗᎦᎴᏯᏍᏗ for ᎦᏙᎯ ᎠᎵᏖᎸᎲᏍᎬ ᎡᏆ ᎠᎵᏍᏗᎳᏁᎬᎢ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Severe threats to life and property">
                <langSet xml:lang="en-US"><tig><term>Severe threats to life and property</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏒᏍᏔᏅᎯ ᏗᎧᏃᎮᏢᏍᎩ ᎾᎿᎢ ᎡᎲᎢ ᎠᎴ ᎦᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Helps other devices find this hotspot. Reduces hotspot connection speed.">
                <langSet xml:lang="en-US"><tig><term>Helps other devices find this hotspot. Reduces hotspot connection speed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏐᎢ ᏓᏍᏕᎵᎰ ᏥᏂᎬᏅᏗᏓᏂ ᎤᏩᏛᏗ ᎤᏗᏞᎫᏓᎸᎢ ᎠᎦᏲᏙᏍᎪᎢ ᎤᏗᎴᎩᏕᎫᏓᎸ ᏕᎫᏛᎸᏍᎦ ᎦᏣᏄᎳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Extreme threats to life and property">
                <langSet xml:lang="en-US"><tig><term>Extreme threats to life and property</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏒᏍᏔᏅᎯ ᏗᎧᏃᎮᏢᏍᎩ ᎾᎿᎢ ᎡᎲᎢ ᎠᎴ ᎦᏙᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off to have public safety messages sent only to your SMS app">
                <langSet xml:lang="en-US"><tig><term>Turn off to have public safety messages sent only to your SMS app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎾᎿᎢ ᎤᎭ ᎤᏤᎵ ᎤᎾᏓᎵᏏᏅᏙᏗ ᏗᎪᎵᏰᏗ ᏭᏅᏅᎢ ᎤᏅᏒ ᎾᎿᎢ ᏂᏨᎤᎢ SMS ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="State and local tests">
