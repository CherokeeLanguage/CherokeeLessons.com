                <langSet xml:lang="en-US"><tig><term>Failed to create a new user</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎢ ᎪᏒᏗ ᎢᏤ ᎬᏗᏍᎩ</term></tig></langSet>
