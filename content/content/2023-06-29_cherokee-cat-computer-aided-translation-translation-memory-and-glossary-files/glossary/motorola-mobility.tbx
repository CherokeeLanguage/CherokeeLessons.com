            <termEntry id="Choose how to open the sidebar during a game">
                <langSet xml:lang="en-US"><tig><term>Choose how to open the sidebar during a game</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏰᎵ ᎾᎢ ᎠᏍᏚᎢᏍᏓ ᎾᏍᎩ ᎤᏟᏗᏢ ᎦᎾᎸᎢ ᎾᎯᏳᎢ ᎾᏍᎩ ᏗᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hide the sidebar">
                <langSet xml:lang="en-US"><tig><term>Hide the sidebar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎲᏍᎦᏢᎦ ᎾᏍᎩ ᎤᏟᏗᏢ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="High performance">
                <langSet xml:lang="en-US"><tig><term>High performance</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏍᎪᎵᏴ ᏧᎸᏫᏍᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap the icon">
                <langSet xml:lang="en-US"><tig><term>Tap the icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎠᎢᎧᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="High performance">
                <langSet xml:lang="en-US"><tig><term>High performance</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏍᎪᎵᏴ ᏧᎸᏫᏍᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Extend CPU limit for smoother gaming">
                <langSet xml:lang="en-US"><tig><term>Extend CPU limit for smoother gaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎯᏗᏍᏗ CPU ᎠᏎᎸᎯ ᎾᏍᎩᎾ ᏓᏫᏍᎦᎨᏍᏗ ᏓᏁᏩᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="High performance allows for smoother gaming. This feature increases battery usage and your device may feel warmer while it’s on.">
                <langSet xml:lang="en-US"><tig><term>High performance allows for smoother gaming. This feature increases battery usage and your device may feel warmer while it’s on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏍᎪᎵᏴ ᏧᎸᏫᏍᏓᏁᎯ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᏍᎩᎾ ᏓᏫᏍᎦᎨᏍᏗ ᏛᏁᎸᏗᏍᎬᎢ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏕᎧᏁᏉᎦ ᎠᎾᎦᎵᏍᎩ ᎬᏗᏍᎩ ᎠᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵᏉ ᎤᎦᎾᏩ ᏱᎩ ᎾᎯᏳᎢ ᎠᏍᏚᎢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show content around the camera cutout">
                <langSet xml:lang="en-US"><tig><term>Show content around the camera cutout</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎦᎸᏛᎢ ᎾᏍᎩ ᎬᏩᏕᏱᏛ ᏗᏓᏟᎶᏍᏙᏗ ᎦᏖᏅᏕᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Display refresh rate">
                <langSet xml:lang="en-US"><tig><term>Display refresh rate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎠᏤᎲᏍᏙᏓ ᎠᏟᎶᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime settings">
                <langSet xml:lang="en-US"><tig><term>Gametime settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Large area">
                <langSet xml:lang="en-US"><tig><term>Large area</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᏆ ᎢᎬᎾᏕᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime brings your games together with rich content from gaming community. You can also find tools and settings for better gaming">
                <langSet xml:lang="en-US"><tig><term>Gametime brings your games together with rich content from gaming community. You can also find tools and settings for better gaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᎠᏲᎯᎲ ᏣᏤᎵ ᏧᎾᏁᎸᏙᏗ ᎢᏧᎳᎭ ᎤᏐᏯᏍᏗ ᎪᏢᏅᎯ ᎦᎸᏛᎢ ᎾᏍᎩᎾ ᏓᏁᎶᎲᏍᎬ ᏚᏂᏚᏒᎢ. ᏂᎯ ᏰᎵᏊ ᎾᏍᏉ ᎯᏩᏔ ᏗᎬᏔᏂᏓᏍᏗ ᏃᎴ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾ ᏓᏤᏢᎩ ᏓᏁᎶᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some games may not work well with Acoustic lights. For the best experience, try using this feature with battle royale shooting games.">
                <langSet xml:lang="en-US"><tig><term>Some games may not work well with Acoustic lights. For the best experience, try using this feature with battle royale shooting games.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏧᎾᏁᎸᏙᏗ ᏰᎵᏉ ᎥᏝ ᎣᏍᏓ ᏱᏗᎬᏙᎩ ᎬᏗ ᏃᏌᏅ ᎤᏃᏴᎵᏓ ᏓᏨᏍᏛ. ᎾᏍᎩᎾ ᏫᏓᏤᏢ ᎠᎦᏙᎲᏒᎢ, ᎭᏁᎵᏓ ᏨᏙᏗᎢ ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎤᏠᏯᏍᏗ ᏚᎾᏟᏴᎲᎢ ᎤᏓᎵᎩ ᏗᏍᏓᏲᏍᏗ ᏧᎾᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn on Dark aware, the display will brighten to show more detail in dark scenes.">
                <langSet xml:lang="en-US"><tig><term>When you turn on Dark aware, the display will brighten to show more detail in dark scenes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎯᏍᏚᎢᏒ ᎤᎵᏏᎩ ᎯᎦᏔᎲ, ᎾᏍᎩ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎠᏎᎢ ᎤᏍᎪᏍᏓᎨᏍᏗ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎤᏟ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ ᎾᎿᎢ ᎤᎵᏏᎩ ᏗᎧᎾᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Uninstalled games">
                <langSet xml:lang="en-US"><tig><term>Uninstalled games</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏘᏅᏕᏍᏗ ᏧᎾᏁᎸᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When Gametime turns off, your game list no longer updates automatically and moments no longer sync. Do you want to turn off Gametime?">
                <langSet xml:lang="en-US"><tig><term>When Gametime turns off, your game list no longer updates automatically and moments no longer sync. Do you want to turn off Gametime?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏗᏁᎸᏙᏗ ᎠᏓᎢᎵᏒ ᎠᎵᏍᏚᏅᎢ, ᏣᏤᏨ ᏗᏁᎸᏙᏗ ᏕᎦᏅᏛᎢ Ꮭ ᏃᏊ ᏱᏗᎪᏢᎯᏐᏗ ᎤᏩᏌ ᎠᎴ ᏂᏕᎦᎵᏍᏗᏍᎬᎢ Ꮭ ᏃᏊ ᎢᏧᎳᎭ ᏱᏂᎦᎵᏍᏗᏍᎨᏍᏗ. ᏣᏚᎵᏍᎪᏃ ᎠᏍᏚᏗ ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure to cancel the incoming transfer?">
                <langSet xml:lang="en-US"><tig><term>Are you sure to cancel the incoming transfer?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏒᎢ ᏂᎯ ᎤᏙᎯᏳ ᎠᏎᏒᏗ ᎦᎷᎦ ᎠᎲᏍᎬᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Play a better way">
                <langSet xml:lang="en-US"><tig><term>Play a better way</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᏁᎶᎲᎦ ᎾᏍᎩ ᏓᏤᏢᎩ ᏳᎵᏍᏙᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ok">
                <langSet xml:lang="en-US"><tig><term>Ok</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Play">
                <langSet xml:lang="en-US"><tig><term>Play</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᏁᎶᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Complete communication of basic radio services between the upper and lower layers of the Android system.">
                <langSet xml:lang="en-US"><tig><term>Complete communication of basic radio services between the upper and lower layers of the Android system.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᎵᎢ ᎠᏓᏛᎪᏙᏗ  ᎾᎿ ᎠᎯᏓ ᎦᏬᏂᏍᎩ ᎢᏳᎾᏓᏛᏁᏗ ᎤᏜᏅᏛ ᎦᎸᎳᏗᏢ ᎠᎴ ᎡᎳᏗᏢ ᏗᏰᎦᏟ ᎾᎿ Android ᏄᏍᏗᏓᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Start and maintain all system services in the Android framework layer.">
                <langSet xml:lang="en-US"><tig><term>Start and maintain all system services in the Android framework layer.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᎾ ᎠᎴ ᏂᎬᏩᏍᏗ ᏂᎦᏓ ᏄᏍᏗᏓᏅᎢ ᎢᏳᎾᏓᏛᏁᏗ ᎾᎿ Android ᎦᏘᏅᏛᏙᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᏰᎦᏟ.</term></tig></langSet>
            </termEntry>
            <termEntry id="An input method editor, enable users to enter text.">
                <langSet xml:lang="en-US"><tig><term>An input method editor, enable users to enter text.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏛᏴᎯ ᎢᏗᎬᏁᏗ ᎣᏍᏓ ᏗᎦᎧᎲᏍᎩ, ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᏗᏅᏗᏍᎩ ᎡᎵᏍᏗ ᏱᏩᏅᏓ ᎾᎿ ᎥᎧᏁᏉᏍᎬᎢ ᎠᎪᎵᏰᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically load contacts from Sim card into phone contacts.">
                <langSet xml:lang="en-US"><tig><term>Automatically load contacts from Sim card into phone contacts.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎯᏢᎦ ᏗᏟᏃᎮᏙᏗ ᎾᏍᎩᎾ Sim ᏆᎾᏲᏍᏗ ᎾᎿᎢ ᏗᎳᏃᎮᏗ ᏗᏟᏃᎮᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Implement IMS function, notify modem of user's switch such as VoLTE\/ViLTE, or report the result of IMS network registration to app.">
                <langSet xml:lang="en-US"><tig><term>Implement IMS function, notify modem of user's switch such as VoLTE\/ViLTE, or report the result of IMS network registration to app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ IMS ᏧᎸᏫᏍᏓᏁᏗᏱ, ᎠᏓᏃᎯᏎᏗ ᎼᏕᎻ ᎾᎿ ᏗᏅᏗᏍᎩ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩᏯ ᎢᏳᏍᏗ VoLTE\/ViLTE, ᎠᎴ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏄᎵᏍᏔᏅ ᎾᎿ IMS ᏧᎾᏚᏓᎵ ᎨᎪᏪᎳᏅᎯ ᎾᎿᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mediatek implement IMS function, notify modem of user's switch such as VoLTE\/ViLTE, or report the result of IMS network registration to app.">
                <langSet xml:lang="en-US"><tig><term>Mediatek implement IMS function, notify modem of user's switch such as VoLTE\/ViLTE, or report the result of IMS network registration to app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Mediatek ᎬᏔᏂᏓᏍᏗ IMS ᏧᎸᏫᏍᏓᏁᏗᏱ, ᎠᏓᏃᎯᏎᏗ ᎼᏕᎻ ᎾᎿ ᏗᏅᏗᏍᎩ ᎦᏁᏟᏴᏍᏗ ᎾᏍᎩᏯ ᎢᏳᏍᏗ VoLTE\/ViLTE, ᎠᎴ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏄᎵᏍᏔᏅ ᎾᎿ IMS ᏧᎾᏚᏓᎵ ᎨᎪᏪᎳᏅᎯ ᎾᎿᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It is download provider.">
                <langSet xml:lang="en-US"><tig><term>It is download provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏓᎪᏘ ᎦᏢᏍᎬᎢ ᎠᏓᏁᏢᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Authenticate some supplementary services in IMS, such as call forwarding.">
                <langSet xml:lang="en-US"><tig><term>Authenticate some supplementary services in IMS, such as call forwarding.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏙᏟᏍᏔᏅ ᎢᎦᏓ ᎤᎶᏒᏍᏔᏅ ᎢᏳᎾᏓᏛᏁᏗ ᎾᎿ IMS, ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᏪᏯᎾ ᏫᎦᏅᎥᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Baidu network location provider service, NLP developed by Baidu.">
                <langSet xml:lang="en-US"><tig><term>Baidu network location provider service, NLP developed by Baidu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Baidu ᏧᎾᏚᏓᎵ ᎤᎿ ᎢᎬᎾᏕᎾ ᎠᏓᏁᏢᏍᎩ ᎢᏯᏓᏛᏁᏗ, NLP ᎤᏙᎷᏩᏛᎲᎩ ᎬᏗ Baidu.</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart SD card">
                <langSet xml:lang="en-US"><tig><term>Smart SD card</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᏑᏗ SD ᏆᎾᏲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="It supports local HTTP Proxy with PAC function.">
                <langSet xml:lang="en-US"><tig><term>It supports local HTTP Proxy with PAC function.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎦᎫᏍᏛᏓ ᎡᏍᎦᏂ HTTP Proxy ᎬᏗ PAC ᏧᎸᏫᏍᏓᏁᏗᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Provide the function of obtaining IP and distributing IP for WIFI.">
                <langSet xml:lang="en-US"><tig><term>Provide the function of obtaining IP and distributing IP for WIFI.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᎳᏁᏗ ᏧᎸᏫᏍᏓᏁᏗᏱ ᎾᎿ ᎣᏤᎵ ᎾᎬᏁᎲ IP ᎠᎴ ᎠᏯᏙᏍᏗ IP ᎾᏍᎩᎾ WIFI.</term></tig></langSet>
            </termEntry>
            <termEntry id="Embedded SE">
                <langSet xml:lang="en-US"><tig><term>Embedded SE</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏄᏴᏗ SE</term></tig></langSet>
            </termEntry>
            <termEntry id="Provides access to Near Field Communication functionality, allowing applications to read NDEF message in NFC tags.">
                <langSet xml:lang="en-US"><tig><term>Provides access to Near Field Communication functionality, allowing applications to read NDEF message in NFC tags.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎾᏓᏁᏢᏍᎬ ᎬᏴᏍᏗ ᎾᎿᎢ Near Field Communication ᏧᏂᎸᏫᏍᏓᏁᏗᏱ, ᎥᎵᏍᎪᎸᏓᏁᎲ ᏗᏔᏲᏍᏙᏗ ᏗᎪᏪᎵ ᎾᎿᎢ ᎠᎪᎵᏰᏗ NDEF ᎠᎪᎵᏰᏗ ᎾᎿ NFC tags.</term></tig></langSet>
            </termEntry>
            <termEntry id="Emuate as a NFC card and transfer data from device to device by NFC.">
                <langSet xml:lang="en-US"><tig><term>Emuate as a NFC card and transfer data from device to device by NFC.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵᏍᎩ ᎯᎢᎾᎢ NFC ᏆᎾᏲᏍᏗ ᎠᎴ ᎠᎲᏍᎬᎢ ᎦᏟᏌᏅᎯ ᎾᏍᎩᎾ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ NFC.</term></tig></langSet>
            </termEntry>
            <termEntry id="Needed when browser request to download any file.">
                <langSet xml:lang="en-US"><tig><term>Needed when browser request to download any file.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏚᎸᏛ ᎢᏳᏃ ᎠᏍᏚᎢᏍᎩ ᎠᏔᏲᏢ ᎾᎿᎢ ᎡᎳᏓᎪᏘ ᎦᏢᏍᎬᎢ ᏂᎦᎥ ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show web view.">
                <langSet xml:lang="en-US"><tig><term>Show web view.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᏂᎳᏛᎢ ᎠᎪᎵᏰᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Scan bluetooth devices, connect bluetooth devices, manage data transmission between bluetooth devices.">
                <langSet xml:lang="en-US"><tig><term>Scan bluetooth devices, connect bluetooth devices, manage data transmission between bluetooth devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ, ᎫᏓᎸᎢ bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ, ᎠᏱᎸᏍᏗ ᎦᏟᏌᏅᎯ ᎤᏠᏒᎩ ᎠᏰᏟ bluetooth ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch to view detail settings">
                <langSet xml:lang="en-US"><tig><term>Touch to view detail settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎾᎿᎢ ᎠᎪᎵᏰᏗ ᏚᏍᏗᎬᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cancel Transfer">
                <langSet xml:lang="en-US"><tig><term>Cancel Transfer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏒᏗ ᎠᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This operation cannot be done during Wireless Display">
                <langSet xml:lang="en-US"><tig><term>This operation cannot be done during Wireless Display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᎢᏒᎢ Ꮭ ᏰᎵ ᎨᏒᎩ ᎠᏍᏆᏗᏍᏗ ᎾᎯᏳ ᏂᏓᏏᎳᏛ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This operation cannot be done during Cast Screen">
                <langSet xml:lang="en-US"><tig><term>This operation cannot be done during Cast Screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎢᏒᎢ Ꮭ ᏰᎵ ᎨᏒᎩ ᎠᏍᏆᏗᏍᏗ ᎾᎯᏳ ᏩᏗᏅᏗ ᎠᏰᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You are trying to connect to:">
                <langSet xml:lang="en-US"><tig><term>You are trying to connect to:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏒᎢ ᎠᏁᏟᏗᎭ ᎾᎿᎢ ᎫᏓᎸᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="You have already connected with ">
                <langSet xml:lang="en-US"><tig><term>You have already connected with </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᎦᏳᎳ ᎫᏓᎸᏅᎯ ᎬᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="Not available due to Wi-Fi hotspot is enabled.">
                <langSet xml:lang="en-US"><tig><term>Not available due to Wi-Fi hotspot is enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ Wi-Fi hotspot ᎠᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Android Beam requires NFC P2P Mode to be enabled.">
                <langSet xml:lang="en-US"><tig><term>Android Beam requires NFC P2P Mode to be enabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Android Beam ᎠᏎᏱᏗᏛᏗ NFC P2P Mode ᎾᎿᎢ ᎠᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Charging voltage is too high!">
                <langSet xml:lang="en-US"><tig><term>Charging voltage is too high!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎬᏩᎶᏗᏍᎬᎢ ᎤᏍᎦᏍᏓᏁᎸ ᎾᏍᏉ ᎦᎸᎳᏗ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to enable P2P Mode?">
                <langSet xml:lang="en-US"><tig><term>Do you want to enable P2P Mode?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎡᎵᏊ ᏱᎬᏛᏁᏗ P2P Mode?</term></tig></langSet>
            </termEntry>
            <termEntry id="Fingerprint verification failed, please try again after  seconds or use other ways to unlock.">
                <langSet xml:lang="en-US"><tig><term>Fingerprint verification failed, please try again after  seconds or use other ways to unlock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎯᏳᏗᏍᎩ ᎠᏓᏄᎸᎲᎩ, ᎰᏩᏊ ᏏᏊ ᏥᎭᏁᎵᏓ ᎤᎶᏐᏅ  ᏓᏓᎾᏩᏍᎬ ᎠᎴ ᎬᏙᏗ ᏐᎢ ᏱᏗᎬᏁᏗ ᎾᎿᎢ ᎤᏂᏐᎭᎾᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please unlock manually.">
                <langSet xml:lang="en-US"><tig><term>Please unlock manually.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎤᏂᏐᎭᎾᎸᏗ ᎣᏩᏌ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera device is occupied, please enter password">
                <langSet xml:lang="en-US"><tig><term>Camera device is occupied, please enter password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏟᎶᏍᏗᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏂᎳᏛ, ᎰᏩᏊ ᎥᎧᏁᏉᏍᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face verification failed, please try again after  seconds or use other ways to unlock.">
                <langSet xml:lang="en-US"><tig><term>Face verification failed, please try again after  seconds or use other ways to unlock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎧᏛ ᎪᎯᏳᏗᏍᎩ ᎠᏓᏄᎸᎲᎩ, ᎰᏩᏊ ᏏᏊ ᏥᎭᏁᎵᏓ ᎤᎶᏐᏅ  ᏓᏓᎾᏩᏍᎬ ᎠᎴ ᎬᏙᏗ ᏐᎢ ᏱᏗᎬᏁᏗ ᎾᎿᎢ ᎤᏂᏐᎭᎾᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please use your pattern/pin/pasword to make active face unlock again">
                <langSet xml:lang="en-US"><tig><term>Please use your pattern/pin/pasword to make active face unlock again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎬᏙᏗ ᏣᏤᎵ ᎤᎾᎶᎢᏓ/ᎦᎭᏛᏗ/ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎪᏢᏗ ᎠᎵᏖᎸᎲᏍᎩ ᎤᎧᏛ ᎤᏂᏐᎭᎾᎸᏗ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="No major unlocking mode has been used for 72 hours.">
                <langSet xml:lang="en-US"><tig><term>No major unlocking mode has been used for 72 hours.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏄᎬᏫᏳᏒ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎬᏙᏗ ᏂᎦᎵᏍᏓ ᎬᏔᏅᎯ ᎾᏍᎩᎾ 72 ᎢᏧᏟᎶᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Incorrect SIM PIN code you must now contact your carrier to unlock your device.">
                <langSet xml:lang="en-US"><tig><term>Incorrect SIM PIN code you must now contact your carrier to unlock your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᏳᎪᏛᎾ SIM PIN ᎠᏍᏓᏩᏛᏍᏙᏗ, ᏂᎯ ᎤᎭ ᏂᎯ ᎠᏎ ᎠᏟᏃᎮᏙᏗ ᎤᎬᏩᏟ ᎠᏫᏗᏍᎩ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Input 8 digits.">
                <langSet xml:lang="en-US"><tig><term>Input 8 digits.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏛᏴᎯ 8 ᏗᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Remains:">
                <langSet xml:lang="en-US"><tig><term>Remains:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏚᎷᎴᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter SIM ME lock">
                <langSet xml:lang="en-US"><tig><term>Enter SIM ME lock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ SIM ME ᏍᏓᏯ ᎠᏍᏚᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Entering incorrect PUK code more than 10 times,SIM card has been permanently locked.">
                <langSet xml:lang="en-US"><tig><term>Entering incorrect PUK code more than 10 times,SIM card has been permanently locked.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏴᎯᎲ ᏂᏚᏳᎪᏛᎾ PUK ᎠᏍᏓᏩᏛᏍᏙᏗ ᎤᏟ ᎢᎦᎢ ᎡᏍᎦᏉ 10 ᏓᏟᎢᎵᏒ,SIM ᏆᎾᏲᏍᏗ ᏂᎦᎵᏍᏓ ᎬᏩᎦᏘ ᏍᏓᏯ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The slot has been permanently locked">
                <langSet xml:lang="en-US"><tig><term>The slot has been permanently locked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏜᏅᏛ ᏂᎦᎵᏍᏓ ᎬᏩᎦᏘ ᏍᏓᏯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM card is unplugged.">
                <langSet xml:lang="en-US"><tig><term>SIM card is unplugged.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᏆᎾᏲᏍᏗ ᎫᏓᎴᏍᎪ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please make sure your SIM card is properly plugged in.">
                <langSet xml:lang="en-US"><tig><term>Please make sure your SIM card is properly plugged in.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ SIM ᏆᎾᏲᏍᏗ ᏄᏍᏛ ᏗᏙᎳᏤᎩ ᎧᏁᏉᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="They are labeled as">
                <langSet xml:lang="en-US"><tig><term>They are labeled as</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏛ ᏗᎦᏯᎸᏗ ᎯᎢᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM card swapped.">
                <langSet xml:lang="en-US"><tig><term>SIM card swapped.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᏆᎾᏲᏍᏗ ᎦᏁᏟᏴᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Input 4-8 digits.">
                <langSet xml:lang="en-US"><tig><term>Input 4-8 digits.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏛᏴᎯ 4-8 ᏗᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now default settings are:">
                <langSet xml:lang="en-US"><tig><term>Now default settings are:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ ᎨᏒᎢ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Wrong Code.">
                <langSet xml:lang="en-US"><tig><term>Wrong Code.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎵᏓᏍᏔᏅᎯ ᎠᏍᏓᏩᏛᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The UIM/SIM card is not recognized.">
                <langSet xml:lang="en-US"><tig><term>The UIM/SIM card is not recognized.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ UIM/SIM ᏆᎾᏲᏍᏗ ᎥᏝ ᎤᏬᎳᏨᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter the Privacy Protection password to unlock.">
                <langSet xml:lang="en-US"><tig><term>Please enter the Privacy Protection password to unlock.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎥᎧᏁᏉᏍᎬᎢ ᎠᏗᏍᎦᎸᏗᎢ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎤᏂᏐᎭᎾᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="All unsaved data in owner account will be lost or damaged.">
                <langSet xml:lang="en-US"><tig><term>All unsaved data in owner account will be lost or damaged.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᎥᏝ ᎠᎵᏏᏅᏔᏅᎢ  ᎦᏟᏌᏅᎯ ᎾᎿᎢ ᎤᏤᎵᎢ ᎠᏚᏓᎸᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏂᏲᎱᏎᎸ ᎠᎴ ᎠᏲᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Slot :\u0020">
                <langSet xml:lang="en-US"><tig><term>Slot :\u0020</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏜᏅᏛ :\u0020</term></tig></langSet>
            </termEntry>
            <termEntry id="Still in long screen shot!">
                <langSet xml:lang="en-US"><tig><term>Still in long screen shot!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏉ ᎦᏅᎯᏓ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock successfully, you have to restart your phone">
                <langSet xml:lang="en-US"><tig><term>Unlock successfully, you have to restart your phone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᏐᎭᎾᎸᏗ ᎢᏳᎵᏍᏙᏗ ᏄᎵᏍᏔᏅᎩ, ᎤᎭ ᎾᎿᎢ ᏥᎭᏂᎩᏍᏓ ᏗᎳᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Password, Pattern or PIN is required when your device restarts!">
                <langSet xml:lang="en-US"><tig><term>Password, Pattern or PIN is required when your device restarts!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᏙᏗ, ᎤᎾᎶᎢᏓ ᎠᎴ PIN ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᏥᏂᎬᏅᏗᏓᎾ ᏥᎭᏂᎩᏍᏓ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Input 4-16 digits.">
                <langSet xml:lang="en-US"><tig><term>Input 4-16 digits.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏛᏴᎯ 4-16 ᏗᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Make the screen in Vertical direction!">
                <langSet xml:lang="en-US"><tig><term>Make the screen in Vertical direction!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏢᏗ ᎠᏰᏙᎳᏛᎢ ᎾᎿ ᎦᏙᎩ ᎤᏁᎭᎲᏍᎩ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch screen or press back key to end">
                <langSet xml:lang="en-US"><tig><term>Touch screen or press back key to end</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗᎢ ᎠᏰᏙᎳᏛᎢ ᎠᎴ ᎭᏐᏅᏍᏓ ᎠᏏᏁᎩ ᏍᏚᎢᏍᏗ ᎾᎿᎢ ᎠᏍᏆᏗᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Merging...">
                <langSet xml:lang="en-US"><tig><term>Merging...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏠᎯᏍᏛ...</term></tig></langSet>
            </termEntry>
            <termEntry id="Long screenshot is not supported in split screen mode">
                <langSet xml:lang="en-US"><tig><term>Long screenshot is not supported in split screen mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎯᏓ ᎠᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ ᎥᏝ ᎤᎵᏍᏕᎸᎲ ᎾᎿ ᏗᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="PIN required when camera is not available">
                <langSet xml:lang="en-US"><tig><term>PIN required when camera is not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PIN ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Password required when camera is not available">
                <langSet xml:lang="en-US"><tig><term>Password required when camera is not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Pattern required when camera is not available">
                <langSet xml:lang="en-US"><tig><term>Pattern required when camera is not available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎶᎢᏓ ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᏗᏓᏟᎶᏍᏗᏍᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="PIN required when face information is not available, please re-setup face unlock">
                <langSet xml:lang="en-US"><tig><term>PIN required when face information is not available, please re-setup face unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PIN ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ, ᎰᏩᏊ ᎦᎧᎲᏍᎬᎢ ᎤᎧᏛ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Password required when face information is not available, please re-setup face unlock">
                <langSet xml:lang="en-US"><tig><term>Password required when face information is not available, please re-setup face unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ, ᎰᏩᏊ ᎦᎧᎲᏍᎬᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Pattern required when face information is not available, please re-setup face unlock">
                <langSet xml:lang="en-US"><tig><term>Pattern required when face information is not available, please re-setup face unlock</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎶᎢᏓ ᎢᏯᏛᏁᏗ ᎢᏳᏃ ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ, ᎰᏩᏊ ᎦᎧᎲᏍᎬᎢ ᎤᎧᏛ ᎠᏂᏐᎭᎾᎳᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can't use 4G when the phone is in airplane mode.">
                <langSet xml:lang="en-US"><tig><term>You can't use 4G when the phone is in airplane mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎬᏙᏗ 4G ᎢᏳᏃ ᏗᎳᏃᎮᏗ ᎾᎿ ᏥᏳ ᏄᏍᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can't switch 4G service during the call.">
                <langSet xml:lang="en-US"><tig><term>You can't switch 4G service during the call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎦᏁᏟᏴᏍᏗ 4G ᎢᏯᏓᏛᏁᏗ ᎾᎯᏳ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Vowifi off">
                <langSet xml:lang="en-US"><tig><term>Vowifi off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Vowifi ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency Calls only available in Cellular Coverage">
                <langSet xml:lang="en-US"><tig><term>Emergency Calls only available in Cellular Coverage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏓᏯᏂ ᎤᏩᏌ ᎠᏛᏅᎢᏍᏔᏅ ᎾᎿ ᏫᏚᏍᏗᎬᎢ ᏣᏚᏓᎸᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can't switch VoWiFi service during the call.">
                <langSet xml:lang="en-US"><tig><term>You can't switch VoWiFi service during the call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏰᎵ ᎦᏁᏟᏴᏍᏗ VoWiFi ᎢᏯᏓᏛᏁᏗ ᎾᎯᏳ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In order to ensure the call quality, the  mode will be open synchronously.">
                <langSet xml:lang="en-US"><tig><term>In order to ensure the call quality, the  mode will be open synchronously.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᎵ ᎾᎿ ᎠᏚᎢᏍᏔᏅ ᏪᏯᎾ ᎢᏲᏍᏓ, ᏥᎩ  ᎬᏙᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎯᏍᏚᎢ ᎢᏧᎳᎭ ᏧᎸᏫᏍᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to continue WiFi-Calling service or disable Wi-Fi calling?">
                <langSet xml:lang="en-US"><tig><term>Do you want to continue WiFi-Calling service or disable Wi-Fi calling?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿ ᎬᎵᏱᎵᏒ WiFi-ᏓᏯᏂᏍᎬ ᎢᏯᏓᏛᏁᏗ ᎠᎴ ᎠᎴᏫᏍᏙᏓ Wi-Fi ᏓᏯᏂᏍᎬ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter SIM  PIN, you have  remaining attempt before you must contact your carrier to unlock your device.">
                <langSet xml:lang="en-US"><tig><term>Enter SIM  PIN, you have  remaining attempt before you must contact your carrier to unlock your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎧᏁᏉᏍᎬᎢ SIM  PIN, ᏂᎯ ᎤᎭ  ᎠᎾᏕᎯᏯᏍᎬᎢ ᎤᏁᎸᏙᏗ ᎤᏓᎷᎸ ᏂᎯ ᎠᏎ ᎠᏟᏃᎮᏙᏗ ᎤᎬᏩᏟ ᎠᏫᏗᏍᎩ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Incorrect SIM  PUK code, remaining times().">
                <langSet xml:lang="en-US"><tig><term>Incorrect SIM  PUK code, remaining times().</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᏳᎪᏛᎾ SIM  PUK ᎤᏕᎵᏓ ᎦᏬᏂᎯᏍᏓ, ᎠᎾᏕᎯᏯᏍᎬᎢ ᏓᏟᎢᎵᏒ().</term></tig></langSet>
            </termEntry>
            <termEntry id="Some applications of this device require data connection which may involve some cost.">
                <langSet xml:lang="en-US"><tig><term>Some applications of this device require data connection which may involve some cost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᏔᏲᏍᏙᏗ ᏗᎪᏪᎵ ᎾᎿ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᏯᏛᏁᏗ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ ᏰᎵᏉ ᎠᏓᏠᏯᏍᏙᏗ ᎢᎦᏓ ᏧᎬᏩᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We suggest that you open data connection.">
                <langSet xml:lang="en-US"><tig><term>We suggest that you open data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎧᏁᎢᏍᏙᏗ ᎯᏍᏚᎢ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Internet package">
                <langSet xml:lang="en-US"><tig><term>Internet package</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏏᎳᏕᏫᏒᎢ ᎦᏇᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some applications of this device require data connection which may involve some cost.">
                <langSet xml:lang="en-US"><tig><term>Some applications of this device require data connection which may involve some cost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᏔᏲᏍᏙᏗ ᏗᎪᏪᎵ ᎾᎿ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᏯᏛᏁᏗ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ ᏰᎵᏉ ᎠᏓᏠᏯᏍᏙᏗ ᎢᎦᏓ ᏧᎬᏩᎶᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We suggest that you order an Internet package.">
                <langSet xml:lang="en-US"><tig><term>We suggest that you order an Internet package.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎧᏁᎢᏍᏙᏗ ᏂᎯ ᎠᏓᏅᏍᏗ ᎠᏏᎳᏕᏫᏒᎢ ᎦᏇᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ultra saving mode">
                <langSet xml:lang="en-US"><tig><term>Ultra saving mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏒᏍᏔᏅ ᎠᎵᏏᏅᏙᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Contact with your operator for details.">
                <langSet xml:lang="en-US"><tig><term>Contact with your operator for details.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᏃᎮᏙᏗ ᎠᎯᎵᏙᎯ ᎾᏍᎩᎾ ᏧᏍᏗᎩᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Service Provider locked">
                <langSet xml:lang="en-US"><tig><term>Service Provider locked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎩ ᏍᏓᏯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Corprorate locked">
                <langSet xml:lang="en-US"><tig><term>Corprorate locked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᎵᎪᏒᎯ ᏍᏓᏯ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Service Provider PUK locked">
