            <termEntry id="To take a photo, give access to Camera">
                <langSet xml:lang="en-US"><tig><term>To take a photo, give access to Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎩᏍᏗ ᏗᏟᎶᏍᏔᏅ, ᏧᏁᏗᏱ ᎠᏴᏍᏗ ᎾᎿᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime doesn't control how third party apps appear in freeform mode.">
                <langSet xml:lang="en-US"><tig><term>Gametime doesn't control how third party apps appear in freeform mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏝᏍᏓ ᎠᎯᎸᏍᏗ ᏰᎵ ᏦᎢᏁ ᎾᏓᏟᏌᎲ ᏗᎬᏙᏗ ᎦᎾᏄᎪᎦ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn't report number">
                <langSet xml:lang="en-US"><tig><term>Couldn't report number</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎠᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="B negative">
                <langSet xml:lang="en-US"><tig><term>B negative</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>B, ᏗᎦᏘᎴᎩ ᎣᏍᏛ ᎧᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Preferred brightness is very low">
