                <langSet xml:lang="chr"><tig><term>ᏨᏌ ᎠᎯᏓ ᎿᏓᏛᏂᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="Limit charging when your device has been plugged in continuously for 3 days">
                <langSet xml:lang="en-US"><tig><term>Limit charging when your device has been plugged in continuously for 3 days</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᎸᎯ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎢᏳᏃ ᏥᏂᎬᏅᏗᏓᎾ ᏂᎦᎵᏍᏓ ᎤᏊᏄᎾᏘ ᎾᎿ ᏫᎬᎵᏱᎵᏒᏊ ᎤᎬᏩᏟ 3 ᏧᏒᎯᏓ</term></tig></langSet>
