            </termEntry>
            <termEntry id="Some apps might restrict secure content playback on secondary display.">
                <langSet xml:lang="en-US"><tig><term>Some apps might restrict secure content playback on secondary display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᎬᏙᏗ ᎡᎵᏊ ᏯᏓᏍᏚᎲᏏ ᎦᎸᏛᎢ ᏔᎵᏁ ᏥᏙᎭᏁᎶᏓ ᎤᎾᎢ ᏔᎵᏁᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't forget to adjust your monitor or TV settings for an optimal viewing experience.">
                <langSet xml:lang="en-US"><tig><term>Don't forget to adjust your monitor or TV settings for an optimal viewing experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏥᏨᏰᏫᏍᏌ ᎾᎢ ᎣᏍᏛ ᎢᎬᏁᏗ ᏣᏤᎵ ᎤᎦᏎᏍᏗᏕᎩ ᎠᎴᏃ ᎠᏓᏴᎳᏛᏍᎩ ᏕᎦᎧᎯᎢ ᎾᏍᎩᎾ ᏫᏓᏤᏢᎢ ᎥᎪᏩᏘᏍᎬᎢ ᎠᎦᏙᎲᏒᎢ. </term></tig></langSet>
            </termEntry>
            <termEntry id="Make the items on your screen smaller or larger">
                <langSet xml:lang="en-US"><tig><term>Make the items on your screen smaller or larger</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏧᏤᎵᏛ ᏗᎪᏪᎵ ᎤᎾᎢ ᏣᏤᎵ ᎠᏴᏙᎳᏛᎢ ᎠᏲᎵᎨᎢ ᎠᎴᏃ ᎡᏉᎯᎨᏍᏗ ᏂᏛᎦ</term></tig></langSet>
