                <langSet xml:lang="chr"><tig><term>ᎡᎷᏪᎢ Ꭰ ᎦᎷᎦ ᏪᏴᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Return to full screen">
                <langSet xml:lang="en-US"><tig><term>Return to full screen</term></tig></langSet>
