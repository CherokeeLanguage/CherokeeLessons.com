            <termEntry id="Automatically download &amp; install security updates and bug fixes over Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>Automatically download &amp; install security updates and bug fixes over Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎡᎳᏗᏣᎦᎸᏍᎬᎢ ᏃᎴ ᏕᎦᏘᏅᏛᎦ ᎤᎦᏎᏍᏗ ᏙᏢᎯᏌ ᏃᎴ ᏍᎪᏯ ᎣᏍᏓ ᏱᎬᏁᎯ Ꮎ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="Insert the SIM card into the tray. Then, insert the tray with the metal contacts facing away from the screen.">
                <langSet xml:lang="en-US"><tig><term>Insert the SIM card into the tray. Then, insert the tray with the metal contacts facing away from the screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏣᎸᏗ ᎾᏍᎩ SIM ᏆᎾᏲᏍᏗ ᎾᎿᎢ ᎾᏍᎩ ᎠᏝᏅᏙᏗ. ᎿᏉᏃ, ᎰᏣᎸᎥᎦ ᎾᏍᎩ ᎠᏝᏅᏙᏗ ᎤᏐᏯᏍᏗ ᎾᏍᎩ ᏔᎷᎩᏍᎩ ᏚᏓᏂᏰᎲᎢ ᏫᏥᎢᏊᏛ ᏂᏛᏓᎴᏂᏍᎩ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you don't opt-in, you won't hear about software updates, new products or exclusive offers">
                <langSet xml:lang="en-US"><tig><term>If you don't opt-in, you won't hear about software updates, new products or exclusive offers</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏣᏚᎵᎲᎾ ᎨᏎᏍᏗ ᏱᏣᏁᏕᏍᏗ, ᎨᏍᏗ ᏱᎨᏣᏃᏎᎮᏍᏗ ᏩᏁᎩ ᎦᎾᏗᏅᏗ, ᎢᏤ ᎦᎾᏗᏅᏗ ᎠᎴ ᎤᏂᏍᎪᎸᏛᎢ</term></tig></langSet>
            </termEntry>
