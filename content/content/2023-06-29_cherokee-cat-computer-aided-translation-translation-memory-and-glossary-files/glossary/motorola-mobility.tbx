            </termEntry>
            <termEntry id="Reboot now">
                <langSet xml:lang="en-US"><tig><term>Reboot now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎵᏍᏛ ᎢᎠᏂᎩᏍᏙᏗ ᏃᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Messaging app has changed.">
                <langSet xml:lang="en-US"><tig><term>Your Messaging app has changed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏣᏤᎵ ᏕᏂᏃᏣᎵᏍᎬ ᎬᏙᏗ ᎦᏁᏟᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show your palm to take a selfie">
                <langSet xml:lang="en-US"><tig><term>Show your palm to take a selfie</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᏣᏤᎵ ᎤᏬᎭᏛ ᎾᎢ ᎠᎩᏍᏗ ᎣᏩᏒ ᏗᏓᏟᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: The file size will be 4-5 times larger than the standard JPG format.">
                <langSet xml:lang="en-US"><tig><term>Note: The file size will be 4-5 times larger than the standard JPG format.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{ᎤᏍᏗ ᎪᏪᎸ: ᎾᏍᎩ ᎠᏍᏆᏂᎪᏙᏗ ᎢᎩᏓ ᏰᎵᏉ ᎨᏎᏍᏗ 4-5 ᎢᏳᏩᎩᏗ ᎡᏑᎯ ᏏᏃ ᎾᏍᎩ ᎢᎬᏩᏍᏗᎭ JPG ᏱᎬᏁᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enable Bluetooth before retry sending">
                <langSet xml:lang="en-US"><tig><term>Please enable Bluetooth before retry sending</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎡᎵᏊ ᏱᎬᏛᏁᏗ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎤᏓᎷᎸ ᎠᏁᎸᏙᏗ ᏫᎦᏅᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Play Protect warning">
                <langSet xml:lang="en-US"><tig><term>Play Protect warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎾᏛᏁᎸᏗ ᎠᎦᏎᏍᏙᏗ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please reboot your device to ensure all features work correctly.">
                <langSet xml:lang="en-US"><tig><term>Please reboot your device to ensure all features work correctly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏄᎵᏍᏛ ᎢᎠᏂᎩᏍᏙᏗ ᏂᎯᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏦᎯᏳᏙᏗᏊ ᏂᎦᏓ ᎢᏧᏓᎴᎩ ᏚᏳᎪᏛᏊ ᏱᏚᎸᏫᏍᏓᏁ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Landscape stereo">
                <langSet xml:lang="en-US"><tig><term>Landscape stereo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏅᎯᏒᎢ ᏗᎦᏃᎩᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dolby Audio is loading user data…">
                <langSet xml:lang="en-US"><tig><term>Dolby Audio is loading user data…</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏃᏴᎬ ᏂᏗᎦᎵᏍᏗᏍᎩ ᎦᏢᏍᎦ ᎬᏗᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ…</term></tig></langSet>
