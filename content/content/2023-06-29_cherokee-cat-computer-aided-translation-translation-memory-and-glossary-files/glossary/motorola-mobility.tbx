            </termEntry>
            <termEntry id="Warn about imminent safety threats">
                <langSet xml:lang="en-US"><tig><term>Warn about imminent safety threats</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲᏨᎯ ᎢᎸᏨ ᎦᏃᏴᏘᏍᏙᏗ ᎤᎾᏓᎵᏏᏅᏙᏗ ᏗᎧᏃᎮᏢᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Spectrum Connectivity Services">
                <langSet xml:lang="en-US"><tig><term>Spectrum Connectivity Services</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Spectrum ᏗᎫᏓᎸᏗᎢ ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected, not charging">
