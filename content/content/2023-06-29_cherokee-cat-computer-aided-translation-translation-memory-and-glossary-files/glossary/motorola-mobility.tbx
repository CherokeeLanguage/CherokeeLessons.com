            <termEntry id="Application does not have External Storage Permission. This is required to Beam this file">
                <langSet xml:lang="en-US"><tig><term>Application does not have External Storage Permission. This is required to Beam this file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏲᏍᏙᏗ ᏞᏍᏗ ᏙᏯᏗᏜ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ. ᎯᎠ ᎠᏎᏯᏛᏁᏗ ᎾᎢ Beam ᎯᎠ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id=" (\u03BCm quad pixel,  output)">
                <langSet xml:lang="en-US"><tig><term> (\u03BCm quad pixel,  output)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> (\u03BCm ᎾᎩ ᎪᏢᏔᏅᎯ ᎤᏍᏗ ᏅᎩ ᏧᏅᏏᏯ,  ᎤᏅᎪᎢᏍᏙᏗ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Rear ">
                <langSet xml:lang="en-US"><tig><term>Rear </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂᏗᏨ </term></tig></langSet>
            </termEntry>
            <termEntry id="After you disable 2G, you will be unable to make emergency and non-emergency phone calls if you are in a location where only 2G is available. Do you wish to continue?">
                <langSet xml:lang="en-US"><tig><term>After you disable 2G, you will be unable to make emergency and non-emergency phone calls if you are in a location where only 2G is available. Do you wish to continue?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᏫᏍᏙᏛᎾ 2Ꮆ, Ꮭ ᎤᏟᏍᏗ ᏪᏯᎾ ᎠᎴ ᏐᎢ ᏗᏢᏃᎮᏓ Ꮎ ᏁᏙᎲᎾ ᏱᎩ Ꮎ 2Ꮆ ᎠᏛᏅᎢᏍᏔᏅ. ᏣᏚᎵᏍ ᎢᎦᏯᎢᏒᎢ? ᏣᏚᎵᏍ ᎢᎦᏯᎢᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="After unlocking, go to the Home screen or last used app">
                <langSet xml:lang="en-US"><tig><term>After unlocking, go to the Home screen or last used app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂᏗᏨ ᎤᏂᏐᎭᎾᎸᏗ, ᏤᏅᏍᏗ ᎣᏪᏅᏒ ᎠᏓᎾᏫᏓ ᏍᏓᏯ ᎠᏍᏚᎭ ᎠᏴᏙᎳᏛᎢ ᏃᎴ ᎣᏂ ᎬᏔᏅᎯ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Call via Wi-Fi">
                <langSet xml:lang="en-US"><tig><term>Call via Wi-Fi</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏯᎾ ᎾᎿ ᎢᏗᏨ Wi-Fi</term></tig></langSet>
            </termEntry>
            <termEntry id="You are connecting to the unsecured (open) Wi-Fi network .Information sent is not encrypted and may be visible to others. Do you still want to connect?">
                <langSet xml:lang="en-US"><tig><term>You are connecting to the unsecured (open) Wi-Fi network .Information sent is not encrypted and may be visible to others. Do you still want to connect?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎯᏚᏛᎸᎦ ᎤᏰᎯᏍᏛ (ᎯᏍᏚᎠ) Wi-Fi ᏑᎾᏚᏓᎵ .ᎧᏃᎮᏢᏗ ᎠᏓᏅᏒ Ꮭ ᎠᏕᎵᏍᏔᏅ ᏱᎩ ᎠᎴ ᎠᏂᏐᎢ ᏯᏂᎪᏩᏘ ᏏᎨ ᏣᏚᎵ ᏣᏚᏛᎸᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency calls are not possible via WiFi Calling.The device switches automatically to a cellular network (2G/3G) to place an emergency call.Emergency calls are only possible in areas with cellular coverage.">
                <langSet xml:lang="en-US"><tig><term>Emergency calls are not possible via WiFi Calling.The device switches automatically to a cellular network (2G/3G) to place an emergency call.Emergency calls are only possible in areas with cellular coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏗ ᏩᏴᏅᏗ ᎭᏗ ᏱᏅᎦᎵᏍᏓ Ꮎ WiFi ᏪᏯᎾ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏱᎬᏁᏟᏴᎾ ᎤᏩᏌ Ꮎ ᏕᎫᏓᎸ ᏧᎾᏚᏓᎵ (2G/3G) ᏱᏣᏚᎵ ᎤᏟᏍᏗ ᏪᏯᏁᏗ.ᎤᏟᏍᏗ ᎤᎵᏍᎨᏛ ᏪᏯᎾ ᎠᏎ ᎮᏙᎲ ᏕᎫᏓᎸ ᎫᏝᎢ ᎨᏎᏍᏗ. ᎤᏟᏍᏗ ᏪᏯᎾ ᎠᏎ ᎮᏙᎲ ᏕᎫᏓᎸ ᎫᏝᎢ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tips: Hold phone in natural way as you use normally. If you see bubbles shown on edge near your finger, that indicates touches there are detected by the phone. If you feel that is too sensitive, please set the level to medium">
                <langSet xml:lang="en-US"><tig><term>Tips: Hold phone in natural way as you use normally. If you see bubbles shown on edge near your finger, that indicates touches there are detected by the phone. If you feel that is too sensitive, please set the level to medium</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᎯᏎᎯ ᏗᏢᏃᎮᏗ  : ᏦᏰᏂ ᎬᏗ ᎯᏱᏙᎮᏍᏗ. ᏚᏆᎷᏓ ᏱᏘᎪᏩᏗ ᎠᏍᏛᎢ ᎾᎥ ᎯᏰᏒᏛ, ᎯᏒᏂᎲ ᎠᏕᎳᎰᏍᎦ ᏗᏢᏃᎮᏗ. ᎮᎵᏍᎬ ᎠᏒᏅᏍᏗᎢ ᎤᎪᏗ ᏱᎩ, ᎦᎧᎲᎢ ᎠᏰᎵᏇ ᎢᏯ ᎯᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't forget the edges">
                <langSet xml:lang="en-US"><tig><term>Don't forget the edges</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏥᏙᏨᎨᏫᏍᏌ ᎾᏍᎩ ᏓᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="PIN must be at least  digits and at most  digits.">
                <langSet xml:lang="en-US"><tig><term>PIN must be at least  digits and at most  digits.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>PIN ᎠᏎᎢ ᎦᏲᎵᎨ ᎠᏎᏍᏗ  ᏗᏎᏍᏗ ᎠᎴ ᎤᎿᎢ ᎤᎪᏗᏗ  ᏗᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Face Detection uses the front-facing camera to improve Auto-rotate accuracy. Images are never stored or sent to Google.">
                <langSet xml:lang="en-US"><tig><term>Face Detection uses the front-facing camera to improve Auto-rotate accuracy. Images are never stored or sent to Google.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎧᏛ ᎦᎾᏄᎪᏫᏍᏒᎢ ᏗᎬᏔᏂᏓᏍᏗ ᎾᏍᎩ ᎢᎬᏱᏗᏢ-ᏭᎦᏘ ᏗᏓᏟᎶᏍᏙᏗ ᎾᎢ ᎪᏢᎯᏐᏗ ᏚᏳᎪᏛ ᎤᏩᏌ-ᎠᏗᏆᎸᏕᏲᎯ. ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᏞᏍᏗ ᎢᎸᎯᏳᎢ ᎠᏍᏆᏂᎪᏔᏅ ᎠᎴᏃ ᏫᎦᏅᏅᎢ ᎾᎾᎢ Google.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set a work password">
                <langSet xml:lang="en-US"><tig><term>Set a work password</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏱᎦᏫᏍᏗ ᎥᎧᏁᎬᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎯᎧᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id=": about  used, as measured by your tablet. Your carrier\u2019s data usage accounting may differ.">
                <langSet xml:lang="en-US"><tig><term>: about  used, as measured by your tablet. Your carrier\u2019s data usage accounting may differ.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>: ᏄᏰᎵᏛ  ᎬᏔᏅᎯ, ᎠᏟᎶᏓ ᎬᏂ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ. ᏂᏨᏅᎢ ᎠᏂᎯᏙᎯ ᎦᏟᏌᏅᎯ ᎬᏗᏍᎬ ᏬᏂᎦᎵᏍᏗᏍᎬ ᎠᏕᎳ ᎧᏃᎮᏍᎩ ᏰᎵᏉ ᏚᏓᎴᎿᎥ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery level">
                <langSet xml:lang="en-US"><tig><term>Battery level</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᏟᎶᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use your face to unlock your phone or for authentication in apps, like when you sign in or approve a purchase.Keep in mind:You can only have one face set up at a time. To add another face, delete the current one.Looking at the phone can unlock it when you don\u2019t intend to.Your phone can be unlocked by someone else if it\u2019s held up to your face.Your phone can be unlocked by someone who looks a lot like you, like an identical sibling.">
                <langSet xml:lang="en-US"><tig><term>Use your face to unlock your phone or for authentication in apps, like when you sign in or approve a purchase.Keep in mind:You can only have one face set up at a time. To add another face, delete the current one.Looking at the phone can unlock it when you don\u2019t intend to.Your phone can be unlocked by someone else if it\u2019s held up to your face.Your phone can be unlocked by someone who looks a lot like you, like an identical sibling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎧᏛᎢ ᏨᏙᏓ ᏣᏐᎭᎾᎳᎩᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ ᎾᏍᎩᎾ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿᎢ ᏗᎬᏙᏗ, ᎤᏠᏱᏉ ᎾᎯᏳ ᏕᏣᏙᎥ ᏦᏪᎵᏍᎪᎢ ᎠᎴᏃ ᎪᎯᏳᏙᏗ Ꮎ ᎠᏩᎯᏍᏗ.ᎯᏍᏆᏂᎪᏓ ᎾᏍᎩ ᏣᏓᏅᏛᎢ:ᏂᎯ ᏰᎵᏯ ᎤᏅ ᏌᏇᏊ ᏭᎦᏛᎢ ᏣᎮᏍᏗ ᎦᎪᏗ ᎤᎿᎢ ᎠᏟᎢᎵᏒᎢ. ᎾᎢ ᎧᏁᏉᏍᏗ ᏄᏓᎴ ᏭᎦᏛᎢ, ᎠᏍᎪᎸᏗᏍᏗ ᎾᏍᎩ ᏃᏊᏥᎩ ᏌᏇᎢ.ᎠᎦᏖᏃᎲ ᎤᎿᎢ ᏥᎩ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᏱᏐᎭᎾᎳᎩ ᎾᏍᎩ ᎾᏳᎢ ᏂᎯ ᏞᏍᏗ\u2019 ᎾᏁᎵᏍᎬ ᎾᎢ.ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏰᎵᏊ ᎨᏒᎩ ᎤᏂᏐᎭᎾᎳᎩᏍᏗ ᎬᏗ ᎩᎶᎢ ᏄᏓᎴᎢ ᎥᎿᎢ ᎾᏍᎩ\u2019 ᎤᏌᎳᏓᏅ ᎤᎾᎢ ᏣᎧᏛᎢ.ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏰᎵᏯ ᎨᏒᎩ ᏯᏂᏐᎭᎾᎳᎩ ᎬᏗ ᎩᎶᎢ ᎾᏍᎩ ᎤᏠᏯ ᏤᏍᏓᎦᏅᏗᎢ, ᎾᏍᎩᏯᎢ ᎤᏠᏱᎨᎢᏍᏗ ᎢᏍᏓᏜᏅᏢᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Update available">
                <langSet xml:lang="en-US"><tig><term>Update available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏒᎯᏌᏅᎯ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Deactivate &amp; uninstall">
                <langSet xml:lang="en-US"><tig><term>Deactivate &amp; uninstall</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏔᏅᏱ &amp; ᎯᏘᏅᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Full background access">
                <langSet xml:lang="en-US"><tig><term>Full background access</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᎵᎢ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ ᎠᏴᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Smart Forwarding Enabled">
                <langSet xml:lang="en-US"><tig><term>Smart Forwarding Enabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ ᎠᎬᏱᏗᏜ ᎠᏂᎩᏍᏗᏍᎩ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Skip lock screen">
                <langSet xml:lang="en-US"><tig><term>Skip lock screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎾᏫᏓ ᏍᏓᏱ ᎠᏍᏚᏗ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="App compatibility changes can only be modified for debuggable apps. Install a debuggable app and try again.">
                <langSet xml:lang="en-US"><tig><term>App compatibility changes can only be modified for debuggable apps. Install a debuggable app and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᏗᏙᎸᎩ ᎨᏒ ᏗᎦᏁᏟᏴᏓ ᏰᎵᏯ ᎤᏅᏒ ᎨᎡᎩ ᎦᏁᏟᏴᏗ ᎤᎬᏩᏟ ᎯᏩᏔ ᎤᏍᏗᎦᎵᏓᏍᏛ ᏗᎬᏙᏗ. ᎯᏘᏅᏛᎦ Ꭰ ᎯᏩᏔ ᎤᏍᏗᎦᎵᏓᏍᏛ ᎬᏙᏗ ᎠᎴ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on now">
                <langSet xml:lang="en-US"><tig><term>Turn on now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎯᏍᏚᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="While docked">
                <langSet xml:lang="en-US"><tig><term>While docked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᎠᏔᎳᏗᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="smart, dim screen, sleep, battery, timeout, attention, display, screen, inactivity">
                <langSet xml:lang="en-US"><tig><term>smart, dim screen, sleep, battery, timeout, attention, display, screen, inactivity</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏌᎹᏗ, ᎤᏍᎪᎸᎢ ᎠᏴᏙᎳᏛᎢ, ᎦᎸᏗ, ᎠᎾᎦᎵᏍᎩ, ᎠᏲᏍᏙᏗ, ᎭᎦᏎᏍᏓ, ᎬᏂᎨᏒ ᎢᎬᏁᏗ, ᎠᏴᏙᎳᏛᎢ, ᎾᎵᏖᎸᎲᏍᎬᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Dark theme uses a black background to help keep battery alive longer on some screens. Dark theme schedules begin when your screen is off.">
                <langSet xml:lang="en-US"><tig><term>Dark theme uses a black background to help keep battery alive longer on some screens. Dark theme schedules begin when your screen is off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏏᎩ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᎬᏔᏂᏓᏍᏗ ᎬᎿᎨᎢ ᎣᎾᏗᏨ ᏄᏍᏗᏓᏅ ᎾᎿᎢ ᎠᎵᏍᏕᎸᏓ ᏣᎮᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎬᎿ ᎦᏅᎯᏓᎨ ᎤᎿᎢ ᎢᎦᏓ ᎠᏴᏙᎳᏛᎢ. ᎤᎵᏏᎩ ᎢᏳᏍᏗ ᎧᏃᎮᏗ ᏓᏒᏍᏛᎢ ᎠᏓᎴᏂᏍᎬ ᎢᏳᏃ ᎠᏴᏙᎳᏛᎢ ᏣᏤᎵ ᏣᏍᏚᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect at least  dots. Try again.">
                <langSet xml:lang="en-US"><tig><term>Connect at least  dots. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎤᎿᎢ ᎦᏲᎵ ᎨᏒ  ᎤᏓᏓᏢ. ᏏᏊ ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again">
                <langSet xml:lang="en-US"><tig><term>Try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Files received via Bluetooth">
                <langSet xml:lang="en-US"><tig><term>Files received via Bluetooth</term></tig></langSet>
