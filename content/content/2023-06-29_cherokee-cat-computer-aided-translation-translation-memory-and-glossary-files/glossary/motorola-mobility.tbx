            </termEntry>
            <termEntry id="- To scan the QR code, Ready For needs permission to access the Camera- To play audio on your PC, Ready For needs permission to record audio">
                <langSet xml:lang="en-US"><tig><term>- To scan the QR code, Ready For needs permission to access the Camera- To play audio on your PC, Ready For needs permission to record audio</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>- ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᏥᎩ QR ᎦᎵᏌᏅᎯ, Ready For ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᏴᏍᏗ ᏗᏓᏟᎶᏍᏗᏍᎩ- ᎾᎿᎢ ᏔᏁᎶᎲᎦ ᎤᏃᏴᎬ ᎤᎾᎿ ᏂᏨᎤᎢ PC, Ready For ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎤᏃᏴᎬ ᎦᏂᏴᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="English (US), Workman style">
                <langSet xml:lang="en-US"><tig><term>English (US), Workman style</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎩᎵᏏ (US), ᎠᏍᎦᏯ ᏧᎸᏫᏍᏓᏁᎯ ᏂᏚᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is required for some users or profiles and was uninstalled for others">
                <langSet xml:lang="en-US"><tig><term>This app is required for some users or profiles and was uninstalled for others</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎾᏍᎩ ᎠᏎᏯᏛᏁᏗ ᎾᏍᎩᎾ ᏗᏅᏗᏍᎩ ᎠᎴᏃ ᏧᏓᏟᎶᏍᏔᏅ ᎠᎴ ᎨᏍᏒ ᎤᎦᏘᏅᏕᏍᏗ ᎾᏍᎩᎾ ᎠᏂᏐᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="Connect to display">
                <langSet xml:lang="en-US"><tig><term>Connect to display</term></tig></langSet>
