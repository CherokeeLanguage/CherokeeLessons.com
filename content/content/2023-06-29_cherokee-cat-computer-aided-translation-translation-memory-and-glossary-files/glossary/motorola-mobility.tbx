                <langSet xml:lang="chr"><tig><term> ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This bug report is being shared with your IT admin. Contact them for more details.">
                <langSet xml:lang="en-US"><tig><term>This bug report is being shared with your IT admin. Contact them for more details.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏍᎪᏯ ᎬᏂᎨᏒ ᏱᎬᏁᎯ ᎾᏍᎩᎾᏃ ᎠᏯᏙᎯᏍᏔᏅ ᎬᏗ ᏣᏤᎵ IT ᏄᏂᎬᏫᏳᏌᏕᎩ. ᎠᏟᏃᎮᏙᏗ ᎢᏯᏂᎢ ᎾᏍᎩᎾ ᎤᏥ ᎢᎦᎢ ᎧᏃᎮᏍᎦ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Reading settings\u2026">
                <langSet xml:lang="en-US"><tig><term>Reading settings\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᎵᏰᏗ ᏕᎦᎧᎲᎢ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Updating settings\u2026">
                <langSet xml:lang="en-US"><tig><term>Updating settings\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏤᎲᏍᏗᏍᎬ ᏕᎦᎧᎲᎢ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Unexpected response from network.">
                <langSet xml:lang="en-US"><tig><term>Unexpected response from network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏅᎦᏖᏃᎲᎾ ᎤᏁᏨᎦ ᏂᏓᏳᏓᎴᏅᎯ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on the radio before viewing these settings.">
                <langSet xml:lang="en-US"><tig><term>Turn on the radio before viewing these settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᏗ Ꮎ ᎦᏬᏂᏍᎩ ᏏᏅ ᏗᎪᎵᏰᏗ ᎯᎠᏃ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can set transition preferences for each app in External display settings.">
                <langSet xml:lang="en-US"><tig><term>You can set transition preferences for each app in External display settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤ cᎠn Ꮞt trᎠnᏏᏘᎣn prᎡfᎡrᎡncᎡᏍ fᎣr ᎡᎠch Ꭰpp Ꭲn ᎡxᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ ᏎtᏘngᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You don’t need to open your Razr to turn on the flashlight.">
                <langSet xml:lang="en-US"><tig><term>You don’t need to open your Razr to turn on the flashlight.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤ Ꮩn’t ᏁᎡd tᎣ ᎣpᎡn ᏲᎤr RᎠzr tᎣ tᎤrn Ꭳn tᎮ fᎳᏍhᎵght.</term></tig></langSet>
            </termEntry>
            <termEntry id="Just hold it in your hand and make a chopping motion twice.">
                <langSet xml:lang="en-US"><tig><term>Just hold it in your hand and make a chopping motion twice.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>JᎤᏍt Ꮀld Ꭲt Ꭲn ᏲᎤr Ꭽnd Ꭰnd ᎹkᎡ Ꭰ cᎰppᎢng ᎼᏘᎣn tᏫcᎡ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can change the font and display size in external display settings.">
                <langSet xml:lang="en-US"><tig><term>You can change the font and display size in external display settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤ cᎠn cᎭnᎨ tᎮ fᎣnt Ꭰnd ᎠᏓᏴᎳᏔᏍᎩ ᏏzᎡ Ꭲn ᎡxᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ ᏎtᏘngᏍ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The settings you choose for the external display are independent from the internal display.">
                <langSet xml:lang="en-US"><tig><term>The settings you choose for the external display are independent from the internal display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TᎮ ᏎtᏘngᏍ ᏲᎤ cᎰᎣᏎ fᎣr tᎮ ᎡxᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ ᎠrᎡ ᎢnᏕpᎡnᏕnt frᎣm tᎮ ᎢnᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn the flashlight on and off with an easy gesture.">
