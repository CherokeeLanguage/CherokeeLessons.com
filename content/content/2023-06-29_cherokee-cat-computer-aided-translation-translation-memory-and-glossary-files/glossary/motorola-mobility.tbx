                <langSet xml:lang="en-US"><tig><term>Cannot access city search service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏩᏴᏍᏗᎢ ᎦᏚᎲ ᎠᏱᏍᏗ ᎤᎾᏓᏍᏕᎸᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Home time zone">
                <langSet xml:lang="en-US"><tig><term>Home time zone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏪᏅᏒ ᎠᏥᎢᎵᏒ ᎠᏎᏢᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Display the current location time and home time when you’re in a different time zone">
                <langSet xml:lang="en-US"><tig><term>Display the current location time and home time when you’re in a different time zone</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏥᎩ ᏃᏊ ᏥᎩ ᎤᏙᏢᏒᎢ ᎠᏥᎢᎵᏒ ᏃᎴ ᎣᏪᏅᏒ ᎠᏥᎢᎵᏒ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎾᎿ Ꭰ ᏧᏓᎴᎿᎢ ᎠᏥᎢᎵᏒ ᎠᏎᏢᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can only have one active Motorola ID at a time.">
                <langSet xml:lang="en-US"><tig><term>You can only have one active Motorola ID at a time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎤᏅᏒ ᎤᎭ ᏌᏇ ᎬᏂᎦᎵᏍᏗ Motorola ID ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" needs location permission allowed all the time. Otherwise, the location-related functions can't work properly. Select Permissions in App info to set.">
                <langSet xml:lang="en-US"><tig><term> needs location permission allowed all the time. Otherwise, the location-related functions can't work properly. Select Permissions in App info to set.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏧᏚᎸᏓ ᎤᏙᏢᏒᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᎵᏍᎪᎸᏔᏅ ᏂᎦᏓ ᏥᎩ ᎠᏥᎢᎵᏒ. ᎢᏳᏃ ᏰᎵ, ᏥᎩ ᎤᏙᏢᏒᎢ-ᏧᏠᏱ ᏚᎸᏫᏍᏓᏁᎰᎢ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏗᏙᎳᏤᎩ. ᎠᏑᏰᏍᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿᎢ ᎬᎡᏗ ᎣᏃᎮᏍᎩ ᏏᏊ ᎤᎾᏓᏡᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Dual time display">
                <langSet xml:lang="en-US"><tig><term>Dual time display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏐᏱ ᎠᏥᎢᎵᏒ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Fitness data enabled to display on Widget">
                <langSet xml:lang="en-US"><tig><term>Fitness data enabled to display on Widget</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᎵᏂᎪᎯᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ to ᎠᏓᏴᎳᏛᏍᎩ ᏫᏥᏘ</term></tig></langSet>
            </termEntry>
            <termEntry id="Time">
                <langSet xml:lang="en-US"><tig><term>Time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will not be able to make or receive HD voice and video calls when you turn this setting off.">
                <langSet xml:lang="en-US"><tig><term>Your phone will not be able to make or receive HD voice and video calls when you turn this setting off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᏎ ᎥᏝ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎪᏒᏗ ᏃᎴ ᎠᎩᏍᏗ HD ᎧᏁᎬ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎢᏳᏃ ᏂᎯ ᎠᎦᏔᎲᏍᏗ ᎯᎠ ᏕᎦᎧᎲᎢ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This will put your device into Verizon store demo mode which significantly limits device functionality and erases all user information and files residing in the internal memory. A factory data reset is required to exit this mode.">
                <langSet xml:lang="en-US"><tig><term>This will put your device into Verizon store demo mode which significantly limits device functionality and erases all user information and files residing in the internal memory. A factory data reset is required to exit this mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎠᎲᎦ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ Verizon ᎯᏍᏆᏂᎪᏓ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎬᏙᏗ ᎦᏙᎤᏍᏗ ᎤᎵᏍᎨᏗᏳᏊ ᏓᏎᎸᎯ ᏥᏂᎬᏅᏗᏓᎾ ᏧᏂᎸᏫᏍᏓᏁᏗᏱ ᏃᎴ ᏛᏍᏍᎪᎸᏥ ᏂᎦᏓ ᎬᏗᏍᎩ ᎧᏃᎮᏢᏗ ᏃᎴ ᏗᏍᏆᏂᎪᏙᏗ ᎤᎾᏕᏗᎢ ᎾᎿ ᏥᎩ ᏄᎵᏍᎨᏗᏴᎢ ᎠᏅᏓᏗᏍᏙ. Ꭰ ᎤᏃᏢᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏥᎯᎧᎲᎦ ᎨᎡᎢ ᎢᏯᏛᏁᏗ to ᎦᏅᎪᎢᏍᏗ ᎯᎠ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Under demo mode, password is needed to do factory reset.">
                <langSet xml:lang="en-US"><tig><term>Under demo mode, password is needed to do factory reset.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏫᏂᏗᏢ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎬᏙᏗ, ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎨᎡᎢ ᎤᏚᎸᏛ ᎾᎿᎢ ᎤᏃᏢᏅᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Verizon Store Demo Mode cannot be started without a valid Verizon SIM, please try again after you insert a valid Verizon SIM card.">
                <langSet xml:lang="en-US"><tig><term>Verizon Store Demo Mode cannot be started without a valid Verizon SIM, please try again after you insert a valid Verizon SIM card.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Verizon Store Demo Mode ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎠᏂᎩᏍᏙᏔᏅᎩ ᎾᏠᏯᏍᏗᏍᎬᎾ Ꭰ ᎠᏓᏂᎸᎦ Verizon SIM, ᎰᏩᏊ ᏥᎭᏁᎸᏓ ᎤᎶᏐᏅ ᏂᎯ ᎰᏣᎸᎥᎦ Ꭰ ᎾᏠᏯᏍᏗᏍᎬᎾ Verizon SIM ᏆᎾᏲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To place a SIP call, check your Internet connection first.">
                <langSet xml:lang="en-US"><tig><term>To place a SIP call, check your Internet connection first.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᏙᏢᏒ Ꭰ SIP ᏪᏯᎾ, ᎪᏪᎶᏗ ᏂᏨᏅᎢ ᎠᏏᎳᏕᏫᏒᎢ ᎫᏓᎸᎢ ᎠᎬᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A Video call cannot be added at this time.">
                <langSet xml:lang="en-US"><tig><term>A Video call cannot be added at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎧᏁᏉᏓ ᎾᏊᎨᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Video calling and RTT keyboard cannot be on at the same time. RTT keyboard will be turned off.">
                <langSet xml:lang="en-US"><tig><term>Video calling and RTT keyboard cannot be on at the same time. RTT keyboard will be turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏴᎳᏛᏍᎩ ᏓᏯᏂᏍᎬ ᏃᎴ RTT ᏗᏐᏅᏍᏙᏗ ᎨᏍᏗ ᏰᎵ ᎠᏍᏚᎢᏓ ᎾᎿᎢ ᎾᏍᎩ ᎾᎯᏳᏉ ᎠᏥᎢᎵᏒ. RTT ᏗᏐᏅᏍᏙᏗ ᎠᏎ ᎨᎡᎢ ᎤᎦᏔᎲᏒᏃ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Data Usage that you set on your device has reached its limit. Your Video call requires data. To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.">
                <langSet xml:lang="en-US"><tig><term>Your Data Usage that you set on your device has reached its limit. Your Video call requires data. To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎥᏍᎩᎾ ᏂᎯ ᎦᎧᎲᎢ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏂᏚᏩᎿ ᏭᎷᏨᎩ ᎨᎡᎢ ᎠᏎᎸᎯ. ᏂᏨᎤᎢ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎠᏎᏳᎾᏛᏁᏗ ᎦᏘᏍᎩᏌᏅᎯ. ᎾᎿᎢ ᎠᎦᏎᏍᏔᏅ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ, ᎡᏅᏍᏙᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ &gt; ᏧᎾᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ &gt; ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on data roaming">
                <langSet xml:lang="en-US"><tig><term>Turn on data roaming</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Mobile Data">
                <langSet xml:lang="en-US"><tig><term>Turn on Mobile Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Location Information">
                <langSet xml:lang="en-US"><tig><term>Location Information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿ ᎢᎬᎾᏕᎾ ᎧᏃᎸᎥᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't Activate">
                <langSet xml:lang="en-US"><tig><term>Don't Activate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎤᏂᎩᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: You can set up your phone using Wi-Fi, but you won’t be able to make or receive calls until your phone has been activated on the Verizon network.">
                <langSet xml:lang="en-US"><tig><term>Note: You can set up your phone using Wi-Fi, but you won’t be able to make or receive calls until your phone has been activated on the Verizon network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ: ᏂᎯ ᏰᎴᏯ ᎦᎧᎲᏍᎬᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎬᏗᎭ Wi-Fi, ᎠᏎᏃ ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎪᏒᏗ ᏃᎴ ᎦᏁᏍᏗ ᏓᏯᏂ ᎩᎳ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏂᎦᎵᏍᏓ ᎤᏂᎩᏍᏗᏍᎩ ᎤᎿᎢ ᏥᎩ Verizon ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, this SIM card is not readable. Please contact your wireless service provider.">
                <langSet xml:lang="en-US"><tig><term>Sorry, this SIM card is not readable. Please contact your wireless service provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎤᏰᎸᏅ, ᎯᎠ SIM ᏆᎾᏲᏍᏗ ᎨᎡᎢ ᎥᏝ ᎢᏲᏍᏓ ᎤᎪᎵᏰᏗ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏣᏤᎵ ᏂᏓᏏᎳᏛ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="App data usage">
                <langSet xml:lang="en-US"><tig><term>App data usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone needs a  to work. You may not have inserted your SIM card yet or it may be inserted incorrectly.Make sure your SIM card is inserted as shown below.">
                <langSet xml:lang="en-US"><tig><term>Your phone needs a  to work. You may not have inserted your SIM card yet or it may be inserted incorrectly.Make sure your SIM card is inserted as shown below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏧᏚᎸᏓ Ꭰ  ᎾᎿ ᏗᎦᎸᏫᏍᏓᏁᏗ. ᏂᎯ ᏰᎵᏯ ᎥᏝ ᎤᎭ ᏫᎪᏣᎸᏅᎢ ᏂᏨᎤᎢ SIM ᏆᎾᏲᏍᏗ ᎩᎳ ᏃᎴ ᎨᎡᎢ ᏰᎵᏯ ᎨᎡᎢ ᏫᎪᏣᎸᏅᎢ ᏂᏚᏳᎪᏛᎾ.ᏙᏳᎢ ᏚᏳᎪᏛ ᎨᏎᏍᏗ ᏂᏨᎤᎢ SIM ᏆᎾᏲᏍᏗ ᎨᎡᎢ ᏫᎪᏣᎸᏅᎢ ᎤᎿ ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id=", however your data usage is currently limited due to time of day or a data limit.">
                <langSet xml:lang="en-US"><tig><term>, however your data usage is currently limited due to time of day or a data limit.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>, ᎠᏍᏎᏃ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏔᏂᏓᏍᏗ ᎨᎡᎢ ᏃᏊ ᏥᎩ ᏩᏎᏢᏊ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ ᎠᏥᎢᎵᏒ ᎾᎿ ᎢᎦ ᏃᎴ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You cannot get the sim status while the device is in airplane mode. Would you like to turn airplane mode off?">
                <langSet xml:lang="en-US"><tig><term>You cannot get the sim status while the device is in airplane mode. Would you like to turn airplane mode off?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎠᎩᏍᏗ ᏥᎩ SIM ᏄᏛᎿᏕᎬᎢ ᎾᎯᏳᎢ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎩ ᎾᎿ ᏥᏳ ᏄᏍᏛᎢ. ᏯᏓᎯᏗᏏ ᏂᏨᎤᎢ ᎯᎸᏉᏗ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᏥᏳ ᏄᏍᏛᎢ ᎠᏍᏚᎭ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage for downloading, using and updating apps will be billed according to your plan.">
                <langSet xml:lang="en-US"><tig><term>Data usage for downloading, using and updating apps will be billed according to your plan.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ ᏄᏰᎸᏛ ᎡᎳᏗᎬᏘ ᎦᏢᏗᏍᎬ, ᎲᏗᏍᎬ ᏃᎴ ᎠᏤᎲᏍᏗᏍᎬ ᏗᎬᏙᏗ ᎠᏎᎯᎯ ᎢᎦ ᎠᏓᏚᏅ ᏂᎬᏅ ᏂᏣᏤᎵ ᏧᎾᎵᏃᎮᏗ ᎠᏍᏓᏩᏛᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You need to be connected to a Wi-Fi network for SIP calls (use the Wireless &amp; Network settings).">
                <langSet xml:lang="en-US"><tig><term>You need to be connected to a Wi-Fi network for SIP calls (use the Wireless &amp; Network settings).</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᏚᎸᏓ ᎾᎿᎢ ᎨᏒᎢ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Ꭰ Wi-Fi ᏧᎾᏚᏓᎵ ᎤᎬᏩᏟ SIP ᏓᏯᏂ (ᎬᏔᏂᏓᏍᏗ ᏥᎩ Wireless &amp; Network ᏕᎦᎧᎲᎢ).</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to purchase data so you can use the Verizon network to access the Internet?">
                <langSet xml:lang="en-US"><tig><term>Do you want to purchase data so you can use the Verizon network to access the Internet?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎠᏩᎯᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᏂᎯ ᏰᎵᏊ ᎬᏔᏂᏓᏍᏗ Verizon ᏧᎾᏚᏓᎵ ᎾᎿᎢ ᎠᏴᏍᏗ ᎠᏏᎳᏕᏫᏒᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Also, you won’t be able to make emergency calls after this screen until you finish the Setup Wizard.">
                <langSet xml:lang="en-US"><tig><term>Also, you won’t be able to make emergency calls after this screen until you finish the Setup Wizard.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᏉ, ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᏓᏯᏂ, ᎤᎶᏐᏅ ᎯᎠ ᎠᏰᏙᎳᏛᎢ ᎩᎳ ᏂᎯ ᎯᏍᏆᏓ ᏥᎩ Setup Wizard.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, that Wi-Fi network is not connected to the Internet right now. Please try a different network or leave setup.">
                <langSet xml:lang="en-US"><tig><term>Sorry, that Wi-Fi network is not connected to the Internet right now. Please try a different network or leave setup.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎤᏰᎸᏅ, ᎥᏍᎩᎾ Wi-Fi ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎥᏝ ᎫᏓᎸᏅᎯ ᎾᎿᎢ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎠᎦᏘᏏ Ꭷ. ᎰᏩᏊ ᏣᏁᎸᏙᏗ Ꭰ ᏧᏓᎴᎿᎢ ᏧᎾᏚᏓᎵ ᏃᎴ ᎠᏓᏅᏍᏗ ᎦᎧᎲᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Usage time">
                <langSet xml:lang="en-US"><tig><term>Usage time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏗᏍᎬ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, this SIM card is not supported. Please contact your wireless service provider.">
                <langSet xml:lang="en-US"><tig><term>Sorry, this SIM card is not supported. Please contact your wireless service provider.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎤᏰᎸᏅ, ᎯᎠ SIM ᏆᎾᏲᏍᏗ ᎨᎡᎢ ᎥᏝ ᎦᎫᏍᏛᏅᎢ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᏣᏤᎵ ᏂᏓᏏᎳᏛ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Email setup is not available because you don't have a data connection. Connect to a Wi-Fi network to set up email now, or set it up later in the Email app.">
                <langSet xml:lang="en-US"><tig><term>Email setup is not available because you don't have a data connection. Connect to a Wi-Fi network to set up email now, or set it up later in the Email app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᎦᎧᎲᏍᎬᎢ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᏂᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏂᎯ ᏝᏍᏗ ᎤᎭ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎫᏓᎸᎢ. ᎫᏓᎸᎢ ᎾᎿᎢ Ꭰ Wi-Fi ᏧᎾᏚᏓᎵ ᎾᎿᎢ ᎦᎧᎲᏍᎬᎢ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ Ꭷ, ᏃᎴ ᎦᎧᎲᏍᎬᎢ ᎣᏂᏯᎨᏍᏗ ᎾᎿ ᏥᎩ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't worry, your choice here won't affect any other Verizon services, and you can change it at any time">
                <langSet xml:lang="en-US"><tig><term>Don't worry, your choice here won't affect any other Verizon services, and you can change it at any time</term></tig></langSet>
