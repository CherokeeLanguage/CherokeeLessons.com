                <langSet xml:lang="en-US"><tig><term>Download the carrier app to activate your new SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎡᎳᏗᏟ ᎦᏢᏍᎬᎢ ᎾᏍᎩ ᎠᎯᏙᎯ ᎬᏙᏗ ᎾᎢ ᎤᏂᎩᏍᏗᏍᎩ ᏣᏤᎵ ᎢᏤ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id=" has been put into the RESTRICTED bucket">
