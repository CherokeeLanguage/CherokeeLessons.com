                <langSet xml:lang="chr"><tig><term>RUIM ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᎸᏍᎩ ᎠᏂᏐᎭᎾᎳᎩ ᏄᏓᏄᎸᏅᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Max call count reached, cannot merge call">
                <langSet xml:lang="en-US"><tig><term>Max call count reached, cannot merge call</term></tig></langSet>
