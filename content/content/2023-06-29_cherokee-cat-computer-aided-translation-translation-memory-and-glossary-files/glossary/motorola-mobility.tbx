                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᏘᏖᎸᎲᎦ ᏕᎯᏰᏒᏛᎢ ᎾᎢ ᎠᏕᎳᎰᎯᏍᏗ ᎾᏍᎩ ᎠᏒᏂᏍᏗ ᏧᏓᏓᏟ ᎾᏍᎩ ᎪᎷᏩᏛᏓ ᏱᎩ ᎠᎴ ᏱᏍᏓᏩᏕᎦ ᎭᏓᏅᏏᏙᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: The number of detectable touch points varies by device.">
                <langSet xml:lang="en-US"><tig><term>Note: The number of detectable touch points varies by device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏗ ᎪᏪᎸ: ᎾᏍᎩ ᎠᏎᏍᏗ ᎥᎿᎢ ᎬᏕᎳᎰᎯᏍᏗ ᎠᏒᏂᏍᏗ ᏧᏓᏓᏟ ᎤᎶᏒᏍᏔᏅ ᏧᏓᎴᏅᏓ ᎬᏗ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps &amp; app data">
                <langSet xml:lang="en-US"><tig><term>Apps &amp; app data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ &amp; ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can\u2019t safely be stopped. If you stop it, you may lose some of your current work.">
                <langSet xml:lang="en-US"><tig><term>This app can\u2019t safely be stopped. If you stop it, you may lose some of your current work.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎨᏍᏗ ᏰᎵ ᎤᏓᎵᏏᏅᏓ ᎨᎡᎢ ᎠᎴᏫᏍᏓ. ᎨᎡᎢ ᏂᎯ ᎭᎴᏫᏍᏓ ᎨᎡᎢ, ᏂᎯ ᏰᎵᏯ ᏣᎫᎯ ᎢᎦᏓ ᎾᎿ ᏂᏨᎤᎢ ᏃᏊ ᏥᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Motorola Support will reply soon.">
