            </termEntry>
            <termEntry id="Find it fast">
                <langSet xml:lang="en-US"><tig><term>Find it fast</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎯᏩᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make your mark">
                <langSet xml:lang="en-US"><tig><term>Make your mark</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎶᏗ ᏣᏤᎵ ᎰᏒᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Take your gaming to the next level with big screen performance on your TV or display. Connect a Bluetooth game controller for an enhanced experience.">
                <langSet xml:lang="en-US"><tig><term>Take your gaming to the next level with big screen performance on your TV or display. Connect a Bluetooth game controller for an enhanced experience.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏫᏓ ᏂᏨᏅᎢ ᏕᎭᏁᎸᏗᏍᎬᎢ ᎾᎢ ᎾᏍᎩ ᏐᎢ ᎠᏥᎶᏍᎩ ᎬᏗ ᎤᏔᎾ ᎠᏴᏙᎳᏛᎢ ᏧᎸᏫᏍᏓᏁᎯ ᎤᎾᎢ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴᏃ ᎬᏂᎨᏒ ᏱᎬᏁᏗ. ᎫᏓᎸᎢ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᏗᏁᎸᏙᏗ ᎠᏱᎴᎦ ᎾᏍᎩᎾ ᏓᏤᏢᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Three finger screenshot makes it easier to capture what you see on your screen. Just touch the screen with three of your fingertips anytime.">
                <langSet xml:lang="en-US"><tig><term>Three finger screenshot makes it easier to capture what you see on your screen. Just touch the screen with three of your fingertips anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎢ ᎦᏰᏌᏛ ᎠᏓᏴᎳᏛᏍᎩ ᏗᏥᎶᏍᏔᏅᎢ ᏂᎬᏂᏏᎠ ᎠᎯᏗᎨᎢ ᎦᏂᏴᏗᎢ ᎢᏳᏍᏗ ᎯᎪᏩᏘᏍᎬ ᏂᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩᎢ. ᎠᏒᏅᏍᏗᏊ Ꮎ ᎠᏓᏴᎳᏛᏍᎩ ᎬᏗ ᏦᎢ ᏂᏗᏣᏤᎵ ᏕᏂᏰᏌᏛᎢ ᏂᎦᎵᏍᏔᏅᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Find My Device helps you locate your phone remotely. It also helps you protect your information if your phone is lost.">
                <langSet xml:lang="en-US"><tig><term>Find My Device helps you locate your phone remotely. It also helps you protect your information if your phone is lost.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>"ᎯᏩᏔ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏆᏤᎵ" ᎠᏍᏕᎵᏍᎪᎢ ᎠᏩᏛᏗ ᏂᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎦᎸᏙᎳᎨᏍᏗ. ᎾᏍᏋ ᎠᏍᏕᎵᏍᎪᎢ ᎠᏓᎦᏎᏍᏙᏗ ᏂᏣᏤᎵ ᎦᏃᎮᏢᎥᏍᎩ ᎢᏳᏃ ᏗᏟᏃᎮᏗᎢ ᏱᏣᏲᏎᎳ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Optimized charging prevents overcharging and keeps your battery healthier over time.">
                <langSet xml:lang="en-US"><tig><term>Optimized charging prevents overcharging and keeps your battery healthier over time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏍᏓ ᎢᏳᎵᏍᏙᏗ ᏓᎬᏩᎶᏗᏍᎬᎢ ᏗᎴᏫᏍᏙᏗᏍᎩ ᎦᎸᎳᏗᏨ ᎬᏃᏗᎭ ᏃᎴ ᏣᏤᎵ ᎠᎾᎦᎵᏍᎩ ᏙᎯᏳᎢ ᏂᎬᏁᎰᎢ ᎢᏴᏛ ᎠᏥᎢᎵᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do more with your voice">
                <langSet xml:lang="en-US"><tig><term>Do more with your voice</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ ᎾᏛᎦ ᎧᏁᎬ ᎤᏃᏴᎬ ᏣᏤᎵ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="For example, peanuts">
                <langSet xml:lang="en-US"><tig><term>For example, peanuts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᏚᏯ ᎠᏂᎳᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You'll continue to receive messages from this number but won't be notified anymore. This conversation will appear in Spam folder.">
                <langSet xml:lang="en-US"><tig><term>You'll continue to receive messages from this number but won't be notified anymore. This conversation will appear in Spam folder.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏊᏃ ᎠᎯᎸᏍᏗ ᎾᎿᎢ ᎦᏁᏍᏗ ᏗᎪᎵᏰᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᎠᏎᏍᏗ ᎠᏎᏃ ᏝᏰᎵ ᎨᏒᎩ ᎤᏓᏃᎯᏎᎸ ᎢᎸᎯᏳᎢ. ᎯᎠ ᏗᏟᏃᎮᏗ ᎠᏎᎢ ᎬᏂᎨᏒᎢ ᎾᎿ Spam ᏗᏴᏈᏛᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" updated group name to &quot;&quot; locally">
                <langSet xml:lang="en-US"><tig><term> updated group name to "" locally</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎪᏢᎯᏌᏅ ᎤᎾᏓᏡᎬᎢ ᏚᏅᏙᎥ ᎾᎿᎢ  ᎡᏍᎦᏂᎨᏍᏗ</term></tig></langSet>
            </termEntry>
