                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏓᏯᏂᏍᎬ ᏂᏚᏩᎿ ᎪᎷᏩᏛᏓ ᎥᏍᎩᎾ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎨᎡᎢ ᎫᏓᎸᏅᎯ ᎾᎿᎢ Ꭰ Wi-Fi ᎠᏴᏍᏗ ᏩᏎᎯᎯ ᎢᎬᎾᏕᏅ ᏙᏯᏗᏢ ᎾᎿ ᏥᎩ USA.</term></tig></langSet>
            </termEntry>
            <termEntry id="Calls to emergency services (to 9-1-1, 999, 112, etc., depending on the country) are not made over Wi-Fi network to which you are connected.">
                <langSet xml:lang="en-US"><tig><term>Calls to emergency services (to 9-1-1, 999, 112, etc., depending on the country) are not made over Wi-Fi network to which you are connected.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏯᏂ ᎾᎿᎢ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ (ᎾᎿᎢ 9-1-1, 999, 112, etc., ᎥᎵᏍᎦᏍᏙᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏰᎵ ᎤᏙᏢᏒ) ᎨᎡᎩ ᎥᏝ ᏄᎵᏍᏔᏅ ᎢᏴᏛ Wi-Fi ᏧᎾᏚᏓᎵ ᎾᎿᎢ ᎦᏙᎤᏍᏗ ᏂᎯ ᎨᎡᎩ ᎫᏓᎸᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="As such, depending on your device's capabilities and current roaming settings, you may be unable to make emergency services calls using Wi-Fi calling.">
                <langSet xml:lang="en-US"><tig><term>As such, depending on your device's capabilities and current roaming settings, you may be unable to make emergency services calls using Wi-Fi calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎿᎢ ᎾᏍᎩᏯ, ᎥᎵᏍᎦᏍᏙᏗᏍᎬ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏰᎵ ᎢᏯᏛᏁᎯ ᎠᎴ ᏃᏊ ᏥᎩ ᎡᏙᎵᏙᎲ ᏕᎦᎧᎲᎢ, ᏂᎯ ᏰᎵᏯ ᎨᎡᎢ ᎤᏓᏄᎸᏅ ᎾᎿᎢ ᎪᏢᏗ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏓᏯᏂ ᎬᏗᎭ Wi-Fi ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Contact emergency services by some other means.">
                <langSet xml:lang="en-US"><tig><term>Contact emergency services by some other means.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏟᏃᎮᏙᏗ ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎬᏗ ᎢᎦᏓ ᏐᎢ ᎤᏅᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To see available networks, turn Wi-Fi on.">
                <langSet xml:lang="en-US"><tig><term>To see available networks, turn Wi-Fi on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᎠᏛᏅᎢᏍᏔᏅ ᏚᎾᏚᏓᎵ, ᎯᏍᏚᎢ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Voice Networks">
                <langSet xml:lang="en-US"><tig><term>Voice Networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏁᎬ ᏚᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="TTY mode turned off">
                <langSet xml:lang="en-US"><tig><term>TTY mode turned off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>TTY ᎬᏙᏗ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning this option off prevents Wi-Fi Calling on Passpoint networks.">
                <langSet xml:lang="en-US"><tig><term>Turning this option off prevents Wi-Fi Calling on Passpoint networks.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᎬ ᎯᎠ ᎠᏑᏰᏍᏗ ᎠᏍᏚᎭ ᏗᎴᏫᏍᏙᏗᏍᎩ Wi-Fi ᏓᏯᏂᏍᎬ ᎤᎿᎢ ᎠᎦᏛᎴᎯᏍᏗ ᏩᏎᎯᎯ ᏚᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notify you when U.S. emergency services (9-1-1) aren't available while traveling internationally">
                <langSet xml:lang="en-US"><tig><term>Notify you when U.S. emergency services (9-1-1) aren't available while traveling internationally</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏃᎯᏎᏗ ᏂᎯ ᎢᏳᏃ U.S. ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ (9-1-1) ᎨᎡᎩ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏏᏉ ᎠᏁᏙᎵᏙᎲ ᎠᏰᎵ ᏚᏓᏂᏴᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="We need your permission to continue">
                <langSet xml:lang="en-US"><tig><term>We need your permission to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳ ᎤᏚᎸᏓ ᏂᏨᎤᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎠᎯᎸᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select the optional networks you want to use for making and receiving voice calls.">
                <langSet xml:lang="en-US"><tig><term>Select the optional networks you want to use for making and receiving voice calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏥᎩ ᎣᏩᏌ ᎠᏑᏰᏍᏗ ᏚᎾᏚᏓᎵ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎤᎬᏩᏟ ᎪᏢᏍᎦ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning on these network connections may improve call quality and coverage.">
                <langSet xml:lang="en-US"><tig><term>Turning on these network connections may improve call quality and coverage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᎬ ᎠᎴ ᎯᎠᏃ ᏚᎾᏚᏓᎵ ᏓᎵᎪᏗᏍᎬ ᏰᎴᏯ ᏦᎦᏤᎳᏍᏙᏗ ᏪᏯᎾ ᎢᏲᏍᏓ ᎠᎴ ᎫᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Wi-Fi Calling to configure your service.">
                <langSet xml:lang="en-US"><tig><term>Turn on Wi-Fi Calling to configure your service.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ Wi-Fi ᏓᏯᏂᏍᎬ ᎾᎿᎢ ᏄᏍᏛ ᎤᏙᏢᏒ ᏂᏨᎤᎢ ᎢᏯᏓᏛᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Passpoint networks for Wi-Fi Calling.">
                <langSet xml:lang="en-US"><tig><term>Use Passpoint networks for Wi-Fi Calling.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎠᎦᏛᎴᎯᏍᏗ ᏩᏎᎯᎯ ᏚᎾᏚᏓᎵ ᎤᎬᏩᏟ Wi-Fi ᏓᏯᏂᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Searching for Wi-Fi networks...">
                <langSet xml:lang="en-US"><tig><term>Searching for Wi-Fi networks...</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏲᎭ ᎤᎬᏩᏟ Wi-Fi ᏚᎾᏚᏓᎵ...</term></tig></langSet>
            </termEntry>
            <termEntry id="Passpoint networks are found in public locations such as airports, shopping malls and sporting venues.">
                <langSet xml:lang="en-US"><tig><term>Passpoint networks are found in public locations such as airports, shopping malls and sporting venues.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏛᎴᎯᏍᏗ ᏩᏎᎯᎯ ᏚᎾᏚᏓᎵ ᎨᎡᎩ ᎠᏩᏛᏗ ᎾᎿ ᎠᏰᎵ ᎤᏤᎵ ᎤᏙᏢᏒᎢ ᏕᎧᏁᎢᏍᏔᏅᎯ ᎤᏃᎴ ᎫᏓᎸᏗ, ᎠᎾᏓᎾᏁᏒᎲᏍᎬ ᎹᎵ ᎠᎴ ᎠᎾᏁᏦᏍᎩ ᎤᏙᏢᏒ ᎠᏓᎳᏑᏢᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Passpoint networks are Wi-Fi networks your phone automatically connects to without requiring authentication information.">
                <langSet xml:lang="en-US"><tig><term>Passpoint networks are Wi-Fi networks your phone automatically connects to without requiring authentication information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏛᎴᎯᏍᏗ ᏩᏎᎯᎯ ᏚᎾᏚᏓᎵ ᎨᎡᎩ Wi-Fi ᏚᎾᏚᏓᎵ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎤᏩᏌᏊ ᎢᏯᏓᏛᏁᎯ ᏕᎫᏓᎸᎢ ᎾᎿᎢ ᎾᏠᏯᏍᏗᏍᎬᎾ ᎠᏎᏳᎾᏛᏁᏗ ᎠᏓᏙᏟᏍᏙᏗ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The International warning message displays a reminder about 9-1-1 emergency service limitations when your phone is detected to be outside the US.">
                <langSet xml:lang="en-US"><tig><term>The International warning message displays a reminder about 9-1-1 emergency service limitations when your phone is detected to be outside the US.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎠᏓᏕᏯᏔᎲᏍᎩ ᏗᎦᏃᏣᎳᏅᎯ ᎬᏂᎨᏒ ᏱᏗᎬᏁᏗ Ꭰ ᎠᏓᏅᏓᏗᏍᏗᏍᎩ ᎢᏳᏰᎸᏛ 9-1-1 ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᎢᏗᏛᏁᎵᏓᏍᏗ ᏗᎦᎶᏐᎲᏍᎩ ᎢᏳᏃ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎪᎷᏩᏛᏓ ᎾᎿᎢ ᎨᎡᎢ ᏙᏱ ᏥᎩ US.</term></tig></langSet>
            </termEntry>
            <termEntry id="Turning off this option will stop the reminder from being displayed.">
                <langSet xml:lang="en-US"><tig><term>Turning off this option will stop the reminder from being displayed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏔᎲᏍᎬ ᎠᏍᏚᎭ ᎯᎠ ᎠᏑᏰᏍᏗ ᎠᏎ ᎭᎴᏫᏍᏓ ᏥᎩ ᎠᏓᏅᏓᏗᏍᏗᏍᎩ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎴᏂᏙᎲ ᎬᏂᎨᏒ ᏁᎬᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Welcome to VoLTE">
                <langSet xml:lang="en-US"><tig><term>Welcome to VoLTE</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎬᏯᏓᏁᎸᎦ ᎾᎿᎢ VoLTE</term></tig></langSet>
            </termEntry>
            <termEntry id="VoLTE provides superior quality when making and receiving voice calls.">
                <langSet xml:lang="en-US"><tig><term>VoLTE provides superior quality when making and receiving voice calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>VoLTE ᏓᎾᏓᏁᏢᏍᎬ ᏄᎬᏫᏳᏌᏕᎩ ᎢᏲᏍᏓ ᎢᏳᏃ ᎪᏢᏍᎦ ᎠᎴ ᎦᏁᏍᏗ ᎤᏁᎬ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="It also lets you use apps and the internet while on a call.">
                <langSet xml:lang="en-US"><tig><term>It also lets you use apps and the internet while on a call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎠᎴ ᎾᏍᏊ ᏩᏂᎩ ᏂᎯ ᎬᏔᏂᏓᏍᏗ ᏗᎬᏙᏗ ᎠᎴ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ ᎾᎯᏳᎢ ᎤᎿᎢ Ꭰ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The VoLTE icon is displayed in the notification bar when you are in a VoLTE coverage area.">
                <langSet xml:lang="en-US"><tig><term>The VoLTE icon is displayed in the notification bar when you are in a VoLTE coverage area.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ VoLTE ᎠᎢᎧᏂ ᎨᎡᎢ ᎬᏂᎨᏒ ᏁᎬᏅᎢ ᎾᎿ ᏥᎩ ᎠᏓᏃᏣᎳᏁᎯ ᎦᎾᎸ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎾᎿ Ꭰ VoLTE ᏓᏁᏃᏣᏢᏍᎦ ᎢᎬᎾᏕᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device can't manage battery normally because  is keeping your device awake.To try to fix this issue, you can stop the app.If this keeps happening, you may need to uninstall the app to improve battery performance.">
                <langSet xml:lang="en-US"><tig><term>Your device can't manage battery normally because  is keeping your device awake.To try to fix this issue, you can stop the app.If this keeps happening, you may need to uninstall the app to improve battery performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr pᎰᏁ cᎠn't ᎹᎾᎨ bᎠtᏖry ᏃrᎹlly bᎡcᎠᎤᏎ  iᎢᏍ kᎡᎡpᎢng ᏲᎤr pᎰᏁ ᎠᏩkᎡTᎣ try tᎣ fᎢx tᎯᏍ ᎢᏍᏑᎡ, ᏲᎤ cᎠn ᏍtᎣp tᎮ Ꭰpp.ᏍᏓ ᏓᏍᏆᏂᎪᏗ ᏂᎦᎵᏍᏗᏍᎬ, ᏅᏅᏓᎩ ᎬᏙᏗ ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏚᎸᏫᏍᏓᏁᎲᎢ ᎪᏢᎯᏐᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data used by VoLTE does not count against your data plan limits.">
                <langSet xml:lang="en-US"><tig><term>Data used by VoLTE does not count against your data plan limits.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᎬᏔᏅᎢ ᎬᏗ VoLTE ᎥᏝ ᎠᏎᏍᏗ ᏗᎦᏘᎸᏛ ᏂᏨᎤᎢ ᎦᏟᏌᏅᎯ ᏗᎫᎪᏔᏂᏙᎸᎯ ᏓᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't show this warning again">
                <langSet xml:lang="en-US"><tig><term>Don't show this warning again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏍᏗ ᎠᏓᏕᏯᏔᎲᏍᎩ ᏏᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Must use for update">
                <langSet xml:lang="en-US"><tig><term>Must use for update</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᎬᏔᏂᏓᏍᏗ ᎤᎬᏩᏟ ᏗᎪᏢᎯᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Configuration file version: ">
                <langSet xml:lang="en-US"><tig><term>Configuration file version: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏛ ᎪᏢᏒᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏄᏓᎴᏒᎢ: </term></tig></langSet>
            </termEntry>
            <termEntry id="Sync failed!">
                <langSet xml:lang="en-US"><tig><term>Sync failed!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᎭ ᏥᏄᎵᏍᏔᏅᎢ ᎤᏄᎸᏅᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Override version less than">
                <langSet xml:lang="en-US"><tig><term>Override version less than</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏭᎯᎳᏛ ᏄᏓᎴᏒᎢ ᏩᎦᏲᏢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This setting will automatically be reset upon entry to a new country.">
                <langSet xml:lang="en-US"><tig><term>This setting will automatically be reset upon entry to a new country.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᏕᎦᎧᎲᎢ ᎠᏎ ᎤᏩᏌᏊ ᎢᏯᏓᏛᏁᎯ ᎨᎡᎢ ᏥᎯᎧᎲᎦ ᎾᎿᎢ ᎥᎧᏁᏉᎢᏍᏙᏗ ᎾᎿᎢ Ꭰ ᏗᏤ ᎠᏰᏟ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Voice Over LTE for voice calls">
                <langSet xml:lang="en-US"><tig><term>Use Voice Over LTE for voice calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ ᎤᏁᎬ ᎢᏴᏛ LTE ᎤᎬᏩᏟ ᎤᏁᎬ ᏓᏯᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wi-Fi networks not found">
                <langSet xml:lang="en-US"><tig><term>Wi-Fi networks not found</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Wi-Fi ᏚᎾᏚᏓᎵ ᎥᏝ ᎤᏩᏛᎲᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable Wi-Fi Calling service">
                <langSet xml:lang="en-US"><tig><term>Disable Wi-Fi Calling service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ Wi-Fi ᏓᏯᏂᏍᎬ ᎤᎾᏓᏍᏕᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="International warning">
                <langSet xml:lang="en-US"><tig><term>International warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Passpoint Networks">
                <langSet xml:lang="en-US"><tig><term>Passpoint Networks</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯ ᏩᏎᎯᎯ ᏚᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Press back to cancel at any time.">
                <langSet xml:lang="en-US"><tig><term>Press back to cancel at any time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᏨᏍᏗ ᎾᎿᎢ ᎠᏎᏒᏗ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We're having trouble with Wi-Fi Calling, and can't open it right now.">
                <langSet xml:lang="en-US"><tig><term>We're having trouble with Wi-Fi Calling, and can't open it right now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗ ᎤᎲᎢ ᎤᏪᎵᎯᏍᏗ ᎬᏗ Wi-Fi ᏓᏯᏂᏍᎬ, ᎠᎴ ᏝᏰᎵ ᎯᏍᏚᎢ it ᎠᎭᏂᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap here to retry later.">
                <langSet xml:lang="en-US"><tig><term>Tap here to retry later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎭᏂ ᎾᎿᎢ ᏥᎭᏁᎸᏓ ᎣᏂᏯᎨᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Carrier Config Channel">
                <langSet xml:lang="en-US"><tig><term>Carrier Config Channel</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏫᏗᏍᎩ ᏄᏍᏛ ᎪᏢᏒᎢ ᎦᎳᏅᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Check for new device configurationCurrent version ">
                <langSet xml:lang="en-US"><tig><term>Check for new device configurationCurrent version </term></tig></langSet>
