                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎤᎦᏎᏍᏗᏕᎩ ᏂᏚᏩᎿ ᏩᎦᏔᎲᎾ ᎤᎾᎢ ᏧᎾᏚᏓᎵ ᏄᏛᏁᎸᏅ ᎠᏍᏆᏂᎪᏗᏍᎩ, ᎦᏙᎤᏍᏗ ᎠᏓᏴᎵᏛᏍᎩ ᏓᏓᏅᏓᏁᎸ ᎤᎾᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your admin is capable of monitoring your network activity including emails, apps, and websites.">
                <langSet xml:lang="en-US"><tig><term>Your admin is capable of monitoring your network activity including emails, apps, and websites.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᏨᎤᎢ ᎤᎦᏎᏍᏗᏕᎩ ᏄᏍᏛ ᏰᎵᏉ ᎢᎬᏁᏗ ᎤᎿᎢ ᎠᏓᏴᎵᏛᏍᎩᏂᏨᏅᎢ ᏧᎾᏚᏓᎵ ᎾᏛᏁᎲ, ᎠᏠᏯᏍᏗᏍᎩ ᏗᎾᎦᎵᏍᎩ ᏗᎪᏪᎵ, ᏗᎬᏙᏗ, ᎠᎴ ᎤᏂᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch output device">
                <langSet xml:lang="en-US"><tig><term>Switch output device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎦᏁᏟᏴᏍᎬᎢ ᏚᏬᏢᏅᎩ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="App is pinned">
