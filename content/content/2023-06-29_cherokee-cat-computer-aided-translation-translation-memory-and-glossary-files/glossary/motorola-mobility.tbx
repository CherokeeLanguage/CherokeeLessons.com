            <termEntry id=" recommends a strong PIN or password and may not work as expected without one">
                <langSet xml:lang="en-US"><tig><term> recommends a strong PIN or password and may not work as expected without one</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎦᎸᏉᏙᏗ ᎤᎱᏍᏘ PIN ᏃᎴ ᎥᎧᏁᎬᎢ ᎠᏍᏚᎢᏍᏙᏗ ᏃᎴ ᏰᎵᏉ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎯᎢᎾᎢ ᎤᏚᎩ ᎤᏩᏌ ᏄᏠᏯᏍᏛᎾ ᏌᏊ</term></tig></langSet>
            </termEntry>
