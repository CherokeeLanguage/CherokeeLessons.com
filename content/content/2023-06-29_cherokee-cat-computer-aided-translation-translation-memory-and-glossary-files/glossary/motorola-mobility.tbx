                <langSet xml:lang="en-US"><tig><term>You are now  steps away from being a developer.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎵᏍᏈᏗ Ꭷ  ᎢᏯᎳᏍᎬᏓ ᎤᏣᏘᎾ ᏅᏓᏳᏓᎴᏅᎯ ᎠᎴᏂᏙᎲ Ꭰ ᎪᏢᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Preview, page  of ">
                <langSet xml:lang="en-US"><tig><term>Preview, page  of </term></tig></langSet>
