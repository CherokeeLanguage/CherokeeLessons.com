            </termEntry>
            <termEntry id="Your face model will be permanently and securely deleted.">
                <langSet xml:lang="en-US"><tig><term>Your face model will be permanently and securely deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᎠᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You\u2019ve reached the maximum number of attempts">
                <langSet xml:lang="en-US"><tig><term>You\u2019ve reached the maximum number of attempts</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᏭᎷᏨᎩ ᏥᎩ ᎦᎸᎳᏗᎨ ᎠᏎᏍᏗ ᎤᎿ ᏚᎾᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Require pattern to start your device?">
                <langSet xml:lang="en-US"><tig><term>Require pattern to start your device?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏯᏛᏁᏗ ᏗᏟᎶᏍᏙᏗ ᎾᎢ ᎠᏂᎩᏍᏙᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
