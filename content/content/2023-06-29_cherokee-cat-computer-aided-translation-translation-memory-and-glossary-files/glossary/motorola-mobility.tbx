                <langSet xml:lang="chr"><tig><term> SIMs</term></tig></langSet>
            </termEntry>
            <termEntry id="You must start with a charged battery and keep your phone plugged in throughout the process.">
                <langSet xml:lang="en-US"><tig><term>You must start with a charged battery and keep your phone plugged in throughout the process.</term></tig></langSet>
