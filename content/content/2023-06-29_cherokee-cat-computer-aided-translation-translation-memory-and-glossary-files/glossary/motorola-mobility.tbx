                <langSet xml:lang="en-US"><tig><term>Included packages</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏔᏅ ᏕᎦᏇᏅᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharging your device can shorten the lifespan of your battery. Overcharge protection keeps your battery healthy by limiting charging to  when your device has been plugged in continuously for 3 days.">
                <langSet xml:lang="en-US"><tig><term>Overcharging your device can shorten the lifespan of your battery. Overcharge protection keeps your battery healthy by limiting charging to  when your device has been plugged in continuously for 3 days.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗ ᎬᎾᎦᎵᏍᏗᏍᎬᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏣᏤᎵ ᏰᎵᏯ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎥᏍᎩᎾ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎨᎡᎢ ᎠᎴᏂᏙᎲᎢ ᏫᎬᏍᏗ ᎠᎾᎦᎵᏍᎩ. ᎦᎸᎳᏗᏨ ᏗᎬᏩᎶᏙᏗ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᏓᏍᏆᏂᎪᏗ ᎠᎾᎦᎵᏍᎩ ᏅᏩᏙᎯᏯᏛ ᎬᏗ ᏳᏰᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎾᎿᎢ  ᎢᏳᏃ ᏥᏂᎬᏅᏗᏓᎾ ᏂᎦᎵᏍᏓ ᎤᏊᏄᎾᏘ ᎾᎿ ᏫᎬᎵᏱᎵᏒᏊ ᎤᎬᏩᏟ 3 ᏧᏒᎯᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Clear text from search box">
                <langSet xml:lang="en-US"><tig><term>Clear text from search box</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎵᎦᎵᏯ ᎪᏪᎳᏅᎢ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏱᏍᏗ ᎧᏁᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make sure your texts are coming through.">
                <langSet xml:lang="en-US"><tig><term>Make sure your texts are coming through.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏳᎢ ᏚᏳᎬᏛ ᎨᏎᏍᏗ ᏂᏨᎤᎢ ᎪᏪᎳᏅᎢ ᎨᎡᎩ ᏓᏯᎢ ᎠᎦᏛᎴᏍᎩ.</term></tig></langSet>
            </termEntry>
