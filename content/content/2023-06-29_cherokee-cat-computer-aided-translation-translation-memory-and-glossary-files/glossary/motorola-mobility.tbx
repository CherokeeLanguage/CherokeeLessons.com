            <termEntry id="Headphones act as an antenna for the radio, so you may experience lower audio quality if you don’t plug them in. If you’d like to listen on another device, choose from the options below.">
                <langSet xml:lang="en-US"><tig><term>Headphones act as an antenna for the radio, so you may experience lower audio quality if you don’t plug them in. If you’d like to listen on another device, choose from the options below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏳᏙᎾᏗᏍᏗ ᎠᎵᏁᎩ ᎤᎿᎢ Ꭰ ᎫᏓᎸᎢ ᎤᎬᏩᏟ ᏥᎩ ᎦᏬᏂᏍᎩ, ᏓᏛ ᏂᎯ ᏰᎵᏯ ᎠᎦᏙᎲᏒᎢ ᎡᎳᏗᏨ ᎤᏃᏴᎬ ᎢᏲᏍᏓ ᎨᎡᎢ ᏂᎯ ᏝᏍᏗ ᎠᏍᏚᏙᏗ ᎢᏯᏂᎢ ᎾᎿ. ᎨᎡᎢ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎭᏛᏓᏍᏓ ᎤᎿᎢ ᏄᏓᎴ ᏥᏂᎬᏅᏗᏓᎾ, ᏣᏑᏰᏍᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎠᏑᏰᏍᏗᎢ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on a category below for sample commands you can try.">
                <langSet xml:lang="en-US"><tig><term>Tap on a category below for sample commands you can try.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎡᎳᏗᏨ ᎤᎬᏩᏟ ᏱᏓᏟᎶᏍᏔᏂ ᏚᏁᏤᎸᎩ ᏂᎯ ᏰᎵᏯ ᏣᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Install the Moto feedback assistant to get started">
                <langSet xml:lang="en-US"><tig><term>Install the Moto feedback assistant to get started</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏘᏅᏛᎦ ᎾᏍᎩ Moto ᎦᏬᎯᎵᏴᏓ ᎤᏂᏍᏕᎸᎯᏙᎯ ᎾᎢ ᎭᎴᏅᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cannot change appearance while application is pinned">
                <langSet xml:lang="en-US"><tig><term>Cannot change appearance while application is pinned</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎯᏁᏟᏴᎾ ᎤᎾᏄᎪᏨᎯ ᎾᎯᏳᎢ ᎬᏙᏗ ᎨᎡᎢ ᎦᎭᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enhance touch response for quicker interactions">
                <langSet xml:lang="en-US"><tig><term>Enhance touch response for quicker interactions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᎴᏍᏗ ᎠᏒᏂᏍᏗ ᎤᏁᏨᎯ ᎤᎬᏩᏟ ᏄᎵᏍᏛᏊ ᏂᏓᏓᎳᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose an app below to start a video chat">
                <langSet xml:lang="en-US"><tig><term>Choose an app below to start a video chat</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ Ꭰ ᎬᏙᏗ ᎡᎳᏗᏨ ᎾᎿᎢ ᎭᎴᎾ Ꭰ ᏗᏓᏴᎳᏛᏍᎩ ᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime gives you easy access to tools and settings that enhance your gaming experience">
                <langSet xml:lang="en-US"><tig><term>Gametime gives you easy access to tools and settings that enhance your gaming experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏣᏁᎭ ᎠᎯᏗᎨᎢ ᎠᏴᏍᏗ ᎾᎾᎢ ᏗᎬᏔᏂᏓᏍᏗ ᏃᎴ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾᎢ ᏓᏤᎴᏍᏗ ᏣᏤᎵ ᏕᎭᏁᎸᏗᏍᎬ ᏣᎦᏙᎲᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data subscription change in progress">
                <langSet xml:lang="en-US"><tig><term>Data subscription change in progress</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᏗᎦᏁᏍᏍᎩ ᎤᏓᏁᏟᏴᏓ ᎠᎵᏱᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="My moments can\’t be updated because Gametime is off. You can turn it on in Gametime Settings">
                <langSet xml:lang="en-US"><tig><term>My moments can\’t be updated because Gametime is off. You can turn it on in Gametime Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏆᏤᎵ ᏂᏕᎦᎵᏍᏗᏍᎬᎢ ᏝᏰᎵ\ ᎨᏒᎢ ᎪᏢᎯᏐᏗ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏄᏍᏛ ᎠᏍᏚᎭ. ᏂᎯ ᏰᎵᏊ ᏱᏍᏚᎢ ᎾᎿᎢ ᏗᏁᎸᏙᏗ ᎠᏟᎢᎵᏒ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Game tool background Data">
                <langSet xml:lang="en-US"><tig><term>Game tool background Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎬᏔᏂᏓᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime doesn't control how third party apps appear in freeform mode. Certain app features may not be available or fully functioning in freeform mode.">
                <langSet xml:lang="en-US"><tig><term>Gametime doesn't control how third party apps appear in freeform mode. Certain app features may not be available or fully functioning in freeform mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏝᏍᏓ ᎠᎯᎸᏍᏗ ᏰᎵ ᏦᎢᏁ ᎾᏓᏟᏌᎲ ᏗᎬᏙᏗ ᎦᎾᏄᎪᎦ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ. ᏑᏓᎴᎩ ᎬᏙᏗ ᏗᎦᏎᏍᏙᏗ ᏰᎵᏉ ᎭᏗ ᎨᏒᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎠᎴᏃ ᎧᎵᏬᏒᎢ ᏧᏂᎸᏫᏍᏓᏗ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use DND features,  needs permission to access Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>To use DND features,  needs permission to access Do Not Disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ ᏗᎦᏎᏍᏙᏗ,  ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data will always turn off when you’re connected to a Wi-Fi network">
                <langSet xml:lang="en-US"><tig><term>Mobile data will always turn off when you’re connected to a Wi-Fi network</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏂᎪᎸᎢ ᎠᏍᏚᎯᏍᎩ ᎥᏍᏴ ᏕᏧᏓᎸᏅᎯ ᎾᎢ WiFi ᏧᎾᏚᏓᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't connect to network. Please try again later.">
                <langSet xml:lang="en-US"><tig><term>Can't connect to network. Please try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏧᏓᏢᎢ ᎾᎢ ᎤᏚᏓᎵ ᎰᏩᏊ ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Gametime can display content around the camera cutout for a full screen experience. You can turn it on anytime by going to Moto &gt; Moto Gametime &gt; Settings. Games may restart after you turn on full screen">
                <langSet xml:lang="en-US"><tig><term>Moto Gametime can display content around the camera cutout for a full screen experience. You can turn it on anytime by going to Moto &gt; Moto Gametime &gt; Settings. Games may restart after you turn on full screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏰᎵᏊ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎦᎸᏛᎢ ᎬᏩᏕᏱᏛ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎦᏖᏅᏕᏓ ᎾᏍᎩ ᎧᎵᎢ ᎠᏴᏙᎳᏛᎢ ᎠᎦᏙᎲᏒᎢ. ᏂᎯ ᏰᎵᏊ ᏱᏍᏚᎢ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ ᎬᏗ ᎮᎬᎢ ᎾᎾᎢ Moto &gt; Moto ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ &gt; ᏕᎦᎧᎲᎢ. ᏧᎾᏁᎶᏗ ᏰᎵᏊ ᏥᎭᏂᎩᏍᏓ ᎤᏟ ᏭᏩᏚᏛᎢ ᎯᏍᏚᎢᏍᎬ ᎧᎵᎢ ᎠᏴᏙᎳᏛᎢ ᎪᏕᏍᏗᎢ ᏗᏐᎥᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Brighten the screen in dark scenes to show more details">
                <langSet xml:lang="en-US"><tig><term>Brighten the screen in dark scenes to show more details</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᎪᏍᏓᎨᏍᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎤᎵᏏᎩ ᏗᎧᎾᏂᏓᏍᏗ ᎾᎢ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᏥ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Answer calls in the background and keep games on the screen">
                <langSet xml:lang="en-US"><tig><term>Answer calls in the background and keep games on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏬᎯᎵᏴᏛ ᏫᏗᎬᏔᏅ ᎾᎿᎢ ᎾᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᏃᎴ ᎠᏍᏆᏂᎪᏙᏗ ᏧᎾᏁᎸᏙᏗ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Data">
                <langSet xml:lang="en-US"><tig><term>Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Games that support acoustic lights are listed below. You can also turn this feature on in the sidebar while you’re gaming.">
                <langSet xml:lang="en-US"><tig><term>Games that support acoustic lights are listed below. You can also turn this feature on in the sidebar while you’re gaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏁᎸᏙᏗ ᎾᏍᎩᎾᎢ ᎦᎫᏍᏛᏓ ᏃᏌᏅ ᎤᏃᏴᎵᏓ ᏓᏨᏍᏛ ᏕᎦᏅᏛᎢ ᎡᎳᏗᏨ. ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᏱᏍᏚᎢ ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎾᎿᎢ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎾᎯᏳᎢ ᏂᎯZ ᏕᎭᏁᎸᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Find tools &amp; settings to enhance your gaming experience">
