                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᎭᏢᏃ ᏥᏳᎪᏗ ᎢᎬᏁᎯ ᎠᏰᏙᎳᏛᎢ ᎬᏂᎨᏒᎢ ᎤᎿᎢ ᏥᎩ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only get notified by important people and apps">
                <langSet xml:lang="en-US"><tig><term>Only get notified by important people and apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᎠᎩᏃᎯᏎᎸ ᎤᎵᏍᎨᏓ ᎠᏂᏴᏫ ᏃᎴ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You are currently in the international roaming, mobile data is turned on, please note that local charges.">
                <langSet xml:lang="en-US"><tig><term>You are currently in the international roaming, mobile data is turned on, please note that local charges.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎾᏍᎩ ᏃᏊ ᏥᎩ ᎾᎿ ᎠᏰᎵ ᏚᏓᏂᏴᏛ ᎡᏙᎵᏙᎲ, ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎠᏍᏚᎢᏓ, ᎰᏩᏊ ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ ᎡᏍᎦᏂ ᏓᏰᎫᎢᏍᏔᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can go to Settings to grant permission to multiple apps so they\’re ready to open anytime.">
                <langSet xml:lang="en-US"><tig><term>You can go to Settings to grant permission to multiple apps so they\’re ready to open anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ Ꭷ ᏕᎦᎧᎲᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿᎢ ᎢᎸᏍᎩ ᏗᎬᏙᏗ ᏓᏛ ᎾᏍᎩᏛ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎠᏍᏚᎢᏓ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not restore">
                <langSet xml:lang="en-US"><tig><term>Do not restore</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᏥᎰᏢᎯᏌᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="When connected to an external display the stylus acts as a mouse">
                <langSet xml:lang="en-US"><tig><term>When connected to an external display the stylus acts as a mouse</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎫᏓᎸᏅᎯ ᎾᎢ ᏙᏯᏗᏜ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᎯᎢᎾᎢ ᏥᏍᏕᏥ ᎢᏳᏍᏗ ᎾᏛᏁᎲᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="When phone connects to external display, stylus acts as an air mouse auto.">
                <langSet xml:lang="en-US"><tig><term>When phone connects to external display, stylus acts as an air mouse auto.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏗᏟᏃᎴᏗ ᏕᎫᏓᎸᎢ ᎾᎢ ᏙᏱᏗᏢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ, ᏗᎪᏪᎳᏅ ᎯᎢᎾᎢ ᎤᏃᎴ ᏥᏍᏕᏥ ᎢᏳᏍᏗ ᎾᏛᏁᎲᎢ ᎤᏩᏒ ᎠᎾᎩᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Weather">
                <langSet xml:lang="en-US"><tig><term>Weather</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏱᏗᏣ ᏂᎦᎵᏍᏔᏅᎲᏍᎬᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you’re ready to take notes, draw, and get creative anytime!">
                <langSet xml:lang="en-US"><tig><term>Now you’re ready to take notes, draw, and get creative anytime!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎿᏉ ᏂᎯ ᎾᏍᎩ ᏣᏛᏅᎢᏍᏓ ᎾᎢ ᏙᏪᎸᎦ ᏧᏍᏗ ᏕᎪᏪᎸ, ᏔᎵᎶᏍᏓ, ᎠᎴ ᎪᏢᏔᏅᏗ ᎿᏛᎦ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on Bluetooth for Moto stylus">
                <langSet xml:lang="en-US"><tig><term>Turn on Bluetooth for Moto stylus</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎢᏍᏗ ᏌᎪᏂᎨ ᎠᏓᎾᏙᏓ ᎾᏍᎩᎾ Moto ᏗᎪᏪᎳᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="application logo icon">
                <langSet xml:lang="en-US"><tig><term>application logo icon</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏲᏍᏙᏗ ᎠᎢᎧᏂ ᏚᏙᏍᏛ ᎪᏪᎶᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose the types of apps that appear in the external display app tray">
                <langSet xml:lang="en-US"><tig><term>Choose the types of apps that appear in the external display app tray</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏥᎩ ᎢᏧᏍᏗ ᎾᎿ ᏗᎬᏙᏗ ᎥᏍᎩᎾ ᎬᏂᎨᏒᎢ ᎾᎿ ᏥᎩ ᏙᏱᏗᏢ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ ᎠᏝᏅᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on now">
                <langSet xml:lang="en-US"><tig><term>Turn on now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᎯᏍᏚᎲᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter your current backup password below:">
                <langSet xml:lang="en-US"><tig><term>Please enter your current backup password below:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏓ ᏣᏤᎵ ᏃᏊ ᏥᎩ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Some apps may need permission to open on the external display.">
                <langSet xml:lang="en-US"><tig><term>Some apps may need permission to open on the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᎤᏚᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᎿᎢ ᎠᏍᏚᎢᏓ ᎾᎿᎢ ᏥᎩ ᏙᏱᏗᏢ ᎠᏰᏙᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Then, push it until it locks in place.">
                <langSet xml:lang="en-US"><tig><term>Then, push it until it locks in place.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎿᏉZ, ᎦᏌᏙᏯᏍᏗ ᎾᏍᎩ ᎩᎳᏃ ᏍᏓᏯ ᏓᎵᏍᏚᎲᏍᎦ ᎾᎿᎢ ᎤᏙᏢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Please enter your device encryption password below.">
                <langSet xml:lang="en-US"><tig><term>Please enter your device encryption password below.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏴᏍᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏕᎵᏍᏙᏗ ᏱᎦᏪᏍᏗ ᎥᎧᏁᎬᎢ ᎡᎳᏗᏨ.</term></tig></langSet>
            </termEntry>
            <termEntry id="close application">
                <langSet xml:lang="en-US"><tig><term>close application</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do Not Disturb behavior">
                <langSet xml:lang="en-US"><tig><term>Do Not Disturb behavior</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎠᏓᏅᏖᏗ ᎢᏯᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're ready to use your fingerprint to unlock, log in and make payments">
                <langSet xml:lang="en-US"><tig><term>You're ready to use your fingerprint to unlock, log in and make payments</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᎯᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ, ᎯᏴᏍᏗ ᎠᎴ ᎠᏃᏢᏍᎪ ᏈᏴᎲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not connected">
                <langSet xml:lang="en-US"><tig><term>Not connected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏱᎫᏓᎸᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't open file">
                <langSet xml:lang="en-US"><tig><term>Can't open file</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎯᏍᏚᎢ ᎠᏍᏆᏂᎪᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Adjust camera settings during a video call">
                <langSet xml:lang="en-US"><tig><term>Adjust camera settings during a video call</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᎩ ᏗᏓᏟᎶᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ ᎾᎯᏳ Ꭰ ᏗᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to navigate with simple gestures">
                <langSet xml:lang="en-US"><tig><term>Learn how to navigate with simple gestures</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏙᎡᎵ ᎾᎿᎢ ᎪᏪᎸ ᎠᏓᏅᏏᏓᏍᏗ ᎠᎯᏓ ᏧᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn how to get around your phone with simple gestures. You can change your navigation preferences in Settings anytime.">
                <langSet xml:lang="en-US"><tig><term>Learn how to get around your phone with simple gestures. You can change your navigation preferences in Settings anytime.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏕᎶᏆᏍᏗ ᏙᎡᎵ ᎾᎿᎢ ᎠᎩᏍᏗ ᎠᏕᏯᏍᏗ ᏗᏟᏃᎮᏗ ᏣᏤᎵ ᎬᏗ ᎠᎯᏓ ᏧᏬᏯᏂᏍᎩ. ᏰᎵᏯ ᏣᏁᏟᏴᏍᏗ ᎠᏓᏘᏂᏙᎯ ᏣᏤᎵ ᎤᏟᎠᏰᎸᏍᎬᎢ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from the bottom of the screen and hold">
                <langSet xml:lang="en-US"><tig><term>Swipe up from the bottom of the screen and hold</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎾᎿᎢ ᎡᎳᏗᏨ ᎾᎿ ᏥᎩ ᎠᏴᏙᎳᏛᎢ ᎠᎴ ᎯᏂᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="This app is needed for your profile and can't be uninstalled.">
                <langSet xml:lang="en-US"><tig><term>This app is needed for your profile and can't be uninstalled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᎾᏍᎩ ᎤᏚᎸᏛ ᎾᏍᎩᎾ ᏣᏤᎵ ᎤᎧᏛ ᏃᎴ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᎤᎦᏘᏅᏕᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Almost, try again">
                <langSet xml:lang="en-US"><tig><term>Almost, try again</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎥᏂᎨᏍᏗ, ᏏᏊ ᎭᏁᎸᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up from the bottom of the screen">
                <langSet xml:lang="en-US"><tig><term>Swipe up from the bottom of the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏥᎩ ᎭᏫᏂ ᎾᎿᎢ ᎠᏴᏙᎳᏛᎢ ᏣᏤᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="Webcam">
                <langSet xml:lang="en-US"><tig><term>Webcam</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏏᎳᏕᏫᏒ ᏗᏓᏟᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your TV and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your TV or loss of data that may result from its use.">
                <langSet xml:lang="en-US"><tig><term>Your TV and personal data are more vulnerable to attack by unknown apps. By installing this app, you agree that you are responsible for any damage to your TV or loss of data that may result from its use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏒᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᎾᎦᎳᎢ ᏗᎦᏘᎴᎩ ᏄᏩᏅ ᎬᎪᏟᏍᏗ ᏂᎦᏒᎾ ᏗᎬᏙᏗ. ᎾᏍᎩ ᎦᏘᏅᏛᏍᎬ ᎯᎠ ᎬᏙᏗ, ᏂᎯ ᎣᏏ ᎯᏰᎸᏍᎦ ᎾᏍᎩᎾᎢ ᏂᎯ ᎨᏒ ᏣᏚᏓᎴᏍᏗ ᎾᏍᎩᎾ ᏂᎦᎥ ᎤᏲᏨᎯ ᎾᎢ ᏣᏤᎵ ᎠᏓᏴᎳᏛᏍᎩ ᎠᎴᏃ ᏣᏲᎱᏎᎸ ᎾᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾᎢ ᏰᎵᏉ ᎢᎬᏩᎵᏍᏙᏗ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" is not allowed to make phone calls">
                <langSet xml:lang="en-US"><tig><term> is not allowed to make phone calls</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> Ꮭ ᏴᏞᏍᎪᏞᏓ ᏗᏢᏃᎮᏗ ᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't load widget">
                <langSet xml:lang="en-US"><tig><term>Can't load widget</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᏴᎯᏢᎦ ᏫᏥᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor with your finger and remove it after you feel a vibration. Touch gently to avoid pressing the power key.">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor with your finger and remove it after you feel a vibration. Touch gently to avoid pressing the power key.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏒᏂᎦ ᎠᏩᏘᏍᎩ ᏣᏰᏌᏛ ᎬᏗ ᎠᎴ ᎯᎲᎦ ᎪᎯᏴᎢ ᎠᎵᏖᎸᏗ ᎭᏕᎶᎰᏍᎬ. ᎭᏒᏂᎦ ᏧᏓᎴᏅᏓ ᎾᎿᎢ ᏗᏓᏅᏗᏍᏙᏗ ᎠᏐᎥᏍᏗᏍᎬ ᎤᏟᏂᎩᏓ ᎠᏍᏚᎢᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set by app">
                <langSet xml:lang="en-US"><tig><term>Set by app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᎲᎦ ᎬᏙᏗ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Proxy Auto-Config">
                <langSet xml:lang="en-US"><tig><term>Proxy Auto-Config</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᏙᎥ ᎤᏩᏒ-ᎾᏛᏁ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn on for all apps">
                <langSet xml:lang="en-US"><tig><term>Turn on for all apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏂᎦᏓ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep moving your finger">
                <langSet xml:lang="en-US"><tig><term>Keep moving your finger</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮟ ᎯᏓᏅᏍᏗ ᎯᏰᏒᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Off (Make emergency call)">
                <langSet xml:lang="en-US"><tig><term>Off (Make emergency call)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏚᎭ (ᎤᏟᏍᏗ ᎠᏴᏅᏓ)</term></tig></langSet>
            </termEntry>
            <termEntry id=" app is available">
                <langSet xml:lang="en-US"><tig><term> app is available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎬᏙᏗ ᎠᏛᏅᎢᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="MAC Address exists in list!">
                <langSet xml:lang="en-US"><tig><term>MAC Address exists in list!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎷᎪᏟ ᎾᎿᎨᏒ ᏩᏎᏍᏗ ᎧᏅᎨᏒ ᏄᏍᏓᎢ ᏕᎦᏅᏅᏛ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Install Software Update and Repair tool for your device on a Mac or Windows computer">
                <langSet xml:lang="en-US"><tig><term>Install Software Update and Repair tool for your device on a Mac or Windows computer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏅᏛᎦ ᎦᎾᏗᏅᏗ ᎪᏢᎯᏍᏙᏗ ᎠᎴ ᎣᏍᏓ ᏱᎬᏅᏘ ᎬᏅᏘᏂᏓᏍᏗ ᏗᎬᏛᏂᏓᏍᏗ Mac ᎠᎴ ᏗᏦᎸᏂ ᏗᏍᏆᏂᎪᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="AutomaticDefault">
                <langSet xml:lang="en-US"><tig><term>AutomaticDefault</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ ᏱᎬᏁᎯ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Warning: Your device will be locked after  incorrect attempts. If locked, you must contact your carrier to unlock your device.">
                <langSet xml:lang="en-US"><tig><term>Warning: Your device will be locked after  incorrect attempts. If locked, you must contact your carrier to unlock your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ: ᏍᏓᏯ ᏛᎵᏍᏚᏂ ᏥᏂᏕᎬᏅᏗᏓᏅ  ᏂᏚᏳᎬᏛᎾ ᎤᏁᎸᏙᏗ. ᏍᏓ ᏯᏍᏚᎭ, ᎠᏎ ᏫᏃᏎᏗ ᏧᏛᎴᏅᎲ ᎤᏂᏍᏚᎢᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Turn off for all apps">
                <langSet xml:lang="en-US"><tig><term>Turn off for all apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎲᎦ ᏂᎦᏓ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use VoLTE when available">
                <langSet xml:lang="en-US"><tig><term>Use VoLTE when available</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏓ VoLTE ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile network settings are not available in airplane mode">
                <langSet xml:lang="en-US"><tig><term>Mobile network settings are not available in airplane mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ Ꮭ ᏗᏛᏅᎢᏍᏔᏅ ᏱᎩ ᏥᏳ ᏱᏨᏣᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Higher sensitivity allows you touch contents shown on edges. Lower sensitivity can prevent unintended falsing touch on edges when you simply hold phone with hands">
                <langSet xml:lang="en-US"><tig><term>Higher sensitivity allows you touch contents shown on edges. Lower sensitivity can prevent unintended falsing touch on edges when you simply hold phone with hands</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗ ᎠᏒᏅᏍᏗᎢ ᏱᏨᎵᏍᎪᎵᏓᏏ ᎠᏒᎾᏍᏗ ᏕᎦᎸᏛᎢ ᎤᎾᏓᏎᎮᎸᎩ ᏗᏍᏛᎢ. ᎡᎳᏗᏝ ᎠᏒᏅᏍᏗᎢ ᏴᎵᏍᎪᎵᏗ ᏂᏣᏚᎵᎲᎾ ᏱᎩ ᎠᏒᏅᏍᏗ ᎠᏍᏛᎢ ᎯᏱᏙᎲ ᏗᏝᏃᎮᏗᎢ ᏦᏰᏂ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Warning: Your device will be locked after  incorrect attempt. If locked, you must contact your carrier to unlock your device.">
                <langSet xml:lang="en-US"><tig><term>Warning: Your device will be locked after  incorrect attempt. If locked, you must contact your carrier to unlock your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏔᎲᏍᎩ: ᏍᏓᏯ ᏛᎵᏍᏚᏂ ᏥᏂᏕᎬᏅᏗᏓᏅ  ᏂᏚᏳᎬᏛᎾ ᎤᏁᎸᏙᏗ. ᏍᏓ ᏯᏍᏚᎭ, ᎠᏎ ᏫᏃᏎᏗ ᏧᏛᎴᏅᎲ ᎤᏂᏍᏚᎢᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The SIM card cannot be found. Please insert a valid SIM card and try again.">
                <langSet xml:lang="en-US"><tig><term>The SIM card cannot be found. Please insert a valid SIM card and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮎ SIM ᏗᏆᏂᏲᏍᏓ ᎤᎾᏞᎩ. ᎰᏣᎸᎥᎦ ᏙᎯᏳ SIM ᎢᏆᏂᏲᏍᏗ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This SIM is disabled">
                <langSet xml:lang="en-US"><tig><term>This SIM is disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ SIM ᎠᎴᏫᏍᏙᏓᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="When full screen is on, apps show content across the entire display. Apps may need to restart before the change takes effect. Note: Some apps may not appear as expected when full screen is on.">
                <langSet xml:lang="en-US"><tig><term>When full screen is on, apps show content across the entire display. Apps may need to restart before the change takes effect. Note: Some apps may not appear as expected when full screen is on.</term></tig></langSet>
