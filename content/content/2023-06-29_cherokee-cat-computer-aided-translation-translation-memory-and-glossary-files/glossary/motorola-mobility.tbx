                <langSet xml:lang="en-US"><tig><term>Notification displayed when Data and/or SMS SIM is not configured.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏃᏣᎳᏁᎯ ᎠᏓᏴᎳᏔᏍᎩ ᎢᏳᏃ ᎦᏘᏍᎩᏌᏅᎯ ᏃᎴ/ᏃᎴ SMS SIM ᎨᎡᎢ ᎥᏝ ᏂᏚᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Share files up to \(Each file counts as one message.\)">
                <langSet xml:lang="en-US"><tig><term>Share files up to \(Each file counts as one message.\)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᏍᏗᎢ ᏗᏍᏆᏂᎪᏙᏗᎢ ᏯᏍᏘ \(ᏌᏊᎭ ᎠᏍᏆᏂᎪᏙᏗ ᏗᏎᏍᏗ ᎯᎢᎾᎢ ᏌᏊ ᏗᎦᏃᏣᎳᏅᎯ.\)</term></tig></langSet>
            </termEntry>
            <termEntry id="Your Dual SIM phone is ready.You can change the profile and make other adjustments at any time via the  menu.">
                <langSet xml:lang="en-US"><tig><term>Your Dual SIM phone is ready.You can change the profile and make other adjustments at any time via the  menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ Dual SIM ᏗᏟᏃᎮᏗ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅᎢ.ᏂᎯ ᏰᎵᏯ ᎦᏁᏟᏴᏍᏗ ᏥᎩ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᏃᎴ ᎪᏒᏗ ᏐᎢ ᎾᎿ ᏫᎧᎲᎦ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ ᎾᎿ ᎢᏗᏨ ᏥᎩ  ᎪᏪᎳᎾᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=",  and  left">
                <langSet xml:lang="en-US"><tig><term>,  and  left</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>,  ᏃᎴ  ᎤᏂᎩᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="GOT IT">
                <langSet xml:lang="en-US"><tig><term>GOT IT</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera is performing image processing service">
                <langSet xml:lang="en-US"><tig><term>Camera is performing image processing service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎾᏍᎩ ᏚᎸᏫᏍᏓᏁᎲ ᎤᏓᏴᎳᏛ ᎠᎵᏱᎵᏍᏒᎢ ᎢᏯᏓᏛᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe left below">
                <langSet xml:lang="en-US"><tig><term>Swipe left below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎦᏂᏗᏟ ᎯᏅᎦᎵᏓ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edit with Google Photos">
                <langSet xml:lang="en-US"><tig><term>Edit with Google Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏓ ᎪᏪᎵ ᎬᏗ Google ᏗᏓᏥᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera settings">
                <langSet xml:lang="en-US"><tig><term>Camera settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use the depth editor to select focus, replace the background or select area to change to black and white">
                <langSet xml:lang="en-US"><tig><term>Use the depth editor to select focus, replace the background or select area to change to black and white</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎾᏍᎩ ᎭᏫᏂᏴ ᎣᏍᏓ ᏗᎦᎧᎲᏍᎩ ᎾᎢ ᎠᏑᏰᏓ ᎾᎿᏊ ᎢᎦ ᏫᏔᎧᏅᎦ, ᎦᏁᏟᏴᏍᏓ ᎾᏍᎩ the ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎠᎴᏃ ᎠᏑᏰᏍᏗ ᎢᎬᎾᏕᎾ ᎾᎢ ᎦᏁᏟᏴᏍᏗ ᎾᎢ ᎬᎿᎨ ᏃᎴ ᎤᏁᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist twice to open or switch between selfie and rear cameras">
                <langSet xml:lang="en-US"><tig><term>Twist twice to open or switch between selfie and rear cameras</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵ ᎢᏳᏩᏚᏗ ᎦᏄᏖᏲᎸᎢ ᎾᎢ ᎠᏍᏚᎢᏍᏗ ᎠᎴᏃ ᎦᏁᏟᏴᏍᎩ ᎤᏜᏅᏛ ᎣᏩᏌ ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᎣᏂᏗᏢ ᏗᏓᏟᎶᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="App not updated">
                <langSet xml:lang="en-US"><tig><term>App not updated</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎭᏗ ᎪᏢᎯᏌᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Reduce file size for UHD videos by saving as H.265/HEVC instead of H.264/AVC. Some platforms may not support the HEVC format.">
                <langSet xml:lang="en-US"><tig><term>Reduce file size for UHD videos by saving as H.265/HEVC instead of H.264/AVC. Some platforms may not support the HEVC format.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎦᏲᎳᎨ ᎠᏍᏆᏂᎪᏙᏗ ᎢᎩᏓ ᎾᏍᎩᎾ UHD ᏗᏓᏴᎳᏛᏍᎩ ᎨᏒᎢ ᏗᎵᏏᏅᏗᏍᎩ ᎾᏍᎩ H.265/HEVC ᎤᎬᏫᏳᏎᏍᏗ ᎥᎿᎢ H.264/AVC. ᎢᎦᏓ ᏓᏲᏓᏝᎲ ᏰᎵᏉ ᎭᏗ ᎦᎫᏍᏛᏅ ᏱᎩ ᎾᏍᎩ HEVC ᏱᎬᏁᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To add location information to your photos and videos, turn on location in Settings">
                <langSet xml:lang="en-US"><tig><term>To add location information to your photos and videos, turn on location in Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎧᏁᏉᏍᏗ ᎤᏙᏢᏒᎢ ᎧᏃᎸᎥᏍᎩ ᏣᏤᎵ ᏗᏓᏥᎶᏍᏔᏅ ᏃᎴ ᏗᏓᏴᎳᏛᏍᎩ, ᎯᏍᏚᎢ ᎤᏙᏢᏒᎢ ᎾᎿᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Photo mode active">
                <langSet xml:lang="en-US"><tig><term>Photo mode active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ ᎬᏙᏗᎭ ᎠᎵᏖᎸᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Selfie camera">
                <langSet xml:lang="en-US"><tig><term>Selfie camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the rear camera">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the rear camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎸ ᏣᏤᎵ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᏄᏟᏍᏛ ᎾᎢ ᎠᏚᎢᏍᏓ ᎾᏍᎩ ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera doesn't support split screen">
                <langSet xml:lang="en-US"><tig><term>Camera doesn't support split screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏝᏍᏓ ᎦᎫᏍᏛᏅ ᏱᎩ ᎠᏍᏡᏴ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Ultra-Res to capture photos with the highest resolution. This mode works best in outdoor lighting.">
                <langSet xml:lang="en-US"><tig><term>Use Ultra-Res to capture photos with the highest resolution. This mode works best in outdoor lighting.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᎤᎶᏒᏍᏔᏅ-ᎠᏓᏴᎳᏛᏙᏗ ᎾᎢ ᎦᏂᏴᏗ ᏗᏓᏥᎶᏍᏔᏅ ᎬᏗ ᎾᏍᎩ ᏩᎦᎸᎳᏗᏴ ᎠᏓᏴᎳᏛᏙᏗ. ᎯᎠ ᎬᏙᏗᎭ ᏓᏤ ᏫᏓᏤᎵ ᏚᎸᏫᏍᏓᏁᎲ ᎾᎿᎢ ᏙᏯᏗᏨ ᎠᏨᏍᏛᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="The objects are too close to the background to capture a portrait photo. Normal photo will be captured.">
                <langSet xml:lang="en-US"><tig><term>The objects are too close to the background to capture a portrait photo. Normal photo will be captured.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏃ ᏧᏓᎴᏅᏓ ᎾᏍᎩᏃ ᎠᏍᏚᎭ ᎾᏍᎩ ᎤᎾᏗᏜ ᏄᏍᏗᏓᏅ ᎾᎢ ᎦᏂᏴᏗ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏟᎶᏍᏔᏅ. ᏱᎬᏩᏍᏗᎭᏭ ᏗᏓᏥᎶᏍᏔᏅ ᏰᎵᏉ ᎦᏂᏴᎲᎩ ᎨᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Google Lens isn't working right now. Please relaunch the camera and try again.">
                <langSet xml:lang="en-US"><tig><term>Google Lens isn't working right now. Please relaunch the camera and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Google ᏗᏓᎨᏗ ᏝᏰᏃ ᏚᏳᎪᏛ ᏱᏚᎸᏫᏍᏓᏁ ᏃᏊᎨᏒᎢ. ᎰᏩᏊ ᏥᎭᏂᎩᏍᏓ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏃᎴ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="HDR and Flash will be turned off when you turn on Active Photos">
                <langSet xml:lang="en-US"><tig><term>HDR and Flash will be turned off when you turn on Active Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>HDR ᏃᎴ ᎠᏙᏯᏩᏍᎩ ᎨᏎᏍᏗ ᎠᏍᏚᏗ ᎢᏳᏃ ᏂᎯ ᎯᏍᏚᎢ ᏗᏥᎶᏍᏔᏅᎯ ᏃᎴ ᎤᏍᏆᎳ ᎠᏓᏴᎳᏛᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow this app to control Motorola camera">
                <langSet xml:lang="en-US"><tig><term>Allow this app to control Motorola camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎯᎠ ᎬᏙᏗ ᎾᎢ ᎠᎯᎸᏍᏗ Motorola ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Photos">
                <langSet xml:lang="en-US"><tig><term>Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏥᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Exposure compensation can't be adjusted when shutter speed and ISO are fixed.">
                <langSet xml:lang="en-US"><tig><term>Exposure compensation can't be adjusted when shutter speed and ISO are fixed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᎸ ᎨᎦᏈᏴᏒᏗᏱ ᎨᏒᎢ ᎨᏍᏗ ᏰᎵ ᎨᏒᎢ ᎣᏍᏛ ᎢᎬᏁᎸ ᎾᎯᏳ ᎠᎵᏍᏚᎲᏍᎩ ᎢᎦᏣᎸᎳ ᏃᎴ ISO ᎣᏍᏓ ᏂᏚᏩᎬᏁᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera has been disabled by your administrator">
                <langSet xml:lang="en-US"><tig><term>Camera has been disabled by your administrator</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᎴᏫᏍᏙᏔᏅᎢ ᏂᎦᎵᏍᏓ ᏄᏩᏅ ᏣᏤᎵ ᎤᎦᏎᏍᏗᏕᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically level and implement the rule of thirds">
                <langSet xml:lang="en-US"><tig><term>Automatically level and implement the rule of thirds</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᏥᎶᏍᎩ ᏃᎴ ᎬᏔᏂᏓᏍᏗ ᎾᏍᎩ ᏗᎧᎾᏩᏛᏍᏙᏗ ᎥᎿᎢ ᎠᏂᏦᎢᏁ</term></tig></langSet>
            </termEntry>
            <termEntry id="Pro">
                <langSet xml:lang="en-US"><tig><term>Pro</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏓᎾᏤᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to capture group selfie. Try again.">
                <langSet xml:lang="en-US"><tig><term>Unable to capture group selfie. Try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎢ ᎦᏂᏴᏗ ᎤᎾᏓᏥᏍᎬ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ. ᏏᏊ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera can't be used because another app is using it.">
                <langSet xml:lang="en-US"><tig><term>Camera can't be used because another app is using it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎨᏍᏗ ᏰᎵ ᎨᏎᏍᏗ ᎬᏔᏅᎯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏅᏩᏓᎴᎢ ᎬᏙᏗ ᎾᏍᎩ ᎬᏗᏍᎬ ᎤᏩᏌ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A regular Slow Motion video will be saved at fps">
                <langSet xml:lang="en-US"><tig><term>A regular Slow Motion video will be saved at fps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᎤᏐᏱᎭᏊ ᎤᏍᎦᏃᎳ ᎠᏓᏅᏏᏒᎭ ᎠᏓᏴᎳᏛᏍᎩ ᏰᎵᏉ ᎠᎵᏏᏅᏔᏅᎢ ᎨᏎᏍᏗ ᎤᎾᏃ fps</term></tig></langSet>
            </termEntry>
            <termEntry id="No face detected">
                <langSet xml:lang="en-US"><tig><term>No face detected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᎤᎧᏛ ᎪᎷᏩᏛᏓ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Google Photos">
                <langSet xml:lang="en-US"><tig><term>Google Photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Google ᏗᏓᏥᎶᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to  camera">
                <langSet xml:lang="en-US"><tig><term>Switch to  camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎢ  ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Right after you take a photo, you can show a preview on the external display">
                <langSet xml:lang="en-US"><tig><term>Right after you take a photo, you can show a preview on the external display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎩᎶᏫᏴ ᎤᎶᏐᏅ ᏂᎯ ᏱᏗᏣᏟᎶᏍᏔᎾ, ᏂᎯ ᏰᎵᏊ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎠᏓᎪᏩᏛᏗᏍᎩ ᎤᎾᎢ ᎾᏍᎩ ᏙᏯᏗᏨ ᎬᏂᎨᏒ ᏱᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Double tap the power button to open the camera">
                <langSet xml:lang="en-US"><tig><term>Double tap the power button to open the camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏔᎵᏳᏩᏔ ᎭᏐᎥᏍᏓ ᎾᏍᎩ ᎤᏟᏂᎩᏓ ᎠᏐᎥᏍᏙᏗ ᎾᎢ ᎠᏍᏚᎢᏍᏓ ᎾᏍᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera can't capture video because the recorder is busy. To record a video, stop the current recording or restart.">
                <langSet xml:lang="en-US"><tig><term>Camera can't capture video because the recorder is busy. To record a video, stop the current recording or restart.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎨᏍᏗ ᏰᎵ ᏱᎬᏴᎦᏂᏯ ᎠᏓᏴᎳᏛᏍᎩ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᏍᎩ ᎥᎦᏫᏁᏍᎬ ᎦᏂᏱᏍᎩ ᎾᏍᎩ ᏚᎸᏫᏍᏓᏁᎢ. ᎾᎢ ᎦᏂᏴᏙᏗ ᎾᏍᎩ ᎠᏓᏴᎳᏛᏍᎩ, ᎭᎴᏫᏍᏙᏓ ᎾᏍᎩ ᏃᏊ ᏥᎩ ᎦᏂᏴᏗᏍᎬ ᎠᎴᏃ ᏥᎭᏂᎩᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Remove photo">
                <langSet xml:lang="en-US"><tig><term>Remove photo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎲᎾ ᏗᏓᏥᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Rear photo HDR">
                <langSet xml:lang="en-US"><tig><term>Rear photo HDR</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏂᏗᏢ ᏗᏓᏥᎶᏍᏔᏅ HDR</term></tig></langSet>
            </termEntry>
            <termEntry id="Manual zoom isn't available in Cutout mode">
                <langSet xml:lang="en-US"><tig><term>Manual zoom isn't available in Cutout mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏩᏌ ᏱᎬᏁᏗ ᏧᎻ ᎨᏍᏗ ᏰᎵ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎾᏄᎢ ᎦᏘᏅᏕᏓ ᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use Portrait mode to blur the background for a bokeh effect">
                <langSet xml:lang="en-US"><tig><term>Use Portrait mode to blur the background for a bokeh effect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏓ ᏗᏓᏥᎶᏍᏔᏅ ᎬᏙᏗᎭ ᎾᎢ ᎤᏍᎪᎸ ᎾᏍᎩ ᎣᏂᏗᏜ ᏄᏍᏗᏓᏅ ᎾᏍᎩᎾ ᏗᏓᎨᏗ ᏧᏍᎪᎸᎢ ᏂᏓᎦᎵᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Activity not found">
                <langSet xml:lang="en-US"><tig><term>Activity not found</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᎲᏍᎬᎢ ᎭᏗ ᎠᏩᏛᏓ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Portrait Editor has been replaced by Color Pop in the Google Photos editor">
                <langSet xml:lang="en-US"><tig><term>Portrait Editor has been replaced by Color Pop in the Google Photos editor</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏔᏅ ᎣᏍᏓ ᏗᎦᎧᎲᏍᎩ ᏂᎦᎵᏍᏓ ᎦᏁᏟᏴᏒ ᏄᏩᏅ ᎠᏑᏫᏓ ᎬᏂᎨᏒ ᏄᎵᏍᏔᏅ ᎾᎿᎢ ᎾᏍᎩ Google ᏗᏓᏥᎶᏍᏔᏅ ᏬᏍᏓ ᏗᎦᎧᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unable to capture group selfie. Try rotating the device slower.">
                <langSet xml:lang="en-US"><tig><term>Unable to capture group selfie. Try rotating the device slower.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏓᏄᎸᏅ ᎾᎢ ᎦᏂᏴᏗ ᎤᎾᏓᏥᏍᎬ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ. ᎭᏁᎵᏓ ᎠᏗᏆᎸᏕᏯᏍᏗ ᎾᏍᎩ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏍᎦᏃᎳᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Panorama picture not taken">
                <langSet xml:lang="en-US"><tig><term>Panorama picture not taken</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏖᎾ ᎠᎦᏖᏃᎸᎢ ᎨᏍᏗ ᏗᏥᎶᏍᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Video stabilization can’t be used when Face Beauty is on">
                <langSet xml:lang="en-US"><tig><term>Video stabilization can’t be used when Face Beauty is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏴᎳᏛᏍᎩ ᏙᎯ ᏄᏍᏗᏓᏅᎢ ᎨᏍᏗ ᏰᎵ ᎨᏒᎢ ᎬᏔᏅᎯ ᎾᎯᏳ ᎤᎧᏛ ᎤᏬᏚᎯ ᎾᏍᎩ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap or swipe left to see more modes">
                <langSet xml:lang="en-US"><tig><term>Tap or swipe left to see more modes</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎠᎴᏃ ᎯᏅᎦᎵᏗ ᎠᏍᎦᏂ ᎾᎢ ᎠᎪᏩᏛᏗ ᎤᏥ ᎢᎦᎢ ᏗᎬᏙᏗᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="Selfie photo mirror">
                <langSet xml:lang="en-US"><tig><term>Selfie photo mirror</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏓᏓᏟᎶᏍᏔᏅᎯ ᎤᏐᏱᎨᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stabilization was interrupted. Go to Google Photos to try again.">
                <langSet xml:lang="en-US"><tig><term>Stabilization was interrupted. Go to Google Photos to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏙᎯ ᏄᏍᏗᏓᏅᎢ ᎨᏍᏒ ᎤᏓᏲᏍᏓᏁᎸᎩ. ᎡᏅᏍᏗ ᎾᎾᎢ Google ᏗᏓᏥᎶᏍᏔᏅ ᎾᎢ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to control the Flash and Timer">
                <langSet xml:lang="en-US"><tig><term>Tap to control the Flash and Timer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏐᎥᏍᏓ ᎾᎢ ᎠᎯᎸᏍᏗ ᎾᏍᎩ ᎠᎾᎦᎵᏍᎩ ᏃᎴ ᎠᏥᏱᎵᏒ ᎠᎦᏘᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
