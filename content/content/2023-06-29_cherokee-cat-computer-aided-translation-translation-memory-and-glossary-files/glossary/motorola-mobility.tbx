                <langSet xml:lang="en-US"><tig><term>Screen usage since full charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᎯᏳ ᎧᎵ ᎬᏂᏗᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn Locked mode on &amp; off in the sidebar. It turns off automatically when you receive a phone call or turn off the display.">
                <langSet xml:lang="en-US"><tig><term>You can turn Locked mode on &amp; off in the sidebar. It turns off automatically when you receive a phone call or turn off the display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎠᎦᏔᎲᏍᏗ ᏍᏓᏯ ᎠᏍᏚᎭ ᎬᏙᏗ ᎤᎿᎢ &amp; ᎠᏍᏚᎭ ᎾᎿ ᏥᎩ ᎤᏟᏗᏢ ᎪᏪᎸᎢ. ᎾᎿ ᎠᎦᏔᎲᎠ ᎠᏍᏚᎭ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎢᏳᏃ ᏂᎯ ᎦᏁᏍᏗ Ꭰ ᏗᏟᏃᎮᏗ ᏪᏯᎾ ᏃᎴ ᎠᏍᏚᏗ ᏥᎩ ᎬᏂᎨᏒ ᏱᎬᏁᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs some permissions to provide the best experience. To grant permissions, tap on &quot;Permissions&quot; in App info.">
                <langSet xml:lang="en-US"><tig><term>Gametime needs some permissions to provide the best experience. To grant permissions, tap on "Permissions" in App info.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏚᏚᎸᏛᎢ ᎢᎦᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏓᏁᎳᏁᏗ ᎾᏍᎩ ᏫᏓᏤᏢ ᎤᎦᏙᎲᏒᎢ. ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ, ᎤᎾᎢ ᎭᏐᎥᏍᏓ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᏙᏗ ᎧᏃᎸᎥᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="My moments can\’t be updated because Gametime is off. You can turn it on in Gametime Settings">
                <langSet xml:lang="en-US"><tig><term>My moments can\’t be updated because Gametime is off. You can turn it on in Gametime Settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏆᏤᎵ ᏂᏚᎵᏍᏔᏅᎩ ᎨᏍᏗ ᏰᎵ\ ᎨᏒᎢ ᎪᏢᎯᏌᏅᎢ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᎠᏍᏚᎭ. ᏂᎯ ᏰᎵᏊ ᏱᏍᏚᎢ ᎾᎿᎢ ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime gives you easy access to tools and settings that enhance your gaming experience">
                <langSet xml:lang="en-US"><tig><term>Gametime gives you easy access to tools and settings that enhance your gaming experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏣᏁᎭ ᎠᎯᏗᎨᎢ ᎠᏴᏍᏗ ᎾᎾᎢ ᏗᎬᏔᏂᏓᏍᏗ ᏃᎴ ᏕᎦᎧᎲᎢ ᎾᏍᎩᎾᎢ ᏓᏤᎴᏍᏗ ᏣᏤᎵ ᏕᎭᏁᎸᏗᏍᎬ ᏣᎦᏙᎲᏍᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you block edge display, you won't be able to turn edge display back on with the double tap gesture">
                <langSet xml:lang="en-US"><tig><term>When you block edge display, you won't be able to turn edge display back on with the double tap gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏂᎯ ᎭᎵᏍᏚᏔᏅ ᎠᏍᏛᎢ ᎬᏂᎨᏒ ᏂᎬᏅᎢ, ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎢ ᎠᎦᏔᎲᏍᏙᏗ ᏱᎬᏩᎵᏍᏙᏗ ᎠᏍᏛᎢ ᎬᏂᎨᏒ ᏂᎬᏅᎢ ᏱᎦᎯᏍᏚᎢ ᎬᏗ ᎾᏍᎩ ᏔᎵ ᎢᏳᏩᎫᏗ ᎭᏐᏅᏍᏗᏍᎬᎢ ᏚᏂᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Show date &amp; time on photos">
                <langSet xml:lang="en-US"><tig><term>Show date &amp; time on photos</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎢᏴ ᎢᎪᎯ &amp; ᎠᏥᎢᎵᏒ ᎤᎾᎢ ᏗᏓᏥᎶᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Game tool background Data">
                <langSet xml:lang="en-US"><tig><term>Game tool background Data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎬᏔᏂᏓᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime needs permission to access background data to identify apps as games. Tap &quot;Continue&quot; to grant permission.">
                <langSet xml:lang="en-US"><tig><term>Gametime needs permission to access background data to identify apps as games. Tap "Continue" to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᏚᏚᎸᏛᎢ ᎢᎦᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎢ ᎪᏟᏍᏙᏗ ᏗᎬᏙᏗ ᎾᏍᎩ ᏧᎾᏁᎸᏙᏗ. ᎭᏐᎥᏍᏓ "ᏂᎦᏯᎢᏒᎢ" ᎾᎢ ᎭᎵᏍᎪᎸᏓ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Gametime doesn't control how third party apps appear in freeform mode. Certain app features may not be available or fully functioning in freeform mode.">
                <langSet xml:lang="en-US"><tig><term>Gametime doesn't control how third party apps appear in freeform mode. Certain app features may not be available or fully functioning in freeform mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏁᎸᏙᏗ ᎠᏟᏱᎶᎦ ᏝᏍᏓ ᎠᎯᎸᏍᏗ ᏰᎵ ᏦᎢᏁ ᎾᏓᏟᏌᎲ ᏗᎬᏙᏗ ᎦᎾᏄᎪᎦ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ. ᏑᏓᎴᎩ ᎬᏙᏗ ᏗᎦᏎᏍᏙᏗ ᏰᎵᏉ ᎭᏗ ᎨᏒᎢ ᎠᏛᏅᎢᏍᏔᏅ ᎠᎴᏃ ᎧᎵᏬᏒᎢ ᏧᏂᎸᏫᏍᏓᏗ ᎾᎿᎢ ᎤᏚᏓᎴᏗ ᎠᎧᎵᏏᏐᏗ ᎬᏙᏗᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To use DND features,  needs permission to access Do Not Disturb">
                <langSet xml:lang="en-US"><tig><term>To use DND features,  needs permission to access Do Not Disturb</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏙᏓ ᏗᎦᏎᏍᏙᏗ,  ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎢ ᎠᏴᏍᏗ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Brighten the screen in dark scenes to show more details">
                <langSet xml:lang="en-US"><tig><term>Brighten the screen in dark scenes to show more details</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᎪᏍᏓᎨᏍᏗ ᎾᏍᎩ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᎤᎵᏏᎩ ᏗᎧᎾᏂᏓᏍᏗ ᎾᎢ ᎬᏂᎨᏒ ᎢᎬᏁᏗ ᎤᏥ ᎢᎦᎢ ᏂᏕᎬᎿᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Answer calls in the background and keep games on the screen">
                <langSet xml:lang="en-US"><tig><term>Answer calls in the background and keep games on the screen</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏬᎯᎵᏴᏛ ᏫᏗᎬᏔᏅ ᎾᎿᎢ ᎾᏍᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᏃᎴ ᎠᏍᏆᏂᎪᏙᏗ ᏧᎾᏁᎸᏙᏗ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you turn on Dark aware, the display will brighten to show more detail in dark scenes.">
                <langSet xml:lang="en-US"><tig><term>When you turn on Dark aware, the display will brighten to show more detail in dark scenes.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳᎢ ᏂᎯ ᎯᏍᏚᎢᏒ ᎤᎵᏏᎩ ᎯᎦᏔᎲ, ᎾᏍᎩ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎠᏎᎢ ᎤᏍᎪᏍᏓᎨᏍᏗ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎤᏥ ᎢᎦᎢ ᏄᏍᏗᏓᏅᎢ ᎾᎿᎢ ᎤᎵᏏᎩ ᏗᎧᎾᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Locked mode can\’t turn on when you\’re using another app">
                <langSet xml:lang="en-US"><tig><term>Locked mode can\’t turn on when you\’re using another app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏍᏓᏱ ᎠᏍᏚᎭ ᎬᏙᏗᎭ ᎨᏍᏗ ᏰᎵ\ ᏱᎦᏴᏍᏚᎢ ᎾᎯᏳ ᏂᎯ ᎾᏍᎩ\ ᎬᏗᏍᎬ ᏅᏩᏓᎴᎢ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Games that support acoustic lights are listed below. You can also turn this feature on in the sidebar while you’re gaming.">
                <langSet xml:lang="en-US"><tig><term>Games that support acoustic lights are listed below. You can also turn this feature on in the sidebar while you’re gaming.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏁᎸᏙᏗ ᎾᏍᎩᎾᎢ ᎦᎫᏍᏛᏓ ᏃᏌᏅ ᎤᏃᏴᎵᏓ ᏓᏨᏍᏛ ᏕᎦᏅᏛᎢ ᎡᎳᏗᏨ. ᏂᎯ ᏰᎵᏊ ᎾᏍᏊ ᏱᏍᏚᎢ ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎾᎿᎢ ᎤᏟᏗᏢ ᎪᏪᎸᎢ ᎾᎯᏳᎢ ᏂᎯZ ᏕᎭᏁᎸᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Find tools &amp; settings to enhance your gaming experience">
                <langSet xml:lang="en-US"><tig><term>Find tools &amp; settings to enhance your gaming experience</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏩᏔ ᏗᎬᏔᏂᏓᏍᏗ &amp; ᏕᎦᎧᎲᎢ ᎾᎢ ᏓᏤᎴᏍᏗ ᏕᎭᏁᎸᏗᏍᎬᎢ ᏣᎦᏙᎲᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera preview is off">
                <langSet xml:lang="en-US"><tig><term>Camera preview is off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏓᎪᏩᏛᏗᏍᎩ ᎾᏍᎩ ᎠᏍᏚᎭ</term></tig></langSet>
            </termEntry>
            <termEntry id="When Gametime turns off, your game list no longer updates automatically and moments no longer sync. Do you want to turn off Gametime?">
                <langSet xml:lang="en-US"><tig><term>When Gametime turns off, your game list no longer updates automatically and moments no longer sync. Do you want to turn off Gametime?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ ᎠᎵᏍᏚᏅᎢ, ᏣᏤᏨ ᏗᏁᎸᏙᏗ ᏕᎦᏅᏛᎢ ᎭᏗ ᏃᏊᏃ ᏗᎪᏢᎯᏐᏗ ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᏃᎴ ᏂᏕᎦᎵᏍᏗᏍᎬᎢ ᎭᏗ ᏃᏊᏃ ᎢᏧᎳᎭ ᏱᏂᎦᎵᏍᏗᏍᎨᏍᏗ. ᏣᏚᎵᏍᎪᏃ ᎠᏍᏚᏗ ᏗᏁᎸᏙᏗ ᎠCᏱᎶᎦ?</term></tig></langSet>
            </termEntry>
