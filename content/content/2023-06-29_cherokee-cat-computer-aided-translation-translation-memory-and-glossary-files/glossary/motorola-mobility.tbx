                <langSet xml:lang="chr"><tig><term>ᎨᎡᎢ ᏂᎯ ᎯᏁᏟᏴᎾ ᎤᏚᏓᎵ ᎬᏙᏗ LTE ᎢᏳᎾᏓᏛᏁᏗ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᏂᏲᎱᏎᎸ, ᎬᎵᏱᎵᏒ ᎭᏐᏅᏍᏓ ᎭᏩ</term></tig></langSet>
            </termEntry>
