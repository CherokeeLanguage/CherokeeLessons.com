            <termEntry id="Camera tuning has been updated. Restart your device to continue.">
                <langSet xml:lang="en-US"><tig><term>Camera tuning has been updated. Restart your device to continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏂᎬᎾᏗᏓᏅ ᎣᏍᏓ ᏗᎦᎪᏓ ᎾᏍᎩᎾᏃ ᎪᏢᎯᏌᏅᎢ ᏥᎭᏂᎩᏍᏓ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎢ ᏂᎦᏯᎢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera Tuner">
                <langSet xml:lang="en-US"><tig><term>Camera Tuner</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏂᎬᎾᏗᏓᏅ ᎣᏍᏓ ᏗᎦᎧᎲᏍᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="As a subsidiary of Lenovo, Motorola uses a Lenovo ID to sync your information across devices.">
                <langSet xml:lang="en-US"><tig><term>As a subsidiary of Lenovo, Motorola uses a Lenovo ID to sync your information across devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᎾᏃ ᎭᏫᏂ ᎤᎾᏙᏢᎯ ᎥᎿᎢ ᎴᏃᏉ, Motorola ᏗᎬᏔᏂᏓᏍᏗ ᎾᏍᎩ ᎴᏃᏉ ID ᎾᎢ ᎢᏧᎳᎭ ᏂᎦᎵᏍᏗᏍᎬ ᏣᏤᎵ ᎧᏃᎸᎥᏍᎩ ᏗᎦᎾᏗᏫᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to reset total received and sent data counters?">
