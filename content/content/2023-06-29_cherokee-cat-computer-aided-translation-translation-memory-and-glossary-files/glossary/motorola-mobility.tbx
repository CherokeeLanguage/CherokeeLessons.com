                <langSet xml:lang="chr"><tig><term>* ᎦᏙᏃ ᏤᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎵᏍᏕᎵᏍᎪᎢ ᎢᏳᎵᏍᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Create contact file failed">
                <langSet xml:lang="en-US"><tig><term>Create contact file failed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᎠᏟᏃᎮᏙᏗ ᎠᏍᏆᏂᎪᏙᏗ ᎤᏓᏄᎸᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not charging">
