                <langSet xml:lang="chr"><tig><term>ᎠᏴᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏂᏓᏳᏓᎴᏅ ᎾᏍᎩ ᎢᏯᏛᏁᏗ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To go to the Home screen, swipe up from the bottom of the external display.">
                <langSet xml:lang="en-US"><tig><term>To go to the Home screen, swipe up from the bottom of the external display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎮᎾ ᎾᎿᎢ ᏥᎫ ᎣᏪᏅᏒ ᎠᏴᏙᎳᏛᎢ, ᎦᎶᎯᏍᏗᏍᎩ ᎦᎸᎳᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎾᎿᎢ ᎡᎳᏗᏢ ᎾᎿ ᏥᎩ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch from extended to mirror mode anytime by tapping on the notification on your phone.">
                <langSet xml:lang="en-US"><tig><term>Switch from extended to mirror mode anytime by tapping on the notification on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᏂᏓᏳᏓᎴᏅ ᎦᏅᎯᏛᎯ ᎾᎢ ᎠᏓᎨᏗ ᎬᏙᏗᎭ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ ᎨᏒᎢ ᎭᏐᎥᏍᏗᏍᎬᎢ ᎤᎾᎢ ᏓᏓᏃᏣᎳᏁᎲᎢ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Over Battery Temperature">
                <langSet xml:lang="en-US"><tig><term>Over Battery Temperature</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎤᎶᏒᏍᏔᏅ ᏄᎦᎾᏮᎢ ᎠᏎᎯᎯ</term></tig></langSet>
            </termEntry>
