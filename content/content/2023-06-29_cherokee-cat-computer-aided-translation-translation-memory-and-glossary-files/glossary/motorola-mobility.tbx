            <termEntry id="You\u2019ve chosen to allow this app to create widgets and access their data.">
                <langSet xml:lang="en-US"><tig><term>You\u2019ve chosen to allow this app to create widgets and access their data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᎠᏑᏰᏔ ᎾᎿᎢ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎯᎠ ᎬᏙᏗ ᎾᎿᎢ ᎪᏒᏗ ᏫᏥᏘ ᏃᎴ ᎠᏴᏍᏗ ᎤᎾᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="{count, plural, =1 {1 number is available on this device, but only one can be used at a time} =2 {2 numbers are available on this device, but only one can be used at a time} other {# numbers are available on this device, but only one can be used at a time} }">
                <langSet xml:lang="en-US"><tig><term>{count, plural, =1 {1 number is available on this device, but only one can be used at a time} =2 {2 numbers are available on this device, but only one can be used at a time} other {# numbers are available on this device, but only one can be used at a time} }</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>{count, plural, =1 {1 ᎠᏎᏍᏗ ᏄᏍᏛ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᏎᏃ ᎤᏅᏒ ᏌᏇ ᏰᎵᏯ ᎨᎡᎢ ᎬᏔᏅᎯ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ} =2 {2 ᎠᏎᏍᏗ ᏄᏍᏛ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᏎᏃ ᎤᏅᏒ ᏌᏇ ᏰᎵᏯ ᎨᎡᎢ ᎬᏔᏅᎯ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ} other {# ᎠᏎᏍᏗ ᏄᏍᏛ ᎠᏛᏅᎢᏍᏔᏅ ᎤᎿᎢ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ, ᎠᏎᏃ ᎤᏅᏒ ᏌᏇ ᏰᎵᏯ ᎨᎡᎢ ᎬᏔᏅᎯ ᎤᎿᎢ Ꭰ ᎠᏥᎢᎵᏒ} }</term></tig></langSet>
            </termEntry>
            <termEntry id="Unavailable because location is turned off. Turn on location.">
                <langSet xml:lang="en-US"><tig><term>Unavailable because location is turned off. Turn on location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎤᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎢᎬᏂᏏ ᎮᏙᎲᎢ ᎠᏍᏚᎭ ᎯᏍᏚᎢ ᎮᏙᎲ</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch &amp; hold each time the fingerprint icon moves. This helps capture your full fingerprint.">
                <langSet xml:lang="en-US"><tig><term>Touch &amp; hold each time the fingerprint icon moves. This helps capture your full fingerprint.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ &amp; ᎯᏂᏯ ᎢᏧᎳ ᎠᏥᎢᎵᏒ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᎢᎧᏂ ᏓᎲᏍᎬ. ᎯᎠ ᎠᎵᏍᏕᎵᏍᎪᎢ ᎦᏂᏴᏗ ᏂᏨᎤᎢ ᏧᎧᎵᏨᎯ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can’t take screenshots">
                <langSet xml:lang="en-US"><tig><term>Can’t take screenshots</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎠᎩᏍᏗ ᏓᏴᏙᎳᏛᎢ ᏗᏟᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="A PIN protects your phone if it\u2019s lost or stolen.Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A PIN protects your phone if it\u2019s lost or stolen.Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D PIN ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᏃᎴ ᎦᏃᏍᎩᏓᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device and personal data are more vulnerable to attack by unknown apps. By installing apps from this source, you agree that you are responsible for any damage to your device or loss of data that may result from their use.">
                <langSet xml:lang="en-US"><tig><term>Your device and personal data are more vulnerable to attack by unknown apps. By installing apps from this source, you agree that you are responsible for any damage to your device or loss of data that may result from their use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎨᏒᎢ ᎤᏥ ᎢᎦᎢ ᎠᏩᎾᎦᎳᎢ ᏗᎦᏘᎴᎩ ᏄᏩᏅ ᎬᎪᏟᏍᏗ ᏂᎦᏒᎾ ᏗᎬᏙᏗ. ᎬᏗ ᎦᏘᏅᏛᏍᎦ ᏗᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎯᎠ ᏧᏓᎴᏅᎲᎢ, ᏕᎭᏓᏁᎸᎩ ᎥᏍᎩᎾ ᏂᎯ ᎨᎡᎩ ᎤᎾᏚᏓᎸ ᎤᎬᏩᏟ ᎾᏂᎥᏉ ᎤᏲᏨᎯ ᎾᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᎤᏲᎲᏎᎸ ᎾᎿ ᎦᏘᏍᎩᏌᏅᎯ ᎥᏍᎩᎾ ᏰᎵᏯ ᏄᎵᏍᏔᏅ ᏅᏓᏳᏓᎴᏅᎯ ᎤᎾᏤᎵ ᎬᏔᏂᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable automatic revocation of adb authorizations for systems that have not reconnected within the default (7 days) or user-configured (minimum 1 day) amount of time.">
                <langSet xml:lang="en-US"><tig><term>Disable automatic revocation of adb authorizations for systems that have not reconnected within the default (7 days) or user-configured (minimum 1 day) amount of time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎤᏩᏌ ᏱᎬᏁᎯ ᎥᎦᏃᎯᏍᏗ ᎾᎿ adb ᎠᎵᏍᎪᏟᏙᏗᎢ ᎤᎬᏩᏟ ᏄᏍᏗᏓᏅᎢ ᎨᎡᎩ ᎤᎭ ᎥᏝ ᏙᎫᏓᎸᎲᏍᎩ ᎬᏗ ᏥᎩ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ (7 ᏧᏙᏓᏆᏓ ᎢᎪᎯᏓ) ᏃᎴ ᎬᏗᏍᎩ-ᏂᏚᎵᏍᏙᏗ (ᏭᏍᏗᎬᎢ 1 ᎢᎦ) ᎢᎦᎢ ᎾᎿ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow access to Do Not Disturb for ?">
                <langSet xml:lang="en-US"><tig><term>Allow access to Do Not Disturb for ?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏁᏗ ᎠᏴᏍᏗ ᎾᎢ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎾᏍᎩᎾ ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera access needed">
                <langSet xml:lang="en-US"><tig><term>Camera access needed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏴᏍᏗ ᎤᏚᎸᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow apps and services to scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location-based features and services.">
                <langSet xml:lang="en-US"><tig><term>Allow apps and services to scan for Wi\u2011Fi networks at any time, even when Wi\u2011Fi is off. This can be used, for example, to improve location-based features and services.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᏗᎬᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ ᎾᎿᎢ ᏗᎦᎴᏴᏗᏍᎩ ᎢᏳᏍᏗ ᏗᏥᎶᏍᏙᏗ ᎤᎬᏩᏟ Wi\u2011Fi ᏚᎾᏚᏓᎵ ᎤᎿᎢ ᎾᏂᎥᏉ ᎠᏥᎢᎵᏒ, ᎥᏍᏊ ᎢᏳᏃ Wi\u2011Fi ᎨᎡᎢ ᎠᏍᏚᎭ. ᎯᎠ ᏰᎵᏊ ᎨᏒᎩ ᎬᏔᏅᎯ, ᎤᎬᏩᏟ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎿᎢ ᏦᎦᏤᎳᏍᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ-ᏓᎳᏏᏔᏅᎩ ᏗᎦᏎᏍᏙᏗ ᏃᎴ ᎢᏗᏛᏁᎵᏓᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto-sync data">
                <langSet xml:lang="en-US"><tig><term>Auto-sync data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏆᎴᏅ ᏓᏟᎶᏍᏗᏓᏅ-ᎢᏧᎳᎭ ᏥᏄᎵᏍᏔᏅᎢ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Use locale default">
                <langSet xml:lang="en-US"><tig><term>Use locale default</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ ᎤᎿ ᎨᏒ ᏃᎴ ᎠᏥᎢᎵᏒ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="All apps and data in this session will be deleted.">
                <langSet xml:lang="en-US"><tig><term>All apps and data in this session will be deleted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᏗᎬᏙᏗ ᏃᎴ ᎦᏘᏍᎩᏌᏅᎯ ᎾᎿ ᎯᎠ ᎤᎾᏓᏡᎩ ᎨᏎᏍᏗ ᎠᏍᎪᎸᏛᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="About ">
                <langSet xml:lang="en-US"><tig><term>About </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎸᏨ </term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t unmount SD card. Try again later.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t unmount SD card. Try again later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎥᏝ ᎤᏌᎯᎸ SD ᏆᎾᏲᏍᏗ. ᏏᏊ ᎪᎯᏴ ᎯᎭᏁᎵᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Alarm can override end time">
                <langSet xml:lang="en-US"><tig><term>Alarm can override end time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏕᏯᏙᏗᏍᎩ ᏰᎵᏊ ᏱᏓᏓᏭᎯᎳᏛ ᎬᎵᏍᏆᏗᏍᎩ ᎠᏥᎢᎵᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Device protection features will not work without your screen lock.Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>Device protection features will not work without your screen lock.Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᏓᏍᏆᏂᎪᏗᏍᎩ ᏗᎦᏎᏍᏙᏗ ᎠᏎ ᎥᏝ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏄᏠᏯᏍᏛᎾ ᏂᏨᎤᎢ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ.ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="App data usage">
                <langSet xml:lang="en-US"><tig><term>App data usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Background data">
                <langSet xml:lang="en-US"><tig><term>Background data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose the SIM you prefer for mobile data.">
                <langSet xml:lang="en-US"><tig><term>Choose the SIM you prefer for mobile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏥᎩ SIM ᏂᎯ ᏫᏟ ᎬᏰᎸᏗ ᎤᎬᏩᏟ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Only connect apps if you trust them not to share personal data with your IT admin.">
                <langSet xml:lang="en-US"><tig><term>Only connect apps if you trust them not to share personal data with your IT admin.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᎱᏓᎸᎥᎦ ᏗᎬᏙᏗ if ᏂᎯ ᎰᏩ ᎯᏰᎵᏎᎭ ᎢᏯᏂᎢ ᎥᏝ ᎾᎿᎢ ᎠᏯᏙᏍᏗᎢ ᎤᏩᏌ ᎤᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗ ᏂᏨᎤᎢ IT ᎤᎦᏎᏍᏗᏕᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A pattern protects your phone if it\u2019s lost or stolen.Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A pattern protects your phone if it\u2019s lost or stolen.Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D ᎤᎾᎶᎢᏓ ᎠᏓᎦᏎᏍᏙᏗ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᏃᎴ ᎦᏃᏍᎩᏓᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This can't include an invalid character">
                <langSet xml:lang="en-US"><tig><term>This can't include an invalid character</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎨᏍᏗ ᏰᎵ ᎠᏠᏯᏍᏙᏗ ᎠᎴᏃ ᏂᏓᏓᏂᎸᎬᎾ ᎪᏪᎵ</term></tig></langSet>
            </termEntry>
            <termEntry id="System updates can\u2019t be installed on external media.">
                <langSet xml:lang="en-US"><tig><term>System updates can\u2019t be installed on external media.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ ᎨᏍᏗ ᏰᎵ ᎨᎡᎢ ᎦᏘᏅᏔᏅ ᎤᎿᎢ ᏙᏱᏗᏢ ᎧᏃᎮᏓ ᎠᏗᎦᎴᏯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No data used">
                <langSet xml:lang="en-US"><tig><term>No data used</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏱᎩ ᎬᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don’t allow app to open links">
                <langSet xml:lang="en-US"><tig><term>Don’t allow app to open links</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏤᏍᏗ ᎠᏓᎵᏍᎪᎸᏓᏁᏗ ᎬᏙᏗ ᎾᎢ ᎯᏍᏚᎢ ᏕᎫᏓᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow data roaming?">
                <langSet xml:lang="en-US"><tig><term>Allow data roaming?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Tablet not docked">
                <langSet xml:lang="en-US"><tig><term>Tablet not docked</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏪᎶᏗ ᎭᏗ ᏱᎦᎧᎯ ᎠᏠᏗᏱ</term></tig></langSet>
            </termEntry>
            <termEntry id="This lock can\u2019t be reset by your IT admin. LINK_BEGINSet a separate work lock insteadLINK_END">
                <langSet xml:lang="en-US"><tig><term>This lock can\u2019t be reset by your IT admin. LINK_BEGINSet a separate work lock insteadLINK_END</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏍᏚᎭ ᎨᏍᏗ ᏰᎵ ᎢᎦᎧᎯᎲᏍᏗ ᎬᏗ ᏂᏨᎤᎢ IT ᎤᎦᏎᏍᏗᏕᎩ. LINK_BEGINᎦᎧᎲᎢ ᎠᏰᎵᏱᎦᏛᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏌᏆᎦᏘ ᎠᏍᏚᎭ ᎤᎬᏫᏳᏎᏍᏗLINK_END</term></tig></langSet>
            </termEntry>
            <termEntry id="This SIM can't be erased due to an error.Restart your device and try again.">
                <langSet xml:lang="en-US"><tig><term>This SIM can't be erased due to an error.Restart your device and try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ eSIM ᎨᏍᏗ ᏰᎵ\u2019 ᎨᏒᎩ ᏛᏍᏍᎪᎸᏥ ᏂᎨᏒ ᏂᏗᎦᎵᏍᏙᏗᏍᎬ ᎾᎿᎢ Ꭰ ᏓᏓᎴᎬᎢ.ᏥᎭᏂᎩᏍᏓ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᏥᎭᏁᎸᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The screen lock option is disabled. To learn more, contact your organization's admin. More detailsYou can still use your fingerprint to authorize purchases and app access. Learn more">
                <langSet xml:lang="en-US"><tig><term>The screen lock option is disabled. To learn more, contact your organization's admin. More detailsYou can still use your fingerprint to authorize purchases and app access. Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏍᏓᏱ ᎠᏍᏚᎭ ᎠᏰᏙᎳᏛᎢ ᎠᏑᏰᏍᏗ ᏄᏍᏛ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ. ᎾᎿᎢ ᎤᏥ ᎢᎦᎢ ᎠᏕᎶᏆᏍᏗ, ᎠᏟᏃᎮᏙᏗ ᏂᏨᎤᎢ ᎢᏣᏙᏢᏒᎢ ᎤᎦᏎᏍᏗᏕᎩ. ᎤᎪᏗᏊ ᏂᏕᎬᎿᏅᎢᏂᎯ ᏰᎵᏯ ᎠᏏᏉ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎾᎿᎢ ᎠᎵᏍᎪᏟᏙᏗᎢ ᏗᏩᎯᏍᏗ ᏃᎴ ᎬᏙᏗ ᎠᏴᏍᏗ. ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="NFC exchanges data between this device and other nearby devices or targets, such as payment terminals, access readers, and interactive ads or tags.">
                <langSet xml:lang="en-US"><tig><term>NFC exchanges data between this device and other nearby devices or targets, such as payment terminals, access readers, and interactive ads or tags.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>NFC ᎦᏁᏟᏴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎤᏜᏅᏛ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᏃᎴ ᏐᎢ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᏃᎴ ᎠᏉᏅᏗᎢ, ᏕᎧᏁᎢᏍᏔᏅᎯ ᏗᏈᏴᏗ ᏥᏳ ᏧᏂᎦᏘᏗᏍᏗᎢ, ᎠᏴᏍᏗ ᏗᏂᎪᎵᏰᏍᎩ, ᏃᎴ ᏗᎵᎪᎲᏍᎩ ᏗᎦᏃᏣᎶᏙᏗ ᏃᎴ ᏗᎦᏛᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Switching data SIM, this may take up to a minute\u2026">
                <langSet xml:lang="en-US"><tig><term>Switching data SIM, this may take up to a minute\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ SIM, ᎯᎠ ᏰᎵᏉ ᎢᏯᏔᏬᏍᏔᏅᎢ ᏯᏟᏱᎵᏓ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't find your devices? Scan it with Ready For.">
                <langSet xml:lang="en-US"><tig><term>Can't find your devices? Scan it with Ready For.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎠᏩᏛᏗ ᏂᏨᎤᎢ ᏥᏂᏕᎬᏅᏗᏓᎾ? ᎠᎾᎦᎵᏍᎩ ᏗᏟᎶᏍᏗᏍᎩ ᎨᎡᎩ ᎬᏗ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎤᎬᏩᏟ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network not in range">
                <langSet xml:lang="en-US"><tig><term>Network not in range</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ ᎭᏗ ᎾᎥ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set 2G-3G data limit">
                <langSet xml:lang="en-US"><tig><term>Set 2G-3G data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ 2 G-3 G ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don\u2019t use Wi\u2011Fi hotspot">
                <langSet xml:lang="en-US"><tig><term>Don\u2019t use Wi\u2011Fi hotspot</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏔᏂᏓᏍᏗ Wi\u2011Fi ᎤᏗᏞᎩ ᎤᏓᏓᏢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't wake for notifications">
