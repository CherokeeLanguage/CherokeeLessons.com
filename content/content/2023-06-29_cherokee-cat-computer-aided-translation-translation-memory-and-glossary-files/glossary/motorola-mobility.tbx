                <langSet xml:lang="en-US"><tig><term>Setting up work device\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᎦᎧᎲᎢ ᏗᎦᎸᏫᏍᏓᏅᏗ ᏥᏂᎬᏅᏗᏓᎾ\u2026</term></tig></langSet>
            </termEntry>
            <termEntry id="Permission label to read Moto Gametime provider">
                <langSet xml:lang="en-US"><tig><term>Permission label to read Moto Gametime provider</term></tig></langSet>
