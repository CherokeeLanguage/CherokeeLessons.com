            <termEntry id="Allows the app to access extra location provider commands.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to access extra location provider commands.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎾᏍᎩ ᎬᏙᏗ ᎾᎢ ᎠᏴᏍᏗ ᎧᏁᏉᏓ ᎤᏙᏢᏒᎢ ᎠᏓᏁᏢᏍᎩ ᏕᏁᏤᎸᎩ.</term></tig></langSet>
