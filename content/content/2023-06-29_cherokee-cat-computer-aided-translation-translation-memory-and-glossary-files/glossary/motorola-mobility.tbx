            <termEntry id="Connect to a device by choosing one of the following functions.">
                <langSet xml:lang="en-US"><tig><term>Connect to a device by choosing one of the following functions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎵᎪᏙᏗ ᎾᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎬᏗ ᏌᏊ ᎠᏑᏰᏍᎬ ᎾᏍᎩ ᎠᏍᏓᏩᏛᏍᏗ ᏚᎸᏫᏍᏓᏁᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="If you don't want  to use this feature, tap to open settings and turn it off.">
                <langSet xml:lang="en-US"><tig><term>If you don't want  to use this feature, tap to open settings and turn it off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᏂᏣᏚᎵᏍᎬᏅ ᏱᎩ  ᎾᎢ ᎬᏙᏓ ᎯᎠ ᎠᎦᏎᏍᏙᏗ, ᎭᏐᎥᏍᏓ ᎾᎢ ᎯᏍᏚᎢ ᏕᎦᎧᎲᎢ ᎠᎴ ᎯᏍᏚᎲᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Recent bubbles and dismissed bubbles will appear here">
