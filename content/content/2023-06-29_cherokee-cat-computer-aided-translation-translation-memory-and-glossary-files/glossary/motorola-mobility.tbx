                <langSet xml:lang="chr"><tig><term>ᏗᎧᏃᏗ ᎠᎴ ᎠᏍᎪᎸᏗᏍᏗ ᎠᏠᏯᏍᏛᎢ ᎪᏪᎵ ᎠᏯᏙᏢ ᎾᎯᏳ ᎯᎠ ᏓᏯᏂ ᎾᎿ ᏗᎪᎵᏰᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Location services for your device must be turned on for the app to get location.">
                <langSet xml:lang="en-US"><tig><term>Location services for your device must be turned on for the app to get location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᏢᏒᎢ ᎢᏗᏓᏛᏁᏗ ᎾᏍᎩᎾ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎᎢ ᎨᏒᎢ ᎠᏍᏚᎢᏓ ᎠᏍᏚᎯᏍᏓ ᎾᏍᎩᎾ ᎬᏙᏗ ᎾᎢ ᎠᎩᏍᏗ ᎤᏙᏢᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="can't receive video calls at this time.">
                <langSet xml:lang="en-US"><tig><term>can't receive video calls at this time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎦᏁᏍᏗ ᎠᏓᏴᎳᏛᏍᎩ ᏓᏯᏂ ᎤᎿᎢ ᎯᎠ ᎠᏥᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app can get your precise location from location services while the app is in use.">
                <langSet xml:lang="en-US"><tig><term>This app can get your precise location from location services while the app is in use.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏰᎵᏊ ᎠᎩᏍᏗ ᏣᏤᎵ ᎧᎵ ᏗᏙᎵᎩ ᎤᏙᏢᏒᎢ ᏂᏓᏳᏓᎴᏅ ᎤᏙᏢᏒᎢ ᎢᏗᏓᏛᏁᏗ ᎾᎯᏳᎢ ᎾᏍᎩ ᎬᏙᏗ ᎾᎿᎢ ᎬᏔᏂᏗᏍᏗ.</term></tig></langSet>
            </termEntry>
