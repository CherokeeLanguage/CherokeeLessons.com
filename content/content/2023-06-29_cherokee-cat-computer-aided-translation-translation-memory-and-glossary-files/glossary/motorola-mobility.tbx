                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏗ ᎠᎯᏙᎯ ᎬᏴᏍᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="The carrier can use this information for any purpose.">
                <langSet xml:lang="en-US"><tig><term>The carrier can use this information for any purpose.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏙᎯ ᏰᎵᏊ ᎬᏙᏗ ᎯᎠ ᎧᏃᎮᏢᎥᏍᎩ ᎾᏍᎩᎾ ᎾᏂᎥᏉ ᎤᎬᏩᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This app allows you to give your carrier access to your device's location.">
                <langSet xml:lang="en-US"><tig><term>This app allows you to give your carrier access to your device's location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎬᏙᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎯ ᎾᎿᎢ ᎠᏓᏁᏗ ᎠᎯᏙᎯ ᎬᏴᏍᏗ ᎾᎿᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎿ ᎢᎬᎾᏕᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="1. On the Location setting screen, turn on Use location.">
                <langSet xml:lang="en-US"><tig><term>1. On the Location setting screen, turn on Use location.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>1. ᎤᎾᎢ ᏥᎩ ᎤᎿ ᎢᎬᎾᏕᎾ ᏕᎦᎧᎲᎢ ᎠᏴᏙᎳᏛᎢ, ᎯᏍᏚᎢ ᎬᏙᏗ ᎤᎿ ᎢᎬᎾᏕᎾ.</term></tig></langSet>
            </termEntry>
