            </termEntry>
            <termEntry id="Trigger the Assistant by holding the power button">
                <langSet xml:lang="en-US"><tig><term>Trigger the Assistant by holding the power button</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏣᏁᏍᏗᎢ ᏥᎩ ᎠᎾᏓᏍᏕᎵᏍᎩ ᎬᏗ ᏚᏂᏴᏒ ᏥᎩ ᏗᏆᏂᏲᏍᏗ &amp; ᎠᏂᎶᏍᎬᎢ</term></tig></langSet>
            </termEntry>
