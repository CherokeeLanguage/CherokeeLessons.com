                <langSet xml:lang="chr"><tig><term>ᎠᏓᏍᏚᏁᏗ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set 4G data limit">
                <langSet xml:lang="en-US"><tig><term>Set 4G data limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎧᎲᎢ 4 G ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disabling background data extends battery life and lowers data use. Some apps may still use the background data connection.">
                <langSet xml:lang="en-US"><tig><term>Disabling background data extends battery life and lowers data use. Some apps may still use the background data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᏥᏅᎯᏗᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎬᏅᎢ ᎠᎴ ᏤᎳᏗᏢ ᎦᏟᏌᏅᎯ ᎬᏙᏗ. ᎢᎦᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᏏᏉ ᎲᏗᏍᎬ ᏥᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" since unplugged">
                <langSet xml:lang="en-US"><tig><term> since unplugged</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏥᎨᏒ ᎫᏓᎴᏍᎪ</term></tig></langSet>
            </termEntry>
            <termEntry id="Deactivate this device admin app">
                <langSet xml:lang="en-US"><tig><term>Deactivate this device admin app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏔᏅᏱ ᎯᎠ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎦᏎᏍᏗᏕᎩ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Syncing now">
                <langSet xml:lang="en-US"><tig><term>Syncing now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᎭ ᏥᏂᎦᎵᏍᏗᏍᎬᎢ ᏃᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="You're already connected to an always-on VPN. If you connect to a different one, your existing VPN will be replaced, and always-on mode will turn off.">
                <langSet xml:lang="en-US"><tig><term>You're already connected to an always-on VPN. If you connect to a different one, your existing VPN will be replaced, and always-on mode will turn off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎾᏍᎩ ᎦᏳᎳ ᎫᏓᎸᏅᎯ ᎤᎿᎢ Ꭰ ᏂᎪᎯᎸᎢ-ᎤᎾᎢ VPN. ᎢᏳᏃ ᏂᎯ ᎫᏓᎸᎢ ᎤᎿᎢ Ꭰ ᏧᏓᎴᎿᎢ ᏌᏊ, ᏂᏨᏅᎢ ᎬᏂᎨᏒ ᏄᏍᏛᎢ VPN ᏰᎵᏉ ᎨᏎᏍᏗ ᎦᏁᏟᏴᏒᎢ, ᎠᎴ ᏂᎪᎯᎸᎢ-ᎤᎾᎢ ᎬᏙᏗ ᎠᏎᎢ ᎯᏍᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete Recordings?">
                <langSet xml:lang="en-US"><tig><term>Delete Recordings?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᎦᏂᏴᎲᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Create &amp; add doc">
