            </termEntry>
            <termEntry id=" We've sent an email to  with a link to verify your account. ">
                <langSet xml:lang="en-US"><tig><term> We've sent an email to  with a link to verify your account. </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏂᎦᏗᏉᏃ ᏭᏥᏅᎲᎦ ᎾᏍᎩ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ ᎾᎾᎢ  ᎤᏠᏯᏍᏗ ᎫᏓᎸᎢ ᎾᎢ ᎪᎯᏳᏙᏗ ᏣᏤᎵ ᎠᏚᏓᎸᏗ. </term></tig></langSet>
            </termEntry>
            <termEntry id="When you start a task on the external display, you can flip open for a more detailed experience on the internal display.">
                <langSet xml:lang="en-US"><tig><term>When you start a task on the external display, you can flip open for a more detailed experience on the internal display.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>WᎮn ᏲᎤ ᏍᏔrt Ꭰ ᏔᏍk Ꭳn tᎮ ᎡxᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ, ᏲᎤ cᎠn fᎵp ᎣpᎡn fᎣr Ꭰ ᎼrᎡ ᏕᏔᎢᎴd ᎡxpᎡrᎢᎡncᎡ Ꭳn tᎮ ᎢnᏖrᎾl ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Get a reminder when the stylus has been removed for a long period of time without use">
                <langSet xml:lang="en-US"><tig><term>Get a reminder when the stylus has been removed for a long period of time without use</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎩᏍᏗ ᎾᏍᎩ ᎠᏓᏅᏓᏗᏍᏗᏍᎩ ᎾᎯᏳ ᎾᏍᎩ ᏗᎪᏪᎳᏅ ᏂᎦᎵᏍᏗᎭ ᎠᎲᏍᏓ ᎾᏍᎩᎾ ᎪᎯᏓ ᎢᎪᎯᏛ ᏄᏠᏯᏍᏛᎾ ᎬᏙᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Transfer failed because other audio is transferring">
                <langSet xml:lang="en-US"><tig><term>Transfer failed because other audio is transferring</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎲᏍᏗ ᎠᏓᏄᎸᏅᎩ ᏅᏗᎦᎵᏍᏙᏗᏍᎬ ᏐᎢ ᎤᏃᏴᎬ ᎾᏍᏛ ᏫᏚᏓᎲᎯᏎᏍᏗ </term></tig></langSet>
            </termEntry>
