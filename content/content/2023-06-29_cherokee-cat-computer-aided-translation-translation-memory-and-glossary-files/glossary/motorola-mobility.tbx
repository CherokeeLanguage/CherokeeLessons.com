            <termEntry id="You can change your location any time by going to Wi-Fi Calling in the Call settings menu or Mobile network settings menu.">
                <langSet xml:lang="en-US"><tig><term>You can change your location any time by going to Wi-Fi Calling in the Call settings menu or Mobile network settings menu.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏯ ᎯᏁᏟᏴᎾ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ ᎢᎸᎯᏳ ᎬᏗ ᏓᏰᏏ ᎾᎿᎢ Wi-Fi ᏓᏯᏂᏍᎬ ᎾᎿ ᏥᎩ ᏪᏯᎾ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᎠᎴ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="We recommend you change this address when you make calls using a different Wi-Fi network so your location information is accurate.">
                <langSet xml:lang="en-US"><tig><term>We recommend you change this address when you make calls using a different Wi-Fi network so your location information is accurate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏴ ᎦᎸᏉᏗᎭ ᏂᎯ ᎯᏁᏟᏴᎾ ᎯᎠ ᎪᏪᎵ ᏧᏁᏍᏗᎢ ᎢᏳᏃ ᏂᎯ ᎪᏢᏗ ᏓᏯᏂ ᎬᏗᎭ Ꭰ ᏧᏓᎴᎿᎢ Wi-Fi ᏧᎾᏚᏓᎵ ᏓᏛ ᏂᏨᎤᎢ ᎤᏙᏢᏒᎢ ᎧᏃᎮᏢᏗ ᎨᎡᎢ ᏗᏙᎳᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow data access?">
                <langSet xml:lang="en-US"><tig><term>Allow data access?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏴᏍᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data is unavailable while on this call.">
                <langSet xml:lang="en-US"><tig><term>Mobile data is unavailable while on this call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎨᎡᎢ Ꮭ ᎬᏙᏗ ᏱᎩ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ ᎾᎯᏳᎢ ᎤᎿᎢ ᎯᎠ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps like email, Internet and social networking will work if you connect to Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>Apps like email, Internet and social networking will work if you connect to Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᎢᏳᏍᏘ ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ, ᎠᏏᎳᏕᏫᏒᎢ ᎠᎴ ᎠᎾᏓᏟᏏᏍᎬ ᏓᎾᏚᏓᎸᏍᎬ ᎠᏎ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎾᎿ ᏂᎯ ᎫᏓᎸᎢ to Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone was rebooted and mobile data connection is turned off.">
                <langSet xml:lang="en-US"><tig><term>Your phone was rebooted and mobile data connection is turned off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎨᏎᎢ ᏥᎭᏂᎩᏍᏗ ᎠᎴ ᎠᏂᎩᏍᎩ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ ᎨᎡᎢ ᎠᏍᏚᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone's Video Calling function won't work when mobile data is off.">
