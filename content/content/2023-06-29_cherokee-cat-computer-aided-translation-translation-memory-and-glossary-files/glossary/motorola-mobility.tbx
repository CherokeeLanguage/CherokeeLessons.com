            </termEntry>
            <termEntry id="An app wants to turn on Bluetooth and make your tablet visible to other devices.">
                <langSet xml:lang="en-US"><tig><term>An app wants to turn on Bluetooth and make your tablet visible to other devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎬᏙᏗ ᏚᎾᏚᎵᎭ ᎾᎿᎢ ᎯᏍᏚᎢ Bluetooth ᎠᎴ ᎪᏢᏗ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᎬᎪᏩᏛᏗ ᎾᎿᎢ ᏐᎢ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery Saver on">
                <langSet xml:lang="en-US"><tig><term>Battery Saver on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎠᎵᏏᏅᏗᏍᎩ ᎤᎾᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to connect to \u0022\u0022.">
                <langSet xml:lang="en-US"><tig><term>Tap to connect to \u0022\u0022.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎫᏓᎸᎢ ᎾᎿᎢ \u0022\u0022.</term></tig></langSet>
            </termEntry>
            <termEntry id="The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data.">
                <langSet xml:lang="en-US"><tig><term>The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏕᎵᏍᏙᏗ ᎠᎢᏒᎢ ᏄᏍᏛ ᎪᎯᏓ ᏗᎨᏛᏍᎩ ᎠᎴ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Wait while your tablet is being encrypted. ^1 complete.">
                <langSet xml:lang="en-US"><tig><term>Wait while your tablet is being encrypted. ^1 complete.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎦᏘᏓ ᎾᎯᏳᎢ ᏂᏨᎤᎢ ᏗᎪᏪᎶᏗᎢ ᏄᏍᏛ ᎠᎴᏂᏙᎲ ᎠᏕᎵᏍᏔᏅ. ^1 ᎧᎵᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone book access request">
                <langSet xml:lang="en-US"><tig><term>Phone book access request</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᏃᎮᏗ ᎪᏪᎵ ᎠᏴᏍᏗ ᎠᏔᏲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Give access to ?">
                <langSet xml:lang="en-US"><tig><term>Give access to ?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᏁᏗᏱ ᎠᏴᏍᏗ ᎾᎿᎢ ?</term></tig></langSet>
            </termEntry>
            <termEntry id="App pinning allows you to keep the current app in view until you unpin it. This feature can be used, for example, to let a trusted friend play a specific game.">
                <langSet xml:lang="en-US"><tig><term>App pinning allows you to keep the current app in view until you unpin it. This feature can be used, for example, to let a trusted friend play a specific game.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏙᏗ ᎦᎭᏛᏍᎬᎢ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏂᎯ ᎾᎢ ᏍᏆᏂᎪᏙᏗ ᎾᏍᎩ ᏃᏊ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᎩᎳ ᏂᎯ ᎯᎥᏍᏈᏛᎲᎢ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᏰᎵᏊ ᎨᏒᎢ ᏗᏔᏅᎯ, ᎾᏍᎩᎾ ᏱᏓᏥᎶᏍᏔᏅ, ᎾᎢ ᎠᎵᏍᎪᎸᏔᏅᎢ ᎨᎦᎨᏅᏛ ᎤᎾᎵᎢ ᏗᏁᎸᏙᏗ ᏗᏙᎳᎩ ᏗᏁᎸᏙᏗ.</term></tig></langSet>
            </termEntry>
