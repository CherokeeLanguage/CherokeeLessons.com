            </termEntry>
            <termEntry id="SIP settings">
                <langSet xml:lang="en-US"><tig><term>SIP settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIP ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Feedback">
                <langSet xml:lang="en-US"><tig><term>Moto Feedback</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎦᏬᎯᎵᏴᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto app">
                <langSet xml:lang="en-US"><tig><term>Moto app</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't draw waveform">
                <langSet xml:lang="en-US"><tig><term>Can't draw waveform</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎠᏂᎾᏏᏁᎩ ᎤᏃᏴᎬ ᏓᎵᏍᏗᏟᏁᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="When unreachable">
                <langSet xml:lang="en-US"><tig><term>When unreachable</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ ᎨᏍᏗ ᏱᏫᎨᏯᏓᏅᎯᏓ ᏂᎨᏒᎾ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Recorder can't ask directly for permissions denied at prior. You need grant them manually now.">
                <langSet xml:lang="en-US"><tig><term>Recorder can't ask directly for permissions denied at prior. You need grant them manually now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏂᏴᏙᏗ ᎨᏍᏗ ᏰᎵ ᎠᏓᏛᏗ ᎠᏓᏎᎮᎸᎢ ᎤᎬᏩᏟ ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎤᏓᏱᎸᎢ ᎤᎿᎢ ᏧᏩᎫᏔᏅᏒ. ᏂᎯ ᎤᏚᎸᏓ ᎭᎵᏍᎪᎸᏓ ᎢᏯᏂᎢ ᎣᏩᏌ ᏱᎬᏁᏗ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The selected action can not be completed because the affiliated app has been removed or disabled.">
                <langSet xml:lang="en-US"><tig><term>The selected action can not be completed because the affiliated app has been removed or disabled.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏑᏰᏛ ᎢᏯᏛᏁᎵᏓᏍᏗ ᏰᎵᏯ ᎥᏝ ᎨᎡᎢ ᎠᏍᏆᏙᏅᎯ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏥᎩ ᏧᎾᎵᎪᏗ ᎬᏙᏗ ᏂᏚᏩᎿ ᏄᎵᏍᏔᏅ ᎠᎲᏍᏓ ᏃᎴ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ.</term></tig></langSet>
            </termEntry>
