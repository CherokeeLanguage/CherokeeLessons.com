                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎠᎦᏘᏏ ᎤᎬᏩᏟ ᎾᏞᎬ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Silence an incoming call">
