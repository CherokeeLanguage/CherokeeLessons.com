                <langSet xml:lang="chr"><tig><term>ᏇᏥᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly access accessibility features from any screen.To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.To use the accessibility button in the navigation bar instead, switch to 2-button navigation or 3-button navigation.">
                <langSet xml:lang="en-US"><tig><term>Quickly access accessibility features from any screen.To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.To use the accessibility button in the navigation bar instead, switch to 2-button navigation or 3-button navigation.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏴᏍᏗᎢ ᎬᏴᏍᏗ ᎨᏒᎢ ᏗᎦᏎᏍᏙᏗ ᏂᎦᎥᏉ ᎠᏴᏙᎳᏛᎢ ᏅᏛᏓᎵᏂᏍᎩ.TᎣ Ꭸt ᏍᏔrᏖd, Ꭺ tᎣ ᎠccᎡᏍᏏbᎢᎵty ᏎtᏘngᏍ Ꭰnd ᏎᎴct Ꭰ fᎡᎠtᎤrᎡ. Ꮤp Ꭳn tᎮ ᏍᎰrtcᎤt Ꭰnd ᏎᎴct tᎮ ᎠccᎡᏍᏏbᎢᎵty bᎤttᎣn.TᎣ ᎤᏎ tᎮ ᎠccᎡᏍᏏbᎢᎵty bᎤttᎣn Ꭲn tᎮ ᎾᎥᎢᎦᏘᎣn bᎠr ᎢnᏍᏖᎠd, ᏍᏫtch tᎣ 2-bᎤttᎣn ᎾᎥᎢᎦᏘᎣn Ꭳr 3-bᎤttᎣn ᎾᎥᎢᎦᏘᎣn.</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera">
                <langSet xml:lang="en-US"><tig><term>Camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="The service providing this function will have access to all of the information that is visible on your screen or played from your device while recording or casting. This includes information such as passwords, payment details, photos, messages, and audio that you play.">
                <langSet xml:lang="en-US"><tig><term>The service providing this function will have access to all of the information that is visible on your screen or played from your device while recording or casting. This includes information such as passwords, payment details, photos, messages, and audio that you play.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎢᏯᏓᏛᏁᏗ ᎠᏓᏁᏢᏍᎬ ᏂᎯ ᏧᎸᏫᏍᏓᏁᏗᏱ ᎠᏎ ᎤᎭ ᎠᏴᏍᏗ ᎾᎿᎢ ᏂᎦᏓ ᎤᎿᎢ ᏥᎩ ᎧᏃᎮᏢᏗ ᎥᏍᎩᎾ ᏄᏍᏛ ᎬᎪᏩᏛᏗ ᎤᎾᎢ ᏂᏨᎤᎢ ᎠᏴᏙᎳᏛᎢ ᏃᎴ ᏚᎾᏁᎶᏅ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏏᏉ ᎦᏂᏴᎲᎢ ᏃᎴ ᏫᏚᏕᎦ. ᎯᎠ ᏚᏠᏯᏍᏗ ᏗᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ, ᎠᏈᏴᏗ ᎧᏃᎮᏢᏗ, ᏗᏥᎶᏍᏔᏅᎯ, ᏗᎪᎵᏰᏗ, ᏃᎴ ᎤᏃᏴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't hear your next alarm ">
                <langSet xml:lang="en-US"><tig><term>You won't hear your next alarm </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎢᏣᏛᏓᏍᏓ ᏂᏨᏅᎢ ᏐᎢ ᎠᏓᏕᏯᏙᏗᏍᎩ </term></tig></langSet>
            </termEntry>
            <termEntry id="Auto-rotate">
                <langSet xml:lang="en-US"><tig><term>Auto-rotate</term></tig></langSet>
