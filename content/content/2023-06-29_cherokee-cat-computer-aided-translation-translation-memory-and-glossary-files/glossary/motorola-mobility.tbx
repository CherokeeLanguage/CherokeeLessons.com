                <langSet xml:lang="chr"><tig><term>ᏥᎭᏂᎩᏍᏗ ᏥᏂᏕᎬᏅᏗᏓᏂ ᏍᏙᏗ ᏱᏣᏚᎵ ᎢᏤ ᏩᏂᎨ ᎦᎾᏗᏅᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM  is still in use.">
