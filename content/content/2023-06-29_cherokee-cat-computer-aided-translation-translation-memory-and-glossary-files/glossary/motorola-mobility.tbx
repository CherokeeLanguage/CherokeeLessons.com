            <termEntry id="If you have more than 20 messages in your voice mailbox, no new messages can be left for you.">
                <langSet xml:lang="en-US"><tig><term>If you have more than 20 messages in your voice mailbox, no new messages can be left for you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᎤᎭ ᎤᏟ ᎢᎦᎢ ᎡᏍᎦᏉ 20 ᏗᎪᎵᏰᏗ ᎾᎿ ᏂᏨᎤᎢ ᎤᏁᎬ ᎪᏪᎵᎧᏁᏌ, Ꮭ ᏗᏤ ᏗᎪᎵᏰᏗ ᏰᎵᏯ ᎨᎡᎢ ᎠᎦᏍᎦᏂ ᎤᎬᏩᏟ ᏂᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="But don't worry—all the messages you have now will be saved.">
                <langSet xml:lang="en-US"><tig><term>But don't worry—all the messages you have now will be saved.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏃ ᏞᏍᏗ ᏱᏤᎵᎯᏍᎨᏍᏗ—ᏂᎦᏓ ᏥᎩ ᏗᎪᎵᏰᏗ ᏂᎯ ᎤᎭ Ꭷ ᎠᏎ ᎨᎡᎢ ᎠᎵᏏᏅᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Save or delete some messages so you have fewer than 20 to make room for new ones.">
                <langSet xml:lang="en-US"><tig><term>Save or delete some messages so you have fewer than 20 to make room for new ones.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎵᏏᏅᏓ ᎠᎴ ᎠᏍᎪᎸᏗᏍᏗ ᎢᎦᏓ ᏗᎪᎵᏰᏗ ᏓᏛ ᏂᎯ ᎤᎭ ᎦᏲᎳᎨᏍᏗ ᎡᏍᎦᏉ 20 ᎾᎿᎢ ᎪᏢᏗ ᎧᏅᏑᎸ ᎤᎬᏩᏟ ᏗᏤ ᏌᏇ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Or subscribe to Premium to keep your larger inbox.">
                <langSet xml:lang="en-US"><tig><term>Or subscribe to Premium to keep your larger inbox.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴ ᏔᏓᏅᎵ ᎾᎿᎢ ᏓᏤᏢᎢ ᎾᎿᎢ ᎠᏍᏆᏂᎪᏙᏗᎢ ᏂᏨᎤᎢ ᎡᏉᎯᎨᏍᏙᏗ ᏂᎬᏅ ᎧᏁᏌᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't be able to use the Internet, Email, Wi-Fi calling or other apps that need a data connection unless you use Wi-Fi.">
                <langSet xml:lang="en-US"><tig><term>You won't be able to use the Internet, Email, Wi-Fi calling or other apps that need a data connection unless you use Wi-Fi.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏝᏰᏍ ᎨᎡᎢ ᏰᎵᏉ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎠᏏᎳᏕᏫᏒᎢ, ᎠᎾᎦᎵᏍᎩ ᎪᏪᎵ, Wi-Fi ᏓᏯᏂᏍᎬ ᎠᎴ ᏐᎢ ᏗᎬᏙᏗ ᎥᏍᎩᎾ ᎤᏚᎸᏓ Ꭰ ᏕᎦᎧᎲᎢ ᎫᏓᎸᎢ ᎢᏳᏍᎩᏂ ᏂᎯ ᎬᏔᏂᏓᏍᏗ Wi-Fi.</term></tig></langSet>
            </termEntry>
            <termEntry id="has note">
                <langSet xml:lang="en-US"><tig><term>has note</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᏩᎿ ᎤᏍᏗ ᎪᏪᎸ</term></tig></langSet>
            </termEntry>
            <termEntry id="Note is saved">
                <langSet xml:lang="en-US"><tig><term>Note is saved</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏍᏗ ᎪᏪᎸ ᎨᎡᎢ ᎠᎵᏏᏅᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Update &amp; Subscribe to Basic Visual Voicemail">
                <langSet xml:lang="en-US"><tig><term>Update &amp; Subscribe to Basic Visual Voicemail</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎪᏢᎯᏌᏅᎯ &amp; ᏔᏓᏅᎵ ᎾᎿᎢ ᏂᎬᏩᏍᏛᏊ ᏓᏟᎶᏍᏛ ᎤᏁᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Error while accessing internal memory.">
                <langSet xml:lang="en-US"><tig><term>Error while accessing internal memory.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏓᎴᎬᎢ ᎠᏏᏉ ᏅᏛᏴᏍᏙᏗᎢ ᎭᏫᏂ ᎠᏅᏓᏗᏍᏙ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try later.">
                <langSet xml:lang="en-US"><tig><term>Try later.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏁᎸᏙᏗ ᎪᎯᏴᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Powered by Moto AI">
                <langSet xml:lang="en-US"><tig><term>Powered by Moto AI</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎳᏂᎩᏛ ᏄᏩᏅ Moto ᎬᏴᏍᏗ ᏕᎦᏅᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Some required permissions were not granted.">
                <langSet xml:lang="en-US"><tig><term>Some required permissions were not granted.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᏓ ᎢᏯᏛᏁᏗ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎨᏒᎩ ᎥᏝ ᎤᎵᏍᎪᎸᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You are running VzwDM Service!">
                <langSet xml:lang="en-US"><tig><term>You are running VzwDM Service!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᎡᎩ ᎠᏂᎩᏍᏓ VzwDM ᎤᎾᏓᏍᏕᎸᏗ!</term></tig></langSet>
            </termEntry>
            <termEntry id="In the future if you would like to use Wi-Fi for Voice calling you can go to Call settings menu or Mobile network settings menu to turn it on.">
                <langSet xml:lang="en-US"><tig><term>In the future if you would like to use Wi-Fi for Voice calling you can go to Call settings menu or Mobile network settings menu to turn it on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏥᎩ ᎤᏩᎫᏗᏗᏒ ᎾᎿ ᏂᎯ ᏯᏓᎯᏗᏏ ᏣᎸᏉᏛ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ Wi-Fi ᎤᎬᏩᏟ ᎤᏁᎬ ᏓᏯᏂᏍᎬ ᏂᎯ ᏰᎵᏯ Ꭷ ᏗᏟᏃᎮᏗ ᏫᎬᏙᏗ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᎠᎴ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᏕᎦᎧᎲᎢ ᎪᏪᎳᎾᎥᎢ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎾᎿ ᎤᎿᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You have incorrectly attempted to unlock the phone  times. After  more unsuccessful attempts, the work profile will be removed, which will delete all profile data.">
                <langSet xml:lang="en-US"><tig><term>You have incorrectly attempted to unlock the phone  times. After  more unsuccessful attempts, the work profile will be removed, which will delete all profile data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏂᏚᏳᎪᏛᎾ ᎤᎾᏁᎶᏔᏅᎯ ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏗᏟᏃᎮᏗ  ᎢᏳᏩᏗ. ᎣᏂᏗᏢ  ᎤᎪᏗᏊ ᎥᏝ ᏄᏓᏄᎸᏅᎾ ᎤᏁᎸᏙᏗ, ᎯᎠ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᎨᏎᏍᏗ ᎠᎲᏍᏓ, ᎦᏙᎤᏍᏗ ᎠᏎ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏧᏓᏟᎶᏍᏔᏅᎢ ᎤᎧᏛ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Call sent to voicemail.">
                <langSet xml:lang="en-US"><tig><term>Call sent to voicemail.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏪᏴᎾ ᏭᏅᏅᎢ ᎾᎿᎢ ᎧᏁᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Verizon provisioning service needs permission to access some things in your device.">
                <langSet xml:lang="en-US"><tig><term>Verizon provisioning service needs permission to access some things in your device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Verizon ᎤᎾᎵᏍᏕᎸᏙᏗ ᎤᎾᏓᏍᏕᎸᏗ ᏗᏓᏟᎶᏍᏗᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎢᎦᏓ ᏧᏓᎴᏅᏛ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
