            <termEntry id="Your searches and incoming calls may be visible to your IT admin">
                <langSet xml:lang="en-US"><tig><term>Your searches and incoming calls may be visible to your IT admin</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᏗᏱᏍᏗ ᎠᎴ ᎦᎷᎦ ᏓᏯᏂ ᏰᎵᏯ ᎨᎡᎩ ᎬᎪᏩᏛᏗ ᎾᎿᎢ ᏂᏨᎤᎢ IT ᎤᎦᏎᏍᏗᏕᎩ</term></tig></langSet>
            </termEntry>
