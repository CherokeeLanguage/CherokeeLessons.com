            <termEntry id="Switching to selfie camera.">
                <langSet xml:lang="en-US"><tig><term>Switching to selfie camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᎩ ᎾᎢ ᎣᎶᏒ ᏗᏓᏟᎶᏍᏔᏅ ᏗᏓᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data usage cycle">
                <langSet xml:lang="en-US"><tig><term>Data usage cycle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᎬᏗᏍᎬ ᎤᏕᏲᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="To preserve your battery. Learn more.">
                <langSet xml:lang="en-US"><tig><term>To preserve your battery. Learn more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᎾᎵᏏᏅᏙᏗ ᏂᏨᏅᎢ ᎠᎾᎦᎵᏍᎩ. ᎤᏟ ᎢᎦᎢ ᎠᏕᎶᏆᏗᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="adjust color">
                <langSet xml:lang="en-US"><tig><term>adjust color</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏁᏟᏴᏍᎩ ᎠᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="(received from server)">
                <langSet xml:lang="en-US"><tig><term>(received from server)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>(ᏓᏥᏁᎸᎩ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏯᏙᎯᎯ)</term></tig></langSet>
            </termEntry>
            <termEntry id="Additional system updates">
                <langSet xml:lang="en-US"><tig><term>Additional system updates</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎧᏁᏉᏍᏙᏔᏅ ᏄᏍᏗᏓᏅᎢ ᏗᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Share your tablet by adding new users. Each user has a personal space on your tablet for custom Home screens, accounts, apps, settings, and more.">
                <langSet xml:lang="en-US"><tig><term>Share your tablet by adding new users. Each user has a personal space on your tablet for custom Home screens, accounts, apps, settings, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏙᏍᏗᎢ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ ᎬᏗ ᎧᏁᏉᏍᏗ ᏗᏤ ᏗᏅᏗᏍᎩ. ᏌᏊᎭ ᎬᏗᏍᎩ ᏂᏚᏩᎿ Ꭰ ᎠᏏᏴᏫ ᎤᏜᏅᏛ ᎤᎾᎢ ᏂᏨᏅᎢ ᏗᎪᏪᎶᏗᎢ ᎤᎬᏩᏟ ᏄᏍᏛ ᎢᏯᏛᏁᏗ ᎣᏪᏅᏒ ᎠᏰᏙᎳᏛᎢ, ᏗᏚᏓᎸᏙᏗ, ᏗᎬᏙᏗ, ᏕᎦᎧᎲᎢ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you allow data roaming, roaming charges may apply.This setting affects all users on this phone.">
                <langSet xml:lang="en-US"><tig><term>When you allow data roaming, roaming charges may apply.This setting affects all users on this phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎦᏘᏍᎩᏌᏅᎯ ᎡᏙᎵᏙᎲ, ᎡᏙᎵᏙᎲ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎲᏓ.ᎯᎠ ᏕᎦᎧᎲᎢ ᏂᏙᏓᎬᏂᏌᏂ ᏂᎦᏓ ᏗᏅᏗᏍᎩ ᎤᎾᎢ ᎯᎠ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Paused at limit">
                <langSet xml:lang="en-US"><tig><term>Paused at limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᎯᏍᏔᏅ ᎾᎿᎢ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id=" has high background battery usage">
