            <termEntry id="Tap &quot;Customize&quot; for more options.Tap &quot;Done&quot; to finish.">
                <langSet xml:lang="en-US"><tig><term>Tap "Customize" for more options.Tap "Done" to finish.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ "ᎠᏤᎲᏍᏙᏗ" ᎾᏍᎩᎾ ᎤᏥ ᎢᎦᎢ ᏗᏑᏰᏍᏗ.ᎭᏐᎥᏍᏓ "ᎠᎵᏍᏆᏓ" ᎾᎢ ᎠᏍᏆᏗᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Show the time, date &amp; weather">
