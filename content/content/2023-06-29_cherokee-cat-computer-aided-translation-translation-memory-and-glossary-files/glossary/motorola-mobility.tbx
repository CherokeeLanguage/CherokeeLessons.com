                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ: RTT ᎢᏍ Ꮓt ᎠᎥᎠᎢᎳbᎴ wᎯᎴ rᎣᎠᎻng</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile Data is turned off. Would you like to turn it back on?">
                <langSet xml:lang="en-US"><tig><term>Mobile Data is turned off. Would you like to turn it back on?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏏᏙᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᎠᏍᏚᎭ. ᏱᏣᏚᎵᏍ ᎢᏍᏚᎢᏍᏗᎢ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Upgrade Service to HD Voice and Video calling">
                <langSet xml:lang="en-US"><tig><term>Upgrade Service to HD Voice and Video calling</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏤᎴᏍᏗ ᏅᎦ ᎢᏯᏓᏛᏁᏗ HD ᎧᏁᎬᎢ ᏃᎴ ᎠᏓᏴᎳᏛᏍᎩ ᏫᏗᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="You’re all set! Now you can learn even more about your device in Tips.">
                <langSet xml:lang="en-US"><tig><term>You’re all set! Now you can learn even more about your device in Tips.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎾᏍᎩ ᏂᎦᏓ ᏣᏛᏅᎢᏍᏔᏅᎢ! ᏃᏊ ᏂᎯ ᏰᎵᏊ ᏫᏣᏕᎶᏆᏍᏗ ᎥᏍᏊ ᎤᏥ ᎢᎦᎢ ᏄᏰᎵᏛᎢ ᏣᏤᎵ ᏥᎵᎬᏅᏗᏓᎾ ᎾᎿᎢ ᏗᏓᏕᏲᎲᏍᎩ.</term></tig></langSet>
