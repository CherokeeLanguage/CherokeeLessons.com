                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᏫᏓᎧᎾᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unavailable because Triple power press is turned on">
                <langSet xml:lang="en-US"><tig><term>Unavailable because Triple power press is turned on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏛᏅᎢᏍᏛᎾ ᎢᎬᏂᏍᏏᏍᎩ ᏦᎢ ᎤᏟᏂᎩᏓ ᎭᏐᎥᏍᏓ ᎠᏍᏚᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="To display stylus shortcuts,this app needs to display on top of other apps you're using.">
                <langSet xml:lang="en-US"><tig><term>To display stylus shortcuts,this app needs to display on top of other apps you're using.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᏗᎪᏪᎳᏅ ᏥᏳᎪᏓᏃ, ᎯᎠ ᎬᏙᏗ ᏧᏚᎸᏓ ᎾᎢ ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎤᎾᎢ ᎦᏚᎢ ᎥᎿᎢ ᏐᎢ ᏗᎬᏙᏗ ᏂᎯ ᎾᏍᎩ ᎬᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Paused at limit">
                <langSet xml:lang="en-US"><tig><term>Paused at limit</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏲᎯᏍᏔᏅ ᎾᎿᎢ ᎠᏎᎸᎯ</term></tig></langSet>
