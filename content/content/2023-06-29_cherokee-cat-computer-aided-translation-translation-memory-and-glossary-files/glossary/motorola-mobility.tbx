            </termEntry>
            <termEntry id="SIM Slot ">
                <langSet xml:lang="en-US"><tig><term>SIM Slot </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᎤᏜᏅᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="When the external display timeout, the connection will be shut down after">
                <langSet xml:lang="en-US"><tig><term>When the external display timeout, the connection will be shut down after</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎯᏳ Ꮎ ᏙᏱᏗᏢ ᎠᏓᏴᎳᏔᏍᎩ, Ꮎ ᏗᎵᎪᏔᏅᎯ ᎨᏎᏍᏗ ᎠᏍᏚᏗ ᎤᎶᏐᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn it off in capture settings.">
                <langSet xml:lang="en-US"><tig><term>You can turn it off in capture settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏍᏚᎲᎦ ᎾᎿᎢ ᎦᏂᏴᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You can turn them off in capture settings.">
                <langSet xml:lang="en-US"><tig><term>You can turn them off in capture settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏰᎵᏊ ᏱᏕᎯᏍᏚᎲᎦ ᎾᎿᎢ ᎦᏂᏴᏗ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Set app behavior for opening on another display">
                <langSet xml:lang="en-US"><tig><term>Set app behavior for opening on another display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎪᏗ ᎬᏙᏗ ᎾᏛᏁᎲᎢ ᎤᎬᏩᏟ ᎠᏍᏚᎢᏍᎬ ᏐᎢ ᎠᏓᏴᎳᏔᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wide angle">
                <langSet xml:lang="en-US"><tig><term>Wide angle</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏯᏖᎾ ᎠᏍᏓᏅᏅ ᎤᎷᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="The content in this app can only be shown on a secondary display">
                <langSet xml:lang="en-US"><tig><term>The content in this app can only be shown on a secondary display</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᏄᏍᏗᏓᏅ ᎤᎿᎢ ᎯᎠ ᎠᏴᏙᎳᏛᎢ ᎥᏝ ᏰᎵ ᎨᎡᎢ ᎤᏓᏎᎮᎸᎩ ᎤᎿᎢ Ꭰ ᎦᏲᎵᎨ ᎠᏓᏴᎳᏔᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="To extend battery life, Adaptive Battery limits battery for infrequently used apps.">
                <langSet xml:lang="en-US"><tig><term>To extend battery life, Adaptive Battery limits battery for infrequently used apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᎦᏅᎯᏍᏗᏍᎬ ᎠᎾᎦᎵᏍᎩ ᎬᏅᎢ,  ᏗᎾᎪᎳᎩ ᎠᎾᎦᎵᏍᎩ ᎠᏎᎸᎢ ᎠᎾᎠᎦᎵᏍᎩ  ᎢᏳᏰᎸᏗ ᎢᏳᏓᎵᎭ ᎬᏔᏅᎯ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="This is a data limit you've set for yourself. Your Mobile Data will be turned off after this call. To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.Your video call is using data. Do you want to continue your call?">
                <langSet xml:lang="en-US"><tig><term>This is a data limit you've set for yourself. Your Mobile Data will be turned off after this call. To check your data usage, go to Settings &gt; Network &amp; Internet &gt; Data usage.Your video call is using data. Do you want to continue your call?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎨᎡᎢ Ꭰ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎᎸᎯ ᏂᎯ ᎤᎭ ᎦᎧᎲᎢ ᎤᎬᏩᏟ ᎢᏨᏌ. ᏂᎯ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏎ ᎨᎡᎢ ᏭᎪᎸᏍᏔᏁᎢ ᎠᏍᏚᎭ ᎣᏂᏗᏢ ᎯᎠ ᏪᏯᎾ. ᎾᎿᎢ ᎠᎦᏎᏍᏔᏅ ᏂᏨᎤᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ, ᎡᏅᏍᏙᏗ ᎾᎿᎢ ᏕᎦᎧᎲᎢ &gt; ᏧᎾᏚᏓᎵ &amp; ᎠᏏᎳᏕᏫᏒᎢ &gt; ᎦᏘᏍᎩᏌᏅᎯ ᎬᏗᏍᎬ.ᏂᏨᎤᎢ ᎠᏓᏴᎳᏛᏍᎩ ᏪᏯᎾ ᎨᎡᎢ ᎬᏗᎭ ᎦᏘᏍᎩᏌᏅᎯ. ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎠᎯᎸᏍᏗ ᏂᏨᎤᎢ ᏪᏯᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Voicemail is not set up on your account. Please contact Customer Service at and tell them the error code is .">
                <langSet xml:lang="en-US"><tig><term>Voicemail is not set up on your account. Please contact Customer Service at and tell them the error code is .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎬ ᎾᎿ ᎥᏝ ᏘᎧᎲᎦ ᎤᎿᎢ ᏂᏨᎤᎢ ᎠᏚᏓᎸᏗ. ᎰᏩᏊ ᎠᏟᏃᎮᏙᏗ ᎤᏩᏍᎩ ᎢᏯᏓᏛᏁᏗ ᎤᎿᎢ  ᏃᎴ ᎤᏃᎮᏗ ᎢᏯᏂᎢ ᏓᏓᎴᎬᎢ ᎠᏍᏓᏩᏛᏍᏙᏗ .</term></tig></langSet>
            </termEntry>
