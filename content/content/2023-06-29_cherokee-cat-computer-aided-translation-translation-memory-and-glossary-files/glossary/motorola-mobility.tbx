            <termEntry id="Please insert a valid Jio sim to unlock the device.">
                <langSet xml:lang="en-US"><tig><term>Please insert a valid Jio sim to unlock the device.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎰᏣᎸᎥᎦ ᎠᏓᏂᎸᎦ Jio sim ᎾᎿᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏥᎩ ᏥᏂᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Accessibility gesture">
                <langSet xml:lang="en-US"><tig><term>Accessibility gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒ ᏧᏬᏯᏂᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="If you have a reason to do so, you can change this information below, otherwise simply tap on next.">
                <langSet xml:lang="en-US"><tig><term>If you have a reason to do so, you can change this information below, otherwise simply tap on next.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏂᎯ ᎤᎭ Ꭰ ᎠᏓᏅᏖᏗ ᎢᏯᏛᏁᏗᏱ ᏓᏛ, ᏂᎯ ᏰᎵᏯ ᎯᏁᏟᏴᎾ ᎯᎠ ᎧᏃᎮᏢᏗ ᎡᎳᏗᏢ, ᎢᏳᏃ ᏰᎵ ᏄᏦᏍᏛᎾᏊ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏐᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="For long distance calls, Easy Prefix uses our database to choose your carrier's prefix.">
                <langSet xml:lang="en-US"><tig><term>For long distance calls, Easy Prefix uses our database to choose your carrier's prefix.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎤᏓᏅᎯᏓ ᏓᏯᏂ, ᎠᎯᏓ ᎠᎴᏔᏅ ᏗᎬᏙᏗ ᎣᎦᏤᎵ ᏬᏍᏗᎬᎢ ᎾᎿᎢ ᏣᏑᏰᏍᏗ ᏂᏨᎤᎢ ᎠᏂᎯᏙᎯ ᎠᎴᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Select Allow on the following screens to grant permissions.">
                <langSet xml:lang="en-US"><tig><term>Select Allow on the following screens to grant permissions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓᏗᏓᎵᏍᎪᎸᏓᏁᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Action bar">
                <langSet xml:lang="en-US"><tig><term>Action bar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᎲᏍᎩ ᎦᎾᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Suggested to turn on.">
                <langSet xml:lang="en-US"><tig><term>Suggested to turn on.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎢᏍᏙᏔᏅ ᎾᎿᎢ ᎯᏍᏚᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected to RSA">
