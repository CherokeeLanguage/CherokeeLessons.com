                <langSet xml:lang="chr"><tig><term>ᏫᎢᏈᎢ ᏫᎬᏗᏍᎬ | </term></tig></langSet>
            </termEntry>
            <termEntry id="Location request">
                <langSet xml:lang="en-US"><tig><term>Location request</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏙᏢᏒᎢ ᎠᏔᏲᎯᎭ</term></tig></langSet>
            </termEntry>
