            </termEntry>
            <termEntry id="Continuing call using mobile data\u2026">
                <langSet xml:lang="en-US"><tig><term>Continuing call using mobile data\u2026</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᎬᎵᏱᎴᎬ ᏪᏯᎾ ᎬᏗᎭ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ\u2026</term></tig></langSet>
