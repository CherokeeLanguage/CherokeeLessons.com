                <langSet xml:lang="en-US"><tig><term>Software Version </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎾᏗᏅᏗ ᏄᏓᎴᏒᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Accessibility settings help you make audio, visual, and haptic adjustments to meet your unique needs.">
                <langSet xml:lang="en-US"><tig><term>Accessibility settings help you make audio, visual, and haptic adjustments to meet your unique needs.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏴᏍᏗ ᎨᏒ ᏕᎦᎧᎲᎢ ᎠᏍᏕᎵᏍᎩ ᎤᏃᏴᎬ ᏱᎬᏁᎯ, ᎠᎪᏩᏛᏗ, ᎠᎴ ᎠᏒᏍᏙᏗ ᎣᏍᏛ ᏂᏓᏅᏁᎲ ᎾᎢ ᏗᏦᎯᏍᏗ ᏣᏤᎵ ᎤᏩᏒᎯᏯ ᏚᏚᎸᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't fetch current location. Click on My Location to turn on location settings.">
                <langSet xml:lang="en-US"><tig><term>Can't fetch current location. Click on My Location to turn on location settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏃᏊ ᏥᎩ ᎤᏙᏢᏒᎢ. ᎭᏐᎥᏍᏓ ᎤᎾᎢ My Location ᎾᎿᎢ ᎯᏍᏚᎢ ᎤᏙᏢᏒᎢ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You won't be able to share files over 1MB, see read receipts, or see when the recipient is typing.You will also no longer be able to send or receive group messages from your current Advanced Messaging group conversations.">
                <langSet xml:lang="en-US"><tig><term>You won't be able to share files over 1MB, see read receipts, or see when the recipient is typing.You will also no longer be able to send or receive group messages from your current Advanced Messaging group conversations.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᏝᏰᎵ ᎨᏒᎩ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎠᏯᏙᏍᏗᎢ ᏗᏍᏆᏂᎪᏙᏗ ᎢᏴᏛ 1MB, ᎠᎪᏩᏛᏗ ᎠᎪᎵᏰᏗ ᎠᎩᏒᏅ ᎧᏃᎮᏍᎩ ᎪᏪᎵ, ᎠᎴ ᎠᎪᏩᏛᏗ ᎢᏳᏃ ᏥᎩ ᏗᎦᏁᏍᎩ ᎨᏒᎢ ᎢᏳᏍᏗ.ᏂᎯ ᎠᏎᎢ ᎾᏍᏊ Ꮭ ᎦᏅᎯᏓᎨ ᎨᏒᎩ ᏰᎵᏉ ᎾᎿᎢ ᏫᏅᎥᎦ ᎠᎴ ᎦᏁᏍᏗ ᎤᎾᏓᏡᎬᎢ ᏗᎪᎵᏰᏗ ᏅᏓᏳᏓᎴᏅᎯ ᏂᏨᏅᎢ ᏃᏊ ᏥᎩ ᎢᏴᏛ ᎠᏱᎸᏛ ᏛᎦᏃᏣᎵᏍᎬ ᎤᎾᏓᏡᎬᎢ ᏓᎾᏟᏃᎮᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You are not allowed to send or receive messages in conversations marked as disabled. This is because you chose to leave this group.">
                <langSet xml:lang="en-US"><tig><term>You are not allowed to send or receive messages in conversations marked as disabled. This is because you chose to leave this group.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ Ꮭ ᏱᎩ ᎠᎵᏍᎪᎸᏔᏅ ᎾᎿᎢ ᏫᏅᎥᎦ ᎠᎴ ᎦᏁᏍᏗ ᏗᎪᎵᏰᏗ ᎾᎿ ᏓᎾᏟᏃᎮᏍᎬᎢ ᎪᏪᎳᏅᎯ ᎯᎢᎾᎢ ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ. ᎯᎠ ᎨᏒᎢ ᏅᏗᎦᎵᏍᏙᏗᏍᎬᏃ ᏂᎯ ᎠᏑᏰᏒ ᎾᎿᎢ ᎠᏂᎩᏍᎬ ᎯᎠ ᎤᎾᏓᏡᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Secure level:\u0020">
                <langSet xml:lang="en-US"><tig><term>Secure level:\u0020</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᎾᏰᎯᏍᏛᎾᏉ ᎠᏥᎶᏍᎩ :\u0020</term></tig></langSet>
            </termEntry>
            <termEntry id="Application not ready">
                <langSet xml:lang="en-US"><tig><term>Application not ready</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏲᏍᏙᏗ ᎭᏗ ᎠᏛᏅᎢᏍᏔᏅ ᏱᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Timer management">
                <langSet xml:lang="en-US"><tig><term>Timer management</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᏱᎵᏒ ᎠᎦᏘᏯ ᎠᎾᏓᏅᏖᎵᏙᎯ</term></tig></langSet>
