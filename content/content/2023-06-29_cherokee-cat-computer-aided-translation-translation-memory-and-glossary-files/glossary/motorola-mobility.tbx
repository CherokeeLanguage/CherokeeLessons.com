                <langSet xml:lang="en-US"><tig><term>Ringtone &amp; Vibrate</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>CᎠll rᎢngtᎣᏁ &amp; ᎥᎢbrᎠᏖ</term></tig></langSet>
            </termEntry>
            <termEntry id="Service">
                <langSet xml:lang="en-US"><tig><term>Service</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏗᏛᏁᎵᏓᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="select contact">
                <langSet xml:lang="en-US"><tig><term>select contact</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᏗᏟᏃᎮᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Voice calling not supported">
