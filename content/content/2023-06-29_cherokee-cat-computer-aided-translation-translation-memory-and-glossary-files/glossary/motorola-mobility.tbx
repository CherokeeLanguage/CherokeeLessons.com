            </termEntry>
            <termEntry id="Connection is not safe.">
                <langSet xml:lang="en-US"><tig><term>Connection is not safe.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᎢ ᎨᎡᎢ ᎥᏝ ᏂᎦᎾᏰᎬᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="No need for bluetooth pairing">
                <langSet xml:lang="en-US"><tig><term>No need for bluetooth pairing</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᎤᏚᎸᏓ ᎤᎬᏩᏟ Bluetooth ᏓᎵᎪᏗᏍᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please press CTRL+V to copy  file into your PC.">
                <langSet xml:lang="en-US"><tig><term>Please press CTRL+V to copy  file into your PC.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎠᏐᎥᏍᏙᏗ CTRL+V ᎾᎿᎢ ᏗᏟᎶᏍᏔᏅᎯ  ᎠᏍᏆᏂᎪᏙᏗ ᎾᎿᎢ ᏂᏨᎤᎢ PC.</term></tig></langSet>
            </termEntry>
            <termEntry id="Privacy Policy">
                <langSet xml:lang="en-US"><tig><term>Privacy Policy</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Ignore Do Not Disturb &amp; other volume settings">
                <langSet xml:lang="en-US"><tig><term>Ignore Do Not Disturb &amp; other volume settings</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᏥᎭᎦᏎᏍᏔᏂ ᏞᏍᏗ ᏣᏓᏕᏯᏙᏔᏅᎢ &amp; ᏐᎢ ᎢᎦᎢ ᎤᏃᏴᎬᎢ ᏕᎦᎧᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone can be unlocked when you don\u2019t intend to, like if someone holds it up to your finger.">
                <langSet xml:lang="en-US"><tig><term>Your phone can be unlocked when you don\u2019t intend to, like if someone holds it up to your finger.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏰᎵᏊ ᎨᏒᎢ ᏱᏐᎭᎾᎳᎩ ᎾᎯᏳ ᏂᎯ ᏞᏍᏗ ᎾᏁᎵᏍᎬ ᎾᎢ, ᎾᏍᎩᏯᎢ ᎥᏳᏃ ᎩᎶ ᎩᎶᎢ ᎠᏌᎳᏗᏍᎨᏍᏗ ᎾᎢ ᎯᏰᏌᏛᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you use Pixel Imprint, images are used to update your fingerprint model. Images used to create your fingerprint model are never stored, but the fingerprint model is stored securely on your phone and never leaves the phone. All processing occurs securely on your phone.">
                <langSet xml:lang="en-US"><tig><term>When you use Pixel Imprint, images are used to update your fingerprint model. Images used to create your fingerprint model are never stored, but the fingerprint model is stored securely on your phone and never leaves the phone. All processing occurs securely on your phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎾᎯᏳ ᏱᏨᏔᎾ ᎾᎿ ᏓᏂᏙᎬ ᏂᎯ ᎬᏔᏂᏓᏍᏗ ᎤᏍᏗ ᏅᎩ ᏧᏅᏏᏯ ᎤᏙᏪᎸᎢ, ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᎬᏔᏅᎯ ᎾᎢ ᏗᎪᏢᎯᏌᏅᎯ ᏣᏤᎵ ᎯᏰᏌᏛ ᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎪᏢᏅᎢ. ᏚᏓᏴᎳᏛ ᎬᏔᏅᎯ ᎾᎢ ᎪᏢᏗ ᏣᏤᎵ ᎯᏰᏌᏛ ᎤᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎪᏢᏅᎢ ᎨᏒᎢ Ꮭ ᎢᎸᎯᏳᎢ ᎠᏍᏆᏂᎪᏔᏅ ᏱᎩ, ᎠᏎᏃ ᎾᏍᎩ ᎦᏰᏌᏛ ᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎪᏢᏅᎢ ᏄᏍᏛ ᎠᏍᏆᏂᎪᏔᏅ ᏄᎾᏰᎯᏍᏛᎾ ᎤᎿᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ ᎠᎴ Ꮭ ᎢᎸᎯᏳᎢ ᏯᎯᏯᏍᎪ ᎾᏍᎩ ᏗᏟᏃᎮᏗᎢ. ᏂᎦᏓ ᎠᎵᏱᎵᏍᏒᎢ ᏂᎦᎳᏍᏗᏍᎬ ᏄᎾᏰᎯᏍᏛᎾ ᎤᎾᎢ ᏣᏤᎵ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Will never turn off automatically">
                <langSet xml:lang="en-US"><tig><term>Will never turn off automatically</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎ ᏞᏍᏗ ᎢᎸᎯᏳᎢ ᏱᏛᎵᏍᏚᎾ ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
