            </termEntry>
            <termEntry id="SD card ready">
                <langSet xml:lang="en-US"><tig><term>SD card ready</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SD ᏆᎾᏲᏍᏗ ᏅᏛᏅᎢᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to change the default write disk?">
                <langSet xml:lang="en-US"><tig><term>Do you want to change the default write disk?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎾᎿᎢ ᎯᏁᏟᏴᎾ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᎪᏪᎶᏗ ᎠᏠᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Connected as an autorun cdrom">
                <langSet xml:lang="en-US"><tig><term>Connected as an autorun cdrom</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎫᏓᎸᏅᎯ ᎯᎢᎾᎢ autorun cdrom</term></tig></langSet>
            </termEntry>
            <termEntry id="Sorry, HDMI has stopped due to current phone call.">
                <langSet xml:lang="en-US"><tig><term>Sorry, HDMI has stopped due to current phone call.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏲ ᎤᏰᎸᏅ, HDMI ᎤᎴᏫᏍᏔᏅᎠᏍᏆᏗᏍᏗ ᎾᎿᎢ ᏃᏊ ᏥᎩ ᏗᎳᏃᎮᏗ ᏪᏯᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data connection only">
                <langSet xml:lang="en-US"><tig><term>Data connection only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="LTE network is not available.">
                <langSet xml:lang="en-US"><tig><term>LTE network is not available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>LTE ᎤᏚᏓᎵ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Suggest to change a 4G SIM card.">
                <langSet xml:lang="en-US"><tig><term>Suggest to change a 4G SIM card.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᎢᏍᏙᏗ ᎾᎿᎢ ᎯᏁᏟᏴᎾ 4G SIM ᏆᎾᏲᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to play audio.">
                <langSet xml:lang="en-US"><tig><term>Failed to play audio.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎿᎢ ᎤᎾᏛᏁᎸᏗ ᎤᏃᏴᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to wakeup the tablet when it is in suspend mode through sensor hub.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to wakeup the tablet when it is in suspend mode through sensor hub.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎬᏙᏗ ᎾᎿᎢᎯᏰᎩ ᏗᎪᏪᎶᏗᎢ ᎢᏳᏃ ᎾᎿ ᏗᏲᎯᏍᏗᎢ ᎬᏙᏗ ᏬᎶᎯᏍᏗ ᎠᏩᏘᏍᎩ ᎠᏰᏟ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the app to wakeup the phone when it is in suspend mode through sensor hub.">
                <langSet xml:lang="en-US"><tig><term>Allows the app to wakeup the phone when it is in suspend mode through sensor hub.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎬᏙᏗ ᎾᎿᎢᎯᏰᎩ ᏗᎳᏃᎮᏗ ᎢᏳᏃ ᎾᎿ ᏗᏲᎯᏍᏗᎢ ᎬᏙᏗ ᏬᎶᎯᏍᏗ ᎠᏩᏘᏍᎩ ᎠᏰᏟ.</term></tig></langSet>
            </termEntry>
            <termEntry id="maximum application">
                <langSet xml:lang="en-US"><tig><term>maximum application</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᎨ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="If mobile network isn't available, you may not be able to make calls.">
                <langSet xml:lang="en-US"><tig><term>If mobile network isn't available, you may not be able to make calls.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ ᎨᎡᎢ ᎠᏛᏅᎢᏍᏔᏅ, ᏂᎯ ᏰᎵᏯ ᎥᏝ ᎨᎡᎢ ᏰᎵ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎪᏢᏗ ᏓᏯᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Search for AT&amp;T MicroCell">
                <langSet xml:lang="en-US"><tig><term>Search for AT&amp;T MicroCell</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᏍᏗ ᎾᏍᎩᎾ AT&amp;T MicroCell</term></tig></langSet>
            </termEntry>
            <termEntry id="LTE only">
                <langSet xml:lang="en-US"><tig><term>LTE only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>LTE ᎤᏩᏌ</term></tig></langSet>
            </termEntry>
            <termEntry id="Licenses have been deleted successfully.">
                <langSet xml:lang="en-US"><tig><term>Licenses have been deleted successfully.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᎯ ᎧᎵ ᎠᏍᎪᎸᏛᎯ ᏄᏓᏄᎸᏅᎾᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable 2G">
                <langSet xml:lang="en-US"><tig><term>Disable 2G</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ 2G</term></tig></langSet>
            </termEntry>
            <termEntry id="All open,closed or hybrid femtocells.">
                <langSet xml:lang="en-US"><tig><term>All open,closed or hybrid femtocells.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ ᎯᏍᏚᎢ,ᎠᏍᏚᏅᎩ ᎠᎴ ᏗᎵᎪᏔᏅᎢ femtocells.</term></tig></langSet>
            </termEntry>
            <termEntry id="Failed to switch to .">
                <langSet xml:lang="en-US"><tig><term>Failed to switch to .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᎸᎲᎩ ᎾᎿ ᎦᏁᏟᏴᏍᏗ ᎾᎿ .</term></tig></langSet>
            </termEntry>
            <termEntry id="Over the limit size">
                <langSet xml:lang="en-US"><tig><term>Over the limit size</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛ ᎾᏍᎩ ᎢᎩᏓ ᎠᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tag mode">
                <langSet xml:lang="en-US"><tig><term>Tag mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏛ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Are you sure to use GPS provided time?">
                <langSet xml:lang="en-US"><tig><term>Are you sure to use GPS provided time?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏒᎢ ᏂᎯ ᎤᏙᎯᏳ ᎾᎿ ᎬᏙᏗ GPS ᎠᏛᏅᎢᏍᏔᏅ ᎠᏟᎢᎵᏒ?</term></tig></langSet>
            </termEntry>
            <termEntry id="To use GPS provided time, you must enable GPS first.">
                <langSet xml:lang="en-US"><tig><term>To use GPS provided time, you must enable GPS first.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᎬᏙᏗ GPS ᎠᏛᏅᎢᏍᏔᏅ ᎠᏟᎢᎵᏒ, ᏂᎯ ᎠᏎ ᎡᎵᏊ ᏱᎬᏛᏁᏗ GPS ᎢᎬᏱᏱ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Besides, GPS may fail to provide time due to weak environmental signal.">
                <langSet xml:lang="en-US"><tig><term>Besides, GPS may fail to provide time due to weak environmental signal.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩ ᏂᏗᎨᏒᎾ, GPS ᏰᎵᏉ ᎤᏄᎸᏅ ᎾᎿ ᎠᏓᏁᎳᏁᏗ ᎠᏟᎢᎵᏒ ᏂᏗᎦᎵᏍᎡᏗᎬ ᎾᎢ ᎤᏩᎾᎦᎳᎢ ᎡᏍᎦᏂ ᏄᏍᏗᏓᏅᎢ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Network data controller">
