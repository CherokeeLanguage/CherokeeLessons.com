                <langSet xml:lang="chr"><tig><term>ᏓᎳᏏᏛᎢ ᎧᏃᎸᎥᏍᎩ ᏄᏰᎵᏛ </term></tig></langSet>
            </termEntry>
            <termEntry id="Find it fast">
                <langSet xml:lang="en-US"><tig><term>Find it fast</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎯᏩᏔ</term></tig></langSet>
            </termEntry>
            <termEntry id="Information">
                <langSet xml:lang="en-US"><tig><term>Information</term></tig></langSet>
