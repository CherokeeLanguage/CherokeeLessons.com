                <langSet xml:lang="en-US"><tig><term>For more information,please refer to the contract for provisioning of services and / or financing.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎪᏕᏍᏗᏃ ᎧᏃᎮᏢᎥᏍᎩ,ᎰᏩᏊ ᏩᏎᏍᏗ ᎾᎿᎢ ᏓᏓᏁᏤᎸ ᎾᏍᎩᎾ ᎢᏳᎾᏓᏛᏁᏗ ᎤᎾᎵᏍᏕᎸᏙᏗ ᎠᎴ / ᎠᎴ ᎠᏕᎸ ᏓᏅᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Such device lock can be eliminated once the payments for the equipment have been settled or the mandatory time period has expired.">
                <langSet xml:lang="en-US"><tig><term>Such device lock can be eliminated once the payments for the equipment have been settled or the mandatory time period has expired.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏍᎩᏯ ᏥᏂᎬᏅᏗᏓᎾ ᏍᏓᏱ ᎠᏍᏚᎭ  ᎪᏣᎴᏍᏓ ᏰᎵᏊ ᏌᏊᏊ ᏗᏈᏴᎲᏍᏗ ᎾᏍᎩᎾ ᎬᏔᏅᏙᏗ ᏗᏓᏙᎳᏤᎸ ᎤᏒᎦᎵ ᏱᎨᏎ ᎠᎴ ᎠᏎᏯᏛᏁᏗ ᎠᏟᎢᎵᏒ ᏓᏓᎴᏛ ᎤᎶᏒᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Licenses detail">
                <langSet xml:lang="en-US"><tig><term>Licenses detail</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏫᏚᏍᏗᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Depending on the country and operator with which it was acquired, the device will be locked to be used only with them, for the time it is associated with a forced term and/or financing.">
                <langSet xml:lang="en-US"><tig><term>Depending on the country and operator with which it was acquired, the device will be locked to be used only with them, for the time it is associated with a forced term and/or financing.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎦᏍᏙᏗᏍᎬ ᎤᎾᎢ ᎠᏰᏟ ᎠᎴ ᎠᎯᎵᏙᎯ ᏥᎩ ᎠᎩᏓ, ᏥᏂᎬᏅᏗᏓᎾ ᏍᏓᏯ ᎠᏍᏚᎭ ᎬᏔᏅᎯ ᎤᏩᏌ ᎬᏗ, ᎾᏍᎩᏯ ᏥᎩ ᎠᏟᎢᎵᏒ ᏚᎵᎪᏒᎢ ᎬᏗ ᏓᎨᏥᏌᏙᏴ ᏓᏓᏁᏤᎸ ᎠᎴ/ᎠᎴ ᎠᏕᎸ ᏓᏅᏗᏍᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Licenses">
                <langSet xml:lang="en-US"><tig><term>Licenses</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="The device is enabled once the payment is made for the pending balance.">
                <langSet xml:lang="en-US"><tig><term>The device is enabled once the payment is made for the pending balance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎠᎵᏍᎪᎸᏓᏁᎯ ᏌᏊᏊ ᏗᏈᏴᎲᏍᏗ ᏄᏍᏛ ᏄᎵᏍᏔᏅ ᎾᏍᎩᎾ ᎠᎵᏱᎵᏙᎲ ᎢᏗᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The debugging mode is disabled">
                <langSet xml:lang="en-US"><tig><term>The debugging mode is disabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎬᎢ ᎬᏙᏗ ᏗᎬᏩᎸᏫᏍᏓᏁᏗ ᏂᎨᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="The debugging mode is enabled">
                <langSet xml:lang="en-US"><tig><term>The debugging mode is enabled</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎬᎢ ᎬᏙᏗ ᎠᎵᏍᎪᎸᏓᏁᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disables the equipment in case of non-payment of monthly device and/or financing fees.">
                <langSet xml:lang="en-US"><tig><term>Disables the equipment in case of non-payment of monthly device and/or financing fees.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᏂᎨᏒᎾ ᎬᏔᏅᏙᏗ ᎾᎿ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏏᏅᏓ ᏂᎦᎵᏍᏔᏂᏒ ᎥᏝ-ᏗᏈᏴᎲᏍᏗ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎴ/ᎠᎴ ᎠᏕᎸ ᏓᏅᏗᏍᎬ ᎤᎾᏓᏠᏒᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Phone Protect and SIM Key">
                <langSet xml:lang="en-US"><tig><term>Phone Protect and SIM Key</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎳᏃᎮᏗ ᎠᏓᎦᏎᏍᏙᏗ ᎠᎴ SIM ᏍᏚᎢᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only applicable in case your device is subject to any type of financing or forced term.">
                <langSet xml:lang="en-US"><tig><term>Only applicable in case your device is subject to any type of financing or forced term.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏗᏓᏂᎸᎩ ᎾᎿ ᎠᏓᏁᏟᏴᏍᏗᏍᎩ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᎾᏓᏅᏖᏍᎬ ᎢᏳᎵᏍᏔᏂᏓᏍᏗ ᏂᎦᎥ ᎢᏳᏍᏗ ᎠᏕᎸ ᏓᏅᏗᏍᎬ ᎠᎴ ᎤᏩᏌᏙᏴ ᎠᏎᎸᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Erase the face information">
                <langSet xml:lang="en-US"><tig><term>Erase the face information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎠᏍᎪᎸᏗᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to erase the face information">
                <langSet xml:lang="en-US"><tig><term>Do you want to erase the face information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎠᏍᎪᎸᏗᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="After record successfully, upon wake up the screen, you can unlock phone through face configuration.">
                <langSet xml:lang="en-US"><tig><term>After record successfully, upon wake up the screen, you can unlock phone through face configuration.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎶᏐᏅ ᎢᏳᎵᏍᏙᏗ ᏄᎵᏍᏔᏅᎩ ᏕᎦᏅᏅᏛᎢ, ᎾᎿᎢ ᎠᏰᏙᎳᏛᎢ ᎯᏰᎩ, ᎤᏂᏐᎭᎾᎸᏗ ᏗᎳᏃᎮᏗ ᏂᎯ ᏰᎵᏇ ᎤᎧᏛ ᏄᏍᏛ ᎪᏢᏒᎢ ᏭᎵᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Add the face information">
                <langSet xml:lang="en-US"><tig><term>Add the face information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎧᏁᏉᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please avoid under the dim light or with lens dirty.">
                <langSet xml:lang="en-US"><tig><term>Please avoid under the dim light or with lens dirty.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᏗᏓᏅᏗᏍᏙᏗ ᎭᏫᏂᏗᏢ ᎯᏍᎪᎸᏓ ᎢᎦᎦᏘ ᏃᎴ ᎬᏗ ᎦᏓᎭ ᏗᏓᎨᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When recording, your face shall not upward, downward or side.">
                <langSet xml:lang="en-US"><tig><term>When recording, your face shall not upward, downward or side.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᎦᏂᏴᎲᎢ, ᏣᏤᎵ ᎤᎧᏛ ᎠᏎᎢ ᎥᏝ ᎦᎸᎳᏗ ᎢᏗᏢ ᏭᎦᏖᏍᏗ, ᎠᎦᏠᎥᏙᏗᏱ ᏃᎴ ᎠᏍᏆᎨᏂ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Different face is detected">
                <langSet xml:lang="en-US"><tig><term>Different face is detected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏛᏓ ᏧᏓᎴᎿᎢ ᎤᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="The security level of face configuration is lower than finger print, pattern, password.">
                <langSet xml:lang="en-US"><tig><term>The security level of face configuration is lower than finger print, pattern, password.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎦᏎᏍᏗ ᎤᏩᎾᏕᏍᎩ ᏄᏍᏛ ᎪᏢᏒᎢ ᎡᎳᏗᏢ ᎡᏍᎦᏉ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ, ᎤᎾᎶᎢᏓ, ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone can be unlocked through the similar face or the object similar to your face.">
                <langSet xml:lang="en-US"><tig><term>Your phone can be unlocked through the similar face or the object similar to your face.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎳᏃᎮᏗ ᏰᎵᏇ ᎦᏐᎭᎾᎳᏕᏗ ᏭᎵᏍᏗ ᎤᏠᏱ ᎤᎧᏛ ᏃᎴ ᎪᎱᏍᏗ ᎤᏠᏱ ᏣᏤᎵ ᎤᎧᏛ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The light is bad">
                <langSet xml:lang="en-US"><tig><term>The light is bad</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎦᏘ ᏄᏍᏛ ᎤᏲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disclaimer">
                <langSet xml:lang="en-US"><tig><term>Disclaimer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏱᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock fail">
                <langSet xml:lang="en-US"><tig><term>Unlock fail</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᏐᎭᎾᎸᏗ ᎤᏄᎸᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Please add face information">
                <langSet xml:lang="en-US"><tig><term>Please add face information</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎰᏩᏊ ᎤᎧᏛ ᎧᏃᎮᏢᎥᏍᎩ ᎧᏁᏉᏍᏗᎰᏩᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlock success">
                <langSet xml:lang="en-US"><tig><term>Unlock success</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏂᏐᎭᎾᎸᏗ ᎠᏍᏆᏙᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="To unlock your phone, just turn your screen on and look at the camera.">
                <langSet xml:lang="en-US"><tig><term>To unlock your phone, just turn your screen on and look at the camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎤᏂᏐᎭᎾᎸᏗ ᏗᎳᏃᎮᏗ, ᎯᏍᏚᎢ ᎠᏰᏙᎳᏛᎢ ᏃᎴ ᏗᎧᏃᏗᎢ ᏗᏓᏟᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep the top of your head and the bottom of your chin within the circle.">
                <langSet xml:lang="en-US"><tig><term>Keep the top of your head and the bottom of your chin within the circle.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏚᎢ ᎾᎿ ᏣᏤᎵ ᎠᏍᎪᎳ ᏣᎮᏍᏗ ᏃᎴ ᎡᎳᏗᏢ ᎾᎿ ᎧᏳᎨᏂ ᎠᏫᏂᏗᏢ ᎦᏐᏆᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Your phone will unlock if it recognises you.">
                <langSet xml:lang="en-US"><tig><term>Your phone will unlock if it recognises you.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏗᎳᏃᎮᏗ ᎠᏎᎢ ᎤᏂᏐᎭᎾᎸᏗ ᎢᏳᏃ ᏗᏓᏙᏟᏍᏗ ᏂᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Don't move">
                <langSet xml:lang="en-US"><tig><term>Don't move</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏞᏍᏗ ᎯᎲᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep still">
                <langSet xml:lang="en-US"><tig><term>Keep still</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᏏᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="More than one face is detected">
                <langSet xml:lang="en-US"><tig><term>More than one face is detected</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟ ᎢᎦᎢ ᎡᏍᎦᏉ ᏌᏊ ᎤᎧᏛ ᎪᎷᏩᏛᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="The light is too bright">
                <langSet xml:lang="en-US"><tig><term>The light is too bright</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎦᏘ ᎾᏍᏉ ᎤᏍᎪᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Move back">
                <langSet xml:lang="en-US"><tig><term>Move back</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎲᎾ ᎠᏏᎾᎦᏘ</term></tig></langSet>
            </termEntry>
            <termEntry id="The light is not good enough">
                <langSet xml:lang="en-US"><tig><term>The light is not good enough</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎦᏘ ᎥᏝ ᎣᏍᏛ ᏰᎵᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="Face does not be registered">
                <langSet xml:lang="en-US"><tig><term>Face does not be registered</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏨᎧᏛ ᎾᏛᏁ ᎥᏝ ᎠᎪᏪᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Detecting the face">
                <langSet xml:lang="en-US"><tig><term>Detecting the face</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎩ ᏨᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="If your face is not recognised, to unlock with your pattern, PIN or password instead.">
                <langSet xml:lang="en-US"><tig><term>If your face is not recognised, to unlock with your pattern, PIN or password instead.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏨᎧᏛ ᎥᏝ ᎤᏬᎳᏨᎩ, ᎾᎿᎢ ᎤᏂᏐᎭᎾᎸᏗ ᎬᏗ ᏣᏤᎵ ᎤᎾᎶᎢᏓ, PIN ᏃᎴ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎤᎬᏫᏳᏎᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Totally  file(s) successed">
                <langSet xml:lang="en-US"><tig><term>Totally  file(s) successed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏟᏌᏃᏅᎯ  ᏗᏍᏆᏂᎪᏙᏗ ᎤᏁᏉᏤᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="BBC Bangla">
                <langSet xml:lang="en-US"><tig><term>BBC Bangla</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>BBC Bangla</term></tig></langSet>
            </termEntry>
            <termEntry id="Radio Foorti">
                <langSet xml:lang="en-US"><tig><term>Radio Foorti</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Radio Foorti</term></tig></langSet>
            </termEntry>
            <termEntry id="Bangladesh Betar">
                <langSet xml:lang="en-US"><tig><term>Bangladesh Betar</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Bangladesh Betar</term></tig></langSet>
            </termEntry>
            <termEntry id="Radio Today">
                <langSet xml:lang="en-US"><tig><term>Radio Today</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Radio Today</term></tig></langSet>
            </termEntry>
            <termEntry id="Type channel here">
                <langSet xml:lang="en-US"><tig><term>Type channel here</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᎦᎳᏅᏛ ᎠᎭᏂ</term></tig></langSet>
            </termEntry>
            <termEntry id="Duplicate, please rename!">
                <langSet xml:lang="en-US"><tig><term>Duplicate, please rename!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏟᎶᏍᏔᏅᎯ, ᎰᏩᏊ ᏥᏙᎰᏣ!</term></tig></langSet>
            </termEntry>
            <termEntry id="Cancel sleep timer">
                <langSet xml:lang="en-US"><tig><term>Cancel sleep timer</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏒᏗ ᎦᏟᏔᏗᏍᎩ ᏂᎦᏯᏄᎸ ᏥᏂᎦᎵᏍᏓ ᎠᏥᎶᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="FM Recorded file saved to ">
                <langSet xml:lang="en-US"><tig><term>FM Recorded file saved to </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>FM ᎦᏂᏴᏔᏅ ᎠᏍᏆᏂᎪᏙᏗ ᎠᎵᏏᏅᏔᏅᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Station name is empty, please input again.">
                <langSet xml:lang="en-US"><tig><term>Station name is empty, please input again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎴᏫᏍᏙᏗ ᏚᏙᎥᎢ ᎤᏑᏩ, ᎰᏩᏊ ᏂᏛᏴᎯ ᏏᏊ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically stop playing after 1 minute">
                <langSet xml:lang="en-US"><tig><term>Automatically stop playing after 1 minute</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌᏊ ᏱᎬᏁᎯ ᎠᏎᏒᏗ ᎤᎾᏛᏁᎸᏗ ᎤᎶᏐᏅ 1 ᎢᏯᏔᏬᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="Operations">
                <langSet xml:lang="en-US"><tig><term>Operations</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏂᏱᎵᏒᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Move slider to select when to stop playback automatically.">
                <langSet xml:lang="en-US"><tig><term>Move slider to select when to stop playback automatically.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎲᎾ ᏗᎲᏍᎩ ᎠᏑᏰᏍᏗ ᎢᏳᏃ ᎠᏎᏒᏗ ᏙᎠᏁᎶᏗᏍᎩ ᎤᏩᏌᏊ ᏱᎬᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Plug in your headset to get started!">
                <langSet xml:lang="en-US"><tig><term>Plug in your headset to get started!</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎧᏁᏉᏍᏙᏗ ᏗᏟᏳᏦᎾᏗᏍᏗ ᎾᎿᎢ ᎠᏛᏅᎢᏍᏗᏍᎬ ᎤᏂᎩᏍᏙᏗᎢ!</term></tig></langSet>
