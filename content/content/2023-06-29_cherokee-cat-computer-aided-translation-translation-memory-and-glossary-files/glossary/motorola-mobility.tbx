                <langSet xml:lang="chr"><tig><term>ᎤᏄᎸᏅᎢ ᎭᏂᎩᏍᏙᏗ </term></tig></langSet>
            </termEntry>
            <termEntry id="To create this fingerprint model during setup, they will take images of their fingerprint from different positions.">
                <langSet xml:lang="en-US"><tig><term>To create this fingerprint model during setup, they will take images of their fingerprint from different positions.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>To ᎪᏢᏗ ᎯᎠ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎾᎯᏳ ᎨᏒ ᏘᎧᎲᎦ, ᏂᎯ ᎠᏎ ᎠᎩᏍᏗ ᏚᏓᏴᎳᏛ ᎤᎿ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᏅᏓᏳᏓᎴᏅᎯ ᏧᏓᎴᎿᎢ ᎾᎿ ᏓᏂᏙᎬ.</term></tig></langSet>
            </termEntry>
            <termEntry id="When you use Pixel Imprint, images are used to update your fingerprint model.">
                <langSet xml:lang="en-US"><tig><term>When you use Pixel Imprint, images are used to update your fingerprint model.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿ ᏓᏂᏙᎬ ᏂᎯ ᎬᏔᏂᏓᏍᏗ Pixel Imprint, ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᎬᏔᏅᎯ ᎾᎿᎢ ᏗᎪᏢᎯᏌᏅᎯ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery may run out earlier than usual">
                <langSet xml:lang="en-US"><tig><term>Battery may run out earlier than usual</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᏰᎵᏉ ᎠᏓᎾᏫᏍᏗ ᎦᏅᎪᏫᏛ ᎢᎬᏱᎯᎨᏍᏗ ᎡᏍᎦᏉ ᎾᏍᎩᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="For  minutes">
                <langSet xml:lang="en-US"><tig><term>For  minutes</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ  ᎢᏗᏔᏬᏍᏔᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Images used to create your fingerprint model are never stored, but the fingerprint model is stored securely on your phone and never leaves the phone.">
                <langSet xml:lang="en-US"><tig><term>Images used to create your fingerprint model are never stored, but the fingerprint model is stored securely on your phone and never leaves the phone.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᏚᏓᏴᎳᏛ ᎨᏒᎢ ᎬᏔᏅᎯ ᎪᏢᏗ ᏂᏨᎤᎢ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎨᏒᎢ ᏞᏍᏗ ᎢᎸᎯᏳᎢ ᎠᏍᏆᏂᎪᏔᏅ, ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᏄᎾᏰᎯᏍᏛᎾ ᎤᎿᎢ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎠᎴ ᎢᎸᎯᏳᎢ ᏧᎦᎶᎦ ᏥᎩ ᏗᏟᏃᎮᏗ.</term></tig></langSet>
            </termEntry>
