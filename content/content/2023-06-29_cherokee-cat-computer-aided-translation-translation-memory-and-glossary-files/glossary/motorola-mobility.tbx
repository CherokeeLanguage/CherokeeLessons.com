                <langSet xml:lang="chr"><tig><term>ᎬᏂᏗᏍᏗ ᎠᏥᎢᎵᏒᎢ ᏄᏍᏛ ᎾᏍᏉ ᎦᏅᎯᏗᎢ, ᎰᏩᏊ ᏭᏓᎳᎩ ᎾᏍᎩ ᎬᏂᏗᏍᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Maximum  files at a time">
                <langSet xml:lang="en-US"><tig><term>Maximum  files at a time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏭᎪᏛᎢ  ᏗᏍᏆᏂᎪᏙᏗ ᎾᎿᎢ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Thanks for contacting us.">
