                <langSet xml:lang="chr"><tig><term>ᎢᏤ ᏗᎦᏃᏣᎳᏅᎯ ᎪᏢᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select a VPN profile to always remain connected to. Network traffic will only be allowed when connected to this VPN.">
                <langSet xml:lang="en-US"><tig><term>Select a VPN profile to always remain connected to. Network traffic will only be allowed when connected to this VPN.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ Ꭰ VPN ᏄᏍᏗᏓᏅᎢ ᎤᎿᎢ ᏂᎪᎯᎸᎢ ᎤᏓᏃᎯᏴ ᎫᏓᎸᏅᎯ ᎤᎿᎢ. ᏧᎾᏚᏓᎵ ᏓᏓᏅᏓᏁᎸ ᎠᏎᎢ ᎤᏅᏒ ᎨᏒᎩ ᎠᎵᏍᎪᎸᏔᏅ ᎢᏳᏃ ᎫᏓᎸᏅᎯ ᎤᎿᎢ ᎯᎠ VPN.</term></tig></langSet>
            </termEntry>
            <termEntry id="Sync is currently experiencing problems. It will be back shortly.">
                <langSet xml:lang="en-US"><tig><term>Sync is currently experiencing problems. It will be back shortly.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏧᎳᎭ ᏱᏗᎬᏁᎸᎢ ᏓᏓᎴᏍᏗᏍᎬ ᎠᎦᏙᎲᏍᏗ ᏃᏊᎨᏒᎢ. ᎨᏒᎩ ᎠᏨᏍᏗ ᏂᎪᎯᎸᎾᏉ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly access accessibility features from any screen. To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.">
                <langSet xml:lang="en-US"><tig><term>Quickly access accessibility features from any screen. To get started, go to accessibility settings and select a feature. Tap on the shortcut and select the accessibility button.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏩᏴᏍᏗᎢ ᎬᏴᏍᏗ ᎨᏒᎢ ᏗᎦᏎᏍᏙᏗ ᏂᎦᎥᏉ ᎠᏴᏙᎳᏛᎢ ᏅᏛᏓᎵᏂᏍᎩ. ᎾᎿᎢ ᎭᎴᏅᎲᎩ, Ꭷ ᎬᏴᏍᏗ ᎨᏒ ᏕᎦᎧᎲᎢ ᎠᎴ ᎠᏑᏰᏍᏗ Ꭰ ᎤᏩᎬᏗᏗᏒ. ᏥᏳᎪᏗ ᎢᎬᏁᎯ ᎠᎴ ᎬᏴᏍᏗ ᎨᏒᎢ ᎦᏛᏗ ᎠᏑᏰᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Backup &amp; restore">
                <langSet xml:lang="en-US"><tig><term>Backup &amp; restore</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏏᏄᎦ &amp; ᎪᏢᎯᏐᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery usage data will be available after you use your phone for a few hours">
                <langSet xml:lang="en-US"><tig><term>Battery usage data will be available after you use your phone for a few hours</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎾᎦᎵᏍᎩ ᎬᏙᏗᎢ ᎦᏟᏌᏅᎯ ᎠᏛᏅᎢᏍᏔᏅ ᏰᎵᏉ ᎨᏎᏍᏗ ᎤᎶᏐᏅ ᎤᎶᏐᏅ ᎢᎸᏍᎩ ᎢᏧᏟᎶᏓ ᎾᏍᎩᎾ ᏗᎳᏃᎮᏗ ᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Estimate may change based on usage">
                <langSet xml:lang="en-US"><tig><term>Estimate may change based on usage</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎦᎢᏛ ᏰᎵᏉ ᏯᏓᏁᏟᏴᎾ ᎤᏙᏢᏒ ᎤᎾᎢ ᎬᏙᏗᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stop app?">
                <langSet xml:lang="en-US"><tig><term>Stop app?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᎴᏫᏍᏓ ᎬᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly tap screen {0,number,integer} times. This shortcut may slow down your device">
                <langSet xml:lang="en-US"><tig><term>Quickly tap screen {0,number,integer} times. This shortcut may slow down your device</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮘckly Ꮤp ᏍcrᎡᎡn {0, ᏄmbᎡr, ᎢnᏖᎨr} ᏘᎺᏍ. ᏥᏳᎪᏗ ᎢᎬᏁᎯ ᏰᎵᏉ ᏥᎯᏍᎦᏃᎳᏗ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do you want to remove this instant app?">
                <langSet xml:lang="en-US"><tig><term>Do you want to remove this instant app?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏚᎵᎭᏍ ᎠᎲᏍᏗ ᎯᎠ ᎩᎳᏫᏴᎢ ᎬᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="This helps capture your full fingerprint">
                <langSet xml:lang="en-US"><tig><term>This helps capture your full fingerprint</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᏕᎵᏍᎪᎢ ᎦᏂᏴᏗ ᏣᏤᎵ ᏧᎧᎵᏨᎯ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disabling background data extends battery life and lowers data use. Some apps may still use the background data connection.">
                <langSet xml:lang="en-US"><tig><term>Disabling background data extends battery life and lowers data use. Some apps may still use the background data connection.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᏥᏅᎯᏗᏍᏗ ᎠᎾᎦᎵᏍᎩ ᎬᏅᎢ ᎠᎴ ᏤᎳᏗᏢ ᎦᏟᏌᏅᎯ ᎬᏙᏗ. ᎢᎦᏓ ᏗᎬᏙᏗ ᏰᎵᏉ ᏏᏉ ᎲᏗᏍᎬ ᏥᎩ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᎦᏟᏌᏅᎯ ᎫᏓᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Allow access to your contacts and call history">
                <langSet xml:lang="en-US"><tig><term>Allow access to your contacts and call history</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ ᎠᏴᏍᏗ ᏣᏤᎵ ᏗᏟᏃᎮᏙᏗ ᎠᎴ ᏪᏯᎾ ᏂᏧᎵᏍᏔᏅᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Auto\u2011connect">
                <langSet xml:lang="en-US"><tig><term>Auto\u2011connect</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏒ\u2011ᎱᏓᎸᎥᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="^1 background from last full charge">
                <langSet xml:lang="en-US"><tig><term>^1 background from last full charge</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>^1 ᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎾᎯᏳ ᎣᏂ ᎧᎵ ᎬᏂᏗᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Manage backup account">
                <langSet xml:lang="en-US"><tig><term>Manage backup account</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏱᎸᏍᏗ ᎠᏍᏆᏂᎪᏙᏗ ᎠᏚᏓᎸᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Stats type">
                <langSet xml:lang="en-US"><tig><term>Stats type</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏍᏗ ᏗᏎᏍᏗ ᎧᏃᎮᏢᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Credentials are not available for this user">
                <langSet xml:lang="en-US"><tig><term>Credentials are not available for this user</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᎪᎸᏓᏁᎯ ᎨᏒᎩ Ꮭ ᎠᏛᏅᎢᏍᏔᏅ ᎾᏍᎩᎾ ᎬᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:">
                <langSet xml:lang="en-US"><tig><term>To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎭᎵᏏᏅᏓ ᎠᎾᎦᎵᏍᎩ, ᎭᎴᏫᏍᏓ ᎯᎠᏃ ᏗᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ. ᎠᏓᎨᏗᏍᎩ ᏗᎬᏙᏗ ᏗᏙᎳᏤᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏰᎵᏊ Ꮭ ᎠᎴ ᏗᏓᏃᏣᎳᏁᎯ ᎤᏬᎯᏛ.ᏗᎬᏙᏗ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Your device can't manage battery normally because  keeps requesting your location when you're not using the app.To fix this issue, you can turn off location for this app.">
                <langSet xml:lang="en-US"><tig><term>Your device can't manage battery normally because  keeps requesting your location when you're not using the app.To fix this issue, you can turn off location for this app.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr pᎰᏁ cᎠn't ᎹᎾᎨ bᎠtᏖry ᏃrᎹlly bᎡcᎠᎤᏎ  kᎡᎡpᏍ rᎡᏇᏍᏘng ᏲᎤr ᎶcᎠᏘᎣn wᎮn ᏲᎤ'rᎡ Ꮓt ᎤᏏng tᎮ Ꭰpp.ᎣᏍᏓ ᏱᏨᏁᏗ ᎠᏓᎴᎬᎢ, ᎠᏍᏚᏗ ᏂᎯ ᏰᎵᏊ ᎾᏍᎩᎾ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Not optimized">
                <langSet xml:lang="en-US"><tig><term>Not optimized</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎥᏝ ᏩᎧᎵᏏᏌᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="No account is currently storing backed up data">
                <langSet xml:lang="en-US"><tig><term>No account is currently storing backed up data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꮭ ᎠᏚᏓᎸᏗ ᎠᏍᏆᏂᎪᏗ ᏃᏊᎨᏒᎢ ᎭᏏᏄᎦ ᎦᏟᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Magnify with shortcut &amp; triple-tap">
                <langSet xml:lang="en-US"><tig><term>Magnify with shortcut &amp; triple-tap</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏔᏃᏍᎩ ᎬᏗ ᏥᏳᎪᏗᏊ &amp; ᏦᎢ ᎢᎦᎢ-ᎤᏟᏍᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically back up device data (such as Wi-Fi passwords and call history) and app data (such as settings and files stored by apps) remotely.When you turn on automatic backup, device and app data is periodically saved remotely. App data can be any data that an app has saved (based on developer settings), including potentially sensitive data such as contacts, messages, and photos.">
                <langSet xml:lang="en-US"><tig><term>Automatically back up device data (such as Wi-Fi passwords and call history) and app data (such as settings and files stored by apps) remotely.When you turn on automatic backup, device and app data is periodically saved remotely. App data can be any data that an app has saved (based on developer settings), including potentially sensitive data such as contacts, messages, and photos.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏏᏄᎦ ᏥᏂᎬᏅᏗᏓᎾ ᎦᏟᏌᏅᎯ ᎤᏩᏌᏊ ᏱᎬᏁᎯ (ᎾᏍᎩᏯ ᎢᏳᏍᏗ Wi-Fi ᎥᎧᏁᎬᎢ ᏗᏍᏚᎢᏍᏙᏗ ᎠᎴ ᏫᏣᏔᏅᎩ ᏂᏧᎵᏍᏔᏅᏒ ) ᎠᎴ ᏗᎬᏙᏗ ᎦᏟᏌᏅᎯ (ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᏕᎦᎧᎲᎢ ᎠᎴ ᏗᏍᏆᏂᎪᏙᏗ ᎠᏍᏆᏂᎪᏗ ᎬᏗ ᏗᎬᏙᏗ) ᎢᏅᎯᏴ.WᎮn ᏲᎤ tᎤrn Ꭳn ᎠᎤtᎣᎹᏘc bᎠckᎤp, ᏕᎥᎢcᎡ Ꭰnd Ꭰpp ᏓᏔ ᎢᏍ pᎡrᎢᎣᏗcᎠlly ᏌᎥᎡd rᎡᎼᏖly. ᎬᏙᏗ ᎦᏟᏌᏅᎯ ᏰᎵᏊ ᎨᏎᏍ ᏂᎦᎥᏉ ᎦᏟᏌᏅᎯ ᎬᏙᏗ ᎠᎵᏏᏅᏔᏅᎢ (ᎪᏢᏍᎩ ᏕᎦᎧᎲᎢ ᏓᎳᏏᏔᏅᎩ ᎤᎾᎢ), ᎤᏠᏯᏍᏗ ᏳᏩᎵᏍᏙᏗ ᎤᏓᏁᏟᏴᏍᏌᏘ ᎦᏟᏌᏅᎯ ᎾᏍᎩᏯ ᎢᏳᏍᏗ ᏗᏟᏃᎮᏙᏗ , ᏗᎪᎵᏰᏗ, ᎠᎴ ᏗᏟᎶᏍᏔᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Over-counted">
                <langSet xml:lang="en-US"><tig><term>Over-counted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛ-ᏗᏎᎸᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your tablet can't manage battery normally because  is keeping your tablet awake.To try to fix this issue, you can stop the app.If this keeps happening, you may need to uninstall the app to improve battery performance.">
                <langSet xml:lang="en-US"><tig><term>Your tablet can't manage battery normally because  is keeping your tablet awake.To try to fix this issue, you can stop the app.If this keeps happening, you may need to uninstall the app to improve battery performance.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏲᎤr pᎰᏁ cᎠn't ᎹᎾᎨ bᎠtᏖry ᏃrᎹlly bᎡcᎠᎤᏎ  iᎢᏍ kᎡᎡpᎢng ᏲᎤr pᎰᏁ ᎠᏩkᎡTᎣ try tᎣ fᎢx tᎯᏍ ᎢᏍᏑᎡ, ᏲᎤ cᎠn ᏍtᎣp tᎮ Ꭰpp.ᏍᏓ ᏓᏍᏆᏂᎪᏗ ᏂᎦᎵᏍᏗᏍᎬ, ᏅᏅᏓᎩ ᎬᏙᏗ ᏂᎯ ᏰᎵᏉ ᎤᏚᎸᏓ ᎾᎿᎢ ᎠᎾᎦᎵᏍᎩ ᏚᎸᏫᏍᏓᏁᎲᎢ ᎪᏢᎯᏐᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile radio active">
                <langSet xml:lang="en-US"><tig><term>Mobile radio active</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏬᏂᏍᎩ ᎠᎵᏖᎸᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Battery used by Bluetooth">
                <langSet xml:lang="en-US"><tig><term>Battery used by Bluetooth</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏗ ᎬᏔᏅᎯ ᎬᏗ Bluetooth</term></tig></langSet>
            </termEntry>
            <termEntry id="Share your device by adding new users. Each user has a personal space on your device for custom Home screens, accounts, apps, settings, and more.">
                <langSet xml:lang="en-US"><tig><term>Share your device by adding new users. Each user has a personal space on your device for custom Home screens, accounts, apps, settings, and more.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏯᏙᏍᏗᎢ ᎬᏗ ᎧᏁᏉᏍᏗᏍᎬ ᎢᏤ ᏗᏅᏗᏍᎩ. ᎤᏩᏌ ᎣᏤᎵ ᎤᏜᏅᏛ ᏌᏊᎭ ᎬᏗᏍᎩ ᏂᏚᏩᎿ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ ᎤᎾᎢ ᎾᏍᎩᎾ ᏄᏍᏛ ᎢᏯᏛᏁᏗᎢ Home ᏗᏴᏙᎳᏛᎢ, ᏗᏚᏓᎸᏙᏗ, ᏗᎬᏙᏗ, ᏕᎦᎧᎲᎢ, ᎠᎴ ᎤᏟ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="System usage for past 24 hr">
                <langSet xml:lang="en-US"><tig><term>System usage for past 24 hr</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏄᏍᏗᏓᏅᎢ ᎬᏙᏗᎢ ᎤᎬᏩᏟ ᎨᏎᎢ 24 hr</term></tig></langSet>
            </termEntry>
            <termEntry id="To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:.">
                <langSet xml:lang="en-US"><tig><term>To save battery, stop these apps from using battery in the background. Restricted apps may not work properly and notifications may be delayed.Apps:.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎭᎵᏏᏅᏓ ᎠᎾᎦᎵᏍᎩ, ᎭᎴᏫᏍᏓ ᎯᎠᏃ ᏗᎬᏙᏗ ᏅᏓᏳᏓᎴᏅᎯ ᎬᏗᎭ ᎠᎾᎦᎵᏍᎩ ᎠᏗᎾ ᎣᏂᏗᏣ ᏄᏍᏗᏓᏅ. ᎠᏓᎨᏗᏍᎩ ᏗᎬᏙᏗ ᏗᏙᎳᏤᎩ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏰᎵᏊ Ꮭ ᎠᎴ ᏗᏓᏃᏣᎳᏁᎯ ᎤᏬᎯᏛ.ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Set behavior when an emergency call is placed">
