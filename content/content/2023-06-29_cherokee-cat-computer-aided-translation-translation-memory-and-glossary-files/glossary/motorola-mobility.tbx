                <langSet xml:lang="chr"><tig><term>ᎤᏕᎵᏓ ᏗᎳᏏᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Be the first to know">
                <langSet xml:lang="en-US"><tig><term>Be the first to know</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᎬᏱᏱ ᎯᎦᏔᎮᏍᏗ</term></tig></langSet>
            </termEntry>
