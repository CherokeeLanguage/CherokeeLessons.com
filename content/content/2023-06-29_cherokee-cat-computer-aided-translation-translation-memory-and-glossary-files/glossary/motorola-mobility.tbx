            <termEntry id="network connection, internet, wireless, data, wifi, wi-fi, wi fi, cellular, mobile, cell carrier, 4g, 3g, 2g, lte">
                <langSet xml:lang="en-US"><tig><term>network connection, internet, wireless, data, wifi, wi-fi, wi fi, cellular, mobile, cell carrier, 4g, 3g, 2g, lte</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏧᎾᏚᏓᎵ ᎫᏓᎸᎢ, ᎠᏏᎳᏕᏫᏒᎢ, ᏂᏓᏏᎳᏛ, ᎦᏘᏍᎩᏌᏅᎯ, wifi, wi-fi, wi fi, ᏫᏚᏍᏗᎬᎢ, ᎠᏂᎩᏍᎩ, ᎧᏅᏑᎸ ᎠᏫᏗᏍᎩ, 4g, 3g, 2g, lte</term></tig></langSet>
