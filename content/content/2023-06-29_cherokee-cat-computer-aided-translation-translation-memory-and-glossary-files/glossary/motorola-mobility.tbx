            <termEntry id="Can\u2019t tether or use portable hotspots while Data Saver is on">
                <langSet xml:lang="en-US"><tig><term>Can\u2019t tether or use portable hotspots while Data Saver is on</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏗᎵᎪᏙᏗ ᏃᎴ ᎬᏔᏂᏓᏍᏗ ᎠᏴᏍᏙᏗᎢ ᎤᏗᏞᎩ ᎤᏓᏓᏢ ᎾᎯᏳᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎠᎵᏏᏅᏗᏍᎩ ᎨᎡᎢ ᎤᎿᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="This will reset all preferences for:Disabled appsDisabled app notificationsDefault applications for actionsBackground data restrictions for appsAny permission restrictionsYou will not lose any app data.">
                <langSet xml:lang="en-US"><tig><term>This will reset all preferences for:Disabled appsDisabled app notificationsDefault applications for actionsBackground data restrictions for appsAny permission restrictionsYou will not lose any app data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᎠ ᎠᏎ ᎢᎦᎧᎯᎲᏍᏗ ᏂᎦᏓ ᎤᏟᎠᏰᎸᏍᎬᎢ ᎤᎬᏩᏟ:ᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ ᏗᎬᏙᏗᏗᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎬᏙᏗ ᏗᏓᏃᏣᎳᏁᎯᎤᏓᏄᎸᏅᎩ ᏗᎬᏙᏗ ᎤᎬᏩᏟ ᎢᏯᏛᏁᏗᎣᏂ ᏗᏜ ᏄᏍᏗᏓᏅ ᎦᏘᏍᎩᏌᏅᎯ ᏚᏅᏍᏓᏕᎲ ᎤᎬᏩᏟ ᏗᎬᏙᏗᎾᏂᎥᏉ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏚᏅᏍᏓᏕᎲᏂᎯ ᎠᏎ ᎥᏝ ᏣᎫᎯ ᎾᏂᎥᏉ ᎬᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
