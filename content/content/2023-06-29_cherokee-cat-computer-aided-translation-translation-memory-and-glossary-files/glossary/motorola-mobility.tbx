            </termEntry>
            <termEntry id="Trust agents">
                <langSet xml:lang="en-US"><tig><term>Trust agents</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᎪᎯᏳᎯ ᏗᎦᏘᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="1 active trust agent">
                <langSet xml:lang="en-US"><tig><term>1 active trust agent</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>1 ᎬᏂᎦᎵᏍᏗ ᎨᎪᎯᏳᎯ ᏗᎦᏘᏯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Inactive / SIM">
                <langSet xml:lang="en-US"><tig><term>Inactive / SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᎸᏫᏍᏓᏁᎲᎾ / SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Active / Downloaded SIM">
                <langSet xml:lang="en-US"><tig><term>Active / Downloaded SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎵᏖᎸᎲᏍᎩ / ᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data.">
                <langSet xml:lang="en-US"><tig><term>The encryption operation is irreversible and if you interrupt it, you\u2019ll lose data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎠᏕᎵᏍᏙᏗ ᎠᎢᏒᎢ ᏄᏍᏛ ᎪᎯᏓ ᏗᎨᏛᏍᎩ ᎠᎴ ᎤᏓᏲᏍᏓᏁᎸᎩ ᎾᏍᎩ, ᏂᎯ\u2019ll ᏣᎫᎯ ᎦᏟᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="In the case your WiFi connection is of poor quality or your device is outside a WiFi network's coverage, your phone will make calls using an available mobile network.">
                <langSet xml:lang="en-US"><tig><term>In the case your WiFi connection is of poor quality or your device is outside a WiFi network's coverage, your phone will make calls using an available mobile network.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯᏣᏤᎵ WiFi ᏗᎫᏓᎸᏅᎯ ᏃᏌᏅᏱ ᎠᎴ ᏂᎯᏣᏤᎵ ᏣᏂᎬᏅᏗᏓᎾ ᏙᏯᏗᏜ WiFi ᏚᏏᎳᏛ ᎫᏝᎢ, ᏂᎯᏣᏤᎵ ᏗᏟᏃᎮᏗ ᏛᏛᏯᎾᎯ ᎥᏗᏍᎬ ᎠᏛᏅᎢᏍᏔᏅ ᎠᏂᎩᏍᎩ ᏧᎾᏚᏓᎵ.</term></tig></langSet>
            </termEntry>
            <termEntry id="NFC">
                <langSet xml:lang="en-US"><tig><term>NFC</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>NFC</term></tig></langSet>
            </termEntry>
            <termEntry id="Inactive / Downloaded SIM">
                <langSet xml:lang="en-US"><tig><term>Inactive / Downloaded SIM</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏚᎸᏫᏍᏓᏁᎲᎾ / ᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ SIM</term></tig></langSet>
            </termEntry>
            <termEntry id="Text will be displayed in another language.">
                <langSet xml:lang="en-US"><tig><term>Text will be displayed in another language.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏪᎳᏅᎢ ᎠᏎ ᎨᏒᎩ ᎠᏓᏴᎳᏔᏍᎩ ᎾᎿ ᏄᏓᎴ ᎦᏬᏂᎯᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Keep at least one preferred language">
                <langSet xml:lang="en-US"><tig><term>Keep at least one preferred language</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᎮᏍᏗ ᎤᎿᎢ ᎦᏲᎵ ᏌᏇ ᎤᏟ ᏱᏥᏰᎸᎾ ᏗᎦᏬᏂᎯᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="What to show">
                <langSet xml:lang="en-US"><tig><term>What to show</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏙ ᎾᎿᎢ ᎠᎪᏩᏛᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="When you allow data roaming, roaming charges may apply.">
                <langSet xml:lang="en-US"><tig><term>When you allow data roaming, roaming charges may apply.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏳᏃ ᏂᎯ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎦᏟᏌᏅᎯ ᎡᏙᎵᏙᎲ, ᎡᏙᎵᏙᎲ ᏓᎬᏩᎶᏗᏍᎬ ᏰᎵᏉ ᎲᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="The Accessibility button is set to . To use magnification, touch &amp; hold the Accessibility button, then select magnification.">
                <langSet xml:lang="en-US"><tig><term>The Accessibility button is set to . To use magnification, touch &amp; hold the Accessibility button, then select magnification.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎬᏴᏍᏗ ᎨᏒ ᎠᏐᏅᏍᏙᏗ ᏄᏍᏛ ᎤᎾᏓᏡᎬ ᎾᎿᎢ .ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏣᏔᏃᎯᏍᏔᏅᎢ, ᎭᏒᏂᎦ ᎠᎴ ᎯᎾᎯᏍᏓ ᏥᎩ ᎬᏴᏍᏗ ᎨᏒ ᎠᏐᏅᏍᏙᏗ, ᎾᏉᏃ ᎠᏑᏰᏍᏗ ᏣᏔᏃᎯᏍᏔᏅᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id=" starts on .">
                <langSet xml:lang="en-US"><tig><term> starts on .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term> ᎠᏂᎩᏍᏗ ᎤᎿᎢ .</term></tig></langSet>
            </termEntry>
            <termEntry id="SIM name &amp; color">
                <langSet xml:lang="en-US"><tig><term>SIM name &amp; color</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>SIM ᏚᏅᏙᎥ &amp; ᎠᏑᏫᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Apps with the Nearby devices permission can determine the relative position of connected devices.">
                <langSet xml:lang="en-US"><tig><term>Apps with the Nearby devices permission can determine the relative position of connected devices.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎬᏙᏗ ᎬᏗ ᏥᎩ ᎡᏍᎦᏂ ᏥᏂᏕᎬᏅᏗᏓᎾ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏰᎵᏯ ᏧᏬᎪᏙᏗ ᏥᎩ ᏚᏛᏓᏕᏫᏒ ᎦᎪᏗ ᎤᎿ ᎫᏓᎸᏅᎯ ᏥᏂᏕᎬᏅᏗᏓᎾ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Device not encrypted">
                <langSet xml:lang="en-US"><tig><term>Device not encrypted</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᏂᎬᏅᏗᏓᎾ ᎥᏝ ᎠᏕᎵᏍᏔᏅ</term></tig></langSet>
            </termEntry>
            <termEntry id="You\u2019ve added the maximum number of faces">
                <langSet xml:lang="en-US"><tig><term>You\u2019ve added the maximum number of faces</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎤᎭ ᎧᏁᏉᏓ ᏥᎩ ᎦᎸᎳᏗᎨ ᎠᏎᏍᏗ ᎤᎿ ᏚᎾᎧᏛ</term></tig></langSet>
            </termEntry>
            <termEntry id="To disable this SIM, remove the SIM card">
                <langSet xml:lang="en-US"><tig><term>To disable this SIM, remove the SIM card</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᎿᎢ ᎦᎬᏙᏗ ᏂᎨᏒᎾ ᎯᎠ SIM, ᎠᎲᏍᏗ ᏥᎩ SIM ᏆᎾᏲᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Only one downloaded SIM can be active at a time.">
                <langSet xml:lang="en-US"><tig><term>Only one downloaded SIM can be active at a time.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏅᏒ ᏌᏇ ᎡᎳᏗᎬᏘ ᏫᎦᏢᏅᎯ SIM ᏰᎵᏯ ᎨᎡᎩ ᎬᏂᎦᎵᏍᏗ ᎤᎿᎢ Ꭰ ᎠᏟᎢᎵᏒ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Switch to ?">
                <langSet xml:lang="en-US"><tig><term>Switch to ?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎾᎾᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="After deletion, you will need your PIN, pattern, or password to unlock your phone or for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>After deletion, you will need your PIN, pattern, or password to unlock your phone or for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᎫᏗᏗᏒ ᏱᎬᏅᏕᏍᏗ, ᎤᏚᎸᏓ ᎨᏎᏍᏗ ᏣᏩᎵ PIN, ᎤᎾᎶᎢᏓ, ᎠᎴ ᎠᏍᏚᎢᏍᏙᏗ ᎥᎧᏁᎬᎢ ᎠᏂᏐᎭᎾᎳᎩ ᏣᏤᎵ ᏗᏟᏃᎮᏗᎢ ᎠᎴ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎤᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="A PIN protects your phone if it\u2019s lost or stolen.This deletes the fingerprint model stored on your device. Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face or fingerprint for authentication in apps.">
                <langSet xml:lang="en-US"><tig><term>A PIN protects your phone if it\u2019s lost or stolen.This deletes the fingerprint model stored on your device. Your face model will also be permanently and securely deleted. You won\u2019t be able to use your face or fingerprint for authentication in apps.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>D PIN ᎠᏓᎦᏎᏍᏙᏗ Ꮒ ᏗᏟᏃᎮᏗ ᎢᏳᏃ ᎾᏍᎩ ᎤᏂᏲᎱᏎᎸ ᏃᎴ ᎦᏃᏍᎩᏓᎯᎠ ᎠᏍᎪᎸᏛᎯ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎤᎿᎢ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ. ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᎪᎱᏍᏗ ᎪᏢᏅ ᎨᏎᏍᏗ ᎬᏩᎦᏘ ᏃᎴ ᏄᎾᏰᎯᏍᏛᎾ ᎠᏍᎪᎸᏛᎯ. ᏂᎯ ᎨᏍᏗ ᏰᎵ ᎨᏒᎩ ᏰᎵᏉ ᎢᏯᏛᏁᏗ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᎧᏁᏉᏍᏗᏍᎬ ᏃᎴ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎤᎬᏩᏟ ᎠᏓᏙᏟᏍᏙᏗ ᎾᎿ ᏗᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Medium ( second)">
                <langSet xml:lang="en-US"><tig><term>Medium ( second)</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᎵᏊ ᎢᏴ ( ᏔᎵᏁᏃ)</term></tig></langSet>
            </termEntry>
            <termEntry id="This printer provided a new security certificate, or another device is impersonating it.">
