                <langSet xml:lang="en-US"><tig><term>EAP method</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>EAP ᎢᎬᏁᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Online Certificate Status">
                <langSet xml:lang="en-US"><tig><term>Online Certificate Status</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᏏᎳᏕᏫᏒ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏄᏛᎿᏕᎬ</term></tig></langSet>
            </termEntry>
            <termEntry id="Domain">
                <langSet xml:lang="en-US"><tig><term>Domain</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency Alert - Simulation Message">
                <langSet xml:lang="en-US"><tig><term>Emergency Alert - Simulation Message</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎢᎦᎵᏍᏗᏍᎩ ᎤᏟᏍᏗ ᎠᏓᏃᏎᎯ -ᎠᎵᏏᎾᎯᏍᏗᏍᎩ ᎠᎪᎵᏰᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Attachment size warning">
                <langSet xml:lang="en-US"><tig><term>Attachment size warning</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏛᎢ ᎪᏪᎵ ᎢᎩᏓ ᎠᏓᏕᏯᏔᎲᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Let apps use Google\u2019s location service to estimate your location faster. Anonymous location data will be collected and sent to Google.">
