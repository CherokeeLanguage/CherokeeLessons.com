            </termEntry>
            <termEntry id="Not registered">
                <langSet xml:lang="en-US"><tig><term>Not registered</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᎠᎪᏪᎳᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Couldn\u2019t complete sign-up. Tap to try again.">
                <langSet xml:lang="en-US"><tig><term>Couldn\u2019t complete sign-up. Tap to try again.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏯᏍᏆᏓ ᎠᏘᎳᏗᏍᏗᎢ. ᎭᏐᎥᏍᏓ ᎾᎢ ᏏᏊ ᏥᎭᏁᎵᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Data two bars.">
                <langSet xml:lang="en-US"><tig><term>Data two bars.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏘᏍᎩᏌᏅᎯ ᏔᎵ ᏕᎦᎾᎸ.</term></tig></langSet>
            </termEntry>
            <termEntry id="There is no shared data for this user.">
                <langSet xml:lang="en-US"><tig><term>There is no shared data for this user.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏓᎲᎢ ᎭᏗ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩᎾ ᎯᎠ ᎬᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Include additional device-specific vendor logs in bug reports, which may contain private information, use more battery, and/or use more storage.">
                <langSet xml:lang="en-US"><tig><term>Include additional device-specific vendor logs in bug reports, which may contain private information, use more battery, and/or use more storage.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏠᏯᏍᏗ ᏗᎦᏟᏌᏅᎯ ᏥᏂᎬᏅᏗᏓᎾ-ᏗᏙᎳᎩ ᎦᎾᏕᎩ ᎸᏛᏁᎵᏙᎸ ᏗᎧᏃᎮᏍᎩ ᎾᎿᎢ ᏍᎪᏯ ᎬᏂᎨᏒ ᎢᏗᎬᏁᎸ, ᏱᏅᎦᎵᏍᏙᏓ ᎦᎸᏛᎢ ᎤᏕᎵᏓ ᎧᏃᎸᎥᏍᎩ, ᎬᏙᏓ ᎤᏥ ᎢᎦᎢ ᎠᎾᎦᎵᏍᎩ, ᏃᎴ/ᎠᎴᏃ ᎬᏙᏓ ᎤᏥ ᎢᎦᎢ ᎠᏍᏆᏂᎪᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Display App Not Responding dialog for background apps">
                <langSet xml:lang="en-US"><tig><term>Display App Not Responding dialog for background apps</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎬᏂᎨᏒ ᏱᎬᏁᏗ ᎬᏙᏗ ᎭᏗ ᏱᎦᏬᎯᎵᏴᏍᏗᎢ ᏗᏟᏃᎮᏗ ᎾᏍᎩᎾ ᎣᎾᏗᏢ ᏄᏍᏗᏓᏅ ᏗᎬᏙᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Disable automatic routing to USB audio peripherals">
                <langSet xml:lang="en-US"><tig><term>Disable automatic routing to USB audio peripherals</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎴᏫᏍᏙᏓ ᎤᏩᏌ ᏱᎬᏁᎯ ᏓᏅᎪᏗᏍᎬ ᎿᏛᏁᎲᎢ ᎾᎢ USB ᎤᏃᏴᎬ ᏙᏯᏗᏨ ᏂᏚᏍᏛᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Debug GPU overdraw">
                <langSet xml:lang="en-US"><tig><term>Debug GPU overdraw</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎷᏩᏘᏍᎩ GPU ᎤᎶᏒᏍᏔᏅ ᎧᏃᎮᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Convert data partition to file based encryption. !!Warning!! This will erase all your data. This feature is alpha, and may not work correctly. Press 'Wipe and convert\u2026' to continue.">
                <langSet xml:lang="en-US"><tig><term>Convert data partition to file based encryption. !!Warning!! This will erase all your data. This feature is alpha, and may not work correctly. Press 'Wipe and convert\u2026' to continue.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏁᏟᏴᏍᏗ ᎦᏘᏍᎩᏌᏅᎯ ᏓᏓᎴᏛᎢ ᎾᎢ ᎠᏍᏆᏂᎪᏙᏗ ᏓᎳᏏᏔᏅᎩ ᎠᏕᎵᏍᏙᏗ. !!ᎠᏓᏓᏰᏙᏗᏍᎩ!! ᎯᎠ ᎠᏎ ᎠᏍᎪᎸᏗᏍᏗ ᏂᎦᏓ ᏣᏤᎵ ᎦᏘᏍᎩᏌᏅᎯ. ᎯᎠ ᎠᎦᏎᏍᏙᏗ ᎾᏍᎩ ᎡᎵᏃ, ᏃᎴ ᏰᎵᏉ ᎭᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᏚᏳᎪᏛᏊ. ᎭᏐᎥᏍᏓ 'ᎦᏅᎦᎸᏗ ᏃᎴ ᎦᏁᏟᏴᏍᏗ\u2026' ᎾᎢ ᏂᎬᏯᎢᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Install voice data">
                <langSet xml:lang="en-US"><tig><term>Install voice data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏘᏅᏛᎦ ᎧᏁᏨᎯ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Delete shared data">
                <langSet xml:lang="en-US"><tig><term>Delete shared data</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏗᏍᏗ ᎠᏯᏙᎯᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ</term></tig></langSet>
            </termEntry>
            <termEntry id="Wireless debugging is intended for development purposes only. Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.">
                <langSet xml:lang="en-US"><tig><term>Wireless debugging is intended for development purposes only. Use it to copy data between your computer and your device, install apps on your device without notification, and read log data.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏏᎳᏛᎾ ᎪᎷᏩᏘᏍᎬ ᎾᏍᎩ ᏄᏪᎵᏒ ᎾᏍᎩᎾ ᎤᏙᎷᏩᏛᏗ ᏂᏚᏰᎵᏛᎢ ᎤᏩᏌ. ᎬᏙᏓ ᎾᏍᎩ ᎾᎢ ᏗᏟᎶᏍᏔᏅ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏰᏟ ᏣᏤᎵ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᏃᎴ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ, ᎯᏘᏅᏛᎦ ᏗᎬᏙᏗ ᎤᎾᎢ ᏣᏤᏨ ᏥᏂᎬᏅᏗᏓᎾ ᏄᏠᏯᏍᏛᎾ ᎠᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎠᎪᎵᏰᏗ ᎸᏛᏁᎸ ᎧᏃᎮᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't connect to ''">
                <langSet xml:lang="en-US"><tig><term>Can't connect to ''</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᏱᎨᎫᏓᎸᎥᎦ ᎾᎾᎢ ''</term></tig></langSet>
            </termEntry>
            <termEntry id="Won't automatically connect">
