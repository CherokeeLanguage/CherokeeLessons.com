            <termEntry id="Built-in SIM cards">
                <langSet xml:lang="en-US"><tig><term>Built-in SIM cards</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>BᎤᎢlt-Ꭲn SIM cᎠrdᏍ</term></tig></langSet>
            </termEntry>
            <termEntry id="Emergency calling only">
                <langSet xml:lang="en-US"><tig><term>Emergency calling only</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᎨᏛ ᏯᎵᏱᎵᏙᎭ ᏓᏯᏂ ᎤᏅᏒ</term></tig></langSet>
