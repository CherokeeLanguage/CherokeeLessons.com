                <langSet xml:lang="chr"><tig><term>ᎠᎵᏍᎪᎸᏗᏍᎬ  ᎾᎿᎢ ᎤᎭ ᏧᎧᎵᏨᎯ ᏗᎫᎪᏔᏂᏓᏍᏗ ᎾᎿ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap to connect anyway">
                <langSet xml:lang="en-US"><tig><term>Tap to connect anyway</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎭᏐᏅᏍᏓ ᎾᎿᎢ ᎫᏓᎸᎢ ᏱᏂᎦᎵᏍᏗᏉ</term></tig></langSet>
            </termEntry>
            <termEntry id="Enter PUK code to continue.">
