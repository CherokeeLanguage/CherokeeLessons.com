            </termEntry>
            <termEntry id="You're not connected to a data service.To view this information now, go to https://t-mo.co/2CqebHM from any computer connected to the Internet.">
                <langSet xml:lang="en-US"><tig><term>You're not connected to a data service.To view this information now, go to https://t-mo.co/2CqebHM from any computer connected to the Internet.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᏨᎤᎢ ᎥᏝ ᎫᏓᎸᏅᎯ ᎾᎿᎢ ᎦᏘᏍᎩᏌᏅᎯ ᎢᏯᏓᏛᏁᏗ.ᎾᎿᎢ ᏗᎧᏃᏗ ᎯᎠ ᎧᏃᎮᏢᏗ Ꭷ, ᏤᏅᏍᏗ https://t-mo.co/2CqebHM ᏂᏙᏓᏳᏓᎴᏅᎯ ᎾᏂᎥᏉ ᎠᎦᏙᎥᎯᏍᏗ ᎠᏍᏆᏂᎪᏗᏍᎩ ᎫᏓᎸᏅᎯ ᎾᎿᎢ ᎠᏏᎳᏕᏫᏒᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You've reached your specified data usage limit, so mobile data has been turned off. If you turn mobile data back on, you may be charged for data usage by your carrier.">
                <langSet xml:lang="en-US"><tig><term>You've reached your specified data usage limit, so mobile data has been turned off. If you turn mobile data back on, you may be charged for data usage by your carrier.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯᏃ ᏫᏣᎷᏨ ᏣᏤᎵ ᎠᎪᎥᎯ ᎦᏘᏍᎩᏌᏅᎯ ᎲᏗᏍᎬ ᎠᏎᎸᎯ, ᎾᏍᎩᏃ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎦᏳᎳ ᎤᏂᏍᏚᏅᎢ. IfᎢᏳᏃ ᏂᎯ ᎾᏍᎩ ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᏱᎵᏍᏚᎢᏌ, ᏂᎯ ᏰᎵᏉ ᏰᏣᏂᏢᎦ ᎾᏍᎩᎾ ᎦᏘᏍᎩᏌᏅᎯ ᎲᏗᏍᎬᎢ ᎾᏍᎩ ᏣᏤᎵ ᎠᎯᏙᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Mobile data is now off.">
                <langSet xml:lang="en-US"><tig><term>Mobile data is now off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᎩ ᎦᏘᏍᎩᏌᏅᎯ ᎾᏍᎩ ᏃᏊ ᎠᏍᏚᎭ.</term></tig></langSet>
            </termEntry>
            <termEntry id="You have new voicemails. Visual Voicemail is not supported on this device. Tap to call the voicemail center.">
                <langSet xml:lang="en-US"><tig><term>You have new voicemails. Visual Voicemail is not supported on this device. Tap to call the voicemail center.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏕᏣᎭ ᎢᏤ ᎧᏁᎬ Ꮎ ᎠᎪᏩᏛᏗ ᎧᏁᎬ ᎭᏗ ᏱᎫᎫᏍᏓ ᎯᎠᎾ ᏥᏂᎬᏅᏗᏓᎾ ᎯᏐᏍᏓ ᏪᏴᎾ Ꮎ ᎧᏁᎬ ᎠᏰᏟ</term></tig></langSet>
            </termEntry>
            <termEntry id="Allows the application to determine when Attentive Display is using the camera.">
                <langSet xml:lang="en-US"><tig><term>Allows the application to determine when Attentive Display is using the camera.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏥᎩ ᎬᏙᏗ ᎾᎿᎢ ᏧᏬᎪᏙᏗ ᎢᏳᏃ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎨᎡᎢ ᎬᏗᎭ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Read Attentive Display camera state">
                <langSet xml:lang="en-US"><tig><term>Read Attentive Display camera state</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᎵᏰᏗ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎧᏃᎮᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Can't demo Attentive Display as the camera is not available.">
                <langSet xml:lang="en-US"><tig><term>Can't demo Attentive Display as the camera is not available.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎨᏍᏗ ᏰᎵ ᎢᏯᏛᏁᏗ ᎠᏓᏎᎮᎯ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎤᎿᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎨᎡᎢ ᎥᏝ ᎠᏛᏅᎢᏍᏔᏅ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Note: It may be hard to see you in certain lighting conditions">
                <langSet xml:lang="en-US"><tig><term>Note: It may be hard to see you in certain lighting conditions</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏅᏓᏗᏍᏙᏗ ᎪᏪᎵ: ᎨᎡᎢ ᏰᎵᏯ ᎨᎡᎢ ᎠᏍᏓᏱ ᎾᎿᎢ ᎠᎪᏩᏛᏗ ᏂᎯ ᎾᎿ ᏑᏓᎴᎩ ᎠᏨᏍᏛᏍᎬ ᏂᏚᎾᎵᏍᏓᏁᎲᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="An image will appear in the circle below when Attentive Display sees you. The image will disappear when you look away from screen.">
                <langSet xml:lang="en-US"><tig><term>An image will appear in the circle below when Attentive Display sees you. The image will disappear when you look away from screen.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭰ ᎠᏅᏓᏗᏍᏙ ᎠᏎ ᎬᏂᎨᏒᎢ ᎾᎿ ᏥᎩ ᎦᏐᏆᎸᎢ ᎡᎳᏗᏨ ᎢᏳᏃ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎠᎪᏩᏘ ᏂᎯ. ᏥᎩ ᎠᎪᏩᏘ ᎠᏎ ᎠᏗᏍᎦᎶᏗ ᎢᏳᏃ ᏂᎯ ᏩᎦᏔ ᎤᏤᎵᏛ ᏅᏓᏳᏓᎴᏅᎯ ᎠᏓᏎᎮᎸᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Now the screen won't dim or sleep as long as you're looking at it">
                <langSet xml:lang="en-US"><tig><term>Now the screen won't dim or sleep as long as you're looking at it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏥᎩ ᎠᏓᏎᎮᎸᎢ ᎨᏍᏗ ᏰᎵ ᎯᏍᎪᎸᏓ ᏃᎴ ᎦᏟᏔᏗᏍᎩ ᎤᎿᎢ ᎢᎪᎯᏓ ᎤᎿᎢ ᏂᎯ ᎨᎡᎩ ᎠᎦᏙᏍᏛ ᎤᎿᎢ ᎨᎡᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you can open the camera quickly and never miss a moment you want to capture">
                <langSet xml:lang="en-US"><tig><term>Now you can open the camera quickly and never miss a moment you want to capture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᏰᎵᏯ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎤᎵᏍᏓᏊ ᏃᎴ ᎢᎸᎯᏳᎢ ᎦᏅᏗᏍᏗ Ꭰ ᏞᎦ ᏂᎯ ᎤᏚᎵᎭ ᎾᎿᎢ ᎦᏂᏴᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Open the camera anytime">
                <langSet xml:lang="en-US"><tig><term>Open the camera anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="The light pattern below will appear when you receive a call or alarm alert.">
                <langSet xml:lang="en-US"><tig><term>The light pattern below will appear when you receive a call or alarm alert.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏥᎩ ᎢᎦᎦᏘ ᎤᎾᎶᎢᏓ ᎡᎳᏗᏨ ᎠᏎ ᎬᏂᎨᏒᎢ ᎢᏳᏃ ᏂᎯ ᎦᏁᏍᏗ Ꭰ ᏪᏯᎾ ᏃᎴ ᎠᏓᏕᏯᏙᏗᏍᎩ ᎠᏓᏕᏯᏔᎲᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="End time">
                <langSet xml:lang="en-US"><tig><term>End time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏥᎢᎵᏒ ᎠᎵᏍᏆᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quick capture camera">
                <langSet xml:lang="en-US"><tig><term>Quick capture camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏣᏄᎳ ᏔᏥᎶᏍᏓ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Send broadcast about FDN">
                <langSet xml:lang="en-US"><tig><term>Send broadcast about FDN</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏫᏅᎥᎦ ᎠᏗᎦᎴᏯᏍᏗ ᎢᎸᏨ FDN</term></tig></langSet>
            </termEntry>
            <termEntry id="Now you’re ready to quickly turn the flashlight on and off anytime">
                <langSet xml:lang="en-US"><tig><term>Now you’re ready to quickly turn the flashlight on and off anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ ᏂᎯ ᎨᎡᎩ ᎠᏛᏅᎢᏍᏔᏅᎢ ᎾᎿᎢ ᎤᎵᏍᏓᏊ ᎠᎦᏔᎲᏍᏗ ᏥᎩ ᎠᏨᏍᏗ ᎤᎿᎢ ᏃᎴ ᎠᏍᏚᏗ ᏱᏂᎦᎵᏍᏗᎭᏊ ᎢᏴᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Select new photo">
                <langSet xml:lang="en-US"><tig><term>Select new photo</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏤ ᏗᏓᏥᎶᏍᏔᏅᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Now, quickly chop twice to turn the flashlight off">
                <langSet xml:lang="en-US"><tig><term>Now, quickly chop twice to turn the flashlight off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Ꭷ, ᎤᎵᏍᏓᏊ ᎦᎷᏱᏓᏍᏗ ᏔᎵ ᎢᏳᏩᎫᏗ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᏥᎩ ᎠᏨᏍᏗ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Screen cannot shrink in this mode">
                <langSet xml:lang="en-US"><tig><term>Screen cannot shrink in this mode</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏰᏙᎳᏛᎢ ᏝᏍᏗ ᎯᏍᏗᎪᎯᏍᏓ ᎾᎿ ᎯᎠ ᎪᏒᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="GOT IT">
                <langSet xml:lang="en-US"><tig><term>GOT IT</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Run time: ">
                <langSet xml:lang="en-US"><tig><term>Run time: </term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᎾᏫᏍᏗ ᎠᏥᎢᎵᏒ: </term></tig></langSet>
            </termEntry>
            <termEntry id="You won't be notified for new voicemails. If you're on Wi\u2011Fi, you can check for voicemail by syncing now.">
                <langSet xml:lang="en-US"><tig><term>You won't be notified for new voicemails. If you're on Wi\u2011Fi, you can check for voicemail by syncing now.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎯ ᎨᏍᏗ ᏰᎵ be ᎠᏓᏃᎯᏎᏗ ᎤᎬᏩᏟ ᏗᏤ ᎧᏁᎬ. ᎤᎿᎢ ᏂᎯ ᎨᎡᎩ ᎤᎿᎢ Wi\u2011Fi, ᏂᎯ ᏰᎴᏯ ᎪᏪᎶᏗ ᎤᎬᏩᏟ ᎧᏁᎬ ᎬᏗ ᎢᏧᎳᎭ ᏥᏂᎦᎵᏍᏗᏍᎬᎢ Ꭷ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap below">
                <langSet xml:lang="en-US"><tig><term>Tap below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe right below">
                <langSet xml:lang="en-US"><tig><term>Swipe right below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎠᎦᏘᏏ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera anytime. This feature works with flip open and closed.">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera anytime. This feature works with flip open and closed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᎸᎯᏳ. ᎯᎠ ᎤᏩᎬᏗᏗᏒ ᏚᎸᏫᏍᏓᏁᎲ ᎬᏗ ᏓᏁᏍᏆᏕᎦ ᎯᏍᏚᎢ ᏃᎴ ᎠᏍᏚᏅᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlocking history">
                <langSet xml:lang="en-US"><tig><term>Unlocking history</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᏂᏧᎵᏍᏔᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Edge lights appear for alerts, notifications, and more. You can customize edge lights in settings.">
                <langSet xml:lang="en-US"><tig><term>Edge lights appear for alerts, notifications, and more. You can customize edge lights in settings.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᏛᎢ ᏗᏨᏍᏗ ᎬᏂᎨᏒᎢ ᎤᎬᏩᏟ ᏗᏓᏕᏯᏔᎲᏍᎩ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎤᏥ ᎢᎦᎢ. ᏂᎯ ᏰᎵᏯ ᎠᏤᎲᏍᏙᏗ ᎤᏥ ᎢᎦᎢ ᎾᎿ ᏕᎦᎧᎲᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Three finger screenshot won't work when you're using the apps below">
                <langSet xml:lang="en-US"><tig><term>Three finger screenshot won't work when you're using the apps below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏦᎢ ᏕᎦᏰᏌᏛ ᎬᏗ ᎠᏓᏴᎳᏔᏍᎩ ᏗᏥᎶᏍᏓ ᎨᏍᏗ ᏰᎵ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎬᏗᎭ ᏥᎩ ᎬᏙᏗ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera anytime">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᎸᎯᏳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Over time, your device will learn your typical charging pattern. It may take several days for your device to provide optimized charging.">
                <langSet xml:lang="en-US"><tig><term>Over time, your device will learn your typical charging pattern. It may take several days for your device to provide optimized charging.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎢᏴᏛ ᎠᏥᎢᎵᏒ, ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎠᏎ ᎠᏕᎶᏆᏍᏗ ᏂᏨᎤᎢ ᎤᏠᏱᏊ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎤᎾᎶᎢᏓ. ᎾᎿ ᏰᎵᏯ ᎠᎩᏍᏗ ᎢᎸᏍᎩ ᏧᏒᎯᏓ ᎤᎬᏩᏟ ᏂᏨᎤᎢ ᏥᏂᎬᏅᏗᏓᎾ ᎾᎿᎢ ᎠᏓᏁᎳᏁᏗ ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Notifications to grant access to sensors and camera">
                <langSet xml:lang="en-US"><tig><term>Notifications to grant access to sensors and camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᎾᏓᏃᏣᎳᏁᎯ Ꭷ ᎭᎵᏍᎪᎸᏓ ᎠᏴᏍᏗ ᎾᎿᎢ ᎠᏩᏘᏍᎩ ᏃᎴ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Navigate faster, and get more screen space. Instead of on screen buttons, use the fingerprint sensor to navigate.">
                <langSet xml:lang="en-US"><tig><term>Navigate faster, and get more screen space. Instead of on screen buttons, use the fingerprint sensor to navigate.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᎩᏍᏗ ᎦᏣᏄᎳᎯᎨ, ᏃᎴ ᎠᎩᏍᏗ ᎤᏥ ᎢᎦᎢ ᎠᏴᏙᎳᏛᎢ ᎤᏜᏅᏛ. ᎤᎬᏫᏳᏎᏍᏗ ᎾᎿ ᎤᎿᎢ ᎠᏰᏙᎳᏛᎢ ᏗᏐᎥᏍᏙᏗ, ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎦᏰᏌᏛᎢᏅᏙᏪᎸᎢ ᎠᏩᏘᏍᎩ ᎾᎿᎢ ᎠᏂᎩᏍᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the sensor below the screen to continue">
                <langSet xml:lang="en-US"><tig><term>Touch the sensor below the screen to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᎠᏩᏘᏍᎩ ᎡᎳᏗᏨ ᎠᏴᏙᎳᏛᎢ ᎾᎿᎢ ᏂᎦᏯᎢᏎᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera, even when the flip is closed">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera, even when the flip is closed</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎠᏍᏚᎢᏓ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ, ᎥᏍᏊ ᎢᏳᏃ ᏥᎩ ᏓᏁᏍᏆᏕᎦ is ᎠᏍᏚᏅᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Clear unlocking history">
                <langSet xml:lang="en-US"><tig><term>Clear unlocking history</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎪᎸᏛᎯ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᏂᏧᎵᏍᏔᏅᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Unlocking failed.">
                <langSet xml:lang="en-US"><tig><term>Unlocking failed.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᎠᏓᏄᎸᎲᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Got it">
                <langSet xml:lang="en-US"><tig><term>Got it</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᎵᎦ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe to split helps you quickly enter split screen mode. This permission commands the system to enter split screen mode when you slide your finger back and forth on the screen. When this service is turned off, Swipe to split will also turn off.">
                <langSet xml:lang="en-US"><tig><term>Swipe to split helps you quickly enter split screen mode. This permission commands the system to enter split screen mode when you slide your finger back and forth on the screen. When this service is turned off, Swipe to split will also turn off.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏍᏡᏍᏗ ᎠᎵᏍᏕᎵᏍᎪᎢ ᏂᎯ ᎤᎵᏍᏓᏊ ᎠᏴᏍᏗ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ. ᎯᎠ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᏚᏁᏤᎸᎩ ᏥᎩ ᏄᏍᏗᏓᏅᎢ ᎾᎿᎢ ᎠᏴᏍᏗ ᎠᏍᏡᏍᏗ ᎠᏰᏙᎳᏛᎢ ᎬᏙᏗ ᎢᏳᏃ ᏂᎯ ᎠᏲᏢᏗᎭ ᏂᏨᎤᎢ ᎦᏰᏌᏛ ᎠᏨᏍᏗ ᏃᎴ ᎦᏌᏙᏯᏍᏗ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ. ᎢᏳᏃ ᎯᎠ ᎤᎾᏓᏍᏕᎸᏗ ᎨᎡᎢ ᎠᏍᏚᏅᎢ, ᎦᎶᎯᏍᏗᏍᎩ ᎾᎿᎢ ᎠᏍᏡᏍᏗ ᎠᏎ ᎾᏍᏊ ᎠᏍᏚᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe up below">
                <langSet xml:lang="en-US"><tig><term>Swipe up below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏅᎦᎵᏓ ᎦᎸᎳᏗᏢ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do not vibrate on tap and swipe">
                <langSet xml:lang="en-US"><tig><term>Do not vibrate on tap and swipe</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏝᏍᏗ ᎠᎵᏖᎸᏗ ᎾᎿ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᏃᎴ ᎦᎶᎯᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Learn more">
                <langSet xml:lang="en-US"><tig><term>Learn more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏥ ᎢᎦᎢ</term></tig></langSet>
            </termEntry>
            <termEntry id="Internal storage is running out, the process has been stopped.">
                <langSet xml:lang="en-US"><tig><term>Internal storage is running out, the process has been stopped.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏫᏂ ᎠᏍᏆᏂᎪᏙᏗ ᏕᏣᎵᏒᏁᎭ, ᎠᏂᎯᎵᏒ ᏂᎦᎵᏍᏓ ᎠᎴᏫᏍᏓ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Try it out below">
                <langSet xml:lang="en-US"><tig><term>Try it out below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏁᎸᏙᏗ ᎨᎡᎢ ᎦᏅᎪᏫᏛ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Overcharging your battery causes strain that can shorten its lifespan. Optimized charging helps your battery stay healthy by reducing the amount of time spent charging over .Your battery will be fully charged at .">
                <langSet xml:lang="en-US"><tig><term>Overcharging your battery causes strain that can shorten its lifespan. Optimized charging helps your battery stay healthy by reducing the amount of time spent charging over .Your battery will be fully charged at .</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎸᎳᏗᏢ ᏗᎬᏩᎶᏙᏗ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᏂᏗᎬᏂᏏᏍᎩ ᎦᏅᏐᎸᏍᏙᏗ ᎥᏍᎩᎾ ᏰᎵᏯ ᏗᏍᏆᎶᏗ ᎨᏎᏍᏗ ᎨᎡᎢ ᎠᎴᏂᏙᎲᎢ ᏫᎬᏍᏗ. ᏩᎧᎵᏏᏌᏅ ᏓᎬᏩᎶᏗᏍᎬᎢ ᏓᎵᏍᏕᎵᏍᎪ ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᎡᏙᎮᏍᏗ ᏙᎯ ᎬᏗ ᎠᎦᏲᎳᎨᏍᏗ ᏥᎩ ᎢᎦᎢ ᎤᎿ ᎠᏥᎢᎵᏒ ᎤᏂᏩᏒᎢ ᏓᎬᏩᎶᏗᏍᎬᎢ ᎢᏴᏛ .ᏂᏨᎤᎢ ᎠᎾᎦᎵᏍᎩ ᎠᏎ ᎨᎡᎢ ᎠᏂᎧᎵ ᎠᎫᏍᏗ ᎤᎿᎢ </term></tig></langSet>
            </termEntry>
            <termEntry id="Choose which camera to open with the twist gesture">
                <langSet xml:lang="en-US"><tig><term>Choose which camera to open with the twist gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎠᏓᏄᏖᏲᎭ ᎤᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Block notifications for calls and messages by turning your phone face down. You’ll still hear alarms in Do Not Disturb mode.">
                <langSet xml:lang="en-US"><tig><term>Block notifications for calls and messages by turning your phone face down. You’ll still hear alarms in Do Not Disturb mode.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᏐᎭᎾᎳ ᏗᎾᏓᏃᏣᎳᏁᎯ ᎤᎬᏩᏟ ᏓᏯᏂ ᏃᎴ ᏗᎪᎵᏰᏗ ᎠᎦᏔᎲᏍᎬ ᏂᏨᎤᎢ ᏗᏟᏃᎮᏗ ᎡᎳᏗ ᏭᎧᏔ. ᏂᎯ ᎠᏎ ᏙᎢ ᎢᏣᏛᎬᎦ ᏗᏓᏕᏯᏙᏗᏍᎩ ᎾᎿ ᏤᏍᏗ ᎠᏓᏕᏯᏙᏗ ᎬᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Open camera">
                <langSet xml:lang="en-US"><tig><term>Open camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏍᏚᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the sensor quickly">
                <langSet xml:lang="en-US"><tig><term>Tap on the sensor quickly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᎠᏩᏘᏍᎩ ᎤᎵᏍᏓᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Not now">
                <langSet xml:lang="en-US"><tig><term>Not now</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎭᏗ ᏆᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose which camera to open with the twist gesture">
                <langSet xml:lang="en-US"><tig><term>Choose which camera to open with the twist gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎠᏓᏄᏖᏲᎭ ᎤᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Swipe left below">
                <langSet xml:lang="en-US"><tig><term>Swipe left below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏍᎦᏂᏗᏟ ᎯᏅᎦᎵᏓ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Quickly see 2 apps at once">
                <langSet xml:lang="en-US"><tig><term>Quickly see 2 apps at once</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎵᏍᏓᏊ ᎠᎪᏩᏛᏗ 2 ᏗᎬᏙᏗ ᎤᎿᎢ ᏌᏊᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="Moto Actions needs permission to access some things on your device. Select &quot;Permissions&quot; in AppInfo to re-enable.">
                <langSet xml:lang="en-US"><tig><term>Moto Actions needs permission to access some things on your device. Select "Permissions" in AppInfo to re-enable.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>Moto ᎾᎾᏛᏁᎲᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏚᏚᎸᏛᎢ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎠᏴᏍᏗ ᎢᎦᏓ ᏧᏓᎴᏅᏛ ᎤᎾᎢ ᏣᏤᎵ ᏥᏂᎬᏅᏗᏓᎾ. ᎠᏑᏰᏍᏗ "ᏗᏓᎵᏍᎪᎸᏓᏁᏗ" ᎾᎿᎢ ᎬᎡᏗ ᎣᏃᎮᏍᎩ ᏏᏊ ᎡᎵᏊ ᎢᏳᎵᏍᏙᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Touch the One Button Navigation below to continue">
                <langSet xml:lang="en-US"><tig><term>Touch the One Button Navigation below to continue</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏒᏂᏍᏗ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎡᎳᏗᏨ ᎾᎿᎢ ᎠᎯᎸᏍᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Hold below">
                <langSet xml:lang="en-US"><tig><term>Hold below</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏂᏯ ᎡᎳᏗᏨ</term></tig></langSet>
            </termEntry>
            <termEntry id="Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions. Use the toggles to turn gestures on &amp; off, and tap on the descriptions for tutorials and more information.">
                <langSet xml:lang="en-US"><tig><term>Easy gestures and touch interactions help you perform everyday tasks with quick and intuitive motions. Use the toggles to turn gestures on &amp; off, and tap on the descriptions for tutorials and more information.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎯᏗᎨᎢ ᏧᏬᏯᏂᏍᎩ ᏃᎴ ᎠᏒᏂᏍᏗ ᏂᏓᏓᎳᏗᏍᎬ ᎠᎵᏍᏕᎸᏓ ᏂᎯ ᎠᎵᏂᎬᏁᏗ ᏂᏚᎩᏨᏂᏒ ᎢᎦ ᎢᏗᏛᏁᏗ ᎬᏗ ᎤᏟᏍᏓ ᏃᎴ ᎭᏕᎳᎰᏍᎬᎢ ᏗᏓᏅᏏᏙᎯ. ᎬᏔᏂᏓᏍᏗ ᏥᎩ ᎤᏗᏞᎩ ᎾᎿᎢ ᎠᎦᏔᎲᏍᏗ ᎤᏬᏯᏂᏍᎩ ᎤᎿᎢ &amp; ᎠᏍᏚᎭ, ᏃᎴ ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᏂᏚᏍᏛ ᏗᎧᏃᏗ ᎤᎬᏩᏟ ᏗᏓᏕᏲᎲᏍᎩ ᏃᎴ ᎤᏥ ᎢᎦᎢ ᎧᏃᎮᏢᏗ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Change Pattern">
                <langSet xml:lang="en-US"><tig><term>Change Pattern</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎯᏁᏟᏴᎾ ᎤᎾᎶᎢᏓ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cancel unlocking the files?">
                <langSet xml:lang="en-US"><tig><term>Cancel unlocking the files?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏒᏗ ᏍᏓᏱ ᎠᏂᏐᎭᎾᎳᎩᏍᎬᎢ ᏗᏍᏆᏂᎪᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Try again:">
                <langSet xml:lang="en-US"><tig><term>Try again:</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏏᏊ ᏥᎭᏁᎵᏓ:</term></tig></langSet>
            </termEntry>
            <termEntry id="Show edge lighting for alerts, notifications, and more">
                <langSet xml:lang="en-US"><tig><term>Show edge lighting for alerts, notifications, and more</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᎪᏩᏛᏙᏗ ᎠᏍᏛᎢ ᏗᏨᏍᏗ ᎤᎬᏩᏟ ᏗᏓᏕᏯᏔᎲᏍᎩ, ᏗᎾᏓᏃᏣᎳᏁᎯ, ᏃᎴ ᎤᏥ ᎢᎦᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twisting opens the selfie camera">
                <langSet xml:lang="en-US"><tig><term>Twisting opens the selfie camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏓᏍᏚᎢ ᏥᎩ ᎣᏩᏒ ᏗᏓᏥᎶᏍᏔᏅ ᏗᏓᏥᎶᏍᏗᏍᎩ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Twist your wrist twice quickly to open the camera anytime">
                <langSet xml:lang="en-US"><tig><term>Twist your wrist twice quickly to open the camera anytime</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏓᏄᏖᏲᎭ ᏂᏨᎤᎢ ᎧᏯᏌᏝ ᏔᎵ ᎢᏳᏩᎫᏗ ᎤᎵᏍᏓᏊ ᎾᎿᎢ ᎯᏍᏚᎢ ᏥᎩ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎢᎸᎯᏳ</term></tig></langSet>
            </termEntry>
            <termEntry id="Do more with the screen off">
                <langSet xml:lang="en-US"><tig><term>Do more with the screen off</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎾᏉ ᎤᏥ ᎢᎦᎢ ᎬᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎠᏍᏚᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Cancel locking the files?">
                <langSet xml:lang="en-US"><tig><term>Cancel locking the files?</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏎᏒᏗ ᏍᏓᏱ ᎠᏍᏚᎭ ᏗᏍᏆᏂᎪᏙᏗ?</term></tig></langSet>
            </termEntry>
            <termEntry id="Camera permission must be enabled to use Moto Actions. Please go to the permissions settings in App Info to grant it.">
                <langSet xml:lang="en-US"><tig><term>Camera permission must be enabled to use Moto Actions. Please go to the permissions settings in App Info to grant it.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏗᏓᏥᎶᏍᏗᏍᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᎠᏎ ᎡᎵᏊ ᏂᏚᏩᏂᎸᎢ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ Moto ᎾᎾᏛᏁᎲᎢ. ᎰᏩᏊ Ꭷ ᏥᎩ ᏗᏓᎵᏍᎪᎸᏓᏁᏗ ᏕᎦᎧᎲᎢ ᎾᎿ ᎬᏙᏗ ᎧᏃᎮᏢᏗ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎨᎡᎢ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Tap on the One Button Navigation quickly">
                <langSet xml:lang="en-US"><tig><term>Tap on the One Button Navigation quickly</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎤᎿᎢ ᏥᎩ ᏌᏇ ᎦᏛᏗ ᎠᏱᎴᎩ ᎤᎵᏍᏓᏊ</term></tig></langSet>
            </termEntry>
            <termEntry id="For Attentive Display to work, Moto Actions needs permission to use your camera so it knows when you’re looking at the screen. Tap ALLOW on the following screen to grant permission.">
                <langSet xml:lang="en-US"><tig><term>For Attentive Display to work, Moto Actions needs permission to use your camera so it knows when you’re looking at the screen. Tap ALLOW on the following screen to grant permission.</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᎬᏩᏟ ᎠᏌᏪᏐᎸᏍᏓᏊ ᏂᎪᏩᏛᎾ ᏱᎩ ᎾᎿᎢ ᏗᎦᎸᏫᏍᏓᏁᏗ, Moto ᎾᎾᏛᏁᎲᎢ ᏧᏚᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ ᎾᎿᎢ ᎬᏔᏂᏓᏍᏗ ᏂᏨᎤᎢ ᏗᏓᏥᎶᏍᏗᏍᎩ ᏓᏛ ᎨᎡᎢ ᎠᏂᎦᏔᎭ ᎢᏳᏃ ᏂᎯ ᎨᎡᎩ ᎠᎦᏙᏍᏛ ᎤᎿᎢ ᏥᎩ ᎠᏰᏙᎳᏛᎢ. ᎤᏟᏍᏓ ᎠᏒᏂᎸ ᎠᎵᏍᎪᎸᏗᏍᎬ ᎤᎿᎢ ᏥᎩ ᎠᏍᏓᏩᏓ ᎠᏰᏙᎳᏛᎢ ᎾᎿᎢ ᎭᎵᏍᎪᎸᏓ ᎠᏓᎵᏍᎪᎸᏓᏁᎯ.</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose a camera">
                <langSet xml:lang="en-US"><tig><term>Choose a camera</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏣᏑᏰᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="All 3 fingertips should touch the screen at the same time">
                <langSet xml:lang="en-US"><tig><term>All 3 fingertips should touch the screen at the same time</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᏂᎦᏓ 3 ᏕᎯᏰᏌᏛ ᏫᏚᎵᏍᏛᎢ ᎾᎢᏳᏃ ᎠᏒᏂᏍᏗ ᏥᎩ ᎠᏰᏙᎳᏛᎢ ᎤᎿᎢ ᏥᎩ ᎤᏠᏱ ᎠᏥᎢᎵᏒ</term></tig></langSet>
            </termEntry>
            <termEntry id="Choose which camera to open with the twist gesture">
                <langSet xml:lang="en-US"><tig><term>Choose which camera to open with the twist gesture</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎠᏑᏰᏍᏗ ᎢᏳᏍᏗ ᏗᏓᏥᎶᏍᏗᏍᎩ ᎠᏍᏚᎢᏍᏗ ᎾᏍᎩ ᎠᏓᏄᏖᏲᎭ ᎤᏬᏯᏂᏍᎩ ᎬᏗ</term></tig></langSet>
            </termEntry>
            <termEntry id="Automatically adjust 5G connection and data transfer mode to save battery">
                <langSet xml:lang="en-US"><tig><term>Automatically adjust 5G connection and data transfer mode to save battery</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎤᏩᏌ ᏱᎬᏁᎯ ᎣᏍᏓ ᏱᎬᏁᎸᎢ 5Ꮆ ᎫᏓᎸᎢ ᏃᎴ ᎦᏟᏌᏅ ᎠᎲᏍᏗ ᎬᏙᏗ ᎠᎵᏏᏅᏙᏗ ᎠᎾᎦᎵᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Your wallpaper couldn’t be downloaded because your device doesn’t have enough storage.">
                <langSet xml:lang="en-US"><tig><term>Your wallpaper couldn’t be downloaded because your device doesn’t have enough storage.</term></tig></langSet>
