                <langSet xml:lang="en-US"><tig><term>Print Spooler</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎦᎴᏴᏙᏗ ᎦᏘᏍᎩᏌᏅᎯ ᎠᏍᏆᏂᎪᏗᏍᎩ</term></tig></langSet>
            </termEntry>
            <termEntry id="Make items on screen larger or smaller">
                <langSet xml:lang="en-US"><tig><term>Make items on screen larger or smaller</term></tig></langSet>
                <langSet xml:lang="chr"><tig><term>ᎪᏒᏗ ᏑᏓᎴᎩ ᏗᎬᏙᏗ ᎤᎾᎢ ᎠᏴᏙᎳᏛᎢ ᎡᏉᎯᎨᏍᏙᏗ ᎠᎴᏃ ᎠᏲᎵᎨᎢ</term></tig></langSet>
